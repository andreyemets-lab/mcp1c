<?xml version="1.0" encoding="UTF-8"?>
<!--
  Реверс-проксі IIS (URL Rewrite + Application Request Routing) для MCP-сервера 1С (ТЗ, п. 6.5, 11.2).

  Сайт https://mcp.company.ua з цим web.config проксірує /mcp на публікацію 1С
  http://onec-web.local/erp-mcp/hs/mcp1c (див. ../1c/default.vrd).

  Перед використанням:
  1. Встановіть URL Rewrite і Application Request Routing, увімкніть проксі:
     IIS Manager -> вузол сервера -> Application Request Routing Cache -> Server Proxy Settings -> Enable proxy.
  2. Дозвольте змінні сервера HTTP_X_REAL_IP, HTTP_X_MCP_AUTHORIZATION і HTTP_AUTHORIZATION
     (URL Rewrite -> View Server Variables), інакше правила нижче не застосуються.
  3. Прив'яжіть сертифікат до сайту (HTTPS, TLS 1.2+), увімкніть HSTS у налаштуваннях сайту.
  4. Обмеження частоти: Dynamic IP Restrictions (розширення IIS) - наприклад, 60 запитів за хвилину з IP.
  5. Журнал IIS не повинен містити заголовки: стандартний W3C-журнал заголовки не пише,
     але рядок запиту (cs-uri-query) вимкніть у полях журналу.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 256 КБ, як maxBodyBytes у налаштуваннях сервера -->
        <requestLimits maxAllowedContentLength="262144" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <!-- Токен у рядку запиту заборонено (п. 6.1 ТЗ). -->
        <rule name="mcp1c-deny-access-token" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)accesstoken=" />
          </conditions>
          <action type="CustomResponse" statusCode="400" statusReason="Bad Request"
                  statusDescription="Token in query string is not allowed" />
        </rule>
        <rule name="mcp1c-health" stopProcessing="true">
          <match url="^mcp/health$" />
          <action type="Rewrite" url="http://onec-web.local/erp-mcp/hs/mcp1c/health" />
        </rule>
        <rule name="mcp1c-endpoint" stopProcessing="true">
          <match url="^mcp$" />
          <serverVariables>
            <!-- IP клієнта завжди перезаписується проксі: клієнт не може його підробити. -->
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
            <!-- Модель B: токен переноситься в окремий заголовок, Authorization до 1С не доходить:
                 веб-розширення 1С сприймає його як облікові дані 1С навіть з користувачем у рядку з'єднання. -->
            <set name="HTTP_X_MCP_AUTHORIZATION" value="{HTTP_AUTHORIZATION}" />
            <set name="HTTP_AUTHORIZATION" value="" />
          </serverVariables>
          <action type="Rewrite" url="http://onec-web.local/erp-mcp/hs/mcp1c" />
        </rule>
        <rule name="mcp1c-other" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>

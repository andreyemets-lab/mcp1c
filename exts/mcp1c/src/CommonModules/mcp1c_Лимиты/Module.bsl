///////////////////////////////////////////////////////////////////////////////
// mcp1c_Лимиты: частота вызовов, суточная квота строк и защита от перебора токенов
// (п. 3.2 шаг 4, 6.5, 7.3 ТЗ).
//
// Счетчики берутся из журнала вызовов (mcp1c_ЖурналВызовов, индексы по клиенту и IP),
// блокировки адресов - в регистре mcp1c_Блокировки. Текущий запрос в журнал еще не записан,
// поэтому при подсчете учитывается отдельно. Лимиты мягкие: параллельные запросы могут
// незначительно превысить их.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Сколько секунд еще действует блокировка IP-адреса.
//
// Параметры:
//  Адрес - Строка - IP-адрес клиента; пустая строка - адрес неизвестен.
//
// Возвращаемое значение:
//  Число - секунд до снятия блокировки; 0 - адрес не заблокирован.
//
Функция ОсталосьБлокировкиАдреса(Адрес) Экспорт

	Если ПустаяСтрока(Адрес) Тогда
		Возврат 0;
	КонецЕсли;
	Сейчас = ТекущаяУниверсальнаяДата();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(Блокировки.ДействуетДо) КАК ДействуетДо
	|ИЗ
	|	РегистрСведений.mcp1c_Блокировки КАК Блокировки
	|ГДЕ
	|	Блокировки.Вид = &Вид
	|	И Блокировки.Ключ = &Ключ
	|	И Блокировки.ДействуетДо > &Сейчас");
	Запрос.УстановитьПараметр("Вид", ВидБлокировкиАдреса());
	Запрос.УстановитьПараметр("Ключ", КлючАдреса(Адрес));
	Запрос.УстановитьПараметр("Сейчас", Сейчас);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Не ЗначениеЗаполнено(Выборка.ДействуетДо) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Макс(Выборка.ДействуетДо - Сейчас, 1);

КонецФункции

// Учитывает неудачную аутентификацию и блокирует адрес, если за окно накопилось
// authFailuresLimit отказов (по умолчанию 10 за 5 минут, блокировка на 15 минут).
//
// Параметры:
//  Адрес - Строка - IP-адрес клиента; пустая строка - адрес неизвестен, блокировки нет.
//  Настройки - см. mcp1c_Настройки.Получить
//
// Возвращаемое значение:
//  Булево - адрес заблокирован этим отказом.
//
Функция ЗарегистрироватьОтказАутентификации(Адрес, Настройки) Экспорт

	Если ПустаяСтрока(Адрес) Тогда
		Возврат Ложь;
	КонецЕсли;
	Предел = mcp1c_Служебный.СвойствоЧисло(Настройки, "authFailuresLimit", 10);
	ОкноМинут = mcp1c_Служебный.СвойствоЧисло(Настройки, "authFailuresWindowMinutes", 5);
	БлокировкаМинут = mcp1c_Служебный.СвойствоЧисло(Настройки, "ipBlockMinutes", 15);
	Если Предел <= 0 Или БлокировкаМинут <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДата();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.АдресКлиента = &Адрес
	|	И Журнал.Момент >= &Граница
	|	И Журнал.Результат = ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.ОтказАутентификации)");
	Запрос.УстановитьПараметр("Адрес", Лев(Адрес, 45));
	Запрос.УстановитьПараметр("Граница", Сейчас - ОкноМинут * 60);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.Количество + 1 < Предел Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = РегистрыСведений.mcp1c_Блокировки.СоздатьМенеджерЗаписи();
	Запись.Вид = ВидБлокировкиАдреса();
	Запись.Ключ = КлючАдреса(Адрес);
	Запись.ДействуетДо = Сейчас + БлокировкаМинут * 60;
	Запись.ДатаУстановки = Сейчас;
	Запись.Причина = СтрШаблон("%1 неудачных аутентификаций за %2 мин.", Выборка.Количество + 1, ОкноМинут);
	Запись.Записать(Истина);

	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("IP-адрес %1 заблокирован на %2 мин.", Адрес, БлокировкаМинут),
		Запись.Причина);
	Возврат Истина;

КонецФункции

// Сколько секунд еще действует автоблокировка клиента доступа после отказов политики.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - клиент доступа.
//
// Возвращаемое значение:
//  Число - секунд до снятия блокировки; 0 - клиент не заблокирован.
//
Функция ОсталосьБлокировкиКлиента(Клиент) Экспорт

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат 0;
	КонецЕсли;
	Сейчас = ТекущаяУниверсальнаяДата();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(Блокировки.ДействуетДо) КАК ДействуетДо
	|ИЗ
	|	РегистрСведений.mcp1c_Блокировки КАК Блокировки
	|ГДЕ
	|	Блокировки.Вид = &Вид
	|	И Блокировки.Ключ = &Ключ
	|	И Блокировки.ДействуетДо > &Сейчас");
	Запрос.УстановитьПараметр("Вид", ВидБлокировкиКлиента());
	Запрос.УстановитьПараметр("Ключ", КлючКлиента(Клиент));
	Запрос.УстановитьПараметр("Сейчас", Сейчас);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Не ЗначениеЗаполнено(Выборка.ДействуетДо) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Макс(Выборка.ДействуетДо - Сейчас, 1);

КонецФункции

// Учитывает отказ политики (запрещенный объект или поле, параметр профиля без значения) и блокирует
// клиента, если за окно накопилось policyDenialsLimit отказов (по умолчанию 30 за 10 минут,
// блокировка на 15 минут): так выглядит перебор того, что профиль скрывает.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - клиент доступа.
//  ИмяКлиента - Строка - наименование клиента для журнала регистрации.
//  Настройки - см. mcp1c_Настройки.Получить
//
// Возвращаемое значение:
//  Булево - клиент заблокирован этим отказом.
//
Функция ЗарегистрироватьОтказПолитики(Клиент, ИмяКлиента, Настройки) Экспорт

	Предел = mcp1c_Служебный.СвойствоЧисло(Настройки, "policyDenialsLimit", 30);
	ОкноМинут = mcp1c_Служебный.СвойствоЧисло(Настройки, "policyDenialsWindowMinutes", 10);
	БлокировкаМинут = mcp1c_Служебный.СвойствоЧисло(Настройки, "clientBlockMinutes", 15);
	Если Не ЗначениеЗаполнено(Клиент) Или Предел <= 0 Или БлокировкаМинут <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДата();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Клиент = &Клиент
	|	И Журнал.Момент >= &Граница
	|	И Журнал.Результат = ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.ОтказДоступа)");
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Граница", Сейчас - ОкноМинут * 60);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	// Текущий отказ в журнал еще не записан.
	Если Выборка.Количество + 1 < Предел Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = РегистрыСведений.mcp1c_Блокировки.СоздатьМенеджерЗаписи();
	Запись.Вид = ВидБлокировкиКлиента();
	Запись.Ключ = КлючКлиента(Клиент);
	Запись.ДействуетДо = Сейчас + БлокировкаМинут * 60;
	Запись.ДатаУстановки = Сейчас;
	Запись.Причина = СтрШаблон("%1 отказов политики за %2 мин.", Выборка.Количество + 1, ОкноМинут);
	Запись.Записать(Истина);

	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Клиент доступа %1 заблокирован на %2 мин.", ИмяКлиента,
		БлокировкаМинут), Запись.Причина);
	Возврат Истина;

КонецФункции

// Снимает автоблокировку клиента доступа.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент доступа.
//
Процедура СнятьБлокировкуКлиента(Клиент) Экспорт

	Набор = РегистрыСведений.mcp1c_Блокировки.СоздатьНаборЗаписей();
	Набор.Отбор.Вид.Установить(ВидБлокировкиКлиента());
	Набор.Отбор.Ключ.Установить(КлючКлиента(Клиент));
	Набор.Записать(Истина);

КонецПроцедуры

// Снимает блокировку IP-адреса.
//
// Параметры:
//  Адрес - Строка - IP-адрес или ключ блокировки (нормализованный адрес).
//
Процедура СнятьБлокировкуАдреса(Адрес) Экспорт

	Набор = РегистрыСведений.mcp1c_Блокировки.СоздатьНаборЗаписей();
	Набор.Отбор.Вид.Установить(ВидБлокировкиАдреса());
	Набор.Отбор.Ключ.Установить(КлючАдреса(Адрес));
	Набор.Записать(Истина);

КонецПроцедуры

// Проверяет частоту вызовов клиента (п. 7.3 ТЗ): tools/call, resources/read и prompts/get.
// Списки (tools/list, resources/list, prompts/list) частоту не расходуют.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Число - секунд до возможности следующего вызова (Retry-After); 0 - лимит не превышен.
//
Функция ПревышениеЧастоты(Политика) Экспорт

	Предел = Политика.Лимиты.ВызововВМинуту;
	Если Предел <= 0 Или Не ЗначениеЗаполнено(Политика.Клиент) Тогда
		Возврат 0;
	КонецЕсли;
	Сейчас = ТекущаяУниверсальнаяДата();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	МИНИМУМ(Журнал.Момент) КАК Первый
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Клиент = &Клиент
	|	И Журнал.Момент > &Граница
	|	И Журнал.Метод В (&Методы)
	|	И Журнал.Результат <> ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.ПревышениеЛимита)");
	Запрос.УстановитьПараметр("Клиент", Политика.Клиент);
	Запрос.УстановитьПараметр("Граница", Сейчас - 60);
	Запрос.УстановитьПараметр("Методы", СтрРазделить("tools/call,resources/read,prompts/get", ","));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.Количество < Предел Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Макс(60 - (Сейчас - Выборка.Первый), 1);

КонецФункции

// Остаток суточной квоты строк клиента (п. 7.3 ТЗ). Сутки - по местному времени сервера.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Структура:
//   * Остаток - Число - сколько строк еще можно выдать сегодня.
//   * СекундДоСброса - Число - секунд до начала следующих суток.
//
Функция ОстатокКвотыСтрок(Политика) Экспорт

	МестноеВремя = ТекущаяДатаСеанса();
	НачалоСуток = НачалоДня(МестноеВремя);
	Результат = Новый Структура;
	Результат.Вставить("Остаток", Политика.Лимиты.СтрокВСутки);
	// Местное время всегда раньше начала следующих суток: значение от 1 до 86400.
	Результат.Вставить("СекундДоСброса", 86400 - (МестноеВремя - НачалоСуток));
	Если Не ЗначениеЗаполнено(Политика.Клиент) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Журнал.КоличествоСтрок), 0) КАК Строк
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Клиент = &Клиент
	|	И Журнал.Момент >= &НачалоСуток");
	Запрос.УстановитьПараметр("Клиент", Политика.Клиент);
	Запрос.УстановитьПараметр("НачалоСуток", УниверсальноеВремя(НачалоСуток, ЧасовойПоясСеанса()));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Остаток = Макс(Политика.Лимиты.СтрокВСутки - Выборка.Строк, 0);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидБлокировкиАдреса()

	Возврат "ip";

КонецФункции

Функция ВидБлокировкиКлиента()

	Возврат "client";

КонецФункции

Функция КлючКлиента(Клиент)

	Возврат Строка(Клиент.УникальныйИдентификатор());

КонецФункции

Функция КлючАдреса(Адрес)

	Нормализованный = mcp1c_Сеть.НормализоватьАдрес(Адрес);
	Возврат Лев(?(ПустаяСтрока(Нормализованный), НРег(СокрЛП(Адрес)), Нормализованный), 100);

КонецФункции

#КонецОбласти

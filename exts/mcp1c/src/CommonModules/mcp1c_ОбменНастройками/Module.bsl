///////////////////////////////////////////////////////////////////////////////
// mcp1c_ОбменНастройками: выгрузка и загрузка настроек MCP-сервера в JSON (п. 5.5, 9.2 ТЗ) - профили
// доступа, пользовательские инструменты, промпты, инструкции, глоссарий и глобальные запреты.
// Токены, клиенты доступа, секреты и привязка к ИБ не выгружаются.
//
// Формат и его проверка - mcp1c_ФорматОбмена. Загрузка идет в одной транзакции: профили, инструменты
// и промпты сопоставляются по имени, найденные заменяются целиком, остальные создаются; инструменты
// и промпты проверяются так же, как при записи из формы. Есть ошибка - не записывается ничего.
// Элементы и настройки, которые совпадают с базой, не перезаписываются (версия профиля не меняется).
// Проверка без записи (ТолькоПроверка) выполняет те же шаги и отменяет транзакцию.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Выгружает настройки в JSON.
//
// Возвращаемое значение:
//  Строка - документ JSON с отступами.
//
Функция Выгрузить() Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Документ = ДокументНастроек();
	mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Користувач %1 вивантажив налаштування MCP: профілів %2, "
		+ "інструментів %3, промптів %4", ИмяПользователя(), Документ.Получить("profiles").Количество(),
		Документ.Получить("tools").Количество(), Документ.Получить("prompts").Количество()));
	Возврат mcp1c_Сериализация.ФорматированныйJSON(Документ);

КонецФункции

// Загружает настройки из JSON.
//
// Параметры:
//  Текст - Строка - документ JSON выгрузки.
//  ТолькоПроверка - Булево - проверить и показать, что изменится, без записи.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - ошибок нет (и, если не проверка, настройки записаны).
//   * Протокол - Массив из Строка - что создано, обновлено, предупреждения проверки.
//   * Ошибки - Массив из Строка - ошибки; при ошибках ничего не записано.
//
Функция Загрузить(Текст, ТолькоПроверка = Ложь) Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Итог = Новый Структура("Успех, Протокол, Ошибки", Ложь, Новый Массив, Новый Массив);
	Попытка
		Документ = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
	Исключение
		Итог.Ошибки.Добавить("Файл не є JSON: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;
	Разбор = mcp1c_ФорматОбмена.РазобратьДокумент(Документ);
	Для Каждого Ошибка Из Разбор.Ошибки Цикл
		Итог.Ошибки.Добавить(Ошибка);
	КонецЦикла;
	Индекс = ИндексСсылок();
	Текущие = ТекущиеЭлементы();
	Для Каждого Имя Из Разбор.ВнешниеПрофили Цикл
		Если Индекс.Профили.Получить(НРег(Имя)) = Неопределено Тогда
			Итог.Ошибки.Добавить(СтрШаблон("Профілю «%1» немає ні у файлі, ні в базі: на нього посилаються інструменти "
				+ "або промпти", Имя));
		КонецЕсли;
	КонецЦикла;
	Если Итог.Ошибки.Количество() > 0 Тогда
		Возврат Итог;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	Канонический = Разбор.Документ;
	// Проверка без записи и загрузка с ошибками проверки заполнения отменяют транзакцию намеренно:
	// все элементы проверяются так же, как при записи, но в базе ничего не остается.
	// BSLLS:WrongUseOfRollbackTransactionMethod-off
	// BSLLS:PairingBrokenTransaction-off
	НачатьТранзакцию();
	Попытка
		ЗагрузитьОбщиеНастройки(Канонический.Получить("settings"), Текущие.Настройки, Итог);
		ЗагрузитьПрофили(Канонический.Получить("profiles"), Индекс, Текущие.Профили, Итог);
		ЗагрузитьИнструменты(Канонический.Получить("tools"), Индекс, Текущие.Инструменты, Итог);
		ЗагрузитьПромпты(Канонический.Получить("prompts"), Индекс, Текущие.Промпты, Итог);
		Если ТолькоПроверка Или Итог.Ошибки.Количество() > 0 Тогда
			ОтменитьТранзакцию();
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Итог.Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	// BSLLS:PairingBrokenTransaction-on
	// BSLLS:WrongUseOfRollbackTransactionMethod-on
	Итог.Успех = (Итог.Ошибки.Количество() = 0);

	Если Итог.Успех И Не ТолькоПроверка Тогда
		mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Пользователь %1 загрузил настройки MCP из файла", ИмяПользователя())
			+ Символы.ПС + СтрСоединить(Итог.Протокол, Символы.ПС));
	КонецЕсли;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Выгрузка

Функция ДокументНастроек()
	// Документ выгрузки: формат, источник, общие настройки, профили, инструменты и промпты.

	Документ = Новый Соответствие;
	Документ.Вставить("format", mcp1c_ФорматОбмена.ИмяФормата());
	Документ.Вставить("formatVersion", mcp1c_ФорматОбмена.ВерсияФормата());
	Документ.Вставить("exportedAt", mcp1c_Служебный.ДатаВСтроку(ТекущаяДатаСеанса()));
	Источник = Новый Соответствие;
	Источник.Вставить("server", mcp1c_Служебный.ИмяСервера() + " " + mcp1c_Служебный.ВерсияСервера());
	Источник.Вставить("configuration", Метаданные.Имя);
	Источник.Вставить("configurationVersion", Метаданные.Версия);
	Документ.Вставить("source", Источник);
	Документ.Вставить("settings", ВыгрузитьОбщиеНастройки());
	Документ.Вставить("profiles", ВыгрузитьПрофили());
	Документ.Вставить("tools", ВыгрузитьИнструменты());
	Документ.Вставить("prompts", ВыгрузитьПромпты());
	Возврат Документ;

КонецФункции

Функция ВыгрузитьОбщиеНастройки()

	Настройки = mcp1c_Настройки.Получить();
	Результат = Новый Соответствие;
	Результат.Вставить("instructions", mcp1c_Служебный.СвойствоСтрока(Настройки, "instructions"));
	Результат.Вставить("glossary", mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(
		mcp1c_Служебный.Свойство(Настройки, "glossary")));
	Результат.Вставить("bannedFieldPatterns", mcp1c_Служебный.СвойствоМассив(Настройки, "bannedFieldPatterns"));
	Результат.Вставить("bannedObjectPatterns", mcp1c_Служебный.СвойствоМассив(Настройки, "bannedObjectPatterns"));
	Возврат Результат;

КонецФункции

Функция ВыгрузитьПрофили()
	// Профили без пометки удаления со всеми табличными частями; строки табличных частей помеченных
	// профилей отбрасываются по ссылке владельца.

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Профили.Ссылка КАК Ссылка,
	|	Профили.Наименование КАК Наименование,
	|	Профили.Описание КАК Описание,
	|	Профили.ЛимитСтрок КАК ЛимитСтрок,
	|	Профили.ВызововВМинуту КАК ВызововВМинуту,
	|	Профили.СтрокВСутки КАК СтрокВСутки,
	|	Профили.ГлубинаПериодаДней КАК ГлубинаПериодаДней,
	|	Профили.РазмерОтветаКБ КАК РазмерОтветаКБ,
	|	Профили.ГлубинаРазыменования КАК ГлубинаРазыменования,
	|	Профили.РазрешитьПомеченныеНаУдаление КАК РазрешитьПомеченныеНаУдаление
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа КАК Профили
	|ГДЕ
	|	НЕ Профили.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Инструмент КАК Инструмент
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.Инструменты КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Объект КАК Объект,
	|	Т.Режим КАК Режим,
	|	Т.ПолитикаПолей КАК ПолитикаПолей,
	|	Т.ОбязательныйФильтрПериода КАК ОбязательныйФильтрПериода,
	|	Т.МинимальныйРазмерГруппы КАК МинимальныйРазмерГруппы
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.Объекты КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Объект КАК Объект,
	|	Т.Поле КАК Поле,
	|	Т.Действие КАК Действие,
	|	Т.ВидМаски КАК ВидМаски,
	|	Т.ПараметрМаски КАК ПараметрМаски
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.Поля КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Объект КАК Объект,
	|	Т.Поле КАК Поле,
	|	Т.ВидСравнения КАК ВидСравнения,
	|	Т.Значение КАК Значение,
	|	Т.Параметр КАК Параметр,
	|	Т.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.ОграниченияСтрок КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Имя КАК Имя,
	|	Т.ТипЗначения КАК ТипЗначения,
	|	Т.Описание КАК Описание
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.Параметры КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	Результаты = Запрос.ВыполнитьПакет();

	Профили = Новый Массив;
	ПоСсылке = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Профиль = Новый Соответствие;
		Профиль.Вставить("name", СокрЛП(Выборка.Наименование));
		Профиль.Вставить("description", Строка(Выборка.Описание));
		Лимиты = Новый Соответствие;
		Лимиты.Вставить("rowsPerCall", Число(Выборка.ЛимитСтрок));
		Лимиты.Вставить("callsPerMinute", Число(Выборка.ВызововВМинуту));
		Лимиты.Вставить("rowsPerDay", Число(Выборка.СтрокВСутки));
		Лимиты.Вставить("periodDays", Число(Выборка.ГлубинаПериодаДней));
		Лимиты.Вставить("responseKb", Число(Выборка.РазмерОтветаКБ));
		Лимиты.Вставить("dereferenceDepth", Число(Выборка.ГлубинаРазыменования));
		Профиль.Вставить("limits", Лимиты);
		Профиль.Вставить("includeDeleted", Выборка.РазрешитьПомеченныеНаУдаление = Истина);
		Для Каждого Ключ Из СтрРазделить("tools,objects,fields,rowRestrictions,parameters", ",") Цикл
			Профиль.Вставить(Ключ, Новый Массив);
		КонецЦикла;
		Профили.Добавить(Профиль);
		ПоСсылке.Вставить(Выборка.Ссылка, Профиль);
	КонецЦикла;

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "tools", СокрЛП(Выборка.Инструмент));
	КонецЦикла;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка_ = Новый Соответствие;
		Строка_.Вставить("object", СокрЛП(Выборка.Объект));
		Строка_.Вставить("mode", КодРежима(Выборка.Режим));
		Строка_.Вставить("fields", ?(Выборка.ПолитикаПолей = Перечисления.mcp1c_ПолитикиПолей.ТолькоРазрешенные,
			"allowed", "all"));
		Строка_.Вставить("requirePeriod", Выборка.ОбязательныйФильтрПериода = Истина);
		Строка_.Вставить("minGroupSize", Число(Выборка.МинимальныйРазмерГруппы));
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "objects", Строка_);
	КонецЦикла;
	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка_ = Новый Соответствие;
		Строка_.Вставить("object", СокрЛП(Выборка.Объект));
		Строка_.Вставить("field", СокрЛП(Выборка.Поле));
		Строка_.Вставить("action", КодДействия(Выборка.Действие));
		Строка_.Вставить("mask", КодВидаМаски(Выборка.ВидМаски));
		Строка_.Вставить("maskParameter", Число(Выборка.ПараметрМаски));
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "fields", Строка_);
	КонецЦикла;
	Выборка = Результаты[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка_ = Новый Соответствие;
		Строка_.Вставить("object", СокрЛП(Выборка.Объект));
		Строка_.Вставить("field", СокрЛП(Выборка.Поле));
		Строка_.Вставить("op", КодВидаСравнения(Выборка.ВидСравнения));
		Строка_.Вставить("value", СокрЛП(Выборка.Значение));
		Строка_.Вставить("parameter", СокрЛП(Выборка.Параметр));
		Строка_.Вставить("comment", СокрЛП(Выборка.Комментарий));
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "rowRestrictions", Строка_);
	КонецЦикла;
	Выборка = Результаты[5].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка_ = Новый Соответствие;
		Строка_.Вставить("name", СокрЛП(Выборка.Имя));
		Строка_.Вставить("types", СокрЛП(Выборка.ТипЗначения));
		Строка_.Вставить("description", СокрЛП(Выборка.Описание));
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "parameters", Строка_);
	КонецЦикла;
	Возврат Профили;

КонецФункции

Функция ВыгрузитьИнструменты()
	// Пользовательские инструменты без пометки удаления: параметры и профили по наименованию.

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Инструменты.Ссылка КАК Ссылка,
	|	Инструменты.Имя КАК Имя,
	|	Инструменты.Наименование КАК Заголовок,
	|	Инструменты.Вид КАК Вид,
	|	Инструменты.Описание КАК Описание,
	|	Инструменты.ТекстЗапроса КАК ТекстЗапроса,
	|	Инструменты.СхемаКомпоновки КАК СхемаКомпоновки,
	|	Инструменты.ИмяМодуля КАК ИмяМодуля,
	|	Инструменты.ИмяМетода КАК ИмяМетода,
	|	Инструменты.ЛимитСтрок КАК ЛимитСтрок
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты КАК Инструменты
	|ГДЕ
	|	НЕ Инструменты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Имя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Имя КАК Имя,
	|	Т.ИмяПараметра КАК ИмяПараметра,
	|	Т.ТипЗначения КАК ТипЗначения,
	|	Т.Описание КАК Описание,
	|	Т.Обязательный КАК Обязательный,
	|	Т.Список КАК Список,
	|	Т.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	Т.ДопустимыеЗначения КАК ДопустимыеЗначения,
	|	Т.ПараметрПрофиля КАК ПараметрПрофиля
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты.Параметры КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Профили.Наименование КАК Профиль
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты.Профили КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.mcp1c_ПрофилиДоступа КАК Профили
	|		ПО Т.Профиль = Профили.Ссылка
	|ГДЕ
	|	НЕ Профили.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	Результаты = Запрос.ВыполнитьПакет();

	Инструменты = Новый Массив;
	ПоСсылке = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Инструмент = Новый Соответствие;
		Инструмент.Вставить("name", СокрЛП(Выборка.Имя));
		Инструмент.Вставить("title", СокрЛП(Выборка.Заголовок));
		Инструмент.Вставить("kind", mcp1c_Политики.КодВидаИнструмента(Выборка.Вид));
		Инструмент.Вставить("description", Строка(Выборка.Описание));
		Инструмент.Вставить("query", Строка(Выборка.ТекстЗапроса));
		Инструмент.Вставить("dcs", Строка(Выборка.СхемаКомпоновки));
		Инструмент.Вставить("module", СокрЛП(Выборка.ИмяМодуля));
		Инструмент.Вставить("method", СокрЛП(Выборка.ИмяМетода));
		Инструмент.Вставить("rowLimit", Число(Выборка.ЛимитСтрок));
		Инструмент.Вставить("parameters", Новый Массив);
		Инструмент.Вставить("profiles", Новый Массив);
		Инструменты.Добавить(Инструмент);
		ПоСсылке.Вставить(Выборка.Ссылка, Инструмент);
	КонецЦикла;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка_ = Новый Соответствие;
		Строка_.Вставить("name", СокрЛП(Выборка.Имя));
		Строка_.Вставить("queryParameter", СокрЛП(Выборка.ИмяПараметра));
		Строка_.Вставить("types", СокрЛП(Выборка.ТипЗначения));
		Строка_.Вставить("description", СокрЛП(Выборка.Описание));
		Строка_.Вставить("required", Выборка.Обязательный = Истина);
		Строка_.Вставить("list", Выборка.Список = Истина);
		Строка_.Вставить("default", СокрЛП(Выборка.ЗначениеПоУмолчанию));
		Строка_.Вставить("allowed", СокрЛП(Выборка.ДопустимыеЗначения));
		Строка_.Вставить("profileParameter", СокрЛП(Выборка.ПараметрПрофиля));
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "parameters", Строка_);
	КонецЦикла;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "profiles", СокрЛП(Выборка.Профиль));
	КонецЦикла;
	Возврат Инструменты;

КонецФункции

Функция ВыгрузитьПромпты()
	// Промпты без пометки удаления: аргументы и профили по наименованию.

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Промпты.Ссылка КАК Ссылка,
	|	Промпты.Имя КАК Имя,
	|	Промпты.Наименование КАК Заголовок,
	|	Промпты.Описание КАК Описание,
	|	Промпты.Текст КАК Текст
	|ИЗ
	|	Справочник.mcp1c_Промпты КАК Промпты
	|ГДЕ
	|	НЕ Промпты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Имя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Имя КАК Имя,
	|	Т.Описание КАК Описание,
	|	Т.Обязательный КАК Обязательный,
	|	Т.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
	|ИЗ
	|	Справочник.mcp1c_Промпты.Аргументы КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Профили.Наименование КАК Профиль
	|ИЗ
	|	Справочник.mcp1c_Промпты.Профили КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.mcp1c_ПрофилиДоступа КАК Профили
	|		ПО Т.Профиль = Профили.Ссылка
	|ГДЕ
	|	НЕ Профили.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	Результаты = Запрос.ВыполнитьПакет();

	Промпты = Новый Массив;
	ПоСсылке = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Промпт = Новый Соответствие;
		Промпт.Вставить("name", СокрЛП(Выборка.Имя));
		Промпт.Вставить("title", СокрЛП(Выборка.Заголовок));
		Промпт.Вставить("description", Строка(Выборка.Описание));
		Промпт.Вставить("text", Строка(Выборка.Текст));
		Промпт.Вставить("arguments", Новый Массив);
		Промпт.Вставить("profiles", Новый Массив);
		Промпты.Добавить(Промпт);
		ПоСсылке.Вставить(Выборка.Ссылка, Промпт);
	КонецЦикла;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка_ = Новый Соответствие;
		Строка_.Вставить("name", СокрЛП(Выборка.Имя));
		Строка_.Вставить("description", СокрЛП(Выборка.Описание));
		Строка_.Вставить("required", Выборка.Обязательный = Истина);
		Строка_.Вставить("default", СокрЛП(Выборка.ЗначениеПоУмолчанию));
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "arguments", Строка_);
	КонецЦикла;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВРаздел(ПоСсылке, Выборка.Ссылка, "profiles", СокрЛП(Выборка.Профиль));
	КонецЦикла;
	Возврат Промпты;

КонецФункции

Процедура ДобавитьВРаздел(ПоСсылке, Ссылка, Ключ, Значение)
	// Строка табличной части в элемент выгрузки по ссылке владельца.

	Элемент = ПоСсылке.Получить(Ссылка);
	Если Элемент <> Неопределено Тогда
		Элемент.Получить(Ключ).Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Загрузка

Процедура ЗагрузитьОбщиеНастройки(Настройки, Текущие, Итог)
	// Меняются только переданные настройки, которые отличаются от настроек базы.

	Измененные = Новый Массив;
	Для Каждого Элемент Из Настройки Цикл
		Если Текущие.Получить(Элемент.Ключ) = mcp1c_Сериализация.КаноническийJSON(Элемент.Значение) Тогда
			Итог.Протокол.Добавить(СтрШаблон("Налаштування сервера «%1»: без змін", Элемент.Ключ));
		Иначе
			Измененные.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Если Измененные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Записываемые = mcp1c_Настройки.ЗаблокироватьИПрочитать();
	Для Каждого Элемент Из Измененные Цикл
		Если Элемент.Ключ = "glossary" Тогда
			Записываемые.Вставить(Элемент.Ключ, mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(Элемент.Значение));
		Иначе
			Записываемые.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
		Итог.Протокол.Добавить(СтрШаблон("Налаштування сервера «%1»: оновлено", Элемент.Ключ));
	КонецЦикла;
	mcp1c_Настройки.Записать(Записываемые);

КонецПроцедуры

Процедура ЗагрузитьПрофили(Профили, Индекс, Текущие, Итог)
	// Профили по наименованию: найденные заменяются целиком, остальные создаются (и попадают в индекс).

	Для Каждого Профиль Из Профили Цикл
		Имя = Профиль.Получить("name");
		Если Текущие.Получить(НРег(Имя)) = mcp1c_Сериализация.КаноническийJSON(Профиль) Тогда
			Итог.Протокол.Добавить(СтрШаблон("Профіль «%1»: без змін", Имя));
			Продолжить;
		КонецЕсли;
		Ссылка = Индекс.Профили.Получить(НРег(Имя));
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Объект.Заблокировать();
			Действие = "оновлено";
		Иначе
			Объект = Справочники.mcp1c_ПрофилиДоступа.СоздатьЭлемент();
			Действие = "створено";
		КонецЕсли;
		ЗаполнитьПрофиль(Объект, Профиль);
		Записать(Объект, СтрШаблон("Профіль «%1»", Имя));
		Индекс.Профили.Вставить(НРег(Имя), Объект.Ссылка);
		Итог.Протокол.Добавить(СтрШаблон("Профіль «%1»: %2", Имя, Действие));
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПрофиль(Объект, Профиль)

	Объект.Наименование = Профиль.Получить("name");
	Объект.Описание = Профиль.Получить("description");
	Объект.ПометкаУдаления = Ложь;
	Лимиты = Профиль.Получить("limits");
	Объект.ЛимитСтрок = Лимиты.Получить("rowsPerCall");
	Объект.ВызововВМинуту = Лимиты.Получить("callsPerMinute");
	Объект.СтрокВСутки = Лимиты.Получить("rowsPerDay");
	Объект.ГлубинаПериодаДней = Лимиты.Получить("periodDays");
	Объект.РазмерОтветаКБ = Лимиты.Получить("responseKb");
	Объект.ГлубинаРазыменования = Лимиты.Получить("dereferenceDepth");
	Объект.РазрешитьПомеченныеНаУдаление = Профиль.Получить("includeDeleted");

	Объект.Инструменты.Очистить();
	Для Каждого Инструмент Из Профиль.Получить("tools") Цикл
		Объект.Инструменты.Добавить().Инструмент = Инструмент;
	КонецЦикла;
	Объект.Объекты.Очистить();
	Для Каждого Правило Из Профиль.Получить("objects") Цикл
		Строка_ = Объект.Объекты.Добавить();
		Строка_.Объект = Правило.Получить("object");
		Строка_.Режим = РежимДоступа(Правило.Получить("mode"));
		Строка_.ПолитикаПолей = ?(Правило.Получить("fields") = "allowed", Перечисления.mcp1c_ПолитикиПолей.ТолькоРазрешенные,
			Перечисления.mcp1c_ПолитикиПолей.ВсеКромеЗапрещенных);
		Строка_.ОбязательныйФильтрПериода = Правило.Получить("requirePeriod");
		Строка_.МинимальныйРазмерГруппы = Правило.Получить("minGroupSize");
	КонецЦикла;
	Объект.Поля.Очистить();
	Для Каждого Правило Из Профиль.Получить("fields") Цикл
		Строка_ = Объект.Поля.Добавить();
		Строка_.Объект = Правило.Получить("object");
		Строка_.Поле = Правило.Получить("field");
		Строка_.Действие = ДействиеСПолем(Правило.Получить("action"));
		Строка_.ВидМаски = ВидМаски(Правило.Получить("mask"));
		Строка_.ПараметрМаски = Правило.Получить("maskParameter");
	КонецЦикла;
	Объект.ОграниченияСтрок.Очистить();
	Для Каждого Ограничение Из Профиль.Получить("rowRestrictions") Цикл
		Строка_ = Объект.ОграниченияСтрок.Добавить();
		Строка_.Объект = Ограничение.Получить("object");
		Строка_.Поле = Ограничение.Получить("field");
		Строка_.ВидСравнения = ВидСравнения(Ограничение.Получить("op"));
		Строка_.Значение = Ограничение.Получить("value");
		Строка_.Параметр = Ограничение.Получить("parameter");
		Строка_.Комментарий = Ограничение.Получить("comment");
	КонецЦикла;
	Объект.Параметры.Очистить();
	Для Каждого Параметр Из Профиль.Получить("parameters") Цикл
		Строка_ = Объект.Параметры.Добавить();
		Строка_.Имя = Параметр.Получить("name");
		Строка_.ТипЗначения = Параметр.Получить("types");
		Строка_.Описание = Параметр.Получить("description");
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьИнструменты(Инструменты, Индекс, Текущие, Итог)
	// Инструменты по имени MCP; проверка - как при записи из формы.

	Для Каждого Инструмент Из Инструменты Цикл
		Имя = Инструмент.Получить("name");
		Если Текущие.Получить(Имя) = mcp1c_Сериализация.КаноническийJSON(Инструмент) Тогда
			Итог.Протокол.Добавить(СтрШаблон("Інструмент %1: без змін", Имя));
			Продолжить;
		КонецЕсли;
		Ссылка = Индекс.Инструменты.Получить(Имя);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Объект.Заблокировать();
			Действие = "оновлено";
		Иначе
			Объект = Справочники.mcp1c_ПользовательскиеИнструменты.СоздатьЭлемент();
			Действие = "створено";
		КонецЕсли;
		Объект.Имя = Имя;
		Объект.Наименование = ?(ПустаяСтрока(Инструмент.Получить("title")), Имя, Инструмент.Получить("title"));
		Объект.Вид = ВидИнструмента(Инструмент.Получить("kind"));
		Объект.Описание = Инструмент.Получить("description");
		Объект.ТекстЗапроса = Инструмент.Получить("query");
		Объект.СхемаКомпоновки = Инструмент.Получить("dcs");
		Объект.ИмяМодуля = Инструмент.Получить("module");
		Объект.ИмяМетода = Инструмент.Получить("method");
		Объект.ЛимитСтрок = Инструмент.Получить("rowLimit");
		Объект.ПометкаУдаления = Ложь;
		Объект.Параметры.Очистить();
		Для Каждого Параметр Из Инструмент.Получить("parameters") Цикл
			Строка_ = Объект.Параметры.Добавить();
			Строка_.Имя = Параметр.Получить("name");
			Строка_.ИмяПараметра = Параметр.Получить("queryParameter");
			Строка_.ТипЗначения = Параметр.Получить("types");
			Строка_.Описание = Параметр.Получить("description");
			Строка_.Обязательный = Параметр.Получить("required");
			Строка_.Список = Параметр.Получить("list");
			Строка_.ЗначениеПоУмолчанию = Параметр.Получить("default");
			Строка_.ДопустимыеЗначения = Параметр.Получить("allowed");
			Строка_.ПараметрПрофиля = Параметр.Получить("profileParameter");
		КонецЦикла;
		ЗаполнитьПрофилиЭлемента(Объект.Профили, Инструмент.Получить("profiles"), Индекс.Профили);
		ПроверитьИЗаписать(Объект, СтрШаблон("Інструмент %1", Имя), Действие, Итог);
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьПромпты(Промпты, Индекс, Текущие, Итог)
	// Промпты по имени MCP; проверка - как при записи из формы.

	Для Каждого Промпт Из Промпты Цикл
		Имя = Промпт.Получить("name");
		Если Текущие.Получить(Имя) = mcp1c_Сериализация.КаноническийJSON(Промпт) Тогда
			Итог.Протокол.Добавить(СтрШаблон("Промпт %1: без змін", Имя));
			Продолжить;
		КонецЕсли;
		Ссылка = Индекс.Промпты.Получить(Имя);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Объект.Заблокировать();
			Действие = "оновлено";
		Иначе
			Объект = Справочники.mcp1c_Промпты.СоздатьЭлемент();
			Действие = "створено";
		КонецЕсли;
		Объект.Имя = Имя;
		Объект.Наименование = ?(ПустаяСтрока(Промпт.Получить("title")), Имя, Промпт.Получить("title"));
		Объект.Описание = Промпт.Получить("description");
		Объект.Текст = Промпт.Получить("text");
		Объект.ПометкаУдаления = Ложь;
		Объект.Аргументы.Очистить();
		Для Каждого Аргумент Из Промпт.Получить("arguments") Цикл
			Строка_ = Объект.Аргументы.Добавить();
			Строка_.Имя = Аргумент.Получить("name");
			Строка_.Описание = Аргумент.Получить("description");
			Строка_.Обязательный = Аргумент.Получить("required");
			Строка_.ЗначениеПоУмолчанию = Аргумент.Получить("default");
		КонецЦикла;
		ЗаполнитьПрофилиЭлемента(Объект.Профили, Промпт.Получить("profiles"), Индекс.Профили);
		ПроверитьИЗаписать(Объект, СтрШаблон("Промпт %1", Имя), Действие, Итог);
	КонецЦикла;


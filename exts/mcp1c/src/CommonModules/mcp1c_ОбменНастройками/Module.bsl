Процедура ЗаполнитьПрофилиЭлемента(ТабличнаяЧасть, Имена, Профили)
	// Профили инструмента или промпта по наименованию: загруженные или из базы (проверено до загрузки).

	ТабличнаяЧасть.Очистить();
	Для Каждого Имя Из Имена Цикл
		ТабличнаяЧасть.Добавить().Профиль = Профили.Получить(НРег(Имя));
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИЗаписать(Объект, Представление, Действие, Итог)
	// Проверка заполнения элемента (ошибки и предупреждения - сообщениями) и запись.

	Проверен = Объект.ПроверитьЗаполнение();
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = СтрШаблон("%1: %2", Представление, Сообщение.Текст);
		Если СтрНачинаетсяС(Сообщение.Текст, "Увага:") Тогда
			Итог.Протокол.Добавить(Текст);
		Иначе
			Итог.Ошибки.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Если Не Проверен Тогда
		Если Итог.Ошибки.Количество() = 0 Тогда
			Итог.Ошибки.Добавить(Представление + ": не пройшов перевірку заповнення");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Записать(Объект, Представление);
	Итог.Протокол.Добавить(СтрШаблон("%1: %2", Представление, Действие));

КонецПроцедуры

Процедура Записать(Объект, Представление)

	Попытка
		Объект.Записать();
	Исключение
		ВызватьИсключение СтрШаблон("%1: %2", Представление, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ТекущиеЭлементы()
	// Канонический JSON настроек, профилей, инструментов и промптов базы - в том виде, в каком их дает
	// разбор выгрузки, чтобы совпадающие с файлом элементы не перезаписывать.

	Документ = mcp1c_ФорматОбмена.РазобратьДокумент(ДокументНастроек()).Документ;
	Настройки = Новый Соответствие;
	Для Каждого Элемент Из Документ.Получить("settings") Цикл
		Настройки.Вставить(Элемент.Ключ, mcp1c_Сериализация.КаноническийJSON(Элемент.Значение));
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("Настройки", Настройки);
	Результат.Вставить("Профили", КаноническиеЭлементы(Документ.Получить("profiles"), Истина));
	Результат.Вставить("Инструменты", КаноническиеЭлементы(Документ.Получить("tools"), Ложь));
	Результат.Вставить("Промпты", КаноническиеЭлементы(Документ.Получить("prompts"), Ложь));
	Возврат Результат;

КонецФункции

Функция КаноническиеЭлементы(Элементы, ИмяВНижнемРегистре)
	// Канонический JSON элементов раздела по имени.

	Результат = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Имя = Элемент.Получить("name");
		Результат.Вставить(?(ИмяВНижнемРегистре, НРег(Имя), Имя), mcp1c_Сериализация.КаноническийJSON(Элемент));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИндексСсылок()
	// Ссылки на элементы по именам: профили - по наименованию без учета регистра, инструменты и промпты -
	// по имени MCP. Элемент без пометки удаления важнее помеченного.

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Профили.Ссылка КАК Ссылка,
	|	Профили.Наименование КАК Имя
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа КАК Профили
	|
	|УПОРЯДОЧИТЬ ПО
	|	Профили.ПометкаУдаления УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Инструменты.Ссылка КАК Ссылка,
	|	Инструменты.Имя КАК Имя
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты КАК Инструменты
	|
	|УПОРЯДОЧИТЬ ПО
	|	Инструменты.ПометкаУдаления УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Промпты.Ссылка КАК Ссылка,
	|	Промпты.Имя КАК Имя
	|ИЗ
	|	Справочник.mcp1c_Промпты КАК Промпты
	|
	|УПОРЯДОЧИТЬ ПО
	|	Промпты.ПометкаУдаления УБЫВ");
	Результаты = Запрос.ВыполнитьПакет();
	Индекс = Новый Структура("Профили, Инструменты, Промпты", Новый Соответствие, Новый Соответствие,
		Новый Соответствие);
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Индекс.Профили.Вставить(НРег(СокрЛП(Выборка.Имя)), Выборка.Ссылка);
	КонецЦикла;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Индекс.Инструменты.Вставить(СокрЛП(Выборка.Имя), Выборка.Ссылка);
	КонецЦикла;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Индекс.Промпты.Вставить(СокрЛП(Выборка.Имя), Выборка.Ссылка);
	КонецЦикла;
	Возврат Индекс;

КонецФункции

#КонецОбласти

#Область Коды

Функция КодРежима(Режим)

	Если Режим = Перечисления.mcp1c_РежимыДоступаКОбъектам.Чтение Тогда
		Возврат "read";
	ИначеЕсли Режим = Перечисления.mcp1c_РежимыДоступаКОбъектам.ТолькоАгрегаты Тогда
		Возврат "aggregates";
	КонецЕсли;
	Возврат "deny";

КонецФункции

Функция РежимДоступа(Код)

	Если Код = "read" Тогда
		Возврат Перечисления.mcp1c_РежимыДоступаКОбъектам.Чтение;
	ИначеЕсли Код = "aggregates" Тогда
		Возврат Перечисления.mcp1c_РежимыДоступаКОбъектам.ТолькоАгрегаты;
	КонецЕсли;
	Возврат Перечисления.mcp1c_РежимыДоступаКОбъектам.Запрещено;

КонецФункции

Функция КодДействия(Действие)

	Если Действие = Перечисления.mcp1c_ДействияСПолями.Разрешить Тогда
		Возврат "allow";
	ИначеЕсли Действие = Перечисления.mcp1c_ДействияСПолями.Маскировать Тогда
		Возврат "mask";
	КонецЕсли;
	Возврат "deny";

КонецФункции

Функция ДействиеСПолем(Код)

	Если Код = "allow" Тогда
		Возврат Перечисления.mcp1c_ДействияСПолями.Разрешить;
	ИначеЕсли Код = "mask" Тогда
		Возврат Перечисления.mcp1c_ДействияСПолями.Маскировать;
	КонецЕсли;
	Возврат Перечисления.mcp1c_ДействияСПолями.Запретить;

КонецФункции

Функция КодВидаМаски(ВидМаски)
	// Пустой вид маски выгружается пустой строкой: для маски это полная маска.

	Если ВидМаски = Перечисления.mcp1c_ВидыМасок.Полная Тогда
		Возврат "full";
	ИначеЕсли ВидМаски = Перечисления.mcp1c_ВидыМасок.Частичная Тогда
		Возврат "partial";
	ИначеЕсли ВидМаски = Перечисления.mcp1c_ВидыМасок.Хеш Тогда
		Возврат "hash";
	ИначеЕсли ВидМаски = Перечисления.mcp1c_ВидыМасок.Округление Тогда
		Возврат "round";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ВидМаски(Код)

	Если Код = "full" Тогда
		Возврат Перечисления.mcp1c_ВидыМасок.Полная;
	ИначеЕсли Код = "partial" Тогда
		Возврат Перечисления.mcp1c_ВидыМасок.Частичная;
	ИначеЕсли Код = "hash" Тогда
		Возврат Перечисления.mcp1c_ВидыМасок.Хеш;
	ИначеЕсли Код = "round" Тогда
		Возврат Перечисления.mcp1c_ВидыМасок.Округление;
	КонецЕсли;
	Возврат Перечисления.mcp1c_ВидыМасок.ПустаяСсылка();

КонецФункции

Функция КодВидаСравнения(ВидСравнения)

	Если ВидСравнения = Перечисления.mcp1c_ВидыСравнения.НеРавно Тогда
		Возврат "ne";
	ИначеЕсли ВидСравнения = Перечисления.mcp1c_ВидыСравнения.ВИерархии Тогда
		Возврат "in_hierarchy";
	КонецЕсли;
	Возврат "eq";

КонецФункции

Функция ВидСравнения(Код)

	Если Код = "ne" Тогда
		Возврат Перечисления.mcp1c_ВидыСравнения.НеРавно;
	ИначеЕсли Код = "in_hierarchy" Тогда
		Возврат Перечисления.mcp1c_ВидыСравнения.ВИерархии;
	КонецЕсли;
	Возврат Перечисления.mcp1c_ВидыСравнения.Равно;

КонецФункции

Функция ВидИнструмента(Код)

	Если Код = "dcs" Тогда
		Возврат Перечисления.mcp1c_ВидыПользовательскихИнструментов.КомпоновкаДанных;
	ИначеЕсли Код = "method" Тогда
		Возврат Перечисления.mcp1c_ВидыПользовательскихИнструментов.МетодМодуля;
	КонецЕсли;
	Возврат Перечисления.mcp1c_ВидыПользовательскихИнструментов.Запрос;

КонецФункции


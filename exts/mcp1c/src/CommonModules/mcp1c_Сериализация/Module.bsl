///////////////////////////////////////////////////////////////////////////////
// mcp1c_Сериализация: чтение и запись JSON.
// Объекты JSON представляются как Соответствие (ключи вида "_meta" и
// "io.modelcontextprotocol/..." недопустимы как ключи Структуры), массивы - как Массив.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает текст JSON.
//
// Параметры:
//  Текст - Строка - текст JSON.
//
// Возвращаемое значение:
//  Произвольный - разобранное значение: объект - Соответствие, массив - Массив, null - Неопределено;
//                 строки, числа и булевы значения - как есть.
//
// Исключения:
//  Вызывается при синтаксической ошибке JSON.
//
Функция ПрочитатьИзСтрокиJSON(Текст) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Сериализует значение в компактный JSON без экранирования не-ASCII символов.
//
// Параметры:
//  Значение - Произвольный - Соответствие, Массив, Строка, Число, Булево или Неопределено.
//
// Возвращаемое значение:
//  Строка - текст JSON.
//
Функция ЗаписатьВСтрокуJSON(Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "", Истина, ЭкранированиеСимволовJSON.Нет);
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

// Канонический JSON: ключи объектов отсортированы, пробелов нет. Одинаковые по смыслу
// значения дают одинаковый текст - используется для отпечатков аргументов.
//
// Параметры:
//  Значение - Произвольный - Соответствие, Массив, Строка, Число, Булево или Неопределено.
//
// Возвращаемое значение:
//  Строка - текст JSON.
//
Функция КаноническийJSON(Значение) Экспорт

	ТипЗначения = ТипЗнч(Значение);
	Части = Новый Массив;
	Если ТипЗначения = Тип("Соответствие") Тогда
		Ключи = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Ключи.Добавить(Элемент.Ключ);
		КонецЦикла;
		Для Каждого Ключ Из ОтсортированныеСтроки(Ключи) Цикл
			Части.Добавить(ЗаписатьВСтрокуJSON(Ключ) + ":" + КаноническийJSON(Значение.Получить(Ключ)));
		КонецЦикла;
		Возврат "{" + СтрСоединить(Части, ",") + "}";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(КаноническийJSON(Элемент));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Части, ",") + "]";
	КонецЕсли;
	Возврат ЗаписатьВСтрокуJSON(Значение);

КонецФункции

// Глубина вложенности объектов и массивов JSON.
//
// Параметры:
//  Значение - Произвольный - разобранное значение JSON.
//  Предел - Число - глубина, после которой подсчет прекращается.
//
// Возвращаемое значение:
//  Число - глубина вложенности (0 для примитивов).
//
Функция ГлубинаВложенности(Значение, Предел = 64) Экспорт

	Возврат ГлубинаЗначения(Значение, 0, Предел);

КонецФункции

// Текст из данных 1С для ответа модели (п. 5.4, 7.7 ТЗ): удаляются управляющие и невидимые
// символы (кроме табуляции и переводов строк), включая символы направления текста и теги Unicode,
// длинный текст обрезается с пометкой «…[обрізано]».
//
// Параметры:
//  Текст - Строка - исходный текст.
//  МаксимальнаяДлина - Число - предельная длина; 0 - без ограничения.
//
// Возвращаемое значение:
//  Строка - очищенный текст.
//
Функция ОчищенныйТекст(Знач Текст, МаксимальнаяДлина = 0) Экспорт

	Обрезан = МаксимальнаяДлина > 0 И СтрДлина(Текст) > МаксимальнаяДлина;
	Если Обрезан Тогда
		Текст = Лев(Текст, МаксимальнаяДлина);
		Если ЭтоСтаршийСуррогат(КодСимвола(Текст, СтрДлина(Текст))) Тогда
			Текст = Лев(Текст, СтрДлина(Текст) - 1); // не разрываем суррогатную пару
		КонецЕсли;
	КонецЕсли;

	Части = Новый Массив;
	Начало = 1;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Код = КодСимвола(Текст, Позиция);
		Пропустить = 0;
		Если ЭтоНевидимыйСимвол(Код) Тогда
			Пропустить = 1;
		ИначеЕсли Код = 56128 И Позиция < Длина И ЭтоМладшийСуррогатТега(КодСимвола(Текст, Позиция + 1)) Тогда
			Пропустить = 2; // теги Unicode U+E0000-U+E007F: суррогаты DB40 + DC00..DC7F
		КонецЕсли;
		Если Пропустить > 0 Тогда
			Если Позиция > Начало Тогда
				Части.Добавить(Сред(Текст, Начало, Позиция - Начало));
			КонецЕсли;
			Позиция = Позиция + Пропустить;
			Начало = Позиция;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Если Начало > 1 Тогда
		Если Начало <= Длина Тогда
			Части.Добавить(Сред(Текст, Начало));
		КонецЕсли;
		Текст = СтрСоединить(Части, "");
	КонецЕсли;
	Возврат ?(Обрезан, Текст + "…[обрізано]", Текст);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтсортированныеСтроки(Значения)
	// Сортировка вставками: массивы ключей небольшие, порядок одинаков на всех платформах.

	Результат = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Позиция = Результат.Количество();
		Пока Позиция > 0 И Результат[Позиция - 1] > Значение Цикл
			Позиция = Позиция - 1;
		КонецЦикла;
		Результат.Вставить(Позиция, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтоНевидимыйСимвол(Код)
	// Управляющие символы C0 (кроме табуляции, LF, CR), DEL, C1, мягкий перенос, символы нулевой
	// ширины и управления направлением текста, BOM, символы аннотаций.

	Если Код < 32 Тогда
		Возврат Код <> 9 И Код <> 10 И Код <> 13;
	КонецЕсли;
	Возврат Код >= 127 И Код <= 159
		Или Код = 173
		Или Код >= 8203 И Код <= 8207    // U+200B-U+200F
		Или Код >= 8234 И Код <= 8238    // U+202A-U+202E
		Или Код >= 8288 И Код <= 8292    // U+2060-U+2064
		Или Код >= 8294 И Код <= 8303    // U+2066-U+206F
		Или Код = 65279                  // U+FEFF
		Или Код >= 65529 И Код <= 65531; // U+FFF9-U+FFFB

КонецФункции

Функция ЭтоСтаршийСуррогат(Код)

	Возврат Код >= 55296 И Код <= 56319;

КонецФункции

Функция ЭтоМладшийСуррогатТега(Код)

	Возврат Код >= 56320 И Код <= 56447;

КонецФункции

Функция ГлубинаЗначения(Значение, Уровень, Предел)

	Если Уровень > Предел Тогда
		Возврат Уровень;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Соответствие") Тогда
		Максимум = Уровень + 1;
		Для Каждого Элемент Из Значение Цикл
			Максимум = Макс(Максимум, ГлубинаЗначения(Элемент.Значение, Уровень + 1, Предел));
		КонецЦикла;
		Возврат Максимум;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Максимум = Уровень + 1;
		Для Каждого Элемент Из Значение Цикл
			Максимум = Макс(Максимум, ГлубинаЗначения(Элемент, Уровень + 1, Предел));
		КонецЦикла;
		Возврат Максимум;
	КонецЕсли;

	Возврат Уровень;

КонецФункции

#КонецОбласти

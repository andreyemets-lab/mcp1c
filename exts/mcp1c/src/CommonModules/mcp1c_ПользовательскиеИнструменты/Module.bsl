///////////////////////////////////////////////////////////////////////////////
// mcp1c_ПользовательскиеИнструменты: предметные инструменты администратора (п. 5.5 ТЗ).
//
// Определение (см. НовоеОпределение) заполняет mcp1c_Политики из справочника
// mcp1c_ПользовательскиеИнструменты для профиля клиента. Виды: query - запрос с параметрами &Имя,
// dcs - схема компоновки данных, method - экспортная функция серверного общего модуля
// Функция(Параметры, Контекст). Модель передает только значения параметров: текст запроса,
// схему и метод задает администратор. Параметр, привязанный к параметру профиля, модели не виден:
// значение берется из клиента доступа, как в ограничениях строк (п. 7.5 ТЗ).
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Определения

// Определение пользовательского инструмента.
//
// Параметры:
//  Имя - Строка - имя инструмента для клиента (^[a-z][a-z0-9_]{2,63}$).
//  Вид - Строка - query, dcs или method.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя инструмента.
//   * Вид - Строка - query, dcs или method.
//   * Заголовок - Строка - заголовок для пользователя.
//   * Описание - Строка - описание для модели.
//   * ТекстЗапроса - Строка - текст запроса (query).
//   * СхемаКомпоновки - Строка - схема компоновки данных в XML (dcs).
//   * ИмяМодуля - Строка - имя серверного общего модуля (method).
//   * ИмяМетода - Строка - имя экспортной функции (method).
//   * ЛимитСтрок - Число - предел строк результата; 0 - лимит профиля.
//   * Колонки - Массив из Строка - колонки результата для outputSchema; пустой - неизвестны.
//   * Параметры - Массив из см. НовыйПараметр - параметры.
//
Функция НовоеОпределение(Имя, Вид) Экспорт

	Определение = Новый Структура;
	Определение.Вставить("Имя", СокрЛП(Имя));
	Определение.Вставить("Вид", Вид);
	Определение.Вставить("Заголовок", "");
	Определение.Вставить("Описание", "");
	Определение.Вставить("ТекстЗапроса", "");
	Определение.Вставить("СхемаКомпоновки", "");
	Определение.Вставить("ИмяМодуля", "");
	Определение.Вставить("ИмяМетода", "");
	Определение.Вставить("ЛимитСтрок", 0);
	Определение.Вставить("Колонки", Новый Массив);
	Определение.Вставить("Параметры", Новый Массив);
	Возврат Определение;

КонецФункции

// Параметр пользовательского инструмента.
//
// Параметры:
//  Имя - Строка - имя аргумента для модели (латиница: counterparty).
//  ИмяПараметра - Строка - имя параметра запроса или схемы без & (Контрагент), ключ структуры
//                 Параметры метода; пустая строка - как Имя.
//  Типы - Строка - типы значения через запятую (см. mcp1c_ПравилаДоступа.ТипыПараметра).
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя аргумента.
//   * ИмяПараметра - Строка - имя параметра запроса, схемы или метода.
//   * Типы - Массив из Строка - допустимые типы.
//   * Описание - Строка - описание для модели.
//   * Обязательный - Булево - без значения вызов не выполняется.
//   * Список - Булево - значение - массив (для В (&Параметр)).
//   * ЗначениеПоУмолчанию - Произвольный, Неопределено - значение JSON, если аргумент не передан;
//                           Неопределено - значения по умолчанию нет.
//   * ДопустимыеЗначения - Массив из Произвольный - допустимые значения (enum); пустой - любые.
//   * ПараметрПрофиля - Строка - параметр профиля, значение которого задает клиент доступа;
//                       такой параметр модели не виден.
//   * Ошибка - Строка - ошибка определения параметра (некорректный JSON значений).
//
Функция НовыйПараметр(Имя, ИмяПараметра, Типы) Экспорт

	Параметр = Новый Структура;
	Параметр.Вставить("Имя", СокрЛП(Имя));
	Параметр.Вставить("ИмяПараметра", ?(ПустаяСтрока(ИмяПараметра), СокрЛП(Имя), СокрЛП(ИмяПараметра)));
	Параметр.Вставить("Типы", mcp1c_ПравилаДоступа.ТипыПараметра(Типы));
	Параметр.Вставить("Описание", "");
	Параметр.Вставить("Обязательный", Ложь);
	Параметр.Вставить("Список", Ложь);
	Параметр.Вставить("ЗначениеПоУмолчанию", Неопределено);
	Параметр.Вставить("ДопустимыеЗначения", Новый Массив);
	Параметр.Вставить("ПараметрПрофиля", "");
	Параметр.Вставить("Ошибка", "");
	Возврат Параметр;

КонецФункции

// Заполняет значение по умолчанию и допустимые значения параметра из JSON администратора.
//
// Параметры:
//  Параметр - см. НовыйПараметр
//  ЗначениеПоУмолчанию - Строка - JSON значения по умолчанию; пустая строка - нет.
//  ДопустимыеЗначения - Строка - JSON-массив допустимых значений (строки, числа); пустая строка - любые.
//
Процедура УстановитьЗначенияПараметра(Параметр, ЗначениеПоУмолчанию, ДопустимыеЗначения) Экспорт

	Разбор = РазобратьJSON(ЗначениеПоУмолчанию);
	Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
		Параметр.Ошибка = "значення за замовчуванням - некоректний JSON";
		Возврат;
	КонецЕсли;
	Параметр.ЗначениеПоУмолчанию = Разбор.Значение;

	Разбор = РазобратьJSON(ДопустимыеЗначения);
	Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
		Параметр.Ошибка = "допустимі значення - некоректний JSON";
	ИначеЕсли ТипЗнч(Разбор.Значение) = Тип("Массив") И ЭтоМассивПростыхЗначений(Разбор.Значение) Тогда
		Параметр.ДопустимыеЗначения = Разбор.Значение;
	ИначеЕсли Разбор.Значение <> Неопределено Тогда
		Параметр.Ошибка = "допустимі значення - JSON-масив рядків або чисел";
	КонецЕсли;

КонецПроцедуры

// Ошибки определения, которые проверяются без обращения к данным: имя, вид, описание,
// параметры. Текст запроса, схема и метод модуля проверяются при записи элемента справочника.
//
// Параметры:
//  Определение - см. НовоеОпределение
//
// Возвращаемое значение:
//  Массив из Строка - тексты ошибок; пустой - определение корректно.
//
Функция ОшибкиОпределения(Определение) Экспорт

	Ошибки = Новый Массив;
	Если Не mcp1c_Служебный.ЭтоИмяMCP(Определение.Имя) Тогда
		Ошибки.Добавить("Ім'я інструмента: латинські малі літери, цифри й _, починається з літери, "
			+ "від 3 до 64 символів (наприклад, customer_debt)");
	ИначеЕсли ЗарезервированныеИмена().Найти(Определение.Имя) <> Неопределено Тогда
		Ошибки.Добавить(СтрШаблон("Ім'я %1 зайняте вбудованим інструментом", Определение.Имя));
	КонецЕсли;
	Если ПустаяСтрока(Определение.Описание) Тогда
		Ошибки.Добавить("Не заповнено опис для моделі: що повертає інструмент і коли його викликати");
	КонецЕсли;
	ДобавитьОшибкиВида(Определение, Ошибки);
	ДобавитьОшибкиПараметров(Определение, Ошибки);
	Возврат Ошибки;

КонецФункции

// Имена, которые не может занять пользовательский инструмент.
//
// Возвращаемое значение:
//  Массив из Строка - имена встроенных и зарезервированных инструментов.
//
Функция ЗарезервированныеИмена() Экспорт

	Результат = mcp1c_ПравилаДоступа.ВстроенныеИнструментыЧтения();
	Результат.Добавить("execute_query");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Описания

// Описания пользовательских инструментов клиента для tools/list - по имени.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Массив из Произвольный - описания (Соответствие): name, title, description, inputSchema,
//    outputSchema, annotations.
//
Функция ОписанияИнструментов(Политика) Экспорт

	Имена = Новый Массив;
	Для Каждого Элемент Из Политика.ПользовательскиеИнструменты Цикл
		ВставитьПоПорядку(Имена, Элемент.Ключ);
	КонецЦикла;
	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Результат.Добавить(ОписаниеИнструмента(Политика.ПользовательскиеИнструменты.Получить(Имя)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Описание пользовательского инструмента для tools/list: inputSchema - из параметров, кроме
// привязанных к параметрам профиля.
//
// Параметры:
//  Определение - см. НовоеОпределение
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - name, title, description, inputSchema, outputSchema, annotations.
//
Функция ОписаниеИнструмента(Определение) Экспорт

	Свойства = Новый Соответствие;
	Обязательные = Новый Массив;
	Для Каждого Параметр Из Определение.Параметры Цикл
		Если Не ПустаяСтрока(Параметр.ПараметрПрофиля) Тогда
			Продолжить; // значение задает клиент доступа
		КонецЕсли;
		Свойства.Вставить(Параметр.Имя, СхемаПараметра(Параметр));
		Если Параметр.Обязательный И Параметр.ЗначениеПоУмолчанию = Неопределено Тогда
			Обязательные.Добавить(Параметр.Имя);
		КонецЕсли;
	КонецЦикла;

	Заголовок = ?(ПустаяСтрока(Определение.Заголовок), Определение.Имя, Определение.Заголовок);
	Аннотации = Новый Соответствие;
	Аннотации.Вставить("title", Заголовок);
	Аннотации.Вставить("readOnlyHint", Истина);
	Аннотации.Вставить("destructiveHint", Ложь);
	Аннотации.Вставить("idempotentHint", Истина);
	Аннотации.Вставить("openWorldHint", Ложь);

	Описание = Новый Соответствие;
	Описание.Вставить("name", Определение.Имя);
	Описание.Вставить("title", Заголовок);
	Описание.Вставить("description", ТекстОписания(Определение));
	Описание.Вставить("inputSchema", mcp1c_СхемаJSON.СхемаОбъекта(Свойства, СтрСоединить(Обязательные, ",")));
	Описание.Вставить("outputSchema", СхемаРезультата(Определение));
	Описание.Вставить("annotations", Аннотации);
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область Аргументы

// Значения параметров вызова: аргументы модели (или значения по умолчанию) и значения
// параметров профиля клиента, проверенные по типам параметров.
//
// Параметры:
//  Определение - см. НовоеОпределение
//  Аргументы - Соответствие из КлючИЗначение - аргументы, проверенные по inputSchema.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Структура:
//   * Значения - Соответствие из КлючИЗначение - переданные значения; параметра без значения нет:
//     ** Ключ - Строка - имя параметра запроса, схемы или метода.
//     ** Значение - см. mcp1c_ЗапросыДанных.НовоеЗначение
//   * Ошибка - Строка - текст ошибки для модели; пустая строка - значения получены.
//   * Причина - Строка - отказ доступа для журнала: у клиента нет значения параметра профиля.
//
Функция ЗначенияАргументов(Определение, Аргументы, Политика) Экспорт

	Итог = Новый Структура("Значения, Ошибка, Причина", Новый Соответствие, "", "");
	Для Каждого Параметр Из Определение.Параметры Цикл
		Если ПустаяСтрока(Параметр.ПараметрПрофиля) Тогда
			Значение = ЗначениеАргумента(Параметр, Аргументы, Итог);
		Иначе
			Значение = ЗначениеИзПрофиля(Параметр, Политика, Итог);
		КонецЕсли;
		Если Не ПустаяСтрока(Итог.Ошибка) Тогда
			Возврат Итог;
		КонецЕсли;
		Если Значение <> Неопределено Тогда
			Итог.Значения.Вставить(Параметр.ИмяПараметра, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Предел строк результата: лимит инструмента, не больше лимита профиля и остатка суточной квоты.
//
// Параметры:
//  Определение - см. НовоеОпределение
//  ЛимитПрофиля - Число - строк за вызов по профилю.
//  ОстатокКвоты - Число, Неопределено - остаток суточной квоты строк.
//
// Возвращаемое значение:
//  Число - предел; 0 - квота исчерпана.
//
Функция ЛимитСтрок(Определение, ЛимитПрофиля, ОстатокКвоты) Экспорт

	Лимит = ЛимитПрофиля;
	Если Определение.ЛимитСтрок > 0 И Определение.ЛимитСтрок < Лимит Тогда
		Лимит = Определение.ЛимитСтрок;
	КонецЕсли;
	Если ТипЗнч(ОстатокКвоты) = Тип("Число") И ОстатокКвоты < Лимит Тогда
		Лимит = ОстатокКвоты;
	КонецЕсли;
	Возврат ?(Лимит > 0, Лимит, 0);

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроверкаОпределения

Процедура ДобавитьОшибкиВида(Определение, Ошибки)
	// Обязательные реквизиты вида инструмента.

	Если Определение.Вид = "query" Тогда
		Если ПустаяСтрока(Определение.ТекстЗапроса) Тогда
			Ошибки.Добавить("Не заповнено текст запиту");
		КонецЕсли;
	ИначеЕсли Определение.Вид = "dcs" Тогда
		Если ПустаяСтрока(Определение.СхемаКомпоновки) Тогда
			Ошибки.Добавить("Не заповнено схему компонування даних (XML)");
		КонецЕсли;
	ИначеЕсли Определение.Вид = "method" Тогда
		Если Не mcp1c_Служебный.ЭтоИдентификатор(Определение.ИмяМодуля)
			Или Не mcp1c_Служебный.ЭтоИдентификатор(Определение.ИмяМетода) Тогда
			Ошибки.Добавить("Ім'я модуля й ім'я методу - ідентифікатори 1С (літери, цифри, _)");
		КонецЕсли;
	Иначе
		Ошибки.Добавить("Не вказано вид інструмента: запит, схема компонування або метод модуля");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОшибкиПараметров(Определение, Ошибки)
	// Имена аргументов и параметров, типы, значения по умолчанию.

	Аргументы = Новый Соответствие;
	ИменаПараметров = Новый Соответствие;
	Для Каждого Параметр Из Определение.Параметры Цикл
		ДобавитьОшибкиИменПараметра(Параметр, Аргументы, ИменаПараметров, Ошибки);
		ДобавитьОшибкиЗначенийПараметра(Параметр, Ошибки);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОшибкиИменПараметра(Параметр, Аргументы, ИменаПараметров, Ошибки)
	// Имя аргумента и имя параметра запроса: формат и уникальность.

	Префикс = СтрШаблон("Параметр %1: ", Параметр.Имя);
	Если Не mcp1c_Служебный.ЭтоИмяАргумента(Параметр.Имя) Тогда
		Ошибки.Добавить(СтрШаблон("Параметр «%1»: ім'я аргументу - латинські літери, цифри й _", Параметр.Имя));
	ИначеЕсли Аргументы.Получить(Параметр.Имя) <> Неопределено Тогда
		Ошибки.Добавить(Префикс + "аргумент з таким ім'ям уже є");
	КонецЕсли;
	Аргументы.Вставить(Параметр.Имя, Истина);

	Ключ = НРег(Параметр.ИмяПараметра);
	Если Не mcp1c_Служебный.ЭтоИдентификатор(Параметр.ИмяПараметра) Тогда
		Ошибки.Добавить(Префикс + "ім'я параметра запиту - ідентифікатор 1С без &");
	ИначеЕсли ИменаПараметров.Получить(Ключ) <> Неопределено Тогда
		Ошибки.Добавить(Префикс + "параметр запиту " + Параметр.ИмяПараметра + " уже зіставлено іншому аргументу");
	КонецЕсли;
	ИменаПараметров.Вставить(Ключ, Истина);

КонецПроцедуры

Процедура ДобавитьОшибкиЗначенийПараметра(Параметр, Ошибки)
	// Типы, JSON значений и соответствие значения по умолчанию типам.

	Префикс = СтрШаблон("Параметр %1: ", Параметр.Имя);
	Если Параметр.Типы.Количество() = 0 Тогда
		Ошибки.Добавить(Префикс + "не вказано тип значення");
	КонецЕсли;
	Если Не ПустаяСтрока(Параметр.Ошибка) Тогда
		Ошибки.Добавить(Префикс + Параметр.Ошибка);
		Возврат;
	ИначеЕсли Параметр.ЗначениеПоУмолчанию = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Итог = Новый Структура("Ошибка, Причина", "", "");
	СпецификацияЗначения(Параметр.ЗначениеПоУмолчанию, Параметр, "значення за замовчуванням", Итог);
	Если Не ПустаяСтрока(Итог.Ошибка) Тогда
		Ошибки.Добавить(Префикс + Итог.Ошибка);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоМассивПростыхЗначений(Значения)
	// Допустимые значения enum: непустой массив строк и чисел.

	Если Значения.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Значение Из Значения Цикл
		Если ТипЗнч(Значение) <> Тип("Строка") И ТипЗнч(Значение) <> Тип("Число") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция РазобратьJSON(Знач Текст)
	// Значение JSON администратора: Значение (Неопределено для пустой строки) и Ошибка.

	Результат = Новый Структура("Значение, Ошибка", Неопределено, "");
	Текст = СокрЛП(Текст);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Результат.Значение = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
	Исключение
		Результат.Ошибка = "некоректний JSON";
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Описание

Функция ТекстОписания(Определение)
	// Описание администратора и формат результата.

	Если Определение.Вид = "method" Тогда
		Формат_ = "Результат: columns і rows (таблиця) або result; has_more - рядків більше за ліміт.";
	Иначе
		Формат_ = "Результат: columns і rows; has_more - рядків більше за ліміт.";
	КонецЕсли;
	Возврат СокрЛП(Определение.Описание) + Символы.ПС + "Інструмент адміністратора бази. " + Формат_;

КонецФункции

Функция СхемаРезультата(Определение)
	// outputSchema: таблица columns/rows; у метода модуля может быть result вместо таблицы.

	Выход = Новый Соответствие;
	Выход.Вставить("columns", mcp1c_СхемаJSON.СхемаТипа("array"));
	Выход.Вставить("rows", mcp1c_СхемаJSON.СхемаТипа("array"));
	Выход.Вставить("row_count", mcp1c_СхемаJSON.СхемаТипа("integer"));
	Выход.Вставить("has_more", mcp1c_СхемаJSON.СхемаТипа("boolean"));
	Выход.Вставить("notes", mcp1c_СхемаJSON.СхемаТипа("array"));
	Если Определение.Вид = "method" Тогда
		Выход.Вставить("result", mcp1c_СхемаJSON.СхемаЗначения("Значення, яке повернув метод"));
		Возврат mcp1c_СхемаJSON.СхемаВыхода(Выход, "");
	КонецЕсли;
	Возврат mcp1c_СхемаJSON.СхемаВыхода(Выход, "columns,rows,row_count,has_more");

КонецФункции

Функция СхемаПараметра(Параметр)
	// Схема аргумента: значение или массив значений, описание с форматом типов, значение по умолчанию.

	Текст = ТекстОписанияПараметра(Параметр);
	Если Параметр.Список Тогда
		Схема = mcp1c_СхемаJSON.СхемаМассива(Текст, СхемаЗначенияПараметра(Параметр), 1000,
			?(Параметр.Обязательный, 1, 0));
	Иначе
		Схема = СхемаЗначенияПараметра(Параметр);
		Схема.Вставить("description", Текст);
	КонецЕсли;
	Если Параметр.ЗначениеПоУмолчанию <> Неопределено Тогда
		Схема.Вставить("default", Параметр.ЗначениеПоУмолчанию);
	КонецЕсли;
	Возврат Схема;

КонецФункции

Функция СхемаЗначенияПараметра(Параметр)
	// Схема одного значения: для единственного примитивного типа - его тип JSON; ссылки, перечисления
	// и составные типы - без type: значение проверяется разбором по типам при вызове.

	Схема = Новый Соответствие;
	Если Параметр.Типы.Количество() = 1 Тогда
		ИмяТипа = Параметр.Типы[0];
		Если ИмяТипа = "Строка" Тогда
			Схема.Вставить("type", "string");
			Схема.Вставить("maxLength", 1000);
		ИначеЕсли ИмяТипа = "Дата" Тогда
			Схема.Вставить("type", "string");
			Схема.Вставить("maxLength", 19);
		ИначеЕсли ИмяТипа = "Число" Тогда
			Схема.Вставить("type", "number");
		ИначеЕсли ИмяТипа = "Булево" Тогда
			Схема.Вставить("type", "boolean");
		КонецЕсли;
	КонецЕсли;
	Если Параметр.ДопустимыеЗначения.Количество() > 0 Тогда
		Схема.Вставить("enum", Параметр.ДопустимыеЗначения);
	КонецЕсли;
	Возврат Схема;

КонецФункции

Функция ТекстОписанияПараметра(Параметр)
	// Описание администратора и формат значения по типам.

	Подсказки = Новый Массив;
	Для Каждого ИмяТипа Из Параметр.Типы Цикл
		Подсказки.Добавить(ПодсказкаТипа(ИмяТипа));
	КонецЦикла;
	Текст = СокрЛП(Параметр.Описание);
	Если Подсказки.Количество() > 0 Тогда
		Текст = Текст + ?(ПустаяСтрока(Текст), "", ". ") + "Значення: " + СтрСоединить(Подсказки, " або ");
	КонецЕсли;
	Если Параметр.Список Тогда
		Текст = Текст + "; масив значень";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ПодсказкаТипа(ИмяТипа)

	Если ИмяТипа = "Строка" Тогда
		Возврат "рядок";
	ИначеЕсли ИмяТипа = "Число" Тогда
		Возврат "число";
	ИначеЕсли ИмяТипа = "Булево" Тогда
		Возврат "true/false";
	ИначеЕсли ИмяТипа = "Дата" Тогда
		Возврат "дата 2026-09-30 або 2026-09-30T14:00:00 (місцевий час сервера)";
	ИначеЕсли mcp1c_ПутиПолей.ЭтоПеречисление(ИмяТипа) Тогда
		Возврат СтрШаблон("ім'я значення перерахування %1", ИмяТипа);
	КонецЕсли;
	Возврат СтрШаблон("посилання {""type"": ""%1"", ""ref"": ""<uuid>""} з результатів інших інструментів", ИмяТипа);

КонецФункции

Процедура ВставитьПоПорядку(Имена, Имя)
	// Вставка в упорядоченный массив строк.

	Для Индекс = 0 По Имена.ВГраница() Цикл
		Если Имя < Имена[Индекс] Тогда
			Имена.Вставить(Индекс, Имя);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Имена.Добавить(Имя);

КонецПроцедуры

#КонецОбласти

#Область ЗначенияПараметров

Функция ЗначениеАргумента(Параметр, Аргументы, Итог)
	// Спецификация значения аргумента модели или значения по умолчанию; Неопределено - значения нет.

	Значение = ?(ТипЗнч(Аргументы) = Тип("Соответствие"), Аргументы.Получить(Параметр.Имя), Неопределено);
	Если Значение = Неопределено Тогда
		Значение = Параметр.ЗначениеПоУмолчанию;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Если Параметр.Обязательный Тогда
			Итог.Ошибка = "Не передано обов'язковий аргумент " + Параметр.Имя;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Возврат СпецификацияЗначения(Значение, Параметр, "arguments." + Параметр.Имя, Итог);

КонецФункции

Функция ЗначениеИзПрофиля(Параметр, Политика, Итог)
	// Спецификация значения параметра профиля клиента; без значения инструмент недоступен.

	Значения = mcp1c_ПравилаДоступа.ЗначенияПараметраКлиента(Политика, Параметр.ПараметрПрофиля);
	Если Не ПустаяСтрока(Значения.Ошибка) Тогда
		Итог.Причина = Значения.Ошибка;
		Итог.Ошибка = "Інструмент недоступний цьому клієнту: адміністратор не задав значення параметра профілю «"
			+ Параметр.ПараметрПрофиля + "»";
		Возврат Неопределено;
	КонецЕсли;
	Если Не Параметр.Список И Значения.Значения.Количество() > 1 Тогда
		Итог.Причина = СтрШаблон("Параметр профілю %1 має кілька значень, а параметр %2 інструмента - не список",
			Параметр.ПараметрПрофиля, Параметр.ИмяПараметра);
		Итог.Ошибка = "Інструмент недоступний цьому клієнту: параметр профілю «" + Параметр.ПараметрПрофиля
			+ "» має кілька значень, а інструмент приймає одне";
		Возврат Неопределено;
	КонецЕсли;
	Значение = ?(Параметр.Список, Значения.Значения, Значения.Значения[0]);
	Спецификация = СпецификацияЗначения(Значение, Параметр, "параметр профілю " + Параметр.ПараметрПрофиля, Итог);
	Если Не ПустаяСтрока(Итог.Ошибка) Тогда
		Итог.Причина = Итог.Ошибка;
		Итог.Ошибка = "Інструмент недоступний цьому клієнту: значення параметра профілю «" + Параметр.ПараметрПрофиля
			+ "» не підходить типу параметра інструмента";
	КонецЕсли;
	Возврат Спецификация;

КонецФункции

Функция СпецификацияЗначения(Значение, Параметр, Путь, Итог)
	// Спецификация значения по типам параметра: одно значение или список для параметра-списка.

	Если Не Параметр.Список Тогда
		Разбор = mcp1c_ЗапросыДанных.РазобратьЗначение(Значение, Параметр.Типы, Путь);
		Итог.Ошибка = Разбор.Ошибка;
		Возврат Разбор.Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Итог.Ошибка = Путь + ": очікується масив значень";
		Возврат Неопределено;
	КонецЕсли;
	Список = mcp1c_ЗапросыДанных.НовоеЗначение("list");
	Для Индекс = 0 По Значение.ВГраница() Цикл
		Разбор = mcp1c_ЗапросыДанных.РазобратьЗначение(Значение[Индекс], Параметр.Типы,
			СтрШаблон("%1[%2]", Путь, Формат(Индекс, "ЧН=0; ЧГ=0")));
		Если Не Разбор.Успех Тогда
			Итог.Ошибка = Разбор.Ошибка;
			Возврат Неопределено;
		КонецЕсли;
		Список.Элементы.Добавить(Разбор.Значение);
	КонецЦикла;
	Возврат Список;

КонецФункции


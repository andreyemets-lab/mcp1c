///////////////////////////////////////////////////////////////////////////////
// mcp1c_Песочница: вызов методов MCP от имени клиента доступа для проверки администратором
// (п. 9.2 ТЗ) - точный ответ, который получит модель, и правила профиля, которые к нему применились.
//
// Вызов идет теми же шагами, что и у транспорта (mcp1c_МетодыMCP): политика клиента, остаток его
// суточной квоты строк, те же инструменты, маски и ограничения. Частоту вызовов и квоту песочница
// не расходует, в журнал вызовов не пишет и в автоблокировке клиента не участвует. То, что помешало
// бы клиенту получить ответ (блокировка, окно времени, нет токенов, сервер выключен, превышена
// частота), показывается предупреждениями. Каждый вызов - событие MCP.Песочница в журнале регистрации.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет метод MCP от имени клиента доступа.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент.
//  Метод - Строка - tools/list, tools/call, resources/list, resources/templates/list, resources/read,
//          prompts/list или prompts/get.
//  Параметры - Соответствие из КлючИЗначение, Строка, Неопределено - params запроса: для tools/call - name
//              и arguments, для resources/read - uri, для prompts/get - name и arguments; строка - JSON.
//
// Возвращаемое значение:
//  см. НовыйИтог
//
Функция Выполнить(Клиент, Метод, Знач Параметры = Неопределено) Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.mcp1c_КлиентыДоступа") Или Клиент.Пустая() Тогда
		ВызватьИсключение "Не вказано клієнта доступу";
	ИначеЕсли mcp1c_МетодыMCP.Методы().Найти(Метод) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пісочниця виконує методи %1", СтрСоединить(mcp1c_МетодыMCP.Методы(), ", "));
	КонецЕсли;
	Если ТипЗнч(Параметры) = Тип("Строка") Тогда
		Параметры = ?(ПустаяСтрока(Параметры), Новый Соответствие, mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Параметры));
	ИначеЕсли Параметры = Неопределено Тогда
		Параметры = Новый Соответствие;
	КонецЕсли;
	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Параметри виклику (params) мають бути об'єктом JSON";
	КонецЕсли;

	Итог = НовыйИтог(Метод);
	Настройки = mcp1c_Настройки.Получить();
	Контекст = КонтекстКлиента(Клиент, Метод, Настройки);
	ДобавитьПредупрежденияКлиента(Итог, Клиент, Настройки);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Вызов = mcp1c_МетодыMCP.Подготовить(Метод, Параметры, Контекст);
	Если Вызов.КодОшибки = 0 И Вызов.РасходуетЧастоту Тогда
		ПроверитьЛимиты(Итог, Вызов, Контекст);
	КонецЕсли;
	Попытка
		Результат = mcp1c_МетодыMCP.Выполнить(Вызов, Контекст);
	Исключение
		// Так же отвечает транспорт: подробности - только администратору и в журнал регистрации.
		Контекст.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Корреляция = Новый Соответствие;
		Корреляция.Вставить("requestId", Контекст.ИдентификаторЗапроса);
		Результат = mcp1c_МетодыMCP.НовыйИтог(mcp1c_МетодыMCP.КодВнутренняяОшибка(), "Internal error", Корреляция);
	КонецПопытки;
	Контекст.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	ЗаполнитьИтог(Итог, Результат, Вызов, Контекст);
	ЗаписатьСобытие(Итог, Контекст);
	Возврат Итог;

КонецФункции

// Результат вызова из песочницы.
//
// Параметры:
//  Метод - Строка - метод MCP.
//
// Возвращаемое значение:
//  Структура:
//   * Метод - Строка - метод MCP.
//   * Клиент - Строка - наименование клиента.
//   * Инструмент - Строка - инструмент, промпт или URI ресурса.
//   * Ответ - Соответствие из КлючИЗначение - то, что получит клиент: result или {"error": {code, message, data}}.
//   * ЕстьОшибка - Булево - ответ - ошибка JSON-RPC.
//   * ОшибкаИнструмента - Булево - результат инструмента с isError.
//   * Правила - Массив из Строка - примененные правила профиля.
//   * Предупреждения - Массив из Строка - что помешало бы клиенту получить этот ответ.
//   * Объекты - Массив из Строка - таблицы, к которым обращался вызов.
//   * Аргументы - Строка - аргументы для журнала.
//   * КоличествоСтрок - Число - строк в ответе.
//   * РазмерОтвета - Число - размер structuredContent в байтах.
//   * ОтказДоступа - Булево - отказ политики (клиенту засчитался бы в автоблокировку).
//   * Причина - Строка - причина отказа, которую увидел бы журнал вызовов.
//   * ТекстОшибки - Строка - подробности внутренней ошибки (только администратору).
//   * ДлительностьМс - Число - длительность выполнения.
//
Функция НовыйИтог(Метод) Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Метод", Метод);
	Итог.Вставить("Клиент", "");
	Итог.Вставить("Инструмент", "");
	Итог.Вставить("Ответ", Новый Соответствие);
	Итог.Вставить("ЕстьОшибка", Ложь);
	Итог.Вставить("ОшибкаИнструмента", Ложь);
	Итог.Вставить("Правила", Новый Массив);
	Итог.Вставить("Предупреждения", Новый Массив);
	Итог.Вставить("Объекты", Новый Массив);
	Итог.Вставить("Аргументы", "");
	Итог.Вставить("КоличествоСтрок", 0);
	Итог.Вставить("РазмерОтвета", 0);
	Итог.Вставить("ОтказДоступа", Ложь);
	Итог.Вставить("Причина", "");
	Итог.Вставить("ТекстОшибки", "");
	Итог.Вставить("ДлительностьМс", 0);
	Возврат Итог;

КонецФункции

// Вызовы, доступные клиенту, - для выбора в диалоге песочницы: списки, инструменты, ресурсы и промпты.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент.
//
// Возвращаемое значение:
//  Массив из см. НовыйВариантВызова
//
Функция ДоступныеВызовы(Клиент) Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Политика = mcp1c_Политики.ПолитикаКлиента(Клиент, mcp1c_Настройки.Получить());
	Результат = Новый Массив;
	Для Каждого Метод Из СтрРазделить("tools/list,resources/list,resources/templates/list,prompts/list", ",") Цикл
		Результат.Добавить(НовыйВариантВызова(Метод, Метод, "", ""));
	КонецЦикла;
	Для Каждого Описание Из mcp1c_Инструменты.ОписанияИнструментов(Политика) Цикл
		Имя = Строка(Описание.Получить("name"));
		Результат.Добавить(НовыйВариантВызова(СтрШаблон("tools/call: %1 - %2", Имя, Описание.Получить("title")),
			"tools/call", Имя, ПримерАргументов(Описание.Получить("inputSchema"))));
	КонецЦикла;
	Для Каждого Описание Из mcp1c_ОписанияРесурсов.ОписанияРесурсов(Политика) Цикл
		URI = Строка(Описание.Получить("uri"));
		Результат.Добавить(НовыйВариантВызова("resources/read: " + URI, "resources/read", "", URI));
	КонецЦикла;
	Для Каждого Описание Из mcp1c_ОписанияРесурсов.ШаблоныРесурсов(Политика) Цикл
		Шаблон = Строка(Описание.Получить("uriTemplate"));
		Результат.Добавить(НовыйВариантВызова("resources/read: " + Шаблон, "resources/read", "", Шаблон));
	КонецЦикла;
	Для Каждого Описание Из mcp1c_РесурсыИПромпты.СписокПромптов(Политика) Цикл
		Имя = Строка(Описание.Получить("name"));
		Результат.Добавить(НовыйВариантВызова("prompts/get: " + Имя, "prompts/get", Имя,
			ПримерАргументовПромпта(Описание.Получить("arguments"))));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Параметры запроса для метода из того, что ввел администратор.
//
// Параметры:
//  Метод - Строка - метод MCP.
//  Имя - Строка - инструмент или промпт.
//  Текст - Строка - arguments в JSON или uri ресурса.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - params запроса.
//
Функция ПараметрыВызова(Метод, Имя, Текст) Экспорт

	Параметры = Новый Соответствие;
	Если Метод = "resources/read" Тогда
		Параметры.Вставить("uri", СокрЛП(Текст));
	ИначеЕсли Метод = "tools/call" Или Метод = "prompts/get" Тогда
		Параметры.Вставить("name", Имя);
		Если Не ПустаяСтрока(Текст) Тогда
			Попытка
				Аргументы = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
			Исключение
				ВызватьИсключение "Аргументи - некоректний JSON: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
			Параметры.Вставить("arguments", Аргументы);
		КонецЕсли;
	КонецЕсли;
	Возврат Параметры;

КонецФункции

// Текст отчета песочницы: предупреждения, примененные правила, сведения журнала и ответ модели.
//
// Параметры:
//  Итог - см. НовыйИтог
//
// Возвращаемое значение:
//  Строка - отчет.
//
Функция ТекстОтчета(Итог) Экспорт

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Пісочниця MCP: клієнт «%1», %2%3", Итог.Клиент, Итог.Метод,
		?(ПустаяСтрока(Итог.Инструмент), "", " " + Итог.Инструмент)));
	Строки.Добавить("Нижче - відповідь, яку отримає модель (без транспортних полів _meta і resultType). "
		+ "Частота викликів і квота клієнта не витрачаються.");
	ДобавитьРаздел(Строки, "Попередження", Итог.Предупреждения);
	ДобавитьРаздел(Строки, "Застосовані правила", Итог.Правила);

	Журнал = Новый Массив;
	Если Итог.Объекты.Количество() > 0 Тогда
		Журнал.Добавить("об'єкти: " + СтрСоединить(Итог.Объекты, ", "));
	КонецЕсли;
	Журнал.Добавить(СтрШаблон("рядків: %1, розмір: %2 байт, тривалість: %3 мс",
		Формат(Итог.КоличествоСтрок, "ЧН=0; ЧГ=0"), Формат(Итог.РазмерОтвета, "ЧН=0; ЧГ=0"),
		Формат(Итог.ДлительностьМс, "ЧН=0; ЧГ=0")));
	Если Итог.ОтказДоступа Тогда
		Журнал.Добавить("відмова політики: клієнту зарахувалася б в автоблокування");
	КонецЕсли;
	Если Не ПустаяСтрока(Итог.Причина) Тогда
		Журнал.Добавить("причина: " + Итог.Причина);
	КонецЕсли;
	Если Не ПустаяСтрока(Итог.Аргументы) Тогда
		Журнал.Добавить("аргументи: " + Итог.Аргументы);
	КонецЕсли;
	ДобавитьРаздел(Строки, "Журнал викликів записав би", Журнал);
	Если Не ПустаяСтрока(Итог.ТекстОшибки) Тогда
		ДобавитьРаздел(Строки, "Внутрішня помилка (лише для адміністратора)", СтрРазделить(Итог.ТекстОшибки, Символы.ПС));
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить(?(Итог.ЕстьОшибка, "Відповідь (помилка JSON-RPC):", "Відповідь (result):"));
	Строки.Добавить(mcp1c_Сериализация.ФорматированныйJSON(Итог.Ответ));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонтекстКлиента(Клиент, Метод, Настройки)
	// Контекст вызова, как после аутентификации токеном клиента в редакции 2026-07-28.

	Контекст = mcp1c_Инструменты.НовыйКонтекстВызова();
	Контекст.Настройки = Настройки;
	Контекст.КлиентСсылка = Клиент;
	Контекст.Эпоха = "modern";
	Контекст.ВерсияПротокола = "2026-07-28";
	Контекст.МетодRPC = Метод;
	Контекст.ИнформацияКлиента = "mcp1c sandbox";
	Контекст.Политика = mcp1c_Политики.ПолитикаКлиента(Клиент, Настройки);
	Контекст.ПолитикаЗагружена = Истина;
	Контекст.Клиент = Контекст.Политика.ИмяКлиента;
	Возврат Контекст;

КонецФункции

Процедура ДобавитьПредупрежденияКлиента(Итог, Клиент, Настройки)
	// Ограничения клиента, из-за которых он не получил бы ответ (п. 4.4, 7.1 ТЗ).

	Предупреждения = Итог.Предупреждения;
	Если Не mcp1c_Служебный.СвойствоБулево(Настройки, "enabled") Тогда
		Предупреждения.Добавить("Сервер вимкнено: клієнти зараз отримують 503");
	КонецЕсли;

	Данные = ДанныеКлиента(Клиент);
	Если Данные = Неопределено Тогда
		Предупреждения.Добавить("Клієнта не знайдено");
		Возврат;
	КонецЕсли;
	Если Данные.Заблокирован Или Данные.ПометкаУдаления Тогда
		Предупреждения.Добавить("Клієнта заблоковано або позначено на вилучення: модель отримала б 403");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Данные.Профиль) Тогда
		Предупреждения.Добавить("Клієнту не призначено профіль: модель отримала б 403");
	КонецЕсли;
	Секунд = mcp1c_Лимиты.ОсталосьБлокировкиКлиента(Клиент);
	Если Секунд > 0 Тогда
		Предупреждения.Добавить(СтрШаблон("Клієнта автоматично заблоковано після відмов політики ще на %1 с: "
			+ "модель отримала б 403", Формат(Секунд, "ЧН=0; ЧГ=0")));
	КонецЕсли;
	Если Не mcp1c_Аутентификация.ВремяВОкне(ТекущаяДатаСеанса(), Данные.ДоступС, Данные.ДоступПо) Тогда
		Предупреждения.Добавить(СтрШаблон("Зараз поза вікном доступу клієнта (%1 - %2): модель отримала б 403",
			Формат(Данные.ДоступС, "ДФ=HH:mm; ДП=00:00"), Формат(Данные.ДоступПо, "ДФ=HH:mm; ДП=00:00")));
	КонецЕсли;
	Если Не ПустаяСтрока(Данные.РазрешенныеАдреса) Тогда
		Предупреждения.Добавить("Клієнту дозволено лише адреси " + СокрЛП(Данные.РазрешенныеАдреса)
			+ ": виклики з інших IP отримають 403");
	КонецЕсли;
	Если Данные.ДействующихТокенов = 0 Тогда
		Предупреждения.Добавить("У клієнта немає дійсних токенів: підключитися він не зможе");
	КонецЕсли;
	Если Данные.ВнешнийПровайдер Тогда
		Предупреждения.Добавить("Клієнт - зовнішній AI-провайдер: ця відповідь піде провайдеру моделі");
	КонецЕсли;

КонецПроцедуры

Функция ДанныеКлиента(Клиент)
	// Ограничения клиента и число действующих токенов.

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Клиенты.Профиль КАК Профиль,
	|	Клиенты.Заблокирован КАК Заблокирован,
	|	Клиенты.ПометкаУдаления КАК ПометкаУдаления,
	|	Клиенты.ДоступС КАК ДоступС,
	|	Клиенты.ДоступПо КАК ДоступПо,
	|	Клиенты.РазрешенныеАдреса КАК РазрешенныеАдреса,
	|	Клиенты.ВнешнийПровайдер КАК ВнешнийПровайдер,
	|	ЕСТЬNULL(Токены.Количество, 0) КАК ДействующихТокенов
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т.Владелец КАК Владелец,
	|			КОЛИЧЕСТВО(*) КАК Количество
	|		ИЗ
	|			Справочник.mcp1c_ТокеныДоступа КАК Т
	|		ГДЕ
	|			Т.Владелец = &Клиент
	|			И НЕ Т.Отозван
	|			И НЕ Т.ПометкаУдаления
	|			И Т.ДействуетДо > &Сейчас
	|		СГРУППИРОВАТЬ ПО
	|			Т.Владелец) КАК Токены
	|		ПО Клиенты.Ссылка = Токены.Владелец
	|ГДЕ
	|	Клиенты.Ссылка = &Клиент");
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = Новый Структура("Профиль, Заблокирован, ПометкаУдаления, ДоступС, ДоступПо, РазрешенныеАдреса, "
		+ "ВнешнийПровайдер, ДействующихТокенов");
	ЗаполнитьЗначенияСвойств(Данные, Выборка);
	Возврат Данные;

КонецФункции

Процедура ПроверитьЛимиты(Итог, Вызов, Контекст)
	// Частота и квота клиента не расходуются; остаток квоты ограничивает строки, как у клиента.

	Секунд = mcp1c_Лимиты.ПревышениеЧастоты(Контекст.Политика);
	Если Секунд > 0 Тогда
		Итог.Предупреждения.Добавить(СтрШаблон("Частоту викликів вичерпано: модель зараз отримала б 429 "
			+ "(Retry-After %1 с)", Формат(Секунд, "ЧН=0; ЧГ=0")));
	КонецЕсли;
	Если Не Вызов.РасходуетКвоту Тогда
		Возврат;
	КонецЕсли;
	Квота = mcp1c_Лимиты.ОстатокКвотыСтрок(Контекст.Политика);
	Если Квота.Остаток > 0 Тогда
		Контекст.ОстатокКвотыСтрок = Квота.Остаток;
	Иначе
		Итог.Предупреждения.Добавить("Добову квоту рядків вичерпано: модель отримала б 429; пісочниця виконує "
			+ "виклик без обмеження квотою");
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьИтог(Итог, Результат, Вызов, Контекст)

	Итог.Клиент = Контекст.Клиент;
	Итог.Инструмент = Контекст.Инструмент;
	Если Результат.КодОшибки = 0 Тогда
		Итог.Ответ = Результат.Результат;
	Иначе
		Ошибка = Новый Соответствие;
		Ошибка.Вставить("code", Результат.КодОшибки);
		Ошибка.Вставить("message", Результат.СообщениеОшибки);
		Если Результат.ДанныеОшибки <> Неопределено Тогда
			Ошибка.Вставить("data", Результат.ДанныеОшибки);
		КонецЕсли;
		Итог.Ответ.Вставить("error", Ошибка);
		Итог.ЕстьОшибка = Истина;
	КонецЕсли;
	Итог.ОшибкаИнструмента = Контекст.ОшибкаИнструмента;
	Итог.Правила = mcp1c_ПравилаДоступа.ПримененныеПравила(Контекст.Политика, ИнструментВызова(Вызов),
		Контекст.Объекты);
	Итог.Объекты = Контекст.Объекты;
	Итог.Аргументы = Контекст.Аргументы;
	Итог.КоличествоСтрок = Контекст.КоличествоСтрок;
	Итог.РазмерОтвета = Контекст.РазмерОтвета;
	Итог.ОтказДоступа = Контекст.ОтказДоступа;
	Итог.Причина = Контекст.Причина;
	Итог.ТекстОшибки = Контекст.ТекстОшибки;
	Итог.ДлительностьМс = Контекст.ДлительностьМс;

КонецПроцедуры

Функция ИнструментВызова(Вызов)
	// Инструмент, правила которого показываются: для ресурса - инструмент, который дает его содержимое.

	Если Вызов.Метод = "tools/call" Тогда
		Возврат Вызов.Имя;
	ИначеЕсли Вызов.Метод = "resources/read" Тогда
		Возврат mcp1c_ОписанияРесурсов.ИнструментРесурса(Вызов.Разбор);
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура ЗаписатьСобытие(Итог, Контекст)

	Подробности = Новый Массив;
	Если Не ПустаяСтрока(Итог.Аргументы) Тогда
		Подробности.Добавить("Аргументы: " + Итог.Аргументы);
	КонецЕсли;
	Если Итог.Объекты.Количество() > 0 Тогда
		Подробности.Добавить("Объекты: " + СтрСоединить(Итог.Объекты, ", "));
	КонецЕсли;
	Подробности.Добавить(СтрШаблон("Строк: %1", Формат(Итог.КоличествоСтрок, "ЧН=0; ЧГ=0")));
	mcp1c_Аудит.ЗаписатьСобытиеПесочницы(СтрШаблон("Пользователь %1 выполнил в песочнице %2 %3 от имени клиента %4",
		ИмяПользователя(), Итог.Метод, Итог.Инструмент, Итог.Клиент), СтрСоединить(Подробности, Символы.ПС));
	Если Не ПустаяСтрока(Контекст.ТекстОшибки) Тогда
		mcp1c_Аудит.ЗаписатьОшибку("Ошибка вызова в песочнице " + Итог.Метод + " " + Итог.Инструмент,
			Контекст.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

// Вариант вызова для выбора в песочнице.
//
// Параметры:
//  Представление - Строка - строка списка выбора.
//  Метод - Строка - метод MCP.
//  Имя - Строка - инструмент или промпт.
//  Пример - Строка - пример arguments (JSON) или uri ресурса; пустая строка - вызов без параметров.
//
// Возвращаемое значение:
//  Структура:
//   * Представление - Строка - строка списка выбора.
//   * Метод - Строка - метод MCP.
//   * Имя - Строка - инструмент или промпт.
//   * Пример - Строка - пример arguments или uri.
//
Функция НовыйВариантВызова(Представление, Метод, Имя, Пример)

	Возврат Новый Структура("Представление, Метод, Имя, Пример", Представление, Метод, Имя, Пример);

КонецФункции

Функция ПримерАргументов(Схема)
	// Обязательные аргументы из inputSchema с пустыми значениями нужного типа.

	Пример = Новый Соответствие;
	Если ТипЗнч(Схема) = Тип("Соответствие") Тогда
		Свойства = Схема.Получить("properties");
		Обязательные = Схема.Получить("required");
		Если ТипЗнч(Свойства) = Тип("Соответствие") И ТипЗнч(Обязательные) = Тип("Массив") Тогда
			Для Каждого Имя Из Обязательные Цикл
				Пример.Вставить(Имя, ПустоеЗначениеСвойства(Свойства.Получить(Имя)));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат mcp1c_Сериализация.ФорматированныйJSON(Пример);

КонецФункции

Функция ПустоеЗначениеСвойства(Свойство)

	ТипЗначения = ?(ТипЗнч(Свойство) = Тип("Соответствие"), Свойство.Получить("type"), Неопределено);
	Если ТипЗначения = "integer" Или ТипЗначения = "number" Тогда
		Возврат 0;
	ИначеЕсли ТипЗначения = "boolean" Тогда
		Возврат Ложь;
	ИначеЕсли ТипЗначения = "array" Тогда
		Возврат Новый Массив;
	ИначеЕсли ТипЗначения = "object" Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПримерАргументовПромпта(Аргументы)
	// Обязательные аргументы промпта - строки.

	Пример = Новый Соответствие;
	Если ТипЗнч(Аргументы) = Тип("Массив") Тогда
		Для Каждого Аргумент Из Аргументы Цикл
			Если ТипЗнч(Аргумент) = Тип("Соответствие") И Аргумент.Получить("required") = Истина Тогда
				Пример.Вставить(Аргумент.Получить("name"), "");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат mcp1c_Сериализация.ФорматированныйJSON(Пример);

КонецФункции

Процедура ДобавитьРаздел(Строки, Заголовок, Элементы)

	Если Элементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Строки.Добавить("");
	Строки.Добавить(Заголовок + ":");
	Для Каждого Элемент Из Элементы Цикл
		Строки.Добавить("  " + Элемент);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

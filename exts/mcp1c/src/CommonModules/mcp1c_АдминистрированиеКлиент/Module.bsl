///////////////////////////////////////////////////////////////////////////////
// mcp1c_АдминистрированиеКлиент: диалоги команд администрирования MCP-сервера
// (выпуск и отзыв токенов, состояние сервера) без собственных форм.
// Права проверяет сервер (mcp1c_Администрирование).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Запрашивает срок действия и выпускает токен для клиента доступа.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент.
//
Процедура ВыпуститьТокен(Клиент) Экспорт

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Структура("Клиент", Клиент);
	Оповещение = Новый ОписаниеОповещения("ВыпуститьТокенПослеВводаСрока", ЭтотОбъект, Параметры);
	ПоказатьВводЧисла(Оповещение, 30, НСтр("ru = 'Срок действия токена, дней'"), 3, 0);

КонецПроцедуры

// Отзывает токен после подтверждения.
//
// Параметры:
//  Токен - СправочникСсылка.mcp1c_ТокеныДоступа - токен.
//
Процедура ОтозватьТокен(Токен) Экспорт

	Если Не ЗначениеЗаполнено(Токен) Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Структура("Токен", Токен);
	Оповещение = Новый ОписаниеОповещения("ОтозватьТокенПослеПодтверждения", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Відкликати токен? Клієнт втратить доступ з наступного запиту.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// Показывает состояние сервера и предлагает доступные действия.
//
Процедура ПоказатьСостояниеСервера() Экспорт

	Состояние = mcp1c_АдминистрированиеВызовСервера.СостояниеСервера();
	Кнопки = Новый СписокЗначений;
	Если Состояние.ЕстьПраваАдминистратора Тогда
		Если Состояние.Включен Тогда
			Кнопки.Добавить("Выключить", НСтр("ru = 'Вимкнути'"));
		Иначе
			Кнопки.Добавить("Включить", НСтр("ru = 'Увімкнути'"));
		КонецЕсли;
		Если Состояние.ТребуетсяПодтверждениеПереноса Тогда
			Кнопки.Добавить("ПодтвердитьПеренос", НСтр("ru = 'Підтвердити перенесення бази'"));
		КонецЕсли;
	КонецЕсли;
	Кнопки.Добавить("Закрыть", НСтр("ru = 'Закрити'"));

	Оповещение = Новый ОписаниеОповещения("ПоказатьСостояниеСервераПослеВыбора", ЭтотОбъект, Состояние);
	ПоказатьВопрос(Оповещение, Состояние.Текст, Кнопки, , "Закрыть", НСтр("ru = 'MCP-сервер'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик ввода срока действия токена.
//
// Параметры:
//  СрокДействияДней - Число, Неопределено - введенный срок.
//  Параметры - Структура - параметры с клиентом.
//
Процедура ВыпуститьТокенПослеВводаСрока(СрокДействияДней, Параметры) Экспорт

	Если СрокДействияДней = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Выпуск = mcp1c_АдминистрированиеВызовСервера.ВыпуститьТокен(Параметры.Клиент, СрокДействияДней);
	ОповеститьОбИзменении(Тип("СправочникСсылка.mcp1c_ТокеныДоступа"));
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ЗавершитьБезДействий", ЭтотОбъект), Выпуск.Текст,
		НСтр("ru = 'Токен показується один раз: скопіюйте його зараз'"), , Истина);

КонецПроцедуры

// Обработчик подтверждения отзыва токена.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  Параметры - Структура - параметры с токеном.
//
Процедура ОтозватьТокенПослеПодтверждения(Ответ, Параметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеВызовСервера.ОтозватьТокен(Параметры.Токен);
	ОповеститьОбИзменении(Параметры.Токен);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Токен відкликано'"));

КонецПроцедуры

// Обработчик выбора действия в окне состояния сервера.
//
// Параметры:
//  Действие - Строка, Неопределено - выбранное действие.
//  Состояние - Структура - см. mcp1c_АдминистрированиеВызовСервера.СостояниеСервера.
//
Процедура ПоказатьСостояниеСервераПослеВыбора(Действие, Состояние) Экспорт

	Если Действие = "Включить" Тогда
		Оповещение = Новый ОписаниеОповещения("ВключитьСерверПослеВводаАдреса", ЭтотОбъект);
		ПоказатьВводСтроки(Оповещение, Состояние.КаноническийАдрес,
			НСтр("ru = 'Публічна адреса MCP-ендпоінта, наприклад https://mcp.company.ua/mcp'"), 500, Ложь);
	ИначеЕсли Действие = "Выключить" Тогда
		mcp1c_АдминистрированиеВызовСервера.ВыключитьСервер();
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP-сервер вимкнено'"));
	ИначеЕсли Действие = "ПодтвердитьПеренос" Тогда
		Оповещение = Новый ОписаниеОповещения("ПодтвердитьПереносПослеОтвета", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			НСтр("ru = 'Підтвердити нове розташування бази? Усі токени буде відкликано, нову прив''язку зафіксує наступний запит.'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	КонецЕсли;

КонецПроцедуры

// Обработчик ввода канонического адреса при включении сервера.
//
// Параметры:
//  Адрес - Строка, Неопределено - введенный адрес.
//  ДополнительныеПараметры - Неопределено - не используется.
//
Процедура ВключитьСерверПослеВводаАдреса(Адрес, ДополнительныеПараметры) Экспорт

	Если Адрес = Неопределено Тогда
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеВызовСервера.ВключитьСервер(Адрес);
	ПоказатьОповещениеПользователя(НСтр("ru = 'MCP-сервер увімкнено'"));

КонецПроцедуры

// Обработчик подтверждения переноса информационной базы.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
Процедура ПодтвердитьПереносПослеОтвета(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеВызовСервера.ПодтвердитьПереносИнформационнойБазы();
	ОповеститьОбИзменении(Тип("СправочникСсылка.mcp1c_ТокеныДоступа"));
	ПоказатьОповещениеПользователя(НСтр("ru = 'Перенесення бази підтверджено, токени відкликано'"));

КонецПроцедуры

// Пустой обработчик закрытия диалога.
//
// Параметры:
//  Результат - Произвольный - результат диалога.
//  ДополнительныеПараметры - Неопределено - не используется.
//
Процедура ЗавершитьБезДействий(Результат, ДополнительныеПараметры) Экспорт

	Возврат;

КонецПроцедуры

#КонецОбласти

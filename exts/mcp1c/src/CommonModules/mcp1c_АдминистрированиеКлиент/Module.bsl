///////////////////////////////////////////////////////////////////////////////
// mcp1c_АдминистрированиеКлиент: команды администрирования MCP-сервера - открытие форм выпуска
// токена и песочницы, отзыв токена, анализ рисков, выгрузка и загрузка настроек (отчеты
// показываются текстовым документом). Состояние сервера - на рабочем месте (mcp1c_РабочееМесто).
// Права проверяет сервер (mcp1c_Администрирование).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Открывает форму выпуска токена для клиента доступа: срок, комментарий, область, токен и фрагменты
// подключения (п. 6.3, 9.3 ТЗ).
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент.
//
Процедура ВыпуститьТокен(Клиент) Экспорт

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат;
	КонецЕсли;
	ОткрытьФорму("ОбщаяФорма.mcp1c_ВыпускТокена", Новый Структура("Клиент", Клиент), , Клиент);

КонецПроцедуры

// Отзывает токен после подтверждения.
//
// Параметры:
//  Токен - СправочникСсылка.mcp1c_ТокеныДоступа - токен.
//
Процедура ОтозватьТокен(Токен) Экспорт

	Если Не ЗначениеЗаполнено(Токен) Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Структура("Токен", Токен);
	Оповещение = Новый ОписаниеОповещения("ОтозватьТокенПослеПодтверждения", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение,
		"Відкликати токен? Клієнт втратить доступ з наступного запиту.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// Имя события оповещения после выпуска или отзыва токена: формы со списком токенов обновляют его.
// Параметр оповещения - клиент (выпуск) или токен (отзыв).
//
// Возвращаемое значение:
//  Строка - имя события.
//
Функция СобытиеИзменениеТокенов() Экспорт

	Возврат "mcp1c_ИзменениеТокенов";

КонецФункции

// Имя события оповещения, которым команда «Аналіз ризиків» передает анализ открытой форме профиля: форма
// анализирует свои данные, в том числе не записанные, и отмечает в параметре, что анализ выполнен.
//
// Возвращаемое значение:
//  Строка - имя события.
//
Функция СобытиеАнализРисковПрофиля() Экспорт

	Возврат "mcp1c_АнализРисковПрофиля";

КонецФункции

// Открывает песочницу (п. 9.2 ТЗ): вызов от имени клиента, ответ модели и примененные правила.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент.
//
Процедура ОткрытьПесочницу(Клиент) Экспорт

	ОткрытьФорму("ОбщаяФорма.mcp1c_Песочница", Новый Структура("Клиент", Клиент), , Клиент);

КонецПроцедуры

// Анализ рисков профиля и предложение замаскировать чувствительные поля.
//
// Параметры:
//  Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа - профиль.
//
Процедура ПоказатьАнализРисков(Профиль) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат;
	КонецЕсли;
	Анализ = mcp1c_АдминистрированиеВызовСервера.АнализРисковПрофиля(Профиль);
	ПоказатьТекст(Анализ.Текст, "Аналіз ризиків профілю");
	Если Анализ.БезМаски > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗамаскироватьПослеВопроса", ЭтотОбъект, Профиль),
			СтрШаблон("Замаскувати %1 чутливих полів рекомендованими масками в цьому профілі?", Анализ.БезМаски),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	КонецЕсли;

КонецПроцедуры

// Кандидаты в чувствительные поля по всей конфигурации.
//
Процедура ПоказатьЧувствительныеПоля() Экспорт

	ПоказатьТекст(mcp1c_АдминистрированиеВызовСервера.ОтчетЧувствительныхПолей(), "Чутливі поля");

КонецПроцедуры

// Выгрузка настроек в JSON: текст показывается документом, его можно сохранить в файл.
//
Процедура ВыгрузитьНастройки() Экспорт

	ПоказатьТекст(mcp1c_АдминистрированиеВызовСервера.ВыгрузитьНастройки(), "Налаштування MCP (JSON)");

КонецПроцедуры

// Загрузка настроек из файла JSON: проверка, подтверждение, запись.
//
Процедура ЗагрузитьНастройки() Экспорт

	НачатьПомещениеФайла(Новый ОписаниеОповещения("ЗагрузитьНастройкиПослеПомещенияФайла", ЭтотОбъект), , , Истина,
		Новый УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик подтверждения отзыва токена.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  Параметры - Структура - параметры с токеном.
//
Процедура ОтозватьТокенПослеПодтверждения(Ответ, Параметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеВызовСервера.ОтозватьТокен(Параметры.Токен);
	ОповеститьОбИзменении(Параметры.Токен);
	Оповестить(СобытиеИзменениеТокенов(), Параметры.Токен);
	ПоказатьОповещениеПользователя("Токен відкликано");

КонецПроцедуры

// Обработчик ответа на предложение замаскировать чувствительные поля.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа - профиль.
//
Процедура ЗамаскироватьПослеВопроса(Ответ, Профиль) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Добавлено = mcp1c_АдминистрированиеВызовСервера.ЗамаскироватьЧувствительныеПоля(Профиль);
	ОповеститьОбИзменении(Профиль);
	ПоказатьОповещениеПользователя(СтрШаблон("Додано правил маскування: %1", Добавлено));

КонецПроцедуры

// Обработчик выбора файла настроек для загрузки.
//
// Параметры:
//  Результат - Булево - файл помещен.
//  Адрес - Строка - адрес во временном хранилище.
//  ВыбранноеИмяФайла - Строка - имя файла.
//  ДополнительныеПараметры - Неопределено - не используется.
//
Процедура ЗагрузитьНастройкиПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	Текст = mcp1c_АдминистрированиеВызовСервера.ТекстФайла(Адрес);
	Проверка = mcp1c_АдминистрированиеВызовСервера.ЗагрузитьНастройки(Текст, Истина);
	Если Не Проверка.Успех Тогда
		ПоказатьТекст(Проверка.Текст, "Завантаження налаштувань MCP: помилки");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗагрузитьНастройкиПослеПодтверждения", ЭтотОбъект, Текст),
		Проверка.Текст + Символы.ПС + Символы.ПС + "Завантажити налаштування?", РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет, "Завантаження налаштувань MCP");

КонецПроцедуры

// Обработчик подтверждения загрузки настроек.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  Текст - Строка - документ JSON.
//
Процедура ЗагрузитьНастройкиПослеПодтверждения(Ответ, Текст) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Итог = mcp1c_АдминистрированиеВызовСервера.ЗагрузитьНастройки(Текст, Ложь);
	Если Итог.Успех Тогда
		ОповеститьОбИзменении(Тип("СправочникСсылка.mcp1c_ПрофилиДоступа"));
		ОповеститьОбИзменении(Тип("СправочникСсылка.mcp1c_ПользовательскиеИнструменты"));
		ОповеститьОбИзменении(Тип("СправочникСсылка.mcp1c_Промпты"));
		ПоказатьОповещениеПользователя("Налаштування MCP завантажено");
	Иначе
		ПоказатьТекст(Итог.Текст, "Завантаження налаштувань MCP: помилки");
	КонецЕсли;

КонецПроцедуры

Процедура ПоказатьТекст(Текст, Заголовок)

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Текст);
	Документ.Показать(Заголовок);

КонецПроцедуры

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// mcp1c_Маскирование: маски значений полей в ответах (п. 7.4 ТЗ).
//
// Маска применяется к значению, уже приведенному к JSON (см. mcp1c_Значения.ЗначениеВJSON):
//  full - "***";
//  partial - "***" и последние N символов (для ссылок - символы представления); если значение
//            не длиннее N символов - "***";
//  hash - "h:" и 12 символов SHA-256 значения с солью профиля: одинаковые значения дают
//         одинаковый хеш, по которому можно сопоставлять строки, не видя значений;
//  round - число, округленное до шага; значения других типов - полная маска.
// Пустое значение (null) остается пустым.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Маска поля.
//
// Параметры:
//  Вид - Строка - full, partial, hash или round; неизвестный вид - full.
//  Параметр - Число - для partial - сколько последних символов показать (0 - 4), для round - шаг (0 - 1000).
//
// Возвращаемое значение:
//  Структура:
//   * Вид - Строка - вид маски.
//   * Параметр - Число - число видимых символов для partial, шаг для round, 0 для остальных.
//
Функция НоваяМаска(Знач Вид, Знач Параметр = 0) Экспорт

	Если ВидыМасок().Найти(Вид) = Неопределено Тогда
		Вид = "full";
	КонецЕсли;
	Если ТипЗнч(Параметр) <> Тип("Число") Или Параметр < 0 Тогда
		Параметр = 0;
	КонецЕсли;
	Если Вид = "partial" Тогда
		Параметр = ?(Параметр = 0, 4, Цел(Параметр));
		Параметр = ?(Параметр = 0, 1, Параметр);
	ИначеЕсли Вид = "round" Тогда
		Параметр = ?(Параметр = 0, 1000, Параметр);
	Иначе
		Параметр = 0;
	КонецЕсли;

	Маска = Новый Структура;
	Маска.Вставить("Вид", Вид);
	Маска.Вставить("Параметр", Параметр);
	Возврат Маска;

КонецФункции

// Виды масок.
//
// Возвращаемое значение:
//  Массив из Строка - full, partial, hash, round.
//
Функция ВидыМасок() Экспорт

	Возврат СтрРазделить("full,partial,hash,round", ",");

КонецФункции

// Значение в формате JSON после маски.
//
// Параметры:
//  Значение - Строка, Число, Булево, Неопределено, Соответствие из КлючИЗначение - значение в формате JSON
//             (ссылка - {"type", "ref", "presentation"}, перечисление - {"type", "value", "presentation"}).
//  Маска - см. НоваяМаска
//  Соль - Строка - соль профиля для хеша.
//  КлючХеша - Строка - каноническое представление исходного значения для хеша (для ссылки - тип
//             и идентификатор, для строки - строка без обрезки); пустая строка - по значению JSON.
//
// Возвращаемое значение:
//  Строка, Число, Неопределено - замаскированное значение; Неопределено для пустого значения.
//
Функция ЗамаскированноеЗначение(Значение, Маска, Соль, КлючХеша = "") Экспорт

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вид = Маска.Вид;
	Если Вид = "round" Тогда
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Округлить(Значение, Маска.Параметр);
		КонецЕсли;
	ИначеЕсли Вид = "hash" Тогда
		Ключ = ?(ПустаяСтрока(КлючХеша), КлючЗначения(Значение), КлючХеша);
		Возврат ПрефиксХеша() + Лев(mcp1c_Служебный.ХешSHA256(Ключ + Соль), 12);
	ИначеЕсли Вид = "partial" Тогда
		Возврат ЧастичнаяМаска(Значение, Маска.Параметр);
	КонецЕсли;
	Возврат ПолнаяМаска();

КонецФункции

// Округляет число до шага маски round: 12345.67 с шагом 1000 - 12000.
//
// Параметры:
//  Значение - Число - число.
//  Шаг - Число - шаг округления; 0 и меньше - 1000.
//
// Возвращаемое значение:
//  Число - округленное число.
//
Функция Округлить(Значение, Знач Шаг) Экспорт

	Если ТипЗнч(Шаг) <> Тип("Число") Или Шаг <= 0 Тогда
		Шаг = 1000;
	КонецЕсли;
	Возврат Окр(Значение / Шаг, 0) * Шаг;

КонецФункции

// Текст полной маски.
//
// Возвращаемое значение:
//  Строка - "***".
//
Функция ПолнаяМаска() Экспорт

	Возврат "***";

КонецФункции

// Описание маски для модели (describe_object, колонки результата).
//
// Параметры:
//  Маска - см. НоваяМаска
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - kind и для partial - visible_chars, для round - step.
//
Функция ОписаниеДляМодели(Маска) Экспорт

	Описание = Новый Соответствие;
	Описание.Вставить("kind", Маска.Вид);
	Если Маска.Вид = "partial" Тогда
		Описание.Вставить("visible_chars", Маска.Параметр);
	ИначеЕсли Маска.Вид = "round" Тогда
		Описание.Вставить("step", Маска.Параметр);
	КонецЕсли;
	Возврат Описание;

КонецФункции

// Представление маски для администратора: «повна», «часткова (видно 4 симв.)», «хеш»,
// «округлення до 1000».
//
// Параметры:
//  Маска - см. НоваяМаска
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция Представление(Маска) Экспорт

	Если Маска.Вид = "partial" Тогда
		Возврат СтрШаблон("часткова (видно %1 симв.)", Формат(Маска.Параметр, "ЧН=0; ЧГ=0"));
	ИначеЕсли Маска.Вид = "hash" Тогда
		Возврат "хеш";
	ИначеЕсли Маска.Вид = "round" Тогда
		Возврат "округлення до " + Формат(Маска.Параметр, "ЧРД=.; ЧН=0; ЧГ=0");
	КонецЕсли;
	Возврат "повна";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЧастичнаяМаска(Значение, Количество)
	// Последние символы строки, числа или представления ссылки; короткие значения скрываются полностью.

	Текст = "";
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Текст = Формат(Значение, "ЧРД=.; ЧГ=0; ЧН=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Представление = Значение.Получить("presentation");
		// Ссылка на скрытый объект и замаскированное представление ничего не раскрывают.
		Если ТипЗнч(Представление) = Тип("Строка") И Значение.Получить("ref") <> Неопределено
			И Представление <> ПолнаяМаска() Тогда
			Текст = Представление;
		КонецЕсли;
	КонецЕсли;
	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) <= Количество Тогда
		Возврат ПолнаяМаска();
	КонецЕсли;
	Возврат ПолнаяМаска() + Прав(Текст, Количество);

КонецФункции

Функция КлючЗначения(Значение)
	// Каноническое представление значения JSON для хеша.

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧГ=0; ЧН=0");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Части = Новый Массив;
		Для Каждого Ключ Из СтрРазделить("type,ref,value", ",") Цикл
			Часть = Значение.Получить(Ключ);
			Части.Добавить(?(ТипЗнч(Часть) = Тип("Строка"), Часть, ""));
		КонецЦикла;
		Возврат СтрСоединить(Части, ":");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ПрефиксХеша()

	Возврат "h:";

КонецФункции

#КонецОбласти

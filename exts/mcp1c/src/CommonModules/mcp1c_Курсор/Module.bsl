///////////////////////////////////////////////////////////////////////////////
// mcp1c_Курсор: курсоры продолжения выборок (п. 5.3, 7.7 ТЗ).
//
// Курсор - base64url(JSON) + "." + base64url(HMAC-SHA256). JSON содержит версию,
// инструмент, отпечаток аргументов, смещение и срок действия; подпись дополнительно
// привязана к клиенту. Чужой, измененный, просроченный курсор или курсор от других
// аргументов отклоняется.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Формирует курсор продолжения.
//
// Параметры:
//  Секрет - Строка - секрет подписи сервера.
//  Привязка - Строка - идентификатор клиента, которому выдан курсор.
//  Инструмент - Строка - имя инструмента.
//  Отпечаток - Строка - см. ОтпечатокАргументов.
//  Смещение - Число - число уже выданных строк.
//  ТекущееВремя - Число - время в секундах от 01.01.1970 (UTC).
//
// Возвращаемое значение:
//  Строка - курсор.
//
Функция Сформировать(Секрет, Привязка, Инструмент, Отпечаток, Смещение, ТекущееВремя) Экспорт

	Данные = Новый Соответствие;
	Данные.Вставить("v", ВерсияФормата());
	Данные.Вставить("t", Инструмент);
	Данные.Вставить("h", Отпечаток);
	Данные.Вставить("o", Смещение);
	Данные.Вставить("x", ТекущееВремя + СрокДействияСекунд());

	Тело = mcp1c_Служебный.КодироватьСтрокуBase64URL(mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Данные));
	Возврат Тело + "." + Подпись(Секрет, Привязка, Тело);

КонецФункции

// Проверяет курсор.
//
// Параметры:
//  Секрет - Строка - секрет подписи сервера.
//  Привязка - Строка - идентификатор клиента, предъявившего курсор.
//  Курсор - Строка - курсор из аргументов.
//  Инструмент - Строка - имя вызванного инструмента.
//  Отпечаток - Строка - отпечаток текущих аргументов, см. ОтпечатокАргументов.
//  ТекущееВремя - Число - время в секундах от 01.01.1970 (UTC).
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - курсор действителен.
//   * Смещение - Число - число уже выданных строк.
//   * Причина - Строка - причина отказа для журнала; клиенту сообщается только, что курсор недействителен.
//
Функция Проверить(Секрет, Привязка, Курсор, Инструмент, Отпечаток, ТекущееВремя) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Смещение", 0);
	Результат.Вставить("Причина", "");

	Если ТипЗнч(Курсор) <> Тип("Строка") Или СтрДлина(Курсор) > МаксимальнаяДлина()
		Или СтрЧислоВхождений(Курсор, ".") <> 1 Тогда
		Результат.Причина = "Некоректний формат курсора";
		Возврат Результат;
	КонецЕсли;

	Части = СтрРазделить(Курсор, ".", Истина);
	Тело = Части[0];
	Если ПустаяСтрока(Тело) Или Части[1] <> Подпись(Секрет, Привязка, Тело) Тогда
		Результат.Причина = "Некоректний підпис курсора";
		Возврат Результат;
	КонецЕсли;

	Данные = ДанныеКурсора(Тело);
	Если Данные = Неопределено Тогда
		Результат.Причина = "Некоректний формат курсора";
		Возврат Результат;
	КонецЕсли;
	Если Данные.Инструмент <> Инструмент Или Данные.Отпечаток <> Отпечаток Тогда
		Результат.Причина = "Курсор видано для інших аргументів";
		Возврат Результат;
	КонецЕсли;
	Если Данные.ДействуетДо < ТекущееВремя Тогда
		Результат.Причина = "Термін дії курсора минув";
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Смещение = Данные.Смещение;
	Возврат Результат;

КонецФункции

// Отпечаток аргументов инструмента: SHA-256 канонического JSON без ключей пагинации.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - аргументы вызова.
//  ИсключаемыеКлючи - Строка - ключи через запятую, не влияющие на набор строк.
//
// Возвращаемое значение:
//  Строка - 32 шестнадцатеричных символа.
//
Функция ОтпечатокАргументов(Аргументы, ИсключаемыеКлючи = "cursor,limit") Экспорт

	Исключаемые = СтрРазделить(ИсключаемыеКлючи, ",", Ложь);
	Значимые = Новый Соответствие;
	Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Аргументы Цикл
			Если Исключаемые.Найти(Элемент.Ключ) = Неопределено Тогда
				Значимые.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Лев(mcp1c_Служебный.ХешSHA256(mcp1c_Сериализация.КаноническийJSON(Значимые)), 32);

КонецФункции

// Время в секундах от 01.01.1970.
//
// Параметры:
//  Значение - Дата - дата (UTC).
//
// Возвращаемое значение:
//  Число - число секунд.
//
Функция СекундыОтНачалаЭпохи(Значение) Экспорт

	Возврат Значение - Дата(1970, 1, 1, 0, 0, 0);

КонецФункции

// HMAC-SHA256 (RFC 2104).
//
// Параметры:
//  Ключ - Строка, ДвоичныеДанные - ключ; строка берется в UTF-8.
//  Сообщение - Строка, ДвоичныеДанные - данные; строка берется в UTF-8.
//
// Возвращаемое значение:
//  ДвоичныеДанные - 32 байта.
//
Функция HMACSHA256(Ключ, Сообщение) Экспорт

	РазмерБлока = 64;
	КлючHex = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ВДвоичныеДанные(Ключ)));
	Если СтрДлина(КлючHex) > РазмерБлока * 2 Тогда
		КлючHex = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешДанныхSHA256(ПолучитьДвоичныеДанныеИзHexСтроки(КлючHex))));
	КонецЕсли;
	Пока СтрДлина(КлючHex) < РазмерБлока * 2 Цикл
		КлючHex = КлючHex + "00";
	КонецЦикла;

	Внутренний = Новый ХешированиеДанных(ХешФункция.SHA256);
	Внутренний.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки(ИсключающееИлиСБайтом(КлючHex, 54)));
	Внутренний.Добавить(ВДвоичныеДанные(Сообщение));

	Внешний = Новый ХешированиеДанных(ХешФункция.SHA256);
	Внешний.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки(ИсключающееИлиСБайтом(КлючHex, 92)));
	Внешний.Добавить(Внутренний.ХешСумма);
	Возврат Внешний.ХешСумма;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВерсияФормата()

	Возврат 1;

КонецФункции

Функция СрокДействияСекунд()

	Возврат 3600;

КонецФункции

Функция МаксимальнаяДлина()

	Возврат 1024;

КонецФункции

Функция Подпись(Секрет, Привязка, Тело)

	Возврат mcp1c_Служебный.КодироватьBase64URL(HMACSHA256(Секрет, "mcp1c-cursor|" + Привязка + "|" + Тело));

КонецФункции

Функция ДанныеКурсора(Тело)
	// Поля тела курсора или Неопределено, если формат неверный.

	Текст = mcp1c_Служебный.ДекодироватьСтрокуBase64URL(Тело);
	Если Текст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Прочитанное = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Прочитанное) <> Тип("Соответствие")
		Или mcp1c_Служебный.Свойство(Прочитанное, "v") <> ВерсияФормата() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Смещение = mcp1c_Служебный.Свойство(Прочитанное, "o");
	ДействуетДо = mcp1c_Служебный.Свойство(Прочитанное, "x");
	Если ТипЗнч(Смещение) <> Тип("Число") Или Смещение < 0 Или Цел(Смещение) <> Смещение
		Или ТипЗнч(ДействуетДо) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Инструмент", mcp1c_Служебный.СвойствоСтрока(Прочитанное, "t"));
	Данные.Вставить("Отпечаток", mcp1c_Служебный.СвойствоСтрока(Прочитанное, "h"));
	Данные.Вставить("Смещение", Смещение);
	Данные.Вставить("ДействуетДо", ДействуетДо);
	Возврат Данные;

КонецФункции

Функция ВДвоичныеДанные(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ПолучитьДвоичныеДанныеИзСтроки(Значение, КодировкаТекста.UTF8, Ложь);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ХешДанныхSHA256(Данные)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат Хеширование.ХешСумма;

КонецФункции

Функция ИсключающееИлиСБайтом(Hex, Байт)
	// Применяет "исключающее или" с байтом к каждому байту шестнадцатеричной строки.

	Цифры = "0123456789abcdef";
	Части = Новый Массив;
	Для Индекс = 0 По СтрДлина(Hex) / 2 - 1 Цикл
		Значение = (СтрНайти(Цифры, Сред(Hex, Индекс * 2 + 1, 1)) - 1) * 16
			+ СтрНайти(Цифры, Сред(Hex, Индекс * 2 + 2, 1)) - 1;
		Результат = ИсключающееИлиБайтов(Значение, Байт);
		Части.Добавить(Сред(Цифры, Цел(Результат / 16) + 1, 1) + Сред(Цифры, Результат % 16 + 1, 1));
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция ИсключающееИлиБайтов(Знач Первый, Знач Второй)
	// Побитовое "исключающее или" двух байтов без функций платформы 8.3.11+.

	Результат = 0;
	Вес = 1;
	Пока Вес < 256 Цикл
		Если Первый % 2 <> Второй % 2 Тогда
			Результат = Результат + Вес;
		КонецЕсли;
		Первый = Цел(Первый / 2);
		Второй = Цел(Второй / 2);
		Вес = Вес * 2;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

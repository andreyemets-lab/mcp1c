// Данные подключения и клиента доступа для проверки токена доступа (см. ДанныеДоступа).
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - СправочникСсылка.mcp1c_ПодключенияOAuth - подключение.
//   * ХешДоступа - Строка - SHA-256 текущего токена доступа.
//   * ДоступДо - Дата - окончание действия текущего токена доступа (UTC).
//   * ХешПредыдущегоДоступа - Строка - SHA-256 предыдущего токена доступа.
//   * ПредыдущийДоступДо - Дата - окончание действия предыдущего токена доступа (UTC).
//   * ДействуетДо - Дата - окончание срока подключения (UTC).
//   * Отозвано - Булево - подключение отозвано.
//   * Удалено - Булево - подключение помечено на удаление.
//   * Области - Строка - выданные области через пробел.
//   * Ресурс - Строка - ресурс, для которого выданы токены.
//   * КлиентOAuthЗаблокирован - Булево - клиент OAuth заблокирован или помечен на удаление.
//   * Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент доступа.
//   * ИмяКлиента - Строка - наименование клиента доступа.
//   * Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа - профиль клиента.
//   * КлиентЗаблокирован - Булево - клиент доступа заблокирован.
//   * КлиентУдален - Булево - клиент доступа помечен на удаление.
//   * РазрешенныеАдреса - Строка - разрешенные IP-адреса и подсети клиента.
//   * РазрешенныеИсточники - Строка - разрешенные значения Origin клиента.
//   * ДоступС - Дата - начало окна времени доступа.
//   * ДоступПо - Дата - конец окна времени доступа.
//
Функция НовыеДанныеДоступа()

	Данные = Новый Структура;
	Данные.Вставить("Ссылка", Справочники.mcp1c_ПодключенияOAuth.ПустаяСсылка());
	Данные.Вставить("ХешДоступа", "");
	Данные.Вставить("ДоступДо", Дата(1, 1, 1));
	Данные.Вставить("ХешПредыдущегоДоступа", "");
	Данные.Вставить("ПредыдущийДоступДо", Дата(1, 1, 1));
	Данные.Вставить("ДействуетДо", Дата(1, 1, 1));
	Данные.Вставить("Отозвано", Ложь);
	Данные.Вставить("Удалено", Ложь);
	Данные.Вставить("Области", "");
	Данные.Вставить("Ресурс", "");
	Данные.Вставить("КлиентOAuthЗаблокирован", Ложь);
	Данные.Вставить("Клиент", Справочники.mcp1c_КлиентыДоступа.ПустаяСсылка());
	Данные.Вставить("ИмяКлиента", "");
	Данные.Вставить("Профиль", Справочники.mcp1c_ПрофилиДоступа.ПустаяСсылка());

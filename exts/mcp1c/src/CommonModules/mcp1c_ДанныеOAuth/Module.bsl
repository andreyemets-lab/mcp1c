///////////////////////////////////////////////////////////////////////////////
// mcp1c_ДанныеOAuth: клиенты и подключения OAuth 2.1 (п. 6.4 ТЗ) в справочниках mcp1c_КлиентыOAuth
// и mcp1c_ПодключенияOAuth. Модуль работает по правам текущего пользователя: сервис (роль mcp1c_Сервис)
// читает данные, кеширует документы метаданных клиентов и меняет токены подключений, администратор выдает
// коды подключения и отзывает подключения. Секреты не хранятся - только SHA-256 (см. mcp1c_ПравилаOAuth).
// Правила без обращений к базе - в mcp1c_ПравилаOAuth, обработка HTTP - в mcp1c_OAuth.
//
// Подключение - элемент mcp1c_ПодключенияOAuth: владелец - клиент доступа, код - идентификатор подключения
// (12 символов base32, входит в токены). Жизненный цикл:
//  1. администратор выдает код подключения (ХешКодаПодключения, КодПодключенияДо);
//  2. пользователь вводит код на странице авторизации и подтверждает доступ: подключение получает клиента
//     OAuth, адрес возврата, области, ресурс, срок ДействуетДо и код авторизации, код подключения гасится;
//  3. клиент OAuth обменивает код авторизации на токены доступа и обновления;
//  4. при обновлении оба токена заменяются; предыдущий токен доступа действует до своего срока, а повторное
//     предъявление предыдущего токена обновления (позже минуты после замены) отзывает подключение.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область КлиентыOAuth

// Клиент OAuth по client_id (с учетом регистра).
//
// Параметры:
//  ИдентификаторКлиента - Строка, Неопределено - client_id.
//
// Возвращаемое значение:
//  - Неопределено - клиента нет.
//  - см. НовыеДанныеКлиента
//
Функция КлиентOAuth(ИдентификаторКлиента) Экспорт

	Если ТипЗнч(ИдентификаторКлиента) <> Тип("Строка") Или ПустаяСтрока(ИдентификаторКлиента)
		Или СтрДлина(ИдентификаторКлиента) > 500 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Клиенты.Ссылка КАК Ссылка,
	|	Клиенты.ИдентификаторКлиента КАК ИдентификаторКлиента,
	|	Клиенты.Наименование КАК Имя,
	|	Клиенты.Источник КАК Источник,
	|	Клиенты.АдресаВозврата КАК АдресаВозврата,
	|	Клиенты.СпособАутентификации КАК СпособАутентификации,
	|	Клиенты.ХешСекрета КАК ХешСекрета,
	|	Клиенты.ДатаЗагрузки КАК ДатаЗагрузки,
	|	Клиенты.Заблокирован КАК Заблокирован,
	|	Клиенты.ПометкаУдаления КАК Удален
	|ИЗ
	|	Справочник.mcp1c_КлиентыOAuth КАК Клиенты
	|ГДЕ
	|	Клиенты.ИдентификаторКлиента = &ИдентификаторКлиента
	|
	|УПОРЯДОЧИТЬ ПО
	|	Клиенты.ПометкаУдаления,
	|	Клиенты.ДатаЗагрузки УБЫВ");
	Запрос.УстановитьПараметр("ИдентификаторКлиента", ИдентификаторКлиента);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Сравнение строк в запросе может не учитывать регистр, а client_id сравнивается точно.
		Если Выборка.ИдентификаторКлиента <> ИдентификаторКлиента Тогда
			Продолжить;
		КонецЕсли;
		Данные = НовыеДанныеКлиента();
		ЗаполнитьЗначенияСвойств(Данные, Выборка, "Ссылка, ИдентификаторКлиента, Имя, Источник, СпособАутентификации");
		ЗаполнитьЗначенияСвойств(Данные, Выборка, "ХешСекрета, ДатаЗагрузки, Заблокирован, Удален");
		Данные.АдресаВозврата = mcp1c_ПравилаOAuth.АдресаИзТекста(Выборка.АдресаВозврата);
		Возврат Данные;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Данные клиента OAuth.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - СправочникСсылка.mcp1c_КлиентыOAuth - клиент.
//   * ИдентификаторКлиента - Строка - client_id.
//   * Имя - Строка - наименование.
//   * Источник - Строка - manual (предварительная регистрация), dcr (динамическая) или cimd (документ метаданных).
//   * АдресаВозврата - Массив из Строка - redirect_uris.
//   * СпособАутентификации - Строка - none, client_secret_post или client_secret_basic.
//   * ХешСекрета - Строка - SHA-256 секрета клиента; пустая строка - публичный клиент.
//   * ДатаЗагрузки - Дата - когда клиент зарегистрирован или загружен его документ метаданных (UTC).
//   * Заблокирован - Булево - клиент заблокирован администратором.
//   * Удален - Булево - клиент помечен на удаление.
//
Функция НовыеДанныеКлиента() Экспорт

	Данные = Новый Структура;
	Данные.Вставить("Ссылка", Справочники.mcp1c_КлиентыOAuth.ПустаяСсылка());
	Данные.Вставить("ИдентификаторКлиента", "");
	Данные.Вставить("Имя", "");
	Данные.Вставить("Источник", "");
	Данные.Вставить("АдресаВозврата", Новый Массив);
	Данные.Вставить("СпособАутентификации", "none");
	Данные.Вставить("ХешСекрета", "");
	Данные.Вставить("ДатаЗагрузки", Дата(1, 1, 1));
	Данные.Вставить("Заблокирован", Ложь);
	Данные.Вставить("Удален", Ложь);
	Возврат Данные;

КонецФункции

// Сохраняет проверенный документ метаданных клиента (CIMD): создает клиента или обновляет кеш.
// Клиента, которого зарегистрировал администратор, документ не меняет.
//
// Параметры:
//  ИдентификаторКлиента - Строка - адрес документа (client_id).
//  Описание - см. mcp1c_ПравилаOAuth.НовоеОписаниеКлиента
//  ТекстДокумента - Строка - документ.
//
// Возвращаемое значение:
//  см. НовыеДанныеКлиента
//
Функция СохранитьКлиентаCIMD(ИдентификаторКлиента, Описание, ТекстДокумента) Экспорт

	НачатьТранзакцию();
	Попытка
		// Блокировка всего справочника: параллельные страницы авторизации не создадут двух клиентов.
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Справочник.mcp1c_КлиентыOAuth");
		Блокировка.Заблокировать();
		Данные = КлиентOAuth(ИдентификаторКлиента);
		Если Данные = Неопределено Или Данные.Источник = "cimd" Тогда
			Если Данные = Неопределено Тогда
				Объект = Справочники.mcp1c_КлиентыOAuth.СоздатьЭлемент();
				Объект.ИдентификаторКлиента = ИдентификаторКлиента;
				Объект.Источник = "cimd";
			Иначе
				Объект = Данные.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			Объект.Наименование = Лев(Описание.Имя, 150);
			Объект.АдресаВозврата = СтрСоединить(Описание.АдресаВозврата, Символы.ПС);
			Объект.СпособАутентификации = Описание.СпособАутентификации;
			Объект.ДокументМетаданных = ТекстДокумента;
			Объект.ДатаЗагрузки = ТекущаяУниверсальнаяДата();
			Объект.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Сохраненный = КлиентOAuth(ИдентификаторКлиента);
	Если Сохраненный = Неопределено Тогда
		ВызватьИсключение "Не вдалося зберегти клієнта OAuth";
	КонецЕсли;
	Результат = НовыеДанныеКлиента();
	ЗаполнитьЗначенияСвойств(Результат, Сохраненный);
	Возврат Результат;

КонецФункции

// Регистрирует клиента OAuth: предварительно (администратор) или динамически (RFC 7591).
//
// Параметры:
//  Описание - см. mcp1c_ПравилаOAuth.НовоеОписаниеКлиента
//  Источник - Строка - manual или dcr.
//  Комментарий - Строка - комментарий.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - СправочникСсылка.mcp1c_КлиентыOAuth - клиент.
//   * ИдентификаторКлиента - Строка - client_id.
//   * Секрет - Строка - client_secret (показывается один раз); пустая строка - публичный клиент.
//   * ДатаРегистрации - Дата - время регистрации (UTC).
//
Функция ЗарегистрироватьКлиента(Описание, Источник, Комментарий = "") Экспорт

	Идентификатор = mcp1c_ПравилаOAuth.НовыйИдентификаторКлиента();
	Пока КлиентOAuth(Идентификатор) <> Неопределено Цикл
		Идентификатор = mcp1c_ПравилаOAuth.НовыйИдентификаторКлиента();
	КонецЦикла;

	Секрет = "";
	Объект = Справочники.mcp1c_КлиентыOAuth.СоздатьЭлемент();
	Если Описание.СпособАутентификации <> "none" Тогда
		НовыйСекрет = mcp1c_ПравилаOAuth.НовыйСекретКлиента();
		Секрет = НовыйСекрет.Секрет;
		Объект.ХешСекрета = НовыйСекрет.Хеш;
	КонецЕсли;
	Сейчас = ТекущаяУниверсальнаяДата();
	Объект.ИдентификаторКлиента = Идентификатор;
	Объект.Наименование = Лев(Описание.Имя, 150);
	Объект.Источник = Источник;
	Объект.АдресаВозврата = СтрСоединить(Описание.АдресаВозврата, Символы.ПС);
	Объект.СпособАутентификации = Описание.СпособАутентификации;
	Объект.ДатаЗагрузки = Сейчас;
	Объект.Комментарий = Комментарий;
	Объект.Записать();

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Объект.Ссылка);
	Результат.Вставить("ИдентификаторКлиента", Идентификатор);
	Результат.Вставить("Секрет", Секрет);
	Результат.Вставить("ДатаРегистрации", Сейчас);
	Возврат Результат;

КонецФункции

// Сколько клиентов зарегистрировано динамически за последний час (ограничение регистрации).
//
// Возвращаемое значение:
//  Число - количество клиентов.
//
Функция РегистрацийЗаЧас() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.mcp1c_КлиентыOAuth КАК Клиенты
	|ГДЕ
	|	Клиенты.Источник = ""dcr""
	|	И Клиенты.ДатаЗагрузки >= &Граница");
	Запрос.УстановитьПараметр("Граница", ТекущаяУниверсальнаяДата() - 3600);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Число(Выборка.Количество), 0);

КонецФункции

#КонецОбласти

#Область Подключения

// Создает подключение клиента доступа с новым кодом подключения.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент доступа.
//  СрокМинут - Число - сколько минут действует код.
//  Автор - Строка - кто выдал код.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - СправочникСсылка.mcp1c_ПодключенияOAuth - подключение.
//   * Идентификатор - Строка - идентификатор подключения.
//   * Код - Строка - код подключения (показывается один раз).
//   * ДействуетДо - Дата - окончание действия кода (UTC).
//
Функция НовоеПодключение(Клиент, СрокМинут, Автор) Экспорт

	Идентификатор = mcp1c_Служебный.СлучайнаяСтрокаBase32(12);
	Пока ПодключениеПоИдентификатору(Идентификатор) <> Неопределено Цикл
		Идентификатор = mcp1c_Служебный.СлучайнаяСтрокаBase32(12);
	КонецЦикла;
	// Совпадение кода с кодом другого ожидающего подключения сделало бы вход неоднозначным.
	КодПодключения = mcp1c_ПравилаOAuth.НовыйКодПодключения();
	Пока ОжидающееПодключение(КодПодключения.Хеш) <> Неопределено Цикл
		КодПодключения = mcp1c_ПравилаOAuth.НовыйКодПодключения();
	КонецЦикла;

	Сейчас = ТекущаяУниверсальнаяДата();
	Объект = Справочники.mcp1c_ПодключенияOAuth.СоздатьЭлемент();
	Объект.Владелец = Клиент;
	Объект.Код = Идентификатор;
	Объект.Наименование = "Очікує коду підключення";
	Объект.Автор = Лев(Автор, 100);
	Объект.ДатаВыпускаКода = Сейчас;
	Объект.ХешКодаПодключения = КодПодключения.Хеш;
	Объект.КодПодключенияДо = Сейчас + Цел(СрокМинут) * 60;
	Объект.Записать();

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Объект.Ссылка);
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("Код", КодПодключения.Код);
	Результат.Вставить("ДействуетДо", Объект.КодПодключенияДо);
	Возврат Результат;

КонецФункции

// Подключение по идентификатору.
//
// Параметры:
//  Идентификатор - Строка, Неопределено - идентификатор подключения (код элемента).
//
// Возвращаемое значение:
//  СправочникСсылка.mcp1c_ПодключенияOAuth, Неопределено - подключение.
//
Функция ПодключениеПоИдентификатору(Идентификатор) Экспорт

	Если ТипЗнч(Идентификатор) <> Тип("Строка") Или СтрДлина(Идентификатор) <> 12 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Подключения.Ссылка КАК Ссылка,
	|	Подключения.Код КАК Код
	|ИЗ
	|	Справочник.mcp1c_ПодключенияOAuth КАК Подключения
	|ГДЕ
	|	Подключения.Код = &Код");
	Запрос.УстановитьПараметр("Код", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Код = Идентификатор Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Подключение, которое ждет ввода кода: код действует, подключение не подтверждено и не отозвано.
//
// Параметры:
//  ХешКода - Строка - хеш введенного кода (см. mcp1c_ПравилаOAuth.ХешКодаПодключения).
//
// Возвращаемое значение:
//  - Неопределено - такого подключения нет.
//  - см. НовоеОжидающееПодключение
//
Функция ОжидающееПодключение(ХешКода) Экспорт

	Если ПустаяСтрока(ХешКода) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Подключения.Ссылка КАК Ссылка,
	|	Подключения.Код КАК Идентификатор,
	|	Подключения.Владелец КАК Клиент,
	|	Клиенты.Наименование КАК ИмяКлиента,
	|	Клиенты.Профиль КАК Профиль,
	|	ЕСТЬNULL(Профили.Наименование, """") КАК ИмяПрофиля,
	|	ВЫБОР
	|		КОГДА Клиенты.Заблокирован
	|				ИЛИ Клиенты.ПометкаУдаления
	|				ИЛИ ЕСТЬNULL(Профили.ПометкаУдаления, ИСТИНА)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК КлиентДоступен
	|ИЗ
	|	Справочник.mcp1c_ПодключенияOAuth КАК Подключения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|		ПО Подключения.Владелец = Клиенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.mcp1c_ПрофилиДоступа КАК Профили
	|		ПО (Клиенты.Профиль = Профили.Ссылка)
	|ГДЕ
	|	Подключения.ХешКодаПодключения = &Хеш
	|	И Подключения.ДатаПодключения = ДАТАВРЕМЯ(1, 1, 1)
	|	И Подключения.КодПодключенияДо > &Сейчас
	|	И НЕ Подключения.Отозвано
	|	И НЕ Подключения.ПометкаУдаления");
	Запрос.УстановитьПараметр("Хеш", ХешКода);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = НовоеОжидающееПодключение();
	ЗаполнитьЗначенияСвойств(Результат, Выборка, "Ссылка, Идентификатор, Клиент, ИмяКлиента");
	ЗаполнитьЗначенияСвойств(Результат, Выборка, "Профиль, ИмяПрофиля, КлиентДоступен");
	Возврат Результат;

КонецФункции

// Подтверждает подключение: связывает его с клиентом OAuth, гасит код подключения и выпускает
// код авторизации.
//
// Параметры:
//  Подключение - СправочникСсылка.mcp1c_ПодключенияOAuth - подключение, которое ждет кода.
//  Данные - Структура:
//   * КлиентOAuth - СправочникСсылка.mcp1c_КлиентыOAuth - клиент OAuth.
//   * ИдентификаторКлиента - Строка - client_id.
//   * ИмяКлиента - Строка - кто получает доступ (для списков подключений).
//   * АдресВозврата - Строка - redirect_uri.
//   * Области - Массив из Строка - выданные области.
//   * Ресурс - Строка - ресурс (RFC 8707).
//   * ВызовPKCE - Строка - code_challenge.
//  Настройки - см. mcp1c_Настройки.Получить
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - код авторизации; пустая строка - подключение уже не ждет кода.
//   * Причина - Строка - почему код авторизации не выпущен.
//
Функция ПодтвердитьПодключение(Подключение, Данные, Настройки) Экспорт

	Результат = Новый Структура("Код, Причина", "", "");
	Дней = Макс(Цел(mcp1c_Служебный.СвойствоЧисло(Настройки, "oauthConnectionDays", 90)), 1);

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПодключение(Подключение);
		Объект = Подключение.ПолучитьОбъект();
		Сейчас = ТекущаяУниверсальнаяДата();
		Если Объект = Неопределено Или Объект.Отозвано Или Объект.ПометкаУдаления
			Или ЗначениеЗаполнено(Объект.ДатаПодключения) Или ПустаяСтрока(Объект.ХешКодаПодключения)
			Или Объект.КодПодключенияДо <= Сейчас Тогда
			Результат.Причина = "Код підключення вже використано, відкликано або строк його дії минув";
		Иначе
			КодАвторизации = mcp1c_ПравилаOAuth.НовыйТокен("ac", Объект.Код);
			Объект.Наименование = Лев(Данные.ИмяКлиента, 150);
			Объект.КлиентOAuth = Данные.КлиентOAuth;
			Объект.ИдентификаторКлиентаOAuth = Данные.ИдентификаторКлиента;
			Объект.ИмяКлиентаOAuth = Лев(Данные.ИмяКлиента, 150);
			Объект.АдресВозврата = Данные.АдресВозврата;
			Объект.Области = mcp1c_ПравилаOAuth.ОбластиСтрокой(Данные.Области);
			Объект.Ресурс = Данные.Ресурс;
			Объект.ДатаПодключения = Сейчас;
			Объект.ДействуетДо = Сейчас + Дней * 86400;
			Объект.ХешКодаПодключения = "";
			Объект.ХешКодаАвторизации = КодАвторизации.Хеш;
			Объект.КодАвторизацииДо = Сейчас + СрокКодаАвторизацииСекунд();
			Объект.ВызовPKCE = Данные.ВызовPKCE;
			Объект.КодАвторизацииИспользован = Ложь;
			Объект.Записать();
			Результат.Код = КодАвторизации.Токен;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Обменивает код авторизации на токены (RFC 6749, п. 4.1.3; RFC 7636, п. 4.6). Повторное использование
// кода отзывает подключение (RFC 6749, п. 4.1.2).
//
// Параметры:
//  Части - см. mcp1c_ПравилаOAuth.РазобратьТокен
//  Клиент - см. НовыеДанныеКлиента
//  АдресВозврата - Строка, Неопределено - redirect_uri запроса токенов.
//  Верификатор - Строка, Неопределено - code_verifier.
//  Ресурс - Строка, Неопределено - resource запроса токенов.
//  Настройки - см. mcp1c_Настройки.Получить
//
// Возвращаемое значение:
//  см. НовыйРезультатТокенов
//
Функция ОбменятьКодАвторизации(Части, Клиент, АдресВозврата, Верификатор, Ресурс, Настройки) Экспорт

	Результат = НовыйРезультатТокенов();
	Подключение = ПодключениеПоИдентификатору(Части.Подключение);
	Если Подключение = Неопределено Тогда
		ЗаполнитьОшибкуТокенов(Результат, "invalid_grant", "Підключення OAuth не знайдено");
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПодключение(Подключение);
		Объект = ОбъектПодключения(Подключение, Результат);
		Если Объект = Неопределено Тогда
			ЗаполнитьОшибкуТокенов(Результат, "invalid_grant", "Підключення OAuth не знайдено");
		Иначе
			ОбменятьКодОбъекта(Объект, Части, Клиент, АдресВозврата, Верификатор, Ресурс, Настройки, Результат);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Обновляет токены по токену обновления (RFC 6749, п. 6) с заменой токена обновления. Предыдущий токен
// обновления в течение минуты после замены принимается (параллельные запросы клиента), позже - отзывает
// подключение (п. 6.4 ТЗ).
//
// Параметры:
//  Части - см. mcp1c_ПравилаOAuth.РазобратьТокен
//  Клиент - см. НовыеДанныеКлиента
//  Области - Массив из Строка - области из параметра scope; пустой массив - области подключения.
//  Ресурс - Строка, Неопределено - resource запроса токенов.
//  Настройки - см. mcp1c_Настройки.Получить
//
// Возвращаемое значение:
//  см. НовыйРезультатТокенов
//
Функция ОбновитьТокены(Части, Клиент, Области, Ресурс, Настройки) Экспорт

	Результат = НовыйРезультатТокенов();
	Подключение = ПодключениеПоИдентификатору(Части.Подключение);
	Если Подключение = Неопределено Тогда
		ЗаполнитьОшибкуТокенов(Результат, "invalid_grant", "Підключення OAuth не знайдено");
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПодключение(Подключение);
		Объект = ОбъектПодключения(Подключение, Результат);
		Если Объект = Неопределено Тогда
			ЗаполнитьОшибкуТокенов(Результат, "invalid_grant", "Підключення OAuth не знайдено");
		Иначе
			ОбновитьТокеныОбъекта(Объект, Части, Клиент, Области, Ресурс, Настройки, Результат);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Отзывает подключение по его токену (RFC 7009): токен доступа или обновления, текущий или предыдущий,
// выданный этому клиенту OAuth.
//
// Параметры:
//  Части - см. mcp1c_ПравилаOAuth.РазобратьТокен
//  Клиент - см. НовыеДанныеКлиента
//
// Возвращаемое значение:
//  см. НовыйРезультатТокенов
//
Функция ОтозватьПоТокену(Части, Клиент) Экспорт

	Результат = НовыйРезультатТокенов();
	Подключение = ПодключениеПоИдентификатору(Части.Подключение);
	Если Подключение = Неопределено Или Части.Вид = "ac" Тогда
		Результат.Причина = "Токен не належить жодному підключенню";
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПодключение(Подключение);
		Объект = ОбъектПодключения(Подключение, Результат);
		Если Объект = Неопределено Тогда
			Результат.Причина = "Підключення OAuth не знайдено";
		ИначеЕсли ХешиТокеновОбъекта(Объект).Найти(Части.Хеш) = Неопределено Тогда
			Результат.Причина = "Токен не належить підключенню";
		ИначеЕсли Объект.ИдентификаторКлиентаOAuth <> Клиент.ИдентификаторКлиента Тогда
			Результат.Причина = "Токен видано іншому клієнту OAuth";
		ИначеЕсли Объект.Отозвано Тогда
			Результат.Причина = "Підключення вже відкликано";
		Иначе
			ОтозватьОбъект(Объект, "Відкликано клієнтом OAuth", ТекущаяУниверсальнаяДата());
			Объект.Записать();
			Результат.Отозвано = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Отзывает подключение.
//
// Параметры:
//  Подключение - СправочникСсылка.mcp1c_ПодключенияOAuth - подключение.
//  Причина - Строка - причина отзыва.
//
// Возвращаемое значение:
//  Строка - идентификатор подключения, если оно отозвано этим вызовом; пустая строка - уже было отозвано.
//
Функция ОтозватьПодключение(Подключение, Причина) Экспорт

	Отозвано = "";
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьПодключение(Подключение);
		Объект = Подключение.ПолучитьОбъект();
		Если Объект <> Неопределено И Не Объект.Отозвано Тогда
			ОтозватьОбъект(Объект, Причина, ТекущаяУниверсальнаяДата());
			Объект.Записать();
			Отозвано = Объект.Код;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Отозвано;

КонецФункции

// Действующие подключения: не отозваны и не истекли (для отзыва при переносе ИБ).
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.mcp1c_ПодключенияOAuth - подключения.
//
Функция ДействующиеПодключения() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Подключения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_ПодключенияOAuth КАК Подключения
	|ГДЕ
	|	НЕ Подключения.Отозвано
	|	И (Подключения.ДействуетДо > &Сейчас
	|			ИЛИ Подключения.КодПодключенияДо > &Сейчас)");
	Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Данные подключения и его клиента доступа для проверки токена доступа (см. mcp1c_Аутентификация).
//
// Параметры:
//  Идентификатор - Строка - идентификатор подключения из токена.
//
// Возвращаемое значение:
//  - Неопределено - подключения нет.
//  - см. НовыеДанныеДоступа
//
Функция ДанныеДоступа(Идентификатор) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Подключения.Ссылка КАК Ссылка,
	|	Подключения.Код КАК Идентификатор,
	|	Подключения.ХешДоступа КАК ХешДоступа,
	|	Подключения.ДоступДо КАК ДоступДо,
	|	Подключения.ХешПредыдущегоДоступа КАК ХешПредыдущегоДоступа,
	|	Подключения.ПредыдущийДоступДо КАК ПредыдущийДоступДо,
	|	Подключения.ДействуетДо КАК ДействуетДо,
	|	Подключения.Отозвано КАК Отозвано,
	|	Подключения.ПометкаУдаления КАК Удалено,
	|	Подключения.Области КАК Области,
	|	Подключения.Ресурс КАК Ресурс,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлиентыOAuth.Заблокирован, ЛОЖЬ)
	|				ИЛИ ЕСТЬNULL(КлиентыOAuth.ПометкаУдаления, ЛОЖЬ)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КлиентOAuthЗаблокирован,
	|	Подключения.Владелец КАК Клиент,
	|	Клиенты.Наименование КАК ИмяКлиента,
	|	Клиенты.Профиль КАК Профиль,
	|	Клиенты.Заблокирован КАК КлиентЗаблокирован,
	|	Клиенты.ПометкаУдаления КАК КлиентУдален,
	|	Клиенты.РазрешенныеАдреса КАК РазрешенныеАдреса,
	|	Клиенты.РазрешенныеИсточники КАК РазрешенныеИсточники,
	|	Клиенты.ДоступС КАК ДоступС,
	|	Клиенты.ДоступПо КАК ДоступПо
	|ИЗ
	|	Справочник.mcp1c_ПодключенияOAuth КАК Подключения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|		ПО Подключения.Владелец = Клиенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.mcp1c_КлиентыOAuth КАК КлиентыOAuth
	|		ПО Подключения.КлиентOAuth = КлиентыOAuth.Ссылка
	|ГДЕ
	|	Подключения.Код = &Код");
	Запрос.УстановитьПараметр("Код", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Идентификатор <> Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		Данные = НовыеДанныеДоступа();
		ЗаполнитьЗначенияСвойств(Данные, Выборка, "Ссылка, ХешДоступа, ДоступДо, ХешПредыдущегоДоступа, ПредыдущийДоступДо");
		ЗаполнитьЗначенияСвойств(Данные, Выборка, "ДействуетДо, Отозвано, Удалено, Области, Ресурс, КлиентOAuthЗаблокирован");
		ЗаполнитьЗначенияСвойств(Данные, Выборка, "Клиент, ИмяКлиента, Профиль, КлиентЗаблокирован, КлиентУдален");
		ЗаполнитьЗначенияСвойств(Данные, Выборка, "РазрешенныеАдреса, РазрешенныеИсточники, ДоступС, ДоступПо");
		Возврат Данные;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Подключения без хешей с временем последнего использования по журналу вызовов. Читаются по правам
// текущего пользователя.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - отбор по клиенту доступа.
//
// Возвращаемое значение:
//  Массив из Структура - Ссылка, Идентификатор, Клиент, Приложение, ИдентификаторКлиента, ХостВозврата, Области,
//                        Автор, ДатаВыпускаКода, КодПодключенияДо, ДатаПодключения, ДействуетДо, ДатаОбновления,
//                        Отозвано, ДатаОтзыва, ПричинаОтзыва, Состояние, Действует,
//                        ПоследнееИспользование (UTC, Неопределено - не использовалось).
//
Функция ОписанияПодключений(Клиент = Неопределено) Экспорт

	// Условие с параметром-флагом: ИЛИ не мешает индексу, отбор по клиенту необязателен.
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Журнал.ИдентификаторТокена КАК ИдентификаторТокена,
	|	МАКСИМУМ(Журнал.Момент) КАК ПоследнееИспользование
	|ПОМЕСТИТЬ ВТ_Использование
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Результат = ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.Успех)
	|	И Журнал.ИдентификаторТокена <> """"
	|	И НЕ Журнал.Метод ПОДОБНО ""oauth/%""
	|	И (&ВсеКлиенты
	|			ИЛИ Журнал.Клиент = &Клиент)
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.ИдентификаторТокена
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторТокена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Подключения.Ссылка КАК Ссылка,
	|	Подключения.Код КАК Идентификатор,
	|	Подключения.Владелец КАК Клиент,
	|	Подключения.ИмяКлиентаOAuth КАК Приложение,
	|	Подключения.ИдентификаторКлиентаOAuth КАК ИдентификаторКлиента,
	|	Подключения.АдресВозврата КАК АдресВозврата,
	|	Подключения.Области КАК Области,
	|	Подключения.Автор КАК Автор,
	|	Подключения.ДатаВыпускаКода КАК ДатаВыпускаКода,
	|	Подключения.КодПодключенияДо КАК КодПодключенияДо,
	|	Подключения.ДатаПодключения КАК ДатаПодключения,
	|	Подключения.ДействуетДо КАК ДействуетДо,
	|	Подключения.ОбновлениеДо КАК ОбновлениеДо,
	|	Подключения.ДатаОбновления КАК ДатаОбновления,
	|	Подключения.Отозвано КАК Отозвано,
	|	Подключения.ДатаОтзыва КАК ДатаОтзыва,
	|	Подключения.ПричинаОтзыва КАК ПричинаОтзыва,
	|	ВЫБОР
	|		КОГДА Подключения.ХешОбновления = """"
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьТокены,
	|	Использование.ПоследнееИспользование КАК ПоследнееИспользование
	|ИЗ
	|	Справочник.mcp1c_ПодключенияOAuth КАК Подключения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Использование КАК Использование
	|		ПО Подключения.Код = Использование.ИдентификаторТокена
	|ГДЕ
	|	НЕ Подключения.ПометкаУдаления
	|	И (&ВсеКлиенты
	|			ИЛИ Подключения.Владелец = &Клиент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВыпускаКода УБЫВ");
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	Запрос.УстановитьПараметр("ВсеКлиенты", Клиент = Неопределено);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();

	Сейчас = ТекущаяУниверсальнаяДата();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура;
		Описание.Вставить("Ссылка", Выборка.Ссылка);
		Описание.Вставить("Идентификатор", Строка(Выборка.Идентификатор));
		Описание.Вставить("Клиент", Выборка.Клиент);
		Описание.Вставить("Приложение", Строка(Выборка.Приложение));
		Описание.Вставить("ИдентификаторКлиента", Строка(Выборка.ИдентификаторКлиента));
		Описание.Вставить("ХостВозврата", mcp1c_ПравилаOAuth.ХостАдреса(Строка(Выборка.АдресВозврата)));
		Описание.Вставить("Области", Строка(Выборка.Области));
		Описание.Вставить("Автор", Строка(Выборка.Автор));
		Описание.Вставить("ДатаВыпускаКода", Выборка.ДатаВыпускаКода);
		Описание.Вставить("КодПодключенияДо", Выборка.КодПодключенияДо);
		Описание.Вставить("ДатаПодключения", Выборка.ДатаПодключения);
		Описание.Вставить("ДействуетДо", Выборка.ДействуетДо);
		Описание.Вставить("ДатаОбновления", Выборка.ДатаОбновления);
		Описание.Вставить("Отозвано", Выборка.Отозвано = Истина);
		Описание.Вставить("ДатаОтзыва", Выборка.ДатаОтзыва);
		Описание.Вставить("ПричинаОтзыва", Строка(Выборка.ПричинаОтзыва));
		Описание.Вставить("Состояние", СостояниеПодключения(Выборка, Сейчас));
		Описание.Вставить("Действует", Не Выборка.Отозвано И Выборка.ЕстьТокены = Истина
			И Выборка.ДействуетДо > Сейчас И Выборка.ОбновлениеДо > Сейчас);
		Описание.Вставить("ПоследнееИспользование",
			?(ЗначениеЗаполнено(Выборка.ПоследнееИспользование), Выборка.ПоследнееИспользование, Неопределено));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Клиенты OAuth без хешей секретов - для списка администратора.
//
// Возвращаемое значение:
//  Массив из Структура - Ссылка, ИдентификаторКлиента, Имя, Источник, АдресаВозврата (Строка, по одному в строке),
//                        СпособАутентификации, ДатаЗагрузки (UTC), Заблокирован.
//
Функция ОписанияКлиентов() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Клиенты.Ссылка КАК Ссылка,
	|	Клиенты.ИдентификаторКлиента КАК ИдентификаторКлиента,
	|	Клиенты.Наименование КАК Имя,
	|	Клиенты.Источник КАК Источник,
	|	Клиенты.АдресаВозврата КАК АдресаВозврата,
	|	Клиенты.СпособАутентификации КАК СпособАутентификации,
	|	Клиенты.ДатаЗагрузки КАК ДатаЗагрузки,
	|	Клиенты.Заблокирован КАК Заблокирован
	|ИЗ
	|	Справочник.mcp1c_КлиентыOAuth КАК Клиенты
	|ГДЕ
	|	НЕ Клиенты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗагрузки УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура;
		Описание.Вставить("Ссылка", Выборка.Ссылка);
		Описание.Вставить("ИдентификаторКлиента", Строка(Выборка.ИдентификаторКлиента));
		Описание.Вставить("Имя", Строка(Выборка.Имя));
		Описание.Вставить("Источник", Строка(Выборка.Источник));
		Описание.Вставить("АдресаВозврата", Строка(Выборка.АдресаВозврата));
		Описание.Вставить("СпособАутентификации", Строка(Выборка.СпособАутентификации));
		Описание.Вставить("ДатаЗагрузки", Выборка.ДатаЗагрузки);
		Описание.Вставить("Заблокирован", Выборка.Заблокирован = Истина);
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Блокирует клиента OAuth или снимает блокировку: подключения заблокированного клиента не получают токены
// и не проходят проверку токена доступа.
//
// Параметры:
//  КлиентOAuth - СправочникСсылка.mcp1c_КлиентыOAuth - клиент.
//  Заблокировать - Булево - Истина - заблокировать, Ложь - снять блокировку.
//
// Возвращаемое значение:
//  Строка - client_id клиента; пустая строка - клиента нет.
//
Функция УстановитьБлокировкуКлиента(КлиентOAuth, Заблокировать) Экспорт

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.mcp1c_КлиентыOAuth");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", КлиентOAuth);
		Блокировка.Заблокировать();
		Объект = КлиентOAuth.ПолучитьОбъект();
		ИдентификаторКлиента = "";
		Если Объект <> Неопределено Тогда
			ИдентификаторКлиента = Объект.ИдентификаторКлиента;
			Если Объект.Заблокирован <> Заблокировать Тогда
				Объект.Заблокирован = Заблокировать;
				Объект.Записать();
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ИдентификаторКлиента;

КонецФункции

#КонецОбласти

#КонецОбласти


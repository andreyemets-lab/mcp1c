КонецФункции

Процедура ЗаполнитьОшибкуТокенов(Результат, Ошибка, Причина)

	Результат.Ошибка = Ошибка;
	Результат.Причина = Причина;

КонецПроцедуры

Процедура ОбменятьКодОбъекта(Объект, Части, Клиент, АдресВозврата, Верификатор, Ресурс, Настройки, Результат)
	// Проверки кода авторизации под блокировкой подключения и выпуск токенов (см. ОбменятьКодАвторизации).

	Сейчас = ТекущаяУниверсальнаяДата();
	Причина = "";
	Если ПустаяСтрока(Объект.ХешКодаАвторизации) Или Объект.ХешКодаАвторизации <> Части.Хеш Тогда
		Причина = "Некоректний код авторизації";
	ИначеЕсли Объект.ИдентификаторКлиентаOAuth <> Клиент.ИдентификаторКлиента Тогда
		Причина = "Код авторизації видано іншому клієнту OAuth";
	ИначеЕсли Объект.КодАвторизацииИспользован Тогда
		Причина = "Повторне використання коду авторизації: підключення відкликано";
		Если Не Объект.Отозвано Тогда
			ОтозватьОбъект(Объект, Причина, Сейчас);
			Результат.Отозвано = Истина;
		КонецЕсли;
	ИначеЕсли Объект.КодАвторизацииДо <= Сейчас Тогда
		Причина = "Строк дії коду авторизації минув";
	ИначеЕсли ТипЗнч(АдресВозврата) = Тип("Строка") И АдресВозврата <> Объект.АдресВозврата Тогда
		Причина = "redirect_uri не збігається з адресою повернення запиту авторизації";
	ИначеЕсли Не mcp1c_ПравилаOAuth.ВерификаторPKCEКорректен(Верификатор)
		Или mcp1c_ПравилаOAuth.ВызовPKCE(Верификатор) <> Объект.ВызовPKCE Тогда
		Причина = "code_verifier не відповідає code_challenge (PKCE)";
	Иначе
		Причина = ПричинаНедействительностиПодключения(Объект, Сейчас);
	КонецЕсли;

	Если Не ПустаяСтрока(Причина) Тогда
		ЗаполнитьОшибкуТокенов(Результат, "invalid_grant", Причина);
	ИначеЕсли ТипЗнч(Ресурс) = Тип("Строка") И Не mcp1c_ПравилаOAuth.ЭквивалентныеРесурсы(Ресурс, Объект.Ресурс) Тогда
		ЗаполнитьОшибкуТокенов(Результат, "invalid_target", "resource не збігається з ресурсом запиту авторизації");
	Иначе
		Объект.КодАвторизацииИспользован = Истина;
		ВыпуститьТокены(Объект, Результат, Сейчас, Настройки);
	КонецЕсли;
	ЗаписатьЕслиИзменен(Объект);

КонецПроцедуры

Процедура ОбновитьТокеныОбъекта(Объект, Части, Клиент, Области, Ресурс, Настройки, Результат)
	// Проверки токена обновления под блокировкой подключения и замена токенов (см. ОбновитьТокены).

	Сейчас = ТекущаяУниверсальнаяДата();
	ЭтоТекущий = Не ПустаяСтрока(Объект.ХешОбновления) И Части.Хеш = Объект.ХешОбновления;
	ЭтоПредыдущий = Не ПустаяСтрока(Объект.ХешПредыдущегоОбновления) И Части.Хеш = Объект.ХешПредыдущегоОбновления;
	Причина = "";
	Если Не ЭтоТекущий И Не ЭтоПредыдущий Тогда
		Причина = "Некоректний токен оновлення";
	ИначеЕсли Объект.ИдентификаторКлиентаOAuth <> Клиент.ИдентификаторКлиента Тогда
		Причина = "Токен оновлення видано іншому клієнту OAuth";
	ИначеЕсли ЭтоПредыдущий И Объект.ДатаОбновления + ПерекрытиеОбновленияСекунд() < Сейчас Тогда
		Причина = "Повторне використання токена оновлення: підключення відкликано";
		Если Не Объект.Отозвано Тогда
			ОтозватьОбъект(Объект, Причина, Сейчас);
			Результат.Отозвано = Истина;
		КонецЕсли;
	ИначеЕсли Объект.ОбновлениеДо <= Сейчас Тогда
		Причина = "Строк дії токена оновлення минув";
	Иначе
		Причина = ПричинаНедействительностиПодключения(Объект, Сейчас);
	КонецЕсли;

	Если Не ПустаяСтрока(Причина) Тогда
		ЗаполнитьОшибкуТокенов(Результат, "invalid_grant", Причина);
	ИначеЕсли ТипЗнч(Ресурс) = Тип("Строка") И Не mcp1c_ПравилаOAuth.ЭквивалентныеРесурсы(Ресурс, Объект.Ресурс) Тогда
		ЗаполнитьОшибкуТокенов(Результат, "invalid_target", "resource не збігається з ресурсом підключення");
	ИначеЕсли Не ОбластиВходят(Области, mcp1c_ПравилаOAuth.РазобратьОбласти(Объект.Области)) Тогда
		ЗаполнитьОшибкуТокенов(Результат, "invalid_scope", "Запитано області, яких немає в підключенні");
	Иначе
		ВыпуститьТокены(Объект, Результат, Сейчас, Настройки);
	КонецЕсли;
	ЗаписатьЕслиИзменен(Объект);

КонецПроцедуры

Функция ХешиТокеновОбъекта(Объект)
	// Хеши токенов доступа и обновления подключения (текущих и предыдущих), кроме пустых.

	Хеши = Новый Массив;
	Для Каждого Хеш Из СтрРазделить(СтрШаблон("%1,%2,%3,%4", Объект.ХешДоступа, Объект.ХешПредыдущегоДоступа,
		Объект.ХешОбновления, Объект.ХешПредыдущегоОбновления), ",", Ложь) Цикл
		Хеши.Добавить(Хеш);
	КонецЦикла;
	Возврат Хеши;

КонецФункции

Функция ОбъектПодключения(Подключение, Результат)
	// Объект подключения под блокировкой; подключение и его клиент доступа - в результат для журнала.
	// Неопределено - подключение удалено.

	Объект = Подключение.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат.Подключение = Объект.Ссылка;
	Результат.Идентификатор = Объект.Код;
	Результат.КлиентДоступа = Объект.Владелец;
	Результат.ИмяКлиентаДоступа = Строка(Объект.Владелец);
	Возврат Объект;

КонецФункции

Процедура ЗаблокироватьПодключение(Подключение)
	// Исключительная блокировка подключения: параллельные запросы токенов меняют его по очереди.

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.mcp1c_ПодключенияOAuth");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Подключение);
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение СтрШаблон("Не вдалося заблокувати підключення OAuth: %1",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ПричинаНедействительностиПодключения(Объект, Сейчас)
	// Почему подключение не может получить токены: отозвано, истекло, клиент доступа или клиент OAuth недоступен.

	Если Объект.Отозвано Тогда
		Возврат "Підключення OAuth відкликано";
	ИначеЕсли Объект.ПометкаУдаления Тогда
		Возврат "Підключення OAuth позначено на вилучення";
	ИначеЕсли Объект.ДействуетДо <= Сейчас Тогда
		Возврат "Строк підключення OAuth минув";
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Клиенты.Заблокирован
	|				ИЛИ Клиенты.ПометкаУдаления
	|				ИЛИ Клиенты.Профиль = ЗНАЧЕНИЕ(Справочник.mcp1c_ПрофилиДоступа.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КлиентНедоступен,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлиентыOAuth.Заблокирован, ЛОЖЬ)
	|				ИЛИ ЕСТЬNULL(КлиентыOAuth.ПометкаУдаления, ЛОЖЬ)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КлиентOAuthЗаблокирован
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.mcp1c_КлиентыOAuth КАК КлиентыOAuth
	|		ПО (КлиентыOAuth.Ссылка = &КлиентOAuth)
	|ГДЕ
	|	Клиенты.Ссылка = &Клиент");
	Запрос.УстановитьПараметр("Клиент", Объект.Владелец);
	Запрос.УстановитьПараметр("КлиентOAuth", Объект.КлиентOAuth);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.КлиентНедоступен = Истина Тогда
		Возврат "Клієнта доступу заблоковано, вилучено або не задано йому профіль";
	ИначеЕсли Выборка.КлиентOAuthЗаблокирован = Истина Тогда
		Возврат "Клієнта OAuth заблоковано";
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура ВыпуститьТокены(Объект, Результат, Сейчас, Настройки)
	// Новые токены доступа и обновления; предыдущий токен доступа действует до своего срока.

	Минут = Мин(Макс(Цел(mcp1c_Служебный.СвойствоЧисло(Настройки, "oauthAccessTokenMinutes", 60)), 5), 1440);
	Дней = Макс(Цел(mcp1c_Служебный.СвойствоЧисло(Настройки, "oauthRefreshTokenDays", 30)), 1);
	Доступ = mcp1c_ПравилаOAuth.НовыйТокен("at", Объект.Код);
	Обновление = mcp1c_ПравилаOAuth.НовыйТокен("rt", Объект.Код);

	ДоступДо = Сейчас + Минут * 60;
	Если ДоступДо > Объект.ДействуетДо Тогда
		ДоступДо = Объект.ДействуетДо;
	КонецЕсли;
	ОбновлениеДо = Сейчас + Дней * 86400;
	Если ОбновлениеДо > Объект.ДействуетДо Тогда
		ОбновлениеДо = Объект.ДействуетДо;
	КонецЕсли;

	Объект.ХешПредыдущегоДоступа = Объект.ХешДоступа;
	Объект.ПредыдущийДоступДо = Объект.ДоступДо;
	Объект.ХешДоступа = Доступ.Хеш;
	Объект.ДоступДо = ДоступДо;
	Объект.ХешПредыдущегоОбновления = Объект.ХешОбновления;
	Объект.ХешОбновления = Обновление.Хеш;
	Объект.ОбновлениеДо = ОбновлениеДо;
	Объект.ДатаОбновления = Сейчас;

	Результат.Ответ = mcp1c_ПравилаOAuth.ОтветТокена(Доступ.Токен, Обновление.Токен, ДоступДо - Сейчас,
		mcp1c_ПравилаOAuth.РазобратьОбласти(Объект.Области));

КонецПроцедуры

Процедура ОтозватьОбъект(Объект, Причина, Сейчас)

	Объект.Отозвано = Истина;
	Объект.ДатаОтзыва = Сейчас;
	Объект.ПричинаОтзыва = Лев(Причина, 200);

КонецПроцедуры

Процедура ЗаписатьЕслиИзменен(Объект)

	Если Объект.Модифицированность() Тогда
		Объект.Записать();
	КонецЕсли;

КонецПроцедуры

Функция ОбластиВходят(Запрошенные, Выданные)

	Для Каждого ИмяОбласти Из Запрошенные Цикл
		Если Выданные.Найти(ИмяОбласти) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция СостояниеПодключения(Выборка, Сейчас)
	// Состояние для списков администратора.

	Если Выборка.Отозвано Тогда
		Возврат "відкликано";
	ИначеЕсли Не ЗначениеЗаполнено(Выборка.ДатаПодключения) Тогда
		Возврат ?(Выборка.КодПодключенияДо > Сейчас, "очікує коду", "код не використано");
	ИначеЕсли Выборка.ЕстьТокены <> Истина Тогда
		Возврат "не завершено";
	ИначеЕсли Выборка.ДействуетДо <= Сейчас Тогда
		Возврат "строк підключення минув";
	ИначеЕсли Выборка.ОбновлениеДо <= Сейчас Тогда
		Возврат "токен оновлення прострочено";
	КонецЕсли;
	Возврат "діє";

КонецФункции

Функция СрокКодаАвторизацииСекунд()

	Возврат 120;

КонецФункции

Функция ПерекрытиеОбновленияСекунд()

	Возврат 60;

КонецФункции


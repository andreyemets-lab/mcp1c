// Результат выпуска токенов.
//
// Возвращаемое значение:
//  Структура:
//   * Ошибка - Строка - код ошибки OAuth (invalid_grant, invalid_target, invalid_scope); пустая строка - успех.
//   * Причина - Строка - причина отказа для журнала.
//   * Подключение - СправочникСсылка.mcp1c_ПодключенияOAuth, Неопределено - подключение.
//   * Идентификатор - Строка - идентификатор подключения.
//   * КлиентДоступа - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - владелец подключения.
//   * ИмяКлиентаДоступа - Строка - наименование клиента доступа.
//   * Ответ - Соответствие из КлючИЗначение - тело ответа с токенами (см. mcp1c_ПравилаOAuth.ОтветТокена).
//   * Отозвано - Булево - подключение отозвано этим запросом.
//
Функция НовыйРезультатТокенов()

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Причина", "");
	Результат.Вставить("Подключение", Неопределено);
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("КлиентДоступа", Неопределено);
	Результат.Вставить("ИмяКлиентаДоступа", "");
	Результат.Вставить("Ответ", Новый Соответствие);
	Результат.Вставить("Отозвано", Ложь);
	Возврат Результат;

КонецФункции

// Подключение, которое ждет ввода кода (см. ОжидающееПодключение).

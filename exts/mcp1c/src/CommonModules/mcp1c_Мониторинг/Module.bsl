///////////////////////////////////////////////////////////////////////////////
// mcp1c_Мониторинг: данные рабочего места MCP-сервера (п. 8.3, 9.2 ТЗ) - состояние сервера,
// показатели журнала вызовов за сутки и неделю, топ инструментов и объектов, последние отказы,
// истекающие токены, активные блокировки и предупреждения.
//
// Данные читаются по правам текущего пользователя: роли mcp1c_Администратор и mcp1c_Аудитор
// читают журнал, токены и блокировки; настройки сервера - только администратор, поэтому аудитор
// видит панель без состояния сервера. Расчеты без обращений к данным - в mcp1c_Статистика.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Данные панели мониторинга. Сутки и неделя - последние 24 часа и 7 дней от текущего момента.
//
// Параметры:
//  ПрофилиСЧувствительнымиПолями - Неопределено, Массив из Строка - итог последней проверки профилей
//                                  (см. ПрофилиСЧувствительнымиПолями) для предупреждений; Неопределено -
//                                  профили не проверялись.
//
// Возвращаемое значение:
//  Структура:
//   * ЕстьПраваАдминистратора - Булево - пользователь может менять состояние сервера и снимать блокировки.
//   * НастройкиДоступны - Булево - пользователь может читать настройки сервера.
//   * Включен - Булево - сервер обрабатывает запросы.
//   * КаноническийАдрес - Строка - публичный адрес MCP-эндпоинта.
//   * Привязка - Строка - расположение базы, к которому привязан сервер; пустая - привязку зафиксирует
//                первый запрос.
//   * ЗаголовокАдресаКлиента - Строка - заголовок с IP клиента от прокси.
//   * СрокХраненияЖурнала - Число - дней; 0 - журнал не очищается.
//   * ТребуетсяПодтверждениеПереноса - Булево - последний запрос отклонен из-за смены расположения базы.
//   * ДействующихТокенов - Число - токенов, которыми можно подключиться.
//   * Показатели - ТаблицаЗначений - колонки Показатель, ЗаСутки, ЗаНеделю (Строка).
//   * Инструменты - ТаблицаЗначений - колонки Инструмент (Строка), Вызовов, Ошибок (Число), Средняя, P95,
//                   Максимум (Строка): вызовы tools/call за неделю.
//   * Объекты - ТаблицаЗначений - колонки Объект (Строка), Обращений (Число): объекты за неделю.
//   * Отказы - ТаблицаЗначений - колонки Момент (Дата, местное время), Клиент, Вызов, Результат, Причина,
//              АдресКлиента: последние неуспешные вызовы за неделю.
//   * Токены - ТаблицаЗначений - колонки Токен, Клиент, ДействуетДо (местное время), Осталось: действующие
//              токены, срок которых истекает в ближайшие дни.
//   * Блокировки - ТаблицаЗначений - колонки ВидБлокировки ("ip", "client"), Вид, Ключ, Объект, Клиент,
//                  ДействуетДо (местное время), Осталось, Причина: действующие блокировки.
//   * Предупреждения - Массив из Строка - предупреждения рабочего места.
//
Функция ДанныеПанели(ПрофилиСЧувствительнымиПолями = Неопределено) Экспорт

	ЕстьПрава = mcp1c_Администрирование.ЕстьПраваАдминистратора();
	Если Не ЕстьПрава И Не ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.mcp1c_ЖурналВызовов) Тогда
		ВызватьИсключение "Недостатньо прав для перегляду робочого місця MCP-сервера";
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДата();
	Данные = НовыеДанныеПанели(ЕстьПрава);
	ЗаполнитьСостояние(Данные);

	Запрос = Новый Запрос(ТекстЗапросаПанели());
	Запрос.УстановитьПараметр("НачалоСуток", Сейчас - 86400);
	Запрос.УстановитьПараметр("НачалоНедели", Сейчас - 7 * 86400);
	Запрос.УстановитьПараметр("Сейчас", Сейчас);
	Запрос.УстановитьПараметр("ГраницаИстечения", Сейчас + ДнейДоИстеченияТокенов() * 86400);
	Запрос.УстановитьПараметр("МетодыРаботы", СтрРазделить("tools/call,resources/read,prompts/get", ","));
	Результаты = Запрос.ВыполнитьПакет();

	ЗаполнитьПоказатели(Данные, Результаты[0].Выгрузить(), Результаты[1].Выгрузить(), Результаты[2].Выгрузить());
	ЗаполнитьИнструменты(Данные, Результаты[3].Выгрузить());
	ЗаполнитьОбъекты(Данные, Результаты[4].Выгрузить());
	ЗаполнитьОтказы(Данные, Результаты[5].Выбрать());
	ЗаполнитьТокены(Данные, Результаты[6].Выбрать(), Сейчас);
	Данные.ДействующихТокенов = Число(Результаты[7].Выгрузить()[0].Действующих);
	ЗаполнитьБлокировки(Данные, Результаты[8].Выбрать(), Сейчас);

	Адреса = Результаты[9].Выгрузить()[0];
	Факты = mcp1c_Статистика.НовыеФактыРабочегоМеста();
	Факты.НастройкиДоступны = Данные.НастройкиДоступны;
	Факты.Включен = Данные.Включен;
	Факты.АдресЗадан = Не ПустаяСтрока(Данные.КаноническийАдрес);
	Факты.ТребуетсяПодтверждениеПереноса = Данные.ТребуетсяПодтверждениеПереноса;
	Факты.ЗаголовокАдресаКлиента = Данные.ЗаголовокАдресаКлиента;
	Факты.ЗапросовСАдресом = Адреса.САдресом;
	Факты.ЗапросовБезАдреса = Адреса.БезАдреса;
	Факты.ДействующихТокенов = Данные.ДействующихТокенов;
	Факты.ИстекающихТокенов = Данные.Токены.Количество();
	Факты.ДнейДоИстечения = ДнейДоИстеченияТокенов();
	Факты.ПрофилиСЧувствительнымиПолями = ПрофилиСЧувствительнымиПолями;
	Данные.Предупреждения = mcp1c_Статистика.ПредупрежденияРабочегоМеста(Факты);
	Возврат Данные;

КонецФункции

// Профили клиентов доступа, которые показывают чувствительные поля без маски (п. 9.2 ТЗ): обход
// метаданных по каждому профилю, поэтому проверка выполняется по команде администратора.
//
// Возвращаемое значение:
//  Массив из Строка - наименования профилей.
//
Функция ПрофилиСЧувствительнымиПолями() Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Клиенты.Профиль КАК Профиль,
	|	Клиенты.Профиль.Наименование КАК Наименование
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|ГДЕ
	|	НЕ Клиенты.ПометкаУдаления
	|	И НЕ Клиенты.Профиль.ПометкаУдаления
	|	И Клиенты.Профиль <> ЗНАЧЕНИЕ(Справочник.mcp1c_ПрофилиДоступа.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Кандидаты = mcp1c_АнализДоступа.ЧувствительныеПоля(Выборка.Профиль);
		Если mcp1c_ЧувствительныеДанные.КоличествоВСостоянии(Кандидаты, "visible") > 0 Тогда
			Результат.Добавить(Строка(Выборка.Наименование));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сколько дней до окончания срока считается, что токен истекает.
//
// Возвращаемое значение:
//  Число - дней.
//
Функция ДнейДоИстеченияТокенов() Экспорт

	Возврат 7;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пустые данные панели.
//
// Параметры:
//  ЕстьПраваАдминистратора - Булево - права текущего пользователя.
//
// Возвращаемое значение:
//  см. ДанныеПанели
//
Функция НовыеДанныеПанели(ЕстьПраваАдминистратора)

	Данные = Новый Структура;
	Данные.Вставить("ЕстьПраваАдминистратора", ЕстьПраваАдминистратора);
	Данные.Вставить("НастройкиДоступны", Ложь);
	Данные.Вставить("Включен", Ложь);
	Данные.Вставить("КаноническийАдрес", "");
	Данные.Вставить("Привязка", "");
	Данные.Вставить("ЗаголовокАдресаКлиента", "");
	Данные.Вставить("СрокХраненияЖурнала", 0);
	Данные.Вставить("ТребуетсяПодтверждениеПереноса", Ложь);
	Данные.Вставить("ДействующихТокенов", 0);
	Данные.Вставить("Показатели", НоваяТаблица("Показатель, ЗаСутки, ЗаНеделю"));
	Данные.Вставить("Инструменты", НоваяТаблица("Инструмент, Вызовов, Ошибок, Средняя, P95, Максимум"));
	Данные.Вставить("Объекты", НоваяТаблица("Объект, Обращений"));
	Данные.Вставить("Отказы", НоваяТаблица("Момент, Клиент, Вызов, Результат, Причина, АдресКлиента"));
	Данные.Вставить("Токены", НоваяТаблица("Токен, Клиент, ДействуетДо, Осталось"));
	Данные.Вставить("Блокировки", НоваяТаблица("ВидБлокировки, Вид, Ключ, Объект, Клиент, ДействуетДо, Осталось, Причина"));
	Данные.Вставить("Предупреждения", Новый Массив);
	Возврат Данные;

КонецФункции

Функция НоваяТаблица(Колонки)

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Колонка Из СтрРазделить(Колонки, ",", Ложь) Цикл
		Таблица.Колонки.Добавить(СокрЛП(Колонка));
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Процедура ЗаполнитьСостояние(Данные)
	// Состояние из настроек сервера; без права чтения настроек (аудитор) - только признак недоступности.

	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.mcp1c_НастройкиСервера) Тогда
		Возврат;
	КонецЕсли;
	Настройки = mcp1c_Настройки.Получить();
	Данные.НастройкиДоступны = Истина;
	Данные.Включен = mcp1c_Служебный.СвойствоБулево(Настройки, "enabled", Ложь);
	Данные.КаноническийАдрес = mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl");
	Данные.Привязка = mcp1c_Служебный.СвойствоСтрока(Настройки, "ibBinding");
	Данные.ЗаголовокАдресаКлиента = mcp1c_Служебный.СвойствоСтрока(Настройки, "clientIpHeader");
	Данные.СрокХраненияЖурнала = mcp1c_Служебный.СвойствоЧисло(Настройки, "logRetentionDays", 180);
	Данные.ТребуетсяПодтверждениеПереноса = ПоследнийОтказПоПривязке();

КонецПроцедуры

Функция ПоследнийОтказПоПривязке()
	// Был ли последний запрос отклонен из-за смены расположения ИБ (п. 6.6 ТЗ). Привязку фиксирует сеанс
	// веб-публикации, а строка соединения в сеансе администратора может отличаться, поэтому
	// расположение здесь не сравнивается.

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Журнал.Результат КАК Результат,
	|	Журнал.Причина КАК Причина
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|
	|УПОРЯДОЧИТЬ ПО
	|	Журнал.Момент УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Выборка.Результат = Перечисления.mcp1c_РезультатыВызовов.СерверНедоступен
		И СтрНайти(Выборка.Причина, "Расположение ИБ") > 0;

КонецФункции

Функция ТекстЗапросаПанели()
	// Пакет: 0 - вызовы по результатам, 1 - гистограмма длительностей, 2 - клиенты, 3 - инструменты,
	// 4 - объекты, 5 - отказы, 6 - истекающие токены, 7 - действующие токены, 8 - блокировки,
	// 9 - запросы с IP клиента и без.

	Возврат
	"ВЫБРАТЬ
	|	Журнал.Результат КАК Результат,
	|	СУММА(ВЫБОР
	|			КОГДА Журнал.Момент >= &НачалоСуток
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВызововЗаСутки,
	|	КОЛИЧЕСТВО(*) КАК ВызововЗаНеделю,
	|	СУММА(ВЫБОР
	|			КОГДА Журнал.Момент >= &НачалоСуток
	|				ТОГДА Журнал.КоличествоСтрок
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтрокЗаСутки,
	|	СУММА(Журнал.КоличествоСтрок) КАК СтрокЗаНеделю,
	|	СУММА(ВЫБОР
	|			КОГДА Журнал.Момент >= &НачалоСуток
	|				ТОГДА Журнал.РазмерОтвета
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОбъемЗаСутки,
	|	СУММА(Журнал.РазмерОтвета) КАК ОбъемЗаНеделю
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Момент >= &НачалоНедели
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.Результат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Журнал.ДлительностьМс КАК Значение,
	|	СУММА(ВЫБОР
	|			КОГДА Журнал.Момент >= &НачалоСуток
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЗаСутки,
	|	КОЛИЧЕСТВО(*) КАК ЗаНеделю
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Момент >= &НачалоНедели
	|	И Журнал.Метод В (&МетодыРаботы)
	|	И Журнал.Результат <> ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.ОтказАутентификации)
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.ДлительностьМс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА Журнал.Момент >= &НачалоСуток
	|				ТОГДА Журнал.Клиент
	|		КОНЕЦ) КАК ЗаСутки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Журнал.Клиент) КАК ЗаНеделю
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Момент >= &НачалоНедели
	|	И Журнал.Клиент <> ЗНАЧЕНИЕ(Справочник.mcp1c_КлиентыДоступа.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Журнал.Инструмент КАК Инструмент,
	|	Журнал.ДлительностьМс КАК Значение,
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА Журнал.Результат = ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.Успех)
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК Ошибок
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Момент >= &НачалоНедели
	|	И Журнал.Метод = ""tools/call""
	|	И Журнал.Инструмент <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.Инструмент,
	|	Журнал.ДлительностьМс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Журнал.Объекты КАК Объекты,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Момент >= &НачалоНедели
	|	И Журнал.Объекты <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.Объекты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 50
	|	Журнал.Момент КАК Момент,
	|	Журнал.Клиент КАК Клиент,
	|	Журнал.Метод КАК Метод,
	|	Журнал.Инструмент КАК Инструмент,
	|	Журнал.Результат КАК Результат,
	|	Журнал.Причина КАК Причина,
	|	Журнал.АдресКлиента КАК АдресКлиента
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Момент >= &НачалоНедели
	|	И Журнал.Результат <> ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.Успех)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Журнал.Момент УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Токены.Ссылка КАК Токен,
	|	Токены.Владелец КАК Клиент,
	|	Токены.ДействуетДо КАК ДействуетДо
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.Отозван
	|	И НЕ Токены.ПометкаУдаления
	|	И Токены.ДействуетДо > &Сейчас
	|	И Токены.ДействуетДо <= &ГраницаИстечения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДействуетДо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Токены.Ссылка) КАК Действующих
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.Отозван
	|	И НЕ Токены.ПометкаУдаления
	|	И Токены.ДействуетДо > &Сейчас
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Блокировки.Вид КАК Вид,
	|	Блокировки.Ключ КАК Ключ,
	|	Блокировки.ДействуетДо КАК ДействуетДо,
	|	Блокировки.Причина КАК Причина
	|ИЗ
	|	РегистрСведений.mcp1c_Блокировки КАК Блокировки
	|ГДЕ
	|	Блокировки.ДействуетДо > &Сейчас
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДействуетДо УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Журнал.АдресКлиента = """"
	|					ТОГДА 0
	|				ИНАЧЕ 1
	|			КОНЕЦ), 0) КАК САдресом,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Журнал.АдресКлиента = """"
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК БезАдреса
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Момент >= &НачалоНедели";

КонецФункции

Процедура ЗаполнитьПоказатели(Данные, ПоРезультатам, Гистограмма, Клиенты)
	// Показатели за сутки и неделю: вызовы по результатам, строки, объем, клиенты, длительности.

	Всего = Новый Структура("ЗаСутки, ЗаНеделю", 0, 0);
	Строк = Новый Структура("ЗаСутки, ЗаНеделю", 0, 0);
	Объем = Новый Структура("ЗаСутки, ЗаНеделю", 0, 0);
	Для Каждого Строка_ Из ПоРезультатам Цикл
		Всего.ЗаСутки = Всего.ЗаСутки + Строка_.ВызововЗаСутки;
		Всего.ЗаНеделю = Всего.ЗаНеделю + Строка_.ВызововЗаНеделю;
		Строк.ЗаСутки = Строк.ЗаСутки + Строка_.СтрокЗаСутки;
		Строк.ЗаНеделю = Строк.ЗаНеделю + Строка_.СтрокЗаНеделю;
		Объем.ЗаСутки = Объем.ЗаСутки + Строка_.ОбъемЗаСутки;
		Объем.ЗаНеделю = Объем.ЗаНеделю + Строка_.ОбъемЗаНеделю;
	КонецЦикла;
	ДобавитьПоказатель(Данные, "Викликів усього", ЧислоСтрокой(Всего.ЗаСутки), ЧислоСтрокой(Всего.ЗаНеделю));

	Для Каждого Вид Из ВидыРезультатов() Цикл
		Найденная = ПоРезультатам.Найти(Вид.Значение, "Результат");
		ДобавитьПоказатель(Данные, Вид.Представление,
			ЧислоСтрокой(?(Найденная = Неопределено, 0, Найденная.ВызововЗаСутки)),
			ЧислоСтрокой(?(Найденная = Неопределено, 0, Найденная.ВызововЗаНеделю)));
	КонецЦикла;

	ДобавитьПоказатель(Данные, "Рядків видано", ЧислоСтрокой(Строк.ЗаСутки), ЧислоСтрокой(Строк.ЗаНеделю));
	ДобавитьПоказатель(Данные, "Обсяг відповідей", mcp1c_Статистика.ПредставлениеОбъема(Объем.ЗаСутки),
		mcp1c_Статистика.ПредставлениеОбъема(Объем.ЗаНеделю));
	ДобавитьПоказатель(Данные, "Клієнтів", ЧислоСтрокой(Клиенты[0].ЗаСутки), ЧислоСтрокой(Клиенты[0].ЗаНеделю));

	ЗаСутки = Новый Массив;
	ЗаНеделю = Новый Массив;
	Для Каждого Строка_ Из Гистограмма Цикл
		ЗаСутки.Добавить(mcp1c_Статистика.НоваяСтрокаГистограммы(Строка_.Значение, Строка_.ЗаСутки));
		ЗаНеделю.Добавить(mcp1c_Статистика.НоваяСтрокаГистограммы(Строка_.Значение, Строка_.ЗаНеделю));
	КонецЦикла;
	СводкаСутки = mcp1c_Статистика.СводкаДлительностей(ЗаСутки);
	СводкаНеделя = mcp1c_Статистика.СводкаДлительностей(ЗаНеделю);
	ДобавитьПоказатель(Данные, "Середня тривалість", Длительность(СводкаСутки, "Среднее"),
		Длительность(СводкаНеделя, "Среднее"));
	ДобавитьПоказатель(Данные, "Медіана тривалості", Длительность(СводкаСутки, "Медиана"),
		Длительность(СводкаНеделя, "Медиана"));
	ДобавитьПоказатель(Данные, "Тривалість p95", Длительность(СводкаСутки, "P95"), Длительность(СводкаНеделя, "P95"));
	ДобавитьПоказатель(Данные, "Найдовший виклик", Длительность(СводкаСутки, "Максимум"),
		Длительность(СводкаНеделя, "Максимум"));

КонецПроцедуры

Функция ВидыРезультатов()
	// Результаты вызовов в порядке строк панели.

	Результаты = Перечисления.mcp1c_РезультатыВызовов;
	Виды = Новый СписокЗначений;
	Виды.Добавить(Результаты.Успех, "Успішних");
	Виды.Добавить(Результаты.ОшибкаИнструмента, "Помилок інструментів");
	Виды.Добавить(Результаты.ОшибкаЗапроса, "Помилок у запитах");
	Виды.Добавить(Результаты.ОтказДоступа, "Відмов доступу");
	Виды.Добавить(Результаты.ПревышениеЛимита, "Перевищень лімітів");
	Виды.Добавить(Результаты.ОтказАутентификации, "Відмов автентифікації");
	Виды.Добавить(Результаты.СерверНедоступен, "Відповідей «сервер недоступний»");
	Виды.Добавить(Результаты.ВнутренняяОшибка, "Внутрішніх помилок");
	Возврат Виды;

КонецФункции

Функция ПредставлениеРезультата(Результат)
	// Результат вызова для таблицы отказов.

	Результаты = Перечисления.mcp1c_РезультатыВызовов;
	Если Результат = Результаты.ОшибкаИнструмента Тогда
		Возврат "Помилка інструмента";
	ИначеЕсли Результат = Результаты.ОшибкаЗапроса Тогда
		Возврат "Помилка в запиті";
	ИначеЕсли Результат = Результаты.ОтказДоступа Тогда
		Возврат "Відмова доступу";
	ИначеЕсли Результат = Результаты.ПревышениеЛимита Тогда
		Возврат "Перевищення ліміту";
	ИначеЕсли Результат = Результаты.ОтказАутентификации Тогда
		Возврат "Відмова автентифікації";
	ИначеЕсли Результат = Результаты.СерверНедоступен Тогда
		Возврат "Сервер недоступний";
	ИначеЕсли Результат = Результаты.ВнутренняяОшибка Тогда
		Возврат "Внутрішня помилка";
	ИначеЕсли Результат = Результаты.Успех Тогда
		Возврат "Успіх";
	КонецЕсли;
	Возврат Строка(Результат);

КонецФункции

Процедура ДобавитьПоказатель(Данные, Показатель, ЗаСутки, ЗаНеделю)

	Строка_ = Данные.Показатели.Добавить();
	Строка_.Показатель = Показатель;
	Строка_.ЗаСутки = ЗаСутки;
	Строка_.ЗаНеделю = ЗаНеделю;

КонецПроцедуры

Функция Длительность(Сводка, Показатель)
	// Длительность из сводки; без вызовов - прочерк.

	Если Сводка.Количество = 0 Тогда
		Возврат "—";
	КонецЕсли;
	Возврат mcp1c_Статистика.ПредставлениеДлительности(Сводка[Показатель]);

КонецФункции

Процедура ЗаполнитьИнструменты(Данные, Строки)
	// Инструменты за неделю: число вызовов, ошибки и длительности по гистограмме каждого инструмента.

	Гистограмма = Новый Массив;
	Ошибки = Новый Соответствие;
	Для Каждого Строка_ Из Строки Цикл
		Гистограмма.Добавить(mcp1c_Статистика.НоваяСтрокаГистограммы(Строка_.Значение, Строка_.Количество,
			Строка_.Инструмент));
		Было = Ошибки.Получить(Строка_.Инструмент);
		Ошибки.Вставить(Строка_.Инструмент, ?(Было = Неопределено, 0, Было) + Строка_.Ошибок);
	КонецЦикла;

	Для Каждого Элемент Из mcp1c_Статистика.СводкиДлительностейПоКлючам(Гистограмма) Цикл
		Сводка = Элемент.Значение;
		Строка_ = Данные.Инструменты.Добавить();
		Строка_.Инструмент = Элемент.Ключ;
		Строка_.Вызовов = Сводка.Количество;
		Строка_.Ошибок = Ошибки.Получить(Элемент.Ключ);
		Строка_.Средняя = mcp1c_Статистика.ПредставлениеДлительности(Сводка.Среднее);
		Строка_.P95 = mcp1c_Статистика.ПредставлениеДлительности(Сводка.P95);
		Строка_.Максимум = mcp1c_Статистика.ПредставлениеДлительности(Сводка.Максимум);
	КонецЦикла;
	Данные.Инструменты.Сортировать("Вызовов Убыв, Инструмент");

КонецПроцедуры

Процедура ЗаполнитьОбъекты(Данные, Строки)
	// Топ объектов за неделю по спискам объектов в журнале.

	Списки = Новый Массив;
	Для Каждого Строка_ Из Строки Цикл
		Списки.Добавить(mcp1c_Статистика.НоваяСтрокаОбъектов(Строка_.Объекты, Строка_.Количество));
	КонецЦикла;
	Для Каждого Элемент Из mcp1c_Статистика.ТопОбъектов(Списки, 30) Цикл
		ЗаполнитьЗначенияСвойств(Данные.Объекты.Добавить(), Элемент);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьОтказы(Данные, Выборка)
	// Последние неуспешные вызовы; время - местное время сеанса.

	ЧасовойПояс = ЧасовойПоясСеанса();
	Пока Выборка.Следующий() Цикл
		Строка_ = Данные.Отказы.Добавить();
		Строка_.Момент = МестноеВремя(Выборка.Момент, ЧасовойПояс);
		Строка_.Клиент = Выборка.Клиент;
		Строка_.Вызов = СокрЛП(Выборка.Метод + " " + Выборка.Инструмент);
		Строка_.Результат = ПредставлениеРезультата(Выборка.Результат);
		Строка_.Причина = Выборка.Причина;
		Строка_.АдресКлиента = Выборка.АдресКлиента;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТокены(Данные, Выборка, Сейчас)
	// Действующие токены, срок которых скоро истекает.

	ЧасовойПояс = ЧасовойПоясСеанса();
	Пока Выборка.Следующий() Цикл
		Строка_ = Данные.Токены.Добавить();
		Строка_.Токен = Выборка.Токен;
		Строка_.Клиент = Выборка.Клиент;
		Строка_.ДействуетДо = МестноеВремя(Выборка.ДействуетДо, ЧасовойПояс);
		Строка_.Осталось = mcp1c_Статистика.ПредставлениеОстатка(Выборка.ДействуетДо - Сейчас);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьБлокировки(Данные, Выборка, Сейчас)
	// Действующие блокировки IP-адресов и клиентов; ключ блокировки клиента - его уникальный идентификатор.

	ЧасовойПояс = ЧасовойПоясСеанса();
	Пока Выборка.Следующий() Цикл
		Строка_ = Данные.Блокировки.Добавить();
		Строка_.ВидБлокировки = Выборка.Вид;
		Строка_.Ключ = Выборка.Ключ;
		Строка_.ДействуетДо = МестноеВремя(Выборка.ДействуетДо, ЧасовойПояс);
		Строка_.Осталось = mcp1c_Статистика.ПредставлениеОстатка(Выборка.ДействуетДо - Сейчас);
		Строка_.Причина = Выборка.Причина;
		Если Выборка.Вид = "client" Тогда
			Строка_.Вид = "Клієнт";
			Строка_.Клиент = КлиентПоКлючу(Выборка.Ключ);
			Строка_.Объект = ?(ЗначениеЗаполнено(Строка_.Клиент), Строка(Строка_.Клиент), Выборка.Ключ);
		Иначе
			Строка_.Вид = "IP-адреса";
			Строка_.Объект = Выборка.Ключ;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КлиентПоКлючу(Ключ)
	// Клиент доступа по ключу блокировки; ссылка на удаленного клиента - пустая.

	Попытка
		Ссылка = Справочники.mcp1c_КлиентыДоступа.ПолучитьСсылку(Новый УникальныйИдентификатор(Ключ));
	Исключение
		Возврат Справочники.mcp1c_КлиентыДоступа.ПустаяСсылка();
	КонецПопытки;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Клиенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|ГДЕ
	|	Клиенты.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Справочники.mcp1c_КлиентыДоступа.ПустаяСсылка();
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

Функция ЧислоСтрокой(Число)

	Возврат Формат(Число, "ЧН=0");

КонецФункции


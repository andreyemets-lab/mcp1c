///////////////////////////////////////////////////////////////////////////////
// mcp1c_OAuth: сервер авторизации OAuth 2.1 и метаданные защищенного ресурса (п. 6.4 ТЗ). Маршруты
// обслуживает тот же HTTP-сервис mcp1c_Сервер, что и MCP-эндпоинт: одна публикация и один маршрут прокси.
//
// Маршруты относительно корня сервиса (публичные адреса - в mcp1c_ПравилаOAuth):
//  GET  /.well-known/oauth-protected-resource         - метаданные защищенного ресурса (RFC 9728);
//  GET  /oauth/.well-known/oauth-authorization-server  - метаданные сервера авторизации (RFC 8414);
//  GET  /oauth/.well-known/openid-configuration        - они же по адресу OpenID Connect Discovery;
//  GET  /oauth/jwks                                    - пустой набор ключей: ID-токены не выпускаются;
//  GET  /oauth/authorize                               - страница ввода кода подключения;
//  POST /oauth/authorize                               - код подключения, затем решение пользователя;
//  POST /oauth/token                                   - обмен кода авторизации, обновление токенов;
//  POST /oauth/revoke                                  - отзыв токена (RFC 7009);
//  POST /oauth/register                                - динамическая регистрация (RFC 7591), если включена.
// Варианты от корня сайта (/.well-known/oauth-authorization-server/<путь> и т.п.) прокси направляет
// на /.well-known/... сервиса: они принимаются с любым продолжением пути.
//
// Состояние между шагами страницы авторизации хранится в подписанных полях формы (oauthSecret),
// подключения и токены - в mcp1c_ДанныеOAuth. Каждый запрос пишется в журнал вызовов с методом
// "oauth/<конечная точка>"; неверный код подключения учитывается для блокировки IP (п. 6.5 ТЗ),
// ошибки конечной точки токенов - нет: секреты там не подбираются, а запросы веб-коннекторов идут
// с общих адресов провайдера.
// Во внешнем соединении модуль не компилируется (HTTPСервисОтвет); флаги - как у mcp1c_Протокол.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Относится ли путь к маршрутам OAuth.
//
// Параметры:
//  Путь - Строка - относительный путь запроса.
//
// Возвращаемое значение:
//  Булево - Истина для /oauth/... и /.well-known/....
//
Функция ЭтоМаршрут(Путь) Экспорт

	Возврат СтрНачинаетсяС(Путь, "/oauth/") Или СтрНачинаетсяС(Путь, "/.well-known/");

КонецФункции

// Обрабатывает запрос к маршрутам OAuth. Настройки и IP клиента в контексте уже заполнены.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос.
//  Путь - Строка - относительный путь запроса.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ.
//
Функция ОбработатьЗапрос(Запрос, Путь, Контекст) Экспорт

	Точка = КонечнаяТочка(Путь);
	Контекст.МетодRPC = "oauth/" + ?(ПустаяСтрока(Точка), "unknown", Точка);
	Если ПустаяСтрока(Точка) Тогда
		Возврат ОтветТекст(Контекст, 404, "Not found");
	КонецЕсли;
	ЭтоСтраница = (Точка = "authorize");
	Если Запрос.HTTPМетод = "OPTIONS" И Не ЭтоСтраница Тогда
		Возврат ОтветПредварительныйЗапросCORS(Контекст);
	КонецЕсли;

	Настройки = Контекст.Настройки;
	Ответ = ПроверитьДоступность(Настройки, ЭтоСтраница, Контекст);
	Если Ответ <> Неопределено Тогда
		Возврат Ответ;
	КонецЕсли;
	Ресурс = mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl");

	Если ЭтоСтраница Тогда
		Если Запрос.HTTPМетод = "GET" Тогда
			Возврат ЗапросАвторизации(Запрос, Ресурс, Настройки, Контекст);
		ИначеЕсли Запрос.HTTPМетод = "POST" Тогда
			Возврат ФормаАвторизации(Запрос, Ресурс, Настройки, Контекст);
		КонецЕсли;
		Возврат ОтветМетодНеРазрешен(Контекст, "GET, POST");
	КонецЕсли;

	Если Точка = "token" Или Точка = "revoke" Или Точка = "register" Тогда
		Если Запрос.HTTPМетод <> "POST" Тогда
			Возврат ОтветМетодНеРазрешен(Контекст, "POST");
		ИначеЕсли Точка = "token" Тогда
			Возврат ЗапросТокенов(Запрос, Настройки, Контекст);
		ИначеЕсли Точка = "revoke" Тогда
			Возврат ЗапросОтзыва(Запрос, Контекст);
		КонецЕсли;
		Возврат ЗапросРегистрации(Запрос, Настройки, Контекст);
	КонецЕсли;

	Если Запрос.HTTPМетод <> "GET" Тогда
		Возврат ОтветМетодНеРазрешен(Контекст, "GET");
	КонецЕсли;
	Регистрация = mcp1c_Служебный.СвойствоБулево(Настройки, "oauthDynamicRegistration", Ложь);
	Если Точка = "resource-metadata" Тогда
		Документ = mcp1c_ПравилаOAuth.МетаданныеРесурса(Ресурс, "MCP-сервер 1С: " + Метаданные.Синоним);
	ИначеЕсли Точка = "metadata" Тогда
		Документ = mcp1c_ПравилаOAuth.МетаданныеСервераАвторизации(Ресурс, Регистрация);
	ИначеЕсли Точка = "openid-configuration" Тогда
		Документ = mcp1c_ПравилаOAuth.МетаданныеСервераАвторизации(Ресурс, Регистрация, Истина);
	Иначе
		Документ = Новый Соответствие;
		Документ.Вставить("keys", Новый Массив);
	КонецЕсли;
	Возврат ОтветJSON(Контекст, 200, Документ, Истина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Маршруты

Функция КонечнаяТочка(Путь)
	// Имя конечной точки по пути; пустая строка - путь не обслуживается.

	Если ПутьСовпадает(Путь, "/.well-known/oauth-protected-resource") Тогда
		Возврат "resource-metadata";
	ИначеЕсли Путь = "/oauth/.well-known/oauth-authorization-server"
		Или ПутьСовпадает(Путь, "/.well-known/oauth-authorization-server") Тогда
		Возврат "metadata";
	ИначеЕсли Путь = "/oauth/.well-known/openid-configuration"
		Или ПутьСовпадает(Путь, "/.well-known/openid-configuration") Тогда
		Возврат "openid-configuration";
	КонецЕсли;
	Точки = СтрРазделить("jwks,authorize,token,revoke,register", ",");
	Для Каждого Точка Из Точки Цикл
		Если Путь = "/oauth/" + Точка Тогда
			Возврат Точка;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ПутьСовпадает(Путь, Основа)
	// Путь равен основе или продолжает ее (варианты от корня сайта: основа + "/" + путь ресурса).

	Возврат Путь = Основа Или СтрНачинаетсяС(Путь, Основа + "/");

КонецФункции

Функция ПроверитьДоступность(Настройки, ЭтоСтраница, Контекст)
	// Сервер включен, привязка к ИБ совпадает (п. 6.6 ТЗ), OAuth включен и публичный адрес задан.

	Если Не mcp1c_Служебный.СвойствоБулево(Настройки, "enabled", Ложь) Тогда
		Контекст.Причина = "Сервер вимкнено";
		Возврат ОтветНедоступен(Контекст, ЭтоСтраница, "MCP-сервер 1С вимкнено.");
	КонецЕсли;
	ПривязкаСохраненная = mcp1c_Служебный.СвойствоСтрока(Настройки, "ibBinding");
	ПривязкаТекущая = mcp1c_Настройки.ПривязкаКИнформационнойБазе();
	Если Не ПустаяСтрока(ПривязкаСохраненная) И ПривязкаСохраненная <> ПривязкаТекущая Тогда
		Контекст.Причина = "Розташування ІБ відрізняється від зафіксованого: потрібне підтвердження перенесення";
		mcp1c_Аудит.ЗаписатьСобытиеБезопасности(Контекст.Причина,
			СтрШаблон("Зафіксовано: %1; поточне: %2", ПривязкаСохраненная, ПривязкаТекущая));
		Возврат ОтветНедоступен(Контекст, ЭтоСтраница, "Базу 1С перенесено: адміністратор має підтвердити нове розташування.");
	КонецЕсли;
	Если Не mcp1c_Служебный.СвойствоБулево(Настройки, "oauthEnabled", Ложь) Тогда
		Контекст.Причина = "OAuth вимкнено в налаштуваннях сервера";
		Возврат ОтветТекст(Контекст, 404, "Not found");
	КонецЕсли;
	Если ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl")) Тогда
		Контекст.Причина = "Не задано публічну адресу сервера (canonicalUrl): OAuth не працює";
		Возврат ОтветНедоступен(Контекст, ЭтоСтраница, "Не задано публічну адресу MCP-сервера.");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Авторизация

Функция ЗапросАвторизации(Запрос, Ресурс, Настройки, Контекст)
	// GET /authorize: проверка клиента и адреса возврата, затем страница ввода кода подключения.

	Параметры = Запрос.ПараметрыЗапроса;
	ИдентификаторКлиента = ПараметрСтрокой(Параметры, "client_id");
	Контекст.ИнформацияКлиента = Лев(ИдентификаторКлиента, 200);
	Клиент = КлиентДляАвторизации(ИдентификаторКлиента, Настройки, Контекст);
	Если Клиент = Неопределено Тогда
		Возврат ОтветСтраницаОшибки(Контекст, 400, Контекст.Причина);
	КонецЕсли;

	АдресВозврата = ПараметрСтрокой(Параметры, "redirect_uri");
	Если ПустаяСтрока(АдресВозврата) И Клиент.АдресаВозврата.Количество() = 1 Тогда
		АдресВозврата = Клиент.АдресаВозврата[0];
	КонецЕсли;
	Если Не mcp1c_ПравилаOAuth.АдресВозвратаЗарегистрирован(АдресВозврата, Клиент.АдресаВозврата) Тогда
		Контекст.Причина = "Адресу повернення не зареєстровано для клієнта OAuth: " + Лев(АдресВозврата, 200);
		Возврат ОтветСтраницаОшибки(Контекст, 400, Контекст.Причина);
	КонецЕсли;

	// Дальше ошибки возвращаются клиенту на адрес возврата (RFC 6749, п. 4.1.2.1).
	Состояние = ПараметрСтрокой(Параметры, "state");
	Ошибка = ОшибкаЗапросаАвторизации(Параметры, Ресурс);
	Если Ошибка <> Неопределено Тогда
		Контекст.Причина = Ошибка.Причина;
		Возврат ОтветПеренаправлениеСОшибкой(Контекст, АдресВозврата, Ошибка.Код, Ошибка.Описание, Состояние, Ресурс, 302);
	КонецЕсли;

	Данные = Новый Соответствие;
	Данные.Вставить("client_id", ИдентификаторКлиента);
	Данные.Вставить("redirect_uri", АдресВозврата);
	Данные.Вставить("state", Состояние);
	Данные.Вставить("code_challenge", ПараметрСтрокой(Параметры, "code_challenge"));
	Данные.Вставить("scope", mcp1c_ПравилаOAuth.ОбластиСтрокой(
		mcp1c_ПравилаOAuth.РазобратьОбласти(ПараметрСтрокой(Параметры, "scope"))));
	Данные.Вставить("resource", ПараметрСтрокой(Параметры, "resource"));
	Подписанные = mcp1c_ПравилаOAuth.ПодписанныеДанные(mcp1c_Настройки.СекретOAuth(), "request", Данные,
		СекундыСейчас() + СрокФормыСекунд());
	Страница = ДанныеСтраницы(Клиент, АдресВозврата, Ресурс);
	Страница.Запрос = Подписанные;
	Возврат ОтветСтраница(Контекст, 200, mcp1c_ПравилаOAuth.СтраницаКода(Страница));

КонецФункции

// Ошибка параметров запроса авторизации, о которой сообщается клиенту.
//
// Параметры:
//  Параметры - ФиксированноеСоответствие из КлючИЗначение - параметры строки запроса.
//  Ресурс - Строка - публичный адрес MCP-эндпоинта.
//
// Возвращаемое значение:
//  - Неопределено - параметры верны.
//  - Структура:
//   * Код - Строка - error (RFC 6749, п. 4.1.2.1; RFC 8707).
//   * Описание - Строка - error_description.
//   * Причина - Строка - причина для журнала.
//
Функция ОшибкаЗапросаАвторизации(Параметры, Ресурс)

	Если ПараметрСтрокой(Параметры, "response_type") <> "code" Тогда
		Возврат НоваяОшибка("unsupported_response_type", "response_type must be code",
			"Непідтримуваний response_type: підтримується лише code");
	ИначеЕсли ПараметрСтрокой(Параметры, "code_challenge_method") <> "S256" Тогда
		Возврат НоваяОшибка("invalid_request", "code_challenge_method must be S256",
			"Немає PKCE з методом S256");
	ИначеЕсли Не mcp1c_ПравилаOAuth.ВызовPKCEКорректен(ПараметрСтрокой(Параметры, "code_challenge")) Тогда
		Возврат НоваяОшибка("invalid_request", "code_challenge is invalid", "Некоректний code_challenge");
	ИначеЕсли СтрДлина(ПараметрСтрокой(Параметры, "state")) > 1000 Тогда
		Возврат НоваяОшибка("invalid_request", "state is too long", "Параметр state довший за 1000 символів");
	КонецЕсли;
	ЗапрошенныйРесурс = ПараметрСтрокой(Параметры, "resource");
	Если ПустаяСтрока(ЗапрошенныйРесурс) Тогда
		Возврат НоваяОшибка("invalid_request", "resource is required", "Не вказано resource (RFC 8707)");
	ИначеЕсли Не mcp1c_ПравилаOAuth.ЭквивалентныеРесурсы(ЗапрошенныйРесурс, Ресурс) Тогда
		Возврат НоваяОшибка("invalid_target", "resource is not served by this server",
			"resource не збігається з публічною адресою сервера: " + Лев(ЗапрошенныйРесурс, 200));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ФормаАвторизации(Запрос, Ресурс, Настройки, Контекст)
	// POST /authorize: код подключения (поле request) или решение пользователя (поле approval).

	Разбор = ПараметрыФормыЗапроса(Запрос, Настройки, Контекст);
	Если Разбор = Неопределено Тогда
		Возврат ОтветСтраницаОшибки(Контекст, 400, "Некоректні дані форми підключення.");
	КонецЕсли;
	Если Разбор.Получить("approval") <> Неопределено Тогда
		Возврат РешениеПользователя(Разбор, Ресурс, Настройки, Контекст);
	ИначеЕсли Разбор.Получить("request") <> Неопределено Тогда
		Возврат ВводКодаПодключения(Разбор, Ресурс, Настройки, Контекст);
	КонецЕсли;
	Контекст.Причина = "У формі немає полів request або approval";
	Возврат ОтветСтраницаОшибки(Контекст, 400, "Некоректні дані форми підключення.");

КонецФункции

Функция ВводКодаПодключения(Поля, Ресурс, Настройки, Контекст)
	// Проверка кода подключения: верный код - страница согласия, неверный - отказ аутентификации (п. 6.5 ТЗ).

	Секрет = mcp1c_Настройки.СекретOAuth();
	Данные = mcp1c_ПравилаOAuth.ПроверенныеДанные(Секрет, "request", Поля.Получить("request"), СекундыСейчас());
	Если Данные = Неопределено Тогда
		Контекст.Причина = "Дані сторінки підключення недійсні або застаріли";
		Возврат ОтветСтраницаОшибки(Контекст, 400, ТекстЗастаревшейСтраницы());
	КонецЕсли;
	Клиент = ЗарегистрированныйКлиент(Данные, Контекст);
	Если Клиент = Неопределено Тогда
		Возврат ОтветСтраницаОшибки(Контекст, 400, Контекст.Причина);
	КонецЕсли;
	АдресВозврата = Строка(Данные.Получить("redirect_uri"));
	Страница = ДанныеСтраницы(Клиент, АдресВозврата, Ресурс);
	Страница.Запрос = Поля.Получить("request");

	Осталось = mcp1c_Лимиты.ОсталосьБлокировкиАдреса(Контекст.IP);
	Если Осталось > 0 Тогда
		Контекст.Причина = "IP-адресу заблоковано після невдалих автентифікацій";
		Страница.Ошибка = "Забагато невдалих спроб. Спробуйте ще раз через "
			+ mcp1c_Статистика.ПредставлениеОстатка(Осталось) + ".";
		Возврат ОтветСтраница(Контекст, 429, mcp1c_ПравилаOAuth.СтраницаКода(Страница));
	КонецЕсли;

	Подключение = mcp1c_ДанныеOAuth.ОжидающееПодключение(
		mcp1c_ПравилаOAuth.ХешКодаПодключения(Поля.Получить("connection_code")));
	Если Подключение = Неопределено Тогда
		Контекст.ОтказАутентификации = Истина;
		Контекст.Причина = "Неправильний або прострочений код підключення";
		mcp1c_Лимиты.ЗарегистрироватьОтказАутентификации(Контекст.IP, Настройки);
		Страница.Ошибка = "Код неправильний або строк його дії минув. Перевірте код або попросіть адміністратора "
			+ "видати новий.";
		Возврат ОтветСтраница(Контекст, 400, mcp1c_ПравилаOAuth.СтраницаКода(Страница));
	КонецЕсли;
	Контекст.КлиентСсылка = Подключение.Клиент;
	Контекст.Клиент = Подключение.ИмяКлиента;
	Контекст.ИдентификаторТокена = Подключение.Идентификатор;
	Если Не Подключение.КлиентДоступен Тогда
		Контекст.Причина = "Клієнта доступу заблоковано, вилучено або не задано йому профіль";
		Возврат ОтветСтраницаОшибки(Контекст, 403, Контекст.Причина + ". Зверніться до адміністратора MCP-сервера.");
	КонецЕсли;

	Политика = mcp1c_Политики.ПолитикаКлиента(Подключение.Клиент, Настройки);
	Выданные = mcp1c_ПравилаOAuth.ВыданныеОбласти(
		mcp1c_ПравилаOAuth.РазобратьОбласти(Данные.Получить("scope")), mcp1c_ПравилаOAuth.ДоступныеОбласти(Политика));
	Согласие = Новый Соответствие;
	Для Каждого Элемент Из Данные Цикл
		Согласие.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Согласие.Вставить("scope", mcp1c_ПравилаOAuth.ОбластиСтрокой(Выданные));
	Согласие.Вставить("connection", Подключение.Идентификатор);
	Страница.Согласие = mcp1c_ПравилаOAuth.ПодписанныеДанные(Секрет, "approval", Согласие,
		СекундыСейчас() + СрокФормыСекунд());
	Страница.КлиентДоступа = Подключение.ИмяКлиента;
	Страница.Профиль = Подключение.ИмяПрофиля;
	Страница.Области = Выданные;
	Возврат ОтветСтраница(Контекст, 200, mcp1c_ПравилаOAuth.СтраницаСогласия(Страница));

КонецФункции

Функция РешениеПользователя(Поля, Ресурс, Настройки, Контекст)
	// Решение на странице согласия: отказ - access_denied, разрешение - код авторизации на адрес возврата.

	Данные = mcp1c_ПравилаOAuth.ПроверенныеДанные(mcp1c_Настройки.СекретOAuth(), "approval", Поля.Получить("approval"),
		СекундыСейчас());
	Если Данные = Неопределено Тогда
		Контекст.Причина = "Дані сторінки згоди недійсні або застаріли";
		Возврат ОтветСтраницаОшибки(Контекст, 400, ТекстЗастаревшейСтраницы());
	КонецЕсли;
	Клиент = ЗарегистрированныйКлиент(Данные, Контекст);
	Если Клиент = Неопределено Тогда
		Возврат ОтветСтраницаОшибки(Контекст, 400, Контекст.Причина);
	КонецЕсли;
	АдресВозврата = Строка(Данные.Получить("redirect_uri"));
	Состояние = Строка(Данные.Получить("state"));
	Идентификатор = Строка(Данные.Получить("connection"));
	Контекст.ИдентификаторТокена = Идентификатор;
	Доступ = mcp1c_ДанныеOAuth.ДанныеДоступа(Идентификатор);
	Подключение = Неопределено;
	Если Доступ <> Неопределено Тогда
		Подключение = Доступ.Ссылка;
		Контекст.КлиентСсылка = Доступ.Клиент;
		Контекст.Клиент = Доступ.ИмяКлиента;
	КонецЕсли;

	Если Поля.Получить("decision") <> "allow" Тогда
		Контекст.Причина = "Користувач відмовив у доступі";
		Возврат ОтветПеренаправлениеСОшибкой(Контекст, АдресВозврата, "access_denied", "the user denied access",
			Состояние, Ресурс, 303);
	КонецЕсли;
	Если Подключение = Неопределено Тогда
		Контекст.Причина = "Підключення OAuth не знайдено";
		Возврат ОтветСтраницаОшибки(Контекст, 400, ТекстЗастаревшейСтраницы());
	КонецЕсли;

	Области = mcp1c_ПравилаOAuth.РазобратьОбласти(Данные.Получить("scope"));
	Параметры = Новый Структура;
	Параметры.Вставить("КлиентOAuth", Клиент.Ссылка);
	Параметры.Вставить("ИдентификаторКлиента", Клиент.ИдентификаторКлиента);
	Параметры.Вставить("ИмяКлиента", ИмяКлиентаДляСписка(Клиент));
	Параметры.Вставить("АдресВозврата", АдресВозврата);
	Параметры.Вставить("Области", Области);
	Параметры.Вставить("Ресурс", Строка(Данные.Получить("resource")));
	Параметры.Вставить("ВызовPKCE", Строка(Данные.Получить("code_challenge")));
	Итог = mcp1c_ДанныеOAuth.ПодтвердитьПодключение(Подключение, Параметры, Настройки);
	Если ПустаяСтрока(Итог.Код) Тогда
		Контекст.Причина = Итог.Причина;
		Возврат ОтветСтраницаОшибки(Контекст, 400, Итог.Причина + ". Почніть підключення в AI-клієнті ще раз "
			+ "і попросіть адміністратора видати новий код.");
	КонецЕсли;

	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон(
		"Підключення OAuth %1 клієнта доступу ""%2"" підтверджено: застосунок %3, повернення на %4, області: %5",
		Идентификатор, Контекст.Клиент, Параметры.ИмяКлиента, mcp1c_ПравилаOAuth.ХостАдреса(АдресВозврата),
		mcp1c_ПравилаOAuth.ОбластиСтрокой(Области)));
	ПараметрыОтвета = Новый Соответствие;
	ПараметрыОтвета.Вставить("code", Итог.Код);
	ПараметрыОтвета.Вставить("state", Состояние);
	ПараметрыОтвета.Вставить("iss", mcp1c_ПравилаOAuth.Издатель(Ресурс));
	Возврат ОтветПеренаправление(Контекст, mcp1c_ПравилаOAuth.АдресСПараметрами(АдресВозврата, ПараметрыОтвета), 303);

КонецФункции

// Клиент OAuth для запроса авторизации: зарегистрированный или по документу метаданных (CIMD).
// Документ хранится сутки; если обновить его не удалось, используется сохраненный.
//
// Параметры:
//  ИдентификаторКлиента - Строка - client_id.
//  Настройки - см. mcp1c_Настройки.Получить
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  - Неопределено - клиент не принят; причина - в Контекст.Причина.
//  - см. mcp1c_ДанныеOAuth.НовыеДанныеКлиента
//
Функция КлиентДляАвторизации(ИдентификаторКлиента, Настройки, Контекст)

	Если ПустаяСтрока(ИдентификаторКлиента) Тогда
		Контекст.Причина = "Не вказано client_id";
		Возврат Неопределено;
	КонецЕсли;
	Клиент = mcp1c_ДанныеOAuth.КлиентOAuth(ИдентификаторКлиента);
	ЭтоДокумент = mcp1c_ПравилаOAuth.ЭтоАдресCIMD(ИдентификаторКлиента)
		И (Клиент = Неопределено Или Клиент.Источник = "cimd");
	Если ЭтоДокумент И (Клиент = Неопределено
		Или ТекущаяУниверсальнаяДата() - Клиент.ДатаЗагрузки > СрокКешаДокументаСекунд()) Тогда
		Клиент = ОбновленныйКлиентCIMD(ИдентификаторКлиента, Клиент, Настройки, Контекст);
	КонецЕсли;
	Если Клиент = Неопределено Тогда
		Если ПустаяСтрока(Контекст.Причина) Тогда
			Контекст.Причина = "Клієнта OAuth не зареєстровано на сервері: " + Лев(ИдентификаторКлиента, 200);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДоступныйКлиент(Клиент, Контекст);

КонецФункции

Функция ОбновленныйКлиентCIMD(ИдентификаторКлиента, Сохраненный, Настройки, Контекст)
	// Загружает и проверяет документ метаданных клиента; при сбое загрузки - сохраненный документ.

	ОшибкаАдреса = mcp1c_ПравилаOAuth.ОшибкаАдресаCIMD(ИдентификаторКлиента,
		mcp1c_Служебный.СвойствоМассив(Настройки, "oauthCimdPrefixes"));
	Если Не ПустаяСтрока(ОшибкаАдреса) Тогда
		Контекст.Причина = "Документ метаданих клієнта не дозволено: " + ОшибкаАдреса;
		Возврат Неопределено;
	КонецЕсли;

	Загрузка = ЗагрузитьДокументCIMD(ИдентификаторКлиента);
	Если Не ПустаяСтрока(Загрузка.Ошибка) Тогда
		Если Сохраненный <> Неопределено Тогда
			mcp1c_Аудит.ЗаписатьОшибку("Не вдалося оновити документ метаданих клієнта OAuth, використано збережений",
				ИдентификаторКлиента + ": " + Загрузка.Ошибка);
			Возврат Сохраненный;
		КонецЕсли;
		Контекст.Причина = СтрШаблон("Не вдалося завантажити документ метаданих клієнта %1: %2",
			Лев(ИдентификаторКлиента, 200), Загрузка.Ошибка);
		Возврат Неопределено;
	КонецЕсли;

	Описание = mcp1c_ПравилаOAuth.ПроверитьДокументCIMD(Загрузка.Текст, ИдентификаторКлиента);
	Если Не ПустаяСтрока(Описание.Ошибка) Тогда
		Контекст.Причина = "Документ метаданих клієнта не прийнято: " + Описание.Ошибка;
		Возврат Неопределено;
	КонецЕсли;
	Возврат mcp1c_ДанныеOAuth.СохранитьКлиентаCIMD(ИдентификаторКлиента, Описание, Загрузка.Текст);

КонецФункции

// Загружает документ метаданных клиента: https с проверкой сертификата по хранилищу ОС, без перенаправлений,
// тайм-аут 5 с, не больше 16 КБ (п. 6.4 ТЗ). Разрешение имени хоста в 1С недоступно, поэтому защита
// от SSRF - доверенные префиксы адресов и запрет IP-адресов (см. mcp1c_ПравилаOAuth.ОшибкаАдресаCIMD).
//
// Параметры:
//  Адрес - Строка - client_id.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - документ.
//   * Ошибка - Строка - причина сбоя; пустая строка - документ загружен.
//
Функция ЗагрузитьДокументCIMD(Адрес)

	Результат = Новый Структура("Текст, Ошибка", "", "");
	Части = mcp1c_ПравилаOAuth.РазобратьАдрес(Адрес);
	Если Части = Неопределено Тогда
		Результат.Ошибка = "некоректна адреса";
		Возврат Результат;
	КонецЕсли;
	Ресурс = Части.Путь + ?(ПустаяСтрока(Части.Запрос), "", "?" + Части.Запрос);
	Попытка
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
		Соединение = Новый HTTPСоединение(Части.Хост, 443, , , Новый ИнтернетПрокси(Истина), 5, ЗащищенноеСоединение);
		ЗапросДокумента = Новый HTTPЗапрос(Ресурс);
		ЗапросДокумента.Заголовки.Вставить("Accept", "application/json");
		ЗапросДокумента.Заголовки.Вставить("User-Agent", "mcp1c/" + mcp1c_Служебный.ВерсияСервера());
		Ответ = Соединение.Получить(ЗапросДокумента);
		Тело = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Ошибка = СтрШаблон("сервер відповів HTTP %1", Формат(Ответ.КодСостояния, "ЧГ=0"));
	ИначеЕсли Тело = Неопределено Или Тело.Размер() = 0 Тогда
		Результат.Ошибка = "порожня відповідь";
	ИначеЕсли Тело.Размер() > 16384 Тогда
		Результат.Ошибка = "документ більший за 16 КБ";
	Иначе
		Результат.Текст = ПолучитьСтрокуИзДвоичныхДанных(Тело, КодировкаТекста.UTF8);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗарегистрированныйКлиент(Данные, Контекст)
	// Клиент OAuth из подписанных данных формы: он мог быть заблокирован, пока открыта страница.

	ИдентификаторКлиента = Строка(Данные.Получить("client_id"));
	Контекст.ИнформацияКлиента = Лев(ИдентификаторКлиента, 200);
	Клиент = mcp1c_ДанныеOAuth.КлиентOAuth(ИдентификаторКлиента);
	Если Клиент = Неопределено Тогда
		Контекст.Причина = "Клієнта OAuth не знайдено: " + Лев(ИдентификаторКлиента, 200);
		Возврат Неопределено;
	КонецЕсли;
	Клиент = ДоступныйКлиент(Клиент, Контекст);
	Если Клиент <> Неопределено
		И Не mcp1c_ПравилаOAuth.АдресВозвратаЗарегистрирован(Строка(Данные.Получить("redirect_uri")), Клиент.АдресаВозврата) Тогда
		Контекст.Причина = "Адресу повернення більше не зареєстровано для клієнта OAuth";
		Возврат Неопределено;
	КонецЕсли;
	Возврат Клиент;

КонецФункции

Функция ДоступныйКлиент(Клиент, Контекст)
	// Клиент, если он не помечен на удаление и не заблокирован; иначе Неопределено с причиной в контексте.

	Если Клиент.Удален Тогда
		Контекст.Причина = "Клієнта OAuth позначено на вилучення";
		Возврат Неопределено;
	ИначеЕсли Клиент.Заблокирован Тогда
		Контекст.Причина = "Клієнта OAuth заблоковано адміністратором";
		Возврат Неопределено;
	КонецЕсли;
	Возврат Клиент;

КонецФункции

// Данные страниц авторизации (см. mcp1c_ПравилаOAuth.СтраницаКода и СтраницаСогласия).
//
// Параметры:
//  Клиент - см. mcp1c_ДанныеOAuth.НовыеДанныеКлиента
//  АдресВозврата - Строка - redirect_uri.
//  Ресурс - Строка - публичный адрес MCP-эндпоинта.
//
// Возвращаемое значение:
//  Структура:
//   * Действие - Строка - адрес формы.
//   * Запрос - Строка - подписанные данные запроса авторизации.
//   * Согласие - Строка - подписанные данные согласия.
//   * База - Строка - название базы.
//   * Приложение - Строка - кто просит доступ.
//   * ИмяКлиента - Строка - client_name.
//   * ХостВозврата - Строка - хост адреса возврата.
//   * ТолькоПетлевые - Булево - у клиента только петлевые адреса возврата.
//   * Ошибка - Строка - сообщение об ошибке ввода.
//   * КлиентДоступа - Строка - наименование клиента доступа.
//   * Профиль - Строка - наименование профиля.
//   * Области - Массив из Строка - области, которые получит токен.
//
Функция ДанныеСтраницы(Клиент, АдресВозврата, Ресурс)

	Данные = Новый Структура;
	Данные.Вставить("Действие", mcp1c_ПравилаOAuth.Издатель(Ресурс) + "/authorize");
	Данные.Вставить("Запрос", "");
	Данные.Вставить("Согласие", "");
	Данные.Вставить("База", Строка(Метаданные.Синоним));
	Данные.Вставить("Приложение", mcp1c_ПравилаOAuth.ПредставлениеКлиента(Клиент.Источник,
		Клиент.ИдентификаторКлиента, Клиент.Имя));
	Данные.Вставить("ИмяКлиента", Клиент.Имя);
	Данные.Вставить("ХостВозврата", mcp1c_ПравилаOAuth.ХостАдреса(АдресВозврата));
	Данные.Вставить("ТолькоПетлевые", mcp1c_ПравилаOAuth.ТолькоПетлевыеАдреса(Клиент.АдресаВозврата));
	Данные.Вставить("Ошибка", "");
	Данные.Вставить("КлиентДоступа", "");
	Данные.Вставить("Профиль", "");
	Данные.Вставить("Области", Новый Массив);
	Возврат Данные;

КонецФункции

Функция ИмяКлиентаДляСписка(Клиент)
	// Застосунок для списка подключений: имя клиента и, для CIMD, хост документа.

	Если Клиент.Источник = "cimd" Тогда
		Возврат СтрШаблон("%1 (%2)", Клиент.Имя, mcp1c_ПравилаOAuth.ХостАдреса(Клиент.ИдентификаторКлиента));
	ИначеЕсли Клиент.Источник = "dcr" Тогда
		Возврат Клиент.Имя + " (самостійна реєстрація)";
	КонецЕсли;
	Возврат Клиент.Имя;

КонецФункции

Функция ТекстЗастаревшейСтраницы()

	Возврат "Сторінка підключення застаріла. Почніть підключення в AI-клієнті ще раз.";

КонецФункции

#КонецОбласти

#Область Токены

Функция ЗапросТокенов(Запрос, Настройки, Контекст)
	// POST /token: authorization_code или refresh_token (RFC 6749, п. 4.1.3, 6).

	Поля = ПараметрыФормыЗапроса(Запрос, Настройки, Контекст);
	Если Поля = Неопределено Тогда
		Возврат ОтветОшибкаOAuth(Контекст, 400, "invalid_request", "the request body must be a valid form");
	КонецЕсли;
	Проверка = АутентифицироватьКлиента(Запрос, Поля, Контекст);
	Если Проверка.Ответ <> Неопределено Тогда
		Возврат Проверка.Ответ;
	КонецЕсли;
	Клиент = Проверка.Клиент;

	ВидРазрешения = ПараметрСтрокой(Поля, "grant_type");
	Контекст.Инструмент = Лев(ВидРазрешения, 100);
	Если ВидРазрешения = "authorization_code" Тогда
		Части = mcp1c_ПравилаOAuth.РазобратьТокен(Поля.Получить("code"));
		Если Части = Неопределено Или Части.Вид <> "ac" Тогда
			Контекст.Причина = "Некоректний код авторизації";
			Возврат ОтветОшибкаOAuth(Контекст, 400, "invalid_grant", ОписаниеОшибкиТокенов("invalid_grant"));
		КонецЕсли;
		Итог = mcp1c_ДанныеOAuth.ОбменятьКодАвторизации(Части, Клиент, Поля.Получить("redirect_uri"),
			Поля.Получить("code_verifier"), Поля.Получить("resource"), Настройки);
	ИначеЕсли ВидРазрешения = "refresh_token" Тогда
		Части = mcp1c_ПравилаOAuth.РазобратьТокен(Поля.Получить("refresh_token"));
		Если Части = Неопределено Или Части.Вид <> "rt" Тогда
			Контекст.Причина = "Некоректний токен оновлення";
			Возврат ОтветОшибкаOAuth(Контекст, 400, "invalid_grant", ОписаниеОшибкиТокенов("invalid_grant"));
		КонецЕсли;
		Итог = mcp1c_ДанныеOAuth.ОбновитьТокены(Части, Клиент,
			mcp1c_ПравилаOAuth.РазобратьОбласти(Поля.Получить("scope")), Поля.Получить("resource"), Настройки);
	Иначе
		Контекст.Причина = "Непідтримуваний grant_type: " + Лев(ВидРазрешения, 100);
		Возврат ОтветОшибкаOAuth(Контекст, 400, "unsupported_grant_type",
			"grant_type must be authorization_code or refresh_token");
	КонецЕсли;

	ЗаполнитьКонтекстПодключения(Контекст, Итог);
	Если Итог.Отозвано Тогда
		mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Підключення OAuth %1 відкликано", Итог.Идентификатор),
			Итог.Причина);
	КонецЕсли;
	Если Не ПустаяСтрока(Итог.Ошибка) Тогда
		Контекст.Причина = Итог.Причина;
		Возврат ОтветОшибкаOAuth(Контекст, 400, Итог.Ошибка, ОписаниеОшибкиТокенов(Итог.Ошибка));
	КонецЕсли;
	Возврат ОтветJSON(Контекст, 200, Итог.Ответ);

КонецФункции

Функция ЗапросОтзыва(Запрос, Контекст)
	// POST /revoke (RFC 7009): ответ 200 и для неизвестного токена.

	Поля = ПараметрыФормыЗапроса(Запрос, Контекст.Настройки, Контекст);
	Если Поля = Неопределено Тогда
		Возврат ОтветОшибкаOAuth(Контекст, 400, "invalid_request", "the request body must be a valid form");
	КонецЕсли;
	Проверка = АутентифицироватьКлиента(Запрос, Поля, Контекст);
	Если Проверка.Ответ <> Неопределено Тогда
		Возврат Проверка.Ответ;
	КонецЕсли;
	Токен = ПараметрСтрокой(Поля, "token");
	Если ПустаяСтрока(Токен) Тогда
		Контекст.Причина = "Не вказано token";
		Возврат ОтветОшибкаOAuth(Контекст, 400, "invalid_request", "token is required");
	КонецЕсли;

	Части = mcp1c_ПравилаOAuth.РазобратьТокен(Токен);
	Если Части = Неопределено Тогда
		Контекст.Причина = "Токен не належить серверу";
	Иначе
		Итог = mcp1c_ДанныеOAuth.ОтозватьПоТокену(Части, Проверка.Клиент);
		ЗаполнитьКонтекстПодключения(Контекст, Итог);
		Контекст.Причина = Итог.Причина;
		Если Итог.Отозвано Тогда
			mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Клієнт OAuth %1 відкликав підключення %2",
				Проверка.Клиент.ИдентификаторКлиента, Итог.Идентификатор));
		КонецЕсли;
	КонецЕсли;
	Возврат ОтветJSON(Контекст, 200, Новый Соответствие);

КонецФункции

// Аутентификация клиента на конечных точках токенов и отзыва (RFC 6749, п. 2.3): публичный клиент - только
// client_id, конфиденциальный - секрет в заголовке Basic или в теле. Заголовок Authorization веб-расширение
// 1С забирает себе, поэтому прокси переносит его в X-MCP-Authorization.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос.
//  Поля - Соответствие из КлючИЗначение - параметры формы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Клиент - см. mcp1c_ДанныеOAuth.НовыеДанныеКлиента
//   * Ответ - HTTPСервисОтвет, Неопределено - ответ об ошибке; Неопределено - клиент аутентифицирован.
//
Функция АутентифицироватьКлиента(Запрос, Поля, Контекст)

	Результат = Новый Структура("Клиент, Ответ", mcp1c_ДанныеOAuth.НовыеДанныеКлиента(), Неопределено);
	Basic = mcp1c_ПравилаOAuth.УчетныеДанныеBasic(mcp1c_Служебный.ЗаголовокЗапроса(Запрос, "X-MCP-Authorization"));
	Если Basic = Неопределено Тогда
		Basic = mcp1c_ПравилаOAuth.УчетныеДанныеBasic(mcp1c_Служебный.ЗаголовокЗапроса(Запрос, "Authorization"));
	КонецЕсли;
	ИдентификаторФормы = ПараметрСтрокой(Поля, "client_id");
	СекретФормы = ПараметрСтрокой(Поля, "client_secret");
	Если Basic <> Неопределено И Не ПустаяСтрока(ИдентификаторФормы) И ИдентификаторФормы <> Basic.Идентификатор Тогда
		Контекст.Причина = "client_id у тілі і в заголовку Basic різні";
		Результат.Ответ = ОтветОшибкаOAuth(Контекст, 400, "invalid_request", "client_id does not match the credentials");
		Возврат Результат;
	КонецЕсли;
	Идентификатор = ?(Basic = Неопределено, ИдентификаторФормы, Basic.Идентификатор);
	Секрет = ?(Basic = Неопределено, СекретФормы, Basic.Секрет);
	Контекст.ИнформацияКлиента = Лев(Идентификатор, 200);

	Клиент = mcp1c_ДанныеOAuth.КлиентOAuth(Идентификатор);
	Причина = "";
	Если ПустаяСтрока(Идентификатор) Тогда
		Причина = "Не вказано client_id";
	ИначеЕсли Клиент = Неопределено Тогда
		Причина = "Клієнта OAuth не знайдено";
	ИначеЕсли Клиент.Удален Или Клиент.Заблокирован Тогда
		Причина = "Клієнта OAuth заблоковано або позначено на вилучення";
	ИначеЕсли Клиент.СпособАутентификации = "none" Тогда
		Если Не ПустаяСтрока(Секрет) Тогда
			Причина = "Публічний клієнт OAuth передав секрет";
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(Секрет) Или ПустаяСтрока(Клиент.ХешСекрета)
		Или mcp1c_Служебный.ХешSHA256(Секрет) <> Клиент.ХешСекрета Тогда
		Причина = "Некоректний секрет клієнта OAuth";
	КонецЕсли;
	Если ПустаяСтрока(Причина) Тогда
		Результат.Клиент = Клиент;
		Возврат Результат;
	КонецЕсли;

	Контекст.Причина = Причина;
	Результат.Ответ = ОтветОшибкаOAuth(Контекст, 401, "invalid_client", "client authentication failed");
	Если Basic <> Неопределено Тогда
		Результат.Ответ.Заголовки.Вставить("WWW-Authenticate", "Basic realm=""mcp1c-oauth""");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ЗаполнитьКонтекстПодключения(Контекст, Итог)
	// Подключение и клиент доступа для журнала вызовов.

	Если Итог.Подключение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контекст.ИдентификаторТокена = Итог.Идентификатор;
	Контекст.КлиентСсылка = Итог.КлиентДоступа;
	Контекст.Клиент = Итог.ИмяКлиентаДоступа;

КонецПроцедуры

Функция ОписаниеОшибкиТокенов(Код)
	// error_description конечной точки токенов: по RFC 6749 только ASCII, подробности - в журнале.

	Если Код = "invalid_grant" Тогда
		Возврат "the authorization grant is invalid, expired or revoked";
	ИначеЕсли Код = "invalid_target" Тогда
		Возврат "resource does not match the authorization";
	ИначеЕсли Код = "invalid_scope" Тогда
		Возврат "the requested scope exceeds the granted scope";
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Регистрация

Функция ЗапросРегистрации(Запрос, Настройки, Контекст)
	// POST /register (RFC 7591): только если динамическая регистрация включена; не больше 100 клиентов в час.

	Если Не mcp1c_Служебный.СвойствоБулево(Настройки, "oauthDynamicRegistration", Ложь) Тогда
		Контекст.Причина = "Динамічну реєстрацію клієнтів вимкнено";
		Возврат ОтветТекст(Контекст, 404, "Not found");
	КонецЕсли;
	ТипСодержимого = mcp1c_Служебный.ЗаголовокЗапроса(Запрос, "Content-Type");
	Если ТипЗнч(ТипСодержимого) <> Тип("Строка") Или СтрНайти(НРег(ТипСодержимого), "application/json") = 0 Тогда
		Контекст.Причина = "Content-Type не application/json";
		Возврат ОтветОшибкаOAuth(Контекст, 400, "invalid_client_metadata", "Content-Type must be application/json");
	КонецЕсли;
	Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если Тело.Размер() > 16384 Тогда
		Контекст.Причина = "Запит реєстрації більший за 16 КБ";
		Возврат ОтветОшибкаOAuth(Контекст, 400, "invalid_client_metadata", "client metadata is too large");
	КонецЕсли;
	Если mcp1c_ДанныеOAuth.РегистрацийЗаЧас() >= 100 Тогда
		Контекст.Причина = "Перевищено ліміт динамічних реєстрацій: 100 за годину";
		Ответ = ОтветОшибкаOAuth(Контекст, 429, "temporarily_unavailable", "too many registrations, try later");
		Ответ.Заголовки.Вставить("Retry-After", "600");
		Возврат Ответ;
	КонецЕсли;

	Описание = mcp1c_ПравилаOAuth.ПроверитьЗапросРегистрации(ПолучитьСтрокуИзДвоичныхДанных(Тело, КодировкаТекста.UTF8));
	Если Не ПустаяСтрока(Описание.Ошибка) Тогда
		Контекст.Причина = "Запит реєстрації не прийнято: " + Описание.Ошибка;
		Возврат ОтветОшибкаOAuth(Контекст, 400, Описание.КодОшибки, ?(Описание.КодОшибки = "invalid_redirect_uri",
			"redirect_uris must use https or http on a loopback address", "client metadata is invalid"));
	КонецЕсли;
	Итог = mcp1c_ДанныеOAuth.ЗарегистрироватьКлиента(Описание, "dcr", "Динамічна реєстрація з IP " + Контекст.IP);
	Контекст.ИнформацияКлиента = Итог.ИдентификаторКлиента;
	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Динамічно зареєстровано клієнта OAuth %1 (""%2""), адреси повернення: %3",
		Итог.ИдентификаторКлиента, Описание.Имя, СтрСоединить(Описание.АдресаВозврата, ", ")));

	Документ = Новый Соответствие;
	Документ.Вставить("client_id", Итог.ИдентификаторКлиента);
	Документ.Вставить("client_id_issued_at", mcp1c_Курсор.СекундыОтНачалаЭпохи(Итог.ДатаРегистрации));
	Если Не ПустаяСтрока(Итог.Секрет) Тогда
		Документ.Вставить("client_secret", Итог.Секрет);
		Документ.Вставить("client_secret_expires_at", 0);
	КонецЕсли;
	Документ.Вставить("client_name", Описание.Имя);
	Документ.Вставить("redirect_uris", Описание.АдресаВозврата);
	Документ.Вставить("grant_types", СтрРазделить("authorization_code,refresh_token", ","));
	Документ.Вставить("response_types", СтрРазделить("code", ","));
	Документ.Вставить("token_endpoint_auth_method", Описание.СпособАутентификации);
	Возврат ОтветJSON(Контекст, 201, Документ);

КонецФункции

#КонецОбласти

#Область Ответы

Функция ОтветJSON(Контекст, КодСостояния, Данные, Кешировать = Ложь)

	Контекст.КодHTTP = КодСостояния;
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если Кешировать Тогда
		Ответ.Заголовки.Вставить("Cache-Control", "max-age=300");
	Иначе
		Ответ.Заголовки.Вставить("Cache-Control", "no-store");
		Ответ.Заголовки.Вставить("Pragma", "no-cache");
	КонецЕсли;
	Ответ.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.УстановитьТелоИзСтроки(mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Данные),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ОтветОшибкаOAuth(Контекст, КодСостояния, Код, Описание)

	Возврат ОтветJSON(Контекст, КодСостояния, mcp1c_ПравилаOAuth.ОшибкаOAuth(Код, Описание));

КонецФункции

Функция ОтветСтраница(Контекст, КодСостояния, ТекстСтраницы)
	// Страница без скриптов и внешних ресурсов; встраивание во фреймы запрещено (защита от кликджекинга).
	// form-action в CSP не задается: браузер проверяет его и для перенаправления на адрес возврата клиента.

	Контекст.КодHTTP = КодСостояния;
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "text/html; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.Заголовки.Вставить("Pragma", "no-cache");
	Ответ.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
	Ответ.Заголовки.Вставить("X-Frame-Options", "DENY");
	Ответ.Заголовки.Вставить("Referrer-Policy", "no-referrer");
	Ответ.Заголовки.Вставить("Content-Security-Policy",
		"default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'");
	Ответ.УстановитьТелоИзСтроки(ТекстСтраницы, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ОтветСтраницаОшибки(Контекст, КодСостояния, Текст)

	Возврат ОтветСтраница(Контекст, КодСостояния, mcp1c_ПравилаOAuth.СтраницаОшибки(Текст));

КонецФункции

Функция ОтветПеренаправление(Контекст, Адрес, КодСостояния)
	// 302 после GET и 303 после POST: браузер не должен повторять POST формы на адресе клиента.

	Контекст.КодHTTP = КодСостояния;
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Location", Адрес);
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.Заголовки.Вставить("Referrer-Policy", "no-referrer");
	Возврат Ответ;

КонецФункции

Функция ОтветПеренаправлениеСОшибкой(Контекст, АдресВозврата, Код, Описание, Состояние, Ресурс, КодСостояния)

	Параметры = Новый Соответствие;
	Параметры.Вставить("error", Код);
	Параметры.Вставить("error_description", Описание);
	Параметры.Вставить("state", Состояние);
	Параметры.Вставить("iss", mcp1c_ПравилаOAuth.Издатель(Ресурс));
	Возврат ОтветПеренаправление(Контекст, mcp1c_ПравилаOAuth.АдресСПараметрами(АдресВозврата, Параметры), КодСостояния);

КонецФункции

Функция ОтветНедоступен(Контекст, ЭтоСтраница, Текст)

	Если ЭтоСтраница Тогда
		Возврат ОтветСтраницаОшибки(Контекст, 503, Текст);
	КонецЕсли;
	Возврат ОтветОшибкаOAuth(Контекст, 503, "temporarily_unavailable", "the server is unavailable");

КонецФункции

Функция ОтветПредварительныйЗапросCORS(Контекст)
	// Предварительный запрос CORS браузерных клиентов к метаданным и конечным точкам токенов.

	Контекст.КодHTTP = 204;
	Ответ = Новый HTTPСервисОтвет(204);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Authorization, Content-Type, MCP-Protocol-Version");
	Ответ.Заголовки.Вставить("Access-Control-Max-Age", "86400");
	Возврат Ответ;

КонецФункции

Функция ОтветМетодНеРазрешен(Контекст, Разрешенные)

	Ответ = ОтветТекст(Контекст, 405, "Method not allowed");
	Ответ.Заголовки.Вставить("Allow", Разрешенные);
	Возврат Ответ;

КонецФункции

Функция ОтветТекст(Контекст, КодСостояния, Текст)

	Контекст.КодHTTP = КодСостояния;
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область Вспомогательные

Функция ПараметрыФормыЗапроса(Запрос, Настройки, Контекст)
	// Поля формы application/x-www-form-urlencoded; Неопределено - другой тип, слишком большое тело или повтор поля.

	ТипСодержимого = mcp1c_Служебный.ЗаголовокЗапроса(Запрос, "Content-Type");
	Если ТипЗнч(ТипСодержимого) <> Тип("Строка")
		Или СтрНайти(НРег(ТипСодержимого), "application/x-www-form-urlencoded") = 0 Тогда
		Контекст.Причина = "Content-Type не application/x-www-form-urlencoded";
		Возврат Неопределено;
	КонецЕсли;
	Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если Тело.Размер() > mcp1c_Служебный.СвойствоЧисло(Настройки, "maxBodyBytes", 262144) Тогда
		Контекст.Причина = "Перевищено розмір тіла запиту";
		Возврат Неопределено;
	КонецЕсли;
	Разбор = mcp1c_ПравилаOAuth.ПараметрыФормы(ПолучитьСтрокуИзДвоичныхДанных(Тело, КодировкаТекста.UTF8));
	Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
		Контекст.Причина = "Некоректна форма: " + Разбор.Ошибка;
		Возврат Неопределено;
	КонецЕсли;
	Возврат Разбор.Параметры;

КонецФункции

Функция ПараметрСтрокой(Параметры, Имя)
	// Значение параметра запроса или поля формы; пустая строка, если его нет.

	Значение = Параметры.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

// Ошибка запроса авторизации.
//
// Параметры:
//  Код - Строка - error.
//  Описание - Строка - error_description.
//  Причина - Строка - причина для журнала.

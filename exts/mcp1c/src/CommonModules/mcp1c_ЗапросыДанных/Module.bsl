КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Построение

// Состояние построения запроса.
//
// Параметры:
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания для разыменования.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Лимит - Число - строк на странице.
//  Смещение - Число - сколько строк пропустить.
//
// Возвращаемое значение:
//  Структура:
//   * Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы.
//   * Описания - Соответствие - описания для разыменования.
//   * Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика.
//   * СистемнаяПолитика - см. mcp1c_ПравилаДоступа.НоваяПолитика - для служебных условий.
//   * Спецификация - см. mcp1c_КонструкторЗапросов.НоваяСпецификация.
//   * Параметры - Соответствие из КлючИЗначение - имя параметра и см. НовоеЗначение.
//   * Колонки - Массив из Структура - Имя, Вид, Псевдоним, Представление, Типы.
//   * Группировка - Булево - запрос с группировкой.
//   * Периодичность - Строка - ключевое слово периодичности оборотов.
//   * Лимит - Число - строк на странице.
//   * Смещение - Число - сколько строк пропустить.
//   * Ошибка - Строка - ошибка для модели; построение остановлено.
//   * Причина - Строка - подробная причина для журнала.
//   * НужноОписание - Строка - полное имя объекта, описание которого нужно загрузить.
//   * Примечания - Массив из Строка - примечания для модели.
//
Функция НовоеПостроение(Таблица, Описания, Политика, Лимит, Смещение)

	П = Новый Структура;
	П.Вставить("Таблица", Таблица);
	П.Вставить("Описания", Описания);
	П.Вставить("Политика", Политика);
	П.Вставить("СистемнаяПолитика", СистемнаяПолитика(Политика));
	П.Вставить("Спецификация", mcp1c_КонструкторЗапросов.НоваяСпецификация(Таблица.Имя));
	П.Вставить("Параметры", Новый Соответствие);
	П.Вставить("Колонки", Новый Массив);
	П.Вставить("Группировка", Ложь);
	П.Вставить("Периодичность", "");
	П.Вставить("Лимит", Лимит);
	П.Вставить("Смещение", Смещение);
	П.Вставить("Ошибка", "");
	П.Вставить("Причина", "");
	П.Вставить("НужноОписание", "");
	П.Вставить("Примечания", Новый Массив);
	Возврат П;

КонецФункции

Функция СистемнаяПолитика(Политика)
	// Политика для служебных условий: все поля доступны, разыменование не ограничено
	// ограничениями строк. Глобально запрещенные объекты расширения остаются недоступны.

	Результат = mcp1c_ПравилаДоступа.НоваяПолитика();
	Результат.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("*"));
	Результат.Лимиты.ГлубинаРазыменования = Макс(Политика.Лимиты.ГлубинаРазыменования, 3);
	Возврат Результат;

КонецФункции

Процедура Остановить(П, ТекстОшибки, Причина = "")

	Если ПустаяСтрока(П.Ошибка) Тогда
		П.Ошибка = ТекстОшибки;
		П.Причина = Причина;
	КонецЕсли;

КонецПроцедуры

Функция Остановлено(П)

	Возврат Не ПустаяСтрока(П.Ошибка) Или Не ПустаяСтрока(П.НужноОписание);

КонецФункции

Процедура Завершить(П)

	Если Остановлено(П) Тогда
		Возврат;
	КонецЕсли;
	Если П.Колонки.Количество() = 0 Тогда
		Остановить(П, СтрШаблон("У «%1» немає доступних полів для вибірки. Перелік полів дає describe_object.",
			П.Таблица.Объект));
		Возврат;
	КонецЕсли;
	П.Спецификация.Первые = П.Смещение + П.Лимит + 1;

КонецПроцедуры

Функция РазобратьПутьКлиента(П, Путь)
	// Разбирает путь поля политикой клиента. При ошибке останавливает построение.

	Возврат РазобратьПутьПоПолитике(П, Путь, П.Политика);

КонецФункции

Функция РазобратьПутьСистемы(П, Путь)
	// Разбирает путь служебного условия системной политикой.

	Возврат РазобратьПутьПоПолитике(П, Путь, П.СистемнаяПолитика);

КонецФункции

Функция РазобратьПутьПоПолитике(П, Путь, Политика)

	Если Остановлено(П) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Путь) <> Тип("Строка") Тогда
		Остановить(П, "Ім'я поля має бути рядком");
		Возврат Неопределено;
	КонецЕсли;
	Разбор = mcp1c_ПутиПолей.РазобратьПуть(П.Таблица, Путь, П.Описания, Политика);
	Если Не ПустаяСтрока(Разбор.НужноОписание) Тогда
		П.НужноОписание = Разбор.НужноОписание;
		Возврат Неопределено;
	КонецЕсли;
	Если Не Разбор.Успех Тогда
		Остановить(П, Разбор.Ошибка);
		Возврат Неопределено;
	КонецЕсли;
	Если Разбор.Поле.Роль = "period" И ПустаяСтрока(П.Периодичность) Тогда
		Остановить(П, "Поле Период доступне лише з periodicity");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Разбор;

КонецФункции

Функция ДобавитьПараметр(П, Значение)

	Имя = "П" + Формат(П.Параметры.Количество() + 1, "ЧН=0; ЧГ=0");
	П.Параметры.Вставить(Имя, Значение);
	Возврат Имя;

КонецФункции

#КонецОбласти

#Область Колонки

Функция ДобавитьКолонку(П, Разбор, ИмяКолонки, Агрегат = "", ВидКолонки = "")
	// Добавляет колонку выборки. Повторное поле не дублируется.

	Для Каждого Колонка Из П.Колонки Цикл
		Если НРег(Колонка.Имя) = НРег(ИмяКолонки) Тогда
			Возврат Колонка;
		КонецЕсли;
	КонецЦикла;

	Псевдоним = "К" + Формат(П.Колонки.Количество() + 1, "ЧН=0; ЧГ=0");
	Выражение = ?(Разбор = Неопределено, "*", Разбор.Выражение);
	Типы = ?(Разбор = Неопределено, Новый Массив, Разбор.Типы);
	Неограниченная = Разбор <> Неопределено И Разбор.НеограниченнаяСтрока;
	ЕстьСсылки = ПустаяСтрока(Агрегат) И mcp1c_ПутиПолей.ЕстьСсылочныйТип(Типы);

	П.Спецификация.Поля.Добавить(mcp1c_КонструкторЗапросов.НовоеПолеВыборки(Выражение, Псевдоним, Агрегат,
		?(ЕстьСсылки, "ссылки", ""), Неограниченная));

	Колонка = Новый Структура;
	Колонка.Вставить("Имя", ИмяКолонки);
	Колонка.Вставить("Вид", ?(ПустаяСтрока(ВидКолонки), mcp1c_ПутиПолей.ВидЗначений(Типы), ВидКолонки));
	Колонка.Вставить("Псевдоним", Псевдоним);
	Колонка.Вставить("Представление", ЕстьСсылки);
	Колонка.Вставить("Типы", Типы);
	Колонка.Вставить("Выражение", Выражение);
	Колонка.Вставить("НеограниченнаяСтрока", Неограниченная);
	П.Колонки.Добавить(Колонка);
	Возврат Колонка;

КонецФункции

Процедура ДобавитьКолонкуЕслиДоступна(П, Имя)
	// Добавляет колонку по имени поля, если поле доступно клиенту; скрытые поля пропускаются молча.

	Если Остановлено(П) Тогда
		Возврат;
	КонецЕсли;
	Разбор = mcp1c_ПутиПолей.РазобратьПуть(П.Таблица, Имя, П.Описания, П.Политика);
	Если Разбор.Успех И Не (Разбор.Поле.Роль = "period" И ПустаяСтрока(П.Периодичность)) Тогда
		ДобавитьКолонку(П, Разбор, Разбор.Путь);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоля(П, Поля)

	Для Каждого Путь Из Поля Цикл
		Разбор = РазобратьПутьКлиента(П, Путь);
		Если Разбор = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ДобавитьКолонку(П, Разбор, Разбор.Путь);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоляПоУмолчанию(П)
	// Ключевые поля и до МаксимумРеквизитовПоУмолчанию первых доступных реквизитов (п. 5.3 ТЗ).

	Для Каждого Имя Из П.Таблица.КлючевыеПоля Цикл
		ДобавитьКолонкуЕслиДоступна(П, Имя);
	КонецЦикла;

	Максимум = МаксимумРеквизитовПоУмолчанию();
	Добавлено = 0;
	Пропущено = 0;
	Для Каждого Поле Из П.Таблица.Поля Цикл
		Если Поле.Роль = "standard" Или Поле.Роль = "period" Тогда
			Продолжить;
		КонецЕсли;
		Разбор = mcp1c_ПутиПолей.РазобратьПуть(П.Таблица, Поле.Имя, П.Описания, П.Политика);
		Если Не Разбор.Успех Или ЕстьКолонка(П, Разбор.Путь) Тогда
			Продолжить;
		КонецЕсли;
		Если Добавлено >= Максимум Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		ДобавитьКолонку(П, Разбор, Разбор.Путь);
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Если Пропущено > 0 Тогда
		П.Примечания.Добавить(СтрШаблон("Показано ключові поля і перші %1 реквізитів; ще %2 полів задайте в fields "
			+ "(перелік дає describe_object)", Максимум, Пропущено));
	КонецЕсли;

КонецПроцедуры

Функция ЕстьКолонка(П, Имя)

	Для Каждого Колонка Из П.Колонки Цикл
		Если НРег(Колонка.Имя) = НРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция НайтиКолонку(П, Имя)

	Для Каждого Колонка Из П.Колонки Цикл
		Если НРег(Колонка.Имя) = НРег(СокрЛП(Имя)) Тогда
			Возврат Колонка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция МаксимумРеквизитовПоУмолчанию()

	Возврат 20;

КонецФункции

#КонецОбласти

#Область Группировки

Процедура ДобавитьГруппировки(П, Группировки)

	Для Каждого Путь Из Группировки Цикл
		ДобавитьГруппировку(П, Путь);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьГруппировку(П, Путь, Системная = Ложь)

	Разбор = ?(Системная, РазобратьПутьСистемы(П, Путь), РазобратьПутьКлиента(П, Путь));
	Если Разбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Разбор.Поле.Роль = "resource" И Не ПустаяСтрока(П.Таблица.ВиртуальнаяТаблица) Тогда
		Остановить(П, СтрШаблон("Групувати за ресурсом «%1» не можна: задайте його в resources", Разбор.Путь));
		Возврат;
	КонецЕсли;
	Если ЕстьКолонка(П, Разбор.Путь) Тогда
		Возврат;
	КонецЕсли;
	ДобавитьКолонку(П, Разбор, Разбор.Путь);
	П.Спецификация.Группировки.Добавить(mcp1c_КонструкторЗапросов.НовоеВыражение(Разбор.Выражение,
		Разбор.НеограниченнаяСтрока));

КонецПроцедуры

Процедура ДобавитьАгрегаты(П, Агрегаты)

	Для Каждого Описание Из Агрегаты Цикл
		Если Остановлено(П) Тогда
			Возврат;
		КонецЕсли;
		ДобавитьАгрегат(П, Описание);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьАгрегат(П, Описание)

	Функция_ = Свойство(Описание, "func", "");
	Путь = СокрЛП(Свойство(Описание, "field", ""));
	Агрегат = ФункцииАгрегатов().Получить(Функция_);
	Если Агрегат = Неопределено Тогда
		Остановить(П, "aggregates.func: допустимі значення sum, count, count_distinct, avg, min, max");
		Возврат;
	КонецЕсли;

	Разбор = Неопределено;
	Если Функция_ = "count" И (Путь = "*" Или ПустаяСтрока(Путь)) Тогда
		Путь = "*";
	Иначе
		Разбор = РазобратьПутьКлиента(П, Путь);
		Если Разбор = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ОшибкаТипа = ОшибкаТипаАгрегата(Функция_, Разбор);
		Если Не ПустаяСтрока(ОшибкаТипа) Тогда
			Остановить(П, ОшибкаТипа);
			Возврат;
		КонецЕсли;
		Путь = Разбор.Путь;
	КонецЕсли;

	ИмяКолонки = СокрЛП(Свойство(Описание, "as", ""));
	Если ПустаяСтрока(ИмяКолонки) Тогда
		ИмяКолонки = Функция_ + "(" + Путь + ")";
	КонецЕсли;
	Если ЕстьКолонка(П, ИмяКолонки) Тогда
		Остановить(П, СтрШаблон("Колонка «%1» уже є в результаті: задайте інше aggregates.as", ИмяКолонки));
		Возврат;
	КонецЕсли;

	Вид = "number";
	Если (Функция_ = "min" Или Функция_ = "max") И Разбор <> Неопределено Тогда
		Вид = mcp1c_ПутиПолей.ВидЗначений(Разбор.Типы);
	КонецЕсли;
	ДобавитьКолонку(П, Разбор, ИмяКолонки, Агрегат, Вид);

КонецПроцедуры

Функция ОшибкаТипаАгрегата(Функция_, Разбор)

	Если Функция_ = "sum" Или Функция_ = "avg" Тогда
		Если Разбор.Типы.Количество() <> 1 Или Разбор.Типы[0] <> "Число" Тогда
			Возврат СтрШаблон("%1 можливе лише для числових полів, а «%2» - %3", Функция_, Разбор.Путь,
				СтрСоединить(Разбор.Типы, ", "));
		КонецЕсли;
	ИначеЕсли Функция_ = "min" Или Функция_ = "max" Тогда
		Если Разбор.Типы.Количество() <> 1 Или Не ДопускаетСравнение(Разбор.Типы) Тогда
			Возврат СтрШаблон("%1 можливе для полів типу число, дата або рядок, а «%2» - %3", Функция_, Разбор.Путь,
				СтрСоединить(Разбор.Типы, ", "));
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ФункцииАгрегатов()

	Результат = Новый Соответствие;
	Результат.Вставить("sum", "СУММА");
	Результат.Вставить("count", "КОЛИЧЕСТВО");
	Результат.Вставить("count_distinct", "КОЛИЧЕСТВО РАЗЛИЧНЫЕ");
	Результат.Вставить("avg", "СРЕДНЕЕ");
	Результат.Вставить("min", "МИНИМУМ");
	Результат.Вставить("max", "МАКСИМУМ");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Регистры

Процедура ДобавитьГруппировкиРегистра(П, Группировки)
	// Группировки виртуальной таблицы регистра: по умолчанию - все доступные измерения
	// (для регистра бухгалтерии - счет).

	Если Остановлено(П) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Группировки) = Тип("Массив") Тогда
		ДобавитьГруппировки(П, Группировки);
		Возврат;
	КонецЕсли;

	Если П.Таблица.Вид = "accounting_register" Тогда
		ДобавитьГруппировку(П, "Счет");
		Возврат;
	КонецЕсли;
	Для Каждого Поле Из П.Таблица.Поля Цикл
		Если Поле.Роль <> "dimension" Тогда
			Продолжить;
		КонецЕсли;
		Разбор = mcp1c_ПутиПолей.РазобратьПуть(П.Таблица, Поле.Имя, П.Описания, П.Политика);
		Если Разбор.Успех Тогда
			ДобавитьГруппировку(П, Поле.Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРесурсы(П, Ресурсы)
	// Суммы показателей ресурсов: по имени ресурса ("Количество") выбираются все поля виртуальной
	// таблицы этого ресурса ("КоличествоОстаток", "КоличествоОстатокДт", ...).

	Если Остановлено(П) Тогда
		Возврат;
	КонецЕсли;
	Имена = ?(ТипЗнч(Ресурсы) = Тип("Массив"), Ресурсы, ДоступныеРесурсы(П));
	Если Имена.Количество() = 0 Тогда
		Остановить(П, СтрШаблон("У «%1» немає доступних ресурсів", П.Таблица.Объект));
		Возврат;
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		Если Не ДобавитьПоказателиРесурса(П, СокрЛП(Имя)) И Не Остановлено(П) Тогда
			Остановить(П, СтрШаблон("Ресурс «%1» не знайдено або недоступний у «%2». Перелік ресурсів дає describe_object.",
				Лев(Имя, 100), П.Таблица.Объект));
		КонецЕсли;
		Если Остановлено(П) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ДоступныеРесурсы(П)
	// Имена ресурсов виртуальной таблицы, доступных клиенту.

	Имена = Новый Массив;
	Для Каждого Поле Из П.Таблица.Поля Цикл
		Если Поле.Роль = "resource" И Имена.Найти(Поле.ПолеПолитики) = Неопределено
			И mcp1c_ПравилаДоступа.ПолеДоступно(П.Политика, П.Таблица.Объект, Поле.ПолеПолитики, Поле.Типы) Тогда
			Имена.Добавить(Поле.ПолеПолитики);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция ДобавитьПоказателиРесурса(П, Имя)
	// Добавляет суммы всех показателей ресурса; Ложь - у таблицы нет полей этого ресурса.

	Найдено = Ложь;
	Для Каждого Поле Из П.Таблица.Поля Цикл
		Если Поле.Роль <> "resource" Или НРег(Поле.ПолеПолитики) <> НРег(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Разбор = РазобратьПутьКлиента(П, Поле.Имя);
		Если Разбор = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ДобавитьКолонку(П, Разбор, Разбор.Путь, "СУММА", "number");
		Найдено = Истина;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

Функция УсловиеСчетаРегистра(П, Счет)
	// Условие на счет для параметра виртуальной таблицы регистра бухгалтерии (субсчета включаются).

	Если Счет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если П.Таблица.Вид <> "accounting_register" Тогда
		Остановить(П, "account задається лише для регістрів бухгалтерії");
		Возврат "";
	КонецЕсли;
	Разбор = РазобратьПутьКлиента(П, "Счет");
	Если Разбор = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Счет) = Тип("Строка") И Не ЭтоУникальныйИдентификатор(СокрЛП(Счет)) Тогда
		Если ПустаяСтрока(Счет) Или СтрДлина(Счет) > 50 Тогда
			Остановить(П, "account: очікується код рахунку, наприклад ""361"", або посилання на рахунок");
			Возврат "";
		КонецЕсли;
		Значение = НовоеЗначение("account_code", СокрЛП(Счет));
		Значение.Тип = П.Таблица.ПланСчетов;
	Иначе
		Разобранное = РазобратьЗначение(Счет, Разбор.Типы, "account");
		Если Не Разобранное.Успех Тогда
			Остановить(П, Разобранное.Ошибка);
			Возврат "";
		КонецЕсли;
		Значение = Разобранное.Значение;
	КонецЕсли;
	Возврат "Счет В ИЕРАРХИИ (&" + ДобавитьПараметр(П, Значение) + ")";

КонецФункции

Функция ПараметрыТаблицыОборотов(Таблица, Начало, Конец, Периодичность, УсловиеСчета)

	СОстатками = (Таблица.ВиртуальнаяТаблица = "ОстаткиИОбороты");
	Если Таблица.Вид = "accounting_register" Тогда
		Если СОстатками Тогда
			// Начало, Конец, Периодичность, МетодДополнения, УсловиеСчета, Субконто, Условие.
			Возврат МассивСтрок(Начало, Конец, Периодичность, "", УсловиеСчета, "", "{Условие}");
		КонецЕсли;
		// Начало, Конец, Периодичность, УсловиеСчета, Субконто, Условие, УсловиеКорСчета, КорСубконто.
		Возврат МассивСтрок(Начало, Конец, Периодичность, УсловиеСчета, "", "{Условие}");
	КонецЕсли;
	Если СОстатками Тогда
		// Начало, Конец, Периодичность, МетодДополнения, Условие.
		Возврат МассивСтрок(Начало, Конец, Периодичность, "", "{Условие}");
	КонецЕсли;
	// Начало, Конец, Периодичность, Условие.
	Возврат МассивСтрок(Начало, Конец, Периодичность, "{Условие}");

КонецФункции

Функция КлючевоеСловоПериодичности(Значение)
	// Ключевое слово периодичности виртуальной таблицы; пустая строка - без периодичности,
	// Неопределено - неизвестное значение.

	Варианты = Новый Соответствие;
	Варианты.Вставить("none", "");
	Варианты.Вставить("day", "День");
	Варианты.Вставить("week", "Неделя");
	Варианты.Вставить("month", "Месяц");
	Варианты.Вставить("quarter", "Квартал");
	Варианты.Вставить("year", "Год");
	Возврат Варианты.Получить(Значение);

КонецФункции

#КонецОбласти

#Область Отборы

Процедура ДобавитьОтборы(П, Отборы)

	Номер = 0;
	Для Каждого Отбор Из Отборы Цикл
		Если Остановлено(П) Тогда
			Возврат;
		КонецЕсли;
		Путь = СтрШаблон("filters[%1]", Формат(Номер, "ЧН=0; ЧГ=0"));
		Номер = Номер + 1;
		Разбор = РазобратьПутьКлиента(П, Свойство(Отбор, "field", ""));
		Если Разбор = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Условие = НовоеУсловиеОтбора(П, Разбор, Свойство(Отбор, "op", ""), Свойство(Отбор, "value"), Путь + ".value");
		Если Условие = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Условие.ВУсловииТаблицы = ВУсловииВиртуальнойТаблицы(П, Разбор);
		П.Спецификация.Условия.Добавить(Условие);
	КонецЦикла;

КонецПроцедуры

Функция НовоеУсловиеОтбора(П, Разбор, Оператор, Значение, Путь)
	// Условие отбора по оператору из аргументов (п. 5.3 ТЗ).

	Если Оператор = "is_empty" Или Оператор = "not_empty" Тогда
		Пустое = НовоеЗначение("empty");
		Пустое.Типы = Разбор.Типы;
		Параметры = Новый Массив;
		Параметры.Добавить(ДобавитьПараметр(П, Пустое));
	ИначеЕсли Оператор = "contains" Или Оператор = "starts_with" Тогда
		Параметры = ПараметрыПодобия(П, Разбор, Оператор, Значение, Путь);
	ИначеЕсли Оператор = "between" Тогда
		Параметры = ПараметрыМежду(П, Разбор, Значение, Путь);
	ИначеЕсли Оператор = "in" Или Оператор = "not_in" Или Оператор = "in_hierarchy" Тогда
		Параметры = ПараметрыСписка(П, Разбор, Оператор, Значение, Путь);
	ИначеЕсли ОператорыСравнения().Найти(Оператор) <> Неопределено Тогда
		Параметры = ПараметрыСравнения(П, Разбор, Оператор, Значение, Путь);
	Иначе
		Остановить(П, "op: допустимі значення eq, ne, gt, gte, lt, lte, between, in, not_in, in_hierarchy, "
			+ "contains, starts_with, is_empty, not_empty");
		Возврат Неопределено;
	КонецЕсли;
	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, Оператор, Параметры, Ложь,
		Разбор.НеограниченнаяСтрока);

КонецФункции

Функция ПараметрыПодобия(П, Разбор, Оператор, Значение, Путь)

	Если Разбор.Типы.Найти("Строка") = Неопределено Тогда
		Остановить(П, СтрШаблон("%1 можливе лише для рядкових полів, а «%2» - %3", Оператор, Разбор.Путь,
			СтрСоединить(Разбор.Типы, ", ")));
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Остановить(П, Путь + ": очікується непорожній рядок");
		Возврат Неопределено;
	КонецЕсли;
	Шаблон = mcp1c_КонструкторЗапросов.ЭкранироватьДляПодобно(Значение) + "%";
	Если Оператор = "contains" Тогда
		Шаблон = "%" + Шаблон;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(П, НовоеЗначение("value", Шаблон)));
	Возврат Параметры;

КонецФункции

Функция ПараметрыМежду(П, Разбор, Значение, Путь)

	Если ТипЗнч(Значение) <> Тип("Массив") Или Значение.Количество() <> 2 Тогда
		Остановить(П, Путь + ": для between очікується масив із двох значень [від, до]");
		Возврат Неопределено;
	КонецЕсли;
	Если Не ДопускаетСравнение(Разбор.Типы) Тогда
		Остановить(П, СтрШаблон("between можливе для полів типу число, дата або рядок, а «%1» - %2", Разбор.Путь,
			СтрСоединить(Разбор.Типы, ", ")));
		Возврат Неопределено;
	КонецЕсли;
	Параметры = Новый Массив;
	Для Индекс = 0 По 1 Цикл
		Элемент = ЗначениеДляУсловия(П, Значение[Индекс], Разбор.Типы, СтрШаблон("%1[%2]", Путь, Индекс), Индекс = 1);
		Если Элемент = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Параметры.Добавить(ДобавитьПараметр(П, Элемент));
	КонецЦикла;
	Возврат Параметры;

КонецФункции

Функция ПараметрыСписка(П, Разбор, Оператор, Значение, Путь)

	Если Оператор = "in_hierarchy" И Не ЕстьИерархическийТип(Разбор.Типы) Тогда
		Остановить(П, СтрШаблон("in_hierarchy можливе лише для посилань, а «%1» - %2", Разбор.Путь,
			СтрСоединить(Разбор.Типы, ", ")));
		Возврат Неопределено;
	КонецЕсли;
	Список = СписокЗначений(П, Значение, Разбор.Типы, Путь);
	Если Список = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(П, Список));
	Возврат Параметры;

КонецФункции

Функция ПараметрыСравнения(П, Разбор, Оператор, Значение, Путь)

	Если Оператор <> "eq" И Оператор <> "ne" И Не ДопускаетСравнение(Разбор.Типы) Тогда
		Остановить(П, СтрШаблон("%1 можливе для полів типу число, дата або рядок, а «%2» - %3", Оператор,
			Разбор.Путь, СтрСоединить(Разбор.Типы, ", ")));
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Остановить(П, Путь + ": для кількох значень використовуйте op in");
		Возврат Неопределено;
	КонецЕсли;
	Элемент = ЗначениеДляУсловия(П, Значение, Разбор.Типы, Путь, Оператор = "lte" Или Оператор = "gt");
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(П, Элемент));
	Возврат Параметры;

КонецФункции

Функция ЗначениеДляУсловия(П, Значение, Типы, Путь, ВерхняяГраница)
	// Значение для сравнения. Дата без времени в верхней границе (lte, gt, вторая граница between)
	// означает конец дня.

	Разобранное = РазобратьЗначение(Значение, Типы, Путь);
	Если Не Разобранное.Успех Тогда
		Остановить(П, Разобранное.Ошибка);
		Возврат Неопределено;
	КонецЕсли;
	Результат = Разобранное.Значение;
	Если ВерхняяГраница И ТипЗнч(Значение) = Тип("Строка") И ТипЗнч(Результат.Значение) = Тип("Дата")
		И СтрДлина(СокрЛП(Значение)) = 10 Тогда
		Результат.Значение = Результат.Значение + 86399;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция СписокЗначений(П, Значение, Типы, Путь)

	Значения = Значение;
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Значения = Новый Массив;
		Значения.Добавить(Значение);
	КонецЕсли;
	Если Значения.Количество() = 0 Или Значения.Количество() > МаксимумЗначенийСписка() Тогда
		Остановить(П, СтрШаблон("%1: очікується від 1 до %2 значень", Путь, МаксимумЗначенийСписка()));
		Возврат Неопределено;
	КонецЕсли;

	Список = НовоеЗначение("list");
	Для Индекс = 0 По Значения.ВГраница() Цикл
		Разобранное = РазобратьЗначение(Значения[Индекс], Типы, СтрШаблон("%1[%2]", Путь, Формат(Индекс, "ЧН=0; ЧГ=0")));
		Если Не Разобранное.Успех Тогда
			Остановить(П, Разобранное.Ошибка);
			Возврат Неопределено;
		КонецЕсли;
		Список.Элементы.Добавить(Разобранное.Значение);
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция УсловиеПоиска(П, Разбор, ТекстПоиска)
	// Условие поиска по строке в поле: подстрока для строк, равенство для чисел из цифр.

	Если Разбор.Типы.Найти("Строка") <> Неопределено Тогда
		Шаблон = "%" + mcp1c_КонструкторЗапросов.ЭкранироватьДляПодобно(ТекстПоиска) + "%";
		Параметры = Новый Массив;
		Параметры.Добавить(ДобавитьПараметр(П, НовоеЗначение("value", Шаблон)));
		Возврат mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, "contains", Параметры, Ложь,
			Разбор.НеограниченнаяСтрока);
	КонецЕсли;
	Если Разбор.Типы.Количество() = 1 И Разбор.Типы[0] = "Число" И СтрДлина(ТекстПоиска) <= 15
		И mcp1c_Служебный.СостоитИзСимволов(ТекстПоиска, "0123456789") Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(ДобавитьПараметр(П, НовоеЗначение("value", Число(ТекстПоиска))));
		Возврат mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, "eq", Параметры);
	КонецЕсли;
	Возврат Неопределено;


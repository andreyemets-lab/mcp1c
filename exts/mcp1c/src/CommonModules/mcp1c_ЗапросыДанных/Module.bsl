#КонецОбласти

#Область СлужебныеОтборы

Процедура ДобавитьСистемныеОтборы(П, ВключатьПомеченные, ТолькоПроведенные)
	// Пометка удаления, проведение и активность записей (п. 5.3, 7.5 ТЗ).

	Если Остановлено(П) Тогда
		Возврат;
	КонецЕсли;
	Таблица = П.Таблица;
	Префикс = ?(Таблица.ВидТаблицы = "tabular_section", "Ссылка.", "");

	Если Таблица.ЕстьПометкаУдаления Тогда
		Разрешено = П.Политика.РазрешитьПомеченныеНаУдаление;
		Если ВключатьПомеченные И Не Разрешено Тогда
			П.Примечания.Добавить("Помічені на вилучення не показуються: профіль цього не дозволяє");
		КонецЕсли;
		Если Не (ВключатьПомеченные И Разрешено) Тогда
			ДобавитьСистемноеРавенство(П, Префикс + "ПометкаУдаления", Ложь);
		КонецЕсли;
	КонецЕсли;

	Если ТолькоПроведенные Тогда
		Если Таблица.ЕстьПроведен Тогда
			ДобавитьСистемноеРавенство(П, Префикс + "Проведен", Истина);
		Иначе
			П.Примечания.Добавить("only_posted не застосовано: об'єкт не має ознаки проведення");
		КонецЕсли;
	КонецЕсли;

	Если Таблица.ЕстьАктивность Тогда
		ДобавитьСистемноеРавенство(П, "Активность", Истина);
	КонецЕсли;


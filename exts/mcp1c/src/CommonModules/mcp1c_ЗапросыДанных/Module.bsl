#Область Прочее

Функция Свойство(Объект, Ключ, ПоУмолчанию = Неопределено)

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = Объект.Получить(Ключ);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);

КонецФункции

Функция МассивСтрок(П1, П2, П3 = Неопределено, П4 = Неопределено, П5 = Неопределено, П6 = Неопределено,
	П7 = Неопределено)
	// Массив строк из параметров; используется для параметров виртуальных таблиц.

	Результат = Новый Массив;
	Значения = Новый Массив;
	Значения.Добавить(П1);
	Значения.Добавить(П2);
	Значения.Добавить(П3);
	Значения.Добавить(П4);
	Значения.Добавить(П5);
	Значения.Добавить(П6);
	Значения.Добавить(П7);
	Для Каждого Значение Из Значения Цикл
		Если Значение = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;


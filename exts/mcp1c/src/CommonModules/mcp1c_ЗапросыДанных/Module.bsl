#КонецОбласти

#Область Период

Процедура ДобавитьОтборПериода(П, Период)
	// Отбор query_records по полю периода таблицы и обязательный отбор периода профиля (п. 7.5 ТЗ).

	Если Остановлено(П) Тогда
		Возврат;
	КонецЕсли;
	Требуется = mcp1c_ПравилаДоступа.ТребуетсяОтборПоПериоду(П.Политика, П.Таблица.Объект);
	Если Период = Неопределено Тогда
		Если Требуется Тогда
			Остановить(П, СтрШаблон("Профіль вимагає фільтр за періодом для «%1»: задайте period.from і period.to",
				П.Таблица.Объект));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(П.Таблица.ПолеПериода) Тогда
		Остановить(П, СтрШаблон("«%1» не має поля періоду: використовуйте filters", П.Таблица.Имя));
		Возврат;
	КонецЕсли;

	Границы = ГраницыПериода(П, Период, Требуется);
	Если Границы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Разбор = РазобратьПутьКлиента(П, П.Таблица.ПолеПериода);
	Если Разбор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Массив;
	Если Границы.Начало <> Неопределено И Границы.Конец <> Неопределено Тогда
		Оператор = "between";
		Параметры.Добавить(ДобавитьПараметр(П, НовоеЗначение("value", Границы.Начало)));
		Параметры.Добавить(ДобавитьПараметр(П, НовоеЗначение("value", Границы.Конец)));
	ИначеЕсли Границы.Начало <> Неопределено Тогда
		Оператор = "gte";
		Параметры.Добавить(ДобавитьПараметр(П, НовоеЗначение("value", Границы.Начало)));
	Иначе
		Оператор = "lte";
		Параметры.Добавить(ДобавитьПараметр(П, НовоеЗначение("value", Границы.Конец)));
	КонецЕсли;
	П.Спецификация.Условия.Добавить(mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, Оператор, Параметры));

КонецПроцедуры

// Границы периода из аргумента {"from", "to"}: дата без времени в to означает конец дня.
// Длина периода ограничена профилем (п. 7.3 ТЗ).
//
// Параметры:
//  П - см. НовоеПостроение
//  Период - Соответствие из КлючИЗначение - аргумент period.
//  ОбаКонцаОбязательны - Булево - требуются и from, и to.
//
// Возвращаемое значение:
//  Структура, Неопределено - Начало и Конец (Дата или Неопределено); Неопределено при ошибке.
//
Функция ГраницыПериода(П, Период, ОбаКонцаОбязательны)

	Результат = ДатыПериода(П, Период);
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЕстьНачало = Результат.Начало <> Неопределено;
	ЕстьКонец = Результат.Конец <> Неопределено;
	Если Не ЕстьНачало И Не ЕстьКонец Или ОбаКонцаОбязательны И Не (ЕстьНачало И ЕстьКонец) Тогда
		Остановить(П, "period: задайте from і to, наприклад {""from"": ""2026-09-01"", ""to"": ""2026-09-30""}");
		Возврат Неопределено;
	КонецЕсли;
	Если Не (ЕстьНачало И ЕстьКонец) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Результат.Начало > Результат.Конец Тогда
		Остановить(П, "period: from пізніше за to");
		Возврат Неопределено;
	КонецЕсли;
	МаксимумДней = П.Политика.Лимиты.ГлубинаПериодаДней;
	Если Результат.Конец - Результат.Начало >= (МаксимумДней + 1) * 86400 Тогда
		Остановить(П, СтрШаблон("Період довший за %1 дн., дозволених профілем: розбийте запит на частини", МаксимумДней));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ДатыПериода(П, Период)
	// Даты from и to из аргумента period; Неопределено при ошибке формата.

	Если ТипЗнч(Период) <> Тип("Соответствие") Тогда
		Остановить(П, "period: очікується об'єкт {""from"": ""2026-09-01"", ""to"": ""2026-09-30""}");
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("Начало, Конец", Неопределено, Неопределено);
	Если Свойство(Период, "from") <> Неопределено Тогда
		Результат.Начало = РазобратьДатуАргумента(П, Свойство(Период, "from"), "period.from", "start_of_day");
		Если Результат.Начало = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если Свойство(Период, "to") <> Неопределено Тогда
		Результат.Конец = РазобратьДатуАргумента(П, Свойство(Период, "to"), "period.to", "end_of_day");
		Если Результат.Конец = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РазобратьДатуАргумента(П, Текст, Путь, Граница)
	// Дата из аргумента. Граница для даты без времени: start_of_day (начало дня), end_of_day (23:59:59)
	// или end_of_day_exclusive (начало следующего дня - момент для остатков на конец дня).

	Разобранная = mcp1c_Служебный.РазобратьДату(Текст);
	Если Разобранная = Неопределено Тогда
		Остановить(П, Путь + ": очікується дата YYYY-MM-DD або YYYY-MM-DDTHH:MM:SS (місцевий час сервера, "
			+ "без часового поясу)");
		Возврат Неопределено;
	КонецЕсли;
	Если Не Разобранная.ТолькоДата Или Граница = "start_of_day" Тогда
		Возврат Разобранная.Дата;
	ИначеЕсли Граница = "end_of_day" Тогда
		Возврат Разобранная.Дата + 86399;
	КонецЕсли;
	Возврат Разобранная.Дата + 86400;


#КонецОбласти

#Область ОграниченияСтрок

Процедура ДобавитьОграниченияСтрок(П)
	// Ограничения строк профиля (п. 7.5 ТЗ): ограничения одного поля с видами eq и in_hierarchy
	// объединяются через ИЛИ, ne - через И, ограничения разных полей - через И. Ограничение,
	// которое нельзя применить к таблице, закрывает доступ (ошибка без подробностей для модели).

	Если Остановлено(П) Тогда
		Возврат;
	КонецЕсли;
	Ограничения = mcp1c_ПравилаДоступа.ОграниченияСтрок(П.Политика, П.Таблица.Объект);
	Для Каждого Группа Из ГруппыОграничений(Ограничения) Цикл
		ДобавитьГруппуОграничений(П, Группа);
		Если Остановлено(П) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ГруппыОграничений(Ограничения)
	// Ограничения, сгруппированные по полю (без учета регистра) и разделенные на условия
	// равенства и иерархии (объединяются через ИЛИ) и неравенства (через И).

	Группы = Новый Массив;
	Индекс = Новый Соответствие;
	Для Каждого Ограничение Из Ограничения Цикл
		Ключ = НРег(Ограничение.Поле);
		Группа = Индекс.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Поле, Положительные, Отрицательные", Ограничение.Поле, Новый Массив, Новый Массив);
			Индекс.Вставить(Ключ, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;
		Если Ограничение.ВидСравнения = "ne" Тогда
			Группа.Отрицательные.Добавить(Ограничение);
		Иначе
			Группа.Положительные.Добавить(Ограничение);
		КонецЕсли;
	КонецЦикла;
	Возврат Группы;

КонецФункции

Процедура ДобавитьГруппуОграничений(П, Группа)

	Префикс = ?(П.Таблица.ВидТаблицы = "tabular_section", "Ссылка.", "");
	Разбор = mcp1c_ПутиПолей.РазобратьПуть(П.Таблица, Префикс + Группа.Поле, П.Описания, П.СистемнаяПолитика);
	Если Не ПустаяСтрока(Разбор.НужноОписание) Тогда
		П.НужноОписание = Разбор.НужноОписание;
		Возврат;
	КонецЕсли;
	Если Не Разбор.Успех Тогда
		ОтказатьПоОграничению(П, СтрШаблон("Поле ограничения %1 не найдено в таблице %2", Группа.Поле, П.Таблица.Имя));
		Возврат;
	КонецЕсли;
	ВУсловииТаблицы = ВУсловииВиртуальнойТаблицы(П, Разбор);

	ИЛИ_ = mcp1c_КонструкторЗапросов.НовоеУсловие("", "or", Неопределено, ВУсловииТаблицы);
	Для Каждого Ограничение Из Группа.Положительные Цикл
		Условие = УсловиеОграничения(П, Разбор, Ограничение);
		Если Условие = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ИЛИ_.Элементы.Добавить(Условие);
	КонецЦикла;
	Если ИЛИ_.Элементы.Количество() = 1 Тогда
		ИЛИ_.Элементы[0].ВУсловииТаблицы = ВУсловииТаблицы;
		П.Спецификация.Условия.Добавить(ИЛИ_.Элементы[0]);
	ИначеЕсли ИЛИ_.Элементы.Количество() > 1 Тогда
		П.Спецификация.Условия.Добавить(ИЛИ_);
	КонецЕсли;

	Для Каждого Ограничение Из Группа.Отрицательные Цикл
		Условие = УсловиеОграничения(П, Разбор, Ограничение);
		Если Условие = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Условие.ВУсловииТаблицы = ВУсловииТаблицы;
		П.Спецификация.Условия.Добавить(Условие);
	КонецЦикла;

КонецПроцедуры

Функция УсловиеОграничения(П, Разбор, Ограничение)

	Вид = Ограничение.ВидСравнения;
	Если Вид <> "eq" И Вид <> "ne" И Вид <> "in_hierarchy" Тогда
		ОтказатьПоОграничению(П, СтрШаблон("Не задан вид сравнения ограничения по полю %1", Ограничение.Поле));
		Возврат Неопределено;
	КонецЕсли;
	Если Вид = "in_hierarchy" И Не ЕстьИерархическийТип(Разбор.Типы) Тогда
		ОтказатьПоОграничению(П, СтрШаблон("В ИЕРАРХИИ для поля %1 без ссылочного типа", Ограничение.Поле));
		Возврат Неопределено;
	КонецЕсли;

	ЭтоСписок = ТипЗнч(Ограничение.Значение) = Тип("Массив") Или Вид = "in_hierarchy";
	Ошибка = "";
	Если ЭтоСписок Тогда
		Значение = СписокОграничения(Ограничение.Значение, Разбор.Типы, Ошибка);
	Иначе
		Разобранное = РазобратьЗначение(Ограничение.Значение, Разбор.Типы, "value");
		Значение = Разобранное.Значение;
		Ошибка = Разобранное.Ошибка;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		ОтказатьПоОграничению(П, СтрШаблон("Значение ограничения по полю %1: %2", Ограничение.Поле, Ошибка));
		Возврат Неопределено;
	КонецЕсли;

	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(П, Значение));
	Возврат mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, ОператорОграничения(Вид, ЭтоСписок), Параметры,
		Ложь, Разбор.НеограниченнаяСтрока);

КонецФункции

Функция ОператорОграничения(Вид, ЭтоСписок)

	Если Вид = "in_hierarchy" Или Не ЭтоСписок Тогда
		Возврат Вид;
	КонецЕсли;
	Возврат ?(Вид = "eq", "in", "not_in");

КонецФункции

Функция СписокОграничения(Значение, Типы, Ошибка)

	Значения = Значение;
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Значения = Новый Массив;
		Значения.Добавить(Значение);
	КонецЕсли;
	Если Значения.Количество() = 0 Тогда
		Ошибка = "пустой список";
		Возврат Неопределено;
	КонецЕсли;
	Список = НовоеЗначение("list");
	Для Каждого Элемент Из Значения Цикл
		Разобранное = РазобратьЗначение(Элемент, Типы, "value");
		Если Не Разобранное.Успех Тогда
			Ошибка = Разобранное.Ошибка;
			Возврат Неопределено;
		КонецЕсли;
		Список.Элементы.Добавить(Разобранное.Значение);
	КонецЦикла;
	Возврат Список;

КонецФункции

Процедура ОтказатьПоОграничению(П, Причина)

	Остановить(П, СтрШаблон("Обмеження рядків профілю для «%1» не може бути застосоване: зверніться до адміністратора. "
		+ "Ідентифікатор запиту - у _meta відповіді.", П.Таблица.Объект), Причина);

КонецПроцедуры

#КонецОбласти

#Область Порядок

Процедура ДобавитьПорядок(П, Порядок)
	// Упорядочивание из аргументов и ключевые поля, задающие однозначный порядок для пагинации.
	// Скрытые поля в упорядочивании не используются (п. 7.4 ТЗ).

	Если Остановлено(П) Тогда
		Возврат;
	КонецЕсли;
	Использованные = Новый Массив;
	Для Каждого Элемент Из Порядок Цикл
		ДобавитьПорядокАргумента(П, СокрЛП(Свойство(Элемент, "field", "")), Свойство(Элемент, "desc", Ложь) = Истина,
			Использованные);
		Если Остановлено(П) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если П.Группировка Тогда
		// После группировки строки однозначно определяются значениями группировок.
		Для Каждого Колонка Из П.Колонки Цикл
			Если ЕстьГруппировкаПоВыражению(П, Колонка.Выражение) Тогда
				ДобавитьЭлементПорядка(П, Колонка.Псевдоним, Ложь, Ложь, Использованные, Колонка.Выражение);
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Для Каждого Имя Из П.Таблица.ПоляПорядка Цикл
		Разбор = mcp1c_ПутиПолей.РазобратьПуть(П.Таблица, Имя, П.Описания, П.Политика);
		Если Разбор.Успех Тогда
			ДобавитьЭлементПорядка(П, Разбор.Выражение, Ложь, Разбор.НеограниченнаяСтрока, Использованные);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПорядокАргумента(П, Имя, Убывание, Использованные)

	Если Не П.Группировка Тогда
		Разбор = РазобратьПутьКлиента(П, Имя);
		Если Разбор <> Неопределено Тогда
			ДобавитьЭлементПорядка(П, Разбор.Выражение, Убывание, Разбор.НеограниченнаяСтрока, Использованные);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Колонка = НайтиКолонку(П, Имя);
	Если Колонка = Неопределено Тогда
		Остановить(П, СтрШаблон("order_by: «%1» - сортувати можна лише за полями group_by або aggregates "
			+ "(для агрегата - за значенням as або func(field))", Лев(Имя, 100)));
		Возврат;
	КонецЕсли;
	ДобавитьЭлементПорядка(П, Колонка.Псевдоним, Убывание, Ложь, Использованные);

КонецПроцедуры

Процедура ДобавитьЭлементПорядка(П, Выражение, Убывание, НеограниченнаяСтрока, Использованные, Синоним = "")

	Если Использованные.Найти(НРег(Выражение)) <> Неопределено
		Или Не ПустаяСтрока(Синоним) И Использованные.Найти(НРег(Синоним)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Использованные.Добавить(НРег(Выражение));
	Если Не ПустаяСтрока(Синоним) Тогда
		Использованные.Добавить(НРег(Синоним));
	КонецЕсли;
	Колонка = Неопределено;
	Для Каждого Элемент Из П.Колонки Цикл
		Если Элемент.Псевдоним = Выражение Тогда
			Колонка = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Колонка <> Неопределено Тогда
		// Синоним колонки: повторное упорядочивание по тому же полю не добавляется.
		Использованные.Добавить(НРег(Колонка.Выражение));
	КонецЕсли;
	П.Спецификация.Порядок.Добавить(mcp1c_КонструкторЗапросов.НовыйЭлементПорядка(Выражение, Убывание, Ложь,
		НеограниченнаяСтрока));

КонецПроцедуры

Функция ЕстьГруппировкаПоВыражению(П, Выражение)

	Для Каждого Группировка Из П.Спецификация.Группировки Цикл
		Если Группировка.Выражение = Выражение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область РазборЗначений

Процедура РазобратьОбъектЗначения(Результат, Значение, Типы, Путь)

	ИмяТипа = Значение.Получить("type");
	Если ТипЗнч(ИмяТипа) <> Тип("Строка") Тогда
		// Без type допускается ссылка или перечисление, если у поля один такой тип.
		Если Значение.Получить("ref") <> Неопределено Тогда
			ИмяТипа = ЕдинственныйСсылочныйТип(Типы);
		Иначе
			ИмяТипа = ЕдинственныйТипПеречисления(Типы);
		КонецЕсли;
		Если ИмяТипа = Неопределено Тогда
			Результат.Ошибка = Путь + ": для посилання очікується {""type"": ""Справочник.Контрагенты"", ""ref"": ""<uuid>""}";
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Тип_ = КаноническийТип(ИмяТипа, Типы);
	Если Тип_ = Неопределено Тогда
		Результат.Ошибка = СтрШаблон("%1: тип «%2» не підходить полю; допустимі типи: %3", Путь, Лев(ИмяТипа, 100),
			СтрСоединить(Типы, ", "));
		Возврат;
	КонецЕсли;

	Если mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
		ИмяЗначения = Значение.Получить("value");
		Если Не ЭтоИмя(ИмяЗначения) Тогда
			Результат.Ошибка = Путь + ": для перерахування очікується {""type"": """ + Тип_ + """, ""value"": ""<ім'я значення>""}";
			Возврат;
		КонецЕсли;
		Результат.Значение = НовоеЗначение("enum");
		Результат.Значение.Тип = Тип_;
		Результат.Значение.Имя = ИмяЗначения;
		Возврат;
	КонецЕсли;

	Идентификатор = Значение.Получить("ref");
	Если Не ЭтоУникальныйИдентификатор(Идентификатор) Тогда
		Результат.Ошибка = Путь + ".ref: очікується унікальний ідентифікатор (поле ref зі значення посилання)";
		Возврат;
	КонецЕсли;
	Результат.Значение = НовоеЗначение("ref");
	Результат.Значение.Тип = Тип_;
	Результат.Значение.Идентификатор = НРег(Идентификатор);

КонецПроцедуры

Процедура РазобратьСтроку(Результат, Значение, Типы, Путь)

	Если Типы.Найти("Строка") <> Неопределено Тогда
		Результат.Значение = НовоеЗначение("value", Значение);
		Возврат;
	КонецЕсли;
	Если Типы.Найти("Дата") <> Неопределено Тогда
		Разобранная = mcp1c_Служебный.РазобратьДату(Значение);
		Если Разобранная = Неопределено Тогда
			Результат.Ошибка = Путь + ": очікується дата YYYY-MM-DD або YYYY-MM-DDTHH:MM:SS (місцевий час сервера)";
		Иначе
			Результат.Значение = НовоеЗначение("value", Разобранная.Дата);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Перечисление = ЕдинственныйТипПеречисления(Типы);
	Если Перечисление <> Неопределено И ЭтоИмя(Значение) Тогда
		Результат.Значение = НовоеЗначение("enum");
		Результат.Значение.Тип = Перечисление;
		Результат.Значение.Имя = Значение;
		Возврат;
	КонецЕсли;
	Если Типы.Найти("УникальныйИдентификатор") <> Неопределено И ЭтоУникальныйИдентификатор(Значение) Тогда
		Результат.Значение = НовоеЗначение("uuid", НРег(Значение));
		Возврат;
	КонецЕсли;
	Ссылочный = ЕдинственныйСсылочныйТип(Типы);
	Если Ссылочный <> Неопределено И ЭтоУникальныйИдентификатор(Значение) Тогда
		Результат.Значение = НовоеЗначение("ref");
		Результат.Значение.Тип = Ссылочный;
		Результат.Значение.Идентификатор = НРег(Значение);
		Возврат;
	КонецЕсли;
	Результат.Ошибка = ОшибкаТипа(Путь, "рядок", Типы);

КонецПроцедуры

Функция ОшибкаТипа(Путь, ВидЗначения, Типы)

	Пример = "";
	Ссылочный = ЕдинственныйСсылочныйТип(Типы);
	Если Ссылочный <> Неопределено Тогда
		Пример = СтрШаблон("; для посилання передайте {""type"": ""%1"", ""ref"": ""<uuid>""}", Ссылочный);
	КонецЕсли;
	Возврат СтрШаблон("%1: значення типу «%2» не підходить полю типу %3%4", Путь, ВидЗначения,
		СтрСоединить(Типы, ", "), Пример);

КонецФункции

Функция КаноническийТип(ИмяТипа, Типы)
	// Тип поля, совпадающий с именем типа из аргументов без учета регистра и языка класса.

	Искомый = НРег(НормализованноеИмяТипа(ИмяТипа));
	Для Каждого Тип_ Из Типы Цикл
		Если mcp1c_ПутиПолей.ЭтоСсылочныйТип(Тип_) И НРег(Тип_) = Искомый Тогда
			Возврат Тип_;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЕдинственныйТипПеречисления(Типы)

	Результат = Неопределено;
	Для Каждого Тип_ Из Типы Цикл
		Если mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
			Если Результат <> Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Результат = Тип_;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕдинственныйСсылочныйТип(Типы)

	Результат = Неопределено;
	Для Каждого Тип_ Из Типы Цикл
		Если mcp1c_ПутиПолей.ЭтоСсылочныйТип(Тип_) И Не mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
			Если Результат <> Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Результат = Тип_;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьИерархическийТип(Типы)

	Для Каждого Тип_ Из Типы Цикл
		Если mcp1c_ПутиПолей.ЭтоСсылочныйТип(Тип_) И Не mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ДопускаетСравнение(Типы)
	// Допускают ли типы сравнение "больше-меньше": только число, дата и строка.

	Если Типы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Тип_ Из Типы Цикл
		Если Тип_ <> "Число" И Тип_ <> "Дата" И Тип_ <> "Строка" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоИмя(Текст)
	// Имя из букв, цифр и подчеркиваний, начинается не с цифры (имя значения перечисления).

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Или СтрДлина(Текст) > 128 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		ЭтоБуква = НРег(Символ) <> ВРег(Символ) Или Символ = "_";
		Если Не ЭтоБуква И Не (Позиция > 1 И СтрНайти("0123456789", Символ) > 0) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;


	Разбор = РазобратьПутьСистемы(П, Путь);
	Если Разбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(П, НовоеЗначение("value", Значение)));

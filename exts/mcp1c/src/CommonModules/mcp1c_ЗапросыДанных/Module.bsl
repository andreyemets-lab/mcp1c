Функция ОператорыСравнения()

	Возврат СтрРазделить("eq,ne,gt,gte,lt,lte", ",");

КонецФункции

Функция МаксимумЗначенийСписка()

	Возврат 100;

КонецФункции

#КонецОбласти

#Область Период

Процедура ДобавитьОтборПериода(Построение, Период)
	// Отбор query_records по полю периода таблицы и обязательный отбор периода профиля (п. 7.5 ТЗ).

	Если Остановлено(Построение) Тогда
		Возврат;
	КонецЕсли;
	Требуется = mcp1c_ПравилаДоступа.ТребуетсяОтборПоПериоду(Построение.Политика, Построение.Таблица.Объект);
	Если Период = Неопределено Тогда
		Если Требуется Тогда
			Остановить(Построение, СтрШаблон("Профіль вимагає фільтр за періодом для «%1»: задайте period.from і period.to",
				Построение.Таблица.Объект));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Построение.Таблица.ПолеПериода) Тогда
		Остановить(Построение, СтрШаблон("«%1» не має поля періоду: використовуйте filters", Построение.Таблица.Имя));
		Возврат;
	КонецЕсли;

	Границы = ГраницыПериода(Построение, Период, Требуется);
	Если Границы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Разбор = РазобратьПутьКлиента(Построение, Построение.Таблица.ПолеПериода);
	Если Разбор = Неопределено Или Не БезМаски(Построение, Разбор, "відбирати за періодом") Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Массив;
	Если Границы.Начало <> Неопределено И Границы.Конец <> Неопределено Тогда
		Оператор = "between";
		Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Границы.Начало)));
		Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Границы.Конец)));
	ИначеЕсли Границы.Начало <> Неопределено Тогда
		Оператор = "gte";
		Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Границы.Начало)));
	Иначе
		Оператор = "lte";
		Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Границы.Конец)));
	КонецЕсли;
	Построение.Спецификация.Условия.Добавить(mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, Оператор, Параметры));

КонецПроцедуры

// Границы периода из аргумента {"from", "to"}: дата без времени в to означает конец дня.
// Длина периода ограничена профилем (п. 7.3 ТЗ).
//
// Параметры:
//  Построение - см. НовоеПостроение
//  Период - Соответствие из КлючИЗначение - аргумент period.
//  ОбаКонцаОбязательны - Булево - требуются и from, и to.
//
// Возвращаемое значение:
//  - Неопределено - при ошибке (построение остановлено).
//  - Структура:
//   * Начало - Дата, Неопределено - начало периода.
//   * Конец - Дата, Неопределено - конец периода.
//
Функция ГраницыПериода(Построение, Период, ОбаКонцаОбязательны)

	Результат = ДатыПериода(Построение, Период);
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЕстьНачало = Результат.Начало <> Неопределено;
	ЕстьКонец = Результат.Конец <> Неопределено;
	Если Не ЕстьНачало И Не ЕстьКонец Или ОбаКонцаОбязательны И Не (ЕстьНачало И ЕстьКонец) Тогда
		Остановить(Построение, "period: задайте from і to, наприклад {""from"": ""2026-09-01"", ""to"": ""2026-09-30""}");
		Возврат Неопределено;
	КонецЕсли;
	Если Не (ЕстьНачало И ЕстьКонец) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Результат.Начало > Результат.Конец Тогда
		Остановить(Построение, "period: from пізніше за to");
		Возврат Неопределено;
	КонецЕсли;
	МаксимумДней = Построение.Политика.Лимиты.ГлубинаПериодаДней;
	Если Результат.Конец - Результат.Начало >= (МаксимумДней + 1) * 86400 Тогда
		Остановить(Построение, СтрШаблон("Період довший за %1 дн., дозволених профілем: розбийте запит на частини", МаксимумДней));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ДатыПериода(Построение, Период)
	// Даты from и to из аргумента period; Неопределено при ошибке формата.

	Если ТипЗнч(Период) <> Тип("Соответствие") Тогда
		Остановить(Построение, "period: очікується об'єкт {""from"": ""2026-09-01"", ""to"": ""2026-09-30""}");
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("Начало, Конец", Неопределено, Неопределено);
	Если Свойство(Период, "from") <> Неопределено Тогда
		Результат.Начало = РазобратьДатуАргумента(Построение, Свойство(Период, "from"), "period.from", "start_of_day");
		Если Результат.Начало = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если Свойство(Период, "to") <> Неопределено Тогда
		Результат.Конец = РазобратьДатуАргумента(Построение, Свойство(Период, "to"), "period.to", "end_of_day");
		Если Результат.Конец = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РазобратьДатуАргумента(Построение, Текст, Путь, Граница)
	// Дата из аргумента. Граница для даты без времени: start_of_day (начало дня), end_of_day (23:59:59)
	// или end_of_day_exclusive (начало следующего дня - момент для остатков на конец дня).

	Разобранная = mcp1c_Служебный.РазобратьДату(Текст);
	Если Разобранная = Неопределено Тогда
		Остановить(Построение, Путь + ": очікується дата YYYY-MM-DD або YYYY-MM-DDTHH:MM:SS (місцевий час сервера, "
			+ "без часового поясу)");
		Возврат Неопределено;
	КонецЕсли;
	Если Не Разобранная.ТолькоДата Или Граница = "start_of_day" Тогда
		Возврат Разобранная.Дата;
	ИначеЕсли Граница = "end_of_day" Тогда
		Возврат Разобранная.Дата + 86399;
	КонецЕсли;
	Возврат Разобранная.Дата + 86400;

КонецФункции

#КонецОбласти

#Область СлужебныеОтборы

Процедура ДобавитьСистемныеОтборы(Построение, ВключатьПомеченные, ТолькоПроведенные)
	// Пометка удаления, проведение и активность записей (п. 5.3, 7.5 ТЗ).

	Если Остановлено(Построение) Тогда
		Возврат;
	КонецЕсли;
	Таблица = Построение.Таблица;
	Префикс = ?(Таблица.ВидТаблицы = "tabular_section", "Ссылка.", "");

	Если Таблица.ЕстьПометкаУдаления Тогда
		Разрешено = Построение.Политика.РазрешитьПомеченныеНаУдаление;
		Если ВключатьПомеченные И Не Разрешено Тогда
			Построение.Примечания.Добавить("Помічені на вилучення не показуються: профіль цього не дозволяє");
		КонецЕсли;
		Если Не (ВключатьПомеченные И Разрешено) Тогда
			ДобавитьСистемноеРавенство(Построение, Префикс + "ПометкаУдаления", Ложь);
		КонецЕсли;
	КонецЕсли;

	Если ТолькоПроведенные Тогда
		Если Таблица.ЕстьПроведен Тогда
			ДобавитьСистемноеРавенство(Построение, Префикс + "Проведен", Истина);
		Иначе
			Построение.Примечания.Добавить("only_posted не застосовано: об'єкт не має ознаки проведення");
		КонецЕсли;
	КонецЕсли;

	Если Таблица.ЕстьАктивность Тогда
		ДобавитьСистемноеРавенство(Построение, "Активность", Истина);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСистемноеРавенство(Построение, Путь, Значение)

	Разбор = РазобратьПутьСистемы(Построение, Путь);
	Если Разбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Значение)));
	Построение.Спецификация.Условия.Добавить(mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, "eq", Параметры));

КонецПроцедуры

#КонецОбласти

#Область ОграниченияСтрок

Процедура ДобавитьОграниченияСтрок(Построение)
	// Ограничения строк профиля (п. 7.5 ТЗ): ограничения одного поля с видами eq и in_hierarchy
	// объединяются через ИЛИ, ne - через И, ограничения разных полей - через И. Ограничение,
	// которое нельзя применить к таблице, закрывает доступ (ошибка без подробностей для модели).

	Если Остановлено(Построение) Тогда
		Возврат;
	КонецЕсли;
	Ограничения = mcp1c_ПравилаДоступа.ОграниченияСтрок(Построение.Политика, Построение.Таблица.Объект);
	Для Каждого Группа Из ГруппыОграничений(Ограничения) Цикл
		ДобавитьГруппуОграничений(Построение, Группа);
		Если Остановлено(Построение) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Если Ограничения.Количество() > 0 Тогда
		Построение.Примечания.Добавить("Рядки обмежено правилами профілю: підсумки охоплюють лише дозволені рядки");
	КонецЕсли;

КонецПроцедуры

Функция ГруппыОграничений(Ограничения)
	// Ограничения, сгруппированные по полю (без учета регистра) и разделенные на условия
	// равенства и иерархии (объединяются через ИЛИ) и неравенства (через И).

	Группы = Новый Массив;
	Индекс = Новый Соответствие;
	Для Каждого Ограничение Из Ограничения Цикл
		Ключ = НРег(Ограничение.Поле);
		Группа = Индекс.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Поле, Положительные, Отрицательные", Ограничение.Поле, Новый Массив, Новый Массив);
			Индекс.Вставить(Ключ, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;
		Если Ограничение.ВидСравнения = "ne" Тогда
			Группа.Отрицательные.Добавить(Ограничение);
		Иначе
			Группа.Положительные.Добавить(Ограничение);
		КонецЕсли;
	КонецЦикла;
	Возврат Группы;

КонецФункции

Процедура ДобавитьГруппуОграничений(Построение, Группа)

	Префикс = ?(Построение.Таблица.ВидТаблицы = "tabular_section", "Ссылка.", "");
	Разбор = mcp1c_ПутиПолей.РазобратьПуть(Построение.Таблица, Префикс + Группа.Поле, Построение.Описания, Построение.СистемнаяПолитика);
	Если Не ПустаяСтрока(Разбор.НужноОписание) Тогда
		Построение.НужноОписание = Разбор.НужноОписание;
		Возврат;
	КонецЕсли;
	Если Не Разбор.Успех Тогда
		ОтказатьПоОграничению(Построение, СтрШаблон("Поле ограничения %1 не найдено в таблице %2", Группа.Поле, Построение.Таблица.Имя));
		Возврат;
	КонецЕсли;
	ВУсловииТаблицы = ВУсловииВиртуальнойТаблицы(Построение, Разбор);

	ИЛИ_ = mcp1c_КонструкторЗапросов.НовоеУсловие("", "or", Неопределено, ВУсловииТаблицы);
	Для Каждого Ограничение Из Группа.Положительные Цикл
		Условие = УсловиеОграничения(Построение, Разбор, Ограничение);
		Если Условие = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ИЛИ_.Элементы.Добавить(Условие);
	КонецЦикла;
	Если ИЛИ_.Элементы.Количество() = 1 Тогда
		ИЛИ_.Элементы[0].ВУсловииТаблицы = ВУсловииТаблицы;
		Построение.Спецификация.Условия.Добавить(ИЛИ_.Элементы[0]);
	ИначеЕсли ИЛИ_.Элементы.Количество() > 1 Тогда
		Построение.Спецификация.Условия.Добавить(ИЛИ_);
	КонецЕсли;

	Для Каждого Ограничение Из Группа.Отрицательные Цикл
		Условие = УсловиеОграничения(Построение, Разбор, Ограничение);
		Если Условие = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Условие.ВУсловииТаблицы = ВУсловииТаблицы;
		Построение.Спецификация.Условия.Добавить(Условие);
	КонецЦикла;

КонецПроцедуры

Функция УсловиеОграничения(Построение, Разбор, Ограничение)

	Вид = Ограничение.ВидСравнения;
	Если Вид <> "eq" И Вид <> "ne" И Вид <> "in_hierarchy" Тогда
		ОтказатьПоОграничению(Построение, ?(ПустаяСтрока(Ограничение.Ошибка),
			СтрШаблон("Не задан вид сравнения ограничения по полю %1", Ограничение.Поле), Ограничение.Ошибка));
		Возврат Неопределено;
	КонецЕсли;
	Если Вид = "in_hierarchy" И Не ЕстьИерархическийТип(Разбор.Типы) Тогда
		ОтказатьПоОграничению(Построение, СтрШаблон("В ИЕРАРХИИ для поля %1 без ссылочного типа", Ограничение.Поле));
		Возврат Неопределено;
	КонецЕсли;

	ЭтоСписок = ТипЗнч(Ограничение.Значение) = Тип("Массив") Или Вид = "in_hierarchy";
	Ошибка = "";
	Если ЭтоСписок Тогда
		Значение = СписокОграничения(Ограничение.Значение, Разбор.Типы, Ошибка);
	Иначе
		Разобранное = РазобратьЗначение(Ограничение.Значение, Разбор.Типы, "value");
		Значение = Разобранное.Значение;
		Ошибка = Разобранное.Ошибка;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		ОтказатьПоОграничению(Построение, СтрШаблон("Значение ограничения по полю %1: %2", Ограничение.Поле, Ошибка));
		Возврат Неопределено;
	КонецЕсли;

	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(Построение, Значение));
	Возврат mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, ОператорОграничения(Вид, ЭтоСписок), Параметры,
		Ложь, Разбор.НеограниченнаяСтрока);

КонецФункции

Функция ОператорОграничения(Вид, ЭтоСписок)

	Если Вид = "in_hierarchy" Или Не ЭтоСписок Тогда
		Возврат Вид;
	КонецЕсли;
	Возврат ?(Вид = "eq", "in", "not_in");

КонецФункции

Функция СписокОграничения(Значение, Типы, Ошибка)

	Значения = Значение;
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Значения = Новый Массив;
		Значения.Добавить(Значение);
	КонецЕсли;
	Если Значения.Количество() = 0 Тогда
		Ошибка = "пустой список";
		Возврат Неопределено;
	КонецЕсли;
	Список = НовоеЗначение("list");
	Для Каждого Элемент Из Значения Цикл
		Разобранное = РазобратьЗначение(Элемент, Типы, "value");
		Если Не Разобранное.Успех Тогда
			Ошибка = Разобранное.Ошибка;
			Возврат Неопределено;
		КонецЕсли;
		Список.Элементы.Добавить(Разобранное.Значение);
	КонецЦикла;
	Возврат Список;

КонецФункции

Процедура ДобавитьМинимумГруппы(Построение)
	// Режим «только агрегаты» (п. 5.3, 7.4 ТЗ): группы, в которых меньше k записей, не выдаются.

	Если Остановлено(Построение) Или Не Построение.ТолькоАгрегаты Тогда
		Возврат;
	КонецЕсли;
	Минимум = mcp1c_ПравилаДоступа.МинимальныйРазмерГруппы(Построение.Политика, Построение.Таблица.Объект);
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Минимум)));
	Построение.Спецификация.Имеющие.Добавить(mcp1c_КонструкторЗапросов.НовоеУсловие("КОЛИЧЕСТВО(*)", "gte", Параметры));
	Построение.Примечания.Добавить(СтрШаблон("Режим «тільки агрегати»: групи, у яких менше %1 записів, не показуються",
		Формат(Минимум, "ЧН=0; ЧГ=0")));

КонецПроцедуры

Процедура ОтказатьПоОграничению(Построение, Причина)

	Остановить(Построение, СтрШаблон("Обмеження рядків профілю для «%1» не може бути застосоване: зверніться до адміністратора. "
		+ "Ідентифікатор запиту - у _meta відповіді.", Построение.Таблица.Объект), Причина);

КонецПроцедуры

#КонецОбласти

#Область Порядок

Процедура ДобавитьПорядок(Построение, Порядок)
	// Упорядочивание из аргументов и ключевые поля, задающие однозначный порядок для пагинации.
	// Скрытые поля в упорядочивании не используются (п. 7.4 ТЗ).

	Если Остановлено(Построение) Тогда
		Возврат;
	КонецЕсли;
	Использованные = Новый Массив;
	Для Каждого Элемент Из Порядок Цикл
		ДобавитьПорядокАргумента(Построение, СокрЛП(Свойство(Элемент, "field", "")), Свойство(Элемент, "desc", Ложь) = Истина,
			Использованные);
		Если Остановлено(Построение) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если Построение.Группировка Тогда
		// После группировки строки однозначно определяются значениями группировок.
		Для Каждого Колонка Из Построение.Колонки Цикл
			Если ЕстьГруппировкаПоВыражению(Построение, Колонка.Выражение) Тогда
				ДобавитьЭлементПорядка(Построение, Колонка.Псевдоним, Ложь, Ложь, Использованные, Колонка.Выражение);
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Для Каждого Имя Из Построение.Таблица.ПоляПорядка Цикл
		Разбор = mcp1c_ПутиПолей.РазобратьПуть(Построение.Таблица, Имя, Построение.Описания, Построение.Политика);
		Если Разбор.Успех И Не ПорядокРаскрываетМаску(Разбор) Тогда
			ДобавитьЭлементПорядка(Построение, Разбор.Выражение, Ложь, Разбор.НеограниченнаяСтрока, Использованные);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПорядокАргумента(Построение, Имя, Убывание, Использованные)

	Если Не Построение.Группировка Тогда
		Разбор = РазобратьПутьКлиента(Построение, Имя);
		Если Разбор <> Неопределено И БезМаски(Построение, Разбор, "сортувати") Тогда
			ДобавитьЭлементПорядка(Построение, Разбор.Выражение, Убывание, Разбор.НеограниченнаяСтрока, Использованные);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Колонка = НайтиКолонку(Построение, Имя);
	Если Колонка = Неопределено Тогда
		Остановить(Построение, СтрШаблон("order_by: «%1» - сортувати можна лише за полями group_by або aggregates "
			+ "(для агрегата - за значенням as або func(field))", Лев(Имя, 100)));
		Возврат;
	КонецЕсли;
	ДобавитьЭлементПорядка(Построение, Колонка.Псевдоним, Убывание, Ложь, Использованные);

КонецПроцедуры

Процедура ДобавитьЭлементПорядка(Построение, Выражение, Убывание, НеограниченнаяСтрока, Использованные, Синоним = "")

	Если Использованные.Найти(НРег(Выражение)) <> Неопределено
		Или Не ПустаяСтрока(Синоним) И Использованные.Найти(НРег(Синоним)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Использованные.Добавить(НРег(Выражение));
	Если Не ПустаяСтрока(Синоним) Тогда
		Использованные.Добавить(НРег(Синоним));
	КонецЕсли;
	Колонка = Неопределено;
	Для Каждого Элемент Из Построение.Колонки Цикл
		Если Элемент.Псевдоним = Выражение Тогда
			Колонка = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Колонка <> Неопределено Тогда
		// Синоним колонки: повторное упорядочивание по тому же полю не добавляется.
		Использованные.Добавить(НРег(Колонка.Выражение));
	КонецЕсли;
	Построение.Спецификация.Порядок.Добавить(mcp1c_КонструкторЗапросов.НовыйЭлементПорядка(Выражение, Убывание, Ложь,
		НеограниченнаяСтрока));

КонецПроцедуры

Функция ПорядокРаскрываетМаску(Разбор)
	// Порядок по замаскированному полю раскрывал бы соотношение значений. Ссылки на объекты
	// упорядочиваются по внутреннему представлению, поэтому порядок по ним для пагинации значений
	// не раскрывает; перечисления упорядочиваются по порядку значений и раскрывают.

	Если Разбор.Маска = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Тип_ Из Разбор.Типы Цикл
		Если Не mcp1c_ПутиПолей.ЭтоСсылочныйТип(Тип_) Или mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЕстьГруппировкаПоВыражению(Построение, Выражение)

	Для Каждого Группировка Из Построение.Спецификация.Группировки Цикл
		Если Группировка.Выражение = Выражение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область РазборЗначений

Процедура РазобратьОбъектЗначения(Результат, Значение, Типы, Путь)

	ИмяТипа = Свойство(Значение, "type");
	Если ТипЗнч(ИмяТипа) <> Тип("Строка") Тогда
		// Без type допускается ссылка или перечисление, если у поля один такой тип.
		Если Свойство(Значение, "ref") <> Неопределено Тогда
			ИмяТипа = ЕдинственныйСсылочныйТип(Типы);
		Иначе
			ИмяТипа = ЕдинственныйТипПеречисления(Типы);
		КонецЕсли;
		Если ИмяТипа = Неопределено Тогда
			Результат.Ошибка = Путь + ": для посилання очікується {""type"": ""Справочник.Контрагенты"", ""ref"": ""<uuid>""}";
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Тип_ = КаноническийТип(ИмяТипа, Типы);
	Если Тип_ = Неопределено Тогда
		Результат.Ошибка = СтрШаблон("%1: тип «%2» не підходить полю; допустимі типи: %3", Путь, Лев(ИмяТипа, 100),
			СтрСоединить(Типы, ", "));
		Возврат;
	КонецЕсли;

	Если mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
		ИмяЗначения = Свойство(Значение, "value");
		Если Не ЭтоИмя(ИмяЗначения) Тогда
			Результат.Ошибка = Путь + ": для перерахування очікується {""type"": """ + Тип_ + """, ""value"": ""<ім'я значення>""}";
			Возврат;
		КонецЕсли;
		Результат.Значение = НовоеЗначение("enum");
		Результат.Значение.Тип = Тип_;
		Результат.Значение.Имя = ИмяЗначения;
		Возврат;
	КонецЕсли;

	Идентификатор = Свойство(Значение, "ref");
	Если Не ЭтоУникальныйИдентификатор(Идентификатор) Тогда
		Результат.Ошибка = Путь + ".ref: очікується унікальний ідентифікатор (поле ref зі значення посилання)";
		Возврат;
	КонецЕсли;
	Результат.Значение = НовоеЗначение("ref");
	Результат.Значение.Тип = Тип_;
	Результат.Значение.Идентификатор = НРег(Идентификатор);

КонецПроцедуры

Процедура РазобратьСтроку(Результат, Значение, Типы, Путь)

	Если Типы.Найти("Строка") <> Неопределено Тогда
		Результат.Значение = НовоеЗначение("value", Строка(Значение));
		Возврат;
	КонецЕсли;
	Если Типы.Найти("Дата") <> Неопределено Тогда
		Разобранная = mcp1c_Служебный.РазобратьДату(Значение);
		Если Разобранная = Неопределено Тогда
			Результат.Ошибка = Путь + ": очікується дата YYYY-MM-DD або YYYY-MM-DDTHH:MM:SS (місцевий час сервера)";
		Иначе
			Результат.Значение = НовоеЗначение("value", Разобранная.Дата);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Перечисление = ЕдинственныйТипПеречисления(Типы);
	Если Перечисление <> Неопределено И ЭтоИмя(Значение) Тогда
		Результат.Значение = НовоеЗначение("enum");
		Результат.Значение.Тип = Перечисление;
		Результат.Значение.Имя = Значение;
		Возврат;
	КонецЕсли;
	Если Типы.Найти("УникальныйИдентификатор") <> Неопределено И ЭтоУникальныйИдентификатор(Значение) Тогда
		Результат.Значение = НовоеЗначение("uuid", НРег(Значение));
		Возврат;
	КонецЕсли;
	Ссылочный = ЕдинственныйСсылочныйТип(Типы);
	Если Ссылочный <> Неопределено И ЭтоУникальныйИдентификатор(Значение) Тогда
		Результат.Значение = НовоеЗначение("ref");
		Результат.Значение.Тип = Ссылочный;
		Результат.Значение.Идентификатор = НРег(Значение);
		Возврат;
	КонецЕсли;
	Результат.Ошибка = ОшибкаТипа(Путь, "рядок", Типы);

КонецПроцедуры

Функция ОшибкаТипа(Путь, ВидЗначения, Типы)

	Пример = "";
	Ссылочный = ЕдинственныйСсылочныйТип(Типы);
	Если Ссылочный <> Неопределено Тогда
		Пример = СтрШаблон("; для посилання передайте {""type"": ""%1"", ""ref"": ""<uuid>""}", Ссылочный);
	КонецЕсли;
	Возврат СтрШаблон("%1: значення типу «%2» не підходить полю типу %3%4", Путь, ВидЗначения,
		СтрСоединить(Типы, ", "), Пример);

КонецФункции

Функция КаноническийТип(ИмяТипа, Типы)
	// Тип поля, совпадающий с именем типа из аргументов без учета регистра и языка класса.

	Искомый = НРег(НормализованноеИмяТипа(ИмяТипа));
	Для Каждого Тип_ Из Типы Цикл
		Если mcp1c_ПутиПолей.ЭтоСсылочныйТип(Тип_) И НРег(Тип_) = Искомый Тогда
			Возврат Тип_;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЕдинственныйТипПеречисления(Типы)

	Результат = Неопределено;
	Для Каждого Тип_ Из Типы Цикл
		Если mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
			Если Результат <> Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Результат = Тип_;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕдинственныйСсылочныйТип(Типы)

	Результат = Неопределено;
	Для Каждого Тип_ Из Типы Цикл
		Если mcp1c_ПутиПолей.ЭтоСсылочныйТип(Тип_) И Не mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
			Если Результат <> Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Результат = Тип_;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьИерархическийТип(Типы)

	Для Каждого Тип_ Из Типы Цикл
		Если mcp1c_ПутиПолей.ЭтоСсылочныйТип(Тип_) И Не mcp1c_ПутиПолей.ЭтоПеречисление(Тип_) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ДопускаетСравнение(Типы)
	// Допускают ли типы сравнение "больше-меньше": только число, дата и строка.

	Если Типы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Тип_ Из Типы Цикл
		Если Тип_ <> "Число" И Тип_ <> "Дата" И Тип_ <> "Строка" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоИмя(Текст)
	// Имя из букв, цифр и подчеркиваний, начинается не с цифры (имя значения перечисления).

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Или СтрДлина(Текст) > 128 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		ЭтоБуква = НРег(Символ) <> ВРег(Символ) Или Символ = "_";
		Если Не ЭтоБуква И Не (Позиция > 1 И СтрНайти("0123456789", Символ) > 0) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция КлассыСсылочныхТипов()

	Классы = Новый Соответствие;
	Классы.Вставить("catalog", "Справочник");
	Классы.Вставить("document", "Документ");
	Классы.Вставить("enum", "Перечисление");
	Классы.Вставить("chartofcharacteristictypes", "ПланВидовХарактеристик");
	Классы.Вставить("chartofaccounts", "ПланСчетов");
	Классы.Вставить("chartofcalculationtypes", "ПланВидовРасчета");
	Классы.Вставить("businessprocess", "БизнесПроцесс");
	Классы.Вставить("task", "Задача");
	Классы.Вставить("exchangeplan", "ПланОбмена");
	Возврат Классы;


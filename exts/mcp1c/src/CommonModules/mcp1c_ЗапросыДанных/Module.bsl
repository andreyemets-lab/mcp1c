Процедура ДобавитьОтборПоСсылке(П, Путь, ПолноеИмя, Идентификатор)

	Разбор = РазобратьПутьСистемы(П, Путь);
	Если Разбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значение = НовоеЗначение("ref");
	Значение.Тип = ПолноеИмя;
	Значение.Идентификатор = Идентификатор;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(П, Значение));
	П.Спецификация.Условия.Добавить(mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, "eq", Параметры));


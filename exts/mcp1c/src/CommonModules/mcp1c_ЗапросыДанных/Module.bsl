///////////////////////////////////////////////////////////////////////////////
// mcp1c_ЗапросыДанных: построение запросов инструментов чтения данных по аргументам
// модели (п. 3.2 шаги 5-7, 5.2-5.4, 7.4-7.5 ТЗ).
//
// Из аргументов, описаний таблиц (mcp1c_Метаданные) и политики клиента строится
// спецификация mcp1c_КонструкторЗапросов, параметры и колонки результата:
//  - каждый путь поля разбирает mcp1c_ПутиПолей с проверкой политикой каждого звена;
//  - значения из аргументов проверяются по типам полей и описываются спецификациями
//    значений (см. НовоеЗначение), которые в значения платформы превращает mcp1c_Значения;
//  - к условиям модели добавляются ограничения строк профиля, отбор пометки удаления,
//    активности и обязательный отбор периода.
// Служебные условия (пометка удаления, ограничения строк) строятся по системной политике:
// они действуют, даже если поле скрыто от клиента.
// Замаскированные поля (п. 7.4 ТЗ) выбираются с маской колонки и не используются в отборах,
// сортировке, группировке и агрегатах (кроме count и count_distinct; для маски округления
// агрегат тоже округляется). Объект в режиме «только агрегаты» читается только группировками
// и агрегатами, группы меньше минимального размера отбрасываются (ИМЕЮЩИЕ КОЛИЧЕСТВО(*) >= k).
// Если для разыменования нужно описание еще одной таблицы, результат содержит НужноОписание:
// вызывающий код загружает описание и повторяет построение.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Построения

// Выборка из одной таблицы для query_records (п. 5.3 ТЗ).
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные по схеме аргументы инструмента.
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания объектов для разыменования, см. mcp1c_ПутиПолей.РазобратьПуть.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Лимит - Число - строк на странице.
//  Смещение - Число - сколько строк уже выдано (из курсора).
//
// Возвращаемое значение:
//  см. НовоеПостроение
//
Функция ВыборкаЗаписей(Аргументы, Таблица, Описания, Политика, Лимит, Смещение) Экспорт

	Построение = НовоеПостроение(Таблица, Описания, Политика, Лимит, Смещение);
	Поля = Свойство(Аргументы, "fields", Новый Массив);
	Группировки = Свойство(Аргументы, "group_by", Новый Массив);
	Агрегаты = Свойство(Аргументы, "aggregates", Новый Массив);

	Если Построение.ТолькоАгрегаты И Агрегаты.Количество() = 0 Тогда
		Остановить(Построение, СтрШаблон("«%1» доступний лише в агрегатах: задайте aggregates і, за потреби, group_by",
			Таблица.Объект));
		Возврат Построение;
	КонецЕсли;
	Если Группировки.Количество() > 0 Или Агрегаты.Количество() > 0 Тогда
		Если Поля.Количество() > 0 Тогда
			Остановить(Построение, "fields не поєднується з group_by і aggregates: поля групування задайте в group_by");
			Возврат Построение;
		КонецЕсли;
		Построение.Группировка = Истина;
		ДобавитьГруппировки(Построение, Группировки);
		ДобавитьАгрегаты(Построение, Агрегаты);
	ИначеЕсли Поля.Количество() > 0 Тогда
		ДобавитьПоля(Построение, Поля);
	Иначе
		ДобавитьПоляПоУмолчанию(Построение);
	КонецЕсли;

	ДобавитьОтборы(Построение, Свойство(Аргументы, "filters", Новый Массив));
	ДобавитьОтборПериода(Построение, Свойство(Аргументы, "period"));
	ДобавитьСистемныеОтборы(Построение, Свойство(Аргументы, "include_deleted", Ложь) = Истина,
		Свойство(Аргументы, "only_posted", Ложь) = Истина);
	ДобавитьОграниченияСтрок(Построение);
	ДобавитьМинимумГруппы(Построение);
	ДобавитьПорядок(Построение, Свойство(Аргументы, "order_by", Новый Массив));
	Завершить(Построение);
	Возврат Построение;

КонецФункции

// Поиск объектов одной таблицы по строке для find_objects: подстрока в строковых полях поиска,
// точное совпадение - в числовых (п. 5.2 ТЗ).
//
// Параметры:
//  ТекстПоиска - Строка - строка поиска.
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания для разыменования.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Лимит - Число - сколько объектов вернуть.
//
// Возвращаемое значение:
//  см. НовоеПостроение
//
Функция ПоискОбъектов(Знач ТекстПоиска, Таблица, Описания, Политика, Лимит) Экспорт

	Построение = НовоеПостроение(Таблица, Описания, Политика, Лимит, 0);
	ТекстПоиска = СокрЛП(ТекстПоиска);
	Если ЗаписиНедоступны(Построение) Тогда
		Возврат Построение;
	КонецЕсли;
	Если mcp1c_ПравилаДоступа.ТребуетсяОтборПоПериоду(Политика, Таблица.Объект) Тогда
		Остановить(Построение, СтрШаблон("Профіль вимагає фільтр за періодом для «%1»: шукайте через query_records з period",
			Таблица.Объект));
		Возврат Построение;
	КонецЕсли;

	Для Каждого Имя Из Таблица.КлючевыеПоля Цикл
		ДобавитьКолонкуЕслиДоступна(Построение, Имя);
	КонецЦикла;

	Группа = mcp1c_КонструкторЗапросов.НовоеУсловие("", "or");
	Для Каждого Имя Из Таблица.ПоляПоиска Цикл
		Разбор = mcp1c_ПутиПолей.РазобратьПуть(Таблица, Имя, Описания, Политика);
		Если Не Разбор.Успех Или Разбор.Маска <> Неопределено Тогда
			Продолжить; // скрытые и замаскированные поля в поиске не участвуют
		КонецЕсли;
		Условие = УсловиеПоиска(Построение, Разбор, ТекстПоиска);
		Если Условие <> Неопределено Тогда
			Группа.Элементы.Добавить(Условие);
			ДобавитьКолонку(Построение, Разбор, Разбор.Путь);
		КонецЕсли;
	КонецЦикла;
	Если Группа.Элементы.Количество() = 0 Тогда
		Остановить(Построение, СтрШаблон("У «%1» немає доступних полів для пошуку за рядком «%2»: використовуйте query_records",
			Таблица.Объект, Лев(ТекстПоиска, 100)));
		Возврат Построение;
	КонецЕсли;
	Построение.Спецификация.Условия.Добавить(Группа);

	ДобавитьСистемныеОтборы(Построение, Ложь, Ложь);
	ДобавитьОграниченияСтрок(Построение);
	ДобавитьПорядок(Построение, Новый Массив);
	Завершить(Построение);
	Возврат Построение;

КонецФункции

// Реквизиты шапки объекта по ссылке для get_object: все доступные поля таблицы объекта.
//
// Параметры:
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания для разыменования.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Идентификатор - Строка - уникальный идентификатор ссылки.
//
// Возвращаемое значение:
//  см. НовоеПостроение
//
Функция КарточкаОбъекта(Таблица, Описания, Политика, Знач Идентификатор) Экспорт

	Построение = НовоеПостроение(Таблица, Описания, Политика, 1, 0);
	Идентификатор = НРег(СокрЛП(Идентификатор));
	Если ЗаписиНедоступны(Построение) Тогда
		Возврат Построение;
	КонецЕсли;
	Если Не ЭтоУникальныйИдентификатор(Идентификатор) Тогда
		Остановить(Построение, "ref: очікується унікальний ідентифікатор виду 4e0c1d2a-0000-0000-0000-000000000000");
		Возврат Построение;
	КонецЕсли;

	Для Каждого Поле Из Таблица.Поля Цикл
		ДобавитьКолонкуЕслиДоступна(Построение, Поле.Имя);
	КонецЦикла;
	ДобавитьОтборПоСсылке(Построение, "Ссылка", Таблица.Объект, Идентификатор);
	ДобавитьСистемныеОтборы(Построение, Ложь, Ложь);
	ДобавитьОграниченияСтрок(Построение);
	Завершить(Построение);
	Возврат Построение;

КонецФункции

// Строки табличной части объекта для get_object.
//
// Параметры:
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания для разыменования.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Идентификатор - Строка - уникальный идентификатор ссылки владельца.
//  Лимит - Число - сколько строк вернуть.
//
// Возвращаемое значение:
//  см. НовоеПостроение
//
Функция СтрокиТабличнойЧасти(Таблица, Описания, Политика, Знач Идентификатор, Лимит) Экспорт

	Построение = НовоеПостроение(Таблица, Описания, Политика, Лимит, 0);
	Идентификатор = НРег(СокрЛП(Идентификатор));
	Если ЗаписиНедоступны(Построение) Тогда
		Возврат Построение;
	КонецЕсли;
	Если Не ЭтоУникальныйИдентификатор(Идентификатор) Тогда
		Остановить(Построение, "ref: очікується унікальний ідентифікатор");
		Возврат Построение;
	КонецЕсли;

	Для Каждого Поле Из Таблица.Поля Цикл
		Если НРег(Поле.Имя) <> "ссылка" Тогда
			ДобавитьКолонкуЕслиДоступна(Построение, Поле.Имя);
		КонецЕсли;
	КонецЦикла;
	ДобавитьОтборПоСсылке(Построение, "Ссылка", Таблица.Объект, Идентификатор);
	ДобавитьОграниченияСтрок(Построение);
	ДобавитьПорядок(Построение, Новый Массив);
	Завершить(Построение);
	Возврат Построение;

КонецФункции

// Остатки регистра накопления или бухгалтерии на момент времени для get_balances.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - аргументы инструмента.
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания для разыменования.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Лимит - Число - строк на странице.
//  Смещение - Число - сколько строк уже выдано.
//
// Возвращаемое значение:
//  см. НовоеПостроение
//
Функция Остатки(Аргументы, Таблица, Описания, Политика, Лимит, Смещение) Экспорт

	Построение = НовоеПостроение(Таблица, Описания, Политика, Лимит, Смещение);
	Построение.Группировка = Истина;
	ПараметрПериода = "";
	ТекстДаты = Свойство(Аргументы, "date");
	Если ТекстДаты <> Неопределено Тогда
		Момент = РазобратьДатуАргумента(Построение, ТекстДаты, "date", "end_of_day_exclusive");
		Если Момент = Неопределено Тогда
			Возврат Построение;
		КонецЕсли;
		ПараметрПериода = "&" + ДобавитьПараметр(Построение, НовоеЗначение("value", Момент));
	КонецЕсли;

	УсловиеСчета = УсловиеСчетаРегистра(Построение, Свойство(Аргументы, "account"));
	Если Остановлено(Построение) Тогда
		Возврат Построение;
	КонецЕсли;
	// Период, [УсловиеСчета, Субконто,] Условие.
	ПараметрыТаблицы = Построение.Спецификация.ПараметрыТаблицы;
	ПараметрыТаблицы.Добавить(ПараметрПериода);
	Если Таблица.Вид = "accounting_register" Тогда
		ПараметрыТаблицы.Добавить(УсловиеСчета);
		ПараметрыТаблицы.Добавить("");
	КонецЕсли;
	ПараметрыТаблицы.Добавить("{Условие}");

	ДобавитьГруппировкиРегистра(Построение, Свойство(Аргументы, "group_by"));
	ДобавитьРесурсы(Построение, Свойство(Аргументы, "resources"));
	ДобавитьОтборы(Построение, Свойство(Аргументы, "filters", Новый Массив));
	ДобавитьОграниченияСтрок(Построение);
	ДобавитьМинимумГруппы(Построение);
	ДобавитьПорядок(Построение, Новый Массив);
	Завершить(Построение);
	Возврат Построение;

КонецФункции

// Обороты (или остатки и обороты) регистра накопления или бухгалтерии за период для get_turnovers.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - аргументы инструмента.
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания для разыменования.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Лимит - Число - строк на странице.
//  Смещение - Число - сколько строк уже выдано.
//
// Возвращаемое значение:
//  см. НовоеПостроение
//
Функция Обороты(Аргументы, Таблица, Описания, Политика, Лимит, Смещение) Экспорт

	Построение = НовоеПостроение(Таблица, Описания, Политика, Лимит, Смещение);
	Построение.Группировка = Истина;
	Период = ГраницыПериода(Построение, Свойство(Аргументы, "period"), Истина);
	Если Период = Неопределено Тогда
		Возврат Построение;
	КонецЕсли;
	Периодичность = КлючевоеСловоПериодичности(Свойство(Аргументы, "periodicity", "none"));
	Если Периодичность = Неопределено Тогда
		Остановить(Построение, "periodicity: допустимі значення none, day, week, month, quarter, year");
		Возврат Построение;
	КонецЕсли;
	Построение.Периодичность = Периодичность;

	Начало = "&" + ДобавитьПараметр(Построение, НовоеЗначение("value", Период.Начало));
	Конец = "&" + ДобавитьПараметр(Построение, НовоеЗначение("value", Период.Конец));
	УсловиеСчета = УсловиеСчетаРегистра(Построение, Свойство(Аргументы, "account"));
	Если Остановлено(Построение) Тогда
		Возврат Построение;
	КонецЕсли;
	Построение.Спецификация.ПараметрыТаблицы = ПараметрыТаблицыОборотов(Таблица, Начало, Конец, Периодичность, УсловиеСчета);

	Если Не ПустаяСтрока(Периодичность) Тогда
		Если mcp1c_ПравилаДоступа.МаскаПоля(Политика, Таблица.Объект, "Период") <> Неопределено Тогда
			Остановить(Построение, "Поле «Период» масковане профілем: розбивка за періодами (periodicity) недоступна");
			Возврат Построение;
		КонецЕсли;
		ДобавитьГруппировку(Построение, "Период", Истина);
	КонецЕсли;
	ДобавитьГруппировкиРегистра(Построение, Свойство(Аргументы, "group_by"));
	ДобавитьРесурсы(Построение, Свойство(Аргументы, "resources"));
	ДобавитьОтборы(Построение, Свойство(Аргументы, "filters", Новый Массив));
	ДобавитьОграниченияСтрок(Построение);
	ДобавитьМинимумГруппы(Построение);
	ДобавитьПорядок(Построение, Новый Массив);
	Завершить(Построение);
	Возврат Построение;

КонецФункции

// Срез последних или первых записей периодического регистра сведений для get_slice.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - аргументы инструмента.
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания для разыменования.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Лимит - Число - строк на странице.
//  Смещение - Число - сколько строк уже выдано.
//
// Возвращаемое значение:
//  см. НовоеПостроение
//
Функция Срез(Аргументы, Таблица, Описания, Политика, Лимит, Смещение) Экспорт

	Построение = НовоеПостроение(Таблица, Описания, Политика, Лимит, Смещение);
	Если ЗаписиНедоступны(Построение) Тогда
		Возврат Построение;
	КонецЕсли;
	ПараметрПериода = "";
	ТекстДаты = Свойство(Аргументы, "date");
	Если ТекстДаты <> Неопределено Тогда
		Граница = ?(Таблица.ВиртуальнаяТаблица = "СрезПервых", "start_of_day", "end_of_day");
		Момент = РазобратьДатуАргумента(Построение, ТекстДаты, "date", Граница);
		Если Момент = Неопределено Тогда
			Возврат Построение;
		КонецЕсли;
		ПараметрПериода = "&" + ДобавитьПараметр(Построение, НовоеЗначение("value", Момент));
	КонецЕсли;
	// Период, Условие.
	Построение.Спецификация.ПараметрыТаблицы.Добавить(ПараметрПериода);
	Построение.Спецификация.ПараметрыТаблицы.Добавить("{Условие}");

	Поля = Свойство(Аргументы, "fields", Новый Массив);
	Если Поля.Количество() > 0 Тогда
		ДобавитьПоля(Построение, Поля);
	Иначе
		Для Каждого Поле Из Таблица.Поля Цикл
			ДобавитьКолонкуЕслиДоступна(Построение, Поле.Имя);
		КонецЦикла;
	КонецЕсли;
	ДобавитьОтборы(Построение, Свойство(Аргументы, "filters", Новый Массив));
	ДобавитьОграниченияСтрок(Построение);
	ДобавитьПорядок(Построение, Новый Массив);
	Завершить(Построение);
	Возврат Построение;

КонецФункции

#КонецОбласти

#Область Значения

// Спецификация значения параметра запроса. Значения платформы (ссылки, перечисления)
// по ней получает mcp1c_Значения.ЗначениеПараметра.
//
// Параметры:
//  Вид - Строка - value (готовое значение: Строка, Число, Булево, Дата), uuid (УникальныйИдентификатор
//        из строки Значение), ref (ссылка: Тип и Идентификатор), enum (значение перечисления: Тип и Имя),
//        list (массив Элементы), empty (пустое значение типов Типы), account_code (счет плана счетов Тип по коду Значение).
//  Значение - Строка, Число, Булево, Дата, Неопределено - значение для видов value, uuid, account_code.
//
// Возвращаемое значение:
//  Структура:
//   * Вид - Строка - вид значения.
//   * Значение - Строка, Число, Булево, Дата, Неопределено - значение для видов value, uuid, account_code.
//   * Тип - Строка - полное имя объекта метаданных для ref, enum, account_code.
//   * Идентификатор - Строка - уникальный идентификатор ссылки.
//   * Имя - Строка - имя значения перечисления.
//   * Элементы - Массив из Структура - элементы списка.
//   * Типы - Массив из Строка - типы для пустого значения.
//
Функция НовоеЗначение(Вид, Значение = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Вид", Вид);
	Результат.Вставить("Значение", Значение);
	Результат.Вставить("Тип", "");
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("Имя", "");
	Результат.Вставить("Элементы", Новый Массив);
	Результат.Вставить("Типы", Новый Массив);
	Возврат Результат;

КонецФункции

// Проверяет значение из аргументов по типам поля и описывает его спецификацией (п. 5.3 ТЗ):
// ссылка - {"type": "Справочник.Контрагенты", "ref": "<uuid>"}; перечисление - {"type": "Перечисление.X",
// "value": "Имя"} или строка с именем значения; дата - ISO 8601; строка, число, булево - как есть.
//
// Параметры:
//  Значение - Произвольный - разобранное значение JSON.
//  Типы - Массив из Строка - типы поля.
//  Путь - Строка - путь к значению для текста ошибки ("filters[0].value").
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - значение подходит полю.
//   * Значение - см. НовоеЗначение
//              - Неопределено - если значение не подходит полю.
//   * Ошибка - Строка - текст ошибки для модели.
//
Функция РазобратьЗначение(Значение, Типы, Путь) Экспорт

	Результат = Новый Структура("Успех, Значение, Ошибка", Ложь, Неопределено, "");
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Соответствие") Тогда
		РазобратьОбъектЗначения(Результат, Значение, Типы, Путь);
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		РазобратьСтроку(Результат, Значение, Типы, Путь);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Если Типы.Найти("Число") = Неопределено Тогда
			Результат.Ошибка = ОшибкаТипа(Путь, "число", Типы);
		Иначе
			Результат.Значение = НовоеЗначение("value", Число(Значение));
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Если Типы.Найти("Булево") = Неопределено Тогда
			Результат.Ошибка = ОшибкаТипа(Путь, "true/false", Типы);
		Иначе
			Результат.Значение = НовоеЗначение("value", Значение = Истина);
		КонецЕсли;
	ИначеЕсли Значение = Неопределено Тогда
		Результат.Ошибка = Путь + ": null не підтримується; для порожніх значень використовуйте op is_empty";
	Иначе
		Результат.Ошибка = Путь + ": очікується одне значення, а не масив";
	КонецЕсли;
	Результат.Успех = ПустаяСтрока(Результат.Ошибка);
	Возврат Результат;

КонецФункции

// Приводит имя типа к виду метаданных: английский класс заменяется русским
// ("Catalog.Контрагенты" -> "Справочник.Контрагенты").
//
// Параметры:
//  Имя - Строка - имя типа из аргументов.
//
// Возвращаемое значение:
//  Строка - имя типа с русским классом.
//
Функция НормализованноеИмяТипа(Знач Имя) Экспорт

	Имя = СокрЛП(Имя);
	Позиция = СтрНайти(Имя, ".");
	Если Позиция = 0 Тогда
		Возврат Имя;
	КонецЕсли;
	Классы = КлассыСсылочныхТипов();
	Класс = Классы.Получить(НРег(Лев(Имя, Позиция - 1)));
	Если Класс = Неопределено Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат Строка(Класс) + Сред(Имя, Позиция);

КонецФункции

// Проверяет формат уникального идентификатора: 8-4-4-4-12 шестнадцатеричных цифр.
//
// Параметры:
//  Текст - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если формат верный.
//
Функция ЭтоУникальныйИдентификатор(Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Цифры = "0123456789abcdefABCDEF";
	Для Позиция = 1 По 36 Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Позиция = 9 Или Позиция = 14 Или Позиция = 19 Или Позиция = 24 Тогда
			Если Символ <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли СтрНайти(Цифры, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Результат

// Описание колонок результата для structuredContent: name, kind и для замаскированных колонок - mask.
//
// Параметры:
//  Построение - см. НовоеПостроение
//
// Возвращаемое значение:
//  Массив из Произвольный - колонки (Соответствие): name, kind, mask.
//
Функция ОписаниеКолонок(Построение) Экспорт

	Результат = Новый Массив;
	Для Каждого Колонка Из Построение.Колонки Цикл
		Описание = Новый Соответствие;
		Описание.Вставить("name", Колонка.Имя);
		Описание.Вставить("kind", Колонка.Вид);
		Если Колонка.Маска <> Неопределено Тогда
			Описание.Вставить("mask", mcp1c_Маскирование.ОписаниеДляМодели(Колонка.Маска));
		КонецЕсли;
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена замаскированных колонок результата (masked_fields, п. 5.3 ТЗ).
//
// Параметры:
//  Построение - см. НовоеПостроение
//
// Возвращаемое значение:
//  Массив из Строка - имена колонок.
//
Функция МаскированныеКолонки(Построение) Экспорт

	Результат = Новый Массив;
	Для Каждого Колонка Из Построение.Колонки Цикл
		Если Колонка.Маска <> Неопределено Тогда
			Результат.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Построение

// Состояние построения запроса.
//
// Параметры:
//  Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Описания - Соответствие из КлючИЗначение - описания для разыменования.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Лимит - Число - строк на странице.
//  Смещение - Число - сколько строк пропустить.
//
// Возвращаемое значение:
//  Структура:
//   * Таблица - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//   * Описания - Соответствие из КлючИЗначение - описания для разыменования:
//     ** Ключ - Строка - полное имя объекта.
//     ** Значение - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//   * Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//   * СистемнаяПолитика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//   * Спецификация - см. mcp1c_КонструкторЗапросов.НоваяСпецификация
//   * Параметры - Соответствие из КлючИЗначение - параметры запроса:
//     ** Ключ - Строка - имя параметра.
//     ** Значение - см. НовоеЗначение
//   * Колонки - Массив из Структура - колонки результата: Имя, Вид, Псевдоним, Представление, Типы,
//               Выражение, НеограниченнаяСтрока, Маска (см. mcp1c_Маскирование.НоваяМаска или Неопределено).
//   * Группировка - Булево - запрос с группировкой.
//   * ТолькоАгрегаты - Булево - объект доступен только в агрегатах (п. 7.4 ТЗ).
//   * Периодичность - Строка - ключевое слово периодичности оборотов.
//   * Лимит - Число - строк на странице.
//   * Смещение - Число - сколько строк пропустить.
//   * Ошибка - Строка - ошибка для модели; построение остановлено.
//   * Причина - Строка - подробная причина для журнала.
//   * НужноОписание - Строка - полное имя объекта, описание которого нужно загрузить.
//   * Примечания - Массив из Строка - примечания для модели.
//
Функция НовоеПостроение(Таблица, Описания, Политика, Лимит, Смещение)

	Построение = Новый Структура;
	Построение.Вставить("Таблица", Таблица);
	Построение.Вставить("Описания", Описания);
	Построение.Вставить("Политика", Политика);
	Построение.Вставить("СистемнаяПолитика", СистемнаяПолитика(Политика));
	Построение.Вставить("Спецификация", mcp1c_КонструкторЗапросов.НоваяСпецификация(Таблица.Имя));
	Построение.Вставить("Параметры", Новый Соответствие);
	Построение.Вставить("Колонки", Новый Массив);
	Построение.Вставить("Группировка", Ложь);
	Построение.Вставить("ТолькоАгрегаты", mcp1c_ПравилаДоступа.ТолькоАгрегаты(Политика, Таблица.Объект));
	Построение.Вставить("Периодичность", "");
	Построение.Вставить("Лимит", Лимит);
	Построение.Вставить("Смещение", Смещение);
	Построение.Вставить("Ошибка", "");
	Построение.Вставить("Причина", "");
	Построение.Вставить("НужноОписание", "");
	Построение.Вставить("Примечания", Новый Массив);
	Возврат Построение;

КонецФункции

Функция СистемнаяПолитика(Политика)
	// Политика для служебных условий: все поля доступны, разыменование не ограничено
	// ограничениями строк. Глобально запрещенные объекты расширения остаются недоступны.

	Результат = mcp1c_ПравилаДоступа.НоваяПолитика();
	Результат.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("*"));
	Результат.Лимиты.ГлубинаРазыменования = Макс(Политика.Лимиты.ГлубинаРазыменования, 3);
	Возврат Результат;

КонецФункции

Процедура Остановить(Построение, ТекстОшибки, Причина = "")

	Если ПустаяСтрока(Построение.Ошибка) Тогда
		Построение.Ошибка = ТекстОшибки;
		Построение.Причина = Причина;
	КонецЕсли;

КонецПроцедуры

Функция Остановлено(Построение)

	Возврат Не ПустаяСтрока(Построение.Ошибка) Или Не ПустаяСтрока(Построение.НужноОписание);

КонецФункции

Функция ЗаписиНедоступны(Построение)
	// Объект в режиме «только агрегаты» не выдает отдельные записи (п. 7.4 ТЗ): останавливает построение.

	Если Не Построение.ТолькоАгрегаты Тогда
		Возврат Ложь;
	КонецЕсли;
	Остановить(Построение, СтрШаблон("«%1» доступний лише в агрегатах: окремі записи не видаються; використовуйте "
		+ "query_records з aggregates і group_by", Построение.Таблица.Объект));
	Возврат Истина;

КонецФункции

Функция БезМаски(Построение, Разбор, Действие)
	// Замаскированное поле нельзя использовать в отборах, сортировке и группировке: значение
	// восстанавливалось бы перебором (п. 7.4 ТЗ). При маске останавливает построение.

	Если Разбор.Маска = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Остановить(Построение, СтрШаблон("Поле «%1» масковане профілем: %2 за ним не можна", Разбор.Путь, Действие));
	Возврат Ложь;

КонецФункции

Процедура Завершить(Построение)

	Если Остановлено(Построение) Тогда
		Возврат;
	КонецЕсли;
	Если Построение.Колонки.Количество() = 0 Тогда
		Остановить(Построение, СтрШаблон("У «%1» немає доступних полів для вибірки. Перелік полів дає describe_object.",
			Построение.Таблица.Объект));
		Возврат;
	КонецЕсли;
	Построение.Спецификация.Первые = Построение.Смещение + Построение.Лимит + 1;

КонецПроцедуры

Функция РазобратьПутьКлиента(Построение, Путь)
	// Разбирает путь поля политикой клиента. При ошибке останавливает построение.

	Возврат РазобратьПутьПоПолитике(Построение, Путь, Построение.Политика);

КонецФункции

Функция РазобратьПутьСистемы(Построение, Путь)
	// Разбирает путь служебного условия системной политикой.

	Возврат РазобратьПутьПоПолитике(Построение, Путь, Построение.СистемнаяПолитика);

КонецФункции

Функция РазобратьПутьПоПолитике(Построение, Путь, Политика)

	Если Остановлено(Построение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Путь) <> Тип("Строка") Тогда
		Остановить(Построение, "Ім'я поля має бути рядком");
		Возврат Неопределено;
	КонецЕсли;
	Разбор = mcp1c_ПутиПолей.РазобратьПуть(Построение.Таблица, Путь, Построение.Описания, Политика);
	Если Не ПустаяСтрока(Разбор.НужноОписание) Тогда
		Построение.НужноОписание = Разбор.НужноОписание;
		Возврат Неопределено;
	КонецЕсли;
	Если Не Разбор.Успех Тогда
		Остановить(Построение, Разбор.Ошибка);
		Возврат Неопределено;
	КонецЕсли;
	Если Разбор.Поле.Роль = "period" И ПустаяСтрока(Построение.Периодичность) Тогда
		Остановить(Построение, "Поле Период доступне лише з periodicity");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Разбор;

КонецФункции

Функция ДобавитьПараметр(Построение, Значение)

	Имя = "П" + Формат(Построение.Параметры.Количество() + 1, "ЧН=0; ЧГ=0");
	Построение.Параметры.Вставить(Имя, Значение);
	Возврат Имя;

КонецФункции

#КонецОбласти

#Область Колонки

Функция ДобавитьКолонку(Построение, Разбор, ИмяКолонки, Агрегат = "", ВидКолонки = "")
	// Добавляет колонку выборки. Повторное поле не дублируется.

	Для Каждого Колонка Из Построение.Колонки Цикл
		Если НРег(Колонка.Имя) = НРег(ИмяКолонки) Тогда
			Возврат Колонка;
		КонецЕсли;
	КонецЦикла;

	Псевдоним = "К" + Формат(Построение.Колонки.Количество() + 1, "ЧН=0; ЧГ=0");
	Выражение = ?(Разбор = Неопределено, "*", Разбор.Выражение);
	Типы = ?(Разбор = Неопределено, Новый Массив, Разбор.Типы);
	Неограниченная = Разбор <> Неопределено И Разбор.НеограниченнаяСтрока;
	ЕстьСсылки = ПустаяСтрока(Агрегат) И mcp1c_ПутиПолей.ЕстьСсылочныйТип(Типы);
	Маска = МаскаКолонки(Разбор, Агрегат);
	Вид = ?(ПустаяСтрока(ВидКолонки), mcp1c_ПутиПолей.ВидЗначений(Типы), ВидКолонки);
	Если Маска <> Неопределено И Маска.Вид <> "round" Тогда
		Вид = "masked";
	КонецЕсли;

	Построение.Спецификация.Поля.Добавить(mcp1c_КонструкторЗапросов.НовоеПолеВыборки(Выражение, Псевдоним, Агрегат,
		?(ЕстьСсылки, "ссылки", ""), Неограниченная));

	Колонка = Новый Структура;
	Колонка.Вставить("Имя", ИмяКолонки);
	Колонка.Вставить("Вид", Вид);
	Колонка.Вставить("Псевдоним", Псевдоним);
	Колонка.Вставить("Представление", ЕстьСсылки);
	Колонка.Вставить("Типы", Типы);
	Колонка.Вставить("Выражение", Выражение);
	Колонка.Вставить("НеограниченнаяСтрока", Неограниченная);
	Колонка.Вставить("Маска", Маска);
	Построение.Колонки.Добавить(Колонка);
	Возврат Колонка;

КонецФункции

Функция МаскаКолонки(Разбор, Агрегат)
	// Маска колонки: маска поля; у количества маски нет; сумма, среднее, минимум и максимум
	// поля с маской округления округляются тем же шагом (другие маски до агрегатов не доходят).

	Если Разбор = Неопределено Или Агрегат = "КОЛИЧЕСТВО" Или Агрегат = "КОЛИЧЕСТВО РАЗЛИЧНЫЕ" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Разбор.Маска;

КонецФункции

Процедура ДобавитьКолонкуЕслиДоступна(Построение, Имя)
	// Добавляет колонку по имени поля, если поле доступно клиенту; скрытые поля пропускаются молча.

	Если Остановлено(Построение) Тогда
		Возврат;
	КонецЕсли;
	Разбор = mcp1c_ПутиПолей.РазобратьПуть(Построение.Таблица, Имя, Построение.Описания, Построение.Политика);
	Если Разбор.Успех И Не (Разбор.Поле.Роль = "period" И ПустаяСтрока(Построение.Периодичность)) Тогда
		ДобавитьКолонку(Построение, Разбор, Разбор.Путь);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоля(Построение, Поля)

	Для Каждого Путь Из Поля Цикл
		Разбор = РазобратьПутьКлиента(Построение, Путь);
		Если Разбор = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ДобавитьКолонку(Построение, Разбор, Разбор.Путь);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоляПоУмолчанию(Построение)
	// Ключевые поля и до МаксимумРеквизитовПоУмолчанию первых доступных реквизитов (п. 5.3 ТЗ).

	Для Каждого Имя Из Построение.Таблица.КлючевыеПоля Цикл
		ДобавитьКолонкуЕслиДоступна(Построение, Имя);
	КонецЦикла;

	Максимум = МаксимумРеквизитовПоУмолчанию();
	Добавлено = 0;
	Пропущено = 0;
	Для Каждого Поле Из Построение.Таблица.Поля Цикл
		Если Поле.Роль = "standard" Или Поле.Роль = "period" Тогда
			Продолжить;
		КонецЕсли;
		Разбор = mcp1c_ПутиПолей.РазобратьПуть(Построение.Таблица, Поле.Имя, Построение.Описания, Построение.Политика);
		Если Не Разбор.Успех Или ЕстьКолонка(Построение, Разбор.Путь) Тогда
			Продолжить;
		КонецЕсли;
		Если Добавлено >= Максимум Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		ДобавитьКолонку(Построение, Разбор, Разбор.Путь);
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Если Пропущено > 0 Тогда
		Построение.Примечания.Добавить(СтрШаблон("Показано ключові поля і перші %1 реквізитів; ще %2 полів задайте в fields "
			+ "(перелік дає describe_object)", Максимум, Пропущено));
	КонецЕсли;

КонецПроцедуры

Функция ЕстьКолонка(Построение, Имя)

	Для Каждого Колонка Из Построение.Колонки Цикл
		Если НРег(Колонка.Имя) = НРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция НайтиКолонку(Построение, Имя)

	Для Каждого Колонка Из Построение.Колонки Цикл
		Если НРег(Колонка.Имя) = НРег(СокрЛП(Имя)) Тогда
			Возврат Колонка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция МаксимумРеквизитовПоУмолчанию()

	Возврат 20;

КонецФункции

#КонецОбласти

#Область Группировки

Процедура ДобавитьГруппировки(Построение, Группировки)

	Для Каждого Путь Из Группировки Цикл
		ДобавитьГруппировку(Построение, Путь);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьГруппировку(Построение, Путь, Системная = Ложь)

	Разбор = ?(Системная, РазобратьПутьСистемы(Построение, Путь), РазобратьПутьКлиента(Построение, Путь));
	Если Разбор = Неопределено Или Не БезМаски(Построение, Разбор, "групувати") Тогда
		Возврат;
	КонецЕсли;
	Если Разбор.Поле.Роль = "resource" И Не ПустаяСтрока(Построение.Таблица.ВиртуальнаяТаблица) Тогда
		Остановить(Построение, СтрШаблон("Групувати за ресурсом «%1» не можна: задайте його в resources", Разбор.Путь));
		Возврат;
	КонецЕсли;
	Если ЕстьКолонка(Построение, Разбор.Путь) Тогда
		Возврат;
	КонецЕсли;
	ДобавитьКолонку(Построение, Разбор, Разбор.Путь);
	Построение.Спецификация.Группировки.Добавить(mcp1c_КонструкторЗапросов.НовоеВыражение(Разбор.Выражение,
		Разбор.НеограниченнаяСтрока));

КонецПроцедуры

Процедура ДобавитьАгрегаты(Построение, Агрегаты)

	Для Каждого Описание Из Агрегаты Цикл
		Если Остановлено(Построение) Тогда
			Возврат;
		КонецЕсли;
		ДобавитьАгрегат(Построение, Описание);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьАгрегат(Построение, Описание)

	Функция_ = Свойство(Описание, "func", "");
	Путь = СокрЛП(Свойство(Описание, "field", ""));
	Агрегат = ФункцииАгрегатов().Получить(Функция_);
	Если Агрегат = Неопределено Тогда
		Остановить(Построение, "aggregates.func: допустимі значення sum, count, count_distinct, avg, min, max");
		Возврат;
	КонецЕсли;

	Разбор = Неопределено;
	Если Функция_ = "count" И (Путь = "*" Или ПустаяСтрока(Путь)) Тогда
		Путь = "*";
	Иначе
		Разбор = РазобратьПутьКлиента(Построение, Путь);
		Если Разбор = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ОшибкаТипа = ОшибкаТипаАгрегата(Функция_, Разбор);
		Если Не ПустаяСтрока(ОшибкаТипа) Тогда
			Остановить(Построение, ОшибкаТипа);
			Возврат;
		КонецЕсли;
		Если Разбор.Маска <> Неопределено И Функция_ <> "count" И Функция_ <> "count_distinct"
			И Разбор.Маска.Вид <> "round" Тогда
			Остановить(Построение, СтрШаблон("Поле «%1» масковане профілем: для нього доступні лише count і count_distinct",
				Разбор.Путь));
			Возврат;
		КонецЕсли;
		Путь = Разбор.Путь;
	КонецЕсли;
	Если Построение.ТолькоАгрегаты И (Функция_ = "min" Или Функция_ = "max") Тогда
		Остановить(Построение, СтрШаблон("«%1» доступний лише в агрегатах: min і max показують значення окремого запису, "
			+ "використовуйте sum, avg, count або count_distinct", Построение.Таблица.Объект));
		Возврат;
	КонецЕсли;

	ИмяКолонки = СокрЛП(Свойство(Описание, "as", ""));
	Если ПустаяСтрока(ИмяКолонки) Тогда
		ИмяКолонки = Функция_ + "(" + Путь + ")";
	КонецЕсли;
	Если ЕстьКолонка(Построение, ИмяКолонки) Тогда
		Остановить(Построение, СтрШаблон("Колонка «%1» уже є в результаті: задайте інше aggregates.as", ИмяКолонки));
		Возврат;
	КонецЕсли;

	Вид = "number";
	Если (Функция_ = "min" Или Функция_ = "max") И Разбор <> Неопределено Тогда
		Вид = mcp1c_ПутиПолей.ВидЗначений(Разбор.Типы);
	КонецЕсли;
	ДобавитьКолонку(Построение, Разбор, ИмяКолонки, Агрегат, Вид);

КонецПроцедуры

Функция ОшибкаТипаАгрегата(Функция_, Разбор)

	Если Функция_ = "sum" Или Функция_ = "avg" Тогда
		Если Разбор.Типы.Количество() <> 1 Или Разбор.Типы[0] <> "Число" Тогда
			Возврат СтрШаблон("%1 можливе лише для числових полів, а «%2» - %3", Функция_, Разбор.Путь,
				СтрСоединить(Разбор.Типы, ", "));
		КонецЕсли;
	ИначеЕсли Функция_ = "min" Или Функция_ = "max" Тогда
		Если Разбор.Типы.Количество() <> 1 Или Не ДопускаетСравнение(Разбор.Типы) Тогда
			Возврат СтрШаблон("%1 можливе для полів типу число, дата або рядок, а «%2» - %3", Функция_, Разбор.Путь,
				СтрСоединить(Разбор.Типы, ", "));
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ФункцииАгрегатов()

	Результат = Новый Соответствие;
	Результат.Вставить("sum", "СУММА");
	Результат.Вставить("count", "КОЛИЧЕСТВО");
	Результат.Вставить("count_distinct", "КОЛИЧЕСТВО РАЗЛИЧНЫЕ");
	Результат.Вставить("avg", "СРЕДНЕЕ");
	Результат.Вставить("min", "МИНИМУМ");
	Результат.Вставить("max", "МАКСИМУМ");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Регистры

Процедура ДобавитьГруппировкиРегистра(Построение, Группировки)
	// Группировки виртуальной таблицы регистра: по умолчанию - все доступные измерения
	// (для регистра бухгалтерии - счет).

	Если Остановлено(Построение) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Группировки) = Тип("Массив") Тогда
		ДобавитьГруппировки(Построение, Группировки);
		Возврат;
	КонецЕсли;

	Если Построение.Таблица.Вид = "accounting_register" Тогда
		ДобавитьГруппировку(Построение, "Счет");
		Возврат;
	КонецЕсли;
	Пропущенные = Новый Массив;
	Для Каждого Поле Из Построение.Таблица.Поля Цикл
		Если Поле.Роль <> "dimension" Тогда
			Продолжить;
		КонецЕсли;
		Разбор = mcp1c_ПутиПолей.РазобратьПуть(Построение.Таблица, Поле.Имя, Построение.Описания, Построение.Политика);
		Если Разбор.Успех И Разбор.Маска <> Неопределено Тогда
			Пропущенные.Добавить(Разбор.Путь);
		ИначеЕсли Разбор.Успех Тогда
			ДобавитьГруппировку(Построение, Поле.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Пропущенные.Количество() > 0 Тогда
		Построение.Примечания.Добавить(СтрШаблон("Масковані виміри не групуються: %1", СтрСоединить(Пропущенные, ", ")));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьРесурсы(Построение, Ресурсы)
	// Суммы показателей ресурсов: по имени ресурса ("Количество") выбираются все поля виртуальной
	// таблицы этого ресурса ("КоличествоОстаток", "КоличествоОстатокДт", ...).

	Если Остановлено(Построение) Тогда
		Возврат;
	КонецЕсли;
	Имена = ?(ТипЗнч(Ресурсы) = Тип("Массив"), Ресурсы, ДоступныеРесурсы(Построение));
	Если Имена.Количество() = 0 Тогда
		Остановить(Построение, СтрШаблон("У «%1» немає доступних ресурсів", Построение.Таблица.Объект));
		Возврат;
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		Если Не ДобавитьПоказателиРесурса(Построение, СокрЛП(Имя)) И Не Остановлено(Построение) Тогда
			Остановить(Построение, СтрШаблон("Ресурс «%1» не знайдено або недоступний у «%2». Перелік ресурсів дає describe_object.",
				Лев(Имя, 100), Построение.Таблица.Объект));
		КонецЕсли;
		Если Остановлено(Построение) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ДоступныеРесурсы(Построение)
	// Имена ресурсов виртуальной таблицы, доступных клиенту. Ресурсы с маской (кроме округления)
	// не суммируются и пропускаются с примечанием.

	Имена = Новый Массив;
	Пропущенные = Новый Массив;
	Политика = Построение.Политика;
	Объект = Построение.Таблица.Объект;
	Для Каждого Поле Из Построение.Таблица.Поля Цикл
		Если Поле.Роль <> "resource" Или Имена.Найти(Поле.ПолеПолитики) <> Неопределено
			Или Пропущенные.Найти(Поле.ПолеПолитики) <> Неопределено
			Или Не mcp1c_ПравилаДоступа.ПолеДоступно(Политика, Объект, Поле.ПолеПолитики, Поле.Типы) Тогда
			Продолжить;
		КонецЕсли;
		Маска = mcp1c_ПравилаДоступа.МаскаПоля(Политика, Объект, Поле.ПолеПолитики);
		Если Маска = Неопределено Или Маска.Вид = "round" Тогда
			Имена.Добавить(Поле.ПолеПолитики);
		Иначе
			Пропущенные.Добавить(Поле.ПолеПолитики);
		КонецЕсли;
	КонецЦикла;
	Если Пропущенные.Количество() > 0 Тогда
		Построение.Примечания.Добавить(СтрШаблон("Масковані ресурси не підсумовуються: %1", СтрСоединить(Пропущенные, ", ")));
	КонецЕсли;
	Возврат Имена;

КонецФункции

Функция ДобавитьПоказателиРесурса(Построение, Имя)
	// Добавляет суммы всех показателей ресурса; Ложь - у таблицы нет полей этого ресурса.

	Найдено = Ложь;
	Для Каждого Поле Из Построение.Таблица.Поля Цикл
		Если Поле.Роль <> "resource" Или НРег(Поле.ПолеПолитики) <> НРег(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Разбор = РазобратьПутьКлиента(Построение, Поле.Имя);
		Если Разбор = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Разбор.Маска <> Неопределено И Разбор.Маска.Вид <> "round" Тогда
			Остановить(Построение, СтрШаблон("Ресурс «%1» масковане профілем: підсумовувати його не можна", Имя));
			Возврат Ложь;
		КонецЕсли;
		ДобавитьКолонку(Построение, Разбор, Разбор.Путь, "СУММА", "number");
		Найдено = Истина;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

Функция УсловиеСчетаРегистра(Построение, Счет)
	// Условие на счет для параметра виртуальной таблицы регистра бухгалтерии (субсчета включаются).

	Если Счет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Построение.Таблица.Вид <> "accounting_register" Тогда
		Остановить(Построение, "account задається лише для регістрів бухгалтерії");
		Возврат "";
	КонецЕсли;
	Разбор = РазобратьПутьКлиента(Построение, "Счет");
	Если Разбор = Неопределено Или Не БезМаски(Построение, Разбор, "відбирати") Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Счет) = Тип("Строка") И Не ЭтоУникальныйИдентификатор(СокрЛП(Счет)) Тогда
		Если ПустаяСтрока(Счет) Или СтрДлина(Счет) > 50 Тогда
			Остановить(Построение, "account: очікується код рахунку, наприклад ""361"", або посилання на рахунок");
			Возврат "";
		КонецЕсли;
		Значение = НовоеЗначение("account_code", СокрЛП(Счет));
		Значение.Тип = Построение.Таблица.ПланСчетов;
	Иначе
		Разобранное = РазобратьЗначение(Счет, Разбор.Типы, "account");
		Если Не Разобранное.Успех Тогда
			Остановить(Построение, Разобранное.Ошибка);
			Возврат "";
		КонецЕсли;
		Значение = Разобранное.Значение;
	КонецЕсли;
	Возврат "Счет В ИЕРАРХИИ (&" + ДобавитьПараметр(Построение, Значение) + ")";

КонецФункции

Функция ПараметрыТаблицыОборотов(Таблица, Начало, Конец, Периодичность, УсловиеСчета)
	// Параметры виртуальных таблиц оборотов:
	//  регистр накопления, Обороты - Начало, Конец, Периодичность, Условие;
	//  регистр накопления, ОстаткиИОбороты - Начало, Конец, Периодичность, МетодДополнения, Условие;
	//  регистр бухгалтерии, Обороты - Начало, Конец, Периодичность, УсловиеСчета, Субконто, Условие;
	//  регистр бухгалтерии, ОстаткиИОбороты - Начало, Конец, Периодичность, МетодДополнения, УсловиеСчета,
	//   Субконто, Условие.

	Результат = Новый Массив;
	Результат.Добавить(Начало);
	Результат.Добавить(Конец);
	Результат.Добавить(Периодичность);
	Если Таблица.ВиртуальнаяТаблица = "ОстаткиИОбороты" Тогда
		Результат.Добавить("");
	КонецЕсли;
	Если Таблица.Вид = "accounting_register" Тогда
		Результат.Добавить(УсловиеСчета);
		Результат.Добавить("");
	КонецЕсли;
	Результат.Добавить("{Условие}");
	Возврат Результат;

КонецФункции

Функция КлючевоеСловоПериодичности(Значение)
	// Ключевое слово периодичности виртуальной таблицы; пустая строка - без периодичности,
	// Неопределено - неизвестное значение.

	Варианты = Новый Соответствие;
	Варианты.Вставить("none", "");
	Варианты.Вставить("day", "День");
	Варианты.Вставить("week", "Неделя");
	Варианты.Вставить("month", "Месяц");
	Варианты.Вставить("quarter", "Квартал");
	Варианты.Вставить("year", "Год");
	Возврат Варианты.Получить(Значение);

КонецФункции

#КонецОбласти

#Область Отборы

Процедура ДобавитьОтборы(Построение, Отборы)

	Номер = 0;
	Для Каждого Отбор Из Отборы Цикл
		Если Остановлено(Построение) Тогда
			Возврат;
		КонецЕсли;
		Путь = СтрШаблон("filters[%1]", Формат(Номер, "ЧН=0; ЧГ=0"));
		Номер = Номер + 1;
		Разбор = РазобратьПутьКлиента(Построение, Свойство(Отбор, "field", ""));
		Если Разбор = Неопределено Или Не БезМаски(Построение, Разбор, "фільтрувати") Тогда
			Возврат;
		КонецЕсли;
		Условие = НовоеУсловиеОтбора(Построение, Разбор, Свойство(Отбор, "op", ""), Свойство(Отбор, "value"), Путь + ".value");
		Если Условие = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Условие.ВУсловииТаблицы = ВУсловииВиртуальнойТаблицы(Построение, Разбор);
		Построение.Спецификация.Условия.Добавить(Условие);
	КонецЦикла;

КонецПроцедуры

Функция НовоеУсловиеОтбора(Построение, Разбор, Оператор, Значение, Путь)
	// Условие отбора по оператору из аргументов (п. 5.3 ТЗ).

	Если Оператор = "is_empty" Или Оператор = "not_empty" Тогда
		Пустое = НовоеЗначение("empty");
		Пустое.Типы = Разбор.Типы;
		Параметры = Новый Массив;
		Параметры.Добавить(ДобавитьПараметр(Построение, Пустое));
	ИначеЕсли Оператор = "contains" Или Оператор = "starts_with" Тогда
		Параметры = ПараметрыПодобия(Построение, Разбор, Оператор, Значение, Путь);
	ИначеЕсли Оператор = "between" Тогда
		Параметры = ПараметрыМежду(Построение, Разбор, Значение, Путь);
	ИначеЕсли Оператор = "in" Или Оператор = "not_in" Или Оператор = "in_hierarchy" Тогда
		Параметры = ПараметрыСписка(Построение, Разбор, Оператор, Значение, Путь);
	ИначеЕсли ОператорыСравнения().Найти(Оператор) <> Неопределено Тогда
		Параметры = ПараметрыСравнения(Построение, Разбор, Оператор, Значение, Путь);
	Иначе
		Остановить(Построение, "op: допустимі значення eq, ne, gt, gte, lt, lte, between, in, not_in, in_hierarchy, "
			+ "contains, starts_with, is_empty, not_empty");
		Возврат Неопределено;
	КонецЕсли;
	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, Оператор, Параметры, Ложь,
		Разбор.НеограниченнаяСтрока);

КонецФункции

Функция ПараметрыПодобия(Построение, Разбор, Оператор, Значение, Путь)

	Если Разбор.Типы.Найти("Строка") = Неопределено Тогда
		Остановить(Построение, СтрШаблон("%1 можливе лише для рядкових полів, а «%2» - %3", Оператор, Разбор.Путь,
			СтрСоединить(Разбор.Типы, ", ")));
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Остановить(Построение, Путь + ": очікується непорожній рядок");
		Возврат Неопределено;
	КонецЕсли;
	Шаблон = mcp1c_КонструкторЗапросов.ЭкранироватьДляПодобно(Значение) + "%";
	Если Оператор = "contains" Тогда
		Шаблон = "%" + Шаблон;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Шаблон)));
	Возврат Параметры;

КонецФункции

Функция ПараметрыМежду(Построение, Разбор, Значение, Путь)

	Если ТипЗнч(Значение) <> Тип("Массив") Или Значение.Количество() <> 2 Тогда
		Остановить(Построение, Путь + ": для between очікується масив із двох значень [від, до]");
		Возврат Неопределено;
	КонецЕсли;
	Если Не ДопускаетСравнение(Разбор.Типы) Тогда
		Остановить(Построение, СтрШаблон("between можливе для полів типу число, дата або рядок, а «%1» - %2", Разбор.Путь,
			СтрСоединить(Разбор.Типы, ", ")));
		Возврат Неопределено;
	КонецЕсли;
	Параметры = Новый Массив;
	Для Индекс = 0 По 1 Цикл
		Элемент = ЗначениеДляУсловия(Построение, Значение[Индекс], Разбор.Типы, СтрШаблон("%1[%2]", Путь, Индекс), Индекс = 1);
		Если Элемент = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Параметры.Добавить(ДобавитьПараметр(Построение, Элемент));
	КонецЦикла;
	Возврат Параметры;

КонецФункции

Функция ПараметрыСписка(Построение, Разбор, Оператор, Значение, Путь)

	Если Оператор = "in_hierarchy" И Не ЕстьИерархическийТип(Разбор.Типы) Тогда
		Остановить(Построение, СтрШаблон("in_hierarchy можливе лише для посилань, а «%1» - %2", Разбор.Путь,
			СтрСоединить(Разбор.Типы, ", ")));
		Возврат Неопределено;
	КонецЕсли;
	Список = СписокЗначений(Построение, Значение, Разбор.Типы, Путь);
	Если Список = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(Построение, Список));
	Возврат Параметры;

КонецФункции

Функция ПараметрыСравнения(Построение, Разбор, Оператор, Значение, Путь)

	Если Оператор <> "eq" И Оператор <> "ne" И Не ДопускаетСравнение(Разбор.Типы) Тогда
		Остановить(Построение, СтрШаблон("%1 можливе для полів типу число, дата або рядок, а «%2» - %3", Оператор,
			Разбор.Путь, СтрСоединить(Разбор.Типы, ", ")));
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Остановить(Построение, Путь + ": для кількох значень використовуйте op in");
		Возврат Неопределено;
	КонецЕсли;
	Элемент = ЗначениеДляУсловия(Построение, Значение, Разбор.Типы, Путь, Оператор = "lte" Или Оператор = "gt");
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(Построение, Элемент));
	Возврат Параметры;

КонецФункции

Функция ЗначениеДляУсловия(Построение, Значение, Типы, Путь, ВерхняяГраница)
	// Значение для сравнения. Дата без времени в верхней границе (lte, gt, вторая граница between)
	// означает конец дня.

	Разобранное = РазобратьЗначение(Значение, Типы, Путь);
	Если Не Разобранное.Успех Тогда
		Остановить(Построение, Разобранное.Ошибка);
		Возврат Неопределено;
	КонецЕсли;
	Результат = Разобранное.Значение;
	Если ВерхняяГраница И ТипЗнч(Значение) = Тип("Строка") И ТипЗнч(Результат.Значение) = Тип("Дата")
		И СтрДлина(СокрЛП(Значение)) = 10 Тогда
		Результат.Значение = Результат.Значение + 86399;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция СписокЗначений(Построение, Значение, Типы, Путь)

	Значения = Значение;
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Значения = Новый Массив;
		Значения.Добавить(Значение);
	КонецЕсли;
	Если Значения.Количество() = 0 Или Значения.Количество() > МаксимумЗначенийСписка() Тогда
		Остановить(Построение, СтрШаблон("%1: очікується від 1 до %2 значень", Путь, МаксимумЗначенийСписка()));
		Возврат Неопределено;
	КонецЕсли;

	Список = НовоеЗначение("list");
	Для Индекс = 0 По Значения.ВГраница() Цикл
		Разобранное = РазобратьЗначение(Значения[Индекс], Типы, СтрШаблон("%1[%2]", Путь, Формат(Индекс, "ЧН=0; ЧГ=0")));
		Если Не Разобранное.Успех Тогда
			Остановить(Построение, Разобранное.Ошибка);
			Возврат Неопределено;
		КонецЕсли;
		Список.Элементы.Добавить(Разобранное.Значение);
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция УсловиеПоиска(Построение, Разбор, ТекстПоиска)
	// Условие поиска по строке в поле: подстрока для строк, равенство для чисел из цифр.

	Если Разбор.Типы.Найти("Строка") <> Неопределено Тогда
		Шаблон = "%" + mcp1c_КонструкторЗапросов.ЭкранироватьДляПодобно(ТекстПоиска) + "%";
		Параметры = Новый Массив;
		Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Шаблон)));
		Возврат mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, "contains", Параметры, Ложь,
			Разбор.НеограниченнаяСтрока);
	КонецЕсли;
	Если Разбор.Типы.Количество() = 1 И Разбор.Типы[0] = "Число" И СтрДлина(ТекстПоиска) <= 15
		И mcp1c_Служебный.СостоитИзСимволов(ТекстПоиска, "0123456789") Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(ДобавитьПараметр(Построение, НовоеЗначение("value", Число(ТекстПоиска))));
		Возврат mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, "eq", Параметры);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Процедура ДобавитьОтборПоСсылке(Построение, Путь, ПолноеИмя, Идентификатор)

	Разбор = РазобратьПутьСистемы(Построение, Путь);
	Если Разбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значение = НовоеЗначение("ref");
	Значение.Тип = ПолноеИмя;
	Значение.Идентификатор = Идентификатор;
	Параметры = Новый Массив;
	Параметры.Добавить(ДобавитьПараметр(Построение, Значение));
	Построение.Спецификация.Условия.Добавить(mcp1c_КонструкторЗапросов.НовоеУсловие(Разбор.Выражение, "eq", Параметры));

КонецПроцедуры

Функция ВУсловииВиртуальнойТаблицы(Построение, Разбор)
	// Попадает ли условие в параметр виртуальной таблицы: только условия на измерения (п. 5.2, 7.5 ТЗ).

	Если ПустаяСтрока(Построение.Таблица.ВиртуальнаяТаблица) Тогда
		Возврат Ложь;
	КонецЕсли;
	Корень = mcp1c_ПутиПолей.НайтиПоле(Построение.Таблица, СтрРазделить(Разбор.Путь, ".")[0]);
	Возврат Корень <> Неопределено И Корень.Роль = "dimension";


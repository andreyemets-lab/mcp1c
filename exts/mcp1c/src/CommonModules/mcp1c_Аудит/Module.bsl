///////////////////////////////////////////////////////////////////////////////
// mcp1c_Аудит: журналирование вызовов и событий безопасности (п. 8 ТЗ).
// Каждый запрос, включая отказы, пишется в регистр mcp1c_ЖурналВызовов (по правам роли
// mcp1c_Сервис); ошибки сервера и события безопасности - в журнал регистрации.
// Секреты (токены, хеши) в журналы не попадают.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Записывает итог обработки MCP-запроса в журнал вызовов. Если запись в регистр не удалась,
// итог пишется в журнал регистрации.
//
// Параметры:
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
Процедура ЗаписатьВызов(Контекст) Экспорт

	Попытка
		ЗаписатьВЖурналВызовов(Контекст);
	Исключение
		ЗаписьЖурналаРегистрации("MCP.Ошибка", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось записать журнал вызовов: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьВЖурналРегистрации(Контекст);
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Контекст.ТекстОшибки) Тогда
		ЗаписатьВЖурналРегистрации(Контекст);
	КонецЕсли;

КонецПроцедуры

// Результат вызова для журнала по кодам ответа.
//
// Параметры:
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  ПеречислениеСсылка.mcp1c_РезультатыВызовов - результат.
//
Функция РезультатВызова(Контекст) Экспорт

	Результаты = Перечисления.mcp1c_РезультатыВызовов;
	Код = Контекст.КодHTTP;
	Если Код = 401 Тогда
		Возврат Результаты.ОтказАутентификации;
	ИначеЕсли Код = 403 Тогда
		Возврат Результаты.ОтказДоступа;
	ИначеЕсли Код = 429 Тогда
		Возврат Результаты.ПревышениеЛимита;
	ИначеЕсли Код = 503 Тогда
		Возврат Результаты.СерверНедоступен;
	ИначеЕсли Код >= 500 Или Контекст.КодRPC = -32603 Тогда
		Возврат Результаты.ВнутренняяОшибка;
	ИначеЕсли Контекст.ОтказДоступа Тогда
		// Отказ политики - и в результате инструмента, и в ошибке JSON-RPC при чтении ресурса.
		Возврат Результаты.ОтказДоступа;
	ИначеЕсли Код >= 400 Или Контекст.КодRPC <> 0 Тогда
		Возврат Результаты.ОшибкаЗапроса;
	ИначеЕсли Контекст.ОшибкаИнструмента Тогда
		Возврат Результаты.ОшибкаИнструмента;
	КонецЕсли;
	Возврат Результаты.Успех;

КонецФункции

// Записывает итог обработки MCP-запроса в журнал регистрации.
//
// Параметры:
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
Процедура ЗаписатьВЖурналРегистрации(Контекст) Экспорт

	Данные = Новый Соответствие;
	Данные.Вставить("requestId", Контекст.ИдентификаторЗапроса);
	Данные.Вставить("http", Контекст.КодHTTP);
	Если Контекст.КодRPC <> 0 Тогда
		Данные.Вставить("rpcError", Контекст.КодRPC);
	КонецЕсли;
	ДобавитьЕслиЗаполнено(Данные, "method", Контекст.МетодRPC);
	ДобавитьЕслиЗаполнено(Данные, "tool", Контекст.Инструмент);
	ДобавитьЕслиЗаполнено(Данные, "client", Контекст.Клиент);
	ДобавитьЕслиЗаполнено(Данные, "tokenId", Контекст.ИдентификаторТокена);
	ДобавитьЕслиЗаполнено(Данные, "ip", Контекст.IP);
	ДобавитьЕслиЗаполнено(Данные, "origin", Контекст.Origin);
	ДобавитьЕслиЗаполнено(Данные, "clientInfo", Контекст.ИнформацияКлиента);
	ДобавитьЕслиЗаполнено(Данные, "protocol", Контекст.ВерсияПротокола);
	ДобавитьЕслиЗаполнено(Данные, "reason", Контекст.Причина);
	Если Контекст.ОшибкаИнструмента Тогда
		Данные.Вставить("toolError", Истина);
	КонецЕсли;
	Данные.Вставить("durationMs", Контекст.ДлительностьМс);

	Уровень = УровеньЖурналаРегистрации.Информация;
	Если Контекст.КодHTTP >= 500 Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Контекст.КодHTTP >= 400 Или Контекст.ОшибкаИнструмента Тогда
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;

	Комментарий = mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Данные);
	Если ЗначениеЗаполнено(Контекст.ТекстОшибки) Тогда
		Комментарий = Комментарий + Символы.ПС + Контекст.ТекстОшибки;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("MCP.Вызов", Уровень, , , Комментарий);

КонецПроцедуры

// Записывает событие безопасности (отказ, подозрительный запрос, перенос ИБ).
//
// Параметры:
//  Описание - Строка - краткое описание.
//  Подробности - Строка - дополнительные сведения.
//
Процедура ЗаписатьСобытиеБезопасности(Описание, Подробности = "") Экспорт

	ЗаписьЖурналаРегистрации("MCP.Безопасность", УровеньЖурналаРегистрации.Предупреждение, , ,
		ТекстСобытия(Описание, Подробности));

КонецПроцедуры

// Записывает событие жизненного цикла токенов (выпуск, отзыв, удаление).
//
// Параметры:
//  Описание - Строка - описание события; секреты токенов не передаются.
//
Процедура ЗаписатьСобытиеТокенов(Описание) Экспорт

	ЗаписьЖурналаРегистрации("MCP.Токены", УровеньЖурналаРегистрации.Информация, , , Описание);

КонецПроцедуры

// Записывает изменение настроек сервера.
//
// Параметры:
//  Описание - Строка - что изменено.
//
Процедура ЗаписатьИзменениеНастроек(Описание) Экспорт

	ЗаписьЖурналаРегистрации("MCP.Настройки", УровеньЖурналаРегистрации.Информация, , , Описание);

КонецПроцедуры

// Записывает ошибку сервера.
//
// Параметры:
//  Описание - Строка - краткое описание.
//  Подробности - Строка - подробное представление ошибки.
//
Процедура ЗаписатьОшибку(Описание, Подробности = "") Экспорт

	ЗаписьЖурналаРегистрации("MCP.Ошибка", УровеньЖурналаРегистрации.Ошибка, , ,
		ТекстСобытия(Описание, Подробности));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьВЖурналВызовов(Контекст)

	Запись = РегистрыСведений.mcp1c_ЖурналВызовов.СоздатьМенеджерЗаписи();
	Запись.Момент = Контекст.Момент;
	Запись.ИдентификаторЗапроса = Контекст.ИдентификаторЗапроса;
	Если ЗначениеЗаполнено(Контекст.КлиентСсылка) Тогда
		Запись.Клиент = Контекст.КлиентСсылка;
	КонецЕсли;
	Запись.ИдентификаторТокена = Лев(Контекст.ИдентификаторТокена, 12);
	Запись.АдресКлиента = Лев(Контекст.IP, 45);
	Запись.ИнформацияКлиента = Лев(Контекст.ИнформацияКлиента, 200);
	Запись.ВерсияПротокола = Лев(Контекст.ВерсияПротокола, 10);
	Запись.Метод = Лев(Контекст.МетодRPC, 50);
	Запись.Инструмент = Лев(Контекст.Инструмент, 100);
	Запись.Аргументы = Контекст.Аргументы;
	Запись.Объекты = Лев(СтрСоединить(Контекст.Объекты, ", "), 1000);
	Запись.Результат = РезультатВызова(Контекст);
	Запись.КодСостояния = Мин(Макс(Контекст.КодHTTP, 0), 999);
	Запись.КодОшибки = Контекст.КодRPC;
	Запись.Причина = Лев(Контекст.Причина, 500);
	Запись.КоличествоСтрок = Контекст.КоличествоСтрок;
	Запись.РазмерОтвета = Контекст.РазмерОтвета;
	Запись.ДлительностьМс = Макс(Контекст.ДлительностьМс, 0);
	Запись.Записать(Истина);

КонецПроцедуры

Процедура ДобавитьЕслиЗаполнено(Данные, Ключ, Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		Данные.Вставить(Ключ, Значение);
	КонецЕсли;

КонецПроцедуры

Функция ТекстСобытия(Описание, Подробности)

	Если ПустаяСтрока(Подробности) Тогда
		Возврат Описание;
	КонецЕсли;
	Возврат Описание + Символы.ПС + Подробности;

КонецФункции

#КонецОбласти

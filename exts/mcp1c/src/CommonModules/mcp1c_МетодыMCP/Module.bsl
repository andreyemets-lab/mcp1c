///////////////////////////////////////////////////////////////////////////////
// mcp1c_МетодыMCP: методы MCP после аутентификации (п. 4-5 ТЗ) - tools/list, tools/call,
// resources/list, resources/templates/list, resources/read, prompts/list, prompts/get.
//
// Вызов идет в два шага. Подготовить разбирает params: что будет выполнено и какие лимиты это
// расходует. ВыполнитьВызов получает результат или ошибку JSON-RPC. Между шагами транспорт
// (mcp1c_Протокол) проверяет частоту вызовов и квоту строк; песочница администратора
// (mcp1c_Песочница) выполняет те же шаги без расхода лимитов, поэтому модель и администратор
// получают один и тот же ответ.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Методы, которые выполняет модуль.
//
// Возвращаемое значение:
//  Массив из Строка - методы JSON-RPC.
//
Функция Методы() Экспорт

	Возврат СтрРазделить("tools/list,tools/call,resources/list,resources/templates/list,resources/read,"
		+ "prompts/list,prompts/get", ",");

КонецФункции

// Разбирает params метода: какой инструмент, ресурс или промпт будет выполнен и какие лимиты
// это расходует. Ничего не выполняет; политика клиента уже загружена в контекст.
//
// Параметры:
//  Метод - Строка - метод из Методы().
//  Параметры - Соответствие из КлючИЗначение - params сообщения.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  см. НовыйВызов
//
Функция Подготовить(Метод, Параметры, Контекст) Экспорт

	Вызов = НовыйВызов(Метод);
	Если Метод = "tools/call" Тогда
		ПодготовитьВызовИнструмента(Вызов, Параметры, Контекст);
	ИначеЕсли Метод = "resources/read" Тогда
		ПодготовитьЧтениеРесурса(Вызов, Параметры, Контекст);
	ИначеЕсли Метод = "prompts/get" Тогда
		ПодготовитьПолучениеПромпта(Вызов, Параметры, Контекст);
	ИначеЕсли Методы().Найти(Метод) = Неопределено Тогда
		УстановитьОшибку(Вызов, КодМетодНеНайден(), "Method not found: " + Лев(Метод, 100));
	КонецЕсли;
	Возврат Вызов;

КонецФункции

// Выполняет подготовленный вызов.
//
// Параметры:
//  Вызов - см. НовыйВызов
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  см. НовыйИтог
//
Функция ВыполнитьВызов(Вызов, Контекст) Экспорт

	Итог = НовыйИтог(Вызов.КодОшибки, Вызов.СообщениеОшибки, Вызов.ДанныеОшибки);
	Если Вызов.КодОшибки <> 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Политика = Контекст.Политика;
	Метод = Вызов.Метод;
	Если Метод = "tools/list" Тогда
		Итог.Результат = РезультатСписка("tools", mcp1c_Инструменты.ОписанияИнструментов(Политика), Контекст);
	ИначеЕсли Метод = "tools/call" Тогда
		Итог.Результат = mcp1c_Инструменты.Вызвать(Вызов.Имя, Вызов.Аргументы, Контекст);
		Контекст.ОшибкаИнструмента = (Итог.Результат.Получить("isError") = Истина);
	ИначеЕсли Метод = "resources/list" Тогда
		Итог.Результат = РезультатСписка("resources", mcp1c_ОписанияРесурсов.ОписанияРесурсов(Политика), Контекст);
	ИначеЕсли Метод = "resources/templates/list" Тогда
		Итог.Результат = РезультатСписка("resourceTemplates", mcp1c_ОписанияРесурсов.ШаблоныРесурсов(Политика),
			Контекст);
	ИначеЕсли Метод = "resources/read" Тогда
		ПрочитатьРесурс(Итог, Вызов, Контекст);
	ИначеЕсли Метод = "prompts/list" Тогда
		Итог.Результат = РезультатСписка("prompts", mcp1c_РесурсыИПромпты.СписокПромптов(Политика), Контекст);
	ИначеЕсли Метод = "prompts/get" Тогда
		Промпт = mcp1c_РесурсыИПромпты.ПолучитьПромпт(Вызов.Имя, Вызов.Аргументы, Политика);
		Если ПустаяСтрока(Промпт.Ошибка) Тогда
			Итог.Результат = Промпт.Результат;
		Иначе
			Контекст.Причина = Промпт.Ошибка;
			Итог.КодОшибки = КодНекорректныеПараметры();
			Итог.СообщениеОшибки = Промпт.Ошибка;
		КонецЕсли;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Итог выполнения вызова: result или ошибка JSON-RPC.
//
// Параметры:
//  КодОшибки - Число - код ошибки JSON-RPC; 0 - результат получен.
//  СообщениеОшибки - Строка - message ошибки.
//  ДанныеОшибки - Неопределено, Соответствие из КлючИЗначение - data ошибки.
//
// Возвращаемое значение:
//  Структура:
//   * Результат - Соответствие из КлючИЗначение - result ответа; пустое при ошибке.
//   * КодОшибки - Число - код ошибки JSON-RPC; 0 - результат получен.
//   * СообщениеОшибки - Строка - message ошибки.
//   * ДанныеОшибки - Неопределено, Соответствие из КлючИЗначение - data ошибки.
//
Функция НовыйИтог(КодОшибки = 0, СообщениеОшибки = "", ДанныеОшибки = Неопределено) Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Результат", Новый Соответствие);
	Итог.Вставить("КодОшибки", КодОшибки);
	Итог.Вставить("СообщениеОшибки", СообщениеОшибки);
	Итог.Вставить("ДанныеОшибки", ДанныеОшибки);
	Возврат Итог;

КонецФункции

// Разобранный вызов метода.
//
// Параметры:
//  Метод - Строка - метод JSON-RPC.
//
// Возвращаемое значение:
//  Структура:
//   * Метод - Строка - метод.
//   * КодОшибки - Число - код ошибки JSON-RPC, найденной при разборе; 0 - ошибки нет.
//   * СообщениеОшибки - Строка - message ошибки.
//   * ДанныеОшибки - Неопределено, Соответствие из КлючИЗначение - data ошибки.
//   * РасходуетЧастоту - Булево - вызов учитывается в частоте вызовов клиента.
//   * РасходуетКвоту - Булево - вызов расходует суточную квоту строк.
//   * Имя - Строка - инструмент или промпт.
//   * Аргументы - Произвольный, Неопределено - arguments.
//   * URI - Строка - uri ресурса.
//   * Разбор - см. mcp1c_ОписанияРесурсов.РазобратьURI
//
Функция НовыйВызов(Метод) Экспорт

	Вызов = Новый Структура;
	Вызов.Вставить("Метод", Метод);
	Вызов.Вставить("КодОшибки", 0);
	Вызов.Вставить("СообщениеОшибки", "");
	Вызов.Вставить("ДанныеОшибки", Неопределено);
	Вызов.Вставить("РасходуетЧастоту", Ложь);
	Вызов.Вставить("РасходуетКвоту", Ложь);
	Вызов.Вставить("Имя", "");
	Вызов.Вставить("Аргументы", Неопределено);
	Вызов.Вставить("URI", "");
	Вызов.Вставить("Разбор", Неопределено);
	Возврат Вызов;

КонецФункции

// Код JSON-RPC «Method not found».
//
// Возвращаемое значение:
//  Число - -32601.
//
Функция КодМетодНеНайден() Экспорт

	Возврат -32601;

КонецФункции

// Код JSON-RPC «Invalid params».
//
// Возвращаемое значение:
//  Число - -32602.
//
Функция КодНекорректныеПараметры() Экспорт

	Возврат -32602;

КонецФункции

// Код JSON-RPC «Internal error».
//
// Возвращаемое значение:
//  Число - -32603.
//
Функция КодВнутренняяОшибка() Экспорт

	Возврат -32603;

КонецФункции

// Код «Resource not found» в редакциях 2025-06-18 и 2025-11-25; в 2026-07-28 - -32602.
//
// Возвращаемое значение:
//  Число - -32002.
//
Функция КодРесурсНеНайденДо20260728() Экспорт

	Возврат -32002;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьВызовИнструмента(Вызов, Параметры, Контекст)
	// tools/call: инструмент, не разрешенный профилем, не отличается от несуществующего.

	Имя = Параметры.Получить("name");
	Если ТипЗнч(Имя) <> Тип("Строка") Или mcp1c_Инструменты.ОписаниеИнструмента(Имя, Контекст.Политика) = Неопределено Тогда
		Контекст.Инструмент = ?(ТипЗнч(Имя) = Тип("Строка"), Лев(Имя, 100), "");
		УстановитьОшибку(Вызов, КодНекорректныеПараметры(), "Unknown tool: " + Контекст.Инструмент);
		Возврат;
	КонецЕсли;
	Контекст.Инструмент = Имя;
	Вызов.Имя = Имя;

	Аргументы = Параметры.Получить("arguments");
	Если Аргументы <> Неопределено И ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		УстановитьОшибку(Вызов, КодНекорректныеПараметры(), "Invalid params: arguments must be an object");
		Возврат;
	КонецЕсли;
	Вызов.Аргументы = Аргументы;
	Вызов.РасходуетЧастоту = Истина;
	Вызов.РасходуетКвоту = РасходуетКвотуСтрок(Имя);

КонецПроцедуры

Процедура ПодготовитьЧтениеРесурса(Вызов, Параметры, Контекст)
	// resources/read: ресурс - представление инструмента, квоту расходует как инструмент.

	URI = Параметры.Получить("uri");
	Если ТипЗнч(URI) <> Тип("Строка") Или ПустаяСтрока(URI) Тогда
		УстановитьОшибку(Вызов, КодНекорректныеПараметры(), "Invalid params: uri must be a non-empty string");
		Возврат;
	КонецЕсли;
	Разбор = mcp1c_ОписанияРесурсов.РазобратьURI(URI);
	Контекст.Инструмент = Лев(mcp1c_ОписанияРесурсов.ПредставлениеURI(Разбор, URI), 100);
	Вызов.URI = URI;
	Вызов.Разбор = Разбор;
	Вызов.РасходуетЧастоту = Истина;
	Вызов.РасходуетКвоту = РасходуетКвотуСтрок(mcp1c_ОписанияРесурсов.ИнструментРесурса(Разбор));

КонецПроцедуры

Процедура ПодготовитьПолучениеПромпта(Вызов, Параметры, Контекст)
	// prompts/get: аргументы промпта проверяет mcp1c_РесурсыИПромпты; квоту строк промпт не расходует.

	Имя = Параметры.Получить("name");
	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
		УстановитьОшибку(Вызов, КодНекорректныеПараметры(), "Invalid params: name must be a non-empty string");
		Возврат;
	КонецЕсли;
	Контекст.Инструмент = Лев(Имя, 100);
	Вызов.Имя = Имя;
	Вызов.Аргументы = Параметры.Получить("arguments");
	mcp1c_Инструменты.ЗапомнитьАргументы(Вызов.Аргументы, Контекст);
	Вызов.РасходуетЧастоту = Истина;

КонецПроцедуры

Процедура ПрочитатьРесурс(Итог, Вызов, Контекст)
	// resources/read (п. 5.6 ТЗ): ресурс не найден или недоступен - -32602 (до 2026-07-28 - -32002).

	Чтение = mcp1c_РесурсыИПромпты.ПрочитатьРесурс(Вызов.URI, Вызов.Разбор, Контекст);
	Если Чтение.ВнутренняяОшибка Тогда
		Итог.КодОшибки = КодВнутренняяОшибка();
		Итог.СообщениеОшибки = "Internal error";
		Итог.ДанныеОшибки = ДанныеКорреляции(Контекст);
		Возврат;
	КонецЕсли;
	Если Не Чтение.Успех Тогда
		Если ПустаяСтрока(Контекст.Причина) Тогда
			Контекст.Причина = "Ресурс не прочитан: " + Чтение.Причина;
		КонецЕсли;
		Данные = Новый Соответствие;
		Данные.Вставить("uri", Лев(Вызов.URI, 2000));
		Если Не ПустаяСтрока(Чтение.Причина) Тогда
			Данные.Вставить("reason", Чтение.Причина);
		КонецЕсли;
		// Ресурс, недоступный профилю, не отличается от несуществующего.
		Итог.КодОшибки = ?(Контекст.Эпоха = "modern", КодНекорректныеПараметры(), КодРесурсНеНайденДо20260728());
		Итог.СообщениеОшибки = "Resource not found";
		Итог.ДанныеОшибки = Данные;
		Возврат;
	КонецЕсли;

	Результат = Новый Соответствие;
	Результат.Вставить("contents", Чтение.Содержимое);
	ДобавитьПодсказкиКеширования(Результат, mcp1c_ОписанияРесурсов.СрокКешированияРесурса(Вызов.Разбор,
		СрокКешированияСписков(Контекст.Настройки)), Контекст);
	Итог.Результат = Результат;

КонецПроцедуры

Функция РезультатСписка(Ключ, Элементы, Контекст)
	// Результат списка с подсказкой кеширования.

	Результат = Новый Соответствие;
	Результат.Вставить(Ключ, Элементы);
	ДобавитьПодсказкиКеширования(Результат, СрокКешированияСписков(Контекст.Настройки), Контекст);
	Возврат Результат;

КонецФункции

Процедура ДобавитьПодсказкиКеширования(Результат, СрокМс, Контекст)
	// ttlMs и cacheScope (MCP 2026-07-28, Caching): списки и ресурсы зависят от профиля клиента.

	Если Контекст.Эпоха = "modern" Тогда
		Результат.Вставить("ttlMs", СрокМс);
		Результат.Вставить("cacheScope", "private");
	КонецЕсли;

КонецПроцедуры

Функция СрокКешированияСписков(Настройки)
	// Подсказка ttlMs для списков; по спецификации - не меньше 0.

	Срок = mcp1c_Служебный.СвойствоЧисло(Настройки, "listTtlMs", 300000);
	Возврат ?(Срок > 0, Срок, 0);

КонецФункции

Функция РасходуетКвотуСтрок(Инструмент)
	// Инструменты метаданных суточную квоту строк не расходуют.

	Возврат Не ПустаяСтрока(Инструмент)
		И СтрРазделить("get_context,list_objects,describe_object", ",").Найти(Инструмент) = Неопределено;

КонецФункции

Процедура УстановитьОшибку(Вызов, Код, Сообщение)

	Вызов.КодОшибки = Код;
	Вызов.СообщениеОшибки = Сообщение;

КонецПроцедуры

Функция ДанныеКорреляции(Контекст)

	Данные = Новый Соответствие;
	Данные.Вставить("requestId", Контекст.ИдентификаторЗапроса);
	Возврат Данные;

КонецФункции

#КонецОбласти

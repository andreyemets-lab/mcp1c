///////////////////////////////////////////////////////////////////////////////
// mcp1c_ПравилаДоступа: правила профиля доступа (п. 7.3-7.6 ТЗ) - инструменты, объекты,
// поля и маски, ограничения строк с параметрами и глобальные запреты.
//
// Политика - структура данных (см. НоваяПолитика), которую заполняет mcp1c_Политики
// из справочников; модуль только вычисляет решения. По умолчанию запрещено все:
// объект доступен, только если его разрешает правило профиля и он не попал
// в глобальные запреты. Режим объекта: read - чтение записей, aggregates - только
// группировки и агрегаты с минимальным размером группы, deny - запрещено.
// Действие правила поля: allow, deny или mask (поле видно замаскированным, см. mcp1c_Маскирование).
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Конструкторы

// Пустая политика: все запрещено.
//
// Возвращаемое значение:
//  Структура:
//   * Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - клиент доступа; Неопределено до аутентификации.
//   * ИмяКлиента - Строка - наименование клиента.
//   * Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа, Неопределено - профиль клиента; Неопределено, если профиля
//               нет или он помечен на удаление.
//   * ИмяПрофиля - Строка - наименование профиля.
//   * ВерсияПрофиля - Число - версия профиля.
//   * Инструменты - Массив из Строка - разрешенные инструменты; пустой массив - встроенные инструменты чтения.
//   * Объекты - Массив из см. НовоеПравилоОбъекта - правила объектов.
//   * Поля - Массив из см. НовоеПравилоПоля - правила полей.
//   * ОграниченияСтрок - Массив из см. НовоеОграничениеСтрок - ограничения строк.
//   * ЗапрещенныеПоля - Массив из Строка - шаблоны имен глобально запрещенных полей.
//   * ЗапрещенныеОбъекты - Массив из Строка - шаблоны полных имен глобально запрещенных объектов.
//   * НедоступныеОбъекты - Соответствие из КлючИЗначение - объекты, которые не может читать
//                          привязанный к клиенту пользователь ИБ (верхняя граница прав, п. 7.1 ТЗ):
//     ** Ключ - Строка - полное имя объекта в нижнем регистре.
//     ** Значение - Булево - Истина.
//   * Лимиты - см. НовыеЛимиты
//   * РазрешитьПомеченныеНаУдаление - Булево - можно запрашивать помеченные на удаление.
//   * СольМаскирования - Строка - соль профиля для хеш-маски; клиенту не показывается.
//   * ПараметрыПрофиля - Соответствие из КлючИЗначение - параметры профиля для ограничений строк:
//     ** Ключ - Строка - имя параметра в нижнем регистре.
//     ** Значение - см. НовыйПараметрПрофиля
//   * ЗначенияПараметров - Соответствие из КлючИЗначение - значения параметров, заданные в клиенте:
//     ** Ключ - Строка - имя параметра в нижнем регистре.
//     ** Значение - Массив из Произвольный - значения (см. НовоеЗначениеПараметра).
//   * ПользовательскиеИнструменты - Соответствие из КлючИЗначение - инструменты администратора,
//                                   назначенные профилю (п. 5.5 ТЗ):
//     ** Ключ - Строка - имя инструмента.
//     ** Значение - см. mcp1c_ПользовательскиеИнструменты.НовоеОпределение
//
Функция НоваяПолитика() Экспорт

	Политика = Новый Структура;
	Политика.Вставить("Клиент", Неопределено);
	Политика.Вставить("ИмяКлиента", "");
	Политика.Вставить("Профиль", Неопределено);
	Политика.Вставить("ИмяПрофиля", "");
	Политика.Вставить("ВерсияПрофиля", 0);
	Политика.Вставить("Инструменты", Новый Массив);
	Политика.Вставить("Объекты", Новый Массив);
	Политика.Вставить("Поля", Новый Массив);
	Политика.Вставить("ОграниченияСтрок", Новый Массив);
	Политика.Вставить("ЗапрещенныеПоля", Новый Массив);
	Политика.Вставить("ЗапрещенныеОбъекты", Новый Массив);
	Политика.Вставить("НедоступныеОбъекты", Новый Соответствие);
	Политика.Вставить("Лимиты", НовыеЛимиты());
	Политика.Вставить("РазрешитьПомеченныеНаУдаление", Ложь);
	Политика.Вставить("СольМаскирования", "");
	Политика.Вставить("ПараметрыПрофиля", Новый Соответствие);
	Политика.Вставить("ЗначенияПараметров", Новый Соответствие);
	Политика.Вставить("ПользовательскиеИнструменты", Новый Соответствие);
	Возврат Политика;

КонецФункции

// Лимиты по умолчанию (п. 7.3 ТЗ).
//
// Возвращаемое значение:
//  Структура:
//   * СтрокЗаВызов - Число - максимум строк в ответе инструмента.
//   * ВызововВМинуту - Число - частота вызовов клиента.
//   * СтрокВСутки - Число - суточная квота строк.
//   * ГлубинаПериодаДней - Число - максимальная длина периода.
//   * РазмерОтветаБайт - Число - предельный размер структурированного результата.
//   * ГлубинаРазыменования - Число - сколько точек допускается в пути поля.
//
Функция НовыеЛимиты() Экспорт

	Лимиты = Новый Структура;
	Лимиты.Вставить("СтрокЗаВызов", 50);
	Лимиты.Вставить("ВызововВМинуту", 30);
	Лимиты.Вставить("СтрокВСутки", 20000);
	Лимиты.Вставить("ГлубинаПериодаДней", 366);
	Лимиты.Вставить("РазмерОтветаБайт", 102400);
	Лимиты.Вставить("ГлубинаРазыменования", 2);
	Возврат Лимиты;

КонецФункции

// Максимальные значения лимитов, которые не может превысить ни один профиль (п. 7.3 ТЗ).
//
// Возвращаемое значение:
//  см. НовыеЛимиты
//
Функция ПредельныеЛимиты() Экспорт

	Лимиты = Новый Структура;
	Лимиты.Вставить("СтрокЗаВызов", 1000);
	Лимиты.Вставить("ВызововВМинуту", 600);
	Лимиты.Вставить("СтрокВСутки", 10000000);
	Лимиты.Вставить("ГлубинаПериодаДней", 36600);
	Лимиты.Вставить("РазмерОтветаБайт", 4194304);
	Лимиты.Вставить("ГлубинаРазыменования", 5);
	Возврат Лимиты;

КонецФункции

// Устанавливает лимит профиля: положительное значение заменяет значение по умолчанию,
// но не превышает предельное (см. ПредельныеЛимиты).
//
// Параметры:
//  Лимиты - см. НовыеЛимиты
//  Имя - Строка - имя лимита.
//  Значение - Число - значение из профиля; 0 или пустое - оставить значение по умолчанию.
//
Процедура УстановитьЛимит(Лимиты, Имя, Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение <= 0 Тогда
		Возврат;
	КонецЕсли;
	Лимиты[Имя] = Мин(Цел(Значение), ПредельныеЛимиты()[Имя]);

КонецПроцедуры

// Уменьшает лимит: клиент может только сузить лимиты профиля (п. 7.1 ТЗ).
//
// Параметры:
//  Лимиты - см. НовыеЛимиты
//  Имя - Строка - имя лимита.
//  Значение - Число - значение из клиента; 0 или пустое - не ограничивать дополнительно.
//
Процедура УменьшитьЛимит(Лимиты, Имя, Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение <= 0 Тогда
		Возврат;
	КонецЕсли;
	Лимиты[Имя] = Мин(Лимиты[Имя], Цел(Значение));

КонецПроцедуры

// Правило доступа к объекту.
//
// Параметры:
//  Шаблон - Строка - полное имя объекта ("Справочник.Контрагенты"), шаблон ("Документ.*") или "*".
//  Режим - Строка - "read" (чтение), "aggregates" (только агрегаты) или "deny" (запрещено).
//  ТолькоРазрешенныеПоля - Булево - доступны только поля, явно разрешенные правилами полей.
//  ОбязательныйФильтрПериода - Булево - выборки из объекта требуют отбор по периоду.
//
// Возвращаемое значение:
//  Структура:
//   * Шаблон - Строка - полное имя или шаблон.
//   * Режим - Строка - "read", "aggregates" или "deny".
//   * ТолькоРазрешенныеПоля - Булево - политика полей.
//   * ОбязательныйФильтрПериода - Булево - требуется отбор по периоду.
//   * МинимальныйРазмерГруппы - Число - для режима aggregates: группы с меньшим числом записей
//                               не выдаются; 0 - МинимальныйРазмерГруппыПоУмолчанию.
//
Функция НовоеПравилоОбъекта(Шаблон, Режим = "read", ТолькоРазрешенныеПоля = Ложь,
	ОбязательныйФильтрПериода = Ложь) Экспорт

	Правило = Новый Структура;
	Правило.Вставить("Шаблон", СокрЛП(Шаблон));
	Правило.Вставить("Режим", Режим);
	Правило.Вставить("ТолькоРазрешенныеПоля", ТолькоРазрешенныеПоля);
	Правило.Вставить("ОбязательныйФильтрПериода", ОбязательныйФильтрПериода);
	Правило.Вставить("МинимальныйРазмерГруппы", 0);
	Возврат Правило;

КонецФункции

// Правило доступа к полю.
//
// Параметры:
//  Объект - Строка - полное имя объекта или шаблон.
//  Поле - Строка - имя поля, имя табличной части или ТабличнаяЧасть.Поле.
//  Действие - Строка - "allow", "deny" или "mask".
//  ВидМаски - Строка - для mask: full, partial, hash или round (см. mcp1c_Маскирование.НоваяМаска).
//  ПараметрМаски - Число - для mask: число видимых символов или шаг округления; 0 - по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * Объект - Строка - полное имя объекта или шаблон.
//   * Поле - Строка - путь поля.
//   * Действие - Строка - "allow", "deny" или "mask".
//   * ВидМаски - Строка - вид маски для mask.
//   * ПараметрМаски - Число - параметр маски.
//
Функция НовоеПравилоПоля(Объект, Поле, Действие, ВидМаски = "", ПараметрМаски = 0) Экспорт

	Правило = Новый Структура;
	Правило.Вставить("Объект", СокрЛП(Объект));
	Правило.Вставить("Поле", СокрЛП(Поле));
	Правило.Вставить("Действие", Действие);
	Правило.Вставить("ВидМаски", ВидМаски);
	Правило.Вставить("ПараметрМаски", ?(ТипЗнч(ПараметрМаски) = Тип("Число"), ПараметрМаски, 0));
	Возврат Правило;

КонецФункции

// Ограничение строк объекта (п. 7.5 ТЗ). Ограничения одного поля с видом "eq"
// и "in_hierarchy" объединяются через ИЛИ, "ne" - через И; ограничения разных полей - через И.
// Значение задается в профиле или берется из параметра профиля, значения которого
// заданы в клиенте (см. ПодставитьПараметры).
//
// Параметры:
//  Объект - Строка - полное имя объекта.
//  Поле - Строка - поле объекта.
//  ВидСравнения - Строка - "eq", "ne", "in_hierarchy" или "invalid" (ошибка настройки - доступ закрыт).
//  Значение - Произвольный - значение в формате JSON аргументов инструментов (разобранное).
//  Комментарий - Строка - пояснение администратора.
//  Параметр - Строка - имя параметра профиля, из которого берется значение; пустая строка - значение задано.
//
// Возвращаемое значение:
//  Структура:
//   * Объект - Строка - полное имя объекта.
//   * Поле - Строка - поле объекта.
//   * ВидСравнения - Строка - "eq", "ne", "in_hierarchy" или "invalid".
//   * Значение - Произвольный - значение JSON.
//   * Комментарий - Строка - пояснение.
//   * Параметр - Строка - имя параметра профиля.
//   * Ошибка - Строка - причина, по которой ограничение нельзя применить (для журнала).
//
Функция НовоеОграничениеСтрок(Объект, Поле, ВидСравнения, Значение, Комментарий = "", Параметр = "") Экспорт

	Ограничение = Новый Структура;
	Ограничение.Вставить("Объект", СокрЛП(Объект));
	Ограничение.Вставить("Поле", СокрЛП(Поле));
	Ограничение.Вставить("ВидСравнения", ВидСравнения);
	Ограничение.Вставить("Значение", Значение);
	Ограничение.Вставить("Комментарий", Комментарий);
	Ограничение.Вставить("Параметр", СокрЛП(Параметр));
	Ограничение.Вставить("Ошибка", "");
	Возврат Ограничение;

КонецФункции

// Параметр профиля (п. 7.3 ТЗ): значения задаются в клиенте и подставляются в ограничения строк.
//
// Параметры:
//  Имя - Строка - имя параметра, например РазрешенныеОрганизации.
//  Типы - Строка - допустимые типы значений через запятую: полные имена объектов (класс можно
//         по-английски: Catalog.Организации), Строка, Число, Дата, Булево (или String, Number, Date,
//         Boolean); пустая строка - любые (тип все равно сверяется с типом поля ограничения).
//  Описание - Строка - пояснение администратора.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя параметра.
//   * Типы - Массив из Строка - допустимые типы с русскими именами классов и примитивных типов.
//   * Описание - Строка - пояснение.
//
Функция НовыйПараметрПрофиля(Имя, Типы = "", Описание = "") Экспорт

	Параметр = Новый Структура;
	Параметр.Вставить("Имя", СокрЛП(Имя));
	Параметр.Вставить("Типы", ТипыПараметра(Типы));
	Параметр.Вставить("Описание", Описание);
	Возврат Параметр;

КонецФункции

// Типы значения параметра профиля или пользовательского инструмента из строки администратора.
//
// Параметры:
//  Типы - Строка - типы через запятую: полные имена объектов (класс можно по-английски:
//         Catalog.Организации), Строка, Число, Дата, Булево (или String, Number, Date, Boolean).
//
// Возвращаемое значение:
//  Массив из Строка - типы с русскими именами классов и примитивных типов.
//
Функция ТипыПараметра(Типы) Экспорт

	Примитивные = ПримитивныеТипыПараметров();
	Результат = Новый Массив;
	Для Каждого ИмяТипа Из СтрРазделить(Типы, ",", Ложь) Цикл
		ИмяТипа = СокрЛП(ИмяТипа);
		Если ПустаяСтрока(ИмяТипа) Тогда
			Продолжить;
		КонецЕсли;
		Примитивный = Примитивные.Получить(НРег(ИмяТипа));
		Результат.Добавить(?(Примитивный = Неопределено, mcp1c_ЗапросыДанных.НормализованноеИмяТипа(ИмяТипа),
			Примитивный));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Значение параметра профиля, заданное в клиенте.
//
// Параметры:
//  Значение - Произвольный - значение в формате JSON аргументов: {"type", "ref"}, {"type", "value"}
//             для перечисления, строка, число, булево, дата строкой ISO 8601.
//  ИмяТипа - Строка - тип значения: полное имя объекта, Строка, Число, Дата или Булево.
//  Ошибка - Строка - значение задано некорректно (пустое, неподдерживаемого типа); пустая строка - корректно.
//
// Возвращаемое значение:
//  Структура:
//   * Значение - Произвольный, Неопределено - значение JSON; Неопределено, если значение задано некорректно.
//   * Тип - Строка - тип значения.
//   * Ошибка - Строка - ошибка значения.
//
Функция НовоеЗначениеПараметра(Значение, ИмяТипа, Ошибка = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Значение", Значение);
	Результат.Вставить("Тип", ИмяТипа);
	Результат.Вставить("Ошибка", Ошибка);
	Возврат Результат;

КонецФункции

// Значения параметра из строки клиента: JSON в формате аргументов инструментов ({"type", "ref"},
// {"type", "value"} для перечисления, строка, число, булево, дата строкой ISO 8601) или массив
// таких значений. Пустая строка, некорректный JSON, null и вложенные массивы дают значение с ошибкой:
// ограничение с ним закрывает доступ.
//
// Параметры:
//  Текст - Строка - значение из клиента.
//
// Возвращаемое значение:
//  Массив из см. НовоеЗначениеПараметра - значения.
//
Функция ЗначенияПараметраИзJSON(Знач Текст) Экспорт

	Результат = Новый Массив;
	Текст = СокрЛП(Текст);
	Если ПустаяСтрока(Текст) Тогда
		Результат.Добавить(НовоеЗначениеПараметра(Неопределено, "", "значение не задано"));
		Возврат Результат;
	КонецЕсли;
	Попытка
		Значение = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
	Исключение
		Результат.Добавить(НовоеЗначениеПараметра(Неопределено, "", "некорректный JSON"));
		Возврат Результат;
	КонецПопытки;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Результат.Добавить(НовоеЗначениеПараметра(Неопределено, "", "пустой массив"));
		КонецЕсли;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеПараметраJSON(Элемент));
		КонецЦикла;
	Иначе
		Результат.Добавить(ЗначениеПараметраJSON(Значение));
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Инструменты

// Встроенные инструменты чтения, доступные профилю без явного перечня.
//
// Возвращаемое значение:
//  Массив из Строка - имена инструментов.
//
Функция ВстроенныеИнструментыЧтения() Экспорт

	Возврат СтрРазделить("get_context,list_objects,describe_object,find_objects,get_object,"
		+ "query_records,get_balances,get_turnovers,get_slice", ",");

КонецФункции

// Доступен ли инструмент клиенту. get_context доступен всегда; пользовательский инструмент -
// если он назначен профилю клиента (тогда он есть в политике).
//
// Параметры:
//  Политика - см. НоваяПолитика
//  Имя - Строка - имя инструмента.
//
// Возвращаемое значение:
//  Булево - Истина, если инструмент разрешен.
//
Функция ИнструментДоступен(Политика, Имя) Экспорт

	Если Имя = "get_context" Или Политика.ПользовательскиеИнструменты.Получить(Имя) <> Неопределено Тогда
		Возврат Истина;
	ИначеЕсли Политика.Инструменты.Количество() = 0 Тогда
		Возврат ВстроенныеИнструментыЧтения().Найти(Имя) <> Неопределено;
	КонецЕсли;
	Возврат Политика.Инструменты.Найти(Имя) <> Неопределено;

КонецФункции

// Значения параметра профиля, заданные в клиенте и проверенные по типам параметра (п. 7.3 ТЗ), -
// для пользовательских инструментов с параметром, привязанным к параметру профиля.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ИмяПараметра - Строка - имя параметра профиля.
//
// Возвращаемое значение:
//  Структура:
//   * Значения - Массив из Произвольный - значения JSON; пустой при ошибке.
//   * Ошибка - Строка - почему значений нет (для журнала); пустая строка - значения получены.
//
Функция ЗначенияПараметраКлиента(Политика, ИмяПараметра) Экспорт

	Результат = Новый Структура("Значения, Ошибка", Новый Массив, "");
	Ошибка = "";
	Значение = ЗначениеПараметраОграничения(Политика, ИмяПараметра, Ошибка);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Результат.Ошибка = Ошибка;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат.Значения = Значение;
	Иначе
		Результат.Значения.Добавить(Значение);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Объекты

// Доступен ли объект клиенту: для чтения записей или только в агрегатах. Доступный объект
// виден в list_objects и describe_object.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта метаданных (для табличной части - имя владельца).
//
// Возвращаемое значение:
//  Булево - Истина, если объект разрешен профилем и не запрещен глобально.
//
Функция ОбъектДоступен(Политика, ПолноеИмя) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмя);
	Возврат Правило <> Неопределено И РежимДопускаетЧтение(Правило.Режим);

КонецФункции

// Читаются ли записи объекта по отдельности: режим «чтение». Объект в режиме «только агрегаты»
// доступен лишь группировками и агрегатами, его записи не выбираются, через ссылки на него
// нельзя разыменовывать поля и его представления скрываются.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Булево - Истина для режима «чтение».
//
Функция ОбъектЧитается(Политика, ПолноеИмя) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмя);
	Возврат Правило <> Неопределено И Правило.Режим = "read";

КонецФункции

// Доступен ли объект только в агрегатах (п. 7.3-7.4 ТЗ).
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта метаданных (для табличной части - имя владельца).
//
// Возвращаемое значение:
//  Булево - Истина для режима «только агрегаты».
//
Функция ТолькоАгрегаты(Политика, ПолноеИмя) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмя);
	Возврат Правило <> Неопределено И Правило.Режим = "aggregates";

КонецФункции

// Минимальный размер группы k для режима «только агрегаты»: группы, в которых меньше записей,
// не выдаются (ИМЕЮЩИЕ КОЛИЧЕСТВО(*) >= k).
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Число - k; если в профиле не задан - МинимальныйРазмерГруппыПоУмолчанию.
//
Функция МинимальныйРазмерГруппы(Политика, ПолноеИмя) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмя);
	Если Правило = Неопределено Или Правило.МинимальныйРазмерГруппы <= 0 Тогда
		Возврат МинимальныйРазмерГруппыПоУмолчанию();
	КонецЕсли;
	Возврат Цел(Правило.МинимальныйРазмерГруппы);

КонецФункции

// Минимальный размер группы, если профиль его не задает.
//
// Возвращаемое значение:
//  Число - 5.
//
Функция МинимальныйРазмерГруппыПоУмолчанию() Экспорт

	Возврат 5;

КонецФункции

// Действующее правило объекта: точное имя важнее шаблона, длинный шаблон - короткого.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  - см. НовоеПравилоОбъекта
//  - Неопределено - если правила нет или объект запрещен глобально.
//
Функция ПравилоОбъекта(Политика, ПолноеИмя) Экспорт

	Если ОбъектЗапрещенГлобально(Политика, ПолноеИмя)
		Или Политика.НедоступныеОбъекты.Получить(НРег(СокрЛП(ПолноеИмя))) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Лучшее = Неопределено;
	ВесЛучшего = -1;
	Для Каждого Правило Из Политика.Объекты Цикл
		Если Не СоответствуетШаблону(ПолноеИмя, Правило.Шаблон) Тогда
			Продолжить;
		КонецЕсли;
		Вес = ?(СтрНайти(Правило.Шаблон, "*") = 0, 100000, СтрДлина(Правило.Шаблон));
		Если Вес > ВесЛучшего Тогда
			Лучшее = Правило;
			ВесЛучшего = Вес;
		КонецЕсли;
	КонецЦикла;
	Возврат Лучшее;

КонецФункции

// Запрещен ли объект глобально: служебные объекты расширения и шаблоны из настроек (п. 7.6 ТЗ).
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если объект недоступен ни одному профилю.
//
Функция ОбъектЗапрещенГлобально(Политика, ПолноеИмя) Экспорт

	Если СтрНайти(НРег(ПолноеИмя), ".mcp1c_") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Шаблон Из Политика.ЗапрещенныеОбъекты Цикл
		Если СоответствуетШаблону(ПолноеИмя, Шаблон) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Требует ли объект отбор по периоду.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если правило объекта требует отбор по периоду.
//
Функция ТребуетсяОтборПоПериоду(Политика, ПолноеИмя) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмя);
	Возврат Правило <> Неопределено И Правило.ОбязательныйФильтрПериода;

КонецФункции

// Ограничения строк объекта (только точное совпадение имени объекта).
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Массив из см. НовоеОграничениеСтрок - ограничения.
//
Функция ОграниченияСтрок(Политика, ПолноеИмя) Экспорт

	Результат = Новый Массив;
	Имя = НРег(ПолноеИмя);
	Для Каждого Ограничение Из Политика.ОграниченияСтрок Цикл
		Если НРег(Ограничение.Объект) = Имя Тогда
			Результат.Добавить(Ограничение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Поля

// Доступно ли поле объекта для выборки, отборов, сортировки и группировки.
// Скрытое поле не показывается в описании объекта и не упоминается в ошибках.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмяОбъекта - Строка - полное имя объекта (для табличной части - имя владельца).
//  ПутьПоля - Строка - имя поля или ТабличнаяЧасть.Поле (без разыменования).
//  ТипыПоля - Неопределено, Массив из Строка - типы поля для запретов по типу.
//
// Возвращаемое значение:
//  Булево - Истина, если поле доступно.
//
Функция ПолеДоступно(Политика, ПолноеИмяОбъекта, ПутьПоля, ТипыПоля = Неопределено) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмяОбъекта);
	Если Правило = Неопределено Или Не РежимДопускаетЧтение(Правило.Режим) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПолеЗапрещеноГлобально(Политика, ПутьПоля, ТипыПоля) Тогда
		Возврат Ложь;
	КонецЕсли;

	Действие = ДействиеПравилПолей(Политика, ПолноеИмяОбъекта, ПутьПоля);
	Если Действие = "deny" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Правило.ТолькоРазрешенныеПоля Тогда
		Возврат Действие = "allow" Или Действие = "mask" Или ЭтоСлужебноеПоле(ПутьПоля);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Маска доступного поля (п. 7.4 ТЗ). Замаскированное поле видно в результатах, но не используется
// в отборах, сортировке, группировке и как звено разыменования. Служебные поля (Ссылка, НомерСтроки,
// ПометкаУдаления и т. п.) не маскируются: без них нельзя перейти к объекту.
// Из нескольких подходящих правил действует самое конкретное: правило поля важнее правила
// табличной части, точное имя объекта - шаблона.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмяОбъекта - Строка - полное имя объекта (для табличной части - имя владельца).
//  ПутьПоля - Строка - имя поля или ТабличнаяЧасть.Поле.
//
// Возвращаемое значение:
//  - Неопределено - поле не маскируется.
//  - см. mcp1c_Маскирование.НоваяМаска
//
Функция МаскаПоля(Политика, ПолноеИмяОбъекта, ПутьПоля) Экспорт

	Если ЭтоСлужебноеПоле(ПутьПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Путь = НРег(ПутьПоля);
	Лучшее = Неопределено;
	ВесЛучшего = -1;
	Для Каждого Правило Из Политика.Поля Цикл
		Если Правило.Действие <> "mask" Тогда
			Продолжить;
		КонецЕсли;
		ПутьПравила = НРег(Правило.Поле);
		Если ПутьПравила <> Путь И Не НачинаетсяС(Путь, ПутьПравила + ".")
			Или Не СоответствуетШаблону(ПолноеИмяОбъекта, Правило.Объект) Тогда
			Продолжить;
		КонецЕсли;
		Вес = СтрДлина(ПутьПравила) * 100000 + ?(СтрНайти(Правило.Объект, "*") = 0, 99999, СтрДлина(Правило.Объект));
		Если Вес > ВесЛучшего Тогда
			Лучшее = Правило;
			ВесЛучшего = Вес;
		КонецЕсли;
	КонецЦикла;
	Если Лучшее = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат mcp1c_Маскирование.НоваяМаска(Лучшее.ВидМаски, Лучшее.ПараметрМаски);

КонецФункции

// Доступна ли табличная часть объекта.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмяОбъекта - Строка - полное имя объекта-владельца.
//  ИмяТабличнойЧасти - Строка - имя табличной части.
//
// Возвращаемое значение:
//  Булево - Истина, если табличная часть доступна.
//
Функция ТабличнаяЧастьДоступна(Политика, ПолноеИмяОбъекта, ИмяТабличнойЧасти) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмяОбъекта);
	Если Правило = Неопределено Или Не РежимДопускаетЧтение(Правило.Режим) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПолеЗапрещеноГлобально(Политика, ИмяТабличнойЧасти) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ДействиеПравилПолей(Политика, ПолноеИмяОбъекта, ИмяТабличнойЧасти) = "deny" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Правило.ТолькоРазрешенныеПоля Тогда
		Возврат Истина;
	КонецЕсли;

	// В режиме "только разрешенные" табличная часть видна, если разрешена (в том числе с маской)
	// она или хотя бы одно ее поле.
	Префикс = НРег(ИмяТабличнойЧасти);
	Для Каждого ПравилоПоля Из Политика.Поля Цикл
		Путь = НРег(ПравилоПоля.Поле);
		Если (ПравилоПоля.Действие = "allow" Или ПравилоПоля.Действие = "mask")
			И (Путь = Префикс Или НачинаетсяС(Путь, Префикс + "."))
			И СоответствуетШаблону(ПолноеИмяОбъекта, ПравилоПоля.Объект) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Запрещено ли поле глобально: по шаблонам имен и по типам ХранилищеЗначения, ДвоичныеДанные (п. 7.6 ТЗ).
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПутьПоля - Строка - имя поля или ТабличнаяЧасть.Поле.
//  ТипыПоля - Неопределено, Массив из Строка - типы поля.
//
// Возвращаемое значение:
//  Булево - Истина, если поле недоступно ни одному профилю.
//
Функция ПолеЗапрещеноГлобально(Политика, ПутьПоля, ТипыПоля = Неопределено) Экспорт

	Если ТипЗнч(ТипыПоля) = Тип("Массив") Тогда
		Для Каждого ТипПоля Из ТипыПоля Цикл
			Если ТипПоля = "ХранилищеЗначения" Или ТипПоля = "ДвоичныеДанные" Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Часть Из СтрРазделить(ПутьПоля, ".", Ложь) Цикл
		Для Каждого Шаблон Из Политика.ЗапрещенныеПоля Цикл
			Если СоответствуетШаблону(Часть, Шаблон) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Как показывать ссылку на объект: visible - ссылка и представление; masked - ссылка и полная маска
// вместо представления (поля представления замаскированы); hidden - только тип и «<приховано>»
// (объект не читается по записям или поля представления скрыты).
//
// Параметры:
//  Политика - см. НоваяПолитика
//  ПолноеИмя - Строка - полное имя объекта, на который указывает ссылка.
//  ПоляПредставления - Массив из Строка - поля представления (Наименование, Код, Номер, Дата).
//
// Возвращаемое значение:
//  Строка - visible, masked или hidden.
//
Функция ДоступПредставления(Политика, ПолноеИмя, ПоляПредставления) Экспорт

	Если Не ОбъектЧитается(Политика, ПолноеИмя) Тогда
		Возврат "hidden";
	КонецЕсли;
	Результат = "visible";
	Для Каждого Поле Из ПоляПредставления Цикл
		Если Не ПолеДоступно(Политика, ПолноеИмя, Поле) Тогда
			Возврат "hidden";
		КонецЕсли;
		Если МаскаПоля(Политика, ПолноеИмя, Поле) <> Неопределено Тогда
			Результат = "masked";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Параметры

// Подставляет в ограничения строк значения параметров профиля, заданные в клиенте (п. 7.3, 7.5 ТЗ).
// Одно значение - условие "=", несколько - "В" ("В ИЕРАРХИИ", "НЕ В"). Ограничение, параметр
// которого не описан в профиле, не задан в клиенте или имеет значение другого типа, закрывает
// доступ к объекту (вид сравнения invalid, причина - в Ошибка).
//
// Параметры:
//  Политика - см. НоваяПолитика
//
Процедура ПодставитьПараметры(Политика) Экспорт

	Для Каждого Ограничение Из Политика.ОграниченияСтрок Цикл
		Если ПустаяСтрока(Ограничение.Параметр) Тогда
			Продолжить;
		КонецЕсли;
		Ошибка = "";
		Значение = ЗначениеПараметраОграничения(Политика, Ограничение.Параметр, Ошибка);
		Если ПустаяСтрока(Ошибка) Тогда
			Ограничение.Значение = Значение;
		Иначе
			Ограничение.ВидСравнения = "invalid";
			Ограничение.Значение = Неопределено;
			Ограничение.Ошибка = Ошибка;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Песочница

// Правила профиля, которые действуют на вызов, - для песочницы администратора (п. 9.2 ТЗ): профиль,
// доступность инструмента, правила объектов, полей и масок, ограничения строк со значениями
// параметров, глобальные запреты, права пользователя ИБ и лимиты.
//
// Параметры:
//  Политика - см. НоваяПолитика
//  Инструмент - Строка - имя инструмента; пустая строка - вызов без инструмента (списки, промпты).
//  Объекты - Массив из Строка - таблицы, к которым обращался вызов (объект или его табличная часть).
//
// Возвращаемое значение:
//  Массив из Строка - описания правил.
//
Функция ПримененныеПравила(Политика, Инструмент, Объекты) Экспорт

	Результат = Новый Массив;
	Если Политика.Профиль = Неопределено Тогда
		Результат.Добавить("Профіль: не призначено або позначено на вилучення - доступ до даних закрито");
	Иначе
		Результат.Добавить(СтрШаблон("Профіль: «%1», версія %2", Политика.ИмяПрофиля,
			Формат(Политика.ВерсияПрофиля, "ЧН=0; ЧГ=0")));
	КонецЕсли;
	Если Не ПустаяСтрока(Инструмент) Тогда
		Результат.Добавить(ПравилоИнструмента(Политика, Инструмент));
	КонецЕсли;

	Обработанные = Новый Соответствие;
	Для Каждого ИмяТаблицы Из Объекты Цикл
		Части = СтрРазделить(СокрЛП(ИмяТаблицы), ".", Ложь);
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = Части[0] + "." + Части[1];
		Если Обработанные.Получить(НРег(ПолноеИмя)) = Неопределено Тогда
			Обработанные.Вставить(НРег(ПолноеИмя), Истина);
			ДобавитьПравилаОбъекта(Результат, Политика, ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Если Обработанные.Количество() > 0 Тогда
		Шаблоны = ?(Политика.ЗапрещенныеПоля.Количество() = 0, "шаблонів немає",
			"шаблони " + СтрСоединить(Политика.ЗапрещенныеПоля, ", "));
		Результат.Добавить(СтрШаблон("Глобальні заборони полів (для всіх профілів): %1; типи ХранилищеЗначения "
			+ "і ДвоичныеДанные", Шаблоны));
	КонецЕсли;
	Результат.Добавить(ОписаниеЛимитов(Политика.Лимиты));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Шаблоны

// Соответствие строки шаблону без учета регистра; * - любая (в том числе пустая)
// последовательность символов.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//  Шаблон - Строка - шаблон.
//
// Возвращаемое значение:
//  Булево - Истина, если строка соответствует шаблону.
//
Функция СоответствуетШаблону(Знач Значение, Знач Шаблон) Экспорт

	Значение = НРег(СокрЛП(Значение));
	Шаблон = НРег(СокрЛП(Шаблон));
	Если СтрНайти(Шаблон, "*") = 0 Тогда
		Возврат Значение = Шаблон;
	КонецЕсли;

	Части = СтрРазделить(Шаблон, "*", Истина);
	Первая = Части[0];
	Последняя = Части[Части.ВГраница()];
	Если Не НачинаетсяС(Значение, Первая) Тогда
		Возврат Ложь;
	КонецЕсли;
	Позиция = СтрДлина(Первая) + 1;
	Для Индекс = 1 По Части.ВГраница() - 1 Цикл
		Часть = Части[Индекс];
		Если Часть = "" Тогда
			Продолжить;
		КонецЕсли;
		Найдено = СтрНайти(Сред(Значение, Позиция), Часть);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Позиция = Позиция + Найдено - 1 + СтрДлина(Часть);
	КонецЦикла;

	Хвост = Сред(Значение, Позиция);
	Возврат СтрДлина(Хвост) >= СтрДлина(Последняя) И Прав(Хвост, СтрДлина(Последняя)) = Последняя;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДействиеПравилПолей(Политика, ПолноеИмяОбъекта, ПутьПоля)
	// Итог правил полей для объекта: "deny" важнее "mask", "mask" - "allow"; пустая строка - правил нет.
	// Действие, отличное от allow и mask (ошибка настройки), запрещает поле.

	Путь = НРег(ПутьПоля);
	Результат = "";
	Для Каждого Правило Из Политика.Поля Цикл
		ПутьПравила = НРег(Правило.Поле);
		Если ПутьПравила <> Путь И Не НачинаетсяС(Путь, ПутьПравила + ".") Тогда
			Продолжить;
		КонецЕсли;
		Если Не СоответствуетШаблону(ПолноеИмяОбъекта, Правило.Объект) Тогда
			Продолжить;
		КонецЕсли;
		Если Правило.Действие = "mask" Тогда
			Результат = "mask";
		ИначеЕсли Правило.Действие = "allow" Тогда
			Результат = ?(Результат = "mask", Результат, "allow");
		Иначе
			Возврат "deny";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РежимДопускаетЧтение(Режим)
	// Режимы, в которых объект доступен клиенту: чтение записей и только агрегаты.

	Возврат Режим = "read" Или Режим = "aggregates";

КонецФункции

Функция ЗначениеПараметраОграничения(Политика, ИмяПараметра, Ошибка)
	// Значение JSON для ограничения из значений параметра клиента: одно значение или массив.

	Ключ = НРег(ИмяПараметра);
	Описание = Политика.ПараметрыПрофиля.Получить(Ключ);
	Если Описание = Неопределено Тогда
		Ошибка = СтрШаблон("Параметр %1 не описан в профиле", ИмяПараметра);
		Возврат Неопределено;
	КонецЕсли;
	Значения = Политика.ЗначенияПараметров.Получить(Ключ);
	Если ТипЗнч(Значения) <> Тип("Массив") Или Значения.Количество() = 0 Тогда
		Ошибка = СтрШаблон("Для клиента не заданы значения параметра %1", ИмяПараметра);
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Значения Цикл
		Если Не ПустаяСтрока(Элемент.Ошибка) Тогда
			Ошибка = СтрШаблон("Значение параметра %1: %2", ИмяПараметра, Элемент.Ошибка);
			Возврат Неопределено;
		КонецЕсли;
		Если Описание.Типы.Количество() > 0 И Не ТипСовместим(Описание.Типы, Элемент) Тогда
			Ошибка = СтрШаблон("Значение параметра %1 типа %2 не соответствует типам параметра: %3", ИмяПараметра,
				Элемент.Тип, СтрСоединить(Описание.Типы, ", "));
			Возврат Неопределено;
		КонецЕсли;
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат ?(Результат.Количество() = 1, Результат[0], Результат);

КонецФункции

Функция ТипСовместим(Типы, Элемент)
	// Тип значения входит в типы параметра; дата в JSON - строка ISO 8601, она подходит типу Дата.

	Если ЕстьСтрокаБезУчетаРегистра(Типы, Элемент.Тип) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Элемент.Тип = "Строка" И ЕстьСтрокаБезУчетаРегистра(Типы, "Дата")
		И mcp1c_Служебный.РазобратьДату(Элемент.Значение) <> Неопределено;

КонецФункции

Функция ЗначениеПараметраJSON(Значение)
	// Значение параметра с типом: ссылка и перечисление - по полю type, строка, число, булево.

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат НовоеЗначениеПараметра(Значение, "Строка", ?(ПустаяСтрока(Значение), "пустая строка", ""));
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат НовоеЗначениеПараметра(Значение, "Число");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат НовоеЗначениеПараметра(Значение, "Булево");
	ИначеЕсли ТипЗначения <> Тип("Соответствие") Тогда
		Возврат НовоеЗначениеПараметра(Неопределено, "", "ожидается одно значение: ссылка, строка, число или булево");
	КонецЕсли;

	ИмяТипа = Значение.Получить("type");
	Если ТипЗнч(ИмяТипа) <> Тип("Строка") Или ПустаяСтрока(ИмяТипа) Тогда
		Возврат НовоеЗначениеПараметра(Неопределено, "", "для ссылки ожидается {""type"": ""Справочник.X"", ""ref"": ""<uuid>""}");
	КонецЕсли;
	ИмяТипа = mcp1c_ЗапросыДанных.НормализованноеИмяТипа(ИмяТипа);
	Если Значение.Получить("ref") = Неопределено И Значение.Получить("value") = Неопределено Тогда
		Возврат НовоеЗначениеПараметра(Неопределено, ИмяТипа, "для ссылки ожидается ref, для перечисления - value");
	КонецЕсли;
	Возврат НовоеЗначениеПараметра(Значение, ИмяТипа);

КонецФункции

Функция ПримитивныеТипыПараметров()

	Результат = Новый Соответствие;
	Результат.Вставить("строка", "Строка");
	Результат.Вставить("string", "Строка");
	Результат.Вставить("число", "Число");
	Результат.Вставить("number", "Число");
	Результат.Вставить("дата", "Дата");
	Результат.Вставить("date", "Дата");
	Результат.Вставить("булево", "Булево");
	Результат.Вставить("boolean", "Булево");
	Возврат Результат;

КонецФункции

Функция ЕстьСтрокаБезУчетаРегистра(Строки, Строка_)

	Искомая = НРег(СокрЛП(Строка_));
	Для Каждого Элемент Из Строки Цикл
		Если НРег(СокрЛП(Элемент)) = Искомая Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоСлужебноеПоле(ПутьПоля)
	// Поля, без которых нельзя выбрать данные и которые ничего не раскрывают сами по себе.

	Части = СтрРазделить(ПутьПоля, ".", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Имя = НРег(Части[Части.ВГраница()]);
	Возврат Имя = "ссылка" Или Имя = "номерстроки" Или Имя = "этогруппа"
		Или Имя = "пометкаудаления" Или Имя = "проведен" Или Имя = "активность";

КонецФункции

Функция ПравилоИнструмента(Политика, Инструмент)
	// Почему инструмент доступен или недоступен клиенту.

	Если Инструмент = "get_context" Тогда
		Возврат "Інструмент get_context: доступний усім клієнтам";
	ИначеЕсли Политика.ПользовательскиеИнструменты.Получить(Инструмент) <> Неопределено Тогда
		Возврат СтрШаблон("Інструмент %1: користувацький, призначений профілю; запит адміністратора виконується "
			+ "як є, правила об'єктів і обмеження рядків профілю до нього не застосовуються", Инструмент);
	ИначеЕсли Не ИнструментДоступен(Политика, Инструмент) Тогда
		Возврат СтрШаблон("Інструмент %1: не дозволений профілем", Инструмент);
	ИначеЕсли Политика.Инструменты.Количество() = 0 Тогда
		Возврат СтрШаблон("Інструмент %1: профіль дозволяє всі вбудовані інструменти читання", Инструмент);
	КонецЕсли;
	Возврат СтрШаблон("Інструмент %1: дозволений списком інструментів профілю", Инструмент);

КонецФункции

Процедура ДобавитьПравилаОбъекта(Результат, Политика, ПолноеИмя)
	// Правило объекта, правила полей и ограничения строк, которые к нему относятся.

	Если ОбъектЗапрещенГлобально(Политика, ПолноеИмя) Тогда
		Результат.Добавить(СтрШаблон("Об'єкт %1: глобально заборонений (%2)", ПолноеИмя,
			ПричинаГлобальногоЗапрета(Политика, ПолноеИмя)));
		Возврат;
	ИначеЕсли Политика.НедоступныеОбъекты.Получить(НРег(ПолноеИмя)) <> Неопределено Тогда
		Результат.Добавить(СтрШаблон("Об'єкт %1: користувач ІБ клієнта не має права читання (його права - "
			+ "верхня межа доступу)", ПолноеИмя));
		Возврат;
	КонецЕсли;
	Правило = ПравилоОбъекта(Политика, ПолноеИмя);
	Если Правило = Неопределено Тогда
		Результат.Добавить(СтрШаблон("Об'єкт %1: немає правила профілю - недоступний", ПолноеИмя));
		Возврат;
	КонецЕсли;
	Результат.Добавить(СтрШаблон("Об'єкт %1: правило «%2» - %3", ПолноеИмя, Правило.Шаблон,
		ОписаниеПравилаОбъекта(Правило)));
	Для Каждого ПравилоПоля Из Политика.Поля Цикл
		Если СоответствуетШаблону(ПолноеИмя, ПравилоПоля.Объект) Тогда
			Результат.Добавить(СтрШаблон("  поле %1: %2 (правило для «%3»)", ПравилоПоля.Поле,
				ОписаниеДействияСПолем(ПравилоПоля), ПравилоПоля.Объект));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ограничение Из ОграниченияСтрок(Политика, ПолноеИмя) Цикл
		Результат.Добавить("  рядки: " + ОписаниеОграничения(Ограничение));
	КонецЦикла;

КонецПроцедуры

Функция ПричинаГлобальногоЗапрета(Политика, ПолноеИмя)

	Если СтрНайти(НРег(ПолноеИмя), ".mcp1c_") > 0 Тогда
		Возврат "службовий об'єкт розширення";
	КонецЕсли;
	Для Каждого Шаблон Из Политика.ЗапрещенныеОбъекты Цикл
		Если СоответствуетШаблону(ПолноеИмя, Шаблон) Тогда
			Возврат СтрШаблон("шаблон «%1» у налаштуваннях сервера", Шаблон);
		КонецЕсли;
	КонецЦикла;
	Возврат "налаштування сервера";

КонецФункции

Функция ОписаниеПравилаОбъекта(Правило)
	// Режим, политика полей и обязательный отбор по периоду.

	Если Правило.Режим = "read" Тогда
		Текст = "читання записів";
	ИначеЕсли Правило.Режим = "aggregates" Тогда
		Размер = ?(Правило.МинимальныйРазмерГруппы > 0, Цел(Правило.МинимальныйРазмерГруппы),
			МинимальныйРазмерГруппыПоУмолчанию());
		Текст = СтрШаблон("лише агрегати записів (query_records), групи від %1 записів", Формат(Размер, "ЧН=0; ЧГ=0"));
	Иначе
		Возврат "заборонено";
	КонецЕсли;
	Текст = Текст + "; поля: " + ?(Правило.ТолькоРазрешенныеПоля, "лише дозволені", "усі, крім заборонених");
	Если Правило.ОбязательныйФильтрПериода Тогда
		Текст = Текст + "; обов'язковий фільтр періоду";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ОписаниеДействияСПолем(ПравилоПоля)

	Если ПравилоПоля.Действие = "allow" Тогда
		Возврат "дозволено";
	ИначеЕсли ПравилоПоля.Действие = "mask" Тогда
		Возврат "маска " + mcp1c_Маскирование.Представление(
			mcp1c_Маскирование.НоваяМаска(ПравилоПоля.ВидМаски, ПравилоПоля.ПараметрМаски));
	КонецЕсли;
	Возврат "заборонено";

КонецФункции

Функция ОписаниеОграничения(Ограничение)
	// Условие ограничения строк со значением; значение параметра профиля уже подставлено.

	Если Ограничение.ВидСравнения = "invalid" Тогда
		Возврат СтрШаблон("за полем %1 обмеження некоректне (%2) - об'єкт закрито", Ограничение.Поле, Ограничение.Ошибка);
	КонецЕсли;
	Список = (ТипЗнч(Ограничение.Значение) = Тип("Массив"));
	Если Ограничение.ВидСравнения = "ne" Тогда
		Оператор = ?(Список, "НЕ В", "<>");
	ИначеЕсли Ограничение.ВидСравнения = "in_hierarchy" Тогда
		Оператор = "В ІЄРАРХІЇ";
	Иначе
		Оператор = ?(Список, "В", "=");
	КонецЕсли;
	Текст = СтрШаблон("%1 %2 %3", Ограничение.Поле, Оператор, ПредставлениеЗначенияОграничения(Ограничение.Значение));
	Если Не ПустаяСтрока(Ограничение.Параметр) Тогда
		Текст = Текст + СтрШаблон(" (параметр профілю %1)", Ограничение.Параметр);
	КонецЕсли;
	Если Не ПустаяСтрока(Ограничение.Комментарий) Тогда
		Текст = Текст + " - " + Ограничение.Комментарий;
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ПредставлениеЗначенияОграничения(Значение)

	Попытка
		Текст = mcp1c_Сериализация.КаноническийJSON(Значение);
	Исключение
		Текст = Строка(Значение);
	КонецПопытки;
	Возврат ?(СтрДлина(Текст) > 300, Лев(Текст, 300) + "...", Текст);

КонецФункции

Функция ОписаниеЛимитов(Лимиты)

	Возврат СтрШаблон("Ліміти: %1 рядків за виклик, %2 викликів за хвилину, %3 рядків на добу, період до %4 днів, "
		+ "відповідь до %5 КБ, до %6 розіменувань", Формат(Лимиты.СтрокЗаВызов, "ЧН=0; ЧГ=0"),
		Формат(Лимиты.ВызововВМинуту, "ЧН=0; ЧГ=0"), Формат(Лимиты.СтрокВСутки, "ЧН=0; ЧГ=0"),
		Формат(Лимиты.ГлубинаПериодаДней, "ЧН=0; ЧГ=0"), Формат(Цел(Лимиты.РазмерОтветаБайт / 1024), "ЧН=0; ЧГ=0"),
		Формат(Лимиты.ГлубинаРазыменования, "ЧН=0; ЧГ=0"));

КонецФункции

Функция НачинаетсяС(Значение, Подстрока)
	// Начинается ли строка с подстроки; пустая подстрока допускается (СтрНачинаетсяС ее не принимает).

	Возврат Лев(Значение, СтрДлина(Подстрока)) = Подстрока;

КонецФункции

#КонецОбласти

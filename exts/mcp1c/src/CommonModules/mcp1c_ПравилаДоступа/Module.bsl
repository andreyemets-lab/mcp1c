///////////////////////////////////////////////////////////////////////////////
// mcp1c_ПравилаДоступа: правила профиля доступа (п. 7.3-7.6 ТЗ) - инструменты, объекты,
// поля, ограничения строк и глобальные запреты.
//
// Политика - структура данных (см. НоваяПолитика), которую заполняет mcp1c_Политики
// из справочников; модуль только вычисляет решения. По умолчанию запрещено все:
// объект доступен, только если его разрешает правило профиля и он не попал
// в глобальные запреты.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Конструкторы

// Пустая политика: все запрещено.
//
// Возвращаемое значение:
//  Структура:
//   * Клиент - Произвольный - ссылка на клиента доступа.
//   * ИмяКлиента - Строка - наименование клиента.
//   * ИмяПрофиля - Строка - наименование профиля.
//   * ВерсияПрофиля - Число - версия профиля.
//   * Инструменты - Массив из Строка - разрешенные инструменты; пустой массив - встроенные инструменты чтения.
//   * Объекты - Массив из см. НовоеПравилоОбъекта - правила объектов.
//   * Поля - Массив из см. НовоеПравилоПоля - правила полей.
//   * ОграниченияСтрок - Массив из см. НовоеОграничениеСтрок - ограничения строк.
//   * ЗапрещенныеПоля - Массив из Строка - шаблоны имен глобально запрещенных полей.
//   * ЗапрещенныеОбъекты - Массив из Строка - шаблоны полных имен глобально запрещенных объектов.
//   * НедоступныеОбъекты - Соответствие из КлючИЗначение - объекты, которые не может читать
//                          привязанный к клиенту пользователь ИБ (верхняя граница прав, п. 7.1 ТЗ):
//     ** Ключ - Строка - полное имя объекта в нижнем регистре.
//     ** Значение - Булево - Истина.
//   * Лимиты - см. НовыеЛимиты.
//   * РазрешитьПомеченныеНаУдаление - Булево - можно запрашивать помеченные на удаление.
//
Функция НоваяПолитика() Экспорт

	Политика = Новый Структура;
	Политика.Вставить("Клиент", Неопределено);
	Политика.Вставить("ИмяКлиента", "");
	Политика.Вставить("ИмяПрофиля", "");
	Политика.Вставить("ВерсияПрофиля", 0);
	Политика.Вставить("Инструменты", Новый Массив);
	Политика.Вставить("Объекты", Новый Массив);
	Политика.Вставить("Поля", Новый Массив);
	Политика.Вставить("ОграниченияСтрок", Новый Массив);
	Политика.Вставить("ЗапрещенныеПоля", Новый Массив);
	Политика.Вставить("ЗапрещенныеОбъекты", Новый Массив);
	Политика.Вставить("НедоступныеОбъекты", Новый Соответствие);
	Политика.Вставить("Лимиты", НовыеЛимиты());
	Политика.Вставить("РазрешитьПомеченныеНаУдаление", Ложь);
	Возврат Политика;

КонецФункции

// Лимиты по умолчанию (п. 7.3 ТЗ).
//
// Возвращаемое значение:
//  Структура:
//   * СтрокЗаВызов - Число - максимум строк в ответе инструмента.
//   * ВызововВМинуту - Число - частота вызовов клиента.
//   * СтрокВСутки - Число - суточная квота строк.
//   * ГлубинаПериодаДней - Число - максимальная длина периода.
//   * РазмерОтветаБайт - Число - предельный размер структурированного результата.
//   * ГлубинаРазыменования - Число - сколько точек допускается в пути поля.
//
Функция НовыеЛимиты() Экспорт

	Лимиты = Новый Структура;
	Лимиты.Вставить("СтрокЗаВызов", 50);
	Лимиты.Вставить("ВызововВМинуту", 30);
	Лимиты.Вставить("СтрокВСутки", 20000);
	Лимиты.Вставить("ГлубинаПериодаДней", 366);
	Лимиты.Вставить("РазмерОтветаБайт", 102400);
	Лимиты.Вставить("ГлубинаРазыменования", 2);
	Возврат Лимиты;

КонецФункции

// Максимальные значения лимитов, которые не может превысить ни один профиль (п. 7.3 ТЗ).
//
// Возвращаемое значение:
//  Структура - те же ключи, что в НовыеЛимиты.
//
Функция ПредельныеЛимиты() Экспорт

	Лимиты = Новый Структура;
	Лимиты.Вставить("СтрокЗаВызов", 1000);
	Лимиты.Вставить("ВызововВМинуту", 600);
	Лимиты.Вставить("СтрокВСутки", 10000000);
	Лимиты.Вставить("ГлубинаПериодаДней", 36600);
	Лимиты.Вставить("РазмерОтветаБайт", 4194304);
	Лимиты.Вставить("ГлубинаРазыменования", 5);
	Возврат Лимиты;

КонецФункции

// Устанавливает лимит профиля: положительное значение заменяет значение по умолчанию,
// но не превышает предельное (см. ПредельныеЛимиты).
//
// Параметры:
//  Лимиты - см. НовыеЛимиты.
//  Имя - Строка - имя лимита.
//  Значение - Число - значение из профиля; 0 или пустое - оставить значение по умолчанию.
//
Процедура УстановитьЛимит(Лимиты, Имя, Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение <= 0 Тогда
		Возврат;
	КонецЕсли;
	Лимиты[Имя] = Мин(Цел(Значение), ПредельныеЛимиты()[Имя]);

КонецПроцедуры

// Уменьшает лимит: клиент может только сузить лимиты профиля (п. 7.1 ТЗ).
//
// Параметры:
//  Лимиты - см. НовыеЛимиты.
//  Имя - Строка - имя лимита.
//  Значение - Число - значение из клиента; 0 или пустое - не ограничивать дополнительно.
//
Процедура УменьшитьЛимит(Лимиты, Имя, Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение <= 0 Тогда
		Возврат;
	КонецЕсли;
	Лимиты[Имя] = Мин(Лимиты[Имя], Цел(Значение));

КонецПроцедуры

// Правило доступа к объекту.
//
// Параметры:
//  Шаблон - Строка - полное имя объекта ("Справочник.Контрагенты"), шаблон ("Документ.*") или "*".
//  Режим - Строка - "read" (чтение) или "deny" (запрещено).
//  ТолькоРазрешенныеПоля - Булево - доступны только поля, явно разрешенные правилами полей.
//  ОбязательныйФильтрПериода - Булево - выборки из объекта требуют отбор по периоду.
//
// Возвращаемое значение:
//  Структура:
//   * Шаблон - Строка - полное имя или шаблон.
//   * Режим - Строка - "read" или "deny".
//   * ТолькоРазрешенныеПоля - Булево - политика полей.
//   * ОбязательныйФильтрПериода - Булево - требуется отбор по периоду.
//
Функция НовоеПравилоОбъекта(Шаблон, Режим = "read", ТолькоРазрешенныеПоля = Ложь,
	ОбязательныйФильтрПериода = Ложь) Экспорт

	Правило = Новый Структура;
	Правило.Вставить("Шаблон", СокрЛП(Шаблон));
	Правило.Вставить("Режим", Режим);
	Правило.Вставить("ТолькоРазрешенныеПоля", ТолькоРазрешенныеПоля);
	Правило.Вставить("ОбязательныйФильтрПериода", ОбязательныйФильтрПериода);
	Возврат Правило;

КонецФункции

// Правило доступа к полю.
//
// Параметры:
//  Объект - Строка - полное имя объекта или шаблон.
//  Поле - Строка - имя поля, имя табличной части или ТабличнаяЧасть.Поле.
//  Действие - Строка - "allow" или "deny".
//
// Возвращаемое значение:
//  Структура:
//   * Объект - Строка - полное имя объекта или шаблон.
//   * Поле - Строка - путь поля.
//   * Действие - Строка - "allow" или "deny".
//
Функция НовоеПравилоПоля(Объект, Поле, Действие) Экспорт

	Правило = Новый Структура;
	Правило.Вставить("Объект", СокрЛП(Объект));
	Правило.Вставить("Поле", СокрЛП(Поле));
	Правило.Вставить("Действие", Действие);
	Возврат Правило;

КонецФункции

// Ограничение строк объекта (п. 7.5 ТЗ). Ограничения одного поля с видом "eq"
// и "in_hierarchy" объединяются через ИЛИ, "ne" - через И; ограничения разных полей - через И.
//
// Параметры:
//  Объект - Строка - полное имя объекта.
//  Поле - Строка - поле объекта.
//  ВидСравнения - Строка - "eq", "ne" или "in_hierarchy".
//  Значение - Произвольный - значение в формате JSON аргументов инструментов (разобранное).
//  Комментарий - Строка - пояснение администратора.
//
// Возвращаемое значение:
//  Структура:
//   * Объект - Строка - полное имя объекта.
//   * Поле - Строка - поле объекта.
//   * ВидСравнения - Строка - "eq", "ne" или "in_hierarchy".
//   * Значение - Произвольный - значение JSON.
//   * Комментарий - Строка - пояснение.
//
Функция НовоеОграничениеСтрок(Объект, Поле, ВидСравнения, Значение, Комментарий = "") Экспорт

	Ограничение = Новый Структура;
	Ограничение.Вставить("Объект", СокрЛП(Объект));
	Ограничение.Вставить("Поле", СокрЛП(Поле));
	Ограничение.Вставить("ВидСравнения", ВидСравнения);
	Ограничение.Вставить("Значение", Значение);
	Ограничение.Вставить("Комментарий", Комментарий);
	Возврат Ограничение;

КонецФункции

#КонецОбласти

#Область Инструменты

// Встроенные инструменты чтения, доступные профилю без явного перечня.
//
// Возвращаемое значение:
//  Массив из Строка - имена инструментов.
//
Функция ВстроенныеИнструментыЧтения() Экспорт

	Возврат СтрРазделить("get_context,list_objects,describe_object,find_objects,get_object,"
		+ "query_records,get_balances,get_turnovers,get_slice", ",");

КонецФункции

// Доступен ли инструмент клиенту. get_context доступен всегда.
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  Имя - Строка - имя инструмента.
//
// Возвращаемое значение:
//  Булево - Истина, если инструмент разрешен.
//
Функция ИнструментДоступен(Политика, Имя) Экспорт

	Если Имя = "get_context" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Политика.Инструменты.Количество() = 0 Тогда
		Возврат ВстроенныеИнструментыЧтения().Найти(Имя) <> Неопределено;
	КонецЕсли;
	Возврат Политика.Инструменты.Найти(Имя) <> Неопределено;

КонецФункции

#КонецОбласти

#Область Объекты

// Доступен ли объект для чтения.
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПолноеИмя - Строка - полное имя объекта метаданных (для табличной части - имя владельца).
//
// Возвращаемое значение:
//  Булево - Истина, если объект разрешен профилем и не запрещен глобально.
//
Функция ОбъектДоступен(Политика, ПолноеИмя) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмя);
	Возврат Правило <> Неопределено И Правило.Режим = "read";

КонецФункции

// Действующее правило объекта: точное имя важнее шаблона, длинный шаблон - короткого.
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  см. НовоеПравилоОбъекта, Неопределено - Неопределено, если правила нет или объект запрещен глобально.
//
Функция ПравилоОбъекта(Политика, ПолноеИмя) Экспорт

	Если ОбъектЗапрещенГлобально(Политика, ПолноеИмя)
		Или Политика.НедоступныеОбъекты.Получить(НРег(СокрЛП(ПолноеИмя))) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Лучшее = Неопределено;
	ВесЛучшего = -1;
	Для Каждого Правило Из Политика.Объекты Цикл
		Если Не СоответствуетШаблону(ПолноеИмя, Правило.Шаблон) Тогда
			Продолжить;
		КонецЕсли;
		Вес = ?(СтрНайти(Правило.Шаблон, "*") = 0, 100000, СтрДлина(Правило.Шаблон));
		Если Вес > ВесЛучшего Тогда
			Лучшее = Правило;
			ВесЛучшего = Вес;
		КонецЕсли;
	КонецЦикла;
	Возврат Лучшее;

КонецФункции

// Запрещен ли объект глобально: служебные объекты расширения и шаблоны из настроек (п. 7.6 ТЗ).
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если объект недоступен ни одному профилю.
//
Функция ОбъектЗапрещенГлобально(Политика, ПолноеИмя) Экспорт

	Если СтрНайти(НРег(ПолноеИмя), ".mcp1c_") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Шаблон Из Политика.ЗапрещенныеОбъекты Цикл
		Если СоответствуетШаблону(ПолноеИмя, Шаблон) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Требует ли объект отбор по периоду.
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если правило объекта требует отбор по периоду.
//
Функция ТребуетсяОтборПоПериоду(Политика, ПолноеИмя) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмя);
	Возврат Правило <> Неопределено И Правило.ОбязательныйФильтрПериода;

КонецФункции

// Ограничения строк объекта (только точное совпадение имени объекта).
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Массив из см. НовоеОграничениеСтрок - ограничения.
//
Функция ОграниченияСтрок(Политика, ПолноеИмя) Экспорт

	Результат = Новый Массив;
	Имя = НРег(ПолноеИмя);
	Для Каждого Ограничение Из Политика.ОграниченияСтрок Цикл
		Если НРег(Ограничение.Объект) = Имя Тогда
			Результат.Добавить(Ограничение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Поля

// Доступно ли поле объекта для выборки, отборов, сортировки и группировки.
// Скрытое поле не показывается в описании объекта и не упоминается в ошибках.
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПолноеИмяОбъекта - Строка - полное имя объекта (для табличной части - имя владельца).
//  ПутьПоля - Строка - имя поля или ТабличнаяЧасть.Поле (без разыменования).
//  ТипыПоля - Массив из Строка, Неопределено - типы поля для запретов по типу.
//
// Возвращаемое значение:
//  Булево - Истина, если поле доступно.
//
Функция ПолеДоступно(Политика, ПолноеИмяОбъекта, ПутьПоля, ТипыПоля = Неопределено) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмяОбъекта);
	Если Правило = Неопределено Или Правило.Режим <> "read" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПолеЗапрещеноГлобально(Политика, ПутьПоля, ТипыПоля) Тогда
		Возврат Ложь;
	КонецЕсли;

	Действие = ДействиеПравилПолей(Политика, ПолноеИмяОбъекта, ПутьПоля);
	Если Действие = "deny" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Правило.ТолькоРазрешенныеПоля Тогда
		Возврат Действие = "allow" Или ЭтоСлужебноеПоле(ПутьПоля);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Доступна ли табличная часть объекта.
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПолноеИмяОбъекта - Строка - полное имя объекта-владельца.
//  ИмяТабличнойЧасти - Строка - имя табличной части.
//
// Возвращаемое значение:
//  Булево - Истина, если табличная часть доступна.
//
Функция ТабличнаяЧастьДоступна(Политика, ПолноеИмяОбъекта, ИмяТабличнойЧасти) Экспорт

	Правило = ПравилоОбъекта(Политика, ПолноеИмяОбъекта);
	Если Правило = Неопределено Или Правило.Режим <> "read" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПолеЗапрещеноГлобально(Политика, ИмяТабличнойЧасти) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ДействиеПравилПолей(Политика, ПолноеИмяОбъекта, ИмяТабличнойЧасти) = "deny" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Правило.ТолькоРазрешенныеПоля Тогда
		Возврат Истина;
	КонецЕсли;

	// В режиме "только разрешенные" табличная часть видна, если разрешена она или хотя бы одно ее поле.
	Префикс = НРег(ИмяТабличнойЧасти);
	Для Каждого ПравилоПоля Из Политика.Поля Цикл
		Путь = НРег(ПравилоПоля.Поле);
		Если ПравилоПоля.Действие = "allow" И (Путь = Префикс Или НачинаетсяС(Путь, Префикс + "."))
			И СоответствуетШаблону(ПолноеИмяОбъекта, ПравилоПоля.Объект) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Запрещено ли поле глобально: по шаблонам имен и по типам ХранилищеЗначения, ДвоичныеДанные (п. 7.6 ТЗ).
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПутьПоля - Строка - имя поля или ТабличнаяЧасть.Поле.
//  ТипыПоля - Массив из Строка, Неопределено - типы поля.
//
// Возвращаемое значение:
//  Булево - Истина, если поле недоступно ни одному профилю.
//
Функция ПолеЗапрещеноГлобально(Политика, ПутьПоля, ТипыПоля = Неопределено) Экспорт

	Если ТипЗнч(ТипыПоля) = Тип("Массив") Тогда
		Для Каждого ТипПоля Из ТипыПоля Цикл
			Если ТипПоля = "ХранилищеЗначения" Или ТипПоля = "ДвоичныеДанные" Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Часть Из СтрРазделить(ПутьПоля, ".", Ложь) Цикл
		Для Каждого Шаблон Из Политика.ЗапрещенныеПоля Цикл
			Если СоответствуетШаблону(Часть, Шаблон) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Можно ли показывать представление ссылки на объект: объект читается, а поля,
// из которых строится представление, доступны.
//
// Параметры:
//  Политика - см. НоваяПолитика.
//  ПолноеИмя - Строка - полное имя объекта, на который указывает ссылка.
//  ПоляПредставления - Массив из Строка - поля представления (Наименование, Код, Номер, Дата).
//
// Возвращаемое значение:
//  Булево - Истина, если представление можно показать.
//
Функция ПредставлениеДоступно(Политика, ПолноеИмя, ПоляПредставления) Экспорт

	Если Не ОбъектДоступен(Политика, ПолноеИмя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Поле Из ПоляПредставления Цикл
		Если Не ПолеДоступно(Политика, ПолноеИмя, Поле) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Шаблоны

// Соответствие строки шаблону без учета регистра; * - любая (в том числе пустая)
// последовательность символов.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//  Шаблон - Строка - шаблон.
//
// Возвращаемое значение:
//  Булево - Истина, если строка соответствует шаблону.
//
Функция СоответствуетШаблону(Знач Значение, Знач Шаблон) Экспорт

	Значение = НРег(СокрЛП(Значение));
	Шаблон = НРег(СокрЛП(Шаблон));
	Если СтрНайти(Шаблон, "*") = 0 Тогда
		Возврат Значение = Шаблон;
	КонецЕсли;

	Части = СтрРазделить(Шаблон, "*", Истина);
	Первая = Части[0];
	Последняя = Части[Части.ВГраница()];
	Если Не НачинаетсяС(Значение, Первая) Тогда
		Возврат Ложь;
	КонецЕсли;
	Позиция = СтрДлина(Первая) + 1;
	Для Индекс = 1 По Части.ВГраница() - 1 Цикл
		Часть = Части[Индекс];
		Если Часть = "" Тогда
			Продолжить;
		КонецЕсли;
		Найдено = СтрНайти(Сред(Значение, Позиция), Часть);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Позиция = Позиция + Найдено - 1 + СтрДлина(Часть);
	КонецЦикла;

	Хвост = Сред(Значение, Позиция);
	Возврат СтрДлина(Хвост) >= СтрДлина(Последняя) И Прав(Хвост, СтрДлина(Последняя)) = Последняя;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Итог правил полей для объекта: "deny" важнее "allow"; пустая строка - правил нет.
Функция ДействиеПравилПолей(Политика, ПолноеИмяОбъекта, ПутьПоля)

	Путь = НРег(ПутьПоля);
	Результат = "";
	Для Каждого Правило Из Политика.Поля Цикл
		ПутьПравила = НРег(Правило.Поле);
		Если ПутьПравила <> Путь И Не НачинаетсяС(Путь, ПутьПравила + ".") Тогда
			Продолжить;
		КонецЕсли;
		Если Не СоответствуетШаблону(ПолноеИмяОбъекта, Правило.Объект) Тогда
			Продолжить;
		КонецЕсли;
		Если Правило.Действие = "deny" Тогда
			Возврат "deny";
		КонецЕсли;
		Результат = Правило.Действие;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Поля, без которых нельзя выбрать данные и которые ничего не раскрывают сами по себе.
Функция ЭтоСлужебноеПоле(ПутьПоля)

	Части = СтрРазделить(ПутьПоля, ".", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Имя = НРег(Части[Части.ВГраница()]);
	Возврат Имя = "ссылка" Или Имя = "номерстроки" Или Имя = "этогруппа"
		Или Имя = "пометкаудаления" Или Имя = "проведен" Или Имя = "активность";

КонецФункции

// Начинается ли строка с подстроки; пустая подстрока допускается (СтрНачинаетсяС ее не принимает).
Функция НачинаетсяС(Значение, Подстрока)

	Возврат Лев(Значение, СтрДлина(Подстрока)) = Подстрока;

КонецФункции

#КонецОбласти

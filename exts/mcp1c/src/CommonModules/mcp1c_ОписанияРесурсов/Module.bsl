Функция ИнструментВида(Вид)

	Если Вид = "metadata" Тогда
		Возврат "describe_object";
	ИначеЕсли Вид = "object" Тогда
		Возврат "get_object";
	КонецЕсли;
	Возврат "get_context";

КонецФункции

Процедура ДобавитьЕслиДоступен(Результат, Политика, Вид, Описание)

	Если mcp1c_ПравилаДоступа.ИнструментДоступен(Политика, ИнструментВида(Вид)) Тогда
		Результат.Добавить(Описание);
	КонецЕсли;

КонецПроцедуры

Функция ОписаниеРесурса(КлючАдреса, Адрес, Имя, Заголовок, Описание)

	Результат = Новый Соответствие;
	Результат.Вставить(КлючАдреса, Адрес);
	Результат.Вставить("name", Имя);
	Результат.Вставить("title", Заголовок);
	Результат.Вставить("description", Описание);
	Результат.Вставить("mimeType", ТипСодержимого());
	Возврат Результат;

КонецФункции

Функция ЗначениеКлюча(Элемент, Ключ)
	// Значение ключа термина глоссария из Соответствия или Структуры.

	Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
		Возврат Элемент.Получить(Ключ);
	ИначеЕсли ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство(Ключ) Тогда
		Возврат Элемент[Ключ];
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция РаскодированнаяЧастьURI(Часть)
	// Часть пути URI без кодировки URL (%D0%A1 -> С); Неопределено при некорректной кодировке.

	Если СтрНайти(Часть, "%") = 0 Тогда
		Возврат Часть;
	КонецЕсли;
	Результат = "";
	Байты = "";
	Позиция = 1;
	Длина = СтрДлина(Часть);
	Пока Позиция <= Длина Цикл
		Символ = Сред(Часть, Позиция, 1);
		Если Символ = "%" Тогда
			Код = ВРег(Сред(Часть, Позиция + 1, 2));
			Если СтрДлина(Код) <> 2 Или Не mcp1c_Служебный.СостоитИзСимволов(Код, "0123456789ABCDEF") Тогда
				Возврат Неопределено;
			КонецЕсли;
			Байты = Байты + Код;
			Позиция = Позиция + 3;
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Байты) Тогда
			Результат = Результат + ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки(Байты),
				КодировкаТекста.UTF8);
			Байты = "";
		КонецЕсли;
		Результат = Результат + Символ;
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Не ПустаяСтрока(Байты) Тогда
		Результат = Результат + ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки(Байты),
			КодировкаТекста.UTF8);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Подставить(Шаблон, Подстановки)
	// Заменяет {{имя}} значениями подстановок за один проход по шаблону.

	Результат = "";
	Остаток = Шаблон;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "{{");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Сред(Остаток, Начало + 2), "}}");
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Имя = СокрЛП(Сред(Остаток, Начало + 2, Конец - 1));
		Значение = Подстановки.Получить(Имя);
		Результат = Результат + Лев(Остаток, Начало - 1)
			+ ?(ТипЗнч(Значение) = Тип("Строка"), Значение, Сред(Остаток, Начало, Конец + 3));
		Остаток = Сред(Остаток, Начало + Конец + 3);
	КонецЦикла;
	Возврат Результат + Остаток;

КонецФункции

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// mcp1c_ОписанияРесурсов: ресурсы и промпты MCP (п. 5.6 ТЗ).
//
// Ресурсы: onec://context, onec://glossary и шаблоны onec://metadata/{object},
// onec://object/{object}/{ref} (схема не может начинаться с цифры, поэтому не 1c://).
// Кириллица в URI передается в кодировке URL (как при раскрытии шаблона по RFC 6570)
// или как есть; заголовок Mcp-Name с кириллицей приходит в base64 и декодируется в mcp1c_Протокол.
// Промпты: текст из справочника mcp1c_Промпты с подстановкой аргументов {{имя}}.
// Глоссарий: термины администратора для ресурса onec://glossary, get_context и инструкций.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Ресурсы

// Ресурсы, доступные клиенту, для resources/list: ресурс доступен, если профиль разрешает
// инструмент, который дает его содержимое (см. ИнструментРесурса).
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Массив из Произвольный - описания (Соответствие): uri, name, title, description, mimeType.
//
Функция ОписанияРесурсов(Политика) Экспорт

	Результат = Новый Массив;
	ДобавитьЕслиДоступен(Результат, Политика, "context", ОписаниеРесурса("uri", ПрефиксURI() + "context", "context",
		"Контекст сервера 1С",
		"Конфігурація, платформа, час і часовий пояс сервера, клієнт, профіль доступу, ліміти й глосарій - "
		+ "те саме, що повертає інструмент get_context."));
	ДобавитьЕслиДоступен(Результат, Политика, "glossary", ОписаниеРесурса("uri", ПрефиксURI() + "glossary", "glossary",
		"Глосарій бази",
		"Терміни, задані адміністратором: що означають показники цієї бази і де їх шукати "
		+ "(наприклад, «дебіторка - залишок за рахунком 361 у розрізі контрагентів»)."));
	Возврат Результат;

КонецФункции

// Шаблоны ресурсов, доступные клиенту, для resources/templates/list.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Массив из Произвольный - описания (Соответствие): uriTemplate, name, title, description, mimeType.
//
Функция ШаблоныРесурсов(Политика) Экспорт

	Результат = Новый Массив;
	ДобавитьЕслиДоступен(Результат, Политика, "metadata", ОписаниеРесурса("uriTemplate",
		ПрефиксURI() + "metadata/{object}", "metadata", "Структура об'єкта метаданих",
		"Те саме, що describe_object: реквізити, табличні частини, виміри й ресурси, доступні профілю. "
		+ "{object} - повне ім'я, як у метаданих: Справочник.Контрагенты (кирилиця - у кодуванні URL)."));
	ДобавитьЕслиДоступен(Результат, Политика, "object", ОписаниеРесурса("uriTemplate",
		ПрефиксURI() + "object/{object}/{ref}", "object", "Картка об'єкта",
		"Те саме, що get_object: реквізити об'єкта й до 20 рядків кожної табличної частини. {object} - повне "
		+ "ім'я, {ref} - унікальний ідентифікатор посилання (поле ref з результатів інструментів)."));
	Возврат Результат;

КонецФункции

// Инструмент, который дает содержимое ресурса: его доступность профилю, проверки политики
// и расход квоты строк действуют и для ресурса. Глоссарий входит в get_context.
//
// Параметры:
//  Разбор - см. РазобратьURI
//
// Возвращаемое значение:
//  Строка - имя инструмента; пустая строка, если URI не распознан.
//
Функция ИнструментРесурса(Разбор) Экспорт

	Если Разбор = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ИнструментВида(Разбор.Вид);

КонецФункции

// Аргументы инструмента для чтения ресурса.
//
// Параметры:
//  Разбор - см. РазобратьURI
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - аргументы: object и ref для шаблонов, пусто для context.
//
Функция АргументыИнструмента(Разбор) Экспорт

	Аргументы = Новый Соответствие;
	Если Разбор = Неопределено Тогда
		Возврат Аргументы;
	КонецЕсли;
	Если Разбор.Вид = "metadata" Или Разбор.Вид = "object" Тогда
		Аргументы.Вставить("object", Разбор.Объект);
	КонецЕсли;
	Если Разбор.Вид = "object" Тогда
		Аргументы.Вставить("ref", Разбор.Ссылка);
	КонецЕсли;
	Возврат Аргументы;

КонецФункции

// URI ресурса без кодировки URL - для журнала вызовов.
//
// Параметры:
//  Разбор - см. РазобратьURI
//  URI - Строка - исходный URI: возвращается, если он не распознан.
//
// Возвращаемое значение:
//  Строка - URI.
//
Функция ПредставлениеURI(Разбор, URI) Экспорт

	Если Разбор = Неопределено Тогда
		Возврат ?(ТипЗнч(URI) = Тип("Строка"), URI, "");
	КонецЕсли;
	Части = Новый Массив;
	Части.Добавить(Разбор.Вид);
	Если Не ПустаяСтрока(Разбор.Объект) Тогда
		Части.Добавить(Разбор.Объект);
	КонецЕсли;
	Если Не ПустаяСтрока(Разбор.Ссылка) Тогда
		Части.Добавить(Разбор.Ссылка);
	КонецЕсли;
	Возврат ПрефиксURI() + СтрСоединить(Части, "/");

КонецФункции

// Подсказка кеширования содержимого ресурса (ttlMs): контекст с текущим временем сервера
// и данные объекта сразу устаревают, метаданные и глоссарий - как списки.
//
// Параметры:
//  Разбор - см. РазобратьURI
//  СрокСписков - Число - срок кеширования списков (настройка listTtlMs).
//
// Возвращаемое значение:
//  Число - миллисекунды.
//
Функция СрокКешированияРесурса(Разбор, СрокСписков) Экспорт

	Если Разбор = Неопределено Или Разбор.Вид = "context" Или Разбор.Вид = "object" Или СрокСписков < 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат СрокСписков;

КонецФункции

// Разбирает URI ресурса сервера: onec://context, onec://glossary, onec://metadata/<объект>,
// onec://object/<объект>/<ссылка>. Части пути могут быть в кодировке URL.
//
// Параметры:
//  URI - Строка - URI из params.uri.
//
// Возвращаемое значение:
//  - Неопределено - URI не относится к ресурсам сервера или некорректен.
//  - Структура:
//   * Вид - Строка - context, glossary, metadata или object.
//   * Объект - Строка - полное имя объекта для metadata и object.
//   * Ссылка - Строка - идентификатор ссылки для object.
//
Функция РазобратьURI(Знач URI) Экспорт

	Если ТипЗнч(URI) <> Тип("Строка") Или СтрДлина(URI) > МаксимальнаяДлинаURI() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Префикс = ПрефиксURI();
	Если НРег(Лев(URI, СтрДлина(Префикс))) <> Префикс Тогда
		Возврат Неопределено;
	КонецЕсли;
	Путь = Сред(URI, СтрДлина(Префикс) + 1);
	Если ПустаяСтрока(Путь) Или СтрНайти(Путь, "?") > 0 Или СтрНайти(Путь, "#") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Путь, "/", Истина) Цикл
		Раскодированная = РаскодированнаяЧастьURI(Часть);
		Если Раскодированная = Неопределено Или ПустаяСтрока(Раскодированная) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Части.Добавить(СокрЛП(Раскодированная));
	КонецЦикла;

	Результат = Новый Структура("Вид, Объект, Ссылка", "", "", "");
	Вид = НРег(Части[0]);
	Если (Вид = "context" Или Вид = "glossary") И Части.Количество() = 1 Тогда
		Результат.Вид = Вид;
	ИначеЕсли Вид = "metadata" И Части.Количество() = 2 Тогда
		Результат.Вид = Вид;
		Результат.Объект = Части[1];
	ИначеЕсли Вид = "object" И Части.Количество() = 3 Тогда
		Результат.Вид = Вид;
		Результат.Объект = Части[1];
		Результат.Ссылка = Части[2];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Тип содержимого ресурсов сервера.
//
// Возвращаемое значение:
//  Строка - application/json.
//
Функция ТипСодержимого() Экспорт

	Возврат "application/json";

КонецФункции

#КонецОбласти

#Область Глоссарий

// Глоссарий в едином виде: из настроек сервера или аргумента администратора.
//
// Параметры:
//  Значение - Произвольный - Соответствие (термин и определение) или Массив терминов
//             (Соответствие или Структура с ключами term и definition); прочие значения - пустой глоссарий.
//
// Возвращаемое значение:
//  Массив из Произвольный - термины (Соответствие): term, definition; повторы термина (без учета
//  регистра) заменяются последним определением.
//
Функция НормализованныйГлоссарий(Значение) Экспорт

	Пары = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Значение Цикл
			Пары.Добавить(Новый Структура("Термин, Определение", Элемент.Ключ, Элемент.Значение));
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Пары.Добавить(Новый Структура("Термин, Определение", ЗначениеКлюча(Элемент, "term"),
				ЗначениеКлюча(Элемент, "definition")));
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Массив;
	Индекс = Новый Соответствие;
	Для Каждого Пара Из Пары Цикл
		Если ТипЗнч(Пара.Термин) <> Тип("Строка") Или ТипЗнч(Пара.Определение) <> Тип("Строка")
			Или ПустаяСтрока(Пара.Термин) Или ПустаяСтрока(Пара.Определение) Тогда
			Продолжить;
		КонецЕсли;
		Термин = Лев(СокрЛП(Пара.Термин), 200);
		Определение = Лев(СокрЛП(Пара.Определение), 2000);
		Номер = Индекс.Получить(НРег(Термин));
		Если Номер <> Неопределено Тогда
			Результат[Номер].Вставить("definition", Определение);
			Продолжить;
		КонецЕсли;
		Если Результат.Количество() >= МаксимумТерминов() Тогда
			Прервать;
		КонецЕсли;
		Элемент = Новый Соответствие;
		Элемент.Вставить("term", Термин);
		Элемент.Вставить("definition", Определение);
		Индекс.Вставить(НРег(Термин), Результат.Количество());
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Глоссарий одной строкой для инструкций модели: «термин - определение; ...». Если текст длиннее
// предела, он обрезается по границе термина со ссылкой на ресурс onec://glossary.
//
// Параметры:
//  Глоссарий - Массив из Произвольный - см. НормализованныйГлоссарий.
//  Максимум - Число - предельная длина текста.
//
// Возвращаемое значение:
//  Строка - текст; пустая строка для пустого глоссария.
//
Функция ТекстГлоссария(Глоссарий, Максимум) Экспорт

	Части = Новый Массив;
	Длина = 0;
	Обрезано = Ложь;
	Для Каждого Элемент Из Глоссарий Цикл
		Часть = Элемент.Получить("term") + " - " + Элемент.Получить("definition");
		Если Длина + СтрДлина(Часть) + 2 > Максимум Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Части.Добавить(Часть);
		Длина = Длина + СтрДлина(Часть) + 2;
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат ?(Обрезано, "Глосарій бази - ресурс " + ПрефиксURI() + "glossary.", "");
	КонецЕсли;
	Текст = "Глосарій бази: " + СтрСоединить(Части, "; ");
	Если Обрезано Тогда
		Текст = Текст + "; ... (повністю - ресурс " + ПрефиксURI() + "glossary)";
	КонецЕсли;
	Возврат Текст + ".";

КонецФункции

// Начало глоссария в пределах суммарной длины терминов и определений - для get_context.
//
// Параметры:
//  Глоссарий - Массив из Произвольный - см. НормализованныйГлоссарий.
//  Максимум - Число - предельная суммарная длина.
//
// Возвращаемое значение:
//  Массив из Произвольный - первые термины (Соответствие): term, definition.
//
Функция НачалоГлоссария(Глоссарий, Максимум) Экспорт

	Результат = Новый Массив;
	Длина = 0;
	Для Каждого Элемент Из Глоссарий Цикл
		Длина = Длина + СтрДлина(Элемент.Получить("term")) + СтрДлина(Элемент.Получить("definition"));
		Если Длина > Максимум Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Промпты

// Аргумент промпта.
//
// Параметры:
//  Имя - Строка - имя аргумента (в тексте - {{имя}}).
//  Описание - Строка - пояснение для пользователя.
//  Обязательный - Булево - без значения промпт не формируется (если нет значения по умолчанию).
//  ЗначениеПоУмолчанию - Строка - значение, если клиент его не передал; может содержать {{today}}.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя аргумента.
//   * Описание - Строка - пояснение.
//   * Обязательный - Булево - обязательный аргумент.
//   * ЗначениеПоУмолчанию - Строка - значение по умолчанию.
//
Функция НовыйАргументПромпта(Имя, Описание = "", Обязательный = Ложь, ЗначениеПоУмолчанию = "") Экспорт

	Аргумент = Новый Структура;
	Аргумент.Вставить("Имя", СокрЛП(Имя));
	Аргумент.Вставить("Описание", СокрЛП(Описание));
	Аргумент.Вставить("Обязательный", Обязательный = Истина);
	Аргумент.Вставить("ЗначениеПоУмолчанию", СокрЛП(ЗначениеПоУмолчанию));
	Возврат Аргумент;

КонецФункции

// Описание промпта для prompts/list.
//
// Параметры:
//  Имя - Строка - имя промпта.
//  Заголовок - Строка - заголовок для пользователя.
//  Описание - Строка - пояснение.
//  Аргументы - Массив из см. НовыйАргументПромпта - аргументы.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - name, title, description, arguments (name, description, required).
//
Функция ОписаниеПромпта(Имя, Заголовок, Описание, Аргументы) Экспорт

	Результат = Новый Соответствие;
	Результат.Вставить("name", Имя);
	Если Не ПустаяСтрока(Заголовок) Тогда
		Результат.Вставить("title", СокрЛП(Заголовок));
	КонецЕсли;
	Если Не ПустаяСтрока(Описание) Тогда
		Результат.Вставить("description", СокрЛП(Описание));
	КонецЕсли;
	ОписанияАргументов = Новый Массив;
	Для Каждого Аргумент Из Аргументы Цикл
		ОписаниеАргумента = Новый Соответствие;
		ОписаниеАргумента.Вставить("name", Аргумент.Имя);
		Если Не ПустаяСтрока(Аргумент.Описание) Тогда
			ОписаниеАргумента.Вставить("description", Аргумент.Описание);
		КонецЕсли;
		// Аргумент со значением по умолчанию клиент может не передавать.
		ОписаниеАргумента.Вставить("required", Аргумент.Обязательный И ПустаяСтрока(Аргумент.ЗначениеПоУмолчанию));
		ОписанияАргументов.Добавить(ОписаниеАргумента);
	КонецЦикла;
	Если ОписанияАргументов.Количество() > 0 Тогда
		Результат.Вставить("arguments", ОписанияАргументов);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Текст промпта: в шаблоне {{имя}} заменяется значением аргумента (переданным или по умолчанию),
// {{today}} и другие встроенные значения - их значениями. Подставленные значения повторно
// не разбираются; неизвестные подстановки остаются как есть.
//
// Параметры:
//  Шаблон - Строка - текст промпта из справочника.
//  Аргументы - Массив из см. НовыйАргументПромпта - описания аргументов.
//  Значения - Произвольный - params.arguments: Соответствие строковых значений или Неопределено.
//  Встроенные - Соответствие из КлючИЗначение - встроенные значения (today):
//   * Ключ - Строка - имя.
//   * Значение - Строка - значение.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - текст промпта; пустая строка при ошибке.
//   * Ошибка - Строка - ошибка аргументов для ответа -32602; пустая строка, если ошибок нет.
//
Функция ТекстПромпта(Шаблон, Аргументы, Значения, Встроенные) Экспорт

	Результат = Новый Структура("Текст, Ошибка", "", "");
	Если Значения <> Неопределено И ТипЗнч(Значения) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "arguments must be an object";
		Возврат Результат;
	КонецЕсли;

	Описания = Новый Соответствие;
	Для Каждого Аргумент Из Аргументы Цикл
		Описания.Вставить(Аргумент.Имя, Аргумент);
	КонецЦикла;
	Если Значения <> Неопределено Тогда
		Для Каждого Элемент Из Значения Цикл
			Если Описания.Получить(Элемент.Ключ) = Неопределено Тогда
				Результат.Ошибка = "Unknown argument: " + Лев(Элемент.Ключ, 64);
				Возврат Результат;
			ИначеЕсли ТипЗнч(Элемент.Значение) <> Тип("Строка") Тогда
				Результат.Ошибка = СтрШаблон("Argument %1 must be a string", Элемент.Ключ);
				Возврат Результат;
			ИначеЕсли СтрДлина(Элемент.Значение) > МаксимальнаяДлинаАргумента() Тогда
				Результат.Ошибка = СтрШаблон("Argument %1 is longer than %2 characters", Элемент.Ключ,
					Формат(МаксимальнаяДлинаАргумента(), "ЧГ=0"));
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Подстановки = Новый Соответствие;
	Для Каждого Элемент Из Встроенные Цикл
		Подстановки.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Для Каждого Аргумент Из Аргументы Цикл
		Значение = ?(Значения = Неопределено, Неопределено, Значения.Получить(Аргумент.Имя));
		Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
			Значение = Подставить(Аргумент.ЗначениеПоУмолчанию, Встроенные);
		КонецЕсли;
		Если ПустаяСтрока(Значение) И Аргумент.Обязательный Тогда
			Результат.Ошибка = "Missing required argument: " + Аргумент.Имя;
			Возврат Результат;
		КонецЕсли;
		Подстановки.Вставить(Аргумент.Имя, Значение);
	КонецЦикла;
	Результат.Текст = Подставить(Шаблон, Подстановки);
	Возврат Результат;

КонецФункции

// Встроенные подстановки текста промпта.
//
// Параметры:
//  ДатаСеанса - Дата - текущая дата сервера.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - подстановки:
//   * Ключ - Строка - имя (today).
//   * Значение - Строка - значение.
//
Функция ВстроенныеПодстановки(ДатаСеанса) Экспорт

	Результат = Новый Соответствие;
	Результат.Вставить("today", Лев(mcp1c_Служебный.ДатаВСтроку(ДатаСеанса), 10));
	Возврат Результат;

КонецФункции


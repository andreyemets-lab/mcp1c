///////////////////////////////////////////////////////////////////////////////
// mcp1c_Служебный: заголовки HTTP, хеширование, base64url, случайные данные,
// безопасное чтение свойств разобранного JSON.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область HTTP

// Возвращает значение заголовка HTTP-запроса без учета регистра имени.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос.
//  ИмяЗаголовка - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение заголовка; Неопределено, если заголовок не передан.
//
Функция ЗаголовокЗапроса(Запрос, ИмяЗаголовка) Экспорт

	ИмяВНижнемРегистре = НРег(ИмяЗаголовка);
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = ИмяВНижнемРегистре Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает значение параметра строки запроса без учета регистра имени.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос.
//  ИмяПараметра - Строка - имя параметра.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение параметра; Неопределено, если параметр не передан.
//
Функция ПараметрСтрокиЗапроса(Запрос, ИмяПараметра) Экспорт

	ИмяВНижнемРегистре = НРег(ИмяПараметра);
	Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
		Если НРег(Параметр.Ключ) = ИмяВНижнемРегистре Тогда
			Возврат Параметр.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Декодирует значение заголовка в формате "=?base64?<данные>?=" (MCP 2026-07-28, Value Encoding).
// Значения без маркера возвращаются как есть.
//
// Параметры:
//  Значение - Строка, Неопределено - значение заголовка.
//
// Возвращаемое значение:
//  Строка, Неопределено - декодированное значение; Неопределено, если маркер есть, а данные некорректны.
//
Функция ДекодироватьЗначениеЗаголовка(Знач Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Префикс = "=?base64?";
	Суффикс = "?=";
	Если Не (СтрНачинаетсяС(Значение, Префикс) И СтрЗаканчиваетсяНа(Значение, Суффикс)) Тогда
		Возврат Значение;
	КонецЕсли;

	ДлинаДанных = СтрДлина(Значение) - СтрДлина(Префикс) - СтрДлина(Суффикс);
	Если ДлинаДанных <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеBase64 = Сред(Значение, СтрДлина(Префикс) + 1, ДлинаДанных);
	Если Не СостоитИзСимволов(ДанныеBase64, АлфавитBase64() + "=") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Данные = ПолучитьДвоичныеДанныеИзBase64Строки(ДанныеBase64);
		Если Данные = Неопределено Или Данные.Размер() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Криптография

// Вычисляет SHA-256 строки в кодировке UTF-8.
//
// Параметры:
//  Текст - Строка - исходная строка.
//
// Возвращаемое значение:
//  Строка - шестнадцатеричное представление хеша в нижнем регистре (64 символа).
//
Функция ХешSHA256(Знач Текст) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Возвращает 32 байта данных для секретов.
// Встроенный ГенераторСлучайныхЧисел не является криптостойким, поэтому источники
// энтропии (UUID версии 4, ГСЧ, время) смешиваются через SHA-256.
// Источник энтропии UUID на целевых ОС проверяется на этапе прототипа.
//
// Возвращаемое значение:
//  ДвоичныеДанные - 32 байта.
//
Функция СлучайныеДанные() Экспорт

	Генератор = Новый ГенераторСлучайныхЧисел();
	Части = Новый Массив;
	Для НомерЧасти = 1 По 4 Цикл
		Части.Добавить(Формат(НомерЧасти, "ЧГ=0") + ":" + Строка(Новый УникальныйИдентификатор));
		Части.Добавить(Формат(Генератор.СлучайноеЧисло(0, 4294967295), "ЧН=0; ЧГ=0"));
	КонецЦикла;
	Части.Добавить(Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧН=0; ЧГ=0"));

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Части, "|"), КодировкаТекста.UTF8, Ложь));
	Возврат Хеширование.ХешСумма;

КонецФункции

// Строка из символов алфавита base32 (RFC 4648), полученная из случайных данных.
//
// Параметры:
//  Количество - Число - длина строки, не более 32.
//
// Возвращаемое значение:
//  Строка - например, "7KQ2MZ4ARXDP".
//
Функция СлучайнаяСтрокаBase32(Количество) Экспорт

	Алфавит = АлфавитBase32();
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(СлучайныеДанные());
	Результат = "";
	Для Индекс = 0 По Мин(Количество, Буфер.Размер) - 1 Цикл
		Результат = Результат + Сред(Алфавит, Буфер[Индекс] % 32 + 1, 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Base64URL

// Кодирует двоичные данные в base64url без выравнивания (RFC 4648, раздел 5).
//
// Параметры:
//  Данные - ДвоичныеДанные - исходные данные.
//
// Возвращаемое значение:
//  Строка - закодированные данные.
//
Функция КодироватьBase64URL(Данные) Экспорт

	Результат = ПолучитьBase64СтрокуИзДвоичныхДанных(Данные);
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, "+", "-");
	Результат = СтрЗаменить(Результат, "/", "_");
	Результат = СтрЗаменить(Результат, "=", "");
	Возврат Результат;

КонецФункции

// Декодирует строку base64url без выравнивания.
//
// Параметры:
//  Текст - Строка - закодированные данные.
//
// Возвращаемое значение:
//  ДвоичныеДанные, Неопределено - декодированные данные; Неопределено при ошибке формата.
//
Функция ДекодироватьBase64URL(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не СостоитИзСимволов(Текст, АлфавитBase64URL()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Текст = СтрЗаменить(Текст, "-", "+");
	Текст = СтрЗаменить(Текст, "_", "/");
	Остаток = СтрДлина(Текст) % 4;
	Если Остаток = 1 Тогда
		Возврат Неопределено;
	ИначеЕсли Остаток > 0 Тогда
		Текст = Текст + Лев("==", 4 - Остаток);
	КонецЕсли;

	Попытка
		Данные = ПолучитьДвоичныеДанныеИзBase64Строки(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Данные = Неопределено Или Данные.Размер() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Данные;

КонецФункции

// Кодирует строку (UTF-8) в base64url.
//
// Параметры:
//  Текст - Строка - исходная строка.
//
// Возвращаемое значение:
//  Строка - закодированная строка.
//
Функция КодироватьСтрокуBase64URL(Текст) Экспорт

	Возврат КодироватьBase64URL(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));

КонецФункции

// Декодирует base64url в строку (UTF-8).
//
// Параметры:
//  Текст - Строка - закодированная строка.
//
// Возвращаемое значение:
//  Строка, Неопределено - исходная строка; Неопределено при ошибке формата.
//
Функция ДекодироватьСтрокуBase64URL(Текст) Экспорт

	Данные = ДекодироватьBase64URL(Текст);
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);

КонецФункции

#КонецОбласти

#Область Строки

// Проверяет, что строка состоит только из символов алфавита (с учетом регистра).
//
// Параметры:
//  Текст - Строка - проверяемая строка.
//  Алфавит - Строка - допустимые символы.
//
// Возвращаемое значение:
//  Булево - Истина, если все символы допустимы.
//
Функция СостоитИзСимволов(Текст, Алфавит) Экспорт

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти(Алфавит, Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Алфавит base32 (RFC 4648).
//
// Возвращаемое значение:
//  Строка - 32 символа.
//
Функция АлфавитBase32() Экспорт

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";

КонецФункции

// Алфавит base64url (RFC 4648, раздел 5) без символа выравнивания.
//
// Возвращаемое значение:
//  Строка - 64 символа.
//
Функция АлфавитBase64URL() Экспорт

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

КонецФункции

// Алфавит base64 (RFC 4648, раздел 4) без символа выравнивания.
//
// Возвращаемое значение:
//  Строка - 64 символа.
//
Функция АлфавитBase64() Экспорт

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

КонецФункции

#КонецОбласти

#Область Даты

// Представление даты в формате ISO 8601 без смещения: ГГГГ-ММ-ДДTчч:мм:сс.
//
// Параметры:
//  Значение - Дата - дата.
//
// Возвращаемое значение:
//  Строка - представление даты.
//
Функция ДатаВСтроку(Значение) Экспорт

	Возврат XMLСтрока(Значение);

КонецФункции

// Разбирает дату в формате ISO 8601 (ГГГГ-ММ-ДДTчч:мм:сс, допускается суффикс Z).
//
// Параметры:
//  Текст - Строка - представление даты.
//
// Возвращаемое значение:
//  Дата, Неопределено - дата; Неопределено при ошибке формата.
//
Функция СтрокаВДату(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Текст, "Z") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает дату из аргументов инструментов: ГГГГ-ММ-ДД, ГГГГ-ММ-ДДTчч:мм или ГГГГ-ММ-ДДTчч:мм:сс
// (вместо T допускается пробел, дробная часть секунд отбрасывается). Часовой пояс не допускается:
// даты в аргументах - местное время сервера (п. 5.4 ТЗ).
//
// Параметры:
//  Текст - Строка - представление даты.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено при ошибке формата или несуществующей дате:
//   * Дата - Дата - дата.
//   * ТолькоДата - Булево - время не указано.
//
Функция РазобратьДату(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) < 10 Или Сред(Текст, 5, 1) <> "-" Или Сред(Текст, 8, 1) <> "-" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Год_ = ЧислоИзЦифр(Лев(Текст, 4));
	Месяц_ = ЧислоИзЦифр(Сред(Текст, 6, 2));
	День_ = ЧислоИзЦифр(Сред(Текст, 9, 2));
	Время = ЧастиВремени(Сред(Текст, 11));
	Если Год_ = Неопределено Или Месяц_ = Неопределено Или День_ = Неопределено Или Время = Неопределено
		Или Год_ < 1 Или Месяц_ < 1 Или Месяц_ > 12 Или День_ < 1 Или День_ > 31 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Значение = Дата(Год_, Месяц_, День_, Время.Час, Время.Минута, Время.Секунда);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Месяц(Значение) <> Месяц_ Или День(Значение) <> День_ Тогда
		Возврат Неопределено; // 30 февраля и подобные
	КонецЕсли;
	Возврат Новый Структура("Дата, ТолькоДата", Значение, Время.ТолькоДата);

КонецФункции

#КонецОбласти

#Область ЧтениеСвойств

// Проверяет наличие ключа в соответствии (в том числе ключа со значением null).
//
// Параметры:
//  Объект - Соответствие - объект JSON.
//  Ключ - Строка - имя свойства.
//
// Возвращаемое значение:
//  Булево - Истина, если ключ есть.
//
Функция ЕстьКлюч(Объект, Ключ) Экспорт

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Элемент Из Объект Цикл
		Если Элемент.Ключ = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Значение свойства объекта JSON.
//
// Параметры:
//  Объект - Соответствие, Произвольный - объект JSON.
//  Ключ - Строка - имя свойства.
//  ПоУмолчанию - Произвольный - значение, если свойства нет или объект не Соответствие.
//
// Возвращаемое значение:
//  Произвольный - значение свойства.
//
Функция Свойство(Объект, Ключ, ПоУмолчанию = Неопределено) Экспорт

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = Объект.Получить(Ключ);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);

КонецФункции

// Строковое свойство объекта JSON; значения другого типа заменяются значением по умолчанию.
//
// Параметры:
//  Объект - Соответствие - объект JSON.
//  Ключ - Строка - имя свойства.
//  ПоУмолчанию - Строка - значение по умолчанию.
//
// Возвращаемое значение:
//  Строка - значение свойства.
//
Функция СвойствоСтрока(Объект, Ключ, ПоУмолчанию = "") Экспорт

	Значение = Свойство(Объект, Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, ПоУмолчанию);

КонецФункции

// Числовое свойство объекта JSON; значения другого типа заменяются значением по умолчанию.
//
// Параметры:
//  Объект - Соответствие - объект JSON.
//  Ключ - Строка - имя свойства.
//  ПоУмолчанию - Число - значение по умолчанию.
//
// Возвращаемое значение:
//  Число - значение свойства.
//
Функция СвойствоЧисло(Объект, Ключ, ПоУмолчанию = 0) Экспорт

	Значение = Свойство(Объект, Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, ПоУмолчанию);

КонецФункции

// Булево свойство объекта JSON; значения другого типа заменяются значением по умолчанию.
//
// Параметры:
//  Объект - Соответствие - объект JSON.
//  Ключ - Строка - имя свойства.
//  ПоУмолчанию - Булево - значение по умолчанию.
//
// Возвращаемое значение:
//  Булево - значение свойства.
//
Функция СвойствоБулево(Объект, Ключ, ПоУмолчанию = Ложь) Экспорт

	Значение = Свойство(Объект, Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, ПоУмолчанию);

КонецФункции

// Свойство-массив объекта JSON; если свойства нет или оно другого типа, возвращается новый пустой массив.
//
// Параметры:
//  Объект - Соответствие - объект JSON.
//  Ключ - Строка - имя свойства.
//
// Возвращаемое значение:
//  Массив - значение свойства.
//
Функция СвойствоМассив(Объект, Ключ) Экспорт

	Значение = Свойство(Объект, Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Массив"), Значение, Новый Массив);

КонецФункции


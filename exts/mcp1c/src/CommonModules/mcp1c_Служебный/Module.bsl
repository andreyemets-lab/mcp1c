#Область СлужебныеПроцедурыИФункции

Функция ЧислоИзЦифр(Текст)
	// Неотрицательное целое из десятичных цифр; Неопределено, если есть другие символы.

	Если ПустаяСтрока(Текст) Или Не СостоитИзСимволов(Текст, "0123456789") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Текст);

КонецФункции

Функция ЧастиВремени(Знач Текст)
	// Час, минута и секунда из хвоста даты: пусто, "Tчч:мм", "Tчч:мм:сс" или "Tчч:мм:сс.дробь".

	Результат = Новый Структура("Час, Минута, Секунда, ТолькоДата", 0, 0, 0, Истина);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Разделитель = Лев(Текст, 1);
	Если Разделитель <> "T" И Разделитель <> "t" И Разделитель <> " " Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = Сред(Текст, 2);
	Точка = СтрНайти(Текст, ".");
	Если Точка > 0 Тогда
		Если ЧислоИзЦифр(Сред(Текст, Точка + 1)) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Текст = Лев(Текст, Точка - 1);
	КонецЕсли;

	Части = СтрРазделить(Текст, ":", Истина);
	Если Части.Количество() < 2 Или Части.Количество() > 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значения = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Значение = ?(СтрДлина(Часть) = 2, ЧислоИзЦифр(Часть), Неопределено);
		Если Значение = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значения.Добавить(Значение);
	КонецЦикла;
	Если Значения.Количество() = 2 Тогда
		Значения.Добавить(0);
	КонецЕсли;
	Если Значения[0] > 23 Или Значения[1] > 59 Или Значения[2] > 59 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат.Час = Значения[0];
	Результат.Минута = Значения[1];
	Результат.Секунда = Значения[2];
	Результат.ТолькоДата = Ложь;
	Возврат Результат;

КонецФункции

#КонецОбласти

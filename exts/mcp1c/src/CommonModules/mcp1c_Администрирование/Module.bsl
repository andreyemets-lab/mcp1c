///////////////////////////////////////////////////////////////////////////////
// mcp1c_Администрирование: управление сервером и токенами.
//
// Каждый метод проверяет, что текущий пользователь имеет право Администрирование
// или роль mcp1c_Администратор, и работает с данными по правам этой роли.
// Методы вызываются из команд подсистемы "MCP-сервер" (mcp1c_АдминистрированиеВызовСервера)
// или из кода администратора.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Сервер

// Включает сервер. Если привязка к ИБ еще не задана, ее зафиксирует первый
// аутентифицированный запрос через веб-публикацию (п. 6.6 ТЗ).
//
// Параметры:
//  КаноническийАдрес - Строка - публичный адрес MCP-эндпоинта, например "https://mcp.company.ua/mcp".
//
Процедура ВключитьСервер(Знач КаноническийАдрес = "") Экспорт

	ПроверитьПраваАдминистратора();
	КаноническийАдрес = ПроверенныйАдрес(КаноническийАдрес);

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить("enabled", Истина);
		Если Не ПустаяСтрока(КаноническийАдрес) Тогда
			Настройки.Вставить("canonicalUrl", КаноническийАдрес);
		КонецЕсли;
		mcp1c_Настройки.ЗаполнитьСекреты(Настройки);
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Сервер включен пользователем %1",
		ИмяТекущегоПользователя()));

КонецПроцедуры

// Выключает сервер: все запросы получают ответ 503.
//
Процедура ВыключитьСервер() Экспорт

	ИзменитьНастройку("enabled", Ложь);

КонецПроцедуры

// Устанавливает публичный адрес MCP-эндпоинта для фрагментов подключения, не меняя состояния сервера.
//
// Параметры:
//  КаноническийАдрес - Строка - например, "https://mcp.company.ua/mcp"; пустая строка - адрес не задан.
//
Процедура УстановитьКаноническийАдрес(Знач КаноническийАдрес) Экспорт

	ИзменитьНастройку("canonicalUrl", ПроверенныйАдрес(КаноническийАдрес));

КонецПроцедуры

// Подтверждает новое расположение ИБ после переноса или восстановления из копии.
// Пока перенос не подтвержден, сервер отвечает 503. После подтверждения привязку
// к новому расположению фиксирует первый аутентифицированный запрос.
//
// Параметры:
//  ОтозватьВсеТокены - Булево - отозвать все действующие токены (рекомендуется для копий баз).
//
Процедура ПодтвердитьПереносИнформационнойБазы(ОтозватьВсеТокены = Истина) Экспорт

	ПроверитьПраваАдминистратора();

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить("ibBinding", "");
		mcp1c_Настройки.Записать(Настройки);
		Если ОтозватьВсеТокены Тогда
			ОтозватьТокены(ДействующиеТокены());
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон(
		"Перенос ИБ подтвержден пользователем %1, токены отозваны: %2",
		ИмяТекущегоПользователя(), Формат(ОтозватьВсеТокены, "БЛ=нет; БИ=да")));

КонецПроцедуры

// Устанавливает разрешенные значения заголовка Origin (браузерные клиенты).
// Запросы с другим Origin получают 403; запросы без Origin разрешены.
// Дополнительные значения задаются в клиенте доступа.
//
// Параметры:
//  Источники - Массив из Строка - например, "https://claude.ai".
//
Процедура УстановитьРазрешенныеИсточники(Источники) Экспорт

	Нормализованные = Новый Массив;
	Для Каждого Источник Из Источники Цикл
		Значение = НормализованныйИсточник(Источник);
		Если Не ПустаяСтрока(Значение) И Нормализованные.Найти(Значение) = Неопределено Тогда
			Нормализованные.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	ИзменитьНастройку("allowedOrigins", Нормализованные);

КонецПроцедуры

// Устанавливает имя заголовка, в котором доверенный реверс-прокси передает IP клиента.
// Пустое имя отключает ограничения и блокировки по IP.
//
// Параметры:
//  ИмяЗаголовка - Строка - например, "X-Real-IP".
//
Процедура УстановитьЗаголовокАдресаКлиента(ИмяЗаголовка) Экспорт

	ИзменитьНастройку("clientIpHeader", СокрЛП(ИмяЗаголовка));

КонецПроцедуры

// Устанавливает дополнительный текст инструкций для модели (особенности базы).
//
// Параметры:
//  Текст - Строка - текст инструкций.
//
Процедура УстановитьИнструкции(Текст) Экспорт

	ИзменитьНастройку("instructions", СокрЛП(Текст));

КонецПроцедуры

// Устанавливает глоссарий базы (п. 5.6, 5.7 ТЗ): термины попадают в инструкции для модели,
// в get_context и в ресурс onec://glossary. Пустые термины пропускаются, повторы термина
// (без учета регистра) заменяются последним определением.
//
// Параметры:
//  Термины - Произвольный - Соответствие (термин и определение) или Массив терминов (Структура
//            или Соответствие с ключами term и definition); пустое значение очищает глоссарий.
//
Процедура УстановитьГлоссарий(Термины) Экспорт

	ИзменитьНастройку("glossary", mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(Термины));

КонецПроцедуры

// Устанавливает срок хранения журнала вызовов (п. 8.1 ТЗ): записи старше срока удаляет
// регламентное задание mcp1c_ОчисткаЖурналаВызовов.
//
// Параметры:
//  Дней - Число - срок хранения в днях, не меньше 7; 0 - журнал не очищается.
//
Процедура УстановитьСрокХраненияЖурнала(Знач Дней) Экспорт

	Дней = Цел(Дней);
	Если Дней < 0 Или Дней > 0 И Дней < 7 Тогда
		ВызватьИсключение "Термін зберігання журналу викликів - щонайменше 7 днів (0 - не очищати)";
	КонецЕсли;
	ИзменитьНастройку("logRetentionDays", Дней);

КонецПроцедуры

// Снимает автоблокировку клиента доступа, установленную после серии отказов политики.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент доступа.
//
Процедура СнятьБлокировкуКлиента(Клиент) Экспорт

	ПроверитьПраваАдминистратора();
	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.mcp1c_КлиентыДоступа") Или Клиент.Пустая() Тогда
		ВызватьИсключение "Не вказано клієнта доступу";
	КонецЕсли;
	mcp1c_Лимиты.СнятьБлокировкуКлиента(Клиент);
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Пользователь %1 снял блокировку клиента доступа %2",
		ИмяТекущегоПользователя(), Клиент));

КонецПроцедуры

// Снимает блокировку IP-адреса, установленную после серии неудачных аутентификаций.
//
// Параметры:
//  Адрес - Строка - IP-адрес.
//
Процедура СнятьБлокировкуАдреса(Знач Адрес) Экспорт

	ПроверитьПраваАдминистратора();
	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Не вказано IP-адресу";
	КонецЕсли;
	mcp1c_Лимиты.СнятьБлокировкуАдреса(Адрес);
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Пользователь %1 снял блокировку IP-адреса %2",
		ИмяТекущегоПользователя(), Адрес));

КонецПроцедуры

// Устанавливает шаблоны фрагментов подключения клиентов, которые показываются при выпуске токена (п. 9.3 ТЗ).
// Подстановки: {url}, {token}, {header}, {allow_http} (см. mcp1c_ПодключениеКлиентов).
//
// Параметры:
//  Шаблоны - Массив из Произвольный - Соответствие или Структура с ключами title и text; пустой массив -
//            шаблоны по умолчанию.
//
Процедура УстановитьШаблоныПодключения(Шаблоны) Экспорт

	Ошибки = mcp1c_ПодключениеКлиентов.ОшибкиШаблонов(Шаблоны);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Нормализованные = Новый Массив;
	Для Каждого Шаблон Из Шаблоны Цикл
		Элемент = Новый Соответствие;
		Элемент.Вставить("title", СокрЛП(Шаблон["title"]));
		Элемент.Вставить("text", Шаблон["text"]);
		Нормализованные.Добавить(Элемент);
	КонецЦикла;
	ИзменитьНастройку("connectionTemplates", Нормализованные);

КонецПроцедуры

// Устанавливает шаблоны глобально запрещенных полей (п. 7.6 ТЗ), например "*Пароль*".
// Запреты действуют для всех профилей, включая доверенные.
//
// Параметры:
//  Шаблоны - Массив из Строка - шаблоны имен полей; * - любая последовательность символов.
//
Процедура УстановитьЗапрещенныеПоля(Шаблоны) Экспорт

	ИзменитьНастройку("bannedFieldPatterns", НепустыеСтроки(Шаблоны));

КонецПроцедуры

// Устанавливает шаблоны глобально запрещенных объектов (п. 7.6 ТЗ), например "ПланОбмена.*".
//
// Параметры:
//  Шаблоны - Массив из Строка - шаблоны полных имен объектов.
//
Процедура УстановитьЗапрещенныеОбъекты(Шаблоны) Экспорт

	ИзменитьНастройку("bannedObjectPatterns", НепустыеСтроки(Шаблоны));

КонецПроцедуры

// Настройки сервера без секретов - для просмотра администратором.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция ОписаниеНастроек() Экспорт

	ПроверитьПраваАдминистратора();

	Результат = Новый Соответствие;
	Для Каждого Элемент Из mcp1c_Настройки.Получить() Цикл
		Если mcp1c_Настройки.СекретныеКлючи().Найти(Элемент.Ключ) = Неопределено Тогда
			Результат.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("ibBindingPending", ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Результат, "ibBinding")));
	Возврат mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Результат);

КонецФункции

#КонецОбласти

#Область Токены

// Выпускает новый токен доступа. Значение токена возвращается один раз;
// в базе хранится только SHA-256 секрета.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - кому выдан токен.
//  СрокДействияДней - Число - срок действия в днях; 0 - срок по умолчанию (defaultTokenDays).
//  Комментарий - Строка - произвольный комментарий.
//  ОбластьТокена - Строка, Массив из Строка - инструменты, которыми ограничен токен (п. 6.3 ТЗ): область
//                  сужает возможности профиля и не расширяет их; пустая - все возможности профиля.
//
// Возвращаемое значение:
//  Структура:
//   * Токен - Строка - значение для заголовка Authorization: Bearer.
//   * Идентификатор - Строка - id токена.
//   * Ссылка - СправочникСсылка.mcp1c_ТокеныДоступа - запись токена.
//   * ДействуетДо - Дата - дата окончания действия (UTC).
//   * Фрагменты - Строка - готовые настройки клиентов с токеном (п. 9.3 ТЗ).
//   * ФрагментыПодключения - Строка - токен, срок действия и готовые настройки клиентов.
//
Функция ВыпуститьТокен(Клиент, Знач СрокДействияДней = 0, Знач Комментарий = "", Знач ОбластьТокена = "") Экспорт

	ПроверитьПраваАдминистратора();
	ПроверитьКлиента(Клиент);

	Настройки = mcp1c_Настройки.Получить();
	МаксимумДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "maxTokenDays", 90);
	Если СрокДействияДней <= 0 Тогда
		СрокДействияДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "defaultTokenDays", 30);
	КонецЕсли;
	Если СрокДействияДней > МаксимумДней Тогда
		ВызватьИсключение СтрШаблон("Термін дії токена не може перевищувати %1 дн.", МаксимумДней);
	КонецЕсли;

	НовыйТокен = mcp1c_Аутентификация.НовыйТокен();
	Пока mcp1c_Аутентификация.ТокенПоИдентификатору(НовыйТокен.Идентификатор) <> Неопределено Цикл
		НовыйТокен = mcp1c_Аутентификация.НовыйТокен();
	КонецЦикла;

	Сейчас = ТекущаяУниверсальнаяДата();
	ДействуетДо = Сейчас + Цел(СрокДействияДней) * 86400;
	Комментарий = СокрЛП(Комментарий);
	ОбластьТокена = mcp1c_ПравилаДоступа.НормализованнаяОбласть(ОбластьТокена);
	Если СтрДлина(ОбластьТокена) > 1000 Тогда
		ВызватьИсключение "Область токена довша за 1000 символів: виберіть менше інструментів";
	КонецЕсли;

	Объект = Справочники.mcp1c_ТокеныДоступа.СоздатьЭлемент();
	Объект.Владелец = Клиент;
	Объект.Код = НовыйТокен.Идентификатор;
	Объект.Наименование = ?(ПустаяСтрока(Комментарий),
		СтрШаблон("Токен від %1", Формат(Сейчас, "ДЛФ=D")), Лев(Комментарий, 100));
	Объект.Хеш = НовыйТокен.Хеш;
	Объект.ДатаВыпуска = Сейчас;
	Объект.ДействуетДо = ДействуетДо;
	Объект.Автор = ИмяТекущегоПользователя();
	Объект.ОбластьДоступа = ОбластьТокена;
	Объект.Записать();

	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон(
		"Выпущен токен %1 для клиента ""%2"" пользователем %3, действует до %4 UTC, область: %5",
		НовыйТокен.Идентификатор, Строка(Клиент), ИмяТекущегоПользователя(), mcp1c_Служебный.ДатаВСтроку(ДействуетДо),
		?(ПустаяСтрока(ОбластьТокена), "все возможности профиля", ОбластьТокена)));

	Результат = Новый Структура;
	Результат.Вставить("Токен", НовыйТокен.Токен);
	Результат.Вставить("Идентификатор", НовыйТокен.Идентификатор);
	Результат.Вставить("Ссылка", Объект.Ссылка);
	Результат.Вставить("ДействуетДо", ДействуетДо);
	Фрагменты = mcp1c_ПодключениеКлиентов.ФрагментыПодключения(
		mcp1c_Служебный.СвойствоМассив(Настройки, "connectionTemplates"), НовыйТокен.Токен,
		mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl"));
	Результат.Вставить("Фрагменты", Фрагменты);
	Результат.Вставить("ФрагментыПодключения", СтрШаблон("Токен (показується один раз, діє до %1 UTC):
		|%2
		|
		|%3", mcp1c_Служебный.ДатаВСтроку(ДействуетДо), НовыйТокен.Токен, Фрагменты));
	Возврат Результат;

КонецФункции

// Отзывает токен. Отзыв действует со следующего запроса.
//
// Параметры:
//  Токен - СправочникСсылка.mcp1c_ТокеныДоступа, Строка - ссылка, id токена (12 символов) или полное значение.
//
Процедура ОтозватьТокен(Токен) Экспорт

	ПроверитьПраваАдминистратора();

	Ссылка = Токен;
	Если ТипЗнч(Токен) = Тип("Строка") Тогда
		Ссылка = mcp1c_Аутентификация.ТокенПоИдентификатору(ИдентификаторИзЗначения(Токен));
	КонецЕсли;
	Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.mcp1c_ТокеныДоступа") Или Ссылка.Пустая() Тогда
		ВызватьИсключение "Токен не знайдено";
	КонецЕсли;

	Токены = Новый Массив;
	Токены.Добавить(Ссылка);
	ОтозватьТокены(Токены);

КонецПроцедуры

// Помечает на удаление отозванные и истекшие токены старше указанного количества дней.
// Помеченные токены удаляет штатная обработка удаления помеченных объектов.
//
// Параметры:
//  ХранитьДней - Число - сколько дней хранить недействующие записи для аудита.
//
// Возвращаемое значение:
//  Число - количество помеченных записей.
//
Функция ПометитьНедействующиеТокены(ХранитьДней = 30) Экспорт

	ПроверитьПраваАдминистратора();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Токены.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.ПометкаУдаления
	|	И Токены.ДействуетДо < &Граница
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Токены.Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.ПометкаУдаления
	|	И Токены.Отозван
	|	И Токены.ДатаОтзыва < &Граница";
	Запрос.УстановитьПараметр("Граница", ТекущаяУниверсальнаяДата() - ХранитьДней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();

	Помечено = 0;
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		Помечено = Помечено + 1;
	КонецЦикла;

	Если Помечено > 0 Тогда
		mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Помечено на удаление недействующих токенов: %1 (пользователь %2)",
			Помечено, ИмяТекущегоПользователя()));
	КонецЕсли;
	Возврат Помечено;

КонецФункции

// Список токенов без хешей с временем последнего использования по журналу вызовов.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - отбор по клиенту.
//
// Возвращаемое значение:
//  Массив из Структура - Ссылка, Идентификатор, Клиент, Наименование, ДатаВыпуска, ДействуетДо,
//                        Отозван, Действует, ОбластьДоступа (пустая - все возможности профиля),
//                        ПоследнееИспользование (UTC, Неопределено - не использовался).
//
Функция СписокТокенов(Клиент = Неопределено) Экспорт

	ПроверитьПраваАдминистратора();

	// Условие с параметром-флагом: ИЛИ не мешает индексу, отбор по клиенту необязателен.
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.ИдентификаторТокена КАК ИдентификаторТокена,
	|	МАКСИМУМ(Журнал.Момент) КАК ПоследнееИспользование
	|ПОМЕСТИТЬ ВТ_Использование
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Результат <> ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.ОтказАутентификации)
	|	И Журнал.ИдентификаторТокена <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.ИдентификаторТокена
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторТокена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Токены.Ссылка КАК Ссылка,
	|	Токены.Код КАК Идентификатор,
	|	Токены.Владелец КАК Клиент,
	|	Токены.Наименование КАК Наименование,
	|	Токены.ДатаВыпуска КАК ДатаВыпуска,
	|	Токены.ДействуетДо КАК ДействуетДо,
	|	Токены.Отозван КАК Отозван,
	|	Токены.ОбластьДоступа КАК ОбластьДоступа,
	|	Использование.ПоследнееИспользование КАК ПоследнееИспользование
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Использование КАК Использование
	|		ПО Токены.Код = Использование.ИдентификаторТокена
	|ГДЕ
	|	(&ВсеКлиенты
	|			ИЛИ Токены.Владелец = &Клиент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВыпуска УБЫВ";
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	Запрос.УстановитьПараметр("ВсеКлиенты", Клиент = Неопределено);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();

	Сейчас = ТекущаяУниверсальнаяДата();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура;
		Описание.Вставить("Ссылка", Выборка.Ссылка);
		Описание.Вставить("Идентификатор", Выборка.Идентификатор);
		Описание.Вставить("Клиент", Выборка.Клиент);
		Описание.Вставить("Наименование", Выборка.Наименование);
		Описание.Вставить("ДатаВыпуска", Выборка.ДатаВыпуска);
		Описание.Вставить("ДействуетДо", Выборка.ДействуетДо);
		Описание.Вставить("Отозван", Выборка.Отозван);
		Описание.Вставить("Действует", Не Выборка.Отозван И Выборка.ДействуетДо > Сейчас);
		Описание.Вставить("ОбластьДоступа", Выборка.ОбластьДоступа);
		Описание.Вставить("ПоследнееИспользование",
			?(ЗначениеЗаполнено(Выборка.ПоследнееИспользование), Выборка.ПоследнееИспользование, Неопределено));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет права администратора MCP; при отсутствии прав вызывает исключение.
//
Процедура ПроверитьПраваАдминистратора() Экспорт

	Если ЕстьПраваАдминистратора() Тогда
		Возврат;
	КонецЕсли;
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон(
		"Отказ в доступе к администрированию MCP для пользователя %1", ИмяТекущегоПользователя()));
	ВызватьИсключение "Недостатньо прав: потрібне право Администрирование або роль mcp1c_Администратор";

КонецПроцедуры

// Есть ли у текущего пользователя права администратора MCP.
//
// Возвращаемое значение:
//  Булево - Истина, если есть право Администрирование или права роли mcp1c_Администратор.
//
Функция ЕстьПраваАдминистратора() Экспорт

	// Модуль не привилегированный: проверки выполняются по правам текущего пользователя.
	// Добавлять токены может только роль mcp1c_Администратор (у mcp1c_Сервис и mcp1c_Аудитор - только чтение).
	Возврат ПравоДоступа("Добавление", Метаданные.Справочники.mcp1c_ТокеныДоступа)
		Или ПравоДоступа("Администрирование", Метаданные);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверенныйАдрес(Знач Адрес)
	// Публичный адрес без пробелов по краям; адрес должен начинаться с https:// (http:// - для локальной сети).

	Адрес = СокрЛП(Адрес);
	Если Не ПустаяСтрока(Адрес) И Не СтрНачинаетсяС(НРег(Адрес), "https://")
		И Не СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		ВызватьИсключение "Адреса має починатися з https://";
	КонецЕсли;
	Возврат Адрес;

КонецФункции

Процедура ИзменитьНастройку(Ключ, Значение)

	ПроверитьПраваАдминистратора();

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить(Ключ, Значение);
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Пользователь %1 изменил настройку %2",
		ИмяТекущегоПользователя(), Ключ));

КонецПроцедуры

Процедура ПроверитьКлиента(Клиент)

	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.mcp1c_КлиентыДоступа") Или Клиент.Пустая() Тогда
		ВызватьИсключение "Не вказано клієнта доступу";
	КонецЕсли;
	Реквизиты = Новый Запрос(
	"ВЫБРАТЬ
	|	Клиенты.Профиль КАК Профиль,
	|	Клиенты.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|ГДЕ
	|	Клиенты.Ссылка = &Клиент");
	Реквизиты.УстановитьПараметр("Клиент", Клиент);
	Выборка = Реквизиты.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.ПометкаУдаления Тогда
		ВызватьИсключение "Клієнта доступу не знайдено або позначено на вилучення";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Выборка.Профиль) Тогда
		ВызватьИсключение "У клієнта доступу не задано профіль: токен не матиме доступу до даних";
	КонецЕсли;

КонецПроцедуры

Функция ДействующиеТокены()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Токены.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.Отозван");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Процедура ОтозватьТокены(Токены)

	Сейчас = ТекущаяУниверсальнаяДата();
	Для Каждого Ссылка Из Токены Цикл
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.mcp1c_ТокеныДоступа");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
		НачатьТранзакцию();
		Попытка
			Блокировка.Заблокировать();
			Объект = Ссылка.ПолучитьОбъект();
			Если Не Объект.Отозван Тогда
				Объект.Отозван = Истина;
				Объект.ДатаОтзыва = Сейчас;
				Объект.Записать();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Токен %1 отозван пользователем %2",
			Строка(Ссылка.Код), ИмяТекущегоПользователя()));
	КонецЦикла;

КонецПроцедуры

Функция НормализованныйИсточник(Источник)

	Значение = НРег(СокрЛП(Источник));
	Пока СтрЗаканчиваетсяНа(Значение, "/") Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	Возврат Значение;

КонецФункции

Функция НепустыеСтроки(Значения)

	Результат = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Текст = СокрЛП(Значение);
		Если Не ПустаяСтрока(Текст) И Результат.Найти(Текст) = Неопределено Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИдентификаторИзЗначения(Знач Значение)

	// Допускается передать полный токен: id - символы 7-18.
	Значение = СокрЛП(Значение);
	Если СтрНачинаетсяС(Значение, "mcp1c_") И СтрДлина(Значение) > 18 Тогда
		Возврат Сред(Значение, 7, 12);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ИмяТекущегоПользователя()

	Имя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Возврат ?(ПустаяСтрока(Имя), "<без пользователя>", Имя);

КонецФункции

#КонецОбласти

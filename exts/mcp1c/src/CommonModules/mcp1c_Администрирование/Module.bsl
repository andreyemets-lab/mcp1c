///////////////////////////////////////////////////////////////////////////////
// mcp1c_Администрирование: управление сервером, токенами и подключениями OAuth.
//
// Каждый метод проверяет, что у текущего пользователя есть права роли mcp1c_Администратор на данные MCP,
// и работает с данными по этим правам: модуль не привилегированный.
// Методы вызываются из команд подсистемы "MCP-сервер" (mcp1c_АдминистрированиеВызовСервера)
// или из кода администратора.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Сервер

// Включает сервер. Если привязка к ИБ еще не задана, ее зафиксирует первый
// аутентифицированный запрос через веб-публикацию (п. 6.6 ТЗ).
//
// Параметры:
//  КаноническийАдрес - Строка - публичный адрес MCP-эндпоинта, например "https://mcp.company.ua/mcp".
//
Процедура ВключитьСервер(Знач КаноническийАдрес = "") Экспорт

	ПроверитьПраваАдминистратора();
	КаноническийАдрес = ПроверенныйАдрес(КаноническийАдрес);

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить("enabled", Истина);
		Если Не ПустаяСтрока(КаноническийАдрес) Тогда
			Настройки.Вставить("canonicalUrl", КаноническийАдрес);
		КонецЕсли;
		mcp1c_Настройки.ЗаполнитьСекреты(Настройки);
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Користувач %1 увімкнув сервер",
		ИмяТекущегоПользователя()));

КонецПроцедуры

// Выключает сервер: все запросы получают ответ 503.
//
Процедура ВыключитьСервер() Экспорт

	ИзменитьНастройку("enabled", Ложь);

КонецПроцедуры

// Устанавливает публичный адрес MCP-эндпоинта для фрагментов подключения, не меняя состояния сервера.
//
// Параметры:
//  КаноническийАдрес - Строка - например, "https://mcp.company.ua/mcp"; пустая строка - адрес не задан.
//
Процедура УстановитьКаноническийАдрес(Знач КаноническийАдрес) Экспорт

	ИзменитьНастройку("canonicalUrl", ПроверенныйАдрес(КаноническийАдрес));

КонецПроцедуры

// Подтверждает новое расположение ИБ после переноса или восстановления из копии.
// Пока перенос не подтвержден, сервер отвечает 503. После подтверждения привязку
// к новому расположению фиксирует первый аутентифицированный запрос.
//
// Параметры:
//  ОтозватьВсеТокены - Булево - отозвать все действующие токены и подключения OAuth (рекомендуется для копий баз).
//
Процедура ПодтвердитьПереносИнформационнойБазы(ОтозватьВсеТокены = Истина) Экспорт

	ПроверитьПраваАдминистратора();

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить("ibBinding", "");
		mcp1c_Настройки.Записать(Настройки);
		Если ОтозватьВсеТокены Тогда
			ОтозватьТокены(ДействующиеТокены());
			Для Каждого Подключение Из mcp1c_ДанныеOAuth.ДействующиеПодключения() Цикл
				mcp1c_ДанныеOAuth.ОтозватьПодключение(Подключение, "Перенесення ІБ");
			КонецЦикла;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон(
		"Перенесення ІБ підтвердив користувач %1, токени й підключення OAuth відкликано: %2",
		ИмяТекущегоПользователя(), Формат(ОтозватьВсеТокены, "БЛ=нет; БИ=да")));

КонецПроцедуры

// Устанавливает разрешенные значения заголовка Origin (браузерные клиенты).
// Запросы с другим Origin получают 403; запросы без Origin разрешены.
// Дополнительные значения задаются в клиенте доступа.
//
// Параметры:
//  Источники - Массив из Строка - например, "https://claude.ai".
//
Процедура УстановитьРазрешенныеИсточники(Источники) Экспорт

	Нормализованные = Новый Массив;
	Для Каждого Источник Из Источники Цикл
		Значение = НормализованныйИсточник(Источник);
		Если Не ПустаяСтрока(Значение) И Нормализованные.Найти(Значение) = Неопределено Тогда
			Нормализованные.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	ИзменитьНастройку("allowedOrigins", Нормализованные);

КонецПроцедуры

// Создает клиента доступа (мастер настройки, п. 9.2 ТЗ); токен выпускается отдельно.
//
// Параметры:
//  Наименование - Строка - имя клиента, например «Claude Desktop, ноутбук Андрія».
//  Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа - профиль доступа.
//  ТипКлиента - ПеречислениеСсылка.mcp1c_ТипыКлиентов - тип клиента.
//  ВнешнийПровайдер - Булево - модель работает у внешнего AI-провайдера.
//
// Возвращаемое значение:
//  СправочникСсылка.mcp1c_КлиентыДоступа - созданный клиент.
//
Функция СоздатьКлиента(Наименование, Профиль, ТипКлиента, ВнешнийПровайдер) Экспорт

	ПроверитьПраваАдминистратора();
	Если ПустаяСтрока(Наименование) Или Не ЗначениеЗаполнено(Профиль) Тогда
		ВызватьИсключение "Вкажіть ім'я клієнта і профіль доступу";
	КонецЕсли;
	Объект = Справочники.mcp1c_КлиентыДоступа.СоздатьЭлемент();
	Объект.Наименование = СокрЛП(Наименование);
	Объект.Профиль = Профиль;
	Объект.ТипКлиента = ТипКлиента;
	Объект.ВнешнийПровайдер = ВнешнийПровайдер;
	Объект.Ответственный = ИмяТекущегоПользователя();
	Объект.Записать();
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Користувач %1 створив клієнта доступу %2 з профілем %3",
		ИмяТекущегоПользователя(), Объект.Наименование, Профиль));
	Возврат Объект.Ссылка;

КонецФункции

// Устанавливает имя заголовка, в котором доверенный реверс-прокси передает IP клиента.
// Пустое имя отключает ограничения и блокировки по IP.
//
// Параметры:
//  ИмяЗаголовка - Строка - например, "X-Real-IP".
//
Процедура УстановитьЗаголовокАдресаКлиента(ИмяЗаголовка) Экспорт

	ИзменитьНастройку("clientIpHeader", СокрЛП(ИмяЗаголовка));

КонецПроцедуры

// Устанавливает дополнительный текст инструкций для модели (особенности базы).
//
// Параметры:
//  Текст - Строка - текст инструкций.
//
Процедура УстановитьИнструкции(Текст) Экспорт

	ИзменитьНастройку("instructions", СокрЛП(Текст));

КонецПроцедуры

// Устанавливает глоссарий базы (п. 5.6, 5.7 ТЗ): термины попадают в инструкции для модели,
// в get_context и в ресурс onec://glossary. Пустые термины пропускаются, повторы термина
// (без учета регистра) заменяются последним определением.
//
// Параметры:
//  Термины - Произвольный - Соответствие (термин и определение) или Массив терминов (Структура
//            или Соответствие с ключами term и definition); пустое значение очищает глоссарий.
//
Процедура УстановитьГлоссарий(Термины) Экспорт

	ИзменитьНастройку("glossary", mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(Термины));

КонецПроцедуры

// Устанавливает срок хранения журнала вызовов (п. 8.1 ТЗ): записи старше срока удаляет
// регламентное задание mcp1c_ОчисткаЖурналаВызовов.
//
// Параметры:
//  Дней - Число - срок хранения в днях, не меньше 7; 0 - журнал не очищается.
//
Процедура УстановитьСрокХраненияЖурнала(Знач Дней) Экспорт

	Дней = Цел(Дней);
	Если Дней < 0 Или Дней > 0 И Дней < 7 Тогда
		ВызватьИсключение "Термін зберігання журналу викликів - щонайменше 7 днів (0 - не очищати)";
	КонецЕсли;
	ИзменитьНастройку("logRetentionDays", Дней);

КонецПроцедуры

// Снимает автоблокировку клиента доступа, установленную после серии отказов политики.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент доступа.
//
Процедура СнятьБлокировкуКлиента(Клиент) Экспорт

	ПроверитьПраваАдминистратора();
	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.mcp1c_КлиентыДоступа") Или Клиент.Пустая() Тогда
		ВызватьИсключение "Не вказано клієнта доступу";
	КонецЕсли;
	mcp1c_Лимиты.СнятьБлокировкуКлиента(Клиент);
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Користувач %1 зняв блокування клієнта доступу %2",
		ИмяТекущегоПользователя(), Клиент));

КонецПроцедуры

// Снимает блокировку IP-адреса, установленную после серии неудачных аутентификаций.
//
// Параметры:
//  Адрес - Строка - IP-адрес.
//
Процедура СнятьБлокировкуАдреса(Знач Адрес) Экспорт

	ПроверитьПраваАдминистратора();
	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Не вказано IP-адресу";
	КонецЕсли;
	mcp1c_Лимиты.СнятьБлокировкуАдреса(Адрес);
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Користувач %1 зняв блокування IP-адреси %2",
		ИмяТекущегоПользователя(), Адрес));

КонецПроцедуры

// Устанавливает шаблоны фрагментов подключения клиентов, которые показываются при выпуске токена (п. 9.3 ТЗ).
// Подстановки: {url}, {token}, {header}, {allow_http} (см. mcp1c_ПодключениеКлиентов).
//
// Параметры:
//  Шаблоны - Массив из Произвольный - Соответствие или Структура с ключами title и text; пустой массив -
//            шаблоны по умолчанию.
//
Процедура УстановитьШаблоныПодключения(Шаблоны) Экспорт

	Ошибки = mcp1c_ПодключениеКлиентов.ОшибкиШаблонов(Шаблоны);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Нормализованные = Новый Массив;
	Для Каждого Шаблон Из Шаблоны Цикл
		Элемент = Новый Соответствие;
		Элемент.Вставить("title", СокрЛП(Шаблон["title"]));
		Элемент.Вставить("text", Шаблон["text"]);
		Нормализованные.Добавить(Элемент);
	КонецЦикла;
	ИзменитьНастройку("connectionTemplates", Нормализованные);

КонецПроцедуры

// Устанавливает шаблоны глобально запрещенных полей (п. 7.6 ТЗ), например "*Пароль*".
// Запреты действуют для всех профилей, включая доверенные.
//
// Параметры:
//  Шаблоны - Массив из Строка - шаблоны имен полей; * - любая последовательность символов.
//
Процедура УстановитьЗапрещенныеПоля(Шаблоны) Экспорт

	ИзменитьНастройку("bannedFieldPatterns", НепустыеСтроки(Шаблоны));

КонецПроцедуры

// Устанавливает шаблоны глобально запрещенных объектов (п. 7.6 ТЗ), например "ПланОбмена.*".
//
// Параметры:
//  Шаблоны - Массив из Строка - шаблоны полных имен объектов.
//
Процедура УстановитьЗапрещенныеОбъекты(Шаблоны) Экспорт

	ИзменитьНастройку("bannedObjectPatterns", НепустыеСтроки(Шаблоны));

КонецПроцедуры

// Настройки сервера без секретов - для просмотра администратором.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция ОписаниеНастроек() Экспорт

	ПроверитьПраваАдминистратора();

	Результат = Новый Соответствие;
	Для Каждого Элемент Из mcp1c_Настройки.Получить() Цикл
		Если mcp1c_Настройки.СекретныеКлючи().Найти(Элемент.Ключ) = Неопределено Тогда
			Результат.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("ibBindingPending", ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Результат, "ibBinding")));
	Возврат mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Результат);

КонецФункции

#КонецОбласти

#Область Токены

// Выпускает новый токен доступа. Значение токена возвращается один раз;
// в базе хранится только SHA-256 секрета.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - кому выдан токен.
//  СрокДействияДней - Число - срок действия в днях; 0 - срок по умолчанию (defaultTokenDays).
//  Комментарий - Строка - произвольный комментарий.
//  ОбластьТокена - Строка, Массив из Строка - инструменты, которыми ограничен токен (п. 6.3 ТЗ): область
//                  сужает возможности профиля и не расширяет их; пустая - все возможности профиля.
//
// Возвращаемое значение:
//  Структура:
//   * Токен - Строка - значение для заголовка Authorization: Bearer.
//   * Идентификатор - Строка - id токена.
//   * Ссылка - СправочникСсылка.mcp1c_ТокеныДоступа - запись токена.
//   * ДействуетДо - Дата - дата окончания действия (UTC).
//   * Фрагменты - Строка - готовые настройки клиентов с токеном (п. 9.3 ТЗ).
//   * ФрагментыПодключения - Строка - токен, срок действия и готовые настройки клиентов.
//
Функция ВыпуститьТокен(Клиент, Знач СрокДействияДней = 0, Знач Комментарий = "", Знач ОбластьТокена = "") Экспорт

	ПроверитьПраваАдминистратора();
	ПроверитьКлиента(Клиент);

	Настройки = mcp1c_Настройки.Получить();
	МаксимумДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "maxTokenDays", 90);
	Если СрокДействияДней <= 0 Тогда
		СрокДействияДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "defaultTokenDays", 30);
	КонецЕсли;
	Если СрокДействияДней > МаксимумДней Тогда
		ВызватьИсключение СтрШаблон("Термін дії токена не може перевищувати %1 дн.", МаксимумДней);
	КонецЕсли;

	НовыйТокен = mcp1c_Аутентификация.НовыйТокен();
	Пока mcp1c_Аутентификация.ТокенПоИдентификатору(НовыйТокен.Идентификатор) <> Неопределено Цикл
		НовыйТокен = mcp1c_Аутентификация.НовыйТокен();
	КонецЦикла;

	Сейчас = ТекущаяУниверсальнаяДата();
	ДействуетДо = Сейчас + Цел(СрокДействияДней) * 86400;
	Комментарий = СокрЛП(Комментарий);
	ОбластьТокена = mcp1c_ПравилаДоступа.НормализованнаяОбласть(ОбластьТокена);
	Если СтрДлина(ОбластьТокена) > 1000 Тогда
		ВызватьИсключение "Область токена довша за 1000 символів: виберіть менше інструментів";
	КонецЕсли;

	Объект = Справочники.mcp1c_ТокеныДоступа.СоздатьЭлемент();
	Объект.Владелец = Клиент;
	Объект.Код = НовыйТокен.Идентификатор;
	Объект.Наименование = ?(ПустаяСтрока(Комментарий),
		СтрШаблон("Токен від %1", Формат(Сейчас, "ДЛФ=D")), Лев(Комментарий, 100));
	Объект.Хеш = НовыйТокен.Хеш;
	Объект.ДатаВыпуска = Сейчас;
	Объект.ДействуетДо = ДействуетДо;
	Объект.Автор = ИмяТекущегоПользователя();
	Объект.ОбластьДоступа = ОбластьТокена;
	Объект.Записать();

	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон(
		"Користувач %3 видав токен %1 клієнту ""%2"", діє до %4 UTC, область: %5",
		НовыйТокен.Идентификатор, Строка(Клиент), ИмяТекущегоПользователя(), mcp1c_Служебный.ДатаВСтроку(ДействуетДо),
		?(ПустаяСтрока(ОбластьТокена), "усі можливості профілю", ОбластьТокена)));

	Результат = Новый Структура;
	Результат.Вставить("Токен", НовыйТокен.Токен);
	Результат.Вставить("Идентификатор", НовыйТокен.Идентификатор);
	Результат.Вставить("Ссылка", Объект.Ссылка);
	Результат.Вставить("ДействуетДо", ДействуетДо);
	Фрагменты = mcp1c_ПодключениеКлиентов.ФрагментыПодключения(
		mcp1c_Служебный.СвойствоМассив(Настройки, "connectionTemplates"), НовыйТокен.Токен,
		mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl"));
	Результат.Вставить("Фрагменты", Фрагменты);
	Результат.Вставить("ФрагментыПодключения", СтрШаблон("Токен (показується один раз, діє до %1 UTC):
		|%2
		|
		|%3", mcp1c_Служебный.ДатаВСтроку(ДействуетДо), НовыйТокен.Токен, Фрагменты));
	Возврат Результат;

КонецФункции

// Отзывает токен. Отзыв действует со следующего запроса.
//
// Параметры:
//  Токен - СправочникСсылка.mcp1c_ТокеныДоступа, Строка - ссылка, id токена (12 символов) или полное значение.
//
Процедура ОтозватьТокен(Токен) Экспорт

	ПроверитьПраваАдминистратора();

	Ссылка = Токен;
	Если ТипЗнч(Токен) = Тип("Строка") Тогда
		Ссылка = mcp1c_Аутентификация.ТокенПоИдентификатору(ИдентификаторИзЗначения(Токен));
	КонецЕсли;
	Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.mcp1c_ТокеныДоступа") Или Ссылка.Пустая() Тогда
		ВызватьИсключение "Токен не знайдено";
	КонецЕсли;

	Токены = Новый Массив;
	Токены.Добавить(Ссылка);
	ОтозватьТокены(Токены);

КонецПроцедуры

// Помечает на удаление отозванные и истекшие токены старше указанного количества дней.
// Помеченные токены удаляет штатная обработка удаления помеченных объектов.
//
// Параметры:
//  ХранитьДней - Число - сколько дней хранить недействующие записи для аудита.
//
// Возвращаемое значение:
//  Число - количество помеченных записей.
//
Функция ПометитьНедействующиеТокены(ХранитьДней = 30) Экспорт

	ПроверитьПраваАдминистратора();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Токены.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.ПометкаУдаления
	|	И Токены.ДействуетДо < &Граница
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Токены.Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.ПометкаУдаления
	|	И Токены.Отозван
	|	И Токены.ДатаОтзыва < &Граница";
	Запрос.УстановитьПараметр("Граница", ТекущаяУниверсальнаяДата() - ХранитьДней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();

	Помечено = 0;
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		Помечено = Помечено + 1;
	КонецЦикла;

	Если Помечено > 0 Тогда
		mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Позначено на вилучення недійсних токенів: %1 (користувач %2)",
			Помечено, ИмяТекущегоПользователя()));
	КонецЕсли;
	Возврат Помечено;

КонецФункции

// Список токенов без хешей с временем последнего использования по журналу вызовов.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - отбор по клиенту.
//
// Возвращаемое значение:
//  см. ОписанияТокенов
//
Функция СписокТокенов(Клиент = Неопределено) Экспорт

	ПроверитьПраваАдминистратора();
	Возврат ОписанияТокенов(Клиент);

КонецФункции

#КонецОбласти

#Область OAuth

// Устанавливает настройки OAuth 2.1 (п. 6.4 ТЗ). Передаются только изменяемые значения.
//
// Параметры:
//  Параметры - Структура - любые из свойств:
//   * Включен - Булево - OAuth для веб-коннекторов; включение требует публичного адреса сервера.
//   * СрокДоступаМинут - Число - срок токена доступа, 5-1440 минут.
//   * СрокОбновленияДней - Число - срок токена обновления, 1-365 дней.
//   * СрокПодключенияДней - Число - абсолютный срок подключения, 1-365 дней.
//   * СрокКодаМинут - Число - срок кода подключения, 1-60 минут.
//   * ПрефиксыCIMD - Массив из Строка, Строка - доверенные префиксы адресов документов метаданных клиентов
//     (https://...); строка - по одному в строке.
//   * ДинамическаяРегистрация - Булево - динамическая регистрация клиентов (RFC 7591).
//
Процедура УстановитьНастройкиOAuth(Параметры) Экспорт

	ПроверитьПраваАдминистратора();
	Изменения = ИзмененияНастроекOAuth(Параметры);
	Если Изменения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Измененные = Новый Массив;
	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Если Изменения.Получить("oauthEnabled") = Истина Тогда
			ПроверитьАдресДляOAuth(mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl"));
		КонецЕсли;
		Для Каждого Элемент Из Изменения Цикл
			Текущее = Настройки.Получить(Элемент.Ключ);
			Если ТипЗнч(Текущее) <> ТипЗнч(Элемент.Значение)
				Или mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Текущее) <> mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Элемент.Значение) Тогда
				Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
				Измененные.Добавить(Элемент.Ключ);
			КонецЕсли;
		КонецЦикла;
		Если Измененные.Количество() > 0 Тогда
			mcp1c_Настройки.ЗаполнитьСекреты(Настройки);
			mcp1c_Настройки.Записать(Настройки);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Измененные.Количество() > 0 Тогда
		mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Користувач %1 змінив налаштування OAuth: %2",
			ИмяТекущегоПользователя(), СтрСоединить(Измененные, ", ")));
	КонецЕсли;

КонецПроцедуры

// Текущие настройки OAuth (п. 6.4 ТЗ) и адреса, которые нужны прокси и AI-клиентам.
//
// Возвращаемое значение:
//  Структура:
//   * Включен - Булево - OAuth для веб-коннекторов.
//   * СрокДоступаМинут - Число - срок токена доступа.
//   * СрокОбновленияДней - Число - срок токена обновления.
//   * СрокПодключенияДней - Число - абсолютный срок подключения.
//   * СрокКодаМинут - Число - срок кода подключения.
//   * ПрефиксыCIMD - Массив из Строка - доверенные префиксы адресов документов метаданных клиентов.
//   * ДинамическаяРегистрация - Булево - динамическая регистрация клиентов.
//   * Ресурс - Строка - публичный адрес MCP-эндпоинта (ресурс токенов).
//   * АдресМетаданныхРесурса - Строка - метаданные защищенного ресурса (RFC 9728); пустая - адрес не задан.
//   * Издатель - Строка - издатель сервера авторизации; пустая - адрес не задан.
//
Функция НастройкиOAuth() Экспорт

	ПроверитьПраваАдминистратора();
	Настройки = mcp1c_Настройки.Получить();
	Ресурс = mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl");
	Результат = Новый Структура;
	Результат.Вставить("Включен", mcp1c_Служебный.СвойствоБулево(Настройки, "oauthEnabled", Ложь));
	Результат.Вставить("СрокДоступаМинут", mcp1c_Служебный.СвойствоЧисло(Настройки, "oauthAccessTokenMinutes", 60));
	Результат.Вставить("СрокОбновленияДней", mcp1c_Служебный.СвойствоЧисло(Настройки, "oauthRefreshTokenDays", 30));
	Результат.Вставить("СрокПодключенияДней", mcp1c_Служебный.СвойствоЧисло(Настройки, "oauthConnectionDays", 90));
	Результат.Вставить("СрокКодаМинут", mcp1c_Служебный.СвойствоЧисло(Настройки, "oauthConnectionCodeMinutes", 10));
	Префиксы = Новый Массив;
	Для Каждого Префикс Из mcp1c_Служебный.СвойствоМассив(Настройки, "oauthCimdPrefixes") Цикл
		Префиксы.Добавить(Строка(Префикс));
	КонецЦикла;
	Результат.Вставить("ПрефиксыCIMD", Префиксы);
	Результат.Вставить("ДинамическаяРегистрация",
		mcp1c_Служебный.СвойствоБулево(Настройки, "oauthDynamicRegistration", Ложь));
	Результат.Вставить("Ресурс", Ресурс);
	Результат.Вставить("АдресМетаданныхРесурса",
		?(ПустаяСтрока(Ресурс), "", mcp1c_ПравилаOAuth.АдресМетаданныхРесурса(Ресурс)));
	Результат.Вставить("Издатель", ?(ПустаяСтрока(Ресурс), "", mcp1c_ПравилаOAuth.Издатель(Ресурс)));
	Возврат Результат;

КонецФункции

// Выдает код подключения AI-клиента по OAuth (п. 6.4 ТЗ): пользователь вводит его на странице авторизации,
// которую открывает AI-клиент. Код показывается один раз; в базе хранится только хеш.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент доступа, от имени которого будет работать AI-клиент.
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - код подключения.
//   * ДействуетДо - Дата - окончание действия кода (UTC).
//   * Подключение - СправочникСсылка.mcp1c_ПодключенияOAuth - подключение.
//   * Идентификатор - Строка - идентификатор подключения.
//   * Адрес - Строка - адрес MCP-сервера для AI-клиента.
//   * Инструкция - Строка - что сделать пользователю.
//
Функция ВыдатьКодПодключенияOAuth(Клиент) Экспорт

	ПроверитьПраваАдминистратора();
	ПроверитьКлиента(Клиент);
	Настройки = mcp1c_Настройки.Получить();
	Если Не mcp1c_Служебный.СвойствоБулево(Настройки, "oauthEnabled", Ложь) Тогда
		ВызватьИсключение "OAuth вимкнено: увімкніть його в робочому місці MCP-сервера, вкладка «OAuth»";
	КонецЕсли;
	Адрес = mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl");
	ПроверитьАдресДляOAuth(Адрес);
	Минут = Мин(Макс(Цел(mcp1c_Служебный.СвойствоЧисло(Настройки, "oauthConnectionCodeMinutes", 10)), 1), 60);

	Итог = mcp1c_ДанныеOAuth.НовоеПодключение(Клиент, Минут, ИмяТекущегоПользователя());
	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон(
		"Користувач %1 видав код підключення OAuth для підключення %2 клієнта ""%3"", код діє до %4 UTC",
		ИмяТекущегоПользователя(), Итог.Идентификатор, Строка(Клиент), mcp1c_Служебный.ДатаВСтроку(Итог.ДействуетДо)));

	Результат = Новый Структура;
	Результат.Вставить("Код", Итог.Код);
	Результат.Вставить("ДействуетДо", Итог.ДействуетДо);
	Результат.Вставить("Подключение", Итог.Ссылка);
	Результат.Вставить("Идентификатор", Итог.Идентификатор);
	Результат.Вставить("Адрес", Адрес);
	Результат.Вставить("Инструкция", СтрШаблон("Код підключення: %1 (діє %2 хв, одноразовий)
		|
		|1. Додайте в AI-клієнті MCP-сервер з адресою %3. У claude.ai: «Налаштування» - «Конектори» - «Додати власний
		|   конектор»; у Claude Code: claude mcp add --transport http 1c %3
		|2. Коли відкриється сторінка підключення 1С, введіть цей код.
		|3. Перевірте застосунок і адресу повернення на сторінці підтвердження й натисніть «Дозволити».",
		Итог.Код, Минут, Адрес));
	Возврат Результат;

КонецФункции

// Отзывает подключение OAuth: его токены перестают действовать со следующего запроса.
//
// Параметры:
//  Подключение - СправочникСсылка.mcp1c_ПодключенияOAuth - подключение.
//
Процедура ОтозватьПодключениеOAuth(Подключение) Экспорт

	ПроверитьПраваАдминистратора();
	Если ТипЗнч(Подключение) <> Тип("СправочникСсылка.mcp1c_ПодключенияOAuth") Или Подключение.Пустая() Тогда
		ВызватьИсключение "Не вказано підключення OAuth";
	КонецЕсли;
	Если mcp1c_ДанныеOAuth.ОтозватьПодключение(Подключение, "Відкликано адміністратором " + ИмяТекущегоПользователя()) Тогда
		mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Користувач %1 відкликав підключення OAuth %2",
			ИмяТекущегоПользователя(), Строка(Подключение.Код)));
	КонецЕсли;

КонецПроцедуры

// Регистрирует клиента OAuth предварительно (п. 6.4 ТЗ) - для AI-клиентов без документа метаданных (CIMD):
// client_id (и секрет) вводятся в настройках коннектора AI-клиента.
//
// Параметры:
//  Наименование - Строка - название клиента, например «claude.ai».
//  АдресаВозврата - Строка, Массив из Строка - redirect_uris (https или http на петлевом адресе);
//                   строка - по одному в строке.
//  Конфиденциальный - Булево - выдать секрет клиента (client_secret_post или client_secret_basic).
//  Комментарий - Строка - комментарий.
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторКлиента - Строка - client_id.
//   * Секрет - Строка - client_secret (показывается один раз); пустая строка - публичный клиент.
//   * Ссылка - СправочникСсылка.mcp1c_КлиентыOAuth - клиент.
//
Функция ЗарегистрироватьКлиентаOAuth(Знач Наименование, Знач АдресаВозврата, Конфиденциальный = Ложь,
	Знач Комментарий = "") Экспорт

	ПроверитьПраваАдминистратора();
	Наименование = СокрЛП(Наименование);
	Если ПустаяСтрока(Наименование) Тогда
		ВызватьИсключение "Вкажіть назву клієнта OAuth";
	КонецЕсли;
	Если ТипЗнч(АдресаВозврата) = Тип("Строка") Тогда
		АдресаВозврата = mcp1c_ПравилаOAuth.АдресаИзТекста(АдресаВозврата);
	КонецЕсли;
	Описание = mcp1c_ПравилаOAuth.НовоеОписаниеКлиента();
	Описание.Имя = Лев(Наименование, 100);
	Описание.СпособАутентификации = ?(Конфиденциальный, "client_secret_post", "none");
	Для Каждого Адрес Из АдресаВозврата Цикл
		Адрес = СокрЛП(Адрес);
		Если Не mcp1c_ПравилаOAuth.АдресВозвратаДопустим(Адрес) Тогда
			ВызватьИсключение СтрШаблон("Адреса повернення %1 має бути https або http на петлевій адресі "
				+ "(127.0.0.1, [::1], localhost), без фрагмента", Адрес);
		КонецЕсли;
		Если Описание.АдресаВозврата.Найти(Адрес) = Неопределено Тогда
			Описание.АдресаВозврата.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Если Описание.АдресаВозврата.Количество() = 0 Тогда
		ВызватьИсключение "Вкажіть хоча б одну адресу повернення клієнта OAuth";
	КонецЕсли;

	Итог = mcp1c_ДанныеOAuth.ЗарегистрироватьКлиента(Описание, "manual", СокрЛП(Комментарий));
	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон(
		"Користувач %1 зареєстрував клієнта OAuth %2 (""%3"", %4), адреси повернення: %5",
		ИмяТекущегоПользователя(), Итог.ИдентификаторКлиента, Наименование,
		?(Конфиденциальный, "конфіденційний", "публічний"), СтрСоединить(Описание.АдресаВозврата, ", ")));

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторКлиента", Итог.ИдентификаторКлиента);
	Результат.Вставить("Секрет", Итог.Секрет);
	Результат.Вставить("Ссылка", Итог.Ссылка);
	Возврат Результат;

КонецФункции

// Блокирует клиента OAuth или снимает блокировку: подключения заблокированного клиента перестают работать.
//
// Параметры:
//  КлиентOAuth - СправочникСсылка.mcp1c_КлиентыOAuth - клиент.
//  Заблокировать - Булево - Истина - заблокировать, Ложь - снять блокировку.
//
Процедура УстановитьБлокировкуКлиентаOAuth(КлиентOAuth, Заблокировать) Экспорт

	ПроверитьПраваАдминистратора();
	Если ТипЗнч(КлиентOAuth) <> Тип("СправочникСсылка.mcp1c_КлиентыOAuth") Или КлиентOAuth.Пустая() Тогда
		ВызватьИсключение "Не вказано клієнта OAuth";
	КонецЕсли;
	mcp1c_ДанныеOAuth.УстановитьБлокировкуКлиента(КлиентOAuth, Заблокировать);
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Користувач %1 %2 клієнта OAuth %3", ИмяТекущегоПользователя(),
		?(Заблокировать, "заблокував", "розблокував"), Строка(КлиентOAuth.ИдентификаторКлиента)));

КонецПроцедуры


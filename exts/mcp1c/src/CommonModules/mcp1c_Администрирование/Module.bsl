///////////////////////////////////////////////////////////////////////////////
// mcp1c_Администрирование (привилегированный): управление сервером и токенами.
//
// Каждый метод проверяет, что текущий пользователь имеет право Администрирование
// или роль mcp1c_Администратор. На этапе 0 методы вызываются из консоли кода
// в контексте сервера (см. README); формы администрирования - этап 1.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Сервер

// Включает сервер. Если привязка к ИБ еще не задана, ее зафиксирует первый
// аутентифицированный запрос через веб-публикацию (п. 6.6 ТЗ).
//
// Параметры:
//  КаноническийАдрес - Строка - публичный адрес MCP-эндпоинта, например "https://mcp.company.ua/mcp".
//
Процедура ВключитьСервер(Знач КаноническийАдрес = "") Экспорт

	ПроверитьПраваАдминистратора();

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить("enabled", Истина);
		Если Не ПустаяСтрока(КаноническийАдрес) Тогда
			Настройки.Вставить("canonicalUrl", СокрЛП(КаноническийАдрес));
		КонецЕсли;
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Сервер включен пользователем %1",
		ИмяТекущегоПользователя()));

КонецПроцедуры

// Выключает сервер: все запросы получают ответ 503.
//
Процедура ВыключитьСервер() Экспорт

	ИзменитьНастройку("enabled", Ложь);

КонецПроцедуры

// Подтверждает новое расположение ИБ после переноса или восстановления из копии.
// Пока перенос не подтвержден, сервер отвечает 503. После подтверждения привязку
// к новому расположению фиксирует первый аутентифицированный запрос.
//
// Параметры:
//  ОтозватьВсеТокены - Булево - отозвать все действующие токены (рекомендуется для копий баз).
//
Процедура ПодтвердитьПереносИнформационнойБазы(ОтозватьВсеТокены = Истина) Экспорт

	ПроверитьПраваАдминистратора();

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить("ibBinding", "");
		Если ОтозватьВсеТокены Тогда
			Сейчас = mcp1c_Служебный.ДатаВСтроку(ТекущаяУниверсальнаяДата());
			Для Каждого Запись Из mcp1c_Служебный.СвойствоМассив(Настройки, "tokens") Цикл
				Если Не mcp1c_Служебный.СвойствоБулево(Запись, "revoked", Ложь) Тогда
					Запись.Вставить("revoked", Истина);
					Запись.Вставить("revokedUtc", Сейчас);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон(
		"Перенос ИБ подтвержден пользователем %1, токены отозваны: %2",
		ИмяТекущегоПользователя(), Формат(ОтозватьВсеТокены, "БЛ=нет; БИ=да")));

КонецПроцедуры

// Устанавливает разрешенные значения заголовка Origin (браузерные клиенты).
// Запросы с другим Origin получают 403; запросы без Origin разрешены.
//
// Параметры:
//  Источники - Массив из Строка - например, "https://claude.ai".
//
Процедура УстановитьРазрешенныеИсточники(Источники) Экспорт

	Нормализованные = Новый Массив;
	Для Каждого Источник Из Источники Цикл
		Значение = НРег(СокрЛП(Источник));
		Пока СтрЗаканчиваетсяНа(Значение, "/") Цикл
			Значение = Лев(Значение, СтрДлина(Значение) - 1);
		КонецЦикла;
		Если Не ПустаяСтрока(Значение) И Нормализованные.Найти(Значение) = Неопределено Тогда
			Нормализованные.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	ИзменитьНастройку("allowedOrigins", Нормализованные);

КонецПроцедуры

// Устанавливает имя заголовка, в котором доверенный реверс-прокси передает IP клиента.
//
// Параметры:
//  ИмяЗаголовка - Строка - например, "X-Real-IP".
//
Процедура УстановитьЗаголовокАдресаКлиента(ИмяЗаголовка) Экспорт

	ИзменитьНастройку("clientIpHeader", СокрЛП(ИмяЗаголовка));

КонецПроцедуры

// Устанавливает дополнительный текст инструкций для модели (глоссарий, особенности базы).
//
// Параметры:
//  Текст - Строка - текст инструкций.
//
Процедура УстановитьИнструкции(Текст) Экспорт

	ИзменитьНастройку("instructions", СокрЛП(Текст));

КонецПроцедуры

// Настройки сервера без хешей токенов - для просмотра администратором.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция ОписаниеНастроек() Экспорт

	ПроверитьПраваАдминистратора();

	Настройки = mcp1c_Настройки.Получить();
	Результат = Новый Соответствие;
	Для Каждого Элемент Из Настройки Цикл
		Если Элемент.Ключ <> "tokens" Тогда
			Результат.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("tokens", ОписанияТокенов(Настройки));
	Результат.Вставить("ibBindingPending", ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Настройки, "ibBinding")));
	Возврат mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Результат);

КонецФункции

#КонецОбласти

#Область Токены

// Выпускает новый токен доступа. Значение токена возвращается один раз;
// в базе хранится только SHA-256 секрета.
//
// Параметры:
//  ИмяКлиента - Строка - кому выдан токен, например "Claude Code - Андрей".
//  СрокДействияДней - Число - срок действия в днях; 0 - срок по умолчанию (defaultTokenDays).
//  Комментарий - Строка - произвольный комментарий.
//
// Возвращаемое значение:
//  Структура:
//   * Токен - Строка - значение для заголовка Authorization: Bearer.
//   * Идентификатор - Строка - id токена.
//   * ДействуетДо - Дата - дата окончания действия (UTC).
//
Функция ВыпуститьТокен(Знач ИмяКлиента, Знач СрокДействияДней = 0, Знач Комментарий = "") Экспорт

	ПроверитьПраваАдминистратора();

	ИмяКлиента = СокрЛП(ИмяКлиента);
	Если ПустаяСтрока(ИмяКлиента) Тогда
		ВызватьИсключение "Не указано имя клиента доступа";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();

		МаксимумДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "maxTokenDays", 90);
		Если СрокДействияДней <= 0 Тогда
			СрокДействияДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "defaultTokenDays", 30);
		КонецЕсли;
		Если СрокДействияДней > МаксимумДней Тогда
			ВызватьИсключение СтрШаблон("Срок действия токена не может превышать %1 дн.", МаксимумДней);
		КонецЕсли;

		НовыйТокен = mcp1c_Аутентификация.НовыйТокен();
		Пока mcp1c_Аутентификация.НайтиЗаписьТокена(Настройки, НовыйТокен.Идентификатор) <> Неопределено Цикл
			НовыйТокен = mcp1c_Аутентификация.НовыйТокен();
		КонецЦикла;

		Сейчас = ТекущаяУниверсальнаяДата();
		ДействуетДо = Сейчас + Цел(СрокДействияДней) * 86400;

		Запись = Новый Соответствие;
		Запись.Вставить("id", НовыйТокен.Идентификатор);
		Запись.Вставить("hash", НовыйТокен.Хеш);
		Запись.Вставить("client", ИмяКлиента);
		Запись.Вставить("comment", СокрЛП(Комментарий));
		Запись.Вставить("createdUtc", mcp1c_Служебный.ДатаВСтроку(Сейчас));
		Запись.Вставить("createdBy", ИмяТекущегоПользователя());
		Запись.Вставить("expiresUtc", mcp1c_Служебный.ДатаВСтроку(ДействуетДо));
		Запись.Вставить("revoked", Ложь);

		Токены = mcp1c_Служебный.СвойствоМассив(Настройки, "tokens");
		Токены.Добавить(Запись);
		Настройки.Вставить("tokens", Токены);

		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Выпущен токен %1 для клиента ""%2"" пользователем %3, действует до %4 UTC",
		НовыйТокен.Идентификатор, ИмяКлиента, ИмяТекущегоПользователя(), mcp1c_Служебный.ДатаВСтроку(ДействуетДо)));

	Результат = Новый Структура;
	Результат.Вставить("Токен", НовыйТокен.Токен);
	Результат.Вставить("Идентификатор", НовыйТокен.Идентификатор);
	Результат.Вставить("ДействуетДо", ДействуетДо);
	Возврат Результат;

КонецФункции

// Отзывает токен. Отзыв действует со следующего запроса.
//
// Параметры:
//  Идентификатор - Строка - id токена (12 символов) или полное значение токена.
//
Процедура ОтозватьТокен(Знач Идентификатор) Экспорт

	ПроверитьПраваАдминистратора();

	Идентификатор = ИдентификаторИзЗначения(Идентификатор);

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Запись = mcp1c_Аутентификация.НайтиЗаписьТокена(Настройки, Идентификатор);
		Если Запись = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Токен %1 не найден", Идентификатор);
		КонецЕсли;
		Запись.Вставить("revoked", Истина);
		Запись.Вставить("revokedUtc", mcp1c_Служебный.ДатаВСтроку(ТекущаяУниверсальнаяДата()));
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Токен %1 отозван пользователем %2",
		Идентификатор, ИмяТекущегоПользователя()));

КонецПроцедуры

// Удаляет записи отозванных и истекших токенов старше указанного количества дней.
//
// Параметры:
//  ХранитьДней - Число - сколько дней хранить недействующие записи для аудита.
//
// Возвращаемое значение:
//  Число - количество удаленных записей.
//
Функция УдалитьНедействующиеТокены(ХранитьДней = 30) Экспорт

	ПроверитьПраваАдминистратора();

	Граница = ТекущаяУниверсальнаяДата() - ХранитьДней * 86400;
	Удалено = 0;

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Оставить = Новый Массив;
		Для Каждого Запись Из mcp1c_Служебный.СвойствоМассив(Настройки, "tokens") Цикл
			ДатаОкончания = mcp1c_Служебный.СтрокаВДату(mcp1c_Служебный.СвойствоСтрока(Запись, "expiresUtc"));
			ДатаОтзыва = mcp1c_Служебный.СтрокаВДату(mcp1c_Служебный.СвойствоСтрока(Запись, "revokedUtc"));
			Недействует = (ДатаОкончания = Неопределено Или ДатаОкончания < Граница)
				Или (ДатаОтзыва <> Неопределено И ДатаОтзыва < Граница);
			Если Недействует Тогда
				Удалено = Удалено + 1;
			Иначе
				Оставить.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
		Настройки.Вставить("tokens", Оставить);
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Удалено > 0 Тогда
		mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Удалено недействующих записей токенов: %1", Удалено));
	КонецЕсли;
	Возврат Удалено;

КонецФункции

// Список токенов без хешей.
//
// Возвращаемое значение:
//  Массив из Соответствие - id, client, comment, createdUtc, createdBy, expiresUtc, revoked, revokedUtc, active.
//
Функция СписокТокенов() Экспорт

	ПроверитьПраваАдминистратора();
	Возврат ОписанияТокенов(mcp1c_Настройки.Получить());

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПраваАдминистратора()

	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() = 0 Тогда
		Возврат; // База без пользователей: любой сеанс административный.
	КонецЕсли;

	// Пользователь передается явно: в привилегированном режиме проверка
	// без пользователя всегда возвращала бы Истина.
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПравоДоступа("Администрирование", Метаданные, ТекущийПользователь) Тогда
		Возврат;
	КонецЕсли;
	Если ТекущийПользователь.Роли.Содержит(Метаданные.Роли.mcp1c_Администратор) Тогда
		Возврат;
	КонецЕсли;

	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон(
		"Отказ в доступе к администрированию MCP для пользователя %1", ТекущийПользователь.Имя));
	ВызватьИсключение "Недостаточно прав: нужно право Администрирование или роль mcp1c_Администратор";

КонецПроцедуры

Процедура ИзменитьНастройку(Ключ, Значение)

	ПроверитьПраваАдминистратора();

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить(Ключ, Значение);
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Пользователь %1 изменил настройку %2",
		ИмяТекущегоПользователя(), Ключ));

КонецПроцедуры

Функция ОписанияТокенов(Настройки)

	Сейчас = ТекущаяУниверсальнаяДата();
	Результат = Новый Массив;
	Для Каждого Запись Из mcp1c_Служебный.СвойствоМассив(Настройки, "tokens") Цикл
		Описание = Новый Соответствие;
		Для Каждого Поле Из Запись Цикл
			Если Поле.Ключ <> "hash" Тогда
				Описание.Вставить(Поле.Ключ, Поле.Значение);
			КонецЕсли;
		КонецЦикла;
		ДействуетДо = mcp1c_Служебный.СтрокаВДату(mcp1c_Служебный.СвойствоСтрока(Запись, "expiresUtc"));
		Описание.Вставить("active", Не mcp1c_Служебный.СвойствоБулево(Запись, "revoked", Ложь)
			И ДействуетДо <> Неопределено И ДействуетДо > Сейчас);
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИдентификаторИзЗначения(Знач Значение)

	// Допускается передать полный токен: id - символы 7-18.
	Значение = СокрЛП(Значение);
	Если СтрНачинаетсяС(Значение, "mcp1c_") И СтрДлина(Значение) > 18 Тогда
		Возврат Сред(Значение, 7, 12);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ИмяТекущегоПользователя()

	Имя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Возврат ?(ПустаяСтрока(Имя), "<без пользователя>", Имя);

КонецФункции

#КонецОбласти

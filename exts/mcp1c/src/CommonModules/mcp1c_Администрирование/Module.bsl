///////////////////////////////////////////////////////////////////////////////
// mcp1c_Администрирование: управление сервером и токенами.
//
// Каждый метод проверяет, что текущий пользователь имеет право Администрирование
// или роль mcp1c_Администратор, и работает с данными по правам этой роли.
// Методы вызываются из команд подсистемы "MCP-сервер" (mcp1c_АдминистрированиеВызовСервера)
// или из кода администратора.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Сервер

// Включает сервер. Если привязка к ИБ еще не задана, ее зафиксирует первый
// аутентифицированный запрос через веб-публикацию (п. 6.6 ТЗ).
//
// Параметры:
//  КаноническийАдрес - Строка - публичный адрес MCP-эндпоинта, например "https://mcp.company.ua/mcp".
//
Процедура ВключитьСервер(Знач КаноническийАдрес = "") Экспорт

	ПроверитьПраваАдминистратора();
	КаноническийАдрес = СокрЛП(КаноническийАдрес);
	Если Не ПустаяСтрока(КаноническийАдрес) И Не СтрНачинаетсяС(НРег(КаноническийАдрес), "https://")
		И Не СтрНачинаетсяС(НРег(КаноническийАдрес), "http://") Тогда
		ВызватьИсключение "Адреса має починатися з https://";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить("enabled", Истина);
		Если Не ПустаяСтрока(КаноническийАдрес) Тогда
			Настройки.Вставить("canonicalUrl", КаноническийАдрес);
		КонецЕсли;
		mcp1c_Настройки.ЗаполнитьСекреты(Настройки);
		mcp1c_Настройки.Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Сервер включен пользователем %1",
		ИмяТекущегоПользователя()));

КонецПроцедуры

// Выключает сервер: все запросы получают ответ 503.
//
Процедура ВыключитьСервер() Экспорт

	ИзменитьНастройку("enabled", Ложь);

КонецПроцедуры

// Подтверждает новое расположение ИБ после переноса или восстановления из копии.
// Пока перенос не подтвержден, сервер отвечает 503. После подтверждения привязку
// к новому расположению фиксирует первый аутентифицированный запрос.
//
// Параметры:
//  ОтозватьВсеТокены - Булево - отозвать все действующие токены (рекомендуется для копий баз).
//
Процедура ПодтвердитьПереносИнформационнойБазы(ОтозватьВсеТокены = Истина) Экспорт

	ПроверитьПраваАдминистратора();

	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Настройки.Вставить("ibBinding", "");
		mcp1c_Настройки.Записать(Настройки);
		Если ОтозватьВсеТокены Тогда
			ОтозватьТокены(ДействующиеТокены());
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон(
		"Перенос ИБ подтвержден пользователем %1, токены отозваны: %2",
		ИмяТекущегоПользователя(), Формат(ОтозватьВсеТокены, "БЛ=нет; БИ=да")));

КонецПроцедуры

// Устанавливает разрешенные значения заголовка Origin (браузерные клиенты).
// Запросы с другим Origin получают 403; запросы без Origin разрешены.
// Дополнительные значения задаются в клиенте доступа.
//
// Параметры:
//  Источники - Массив из Строка - например, "https://claude.ai".
//
Процедура УстановитьРазрешенныеИсточники(Источники) Экспорт

	Нормализованные = Новый Массив;
	Для Каждого Источник Из Источники Цикл
		Значение = НормализованныйИсточник(Источник);
		Если Не ПустаяСтрока(Значение) И Нормализованные.Найти(Значение) = Неопределено Тогда
			Нормализованные.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	ИзменитьНастройку("allowedOrigins", Нормализованные);

КонецПроцедуры

// Устанавливает имя заголовка, в котором доверенный реверс-прокси передает IP клиента.
// Пустое имя отключает ограничения и блокировки по IP.
//
// Параметры:
//  ИмяЗаголовка - Строка - например, "X-Real-IP".
//
Процедура УстановитьЗаголовокАдресаКлиента(ИмяЗаголовка) Экспорт

	ИзменитьНастройку("clientIpHeader", СокрЛП(ИмяЗаголовка));

КонецПроцедуры

// Устанавливает дополнительный текст инструкций для модели (глоссарий, особенности базы).
//
// Параметры:
//  Текст - Строка - текст инструкций.
//
Процедура УстановитьИнструкции(Текст) Экспорт

	ИзменитьНастройку("instructions", СокрЛП(Текст));

КонецПроцедуры

// Устанавливает шаблоны глобально запрещенных полей (п. 7.6 ТЗ), например "*Пароль*".
// Запреты действуют для всех профилей, включая доверенные.
//
// Параметры:
//  Шаблоны - Массив из Строка - шаблоны имен полей; * - любая последовательность символов.
//
Процедура УстановитьЗапрещенныеПоля(Шаблоны) Экспорт

	ИзменитьНастройку("bannedFieldPatterns", НепустыеСтроки(Шаблоны));

КонецПроцедуры

// Устанавливает шаблоны глобально запрещенных объектов (п. 7.6 ТЗ), например "ПланОбмена.*".
//
// Параметры:
//  Шаблоны - Массив из Строка - шаблоны полных имен объектов.
//
Процедура УстановитьЗапрещенныеОбъекты(Шаблоны) Экспорт

	ИзменитьНастройку("bannedObjectPatterns", НепустыеСтроки(Шаблоны));

КонецПроцедуры

// Настройки сервера без секретов - для просмотра администратором.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция ОписаниеНастроек() Экспорт

	ПроверитьПраваАдминистратора();

	Результат = Новый Соответствие;
	Для Каждого Элемент Из mcp1c_Настройки.Получить() Цикл
		Если mcp1c_Настройки.СекретныеКлючи().Найти(Элемент.Ключ) = Неопределено Тогда
			Результат.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("ibBindingPending", ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Результат, "ibBinding")));
	Возврат mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Результат);

КонецФункции

// Состояние сервера для окна команды "Состояние MCP-сервера".
//
// Возвращаемое значение:
//  Структура:
//   * Включен - Булево - сервер обрабатывает запросы.
//   * КаноническийАдрес - Строка - публичный адрес.
//   * ТребуетсяПодтверждениеПереноса - Булево - ИБ отличается от зафиксированной (сервер отвечает 503).
//   * ЕстьПраваАдминистратора - Булево - пользователь может менять состояние.
//   * Текст - Строка - описание состояния для пользователя.
//
Функция СостояниеСервера() Экспорт

	ЕстьПрава = ЕстьПраваАдминистратора();
	Если Не ЕстьПрава И Не ЕстьПравоПросмотра() Тогда
		ВызватьИсключение "Недостатньо прав для перегляду стану MCP-сервера";
	КонецЕсли;

	Настройки = mcp1c_Настройки.Получить();
	Включен = mcp1c_Служебный.СвойствоБулево(Настройки, "enabled", Ложь);
	Адрес = mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl");
	Привязка = mcp1c_Служебный.СвойствоСтрока(Настройки, "ibBinding");
	Статистика = СтатистикаТокенов();

	// Привязку фиксирует сеанс веб-публикации; в сеансе администратора строка соединения
	// может отличаться, поэтому расхождение здесь - только подсказка, а не диагноз.
	ТребуетсяПодтверждение = ПоследнийОтказПоПривязке();

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Стан: %1", ?(Включен, "увімкнено", "вимкнено")));
	Строки.Добавить(СтрШаблон("Публічна адреса: %1",
		?(ПустаяСтрока(Адрес), "<не задана>", Адрес)));
	Строки.Добавить(СтрШаблон("Прив'язка до бази: %1",
		?(ПустаяСтрока(Привязка), "буде зафіксована першим запитом", Привязка)));
	Если ТребуетсяПодтверждение Тогда
		Строки.Добавить("Увага: сервер відхиляє запити, бо розташування бази змінилося. Підтвердіть перенесення.");
	КонецЕсли;
	Строки.Добавить(СтрШаблон("Діючих токенів: %1, спливають протягом 7 днів: %2",
		Статистика.Действующих, Статистика.Истекающих));
	Строки.Добавить(СтрШаблон("Заголовок IP клієнта: %1",
		mcp1c_Служебный.СвойствоСтрока(Настройки, "clientIpHeader")));

	Результат = Новый Структура;
	Результат.Вставить("Включен", Включен);
	Результат.Вставить("КаноническийАдрес", Адрес);
	Результат.Вставить("ТребуетсяПодтверждениеПереноса", ТребуетсяПодтверждение);
	Результат.Вставить("ЕстьПраваАдминистратора", ЕстьПрава);
	Результат.Вставить("Текст", СтрСоединить(Строки, Символы.ПС));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Токены

// Выпускает новый токен доступа. Значение токена возвращается один раз;
// в базе хранится только SHA-256 секрета.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - кому выдан токен.
//  СрокДействияДней - Число - срок действия в днях; 0 - срок по умолчанию (defaultTokenDays).
//  Комментарий - Строка - произвольный комментарий.
//
// Возвращаемое значение:
//  Структура:
//   * Токен - Строка - значение для заголовка Authorization: Bearer.
//   * Идентификатор - Строка - id токена.
//   * Ссылка - СправочникСсылка.mcp1c_ТокеныДоступа - запись токена.
//   * ДействуетДо - Дата - дата окончания действия (UTC).
//   * ФрагментыПодключения - Строка - токен и готовые настройки клиентов (п. 9.3 ТЗ).
//
Функция ВыпуститьТокен(Клиент, Знач СрокДействияДней = 0, Знач Комментарий = "") Экспорт

	ПроверитьПраваАдминистратора();
	ПроверитьКлиента(Клиент);

	Настройки = mcp1c_Настройки.Получить();
	МаксимумДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "maxTokenDays", 90);
	Если СрокДействияДней <= 0 Тогда
		СрокДействияДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "defaultTokenDays", 30);
	КонецЕсли;
	Если СрокДействияДней > МаксимумДней Тогда
		ВызватьИсключение СтрШаблон("Термін дії токена не може перевищувати %1 дн.", МаксимумДней);
	КонецЕсли;

	НовыйТокен = mcp1c_Аутентификация.НовыйТокен();
	Пока mcp1c_Аутентификация.ТокенПоИдентификатору(НовыйТокен.Идентификатор) <> Неопределено Цикл
		НовыйТокен = mcp1c_Аутентификация.НовыйТокен();
	КонецЦикла;

	Сейчас = ТекущаяУниверсальнаяДата();
	ДействуетДо = Сейчас + Цел(СрокДействияДней) * 86400;
	Комментарий = СокрЛП(Комментарий);

	Объект = Справочники.mcp1c_ТокеныДоступа.СоздатьЭлемент();
	Объект.Владелец = Клиент;
	Объект.Код = НовыйТокен.Идентификатор;
	Объект.Наименование = ?(ПустаяСтрока(Комментарий),
		СтрШаблон("Токен від %1", Формат(Сейчас, "ДЛФ=D")), Лев(Комментарий, 100));
	Объект.Хеш = НовыйТокен.Хеш;
	Объект.ДатаВыпуска = Сейчас;
	Объект.ДействуетДо = ДействуетДо;
	Объект.Автор = ИмяТекущегоПользователя();
	Объект.Записать();

	mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон(
		"Выпущен токен %1 для клиента ""%2"" пользователем %3, действует до %4 UTC",
		НовыйТокен.Идентификатор, Строка(Клиент), ИмяТекущегоПользователя(), mcp1c_Служебный.ДатаВСтроку(ДействуетДо)));

	Результат = Новый Структура;
	Результат.Вставить("Токен", НовыйТокен.Токен);
	Результат.Вставить("Идентификатор", НовыйТокен.Идентификатор);
	Результат.Вставить("Ссылка", Объект.Ссылка);
	Результат.Вставить("ДействуетДо", ДействуетДо);
	Результат.Вставить("ФрагментыПодключения", ФрагментыПодключения(НовыйТокен.Токен, ДействуетДо,
		mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl")));
	Возврат Результат;

КонецФункции

// Отзывает токен. Отзыв действует со следующего запроса.
//
// Параметры:
//  Токен - СправочникСсылка.mcp1c_ТокеныДоступа, Строка - ссылка, id токена (12 символов) или полное значение.
//
Процедура ОтозватьТокен(Токен) Экспорт

	ПроверитьПраваАдминистратора();

	Ссылка = Токен;
	Если ТипЗнч(Токен) = Тип("Строка") Тогда
		Ссылка = mcp1c_Аутентификация.ТокенПоИдентификатору(ИдентификаторИзЗначения(Токен));
	КонецЕсли;
	Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.mcp1c_ТокеныДоступа") Или Ссылка.Пустая() Тогда
		ВызватьИсключение "Токен не знайдено";
	КонецЕсли;

	Токены = Новый Массив;
	Токены.Добавить(Ссылка);
	ОтозватьТокены(Токены);

КонецПроцедуры

// Помечает на удаление отозванные и истекшие токены старше указанного количества дней.
// Помеченные токены удаляет штатная обработка удаления помеченных объектов.
//
// Параметры:
//  ХранитьДней - Число - сколько дней хранить недействующие записи для аудита.
//
// Возвращаемое значение:
//  Число - количество помеченных записей.
//
Функция ПометитьНедействующиеТокены(ХранитьДней = 30) Экспорт

	ПроверитьПраваАдминистратора();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Токены.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.ПометкаУдаления
	|	И Токены.ДействуетДо < &Граница
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Токены.Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.ПометкаУдаления
	|	И Токены.Отозван
	|	И Токены.ДатаОтзыва < &Граница";
	Запрос.УстановитьПараметр("Граница", ТекущаяУниверсальнаяДата() - ХранитьДней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();

	Помечено = 0;
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		Помечено = Помечено + 1;
	КонецЦикла;

	Если Помечено > 0 Тогда
		mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Помечено на удаление недействующих токенов: %1 (пользователь %2)",
			Помечено, ИмяТекущегоПользователя()));
	КонецЕсли;
	Возврат Помечено;

КонецФункции

// Список токенов без хешей с временем последнего использования по журналу вызовов.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - отбор по клиенту.
//
// Возвращаемое значение:
//  Массив из Структура - Ссылка, Идентификатор, Клиент, Наименование, ДатаВыпуска, ДействуетДо,
//                        Отозван, Действует, ПоследнееИспользование (UTC, Неопределено - не использовался).
//
Функция СписокТокенов(Клиент = Неопределено) Экспорт

	ПроверитьПраваАдминистратора();

	// Условие с параметром-флагом: ИЛИ не мешает индексу, отбор по клиенту необязателен.
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.ИдентификаторТокена КАК ИдентификаторТокена,
	|	МАКСИМУМ(Журнал.Момент) КАК ПоследнееИспользование
	|ПОМЕСТИТЬ ВТ_Использование
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Результат <> ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.ОтказАутентификации)
	|	И Журнал.ИдентификаторТокена <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.ИдентификаторТокена
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторТокена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Токены.Ссылка КАК Ссылка,
	|	Токены.Код КАК Идентификатор,
	|	Токены.Владелец КАК Клиент,
	|	Токены.Наименование КАК Наименование,
	|	Токены.ДатаВыпуска КАК ДатаВыпуска,
	|	Токены.ДействуетДо КАК ДействуетДо,
	|	Токены.Отозван КАК Отозван,
	|	Использование.ПоследнееИспользование КАК ПоследнееИспользование
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Использование КАК Использование
	|		ПО Токены.Код = Использование.ИдентификаторТокена
	|ГДЕ
	|	(&ВсеКлиенты
	|			ИЛИ Токены.Владелец = &Клиент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВыпуска УБЫВ";
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	Запрос.УстановитьПараметр("ВсеКлиенты", Клиент = Неопределено);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();

	Сейчас = ТекущаяУниверсальнаяДата();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура;
		Описание.Вставить("Ссылка", Выборка.Ссылка);
		Описание.Вставить("Идентификатор", Выборка.Идентификатор);
		Описание.Вставить("Клиент", Выборка.Клиент);
		Описание.Вставить("Наименование", Выборка.Наименование);
		Описание.Вставить("ДатаВыпуска", Выборка.ДатаВыпуска);
		Описание.Вставить("ДействуетДо", Выборка.ДействуетДо);
		Описание.Вставить("Отозван", Выборка.Отозван);
		Описание.Вставить("Действует", Не Выборка.Отозван И Выборка.ДействуетДо > Сейчас);
		Описание.Вставить("ПоследнееИспользование",
			?(ЗначениеЗаполнено(Выборка.ПоследнееИспользование), Выборка.ПоследнееИспользование, Неопределено));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти


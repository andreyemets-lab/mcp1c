#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Токены без хешей с временем последнего использования по журналу вызовов. Читаются по правам текущего
// пользователя: аудитор видит токены, не имея права их выпускать.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - отбор по клиенту.
//
// Возвращаемое значение:
//  Массив из Структура - Ссылка, Идентификатор, Клиент, Наименование, ДатаВыпуска, ДействуетДо (UTC),
//                        Отозван, Действует, ОбластьДоступа (пустая - все возможности профиля), Автор,
//                        ПоследнееИспользование (UTC, Неопределено - не использовался).
//
Функция ОписанияТокенов(Клиент = Неопределено) Экспорт

	// Условие с параметром-флагом: ИЛИ не мешает индексу, отбор по клиенту необязателен.
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.ИдентификаторТокена КАК ИдентификаторТокена,
	|	МАКСИМУМ(Журнал.Момент) КАК ПоследнееИспользование
	|ПОМЕСТИТЬ ВТ_Использование
	|ИЗ
	|	РегистрСведений.mcp1c_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	НЕ Журнал.Результат В (ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.ОтказАутентификации),
	|				ЗНАЧЕНИЕ(Перечисление.mcp1c_РезультатыВызовов.ТребуетсяАутентификация))
	|	И Журнал.ИдентификаторТокена <> """"
	|	И (&ВсеКлиенты
	|			ИЛИ Журнал.Клиент = &Клиент)
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.ИдентификаторТокена
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторТокена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Токены.Ссылка КАК Ссылка,
	|	Токены.Код КАК Идентификатор,
	|	Токены.Владелец КАК Клиент,
	|	Токены.Наименование КАК Наименование,
	|	Токены.ДатаВыпуска КАК ДатаВыпуска,
	|	Токены.ДействуетДо КАК ДействуетДо,
	|	Токены.Отозван КАК Отозван,
	|	Токены.ОбластьДоступа КАК ОбластьДоступа,
	|	Токены.Автор КАК Автор,
	|	Использование.ПоследнееИспользование КАК ПоследнееИспользование
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Использование КАК Использование
	|		ПО Токены.Код = Использование.ИдентификаторТокена
	|ГДЕ
	|	(&ВсеКлиенты
	|			ИЛИ Токены.Владелец = &Клиент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВыпуска УБЫВ";
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	Запрос.УстановитьПараметр("ВсеКлиенты", Клиент = Неопределено);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();

	Сейчас = ТекущаяУниверсальнаяДата();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура;
		Описание.Вставить("Ссылка", Выборка.Ссылка);
		Описание.Вставить("Идентификатор", Выборка.Идентификатор);
		Описание.Вставить("Клиент", Выборка.Клиент);
		Описание.Вставить("Наименование", Выборка.Наименование);
		Описание.Вставить("ДатаВыпуска", Выборка.ДатаВыпуска);
		Описание.Вставить("ДействуетДо", Выборка.ДействуетДо);
		Описание.Вставить("Отозван", Выборка.Отозван);
		Описание.Вставить("Действует", Не Выборка.Отозван И Выборка.ДействуетДо > Сейчас);
		Описание.Вставить("ОбластьДоступа", Выборка.ОбластьДоступа);
		Описание.Вставить("Автор", Выборка.Автор);
		Описание.Вставить("ПоследнееИспользование",
			?(ЗначениеЗаполнено(Выборка.ПоследнееИспользование), Выборка.ПоследнееИспользование, Неопределено));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверяет права администратора MCP; при отсутствии прав вызывает исключение.
//
Процедура ПроверитьПраваАдминистратора() Экспорт

	Если ЕстьПраваАдминистратора() Тогда
		Возврат;
	КонецЕсли;
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон(
		"Відмова в доступі до адміністрування MCP користувачу %1", ИмяТекущегоПользователя()));
	ВызватьИсключение "Недостатньо прав: потрібна роль mcp1c_Администратор. Дані MCP читаються й змінюються "
		+ "за правами користувача, а ролі конфігурації й право «Адміністрування» прав на об'єкти розширення не дають";

КонецПроцедуры

// Есть ли у текущего пользователя права администратора MCP.
//
// Возвращаемое значение:
//  Булево - Истина, если у пользователя есть права роли mcp1c_Администратор.
//
Функция ЕстьПраваАдминистратора() Экспорт

	// Модуль не привилегированный: проверки выполняются по правам текущего пользователя.
	// Добавлять токены может только роль mcp1c_Администратор (у mcp1c_Сервис и mcp1c_Аудитор - только чтение).
	// Права Администрирование без прав на данные MCP недостаточно: настройки и токены читаются по правам
	// пользователя, и вместо понятной ошибки было бы нарушение прав доступа. В режиме совместимости
	// расширения 8.3.12 права ролей конфигурации (и ПолныеПрава) на объекты расширения не распространяются.
	Возврат ПравоДоступа("Добавление", Метаданные.Справочники.mcp1c_ТокеныДоступа);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверенныйАдрес(Знач Адрес)
	// Публичный адрес без пробелов по краям; адрес должен начинаться с https:// (http:// - для локальной сети).

	Адрес = СокрЛП(Адрес);
	Если Не ПустаяСтрока(Адрес) И Не СтрНачинаетсяС(НРег(Адрес), "https://")
		И Не СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		ВызватьИсключение "Адреса має починатися з https://";
	КонецЕсли;
	Возврат Адрес;

КонецФункции

Процедура ПроверитьАдресДляOAuth(Адрес)
	// OAuth требует публичного адреса: он - ресурс токенов (RFC 8707) и основа адресов сервера авторизации.

	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Для OAuth потрібна публічна адреса MCP-сервера: задайте її в робочому місці";
	КонецЕсли;
	Части = mcp1c_ПравилаOAuth.РазобратьАдрес(Адрес);
	Если Части = Неопределено Или Части.ЕстьФрагмент Или Не ПустаяСтрока(Части.Запрос) Тогда
		ВызватьИсключение "Публічна адреса MCP-сервера для OAuth має бути абсолютною, без параметрів і фрагмента";
	КонецЕсли;

КонецПроцедуры

// Изменения настроек OAuth из параметров администратора, проверенные и нормализованные.
//
// Параметры:
//  Параметры - Структура - свойства, описанные у процедуры УстановитьНастройкиOAuth.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ настройки и новое значение.
//
Функция ИзмененияНастроекOAuth(Параметры)

	Изменения = Новый Соответствие;
	Если Параметры.Свойство("Включен") Тогда
		Изменения.Вставить("oauthEnabled", Параметры.Включен = Истина);
	КонецЕсли;
	Если Параметры.Свойство("ДинамическаяРегистрация") Тогда
		Изменения.Вставить("oauthDynamicRegistration", Параметры.ДинамическаяРегистрация = Истина);
	КонецЕсли;
	Пределы = Новый Массив;
	Пределы.Добавить(Новый Структура("Свойство, Ключ, Минимум, Максимум, Единица", "СрокДоступаМинут",
		"oauthAccessTokenMinutes", 5, 1440, "хв"));
	Пределы.Добавить(Новый Структура("Свойство, Ключ, Минимум, Максимум, Единица", "СрокОбновленияДней",
		"oauthRefreshTokenDays", 1, 365, "дн."));
	Пределы.Добавить(Новый Структура("Свойство, Ключ, Минимум, Максимум, Единица", "СрокПодключенияДней",
		"oauthConnectionDays", 1, 365, "дн."));
	Пределы.Добавить(Новый Структура("Свойство, Ключ, Минимум, Максимум, Единица", "СрокКодаМинут",
		"oauthConnectionCodeMinutes", 1, 60, "хв"));
	Для Каждого Предел Из Пределы Цикл
		Если Не Параметры.Свойство(Предел.Свойство) Тогда
			Продолжить;
		КонецЕсли;
		Значение = Параметры[Предел.Свойство];
		Если ТипЗнч(Значение) <> Тип("Число") Или Значение <> Цел(Значение)
			Или Значение < Предел.Минимум Или Значение > Предел.Максимум Тогда
			ВызватьИсключение СтрШаблон("Значення %1 має бути цілим числом від %2 до %3 %4", Предел.Свойство,
				Предел.Минимум, Предел.Максимум, Предел.Единица);
		КонецЕсли;
		Изменения.Вставить(Предел.Ключ, Значение);
	КонецЦикла;
	Если Параметры.Свойство("ПрефиксыCIMD") Тогда
		Префиксы = Параметры.ПрефиксыCIMD;
		Если ТипЗнч(Префиксы) = Тип("Строка") Тогда
			Префиксы = mcp1c_ПравилаOAuth.АдресаИзТекста(Префиксы);
		КонецЕсли;
		Нормализованные = Новый Массив;
		Для Каждого Префикс Из Префиксы Цикл
			Значение = СокрЛП(Префикс);
			Части = mcp1c_ПравилаOAuth.РазобратьАдрес(Значение);
			Если Части = Неопределено Или Части.Схема <> "https" Или Части.ЕстьПользователь Или Части.ЕстьФрагмент Тогда
				ВызватьИсключение СтрШаблон("Префікс адрес документів клієнтів %1 має починатися з https:// і хоста",
					Значение);
			КонецЕсли;
			Если Нормализованные.Найти(Значение) = Неопределено Тогда
				Нормализованные.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		Изменения.Вставить("oauthCimdPrefixes", Нормализованные);
	КонецЕсли;
	Возврат Изменения;

КонецФункции

Процедура ИзменитьНастройку(Ключ, Значение)
	// Простое значение, равное текущему, не записывается и не попадает в журнал регистрации: мастер настройки
	// сохраняет адрес и заголовок IP при каждом переходе с первого шага.

	ПроверитьПраваАдминистратора();

	Изменена = Ложь;
	НачатьТранзакцию();
	Попытка
		Настройки = mcp1c_Настройки.ЗаблокироватьИПрочитать();
		Текущее = Настройки.Получить(Ключ);
		Изменена = ТипЗнч(Текущее) <> ТипЗнч(Значение) Или Текущее <> Значение;
		Если Изменена Тогда
			Настройки.Вставить(Ключ, Значение);
			mcp1c_Настройки.Записать(Настройки);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Изменена Тогда
		mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Користувач %1 змінив налаштування %2",
			ИмяТекущегоПользователя(), Ключ));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКлиента(Клиент)

	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.mcp1c_КлиентыДоступа") Или Клиент.Пустая() Тогда
		ВызватьИсключение "Не вказано клієнта доступу";
	КонецЕсли;
	Реквизиты = Новый Запрос(
	"ВЫБРАТЬ
	|	Клиенты.Профиль КАК Профиль,
	|	Клиенты.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|ГДЕ
	|	Клиенты.Ссылка = &Клиент");
	Реквизиты.УстановитьПараметр("Клиент", Клиент);
	Выборка = Реквизиты.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.ПометкаУдаления Тогда
		ВызватьИсключение "Клієнта доступу не знайдено або позначено на вилучення";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Выборка.Профиль) Тогда
		ВызватьИсключение "У клієнта доступу не задано профіль: токен не матиме доступу до даних";
	КонецЕсли;

КонецПроцедуры

Функция ДействующиеТокены()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Токены.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	НЕ Токены.Отозван");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Процедура ОтозватьТокены(Токены)

	Сейчас = ТекущаяУниверсальнаяДата();
	Для Каждого Ссылка Из Токены Цикл
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.mcp1c_ТокеныДоступа");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
		НачатьТранзакцию();
		Попытка
			Блокировка.Заблокировать();
			Объект = Ссылка.ПолучитьОбъект();
			Если Не Объект.Отозван Тогда
				Объект.Отозван = Истина;
				Объект.ДатаОтзыва = Сейчас;
				Объект.Записать();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		mcp1c_Аудит.ЗаписатьСобытиеТокенов(СтрШаблон("Користувач %2 відкликав токен %1",
			Строка(Ссылка.Код), ИмяТекущегоПользователя()));
	КонецЦикла;

КонецПроцедуры

Функция НормализованныйИсточник(Источник)

	Значение = НРег(СокрЛП(Источник));
	Пока СтрЗаканчиваетсяНа(Значение, "/") Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	Возврат Значение;

КонецФункции

Функция НепустыеСтроки(Значения)

	Результат = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Текст = СокрЛП(Значение);
		Если Не ПустаяСтрока(Текст) И Результат.Найти(Текст) = Неопределено Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИдентификаторИзЗначения(Знач Значение)

	// Допускается передать полный токен: id - символы 7-18.
	Значение = СокрЛП(Значение);
	Если СтрНачинаетсяС(Значение, "mcp1c_") И СтрДлина(Значение) > 18 Тогда
		Возврат Сред(Значение, 7, 12);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ИмяТекущегоПользователя()

	Имя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Возврат ?(ПустаяСтрока(Имя), "<без користувача>", Имя);

КонецФункции

#КонецОбласти

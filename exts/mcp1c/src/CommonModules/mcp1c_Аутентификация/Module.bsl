///////////////////////////////////////////////////////////////////////////////
// mcp1c_Аутентификация: персональные токены доступа (PAT, п. 6.3 ТЗ).
// Токены читаются по правам роли mcp1c_Сервис (привилегированные модули в расширениях недопустимы).
//
// Формат токена: mcp1c_<id>_<secret>
//   id     - 12 символов base32, код элемента справочника mcp1c_ТокеныДоступа (виден в журнале);
//   secret - 43 символа base64url (256 бит), в базе хранится только SHA-256.
// Токен принимается только из заголовка Authorization: Bearer или
// X-MCP-Authorization: Bearer (если реверс-прокси переносит заголовок).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет токен доступа запроса.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - токен действителен.
//   * ТокенПредъявлен - Булево - клиент передал какой-либо токен.
//   * Причина - Строка - причина отказа; пишется в журнал, клиенту не сообщается.
//   * ИдентификаторТокена - Строка - id токена, если его удалось разобрать.
//   * Токен - СправочникСсылка.mcp1c_ТокеныДоступа, Неопределено - запись токена.
//   * Клиент - СправочникСсылка.mcp1c_КлиентыДоступа, Неопределено - клиент доступа.
//   * ИмяКлиента - Строка - наименование клиента.
//   * ДанныеКлиента - Структура, Неопределено - ограничения клиента, см. ПроверитьОграниченияКлиента.
//
Функция ПроверитьЗапрос(Запрос) Экспорт

	Результат = НовыйРезультатПроверки();

	// Платформа принимает JWT в параметре AccessToken; MCP запрещает токены в строке запроса.
	Если mcp1c_Служебный.ПараметрСтрокиЗапроса(Запрос, "AccessToken") <> Неопределено Тогда
		Результат.ТокенПредъявлен = Истина;
		Результат.Причина = "Токен в строке запроса запрещен";
		Возврат Результат;
	КонецЕсли;

	Значение = ТокенИзЗаголовков(Запрос);
	Если Значение = Неопределено Тогда
		Результат.Причина = "Токен не передан";
		Возврат Результат;
	КонецЕсли;
	Результат.ТокенПредъявлен = Истина;

	Части = РазобратьТокен(Значение);
	Если Части = Неопределено Тогда
		Результат.Причина = "Неверный формат токена";
		Возврат Результат;
	КонецЕсли;
	Результат.ИдентификаторТокена = Части.Идентификатор;

	Данные = ДанныеТокена(Части.Идентификатор);
	Если Данные = Неопределено Тогда
		Результат.Причина = "Токен не найден";
		Возврат Результат;
	КонецЕсли;
	Причина = ПричинаНедействительности(Данные, Части.Секрет);
	Если Не ПустаяСтрока(Причина) Тогда
		Результат.Причина = Причина;
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Токен = Данные.Ссылка;
	Результат.Клиент = Данные.Клиент;
	Результат.ИмяКлиента = Данные.ИмяКлиента;
	Результат.ДанныеКлиента = Данные;
	Возврат Результат;

КонецФункции

// Проверяет ограничения клиента: блокировку, профиль, IP-адрес, Origin и окно времени.
// Нарушение - отказ 403 (п. 4.4 ТЗ).
//
// Параметры:
//  ДанныеКлиента - Структура - см. ПроверитьЗапрос.
//  АдресКлиента - Строка - IP клиента из заголовка доверенного прокси; пустая строка, если неизвестен.
//  Origin - Строка - заголовок Origin; пустая строка, если не передан.
//  OriginРазрешенСервером - Булево - Origin входит в разрешенные значения сервера.
//  ВремяСеанса - Дата - текущее время сервера.
//
// Возвращаемое значение:
//  Строка - причина отказа для журнала; пустая строка, если ограничения соблюдены.
//
Функция ПроверитьОграниченияКлиента(ДанныеКлиента, АдресКлиента, Origin, OriginРазрешенСервером, ВремяСеанса) Экспорт

	Если ДанныеКлиента.КлиентЗаблокирован Или ДанныеКлиента.КлиентУдален Тогда
		Возврат "Клиент доступа заблокирован";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеКлиента.Профиль) Тогда
		Возврат "У клиента доступа не задан профиль";
	КонецЕсли;

	Если Не ПустаяСтрока(ДанныеКлиента.РазрешенныеАдреса) Тогда
		Если ПустаяСтрока(АдресКлиента) Тогда
			Возврат "IP-адрес клиента неизвестен, а клиенту заданы разрешенные адреса";
		КонецЕсли;
		Если Не mcp1c_Сеть.АдресВСписке(АдресКлиента, ДанныеКлиента.РазрешенныеАдреса) Тогда
			Возврат "IP-адрес не входит в разрешенные адреса клиента";
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(Origin) И Не OriginРазрешенСервером
		И Не ИсточникВСписке(Origin, ДанныеКлиента.РазрешенныеИсточники) Тогда
		Возврат "Origin не разрешен";
	КонецЕсли;

	Если Не ВремяВОкне(ВремяСеанса, ДанныеКлиента.ДоступС, ДанныеКлиента.ДоступПо) Тогда
		Возврат "Вызов вне разрешенного окна времени клиента";
	КонецЕсли;

	Возврат "";

КонецФункции

// Формирует новый токен. Запись в справочник выполняет mcp1c_Администрирование.
//
// Возвращаемое значение:
//  Структура:
//   * Идентификатор - Строка - id токена.
//   * Токен - Строка - полное значение токена (показывается один раз).
//   * Хеш - Строка - SHA-256 секрета для хранения.
//
Функция НовыйТокен() Экспорт

	Идентификатор = mcp1c_Служебный.СлучайнаяСтрокаBase32(ДлинаИдентификатора());
	Секрет = mcp1c_Служебный.КодироватьBase64URL(mcp1c_Служебный.СлучайныеДанные());

	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("Токен", ПрефиксТокена() + Идентификатор + "_" + Секрет);
	Результат.Вставить("Хеш", mcp1c_Служебный.ХешSHA256(Секрет));
	Возврат Результат;

КонецФункции

// Находит токен по идентификатору.
//
// Параметры:
//  Идентификатор - Строка - id токена.
//
// Возвращаемое значение:
//  СправочникСсылка.mcp1c_ТокеныДоступа, Неопределено - токен.
//
Функция ТокенПоИдентификатору(Идентификатор) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Токены.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|ГДЕ
	|	Токены.Код = &Код");
	Запрос.УстановитьПараметр("Код", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатПроверки()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТокенПредъявлен", Ложь);
	Результат.Вставить("Причина", "");
	Результат.Вставить("ИдентификаторТокена", "");
	Результат.Вставить("Токен", Неопределено);
	Результат.Вставить("Клиент", Неопределено);
	Результат.Вставить("ИмяКлиента", "");
	Результат.Вставить("ДанныеКлиента", Неопределено);
	Возврат Результат;

КонецФункции

Функция ДанныеТокена(Идентификатор)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Токены.Ссылка КАК Ссылка,
	|	Токены.Хеш КАК Хеш,
	|	Токены.ДействуетДо КАК ДействуетДо,
	|	Токены.Отозван КАК Отозван,
	|	Токены.ПометкаУдаления КАК ТокенУдален,
	|	Токены.Владелец КАК Клиент,
	|	Клиенты.Наименование КАК ИмяКлиента,
	|	Клиенты.Профиль КАК Профиль,
	|	Клиенты.Заблокирован КАК КлиентЗаблокирован,
	|	Клиенты.ПометкаУдаления КАК КлиентУдален,
	|	Клиенты.РазрешенныеАдреса КАК РазрешенныеАдреса,
	|	Клиенты.РазрешенныеИсточники КАК РазрешенныеИсточники,
	|	Клиенты.ДоступС КАК ДоступС,
	|	Клиенты.ДоступПо КАК ДоступПо
	|ИЗ
	|	Справочник.mcp1c_ТокеныДоступа КАК Токены
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|		ПО Токены.Владелец = Клиенты.Ссылка
	|ГДЕ
	|	Токены.Код = &Код");
	Запрос.УстановитьПараметр("Код", Идентификатор);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Данные.Вставить(Колонка.Имя, Таблица[0][Колонка.Имя]);
	КонецЦикла;
	Возврат Данные;

КонецФункции

Функция ПричинаНедействительности(Данные, Секрет)

	Если Данные.Хеш <> mcp1c_Служебный.ХешSHA256(Секрет) Тогда
		Возврат "Неверный секрет токена";
	КонецЕсли;
	Если Данные.Отозван Тогда
		Возврат "Токен отозван";
	КонецЕсли;
	Если Данные.ТокенУдален Тогда
		Возврат "Токен помечен на удаление";
	КонецЕсли;
	Если Данные.ДействуетДо <= ТекущаяУниверсальнаяДата() Тогда
		Возврат "Срок действия токена истек";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ИсточникВСписке(Origin, Список)

	Значение = НРег(СокрЛП(Origin));
	Для Каждого Элемент Из mcp1c_Сеть.ЭлементыСписка(Список) Цикл
		Разрешенный = НРег(Элемент);
		Пока СтрЗаканчиваетсяНа(Разрешенный, "/") Цикл
			Разрешенный = Лев(Разрешенный, СтрДлина(Разрешенный) - 1);
		КонецЦикла;
		Если Разрешенный = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Попадает ли время суток в окно [начало, окончание]; окно через полночь допускается.
Функция ВремяВОкне(Момент, ВремяНачала, ВремяОкончания)

	НачалоОкна = СекундыСуток(ВремяНачала);
	КонецОкна = СекундыСуток(ВремяОкончания);
	Если НачалоОкна = 0 И КонецОкна = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Текущее = СекундыСуток(Момент);
	Если НачалоОкна <= КонецОкна Тогда
		Возврат Текущее >= НачалоОкна И Текущее <= КонецОкна;
	КонецЕсли;
	Возврат Текущее >= НачалоОкна Или Текущее <= КонецОкна;

КонецФункции

Функция СекундыСуток(Значение)

	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Час(Значение) * 3600 + Минута(Значение) * 60 + Секунда(Значение);

КонецФункции

Функция ПрефиксТокена()

	Возврат "mcp1c_";

КонецФункции

Функция ДлинаИдентификатора()

	Возврат 12;

КонецФункции

Функция ДлинаСекрета()

	Возврат 43;

КонецФункции

Функция ТокенИзЗаголовков(Запрос)

	ИменаЗаголовков = СтрРазделить("Authorization,X-MCP-Authorization", ",");
	Для Каждого ИмяЗаголовка Из ИменаЗаголовков Цикл
		Значение = mcp1c_Служебный.ЗаголовокЗапроса(Запрос, ИмяЗаголовка);
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Значение = СокрЛП(Значение);
		Если НРег(Лев(Значение, 7)) <> "bearer " Тогда
			Продолжить;
		КонецЕсли;
		Токен = СокрЛП(Сред(Значение, 8));
		Если Не ПустаяСтрока(Токен) Тогда
			Возврат Токен;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция РазобратьТокен(Токен)

	Префикс = ПрефиксТокена();
	ДлинаПрефикса = СтрДлина(Префикс);
	ОжидаемаяДлина = ДлинаПрефикса + ДлинаИдентификатора() + 1 + ДлинаСекрета();
	Если СтрДлина(Токен) <> ОжидаемаяДлина Или Не СтрНачинаетсяС(Токен, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Идентификатор = Сред(Токен, ДлинаПрефикса + 1, ДлинаИдентификатора());
	Разделитель = Сред(Токен, ДлинаПрефикса + ДлинаИдентификатора() + 1, 1);
	Секрет = Сред(Токен, ДлинаПрефикса + ДлинаИдентификатора() + 2);

	Если Разделитель <> "_"
		Или Не mcp1c_Служебный.СостоитИзСимволов(Идентификатор, mcp1c_Служебный.АлфавитBase32())
		Или Не mcp1c_Служебный.СостоитИзСимволов(Секрет, mcp1c_Служебный.АлфавитBase64URL()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Идентификатор, Секрет", Идентификатор, Секрет);

КонецФункции

#КонецОбласти

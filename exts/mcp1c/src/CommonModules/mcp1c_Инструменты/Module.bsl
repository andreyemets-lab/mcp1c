///////////////////////////////////////////////////////////////////////////////
// mcp1c_Инструменты: реестр инструментов MCP, проверка аргументов, реализация.
//
// Этап 0 (прототип) - только метаданные, данные ИБ не читаются:
//   get_context, list_objects, describe_object.
// Инструменты чтения данных (query_records, get_balances, ...) появятся на этапе 1
// вместе с профилями доступа.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Описания инструментов для tools/list в детерминированном порядке.
//
// Возвращаемое значение:
//  Массив из Соответствие - name, title, description, inputSchema, outputSchema, annotations.
//
Функция ОписанияИнструментов() Экспорт

	Результат = Новый Массив;
	Результат.Добавить(ОписаниеGetContext());
	Результат.Добавить(ОписаниеListObjects());
	Результат.Добавить(ОписаниеDescribeObject());
	Возврат Результат;

КонецФункции

// Описание инструмента по имени.
//
// Параметры:
//  Имя - Строка - имя инструмента.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - описание; Неопределено, если инструмента нет.
//
Функция ОписаниеИнструмента(Имя) Экспорт

	Для Каждого Описание Из ОписанияИнструментов() Цикл
		Если Описание.Получить("name") = Имя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Выполняет инструмент.
//
// Параметры:
//  Имя - Строка - имя существующего инструмента.
//  Аргументы - Соответствие, Неопределено - аргументы вызова.
//  Контекст - Структура - см. mcp1c_Протокол.НовыйКонтекст.
//
// Возвращаемое значение:
//  Соответствие - результат tools/call: content, structuredContent, isError.
//
Функция Вызвать(Имя, Знач Аргументы, Контекст) Экспорт

	Описание = ОписаниеИнструмента(Имя);
	Если Описание = Неопределено Тогда
		Возврат РезультатОшибки(СтрШаблон("Невідомий інструмент: %1", Имя));
	КонецЕсли;
	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;

	Ошибки = Новый Массив;
	ПроверитьПоСхеме(Аргументы, Описание.Получить("inputSchema"), "arguments", Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		Возврат РезультатОшибки("Некоректні аргументи: " + СтрСоединить(Ошибки, "; "));
	КонецЕсли;

	Попытка
		Если Имя = "get_context" Тогда
			Итог = ВыполнитьGetContext(Контекст);
		ИначеЕсли Имя = "list_objects" Тогда
			Итог = ВыполнитьListObjects(Аргументы);
		ИначеЕсли Имя = "describe_object" Тогда
			Итог = ВыполнитьDescribeObject(Аргументы);
		Иначе
			Итог = ИтогОшибка(СтрШаблон("Інструмент %1 не реалізовано", Имя));
		КонецЕсли;
	Исключение
		Контекст.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат РезультатОшибки(СтрШаблон(
			"Внутрішня помилка інструмента. Ідентифікатор запиту для адміністратора: %1",
			Контекст.ИдентификаторЗапроса));
	КонецПопытки;

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат РезультатОшибки(Итог.Ошибка);
	КонецЕсли;
	Возврат РезультатУспех(Итог.Данные);

КонецФункции

// Проверяет значение по подмножеству JSON Schema: type (object, string, integer,
// number, boolean, array), properties, required, additionalProperties = false, enum,
// minLength, maxLength, minimum, maximum, items, minItems, maxItems.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение (разобранный JSON).
//  Схема - Соответствие - схема.
//  Путь - Строка - путь к значению для текста ошибки.
//  Ошибки - Массив из Строка - сюда добавляются ошибки.
//
Процедура ПроверитьПоСхеме(Значение, Схема, Путь, Ошибки) Экспорт

	Если ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ТипСхемы = Схема.Получить("type");
	Если ТипСхемы = "object" Тогда
		ПроверитьОбъект(Значение, Схема, Путь, Ошибки);
	ИначеЕсли ТипСхемы = "array" Тогда
		ПроверитьМассив(Значение, Схема, Путь, Ошибки);
	ИначеЕсли ТипСхемы = "string" Тогда
		ПроверитьСтроку(Значение, Схема, Путь, Ошибки);
	ИначеЕсли ТипСхемы = "integer" Или ТипСхемы = "number" Тогда
		ПроверитьЧисло(Значение, Схема, Путь, Ошибки, ТипСхемы = "integer");
	ИначеЕсли ТипСхемы = "boolean" Тогда
		Если ТипЗнч(Значение) <> Тип("Булево") Тогда
			Ошибки.Добавить(Путь + ": очікується true або false");
		КонецЕсли;
	КонецЕсли;

	Варианты = Схема.Получить("enum");
	Если ТипЗнч(Варианты) = Тип("Массив") И Варианты.Найти(Значение) = Неопределено Тогда
		Ошибки.Добавить(СтрШаблон("%1: допустимі значення: %2", Путь, СтрСоединить(Варианты, ", ")));
	КонецЕсли;

КонецПроцедуры


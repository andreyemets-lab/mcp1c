Функция ОписаниеGetContext()

	Свойства = Новый Соответствие;

	Описание = НовоеОписание("get_context", "Контекст сервера 1С",
		"Повертає контекст сервера 1С: назву й версію конфігурації, версію платформи, поточні дату й час "
		+ "сервера з часовим поясом, мову сеансу, ім'я клієнта і доступні можливості. "
		+ "Викликайте першим, щоб зорієнтуватися в базі.",
		СхемаОбъекта(Свойства, Новый Массив));

	Выход = Новый Соответствие;
	Выход.Вставить("configuration", СхемаТипа("object"));
	Выход.Вставить("platform", СхемаТипа("object"));
	Выход.Вставить("server_time", СхемаТипа("object"));
	Выход.Вставить("language", СхемаТипа("string"));
	Выход.Вставить("client", СхемаТипа("object"));
	Выход.Вставить("server", СхемаТипа("object"));
	Описание.Вставить("outputSchema", СхемаВыхода(Выход, "configuration,platform,server_time"));
	Возврат Описание;

КонецФункции

Функция ОписаниеListObjects()

	Свойства = Новый Соответствие;
	Свойства.Вставить("kinds", СхемаМассиваСтрок(
		"Види об'єктів; якщо не вказано - усі види", mcp1c_Метаданные.КодыВидов()));
	Свойства.Вставить("search", СхемаСтроки(
		"Підрядок імені або синоніма без урахування регістру, наприклад ""контраг""", 100));
	Свойства.Вставить("limit", СхемаЦелого("Скільки об'єктів повернути", 1, 500, 100));
	Свойства.Вставить("cursor", СхемаСтроки("next_cursor з попередньої відповіді", 200));

	Описание = НовоеОписание("list_objects", "Перелік об'єктів метаданих",
		"Перелік об'єктів метаданих конфігурації 1С (довідники, документи, регістри, перерахування тощо) "
		+ "з синонімами. Фільтр за видами і пошук за підрядком в імені або синонімі. "
		+ "Використовуйте, щоб знайти потрібний об'єкт, а потім describe_object для його структури. "
		+ "Приклад: {""kinds"": [""catalog""], ""search"": ""контраг""}.",
		СхемаОбъекта(Свойства, Новый Массив));

	Выход = Новый Соответствие;
	Выход.Вставить("items", СхемаТипа("array"));
	Выход.Вставить("total", СхемаТипа("integer"));
	Выход.Вставить("returned", СхемаТипа("integer"));
	Выход.Вставить("next_cursor", СхемаТипа("string"));
	Описание.Вставить("outputSchema", СхемаВыхода(Выход, "items,total,returned"));
	Возврат Описание;

КонецФункции

Функция ОписаниеDescribeObject()

	Свойства = Новый Соответствие;
	Свойства.Вставить("object", СхемаСтроки(
		"Повне ім'я об'єкта, як у метаданих: Справочник.Контрагенты, Документ.РеализацияТоваровУслуг, "
		+ "РегистрНакопления.ТоварыНаСкладах; можна з англійським класом: Catalog.Контрагенты", 300));
	Свойства.Вставить("include", СхемаМассиваСтрок(
		"Розділи опису; якщо не вказано - усі доступні для цього виду", mcp1c_Метаданные.КодыРазделов()));
	Свойства.Вставить("max_fields", СхемаЦелого("Найбільша кількість полів у відповіді", 10, 1000, 300));

	Обязательные = Новый Массив;
	Обязательные.Добавить("object");

	Описание = НовоеОписание("describe_object", "Структура об'єкта метаданих",
		"Структура об'єкта метаданих 1С: реквізити з типами, табличні частини, виміри й ресурси регістрів, "
		+ "значення перерахувань, регістри, у які пише документ, поля пошуку, властивості виду "
		+ "(періодичність регістра, ієрархія довідника тощо). Імена полів повертаються так, як у метаданих.",
		СхемаОбъекта(Свойства, Обязательные));

	Выход = Новый Соответствие;
	Выход.Вставить("object", СхемаТипа("string"));
	Выход.Вставить("kind", СхемаТипа("string"));
	Выход.Вставить("name", СхемаТипа("string"));
	Выход.Вставить("synonym", СхемаТипа("string"));
	Описание.Вставить("outputSchema", СхемаВыхода(Выход, "object,kind,name"));
	Возврат Описание;

КонецФункции

Функция НовоеОписание(Имя, Заголовок, ТекстОписания, ВходнаяСхема)

	Аннотации = Новый Соответствие;
	Аннотации.Вставить("title", Заголовок);
	Аннотации.Вставить("readOnlyHint", Истина);
	Аннотации.Вставить("destructiveHint", Ложь);
	Аннотации.Вставить("idempotentHint", Истина);
	Аннотации.Вставить("openWorldHint", Ложь);

	Описание = Новый Соответствие;
	Описание.Вставить("name", Имя);
	Описание.Вставить("title", Заголовок);
	Описание.Вставить("description", ТекстОписания);
	Описание.Вставить("inputSchema", ВходнаяСхема);
	Описание.Вставить("annotations", Аннотации);
	Возврат Описание;

КонецФункции

Функция СхемаОбъекта(Свойства, Обязательные)

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Если Обязательные.Количество() > 0 Тогда
		Схема.Вставить("required", Обязательные);
	КонецЕсли;
	Схема.Вставить("additionalProperties", Ложь);
	Возврат Схема;

КонецФункции

Функция СхемаВыхода(Свойства, ОбязательныеСтрокой)

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(ОбязательныеСтрокой, ","));
	Возврат Схема;

КонецФункции

Функция СхемаТипа(ИмяТипа)

	Схема = Новый Соответствие;
	Схема.Вставить("type", ИмяТипа);
	Возврат Схема;

КонецФункции

Функция СхемаСтроки(ТекстОписания, МаксимальнаяДлина)

	Схема = СхемаТипа("string");
	Схема.Вставить("description", ТекстОписания);
	Схема.Вставить("maxLength", МаксимальнаяДлина);
	Возврат Схема;

КонецФункции

Функция СхемаЦелого(ТекстОписания, Минимум, Максимум, ПоУмолчанию)

	Схема = СхемаТипа("integer");
	Схема.Вставить("description", ТекстОписания);
	Схема.Вставить("minimum", Минимум);
	Схема.Вставить("maximum", Максимум);
	Схема.Вставить("default", ПоУмолчанию);
	Возврат Схема;

КонецФункции

Функция СхемаМассиваСтрок(ТекстОписания, Варианты)

	Элемент = СхемаТипа("string");
	Элемент.Вставить("enum", Варианты);

	Схема = СхемаТипа("array");
	Схема.Вставить("description", ТекстОписания);
	Схема.Вставить("items", Элемент);
	Схема.Вставить("maxItems", Варианты.Количество());
	Возврат Схема;

КонецФункции

#КонецОбласти

#Область Реализация

Функция ВыполнитьGetContext(Контекст)

	Конфигурация = Новый Соответствие;
	Конфигурация.Вставить("name", Метаданные.Имя);
	Конфигурация.Вставить("synonym", Метаданные.Синоним);
	Конфигурация.Вставить("version", Метаданные.Версия);
	Конфигурация.Вставить("vendor", Метаданные.Поставщик);

	ИнформацияОСистеме = Новый СистемнаяИнформация;
	Платформа = Новый Соответствие;
	Платформа.Вставить("version", ИнформацияОСистеме.ВерсияПриложения);
	Платформа.Вставить("type", Строка(ИнформацияОСистеме.ТипПлатформы));

	ДатаСеанса = ТекущаяДатаСеанса();
	ДатаUTC = ТекущаяУниверсальнаяДата();
	ВремяСервера = Новый Соответствие;
	ВремяСервера.Вставить("local", mcp1c_Служебный.ДатаВСтроку(ДатаСеанса));
	ВремяСервера.Вставить("utc", mcp1c_Служебный.ДатаВСтроку(ДатаUTC) + "Z");
	ВремяСервера.Вставить("timezone", ЧасовойПоясСеанса());
	ВремяСервера.Вставить("utc_offset_minutes", Окр((ДатаСеанса - ДатаUTC) / 60, 0));

	Клиент = Новый Соответствие;
	Клиент.Вставить("name", Контекст.Клиент);
	Клиент.Вставить("token_id", Контекст.ИдентификаторТокена);
	Клиент.Вставить("protocol_version", Контекст.ВерсияПротокола);

	Сервер = Новый Соответствие;
	Сервер.Вставить("name", mcp1c_Протокол.ИмяСервера());
	Сервер.Вставить("version", mcp1c_Протокол.ВерсияСервера());
	Сервер.Вставить("stage", "prototype");
	Сервер.Вставить("data_access", Ложь);

	Данные = Новый Соответствие;
	Данные.Вставить("configuration", Конфигурация);
	Данные.Вставить("platform", Платформа);
	Данные.Вставить("server_time", ВремяСервера);
	Данные.Вставить("language", КодЯзыкаСеанса());
	Данные.Вставить("client", Клиент);
	Данные.Вставить("server", Сервер);
	Данные.Вставить("notes", Подсказки());
	Возврат ИтогУспех(Данные);

КонецФункции

Функция ВыполнитьListObjects(Аргументы)

	Коды = mcp1c_Служебный.СвойствоМассив(Аргументы, "kinds");
	СтрокаПоиска = mcp1c_Служебный.СвойствоСтрока(Аргументы, "search");
	Лимит = mcp1c_Служебный.СвойствоЧисло(Аргументы, "limit", 100);

	Смещение = 0;
	Курсор = mcp1c_Служебный.СвойствоСтрока(Аргументы, "cursor");
	Если Не ПустаяСтрока(Курсор) Тогда
		Смещение = СмещениеИзКурсора(Курсор);
		Если Смещение = Неопределено Тогда
			Возврат ИтогОшибка("Курсор недійсний: повторіть запит без cursor");
		КонецЕсли;
	КонецЕсли;

	Список = mcp1c_Метаданные.СписокОбъектов(Коды, СтрокаПоиска, Смещение, Лимит);

	Данные = Новый Соответствие;
	Данные.Вставить("items", Список.Элементы);
	Данные.Вставить("total", Список.Всего);
	Данные.Вставить("returned", Список.Элементы.Количество());
	Если Список.СледующееСмещение <> Неопределено Тогда
		Данные.Вставить("next_cursor", КурсорИзСмещения(Список.СледующееСмещение));
	КонецЕсли;
	Возврат ИтогУспех(Данные);

КонецФункции

Функция ВыполнитьDescribeObject(Аргументы)

	ПолноеИмя = mcp1c_Служебный.СвойствоСтрока(Аргументы, "object");
	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(ПолноеИмя);
	Если ОбъектМД = Неопределено Тогда
		Возврат ИтогОшибка(СтрШаблон(
			"Об'єкт не знайдено або недоступний: %1. Перевірте ім'я через list_objects.", ПолноеИмя));
	КонецЕсли;

	Разделы = mcp1c_Служебный.СвойствоМассив(Аргументы, "include");
	МаксимумПолей = mcp1c_Служебный.СвойствоЧисло(Аргументы, "max_fields", 300);
	Возврат ИтогУспех(mcp1c_Метаданные.ОписаниеОбъекта(ОбъектМД, Разделы, МаксимумПолей));

КонецФункции

Функция КодЯзыкаСеанса()

	Попытка
		Возврат ТекущийЯзык().КодЯзыка;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция Подсказки()

	Результат = Новый Массив;
	Результат.Добавить("Етап 0: доступні лише метадані, дані інформаційної бази не читаються.");
	Результат.Добавить("Імена об'єктів передавайте так, як у метаданих 1С: Справочник.Контрагенты.");
	Результат.Добавить("Дати сервера - локальний час сеансу; часовий пояс у server_time.timezone.");
	Возврат Результат;

КонецФункции

Функция КурсорИзСмещения(Смещение)

	Возврат mcp1c_Служебный.КодироватьСтрокуBase64URL("list_objects:" + Формат(Смещение, "ЧН=0; ЧГ=0"));

КонецФункции

Функция СмещениеИзКурсора(Курсор)

	Текст = mcp1c_Служебный.ДекодироватьСтрокуBase64URL(Курсор);
	Префикс = "list_objects:";
	Если Текст = Неопределено Или Не СтрНачинаетсяС(Текст, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цифры = Сред(Текст, СтрДлина(Префикс) + 1);
	Если ПустаяСтрока(Цифры) Или СтрДлина(Цифры) > 9 Или Не mcp1c_Служебный.СостоитИзСимволов(Цифры, "0123456789") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

#КонецОбласти

#Область Результаты

Функция ИтогУспех(Данные)

	Возврат Новый Структура("Данные, Ошибка", Данные, "");

КонецФункции

Функция ИтогОшибка(ТекстОшибки)

	Возврат Новый Структура("Данные, Ошибка", Неопределено, ТекстОшибки);

КонецФункции

Функция РезультатУспех(Данные)

	Блок = Новый Соответствие;
	Блок.Вставить("type", "text");
	Блок.Вставить("text", mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Данные));
	Содержимое = Новый Массив;
	Содержимое.Добавить(Блок);

	Результат = Новый Соответствие;
	Результат.Вставить("content", Содержимое);
	Результат.Вставить("structuredContent", Данные);
	Результат.Вставить("isError", Ложь);
	Возврат Результат;

КонецФункции

Функция РезультатОшибки(ТекстОшибки)

	Блок = Новый Соответствие;
	Блок.Вставить("type", "text");
	Блок.Вставить("text", ТекстОшибки);
	Содержимое = Новый Массив;
	Содержимое.Добавить(Блок);

	Результат = Новый Соответствие;
	Результат.Вставить("content", Содержимое);
	Результат.Вставить("isError", Истина);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПроверкаСхемы

Процедура ПроверитьОбъект(Значение, Схема, Путь, Ошибки)

	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Ошибки.Добавить(Путь + ": очікується об'єкт");
		Возврат;
	КонецЕсли;

	Свойства = Схема.Получить("properties");
	Если ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		Свойства = Новый Соответствие;
	КонецЕсли;

	ПроверитьОбязательныеСвойства(Значение, Схема, Путь, Ошибки);

	ЗапретитьЛишние = (Схема.Получить("additionalProperties") = Ложь);
	Для Каждого Элемент Из Значение Цикл
		СхемаСвойства = Свойства.Получить(Элемент.Ключ);
		Если СхемаСвойства = Неопределено Тогда
			Если ЗапретитьЛишние Тогда
				Ошибки.Добавить(СтрШаблон("%1.%2: невідомий параметр", Путь, Элемент.Ключ));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Элемент.Значение = Неопределено Тогда
			Продолжить; // null трактуется как отсутствие необязательного параметра
		КонецЕсли;
		ПроверитьПоСхеме(Элемент.Значение, СхемаСвойства, Путь + "." + Элемент.Ключ, Ошибки);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОбязательныеСвойства(Значение, Схема, Путь, Ошибки)

	Обязательные = Схема.Получить("required");
	Если ТипЗнч(Обязательные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ИмяСвойства Из Обязательные Цикл
		Если Значение.Получить(ИмяСвойства) = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон("%1.%2: обов'язковий параметр", Путь, ИмяСвойства));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьМассив(Значение, Схема, Путь, Ошибки)

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Ошибки.Добавить(Путь + ": очікується масив");
		Возврат;
	КонецЕсли;

	Минимум = Схема.Получить("minItems");
	Если ТипЗнч(Минимум) = Тип("Число") И Значение.Количество() < Минимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: щонайменше %2 елементів", Путь, Минимум));
	КонецЕсли;
	Максимум = Схема.Получить("maxItems");
	Если ТипЗнч(Максимум) = Тип("Число") И Значение.Количество() > Максимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: не більше %2 елементів", Путь, Максимум));
	КонецЕсли;

	СхемаЭлемента = Схема.Получить("items");
	Если ТипЗнч(СхемаЭлемента) = Тип("Соответствие") Тогда
		Для Индекс = 0 По Значение.ВГраница() Цикл
			ПроверитьПоСхеме(Значение[Индекс], СхемаЭлемента, СтрШаблон("%1[%2]", Путь, Индекс), Ошибки);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСтроку(Значение, Схема, Путь, Ошибки)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Ошибки.Добавить(Путь + ": очікується рядок");
		Возврат;
	КонецЕсли;

	Минимум = Схема.Получить("minLength");
	Если ТипЗнч(Минимум) = Тип("Число") И СтрДлина(Значение) < Минимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: щонайменше %2 символів", Путь, Минимум));
	КонецЕсли;
	Максимум = Схема.Получить("maxLength");
	Если ТипЗнч(Максимум) = Тип("Число") И СтрДлина(Значение) > Максимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: не більше %2 символів", Путь, Максимум));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЧисло(Значение, Схема, Путь, Ошибки, ТолькоЦелое)

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Ошибки.Добавить(Путь + ": очікується число");
		Возврат;
	КонецЕсли;
	Если ТолькоЦелое И Цел(Значение) <> Значение Тогда
		Ошибки.Добавить(Путь + ": очікується ціле число");
	КонецЕсли;

	Минимум = Схема.Получить("minimum");
	Если ТипЗнч(Минимум) = Тип("Число") И Значение < Минимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: не менше %2", Путь, Минимум));
	КонецЕсли;
	Максимум = Схема.Получить("maximum");
	Если ТипЗнч(Максимум) = Тип("Число") И Значение > Максимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: не більше %2", Путь, Максимум));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

Функция ЭтоПетлевойАдрес(Части)
	// http на 127.0.0.1, [::1] или localhost (RFC 8252, п. 7.3): адреса петли - правило, а не настройка.

	// BSLLS:UsingHardcodeNetworkAddress-off
	Возврат Части.Схема = "http" И (Части.Хост = "127.0.0.1" Или Части.Хост = "[::1]" Или Части.Хост = "localhost");
	// BSLLS:UsingHardcodeNetworkAddress-on

КонецФункции

Функция ЭтоIPАдрес(Хост)
	// IPv6 в скобках или запись из цифр и точек (в том числе сокращенная, вроде 127.1).

	Возврат СтрНачинаетсяС(Хост, "[") Или mcp1c_Служебный.СостоитИзСимволов(Хост, "0123456789.");

КонецФункции

Функция ИсточникАдреса(Адрес)
	// Схема, хост и порт без порта по умолчанию; пустая строка, если адрес не разобран.

	Части = РазобратьАдрес(Адрес);
	Если Части = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Порт = Части.Порт;
	Если (Части.Схема = "https" И Порт = "443") Или (Части.Схема = "http" И Порт = "80") Тогда
		Порт = "";
	КонецЕсли;
	Возврат Части.Схема + "://" + Части.Хост + ?(ПустаяСтрока(Порт), "", ":" + Порт);

КонецФункции

Функция НормализованныйРесурс(Адрес)
	// Схема, хост, порт без порта по умолчанию, путь без завершающего "/" и запрос; пустая строка, если адрес
	// не абсолютный или содержит фрагмент.

	Части = РазобратьАдрес(Адрес);
	Если Части = Неопределено Или Части.ЕстьФрагмент Или Части.ЕстьПользователь Тогда
		Возврат "";
	КонецЕсли;
	Порт = Части.Порт;
	Если (Части.Схема = "https" И Порт = "443") Или (Части.Схема = "http" И Порт = "80") Тогда
		Порт = "";
	КонецЕсли;
	Путь = Части.Путь;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	Результат = Части.Схема + "://" + Части.Хост + ?(ПустаяСтрока(Порт), "", ":" + Порт) + Путь;
	Если Не ПустаяСтрока(Части.Запрос) Тогда
		Результат = Результат + "?" + Части.Запрос;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция НормализованныйПрефикс(Префикс)
	// Префикс адреса в нижнем регистре, который заканчивается хотя бы на "/" после хоста: иначе префикс
	// "https://claude.ai" принял бы и "https://claude.ai.example.com/...".

	Части = РазобратьАдрес(СокрЛП(Префикс));
	Если Части = Неопределено Или Части.Схема <> "https" Тогда
		Возврат "";
	КонецЕсли;
	Результат = НРег(СокрЛП(Префикс));
	Если ПустаяСтрока(Части.Путь) Тогда
		Результат = Результат + "/";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция БезЗавершающейКосой(Адрес)

	Результат = СокрЛП(Адрес);
	Пока СтрЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоддерживаетСпособNone(Данные)
	// Клиент CIMD умеет none: в token_endpoint_auth_method (без него - none) или в списке
	// token_endpoint_auth_methods_supported. ChatGPT указывает в первом предпочтение (private_key_jwt),
	// а во втором - все способы; подходит любой из пересечения, у сервера для CIMD это только none.

	Если mcp1c_Служебный.Свойство(Данные, "token_endpoint_auth_method", "none") = "none" Тогда
		Возврат Истина;
	КонецЕсли;
	Способы = mcp1c_Служебный.Свойство(Данные, "token_endpoint_auth_methods_supported");
	Возврат ТипЗнч(Способы) = Тип("Массив") И Способы.Найти("none") <> Неопределено;

КонецФункции

Функция ПрочитатьОбъектJSON(Текст)
	// Объект JSON (Соответствие) или Неопределено, если текст - не объект JSON.

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Данные = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные, Неопределено);

КонецФункции

Процедура ЗаполнитьОписаниеКлиента(Описание, Данные, Имя, Способ)
	// Адреса возврата, типы разрешений и ответов клиента; ошибка - в Описание.Ошибка.

	Адреса = mcp1c_Служебный.Свойство(Данные, "redirect_uris");
	Если ТипЗнч(Адреса) <> Тип("Массив") Или Адреса.Количество() = 0 Тогда
		Описание.Ошибка = "немає redirect_uris";
		Описание.КодОшибки = "invalid_redirect_uri";
		Возврат;
	КонецЕсли;
	Для Каждого Адрес Из Адреса Цикл
		Если Не АдресВозвратаДопустим(Адрес) Тогда
			Описание.Ошибка = СтрШаблон("адреса повернення %1 має бути https або http на петлевій адресі",
				Лев(Строка(Адрес), 200));
			Описание.КодОшибки = "invalid_redirect_uri";
			Описание.АдресаВозврата.Очистить();
			Возврат;
		КонецЕсли;
		Описание.АдресаВозврата.Добавить(Адрес);
	КонецЦикла;
	Разрешения = mcp1c_Служебный.Свойство(Данные, "grant_types");
	Если ТипЗнч(Разрешения) = Тип("Массив") И Разрешения.Найти("authorization_code") = Неопределено Тогда
		Описание.Ошибка = "grant_types не містить authorization_code";
		Возврат;
	КонецЕсли;
	Ответы = mcp1c_Служебный.Свойство(Данные, "response_types");
	Если ТипЗнч(Ответы) = Тип("Массив") И Ответы.Найти("code") = Неопределено Тогда
		Описание.Ошибка = "response_types не містить code";
		Возврат;
	КонецЕсли;
	Описание.Имя = Лев(СокрЛП(Имя), 100);
	Описание.СпособАутентификации = Способ;

КонецПроцедуры

Функция СтрокаИзБайтов(Шестнадцатеричное)

	Возврат ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки(Шестнадцатеричное), КодировкаТекста.UTF8);

КонецФункции

Функция ПодписьДанных(Секрет, Назначение, ТекстТела)

	Возврат mcp1c_Служебный.КодироватьBase64URL(mcp1c_Курсор.HMACSHA256(Секрет, "mcp1c-oauth|" + Назначение + "|" + ТекстТела));

КонецФункции

Функция МассивИзСтроки(Значения)

	Возврат СтрРазделить(Значения, ",", Ложь);

КонецФункции

Функция ПредставлениеИмениКлиента(Данные)
	// Имя из метаданных клиента в скобках, если оно отличается от показанного приложения.

	Если ПустаяСтрока(Данные.ИмяКлиента) Или НРег(Данные.ИмяКлиента) = НРег(Данные.Приложение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(" (%1)", ЭкранироватьHTML(Данные.ИмяКлиента));

КонецФункции

Функция ПредупреждениеПетлевогоАдреса()

	Возврат "<p class=""warning"">Клієнт повертає код авторизації на локальну адресу комп'ютера. Підтверджуйте, лише якщо "
		+ "щойно самі почали підключення в цьому застосунку: таку адресу може зайняти будь-яка програма на "
		+ "вашому комп'ютері.</p>";

КонецФункции

Функция Страница(Заголовок, Тело)
	// HTML-страница без внешних ресурсов и скриптов.

	Стили = "body{font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;background:#f4f5f7;"
		+ "color:#1f2328;margin:0}
		|main{max-width:30rem;margin:3rem auto;padding:2rem;background:#fff;border-radius:12px;"
		+ "box-shadow:0 1px 4px rgba(0,0,0,.12)}
		|h1{font-size:1.35rem;margin:0 0 1rem}
		|label{display:block;margin:1rem 0 .4rem;font-weight:600}
		|input{width:100" + "%;box-sizing:border-box;font-size:1.25rem;padding:.6rem;letter-spacing:.12em;"
		+ "text-transform:uppercase;border:1px solid #c7ccd1;border-radius:8px}
		|button{margin:1rem .5rem 0 0;padding:.6rem 1.4rem;font-size:1rem;border:0;border-radius:8px;"
		+ "background:#0b63ce;color:#fff;cursor:pointer}
		|button.secondary{background:#e7e9ec;color:#1f2328}
		|.error{color:#b3261e}
		|.warning{background:#fff4ce;padding:.7rem;border-radius:8px}
		|.hint{color:#59636e;font-size:.9rem}";
	Возврат "<!DOCTYPE html>
	|<html lang=""uk"">
	|<head>
	|<meta charset=""utf-8"">
	|<meta name=""viewport"" content=""width=device-width, initial-scale=1"">
	|<meta name=""referrer"" content=""no-referrer"">
	|<title>" + ЭкранироватьHTML(Заголовок) + "</title>
	|<style>
	|" + Стили + "
	|</style>
	|</head>
	|<body>
	|<main>
	|" + Тело + "
	|</main>
	|</body>
	|</html>";

КонецФункции


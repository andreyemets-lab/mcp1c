///////////////////////////////////////////////////////////////////////////////
// mcp1c_ПравилаOAuth: правила OAuth 2.1 без обращений к базе (п. 6.4 ТЗ): области, PKCE, адреса
// возврата, документы метаданных клиентов (CIMD), разбор форм, формат токенов, метаданные RFC 8414
// и RFC 9728, страницы авторизации. Модуль чистой логики: проверяется тестами OneScript.
//
// Адреса: ресурс - публичный адрес MCP-эндпоинта (настройка canonicalUrl), издатель - ресурс + "/oauth",
// метаданные ресурса - ресурс + "/.well-known/oauth-protected-resource", метаданные сервера авторизации -
// издатель + "/.well-known/openid-configuration" и "/.well-known/oauth-authorization-server" (третий
// и запасной варианты обнаружения MCP; варианты от корня сайта добавляет проксі).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Области

// Области доступа сервера (п. 6.4 ТЗ): mcp:read - метаданные и чтение, mcp:reports - отчеты,
// mcp:query - произвольные запросы.
//
// Возвращаемое значение:
//  Массив из Строка - области в порядке сервера.
//
Функция ОбластиСервера() Экспорт

	Области = Новый Массив;
	Области.Добавить("mcp:read");
	Области.Добавить("mcp:reports");
	Области.Добавить("mcp:query");
	Возврат Области;

КонецФункции

// Известные серверу области из строки scope; неизвестные (например, offline_access) пропускаются.
// Разделитель - пробел; "+" тоже считается разделителем: в именах областей сервера его нет, а строка
// запроса может прийти без замены "+" на пробел.
//
// Параметры:
//  Текст - Строка, Неопределено - области через пробел.
//
// Возвращаемое значение:
//  Массив из Строка - области без повторов в порядке сервера.
//
Функция РазобратьОбласти(Текст) Экспорт

	Запрошенные = Новый Массив;
	Если ТипЗнч(Текст) = Тип("Строка") Тогда
		Запрошенные = СтрРазделить(СтрЗаменить(СтрЗаменить(Текст, Символы.Таб, " "), "+", " "), " ", Ложь);
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого ИмяОбласти Из ОбластиСервера() Цикл
		Если Запрошенные.Найти(ИмяОбласти) <> Неопределено Тогда
			Результат.Добавить(ИмяОбласти);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка scope из областей в порядке сервера.
//
// Параметры:
//  Области - Массив из Строка - области.
//
// Возвращаемое значение:
//  Строка - например, "mcp:read mcp:reports".
//
Функция ОбластиСтрокой(Области) Экспорт

	Части = Новый Массив;
	Для Каждого ИмяОбласти Из ОбластиСервера() Цикл
		Если Области.Найти(ИмяОбласти) <> Неопределено Тогда
			Части.Добавить(ИмяОбласти);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

// Области, которые профиль клиента может дать: mcp:read - всегда (get_context доступен любому профилю),
// mcp:reports - если доступен хотя бы один инструмент отчетов, mcp:query - если доступен execute_query.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Массив из Строка - области.
//
Функция ДоступныеОбласти(Политика) Экспорт

	Результат = Новый Массив;
	Результат.Добавить("mcp:read");
	Для Каждого Имя Из СтрРазделить("list_reports,describe_report,run_report", ",") Цикл
		Если mcp1c_ПравилаДоступа.ИнструментДоступен(Политика, Имя) Тогда
			Результат.Добавить("mcp:reports");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если mcp1c_ПравилаДоступа.ИнструментДоступен(Политика, "execute_query") Тогда
		Результат.Добавить("mcp:query");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Области, которые получит подключение: запрошенные клиентом и доступные профилю; без запрошенных известных
// областей - все доступные профилю. mcp:read выдается всегда: без нее не работает ни один инструмент.
//
// Параметры:
//  Запрошенные - Массив из Строка - области из запроса авторизации (см. РазобратьОбласти).
//  Доступные - Массив из Строка - области профиля (см. ДоступныеОбласти).
//
// Возвращаемое значение:
//  Массив из Строка - области в порядке сервера.
//
Функция ВыданныеОбласти(Запрошенные, Доступные) Экспорт

	Результат = Новый Массив;
	Для Каждого ИмяОбласти Из ОбластиСервера() Цикл
		Если Доступные.Найти(ИмяОбласти) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ИмяОбласти = "mcp:read" Или Запрошенные.Количество() = 0 Или Запрошенные.Найти(ИмяОбласти) <> Неопределено Тогда
			Результат.Добавить(ИмяОбласти);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Область, которая нужна вызову: инструменты отчетов - mcp:reports, execute_query - mcp:query,
// остальные инструменты, ресурсы и промпты - mcp:read. Списки и служебные методы области не требуют.
//
// Параметры:
//  Метод - Строка - метод MCP.
//  Имя - Строка - имя инструмента для tools/call.
//
// Возвращаемое значение:
//  Строка - область; пустая строка - область не нужна.
//
Функция ОбластьВызова(Метод, Имя) Экспорт

	Если Метод = "tools/call" Тогда
		Если Имя = "list_reports" Или Имя = "describe_report" Или Имя = "run_report" Тогда
			Возврат "mcp:reports";
		ИначеЕсли Имя = "execute_query" Тогда
			Возврат "mcp:query";
		КонецЕсли;
		Возврат "mcp:read";
	ИначеЕсли Метод = "resources/read" Или Метод = "prompts/get" Тогда
		Возврат "mcp:read";
	КонецЕсли;
	Возврат "";

КонецФункции

// Представление области для страницы согласия.
//
// Параметры:
//  ИмяОбласти - Строка - область.
//
// Возвращаемое значение:
//  Строка - текст для пользователя.
//
Функция ПредставлениеОбласти(ИмяОбласти) Экспорт

	Если ИмяОбласти = "mcp:read" Тогда
		Возврат "читати метадані й дані, які відкриває профіль";
	ИначеЕсли ИмяОбласти = "mcp:reports" Тогда
		Возврат "формувати звіти, які відкриває профіль";
	ИначеЕсли ИмяОбласти = "mcp:query" Тогда
		Возврат "виконувати запити мовою запитів 1С (лише вибірку)";
	КонецЕсли;
	Возврат ИмяОбласти;

КонецФункции

#КонецОбласти

#Область PKCE

// Значение code_challenge для метода S256 (RFC 7636): BASE64URL(SHA256(code_verifier)).
//
// Параметры:
//  Верификатор - Строка - code_verifier.
//
// Возвращаемое значение:
//  Строка - code_challenge.
//
Функция ВызовPKCE(Верификатор) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Верификатор, КодировкаТекста.UTF8, Ложь));
	Возврат mcp1c_Служебный.КодироватьBase64URL(Хеширование.ХешСумма);

КонецФункции

// Соответствует ли code_verifier RFC 7636: 43-128 символов из A-Z, a-z, 0-9, "-", ".", "_", "~".
//
// Параметры:
//  Верификатор - Строка, Неопределено - code_verifier.
//
// Возвращаемое значение:
//  Булево - Истина, если формат верный.
//
Функция ВерификаторPKCEКорректен(Верификатор) Экспорт

	Возврат ТипЗнч(Верификатор) = Тип("Строка") И СтрДлина(Верификатор) >= 43 И СтрДлина(Верификатор) <= 128
		И mcp1c_Служебный.СостоитИзСимволов(Верификатор, АлфавитНезарезервированных());

КонецФункции

// Соответствует ли code_challenge методу S256: 43 символа base64url.
//
// Параметры:
//  Вызов - Строка, Неопределено - code_challenge.
//
// Возвращаемое значение:
//  Булево - Истина, если формат верный.
//
Функция ВызовPKCEКорректен(Вызов) Экспорт

	Возврат ТипЗнч(Вызов) = Тип("Строка") И СтрДлина(Вызов) = 43
		И mcp1c_Служебный.СостоитИзСимволов(Вызов, mcp1c_Служебный.АлфавитBase64URL());

КонецФункции

#КонецОбласти

#Область Адреса

// Части абсолютного адреса URL.
//
// Параметры:
//  Адрес - Строка, Неопределено - адрес.
//
// Возвращаемое значение:
//  - Неопределено - это не абсолютный адрес со схемой и хостом.
//  - Структура:
//   * Схема - Строка - схема в нижнем регистре.
//   * Хост - Строка - хост в нижнем регистре; IPv6 - в квадратных скобках.
//   * Порт - Строка - порт; пустая строка, если не указан.
//   * Путь - Строка - путь с ведущим "/"; пустая строка, если пути нет.
//   * Запрос - Строка - строка запроса без "?".
//   * ЕстьФрагмент - Булево - в адресе есть "#".
//   * ЕстьПользователь - Булево - в адресе есть имя пользователя ("user@host").
//
Функция РазобратьАдрес(Адрес) Экспорт

	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПозицияСхемы = СтрНайти(Адрес, "://");
	Если ПозицияСхемы < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Схема = НРег(Лев(Адрес, ПозицияСхемы - 1));
	Если Не mcp1c_Служебный.СостоитИзСимволов(Схема, "abcdefghijklmnopqrstuvwxyz0123456789+-.") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(Адрес, ПозицияСхемы + 3);

	ЕстьФрагмент = Ложь;
	ПозицияФрагмента = СтрНайти(Остаток, "#");
	Если ПозицияФрагмента > 0 Тогда
		ЕстьФрагмент = Истина;
		Остаток = Лев(Остаток, ПозицияФрагмента - 1);
	КонецЕсли;
	СтрокаЗапроса = "";
	ПозицияЗапроса = СтрНайти(Остаток, "?");
	Если ПозицияЗапроса > 0 Тогда
		СтрокаЗапроса = Сред(Остаток, ПозицияЗапроса + 1);
		Остаток = Лев(Остаток, ПозицияЗапроса - 1);
	КонецЕсли;
	Путь = "";
	ПозицияПути = СтрНайти(Остаток, "/");
	Если ПозицияПути > 0 Тогда
		Путь = Сред(Остаток, ПозицияПути);
		Остаток = Лев(Остаток, ПозицияПути - 1);
	КонецЕсли;

	ЕстьПользователь = Ложь;
	ПозицияПользователя = СтрНайти(Остаток, "@", НаправлениеПоиска.СКонца);
	Если ПозицияПользователя > 0 Тогда
		ЕстьПользователь = Истина;
		Остаток = Сред(Остаток, ПозицияПользователя + 1);
	КонецЕсли;
	Порт = "";
	Если СтрНачинаетсяС(Остаток, "[") Тогда
		КонецХоста = СтрНайти(Остаток, "]");
		Если КонецХоста = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Хост = Лев(Остаток, КонецХоста);
		Хвост = Сред(Остаток, КонецХоста + 1);
		Если СтрНачинаетсяС(Хвост, ":") Тогда
			Порт = Сред(Хвост, 2);
		ИначеЕсли Не ПустаяСтрока(Хвост) Тогда
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		ПозицияПорта = СтрНайти(Остаток, ":", НаправлениеПоиска.СКонца);
		Если ПозицияПорта > 0 Тогда
			Хост = Лев(Остаток, ПозицияПорта - 1);
			Порт = Сред(Остаток, ПозицияПорта + 1);
		Иначе
			Хост = Остаток;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Хост) Или (Не ПустаяСтрока(Порт) И Не mcp1c_Служебный.СостоитИзСимволов(Порт, "0123456789")) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Хост", НРег(Хост));
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("Путь", Путь);
	Результат.Вставить("Запрос", СтрокаЗапроса);
	Результат.Вставить("ЕстьФрагмент", ЕстьФрагмент);
	Результат.Вставить("ЕстьПользователь", ЕстьПользователь);
	Возврат Результат;

КонецФункции

// Допустим ли адрес возврата (redirect_uri): https с хостом или http на петлевом адресе (127.0.0.1, [::1],
// localhost) - требование MCP; без фрагмента и имени пользователя.
//
// Параметры:
//  Адрес - Строка, Неопределено - адрес возврата.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес допустим.
//
Функция АдресВозвратаДопустим(Адрес) Экспорт

	Части = РазобратьАдрес(Адрес);
	Если Части = Неопределено Или Части.ЕстьФрагмент Или Части.ЕстьПользователь Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Части.Схема = "https" Или ЭтоПетлевойАдрес(Части);

КонецФункции

// Зарегистрирован ли адрес возврата: точное совпадение, а для петлевых адресов http - совпадение
// без учета порта (RFC 8252, п. 7.3; Claude Code объявляет http://localhost/callback и
// http://127.0.0.1/callback и подставляет случайный порт).
//
// Параметры:
//  Запрошенный - Строка - redirect_uri запроса.
//  Зарегистрированные - Массив из Строка - адреса клиента.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес зарегистрирован.
//
Функция АдресВозвратаЗарегистрирован(Запрошенный, Зарегистрированные) Экспорт

	Если Не АдресВозвратаДопустим(Запрошенный) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Зарегистрированные.Найти(Запрошенный) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Части = РазобратьАдрес(Запрошенный);
	Если Не ЭтоПетлевойАдрес(Части) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Адрес Из Зарегистрированные Цикл
		Зарегистрированный = РазобратьАдрес(Адрес);
		Если Зарегистрированный <> Неопределено И ЭтоПетлевойАдрес(Зарегистрированный)
			И Зарегистрированный.Хост = Части.Хост И Зарегистрированный.Путь = Части.Путь
			И Зарегистрированный.Запрос = Части.Запрос Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Только ли петлевые адреса возврата у клиента: страница авторизации предупреждает, что такой адрес
// может занять любая программа на компьютере пользователя.
//
// Параметры:
//  Адреса - Массив из Строка - адреса возврата.
//
// Возвращаемое значение:
//  Булево - Истина, если все адреса петлевые.
//
Функция ТолькоПетлевыеАдреса(Адреса) Экспорт

	Для Каждого Адрес Из Адреса Цикл
		Части = РазобратьАдрес(Адрес);
		Если Части = Неопределено Или Не ЭтоПетлевойАдрес(Части) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Адреса.Количество() > 0;

КонецФункции

// Хост адреса для показа пользователю.
//
// Параметры:
//  Адрес - Строка - адрес.
//
// Возвращаемое значение:
//  Строка - хост; адрес целиком, если его не удалось разобрать.
//
Функция ХостАдреса(Адрес) Экспорт

	Части = РазобратьАдрес(Адрес);
	Возврат ?(Части = Неопределено, Адрес, Части.Хост);

КонецФункции

// Совпадают ли адреса ресурса (RFC 8707): схема и хост без учета регистра, порт по умолчанию
// и завершающий "/" не учитываются.
//
// Параметры:
//  Первый - Строка, Неопределено - адрес.
//  Второй - Строка, Неопределено - адрес.
//
// Возвращаемое значение:
//  Булево - Истина, если это один ресурс.
//
Функция ЭквивалентныеРесурсы(Первый, Второй) Экспорт

	НормализованныйПервый = НормализованныйРесурс(Первый);
	Возврат Не ПустаяСтрока(НормализованныйПервый) И НормализованныйПервый = НормализованныйРесурс(Второй);

КонецФункции

// Можно ли загрузить документ метаданных клиента по client_id (CIMD): https с путем, без порта
// (кроме 443), имени пользователя и фрагмента, хост - доменное имя, адрес начинается с одного из доверенных
// префиксов (защита от SSRF, п. 6.4 ТЗ).
//
// Параметры:
//  ИдентификаторКлиента - Строка - client_id.
//  Префиксы - Массив из Строка - доверенные префиксы адресов (настройка oauthCimdPrefixes).
//
// Возвращаемое значение:
//  Строка - причина отказа; пустая строка, если загрузка допустима.
//
Функция ОшибкаАдресаCIMD(ИдентификаторКлиента, Префиксы) Экспорт

	Части = РазобратьАдрес(ИдентификаторКлиента);
	Если Части = Неопределено Или Части.Схема <> "https" Тогда
		Возврат "client_id - не адреса https";
	ИначеЕсли Части.ЕстьПользователь Или Части.ЕстьФрагмент Тогда
		Возврат "адреса client_id містить ім'я користувача або фрагмент";
	ИначеЕсли Не ПустаяСтрока(Части.Порт) И Части.Порт <> "443" Тогда
		Возврат "адреса client_id містить порт";
	ИначеЕсли ПустаяСтрока(Части.Путь) Или Части.Путь = "/" Тогда
		Возврат "адреса client_id не містить шляху";
	ИначеЕсли ЭтоIPАдрес(Части.Хост) Или Части.Хост = "localhost" Или СтрНайти(Части.Хост, ".") = 0 Тогда
		Возврат "хост client_id - не доменне ім'я";
	КонецЕсли;
	Для Каждого Префикс Из Префиксы Цикл
		Нормализованный = НормализованныйПрефикс(Префикс);
		Если Не ПустаяСтрока(Нормализованный) И СтрНачинаетсяС(НРег(ИдентификаторКлиента), Нормализованный) Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат "адреса client_id не входить до довірених адрес документів клієнтів (oauthCimdPrefixes)";

КонецФункции

// Похож ли client_id на адрес документа метаданных клиента (CIMD).
//
// Параметры:
//  ИдентификаторКлиента - Строка - client_id.
//
// Возвращаемое значение:
//  Булево - Истина, если client_id начинается с "https://".
//
Функция ЭтоАдресCIMD(ИдентификаторКлиента) Экспорт

	Возврат СтрНачинаетсяС(НРег(ИдентификаторКлиента), "https://");

КонецФункции

#КонецОбласти

#Область КлиентыOAuth

// Проверяет документ метаданных клиента (CIMD, draft-ietf-oauth-client-id-metadata-document): объект JSON,
// client_id равен адресу документа, есть client_name и redirect_uris, клиент умеет аутентифицироваться
// способом none, адреса возврата - петлевые или на хосте документа.
//
// Параметры:
//  Текст - Строка - тело документа.
//  ИдентификаторКлиента - Строка - адрес, по которому документ загружен.
//
// Возвращаемое значение:
//  см. НовоеОписаниеКлиента
//
Функция ПроверитьДокументCIMD(Текст, ИдентификаторКлиента) Экспорт

	Результат = НовоеОписаниеКлиента();
	Данные = ПрочитатьОбъектJSON(Текст);
	Если Данные = Неопределено Тогда
		Результат.Ошибка = "документ метаданих клієнта - не об'єкт JSON";
		Возврат Результат;
	КонецЕсли;
	Если mcp1c_Служебный.Свойство(Данные, "client_id") <> ИдентификаторКлиента Тогда
		Результат.Ошибка = "client_id у документі метаданих не збігається з його адресою";
		Возврат Результат;
	КонецЕсли;
	Имя = mcp1c_Служебный.Свойство(Данные, "client_name");
	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
		Результат.Ошибка = "у документі метаданих немає client_name";
		Возврат Результат;
	КонецЕсли;
	Если Не ПоддерживаетСпособNone(Данные) Тогда
		Результат.Ошибка = СтрШаблон("спосіб автентифікації клієнта %1 не підтримується: лише none",
			Строка(mcp1c_Служебный.Свойство(Данные, "token_endpoint_auth_method")));
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьОписаниеКлиента(Результат, Данные, Имя, "none");
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Возврат Результат;
	КонецЕсли;
	// Адрес возврата не на петлевом адресе должен быть на хосте документа: иначе документ с доверенного
	// хоста мог бы направить код авторизации на чужой сайт.
	Источник = ИсточникАдреса(ИдентификаторКлиента);
	Для Каждого Адрес Из Результат.АдресаВозврата Цикл
		Части = РазобратьАдрес(Адрес);
		Если Не ЭтоПетлевойАдрес(Части) И ИсточникАдреса(Адрес) <> Источник Тогда
			Результат.Ошибка = СтрШаблон("адреса повернення %1 не на хості документа метаданих клієнта",
				Лев(Адрес, 200));
			Результат.КодОшибки = "invalid_redirect_uri";
			Результат.АдресаВозврата.Очистить();
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверяет запрос динамической регистрации клиента (RFC 7591): адреса возврата обязательны,
// способ аутентификации - none, client_secret_post или client_secret_basic (по умолчанию).
//
// Параметры:
//  Текст - Строка - тело запроса регистрации.
//
// Возвращаемое значение:
//  см. НовоеОписаниеКлиента
//
Функция ПроверитьЗапросРегистрации(Текст) Экспорт

	Результат = НовоеОписаниеКлиента();
	Результат.КодОшибки = "invalid_client_metadata";
	Данные = ПрочитатьОбъектJSON(Текст);
	Если Данные = Неопределено Тогда
		Результат.Ошибка = "тіло запиту реєстрації - не об'єкт JSON";
		Возврат Результат;
	КонецЕсли;
	Имя = mcp1c_Служебный.Свойство(Данные, "client_name");
	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
		Имя = "Клієнт без назви";
	КонецЕсли;
	Способ = mcp1c_Служебный.Свойство(Данные, "token_endpoint_auth_method", "client_secret_basic");
	Если СпособыАутентификацииКлиента().Найти(Способ) = Неопределено Тогда
		Результат.Ошибка = СтрШаблон("спосіб автентифікації клієнта %1 не підтримується", Строка(Способ));
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьОписаниеКлиента(Результат, Данные, Имя, Способ);
	Если ПустаяСтрока(Результат.Ошибка) Тогда
		Результат.КодОшибки = "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Описание клиента OAuth из документа метаданных или запроса регистрации.
//
// Возвращаемое значение:
//  Структура:
//   * Ошибка - Строка - почему клиент не принят; пустая строка, если описание верное.
//   * КодОшибки - Строка - код ошибки регистрации (RFC 7591, п. 3.2.2): invalid_redirect_uri
//     или invalid_client_metadata.
//   * Имя - Строка - client_name (не длиннее 100 символов).
//   * АдресаВозврата - Массив из Строка - redirect_uris.
//   * СпособАутентификации - Строка - none, client_secret_post или client_secret_basic.
//
Функция НовоеОписаниеКлиента() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Ошибка", "");
	Описание.Вставить("КодОшибки", "");
	Описание.Вставить("Имя", "");
	Описание.Вставить("АдресаВозврата", Новый Массив);
	Описание.Вставить("СпособАутентификации", "none");
	Возврат Описание;

КонецФункции

// Кто просит доступ - для страниц авторизации. Документ метаданных и запрос регистрации клиент составляет
// сам, поэтому для CIMD показывается хост client_id, а для динамической регистрации - пометка о ней.
//
// Параметры:
//  Источник - Строка - manual, dcr или cimd.
//  ИдентификаторКлиента - Строка - client_id.
//  Имя - Строка - наименование клиента.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ПредставлениеКлиента(Источник, ИдентификаторКлиента, Имя) Экспорт

	Если Источник = "cimd" Тогда
		Возврат ХостАдреса(ИдентификаторКлиента);
	ИначеЕсли Источник = "dcr" Тогда
		Возврат СтрШаблон("«%1» (самостійна реєстрація)", Имя);
	КонецЕсли;
	Возврат Имя;

КонецФункции

// Способы аутентификации клиента на конечной точке токенов, которые поддерживает сервер.
//
// Возвращаемое значение:
//  Массив из Строка - none, client_secret_post, client_secret_basic.
//
Функция СпособыАутентификацииКлиента() Экспорт

	Способы = Новый Массив;
	Способы.Добавить("none");
	Способы.Добавить("client_secret_post");
	Способы.Добавить("client_secret_basic");
	Возврат Способы;

КонецФункции

// Идентификатор и секрет клиента из заголовка Authorization: Basic (RFC 6749, п. 2.3.1: перед кодированием
// base64 оба значения кодируются как поля формы).
//
// Параметры:
//  Значение - Строка, Неопределено - значение заголовка.
//
// Возвращаемое значение:
//  - Неопределено - заголовка Basic нет или он некорректен.
//  - Структура:
//   * Идентификатор - Строка - client_id.
//   * Секрет - Строка - client_secret.
//
Функция УчетныеДанныеBasic(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Или НРег(Лев(СокрЛП(Значение), 6)) <> "basic " Тогда
		Возврат Неопределено;
	КонецЕсли;
	Закодированные = СокрЛП(Сред(СокрЛП(Значение), 7));
	Если ПустаяСтрока(Закодированные) Или СтрДлина(Закодированные) > 4096
		Или Не mcp1c_Служебный.СостоитИзСимволов(Закодированные, mcp1c_Служебный.АлфавитBase64() + "=") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Текст = ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки(Закодированные), КодировкаТекста.UTF8);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Позиция = СтрНайти(Текст, ":");
	Если Позиция < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", РаскодироватьКомпонентURL(Лев(Текст, Позиция - 1)));
	Результат.Вставить("Секрет", РаскодироватьКомпонентURL(Сред(Текст, Позиция + 1)));
	Возврат Результат;

КонецФункции

// Адреса возврата из многострочного текста (по одному в строке).
//
// Параметры:
//  Текст - Строка - адреса.
//
// Возвращаемое значение:
//  Массив из Строка - адреса без пустых строк.
//
Функция АдресаИзТекста(Текст) Экспорт

	Результат = Новый Массив;
	Для Каждого СтрокаАдреса Из СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Адрес = СокрЛП(СтрокаАдреса);
		Если Не ПустаяСтрока(Адрес) И Результат.Найти(Адрес) = Неопределено Тогда
			Результат.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Формы

// Параметры тела application/x-www-form-urlencoded. Повтор параметра - ошибка (RFC 6749, п. 3.1).
//
// Параметры:
//  Текст - Строка - тело запроса.
//
// Возвращаемое значение:
//  Структура:
//   * Параметры - Соответствие из КлючИЗначение - имя и значение (Строка).
//   * Ошибка - Строка - пустая строка, если тело разобрано.
//
Функция ПараметрыФормы(Текст) Экспорт

	Результат = Новый Структура("Параметры, Ошибка", Новый Соответствие, "");
	Для Каждого Пара Из СтрРазделить(Текст, "&", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Если Позиция = 0 Тогда
			Имя = РаскодироватьКомпонентURL(Пара);
			Значение = "";
		Иначе
			Имя = РаскодироватьКомпонентURL(Лев(Пара, Позиция - 1));
			Значение = РаскодироватьКомпонентURL(Сред(Пара, Позиция + 1));
		КонецЕсли;
		Если Результат.Параметры.Получить(Имя) <> Неопределено Тогда
			Результат.Ошибка = СтрШаблон("параметр %1 передано кілька разів", Лев(Имя, 50));
			Возврат Результат;
		КонецЕсли;
		Результат.Параметры.Вставить(Имя, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Декодирует компонент URL или поле формы: "+" - пробел, "%XX" - байты UTF-8.
//
// Параметры:
//  Текст - Строка - закодированный текст.
//
// Возвращаемое значение:
//  Строка - текст.
//
Функция РаскодироватьКомпонентURL(Текст) Экспорт

	Части = Новый Массив;
	Байты = "";
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Шестнадцатеричное = Сред(Текст, Позиция + 1, 2);
		Если Символ = "%" И СтрДлина(Шестнадцатеричное) = 2
			И mcp1c_Служебный.СостоитИзСимволов(Шестнадцатеричное, "0123456789abcdefABCDEF") Тогда
			Байты = Байты + Шестнадцатеричное;
			Позиция = Позиция + 3;
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Байты) Тогда
			Части.Добавить(СтрокаИзБайтов(Байты));
			Байты = "";
		КонецЕсли;
		Части.Добавить(?(Символ = "+", " ", Символ));
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Не ПустаяСтрока(Байты) Тогда
		Части.Добавить(СтрокаИзБайтов(Байты));
	КонецЕсли;
	Возврат СтрСоединить(Части, "");

КонецФункции

// Кодирует компонент URL: все символы, кроме A-Z, a-z, 0-9, "-", ".", "_", "~", - как "%XX" байтов UTF-8.
//
// Параметры:
//  Текст - Строка - текст.
//
// Возвращаемое значение:
//  Строка - закодированный текст.
//
Функция КодироватьКомпонентURL(Текст) Экспорт

	Незарезервированные = АлфавитНезарезервированных();
	Части = Новый Массив;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти(Незарезервированные, Символ) > 0 Тогда
			Части.Добавить(Символ);
			Продолжить;
		КонецЕсли;
		Шестнадцатеричное = ВРег(ПолучитьHexСтрокуИзДвоичныхДанных(
			ПолучитьДвоичныеДанныеИзСтроки(Символ, КодировкаТекста.UTF8, Ложь)));
		Для Байт = 0 По СтрДлина(Шестнадцатеричное) / 2 - 1 Цикл
			Части.Добавить("%" + Сред(Шестнадцатеричное, Байт * 2 + 1, 2));
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции

// Адрес с добавленными параметрами строки запроса (ответ авторизации).
//
// Параметры:
//  Адрес - Строка - адрес возврата клиента; может уже содержать строку запроса.
//  Параметры - Соответствие из КлючИЗначение - имя и значение (Строка); пустые значения пропускаются.
//
// Возвращаемое значение:
//  Строка - адрес.
//
Функция АдресСПараметрами(Адрес, Параметры) Экспорт

	Части = Новый Массив;
	Для Каждого Параметр Из Параметры Цикл
		Если ТипЗнч(Параметр.Значение) = Тип("Строка") И Не ПустаяСтрока(Параметр.Значение) Тогда
			Части.Добавить(КодироватьКомпонентURL(Параметр.Ключ) + "=" + КодироватьКомпонентURL(Параметр.Значение));
		КонецЕсли;
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат Адрес;
	КонецЕсли;
	Разделитель = ?(СтрНайти(Адрес, "?") > 0, "&", "?");
	Возврат Адрес + Разделитель + СтрСоединить(Части, "&");

КонецФункции

// Экранирует текст для HTML (содержимое элементов и значения атрибутов в кавычках).
//
// Параметры:
//  Текст - Строка - текст.
//
// Возвращаемое значение:
//  Строка - экранированный текст.
//
Функция ЭкранироватьHTML(Текст) Экспорт

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат СтрЗаменить(Результат, "'", "&#39;");

КонецФункции

#КонецОбласти

#Область ПодписьДанных

// Данные страницы авторизации, подписанные HMAC-SHA256 секретом сервера: форма возвращает их без
// изменений, поэтому сервер не хранит состояние между шагами (п. 6.4 ТЗ).
//
// Параметры:
//  Секрет - Строка - секрет сервера (oauthSecret).
//  Назначение - Строка - шаг ("request", "approval"): данные одного шага не подходят к другому.
//  Данные - Соответствие из КлючИЗначение - значения (Строка, Число, Булево).
//  ДействуетДо - Число - окончание действия, секунды от начала эпохи (UTC).
//
// Возвращаемое значение:
//  Строка - "<данные>.<подпись>" в base64url.
//
Функция ПодписанныеДанные(Секрет, Назначение, Данные, ДействуетДо) Экспорт

	Тело = Новый Соответствие;
	Для Каждого Элемент Из Данные Цикл
		Тело.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Тело.Вставить("_use", Назначение);
	Тело.Вставить("_exp", ДействуетДо);
	ТекстТела = mcp1c_Служебный.КодироватьСтрокуBase64URL(mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Тело));
	Возврат ТекстТела + "." + ПодписьДанных(Секрет, Назначение, ТекстТела);

КонецФункции

// Проверяет подписанные данные страницы авторизации.
//
// Параметры:
//  Секрет - Строка - секрет сервера.
//  Назначение - Строка - ожидаемый шаг.
//  Значение - Строка, Неопределено - значение поля формы.
//  ТекущееВремя - Число - секунды от начала эпохи (UTC).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение, Неопределено - данные без служебных ключей; Неопределено, если подпись
//   неверна, данные просрочены или относятся к другому шагу.
//
Функция ПроверенныеДанные(Секрет, Назначение, Значение, ТекущееВремя) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > 8192 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Части = СтрРазделить(Значение, ".");
	Если Части.Количество() <> 2 Или Части[1] <> ПодписьДанных(Секрет, Назначение, Части[0]) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = ПрочитатьОбъектJSON(mcp1c_Служебный.ДекодироватьСтрокуBase64URL(Части[0]));
	Если Данные = Неопределено Или Данные.Получить("_use") <> Назначение Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДействуетДо = Данные.Получить("_exp");
	Если ТипЗнч(ДействуетДо) <> Тип("Число") Или ДействуетДо <= ТекущееВремя Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные.Удалить("_use");
	Данные.Удалить("_exp");
	Возврат Данные;

КонецФункции

#КонецОбласти

#Область Токены

// Новый токен OAuth: "mcp1c_<вид>_<подключение>_<секрет>"; вид - at (доступ), rt (обновление) или ac
// (код авторизации), подключение - код элемента mcp1c_ПодключенияOAuth, секрет - 256 бит в base64url.
// В базе хранится только SHA-256 секрета.
//
// Параметры:
//  Вид - Строка - at, rt или ac.
//  Подключение - Строка - идентификатор подключения (12 символов base32).
//
// Возвращаемое значение:
//  Структура:
//   * Токен - Строка - значение токена (передается клиенту один раз).
//   * Хеш - Строка - SHA-256 секрета.
//
Функция НовыйТокен(Вид, Подключение) Экспорт

	Секрет = mcp1c_Служебный.КодироватьBase64URL(mcp1c_Служебный.СлучайныеДанные());
	Результат = Новый Структура;
	Результат.Вставить("Токен", СтрШаблон("mcp1c_%1_%2_%3", Вид, Подключение, Секрет));
	Результат.Вставить("Хеш", mcp1c_Служебный.ХешSHA256(Секрет));
	Возврат Результат;

КонецФункции

// Части токена OAuth (см. НовыйТокен).
//
// Параметры:
//  Токен - Строка, Неопределено - значение токена.
//
// Возвращаемое значение:
//  - Неопределено - это не токен OAuth сервера.
//  - Структура:
//   * Вид - Строка - at, rt или ac.
//   * Подключение - Строка - идентификатор подключения.
//   * Хеш - Строка - SHA-256 секрета для сравнения с сохраненным.
//
Функция РазобратьТокен(Токен) Экспорт

	Если ТипЗнч(Токен) <> Тип("Строка") Или СтрДлина(Токен) <> 65 Или Не СтрНачинаетсяС(Токен, "mcp1c_") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вид = Сред(Токен, 7, 2);
	Подключение = Сред(Токен, 10, 12);
	Секрет = Сред(Токен, 23);
	Если (Вид <> "at" И Вид <> "rt" И Вид <> "ac") Или Сред(Токен, 9, 1) <> "_" Или Сред(Токен, 22, 1) <> "_"
		Или Не mcp1c_Служебный.СостоитИзСимволов(Подключение, mcp1c_Служебный.АлфавитBase32())
		Или Не mcp1c_Служебный.СостоитИзСимволов(Секрет, mcp1c_Служебный.АлфавитBase64URL()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Вид", Вид);
	Результат.Вставить("Подключение", Подключение);
	Результат.Вставить("Хеш", mcp1c_Служебный.ХешSHA256(Секрет));
	Возврат Результат;

КонецФункции

// Новый код подключения для страницы авторизации: 8 символов base32 в виде "ABCD-EFGH".
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - код для пользователя (показывается один раз).
//   * Хеш - Строка - хеш для хранения (см. ХешКодаПодключения).
//
Функция НовыйКодПодключения() Экспорт

	Значение = mcp1c_Служебный.СлучайнаяСтрокаBase32(8);
	Результат = Новый Структура;
	Результат.Вставить("Код", Лев(Значение, 4) + "-" + Прав(Значение, 4));
	Результат.Вставить("Хеш", ХешКодаПодключения(Значение));
	Возврат Результат;

КонецФункции

// Хеш введенного кода подключения: регистр, пробелы и дефисы не учитываются.
//
// Параметры:
//  Ввод - Строка, Неопределено - код из формы.
//
// Возвращаемое значение:
//  Строка - хеш; пустая строка, если это не код из 8 символов base32.
//
Функция ХешКодаПодключения(Ввод) Экспорт

	Если ТипЗнч(Ввод) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Значение = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(Ввод), "-", ""), " ", ""));
	Если СтрДлина(Значение) <> 8 Или Не mcp1c_Служебный.СостоитИзСимволов(Значение, mcp1c_Служебный.АлфавитBase32()) Тогда
		Возврат "";
	КонецЕсли;
	Возврат mcp1c_Служебный.ХешSHA256("mcp1c-connect|" + Значение);

КонецФункции

// Новый секрет клиента OAuth (конфиденциальный клиент: предварительная или динамическая регистрация).
//
// Возвращаемое значение:
//  Структура:
//   * Секрет - Строка - client_secret (показывается один раз).
//   * Хеш - Строка - SHA-256 секрета.
//
Функция НовыйСекретКлиента() Экспорт

	Секрет = mcp1c_Служебный.КодироватьBase64URL(mcp1c_Служебный.СлучайныеДанные());
	Возврат Новый Структура("Секрет, Хеш", Секрет, mcp1c_Служебный.ХешSHA256(Секрет));

КонецФункции

// Новый client_id для предварительной или динамической регистрации.
//
// Возвращаемое значение:
//  Строка - "mcp1c-" и 20 символов base32 в нижнем регистре.
//
Функция НовыйИдентификаторКлиента() Экспорт

	Возврат "mcp1c-" + НРег(mcp1c_Служебный.СлучайнаяСтрокаBase32(20));

КонецФункции

#КонецОбласти

#Область Метаданные

// Ответ конечной точки токенов (RFC 6749, п. 5.1).
//
// Параметры:
//  ТокенДоступа - Строка - access_token.
//  ТокенОбновления - Строка - refresh_token.
//  СрокСекунд - Число - expires_in.
//  Области - Массив из Строка - выданные области.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - документ JSON.
//
Функция ОтветТокена(ТокенДоступа, ТокенОбновления, СрокСекунд, Области) Экспорт

	Ответ = Новый Соответствие;
	Ответ.Вставить("access_token", ТокенДоступа);
	Ответ.Вставить("token_type", "Bearer");
	Ответ.Вставить("expires_in", Макс(Цел(СрокСекунд), 1));
	Ответ.Вставить("refresh_token", ТокенОбновления);
	Ответ.Вставить("scope", ОбластиСтрокой(Области));
	Возврат Ответ;

КонецФункции

// Ошибка OAuth в теле ответа (RFC 6749, п. 5.2).
//
// Параметры:
//  Код - Строка - error, например invalid_grant.
//  Описание - Строка - error_description (ASCII); пустая строка - без описания.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - документ JSON.
//
Функция ОшибкаOAuth(Код, Описание = "") Экспорт

	Ответ = Новый Соответствие;
	Ответ.Вставить("error", Код);
	Если Не ПустаяСтрока(Описание) Тогда
		Ответ.Вставить("error_description", Описание);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Издатель (issuer) сервера авторизации: ресурс + "/oauth".
//
// Параметры:
//  Ресурс - Строка - публичный адрес MCP-эндпоинта.
//
// Возвращаемое значение:
//  Строка - издатель.
//
Функция Издатель(Ресурс) Экспорт

	Возврат БезЗавершающейКосой(Ресурс) + "/oauth";

КонецФункции

// Адрес метаданных защищенного ресурса (RFC 9728) для WWW-Authenticate.
//
// Параметры:
//  Ресурс - Строка - публичный адрес MCP-эндпоинта.
//
// Возвращаемое значение:
//  Строка - адрес.
//
Функция АдресМетаданныхРесурса(Ресурс) Экспорт

	Возврат БезЗавершающейКосой(Ресурс) + "/.well-known/oauth-protected-resource";

КонецФункции

// Метаданные защищенного ресурса (RFC 9728).
//
// Параметры:
//  Ресурс - Строка - публичный адрес MCP-эндпоинта.
//  ИмяРесурса - Строка - название для пользователя.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - документ JSON.
//
Функция МетаданныеРесурса(Ресурс, ИмяРесурса) Экспорт

	Серверы = Новый Массив;
	Серверы.Добавить(Издатель(Ресурс));
	Способы = Новый Массив;
	Способы.Добавить("header");
	Документ = Новый Соответствие;
	Документ.Вставить("resource", Ресурс);
	Документ.Вставить("authorization_servers", Серверы);
	Документ.Вставить("scopes_supported", ОбластиСервера());
	Документ.Вставить("bearer_methods_supported", Способы);
	Документ.Вставить("resource_name", ИмяРесурса);
	Возврат Документ;

КонецФункции

// Метаданные сервера авторизации (RFC 8414). Claude выбирает CIMD, только если есть
// client_id_metadata_document_supported и none среди token_endpoint_auth_methods_supported.
// По адресу OpenID Connect Discovery документ дополняется обязательными полями OpenID (jwks_uri с пустым
// набором ключей и т.п.): клиенты MCP разбирают его по схеме OpenID, хотя ID-токены сервер не выпускает.
//
// Параметры:
//  Ресурс - Строка - публичный адрес MCP-эндпоинта.
//  РегистрацияВключена - Булево - разрешена динамическая регистрация клиентов (RFC 7591).
//  ДляOpenIDConnect - Булево - документ для адреса /.well-known/openid-configuration.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - документ JSON.
//
Функция МетаданныеСервераАвторизации(Ресурс, РегистрацияВключена, ДляOpenIDConnect = Ложь) Экспорт

	ИздательСервера = Издатель(Ресурс);
	Документ = Новый Соответствие;
	Документ.Вставить("issuer", ИздательСервера);
	Документ.Вставить("authorization_endpoint", ИздательСервера + "/authorize");
	Документ.Вставить("token_endpoint", ИздательСервера + "/token");
	Документ.Вставить("revocation_endpoint", ИздательСервера + "/revoke");
	Если РегистрацияВключена Тогда
		Документ.Вставить("registration_endpoint", ИздательСервера + "/register");
	КонецЕсли;
	Документ.Вставить("scopes_supported", ОбластиСервера());
	Документ.Вставить("response_types_supported", МассивИзСтроки("code"));
	Документ.Вставить("response_modes_supported", МассивИзСтроки("query"));
	Документ.Вставить("grant_types_supported", МассивИзСтроки("authorization_code,refresh_token"));
	Документ.Вставить("token_endpoint_auth_methods_supported", СпособыАутентификацииКлиента());
	Документ.Вставить("revocation_endpoint_auth_methods_supported", СпособыАутентификацииКлиента());
	Документ.Вставить("code_challenge_methods_supported", МассивИзСтроки("S256"));
	Документ.Вставить("authorization_response_iss_parameter_supported", Истина);
	Документ.Вставить("client_id_metadata_document_supported", Истина);
	Если ДляOpenIDConnect Тогда
		Документ.Вставить("jwks_uri", ИздательСервера + "/jwks");
		Документ.Вставить("subject_types_supported", МассивИзСтроки("public"));
		Документ.Вставить("id_token_signing_alg_values_supported", МассивИзСтроки("RS256"));
	КонецЕсли;
	Возврат Документ;

КонецФункции

// Значение заголовка WWW-Authenticate (RFC 6750, RFC 9728).
//
// Параметры:
//  Ресурс - Строка - публичный адрес MCP-эндпоинта.
//  Области - Массив из Строка - области, нужные для запроса.
//  Ошибка - Строка - invalid_token, insufficient_scope; пустая строка - без ошибки.
//  ОписаниеОшибки - Строка - error_description.
//
// Возвращаемое значение:
//  Строка - значение заголовка.
//
Функция ЗначениеВызоваАутентификации(Ресурс, Области, Ошибка = "", ОписаниеОшибки = "") Экспорт

	Части = Новый Массив;
	Если Не ПустаяСтрока(Ошибка) Тогда
		Части.Добавить(СтрШаблон("error=""%1""", Ошибка));
	КонецЕсли;
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		Части.Добавить(СтрШаблон("error_description=""%1""", СтрЗаменить(СтрЗаменить(ОписаниеОшибки, """", "'"), "\", "/")));
	КонецЕсли;
	Части.Добавить(СтрШаблон("resource_metadata=""%1""", АдресМетаданныхРесурса(Ресурс)));
	Если Области.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон("scope=""%1""", ОбластиСтрокой(Области)));
	КонецЕсли;
	Возврат "Bearer " + СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти

#Область Страницы

// Страница ввода кода подключения (первый шаг авторизации).
//
// Параметры:
//  Данные - Структура:
//   * Действие - Строка - адрес формы (конечная точка /authorize).
//   * Запрос - Строка - подписанные данные запроса авторизации.
//   * База - Строка - название базы.
//   * Приложение - Строка - кто просит доступ (хост client_id или имя зарегистрированного клиента).
//   * ИмяКлиента - Строка - client_name из метаданных клиента.
//   * ХостВозврата - Строка - хост адреса возврата.
//   * ТолькоПетлевые - Булево - у клиента только петлевые адреса возврата.
//   * Ошибка - Строка - сообщение об ошибке ввода; пустая строка - без ошибки.
//
// Возвращаемое значение:
//  Строка - HTML.
//
Функция СтраницаКода(Данные) Экспорт

	Части = Новый Массив;
	Части.Добавить("<h1>Підключення AI-клієнта до 1С</h1>");
	Части.Добавить(СтрШаблон("<p><b>%1</b>%2 просить доступ до бази «%3».</p>", ЭкранироватьHTML(Данные.Приложение),
		ПредставлениеИмениКлиента(Данные), ЭкранироватьHTML(Данные.База)));
	Части.Добавить(СтрШаблон("<p>Після підтвердження браузер повернеться на <b>%1</b>.</p>",
		ЭкранироватьHTML(Данные.ХостВозврата)));
	Если Данные.ТолькоПетлевые Тогда
		Части.Добавить(ПредупреждениеПетлевогоАдреса());
	КонецЕсли;
	Части.Добавить(СтрШаблон("<form method=""post"" action=""%1"" autocomplete=""off"">", ЭкранироватьHTML(Данные.Действие)));
	Части.Добавить(СтрШаблон("<input type=""hidden"" name=""request"" value=""%1"">", ЭкранироватьHTML(Данные.Запрос)));
	Части.Добавить("<label for=""code"">Код підключення з 1С</label>");
	Части.Добавить("<input id=""code"" name=""connection_code"" maxlength=""20"" required autofocus "
		+ "placeholder=""ABCD-EFGH"" spellcheck=""false"">");
	Если Не ПустаяСтрока(Данные.Ошибка) Тогда
		Части.Добавить(СтрШаблон("<p class=""error"">%1</p>", ЭкранироватьHTML(Данные.Ошибка)));
	КонецЕсли;
	Части.Добавить("<button type=""submit"">Далі</button>");
	Части.Добавить("</form>");
	Части.Добавить("<p class=""hint"">Код видає адміністратор MCP-сервера в 1С: картка клієнта доступу, вкладка "
		+ "«OAuth». Код діє обмежений час і використовується один раз. Вводьте його, лише якщо щойно самі почали "
		+ "підключення в AI-клієнті.</p>");
	Возврат Страница("Підключення до 1С", СтрСоединить(Части, Символы.ПС));

КонецФункции

// Страница согласия (второй шаг авторизации).
//
// Параметры:
//  Данные - Структура:
//   * Действие - Строка - адрес формы (конечная точка /authorize).
//   * Согласие - Строка - подписанные данные согласия.
//   * База - Строка - название базы.
//   * Приложение - Строка - кто просит доступ.
//   * ИмяКлиента - Строка - client_name.
//   * ХостВозврата - Строка - хост адреса возврата.
//   * ТолькоПетлевые - Булево - у клиента только петлевые адреса возврата.
//   * КлиентДоступа - Строка - наименование клиента доступа.
//   * Профиль - Строка - наименование профиля.
//   * Области - Массив из Строка - области, которые получит токен.
//
// Возвращаемое значение:
//  Строка - HTML.
//
Функция СтраницаСогласия(Данные) Экспорт

	Части = Новый Массив;
	Части.Добавить("<h1>Підтвердіть доступ</h1>");
	Части.Добавить(СтрШаблон("<p><b>%1</b>%2 отримає доступ до бази «%3» як клієнт доступу «%4» (профіль «%5») "
		+ "і зможе:</p>", ЭкранироватьHTML(Данные.Приложение), ПредставлениеИмениКлиента(Данные),
		ЭкранироватьHTML(Данные.База), ЭкранироватьHTML(Данные.КлиентДоступа), ЭкранироватьHTML(Данные.Профиль)));
	Части.Добавить("<ul>");
	Для Каждого ИмяОбласти Из Данные.Области Цикл
		Части.Добавить(СтрШаблон("<li>%1</li>", ЭкранироватьHTML(ПредставлениеОбласти(ИмяОбласти))));
	КонецЦикла;
	Части.Добавить("</ul>");
	Части.Добавить("<p>Сервер лише читає дані. Відкликати підключення можна в 1С: картка клієнта доступу, вкладка "
		+ "«OAuth».</p>");
	Части.Добавить(СтрШаблон("<p>Повернення на: <b>%1</b></p>", ЭкранироватьHTML(Данные.ХостВозврата)));
	Если Данные.ТолькоПетлевые Тогда
		Части.Добавить(ПредупреждениеПетлевогоАдреса());
	КонецЕсли;
	Части.Добавить(СтрШаблон("<form method=""post"" action=""%1"">", ЭкранироватьHTML(Данные.Действие)));
	Части.Добавить(СтрШаблон("<input type=""hidden"" name=""approval"" value=""%1"">", ЭкранироватьHTML(Данные.Согласие)));
	Части.Добавить("<button type=""submit"" name=""decision"" value=""allow"">Дозволити</button>");
	Части.Добавить("<button type=""submit"" name=""decision"" value=""deny"" class=""secondary"">Відмовити</button>");
	Части.Добавить("</form>");
	Возврат Страница("Підтвердження доступу", СтрСоединить(Части, Символы.ПС));

КонецФункции

// Страница ошибки авторизации, когда перенаправить пользователя к клиенту нельзя (неизвестный клиент,
// незарегистрированный адрес возврата, просроченная форма).
//
// Параметры:

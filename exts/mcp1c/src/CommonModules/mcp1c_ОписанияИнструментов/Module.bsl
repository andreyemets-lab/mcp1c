Функция СхемаОтборов()

	Свойства = Новый Соответствие;
	Свойства.Вставить("field", mcp1c_СхемаJSON.СхемаСтроки("Поле або шлях через крапку: Контрагент.ИНН", 300));
	Свойства.Вставить("op", mcp1c_СхемаJSON.СхемаСтроки("Оператор", 20, ОператорыОтбора()));
	Свойства.Вставить("value", mcp1c_СхемаJSON.СхемаЗначения(
		"Значення: рядок, число, true/false, дата ISO, посилання {""type"", ""ref""}; масив для in, not_in, between"));
	Возврат mcp1c_СхемаJSON.СхемаМассива("Фільтри, об'єднуються через І",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "field,op"), 20);


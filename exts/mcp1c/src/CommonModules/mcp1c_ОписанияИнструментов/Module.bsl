Функция СхемаПериода(ТекстОписания, Обязательные)

	Свойства = Новый Соответствие;
	Свойства.Вставить("from", mcp1c_СхемаJSON.СхемаСтроки("Початок: 2026-09-01 або 2026-09-01T00:00:00", 30));
	Свойства.Вставить("to", mcp1c_СхемаJSON.СхемаСтроки("Кінець: 2026-09-30 (кінець дня) або 2026-09-30T18:00:00", 30));

	Свойства.Вставить("resources", СхемаСпискаПолей("Ресурси (Количество, Сумма); типово - усі доступні", 20));
	Свойства.Вставить("account", mcp1c_СхемаJSON.СхемаЗначения(
		"Лише для регістрів бухгалтерії: рахунок кодом (""361"") або посиланням; субрахунки включаються"));

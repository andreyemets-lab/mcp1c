Функция СхемаАгрегатов()

	Свойства = Новый Соответствие;
	Свойства.Вставить("field", mcp1c_СхемаJSON.СхемаСтроки("Поле; для count можна ""*""", 300));
	Свойства.Вставить("func", mcp1c_СхемаJSON.СхемаСтроки("Функція", 20,
		СтрРазделить("sum,count,count_distinct,avg,min,max", ",")));

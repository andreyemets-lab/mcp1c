		+ """group_by"": [""Номенклатура"", ""Склад""], ""filters"": [{""field"": ""Склад"", ""op"": ""eq"", "
		+ """value"": {""type"": ""Справочник.Склады"", ""ref"": ""<uuid>""}}]}. "
		+ "Борг за рахунком: {""register"": ""РегистрБухгалтерии.Хозрасчетный"", ""account"": ""361"", "
		+ """group_by"": [""Субконто1""]}.",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "register"));
	Описание.Вставить("outputSchema", СхемаВыходаСписка("register", "register,columns,rows,row_count,has_more"));
	Возврат Описание;


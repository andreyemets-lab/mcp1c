	Свойства.Вставить("date", mcp1c_СхемаJSON.СхемаСтроки(
		"Момент залишків; дата без часу - на кінець дня; якщо не вказано - поточні залишки", 30));
	Свойства.Вставить("group_by", СхемаСпискаПолей(
		"Виміри, в розрізі яких показати залишки; [] - лише підсумок. Типово: усі виміри (для регістра "
		+ "бухгалтерії - Счет)", 10));

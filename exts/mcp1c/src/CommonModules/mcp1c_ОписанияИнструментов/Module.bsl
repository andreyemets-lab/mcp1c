#Область Схемы

Функция НовоеОписание(Имя, Заголовок, ТекстОписания, ВходнаяСхема)

	Аннотации = Новый Соответствие;
	Аннотации.Вставить("title", Заголовок);
	Аннотации.Вставить("readOnlyHint", Истина);
	Аннотации.Вставить("destructiveHint", Ложь);
	Аннотации.Вставить("idempotentHint", Истина);
	Аннотации.Вставить("openWorldHint", Ложь);

	Описание = Новый Соответствие;
	Описание.Вставить("name", Имя);
	Описание.Вставить("title", Заголовок);
	Описание.Вставить("description", ТекстОписания);
	Описание.Вставить("inputSchema", ВходнаяСхема);
	Описание.Вставить("annotations", Аннотации);
	Возврат Описание;

КонецФункции

Функция СхемаОбъектаМетаданных()

	Возврат mcp1c_СхемаJSON.СхемаСтроки(
		"Повне ім'я об'єкта, як у метаданих: Справочник.Контрагенты, Документ.РеализацияТоваровУслуг, "
		+ "РегистрНакопления.ТоварыНаСкладах; можна з англійським класом: Catalog.Контрагенты", 300);

КонецФункции

Функция СхемаСтрокиОграниченной(ТекстОписания, Минимум, Максимум)

	Схема = mcp1c_СхемаJSON.СхемаСтроки(ТекстОписания, Максимум);
	Схема.Вставить("minLength", Минимум);
	Возврат Схема;

КонецФункции

Функция СхемаСпискаПолей(ТекстОписания, МаксимумЭлементов)

	Возврат mcp1c_СхемаJSON.СхемаМассива(ТекстОписания,
		mcp1c_СхемаJSON.СхемаСтроки("Ім'я поля або шлях через крапку", 300), МаксимумЭлементов);


Функция GetTurnovers()

	Свойства = Новый Соответствие;
	Свойства.Вставить("register", mcp1c_СхемаJSON.СхемаСтроки(
		"Регістр накопичення або бухгалтерії: РегистрНакопления.Продажи, РегистрБухгалтерии.Хозрасчетный", 300));
	Свойства.Вставить("period", СхемаПериода("Період оборотів; дата без часу в to - кінець дня", "from,to"));
	Свойства.Вставить("periodicity", mcp1c_СхемаJSON.СхемаСтроки("Розбивка за періодами; типово none - весь період",
		10, СтрРазделить("none,day,week,month,quarter,year", ",")));
	Свойства.Вставить("group_by", СхемаСпискаПолей(
		"Виміри групування; [] - лише підсумок. Типово: усі виміри (для регістра бухгалтерії - Счет)", 10));
	Свойства.Вставить("filters", СхемаОтборов());
	Свойства.Вставить("resources", СхемаСпискаПолей("Ресурси; типово - усі доступні", 20));
	Свойства.Вставить("account", mcp1c_СхемаJSON.СхемаЗначения(
		"Лише для регістрів бухгалтерії: рахунок кодом (""701"") або посиланням; субрахунки включаються"));
	Свойства.Вставить("with_balances", mcp1c_СхемаJSON.СхемаБулево(
		"Додати початкові й кінцеві залишки (віртуальна таблиця ОстаткиИОбороты)"));
	Свойства.Вставить("limit", mcp1c_СхемаJSON.СхемаЦелого("Рядків на сторінці (не більше ліміту профілю)", 1, 1000, 50));
	Свойства.Вставить("cursor", СхемаКурсора());

	Описание = НовоеОписание("get_turnovers", "Обороти регістра",
		"Обороти регістра накопичення або бухгалтерії за період (віртуальні таблиці Обороты, ОстаткиИОбороты) "
		+ "з групуванням за вимірами і періодами. Колонки: <Ресурс>Приход, <Ресурс>Расход, <Ресурс>Оборот для "
		+ "регістрів накопичення; <Ресурс>ОборотДт, <Ресурс>ОборотКт для бухгалтерії; з with_balances - також "
		+ "початкові й кінцеві залишки. Період не довший за ліміт профілю. "
		+ "Приклад: {""register"": ""РегистрНакопления.Продажи"", ""period"": {""from"": ""2026-01-01"", "
		+ """to"": ""2026-09-30""}, ""periodicity"": ""month"", ""group_by"": [""Номенклатура""], "
		+ """resources"": [""Сумма""]}.",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "register,period"));
	Описание.Вставить("outputSchema", СхемаВыходаСписка("register", "register,columns,rows,row_count,has_more"));
	Возврат Описание;

КонецФункции

Функция GetSlice()

	Свойства = Новый Соответствие;
	Свойства.Вставить("register", mcp1c_СхемаJSON.СхемаСтроки(
		"Періодичний регістр відомостей: РегистрСведений.КурсыВалют, РегистрСведений.ЦеныНоменклатуры", 300));
	Свойства.Вставить("date", mcp1c_СхемаJSON.СхемаСтроки(
		"Момент зрізу; дата без часу - кінець дня (для first - початок); якщо не вказано - поточний зріз", 30));
	Свойства.Вставить("mode", mcp1c_СхемаJSON.СхемаСтроки("last - останні значення на дату, first - перші після дати",
		10, СтрРазделить("last,first", ",")));
	Свойства.Вставить("filters", СхемаОтборов());
	Свойства.Вставить("fields", СхемаСпискаПолей("Поля; типово - період, виміри, ресурси і реквізити", 50));
	Свойства.Вставить("limit", mcp1c_СхемаJSON.СхемаЦелого("Рядків на сторінці (не більше ліміту профілю)", 1, 1000, 50));
	Свойства.Вставить("cursor", СхемаКурсора());

	Описание = НовоеОписание("get_slice", "Зріз регістра відомостей",
		"Зріз останніх (або перших) записів періодичного регістра відомостей на дату: курси, ціни, "
		+ "налаштування на момент часу. Фільтри за вимірами застосовуються всередині віртуальної таблиці. "
		+ "Приклад: {""register"": ""РегистрСведений.КурсыВалют"", ""date"": ""2026-10-19"", "
		+ """filters"": [{""field"": ""Валюта"", ""op"": ""eq"", ""value"": {""type"": ""Справочник.Валюты"", "
		+ """ref"": ""<uuid>""}}]}.",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "register"));
	Описание.Вставить("outputSchema", СхемаВыходаСписка("register", "register,columns,rows,row_count,has_more"));
	Возврат Описание;


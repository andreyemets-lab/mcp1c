///////////////////////////////////////////////////////////////////////////////
// mcp1c_ОписанияИнструментов: описания встроенных инструментов для tools/list (п. 5.1-5.3 ТЗ):
// имена, заголовки, описания для модели, схемы аргументов и результатов, аннотации.
// Порядок инструментов фиксированный. Аргументы проверяются по схемам mcp1c_СхемаJSON
// до выполнения инструмента.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Описания встроенных инструментов в фиксированном порядке.
//
// Параметры:
//  КодыВидов - Массив из Строка - коды видов объектов метаданных (catalog, document, ...).
//  КодыРазделов - Массив из Строка - коды разделов describe_object.
//
// Возвращаемое значение:
//  Массив из Соответствие - name, title, description, inputSchema, outputSchema, annotations.
//
Функция Описания(КодыВидов, КодыРазделов) Экспорт

	Результат = Новый Массив;
	Результат.Добавить(GetContext());
	Результат.Добавить(ListObjects(КодыВидов));
	Результат.Добавить(DescribeObject(КодыРазделов));
	Результат.Добавить(FindObjects());
	Результат.Добавить(GetObject());
	Результат.Добавить(QueryRecords());
	Результат.Добавить(GetBalances());
	Результат.Добавить(GetTurnovers());
	Результат.Добавить(GetSlice());
	Возврат Результат;

КонецФункции

// Операторы отбора filters[].op.
//
// Возвращаемое значение:
//  Массив из Строка - операторы.
//
Функция ОператорыОтбора() Экспорт

	Возврат СтрРазделить("eq,ne,gt,gte,lt,lte,between,in,not_in,in_hierarchy,contains,starts_with,is_empty,not_empty", ",");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Метаданные

Функция GetContext()

	Описание = НовоеОписание("get_context", "Контекст сервера 1С",
		"Повертає контекст сервера 1С: назву й версію конфігурації, версію платформи, поточні дату й час "
		+ "сервера з часовим поясом, мову сеансу, клієнта, профіль доступу, ліміти і доступні інструменти. "
		+ "Викликайте першим, щоб зорієнтуватися в базі.",
		mcp1c_СхемаJSON.СхемаОбъекта(Новый Соответствие));

	Выход = Новый Соответствие;
	Выход.Вставить("configuration", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("platform", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("server_time", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("language", mcp1c_СхемаJSON.СхемаТипа("string"));
	Выход.Вставить("client", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("access", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("server", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("notes", mcp1c_СхемаJSON.СхемаТипа("array"));
	Описание.Вставить("outputSchema", mcp1c_СхемаJSON.СхемаВыхода(Выход, "configuration,platform,server_time"));
	Возврат Описание;

КонецФункции

Функция ListObjects(КодыВидов)

	Свойства = Новый Соответствие;
	Свойства.Вставить("kinds", mcp1c_СхемаJSON.СхемаМассиваСтрок(
		"Види об'єктів; якщо не вказано - усі види", КодыВидов));
	Свойства.Вставить("search", mcp1c_СхемаJSON.СхемаСтроки(
		"Підрядок імені або синоніма без урахування регістру, наприклад ""контраг""", 100));
	Свойства.Вставить("limit", mcp1c_СхемаJSON.СхемаЦелого("Скільки об'єктів повернути", 1, 500, 100));
	Свойства.Вставить("cursor", mcp1c_СхемаJSON.СхемаСтроки("next_cursor з попередньої відповіді", 200));

	Описание = НовоеОписание("list_objects", "Перелік об'єктів метаданих",
		"Перелік доступних об'єктів метаданих конфігурації 1С (довідники, документи, регістри, перерахування тощо) "
		+ "з синонімами. Фільтр за видами і пошук за підрядком в імені або синонімі. "
		+ "Використовуйте, щоб знайти потрібний об'єкт, а потім describe_object для його структури. "
		+ "Приклад: {""kinds"": [""catalog""], ""search"": ""контраг""}.",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства));

	Выход = Новый Соответствие;
	Выход.Вставить("items", mcp1c_СхемаJSON.СхемаТипа("array"));
	Выход.Вставить("total", mcp1c_СхемаJSON.СхемаТипа("integer"));
	Выход.Вставить("returned", mcp1c_СхемаJSON.СхемаТипа("integer"));
	Выход.Вставить("next_cursor", mcp1c_СхемаJSON.СхемаТипа("string"));
	Описание.Вставить("outputSchema", mcp1c_СхемаJSON.СхемаВыхода(Выход, "items,total,returned"));
	Возврат Описание;

КонецФункции

Функция DescribeObject(КодыРазделов)

	Свойства = Новый Соответствие;
	Свойства.Вставить("object", СхемаОбъектаМетаданных());
	Свойства.Вставить("include", mcp1c_СхемаJSON.СхемаМассиваСтрок(
		"Розділи опису; якщо не вказано - усі доступні для цього виду", КодыРазделов));
	Свойства.Вставить("max_fields", mcp1c_СхемаJSON.СхемаЦелого("Найбільша кількість полів у відповіді", 10, 1000, 300));

	Описание = НовоеОписание("describe_object", "Структура об'єкта метаданих",
		"Структура об'єкта метаданих 1С: реквізити з типами, табличні частини, виміри й ресурси регістрів, "
		+ "значення перерахувань, регістри, у які пише документ, поля пошуку, властивості виду "
		+ "(періодичність регістра, ієрархія довідника тощо) і інструменти, якими можна читати дані об'єкта. "
		+ "Показуються лише поля, доступні профілю; імена полів - так, як у метаданих.",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "object"));

	Выход = Новый Соответствие;
	Выход.Вставить("object", mcp1c_СхемаJSON.СхемаТипа("string"));
	Выход.Вставить("kind", mcp1c_СхемаJSON.СхемаТипа("string"));
	Выход.Вставить("name", mcp1c_СхемаJSON.СхемаТипа("string"));
	Выход.Вставить("synonym", mcp1c_СхемаJSON.СхемаТипа("string"));
	Описание.Вставить("outputSchema", mcp1c_СхемаJSON.СхемаВыхода(Выход, "object,kind,name"));
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область Данные

Функция FindObjects()

	ЭлементОбъекта = mcp1c_СхемаJSON.СхемаСтроки("Повне ім'я об'єкта", 300);
	Свойства = Новый Соответствие;
	Свойства.Вставить("query", СхемаСтрокиОграниченной("Рядок пошуку: частина найменування, коду, номера "
		+ "або інших полів пошуку", 1, 100));
	Свойства.Вставить("objects", mcp1c_СхемаJSON.СхемаМассива(
		"Де шукати: повні імена довідників, документів, планів видів характеристик або планів рахунків",
		ЭлементОбъекта, 10, 1));
	Свойства.Вставить("limit", mcp1c_СхемаJSON.СхемаЦелого("Скільки об'єктів повернути", 1, 100, 20));

	Описание = НовоеОписание("find_objects", "Пошук об'єктів за рядком",
		"Знаходить елементи довідників, документи тощо за рядком у полях пошуку (Наименование, Код, Номер і поля "
		+ "«Ввод по строке»; числові коди - за точним збігом). Повертає посилання {""type"", ""ref"", "
		+ """presentation""}, які передаються у filters інших інструментів і в get_object. "
		+ "Помічені на вилучення не показуються. "
		+ "Приклад: {""query"": ""альфа"", ""objects"": [""Справочник.Контрагенты""]}.",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "query,objects"));
	Описание.Вставить("outputSchema", СхемаВыходаСписка("query", "items,returned,has_more"));
	Возврат Описание;

КонецФункции

Функция GetObject()

	Свойства = Новый Соответствие;
	Свойства.Вставить("object", СхемаОбъектаМетаданных());
	Свойства.Вставить("ref", mcp1c_СхемаJSON.СхемаСтроки(
		"Унікальний ідентифікатор: поле ref значення-посилання з результатів інших інструментів", 36));
	Свойства.Вставить("tabular_sections", mcp1c_СхемаJSON.СхемаМассива(
		"Табличні частини; якщо не вказано - усі доступні", mcp1c_СхемаJSON.СхемаСтроки("Ім'я табличної частини", 128), 20));
	Свойства.Вставить("tabular_limit", mcp1c_СхемаJSON.СхемаЦелого(
		"Скільки рядків кожної табличної частини повернути; 0 - без табличних частин", 0, 1000, 20));

	Описание = НовоеОписание("get_object", "Картка об'єкта",
		"Картка об'єкта за посиланням: усі доступні профілю реквізити і рядки табличних частин. "
		+ "Об'єкт поза профілем або відсіяний обмеженнями рядків - «не знайдено або недоступно». "
		+ "Приклад: {""object"": ""Документ.РеализацияТоваровУслуг"", ""ref"": ""4e0c1d2a-…"", "
		+ """tabular_sections"": [""Товары""]}.",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "object,ref"));

	Выход = Новый Соответствие;
	Выход.Вставить("object", mcp1c_СхемаJSON.СхемаТипа("string"));
	Выход.Вставить("ref", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("fields", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("tabular_sections", mcp1c_СхемаJSON.СхемаТипа("object"));
	Выход.Вставить("notes", mcp1c_СхемаJSON.СхемаТипа("array"));
	Описание.Вставить("outputSchema", mcp1c_СхемаJSON.СхемаВыхода(Выход, "object,fields"));
	Возврат Описание;

КонецФункции

Функция QueryRecords()

	Свойства = Новый Соответствие;
	Свойства.Вставить("object", mcp1c_СхемаJSON.СхемаСтроки(
		"Таблиця: Справочник.Контрагенты, Документ.РеализацияТоваровУслуг, таблична частина "
		+ "Документ.РеализацияТоваровУслуг.Товары, РегистрСведений.КурсыВалют, РегистрНакопления.Продажи", 300));
	Свойства.Вставить("fields", СхемаСпискаПолей("Поля вибірки; шлях через крапку розіменовує посилання: "
		+ "Контрагент.ИНН. Якщо не вказано - ключові поля і перші 20 реквізитів", 50));
	Свойства.Вставить("filters", СхемаОтборов());
	Свойства.Вставить("period", СхемаПериода("Відбір за періодом (Дата документа, Период регістра)", ""));
	Свойства.Вставить("group_by", СхемаСпискаПолей("Поля групування; разом з aggregates", 10));
	Свойства.Вставить("aggregates", СхемаАгрегатов());
	Свойства.Вставить("order_by", СхемаПорядка());
	Свойства.Вставить("include_deleted", mcp1c_СхемаJSON.СхемаБулево("Показувати помічені на вилучення, якщо дозволяє профіль"));
	Свойства.Вставить("only_posted", mcp1c_СхемаJSON.СхемаБулево("Лише проведені документи"));
	Свойства.Вставить("limit", mcp1c_СхемаJSON.СхемаЦелого("Рядків на сторінці (не більше ліміту профілю)", 1, 1000, 50));
	Свойства.Вставить("cursor", СхемаКурсора());

	Описание = НовоеОписание("query_records", "Вибірка записів",
		"Вибірка з однієї таблиці (довідник, документ, таблична частина, регістр відомостей або накопичення) "
		+ "з фільтрами, сортуванням, групуванням і агрегатами. Значення фільтрів: посилання - "
		+ "{""type"": ""Справочник.Контрагенты"", ""ref"": ""<uuid>""}, перерахування - ім'я значення, дата - "
		+ """2026-09-30"" або ""2026-09-30T14:00:00"" (місцевий час сервера), between - [від, до], in - до 100 значень. "
		+ "Дата без часу у верхній межі означає кінець дня. Без fields повертаються ключові поля. "
		+ "Наступна сторінка - той самий виклик з cursor = next_cursor. "
		+ "Приклад: {""object"": ""Документ.РеализацияТоваровУслуг"", ""fields"": [""Дата"", ""Номер"", ""Контрагент"", "
		+ """СуммаДокумента""], ""period"": {""from"": ""2026-09-01"", ""to"": ""2026-09-30""}, ""only_posted"": true}. "
		+ "Групування: {""object"": ""Документ.РеализацияТоваровУслуг"", ""group_by"": [""Контрагент""], "
		+ """aggregates"": [{""field"": ""СуммаДокумента"", ""func"": ""sum"", ""as"": ""Сума""}], "
		+ """order_by"": [{""field"": ""Сума"", ""desc"": true}]}.",
		mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "object"));
	Описание.Вставить("outputSchema", СхемаВыходаСписка("object", "object,columns,rows,row_count,has_more"));
	Возврат Описание;


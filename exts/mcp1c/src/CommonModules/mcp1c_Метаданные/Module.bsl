// Коллекция свойства объекта метаданных.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект.
//  ИмяСвойства - Строка - имя свойства-коллекции (Реквизиты, ТабличныеЧасти и т. п.).
//
// Возвращаемое значение:
//  КоллекцияОбъектовМетаданных, Неопределено - коллекция или Неопределено, если получить ее не удалось.
//
Функция КоллекцияСвойства(ОбъектМД, ИмяСвойства)

	Попытка
		Если ИмяСвойства = "Реквизиты" Тогда
			Возврат ОбъектМД.Реквизиты;
		ИначеЕсли ИмяСвойства = "СтандартныеРеквизиты" Тогда
			Возврат ОбъектМД.СтандартныеРеквизиты;
		ИначеЕсли ИмяСвойства = "ТабличныеЧасти" Тогда
			Возврат ОбъектМД.ТабличныеЧасти;
		ИначеЕсли ИмяСвойства = "Измерения" Тогда
			Возврат ОбъектМД.Измерения;
		ИначеЕсли ИмяСвойства = "Ресурсы" Тогда
			Возврат ОбъектМД.Ресурсы;
		ИначеЕсли ИмяСвойства = "ЗначенияПеречисления" Тогда
			Возврат ОбъектМД.ЗначенияПеречисления;
		ИначеЕсли ИмяСвойства = "Движения" Тогда
			Возврат ОбъектМД.Движения;
		ИначеЕсли ИмяСвойства = "ВводПоСтроке" Тогда
			Возврат ОбъектМД.ВводПоСтроке;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ОписаниеПоля(Имя, Синоним, ТипыПоля, Стандартное = Ложь)

	Поле = Новый Соответствие;
	Поле.Вставить("name", Имя);
	Если Не ПустаяСтрока(Синоним) И Синоним <> Имя Тогда
		Поле.Вставить("synonym", Синоним);
	КонецЕсли;
	Если ТипЗнч(ТипыПоля) = Тип("Массив") Тогда
		Поле.Вставить("types", ТипыПоля);
	Иначе
		Поле.Вставить("types", ПредставленияТипов(ТипыПоля));
	КонецЕсли;
	Если Стандартное Тогда
		Поле.Вставить("standard", Истина);
	КонецЕсли;
	Возврат Поле;

КонецФункции

// Описания полей коллекции метаданных, доступных клиенту.
//
// Параметры:
//  Коллекция - КоллекцияОбъектовМетаданных, Неопределено - реквизиты, измерения или ресурсы.
//  Контекст - Структура - счетчик полей и политика, см. ОписаниеОбъекта.
//
// Возвращаемое значение:
//  Массив из Соответствие - описания полей.
//
Функция ОписанияПолей(Коллекция, Контекст, Стандартные = Ложь)

	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ПолеМД Из Коллекция Цикл
		Если Не mcp1c_ПравилаДоступа.ПолеДоступно(Контекст.Политика, Контекст.Объект, Контекст.Префикс + ПолеМД.Имя,
			ИменаТипов(ПолеМД.Тип)) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЕстьМестоДляПоля(Контекст) Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(ОписаниеПоля(ПолеМД.Имя, ПолеМД.Синоним, ПолеМД.Тип, Стандартные));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписанияСтандартныхРеквизитов(ОбъектМД, Код, Контекст)
	// Стандартные поля: для поддерживаемых видов - те же, что принимают инструменты чтения
	// (см. ОписаниеТаблицы); для остальных - из коллекции СтандартныеРеквизиты.

	Таблица = ОписаниеОсновнойТаблицы(ОбъектМД, Код);
	Если Таблица = Неопределено Тогда
		Возврат ОписанияПолей(КоллекцияСвойства(ОбъектМД, "СтандартныеРеквизиты"), Контекст, Истина);
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Поле Из Таблица.Поля Цикл
		Если Поле.Роль <> "standard"
			Или Не mcp1c_ПравилаДоступа.ПолеДоступно(Контекст.Политика, Контекст.Объект, Поле.ПолеПолитики, Поле.Типы) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЕстьМестоДляПоля(Контекст) Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(ОписаниеПоля(Поле.Имя, "", ПредставленияТиповПоля(Поле), Истина));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписанияТабличныхЧастей(ОбъектМД, Контекст)

	Результат = Новый Массив;
	Коллекция = КоллекцияСвойства(ОбъектМД, "ТабличныеЧасти");
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ТабличнаяЧасть Из Коллекция Цикл
		Если Не mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(Контекст.Политика, Контекст.Объект, ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЕстьМестоДляПоля(Контекст) Тогда
			Прервать;
		КонецЕсли;
		Описание = Новый Соответствие;
		Описание.Вставить("name", ТабличнаяЧасть.Имя);
		Описание.Вставить("table", Контекст.Объект + "." + ТабличнаяЧасть.Имя);
		Если Не ПустаяСтрока(ТабличнаяЧасть.Синоним) И ТабличнаяЧасть.Синоним <> ТабличнаяЧасть.Имя Тогда
			Описание.Вставить("synonym", ТабличнаяЧасть.Синоним);
		КонецЕсли;
		Контекст.Префикс = ТабличнаяЧасть.Имя + ".";
		Описание.Вставить("attributes", ОписанияПолей(ТабличнаяЧасть.Реквизиты, Контекст));
		Контекст.Префикс = "";
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписанияЗначенийПеречисления(ОбъектМД)

	Результат = Новый Массив;
	Коллекция = КоллекцияСвойства(ОбъектМД, "ЗначенияПеречисления");
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ЗначениеМД Из Коллекция Цикл
		Описание = Новый Соответствие;
		Описание.Вставить("name", ЗначениеМД.Имя);
		Описание.Вставить("synonym", ?(ПустаяСтрока(ЗначениеМД.Синоним), ЗначениеМД.Имя, ЗначениеМД.Синоним));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолныеИменаОбъектов(Коллекция, Политика = Неопределено)
	// Полные имена объектов коллекции без служебных объектов; если передана политика - только доступные.

	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ОбъектМД Из Коллекция Цикл
		Если ЭтоСкрытыйОбъект(ОбъектМД) Тогда
			Продолжить;
		КонецЕсли;
		Если Политика <> Неопределено И Не mcp1c_ПравилаДоступа.ОбъектДоступен(Политика, ПолноеИмяОбъекта(ОбъектМД)) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ПолноеИмяОбъекта(ОбъектМД));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИменаОбъектов(Коллекция)

	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ОбъектМД Из Коллекция Цикл
		Результат.Добавить(ОбъектМД.Имя);
	КонецЦикла;
	Возврат Результат;


// Разделы описания, которые существуют у объектов данного вида.
// Обращение к отсутствующему свойству объекта метаданных вызывает исключение,
// поэтому разделы определяются по виду заранее.
//
// Параметры:
//  Код - Строка - код вида объекта, см. ВидыОбъектов.
//
// Возвращаемое значение:
//  Массив из Строка - коды разделов (properties, attributes, ...).
//
Функция ПрименимыеРазделы(Код)

	ОбъектныеВиды = СтрРазделить("catalog,document,chart_of_characteristic_types,chart_of_accounts,"
		+ "chart_of_calculation_types,business_process,task", ",");
	Регистры = СтрРазделить("information_register,accumulation_register,accounting_register,calculation_register", ",");

	Разделы = Новый Массив;
	Разделы.Добавить("properties");
	Если ОбъектныеВиды.Найти(Код) <> Неопределено Тогда
		Разделы.Добавить("standard_attributes");
		Разделы.Добавить("attributes");
		Разделы.Добавить("tabular_sections");
		Разделы.Добавить("search_fields");
		Если Код = "document" Тогда
			Разделы.Добавить("movements");
		КонецЕсли;
	ИначеЕсли Регистры.Найти(Код) <> Неопределено Тогда
		Разделы.Добавить("standard_attributes");
		Разделы.Добавить("dimensions");
		Разделы.Добавить("resources");
		Разделы.Добавить("attributes");
	ИначеЕсли Код = "document_journal" Тогда
		Разделы.Добавить("standard_attributes");
	ИначеЕсли Код = "enum" Тогда
		Разделы.Добавить("enum_values");
	КонецЕсли;
	Возврат Разделы;


///////////////////////////////////////////////////////////////////////////////
// mcp1c_Метаданные: универсальная интроспекция метаданных конфигурации.
// Работает с любой конфигурацией: сведения берутся из Метаданные во время выполнения.
// Служебные объекты расширения (префикс mcp1c_) и планы обмена не показываются.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Поддерживаемые виды объектов метаданных в порядке вывода.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Код - Строка - код вида для MCP (catalog, document, ...).
//   * Класс - Строка - первая часть полного имени (Справочник, Документ, ...).
//   * КлассАнгл - Строка - то же на английском (Catalog, Document, ...).
//
Функция ВидыОбъектов() Экспорт

	Виды = Новый Массив;
	ДобавитьВид(Виды, "catalog", "Справочник", "Catalog");
	ДобавитьВид(Виды, "document", "Документ", "Document");
	ДобавитьВид(Виды, "document_journal", "ЖурналДокументов", "DocumentJournal");
	ДобавитьВид(Виды, "enum", "Перечисление", "Enum");
	ДобавитьВид(Виды, "chart_of_characteristic_types", "ПланВидовХарактеристик", "ChartOfCharacteristicTypes");
	ДобавитьВид(Виды, "chart_of_accounts", "ПланСчетов", "ChartOfAccounts");
	ДобавитьВид(Виды, "chart_of_calculation_types", "ПланВидовРасчета", "ChartOfCalculationTypes");
	ДобавитьВид(Виды, "information_register", "РегистрСведений", "InformationRegister");
	ДобавитьВид(Виды, "accumulation_register", "РегистрНакопления", "AccumulationRegister");
	ДобавитьВид(Виды, "accounting_register", "РегистрБухгалтерии", "AccountingRegister");
	ДобавитьВид(Виды, "calculation_register", "РегистрРасчета", "CalculationRegister");
	ДобавитьВид(Виды, "business_process", "БизнесПроцесс", "BusinessProcess");
	ДобавитьВид(Виды, "task", "Задача", "Task");
	ДобавитьВид(Виды, "constant", "Константа", "Constant");
	ДобавитьВид(Виды, "report", "Отчет", "Report");
	Возврат Виды;

КонецФункции

// Коды поддерживаемых видов объектов.
//
// Возвращаемое значение:
//  Массив из Строка - коды видов.
//
Функция КодыВидов() Экспорт

	Результат = Новый Массив;
	Для Каждого Вид Из ВидыОбъектов() Цикл
		Результат.Добавить(Вид.Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Коды разделов описания объекта (аргумент include инструмента describe_object).
//
// Возвращаемое значение:
//  Массив из Строка - коды разделов.
//
Функция КодыРазделов() Экспорт

	Возврат СтрРазделить("properties,standard_attributes,attributes,tabular_sections,dimensions,resources,"
		+ "enum_values,movements,search_fields", ",");

КонецФункции

// Список объектов метаданных с фильтром по видам и строке поиска.
//
// Параметры:
//  Коды - Массив из Строка - коды видов; пустой массив - все виды.
//  СтрокаПоиска - Строка - подстрока имени или синонима (без учета регистра).
//  Смещение - Число - сколько найденных объектов пропустить.
//  Лимит - Число - максимальное количество объектов в ответе.
//
// Возвращаемое значение:
//  Структура:
//   * Элементы - Массив из Соответствие - object, kind, synonym.
//   * Всего - Число - количество найденных объектов.
//   * СледующееСмещение - Число, Неопределено - смещение следующей страницы.
//
Функция СписокОбъектов(Коды, Знач СтрокаПоиска, Смещение, Лимит) Экспорт

	СтрокаПоиска = НРег(СокрЛП(СтрокаПоиска));
	Найденные = Новый Массив;

	Для Каждого Вид Из ВидыОбъектов() Цикл
		Если Коды.Количество() > 0 И Коды.Найти(Вид.Код) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОбъектМД Из КоллекцияВида(Вид.Код) Цикл
			Если ЭтоСкрытыйОбъект(ОбъектМД) Тогда
				Продолжить;
			КонецЕсли;
			Синоним = СинонимОбъекта(ОбъектМД);
			Если Не ПустаяСтрока(СтрокаПоиска)
				И СтрНайти(НРег(ОбъектМД.Имя), СтрокаПоиска) = 0
				И СтрНайти(НРег(Синоним), СтрокаПоиска) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Элемент = Новый Соответствие;
			Элемент.Вставить("object", ОбъектМД.ПолноеИмя());
			Элемент.Вставить("kind", Вид.Код);
			Элемент.Вставить("synonym", Синоним);
			Найденные.Добавить(Элемент);
		КонецЦикла;
	КонецЦикла;

	Элементы = Новый Массив;
	Граница = Мин(Смещение + Лимит, Найденные.Количество());
	Для Индекс = Смещение По Граница - 1 Цикл
		Элементы.Добавить(Найденные[Индекс]);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Элементы", Элементы);
	Результат.Вставить("Всего", Найденные.Количество());
	Результат.Вставить("СледующееСмещение", ?(Граница < Найденные.Количество(), Граница, Неопределено));
	Возврат Результат;

КонецФункции

// Находит объект метаданных по полному имени. Допускаются русские и английские
// имена классов ("Справочник.Контрагенты", "Catalog.Контрагенты"), регистр не важен.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - найденный объект; Неопределено, если объекта нет,
//                                   вид не поддерживается или объект скрыт.
//
Функция НайтиОбъект(Знач ПолноеИмя) Экспорт

	Части = СтрРазделить(СокрЛП(ПолноеИмя), ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вид = ВидПоКлассу(Части[0]);
	Если Вид = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяОбъекта = НРег(Части[1]);
	Для Каждого ОбъектМД Из КоллекцияВида(Вид.Код) Цикл
		Если НРег(ОбъектМД.Имя) = ИмяОбъекта Тогда
			Возврат ?(ЭтоСкрытыйОбъект(ОбъектМД), Неопределено, ОбъектМД);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Описание структуры объекта метаданных для модели.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - описываемый объект.
//  Разделы - Массив из Строка - включаемые разделы (см. КодыРазделов); пустой массив - все.
//  МаксимумПолей - Число - ограничение общего количества полей в ответе.
//
// Возвращаемое значение:
//  Соответствие - описание объекта (object, kind, name, synonym, properties, attributes, ...).
//
Функция ОписаниеОбъекта(ОбъектМД, Разделы, МаксимумПолей) Экспорт

	Код = КодВида(ОбъектМД);
	Результат = Новый Соответствие;
	Результат.Вставить("object", ОбъектМД.ПолноеИмя());
	Результат.Вставить("kind", Код);
	Результат.Вставить("name", ОбъектМД.Имя);
	Результат.Вставить("synonym", СинонимОбъекта(ОбъектМД));
	Если Не ПустаяСтрока(ОбъектМД.Комментарий) Тогда
		Результат.Вставить("comment", ОбъектМД.Комментарий);
	КонецЕсли;

	Счетчик = Новый Структура("Количество, Максимум, Обрезано", 0, МаксимумПолей, Ложь);
	Применимые = ПрименимыеРазделы(Код);

	Если РазделНужен(Разделы, Применимые, "properties") Тогда
		Свойства = СвойстваОбъекта(ОбъектМД, Код);
		Если Свойства.Количество() > 0 Тогда
			Результат.Вставить("properties", Свойства);
		КонецЕсли;
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "standard_attributes") Тогда
		ДобавитьПоля(Результат, "standard_attributes", ОписанияСтандартныхРеквизитов(ОбъектМД, Счетчик));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "dimensions") Тогда
		ДобавитьПоля(Результат, "dimensions", ОписанияПолей(КоллекцияСвойства(ОбъектМД, "Измерения"), Счетчик));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "resources") Тогда
		ДобавитьПоля(Результат, "resources", ОписанияПолей(КоллекцияСвойства(ОбъектМД, "Ресурсы"), Счетчик));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "attributes") Тогда
		ДобавитьПоля(Результат, "attributes", ОписанияПолей(КоллекцияСвойства(ОбъектМД, "Реквизиты"), Счетчик));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "tabular_sections") Тогда
		ДобавитьПоля(Результат, "tabular_sections", ОписанияТабличныхЧастей(ОбъектМД, Счетчик));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "enum_values") Тогда
		ДобавитьПоля(Результат, "enum_values", ОписанияЗначенийПеречисления(ОбъектМД));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "movements") Тогда
		ДобавитьПоля(Результат, "movements", ПолныеИменаОбъектов(КоллекцияСвойства(ОбъектМД, "Движения")));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "search_fields") Тогда
		ДобавитьПоля(Результат, "search_fields", ИменаОбъектов(КоллекцияСвойства(ОбъектМД, "ВводПоСтроке")));
	КонецЕсли;

	Если Счетчик.Обрезано Тогда
		Результат.Вставить("truncated", Истина);
		Результат.Вставить("note", СтрШаблон(
			"Показано %1 полів; збільште max_fields або обмежте include", Счетчик.Максимум));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Код вида объекта метаданных.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект.
//
// Возвращаемое значение:
//  Строка - код вида; пустая строка, если вид не поддерживается.
//
Функция КодВида(ОбъектМД) Экспорт

	Класс = СтрРазделить(ОбъектМД.ПолноеИмя(), ".")[0];
	Вид = ВидПоКлассу(Класс);
	Возврат ?(Вид = Неопределено, "", Вид.Код);

КонецФункции

// Синоним объекта метаданных на языке сеанса, а если он пуст - имя.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект.
//
// Возвращаемое значение:
//  Строка - синоним или имя.
//
Функция СинонимОбъекта(ОбъектМД) Экспорт

	Синоним = ОбъектМД.Синоним;
	Возврат ?(ПустаяСтрока(Синоним), ОбъектМД.Имя, Синоним);

КонецФункции

// Строковые представления типов из описания типов.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов - описание типов поля.
//
// Возвращаемое значение:
//  Массив из Строка - например, "Строка(150)", "Число(15,2)", "Справочник.Контрагенты".
//
Функция ПредставленияТипов(ОписаниеТипов) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(ОписаниеТипов) <> Тип("ОписаниеТипов") Тогда
		Возврат Результат;
	КонецЕсли;

	МаксимумТипов = 20;
	Типы = ОписаниеТипов.Типы();
	Для Каждого ТекущийТип Из Типы Цикл
		Если Результат.Количество() >= МаксимумТипов Тогда
			Результат.Добавить(СтрШаблон("... ще %1", Типы.Количество() - МаксимумТипов));
			Прервать;
		КонецЕсли;
		Результат.Добавить(ПредставлениеТипа(ТекущийТип, ОписаниеТипов));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Виды

Процедура ДобавитьВид(Виды, Код, Класс, КлассАнгл)

	Виды.Добавить(Новый Структура("Код, Класс, КлассАнгл", Код, Класс, КлассАнгл));

КонецПроцедуры

Функция ВидПоКлассу(Знач Класс)

	Класс = НРег(СокрЛП(Класс));
	Для Каждого Вид Из ВидыОбъектов() Цикл
		Если НРег(Вид.Класс) = Класс Или НРег(Вид.КлассАнгл) = Класс Тогда
			Возврат Вид;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция КоллекцияВида(Код)

	Если Код = "catalog" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли Код = "document" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли Код = "document_journal" Тогда
		Возврат Метаданные.ЖурналыДокументов;
	ИначеЕсли Код = "enum" Тогда
		Возврат Метаданные.Перечисления;
	ИначеЕсли Код = "chart_of_characteristic_types" Тогда
		Возврат Метаданные.ПланыВидовХарактеристик;
	ИначеЕсли Код = "chart_of_accounts" Тогда
		Возврат Метаданные.ПланыСчетов;
	ИначеЕсли Код = "chart_of_calculation_types" Тогда
		Возврат Метаданные.ПланыВидовРасчета;
	ИначеЕсли Код = "information_register" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли Код = "accumulation_register" Тогда
		Возврат Метаданные.РегистрыНакопления;
	ИначеЕсли Код = "accounting_register" Тогда
		Возврат Метаданные.РегистрыБухгалтерии;
	ИначеЕсли Код = "calculation_register" Тогда
		Возврат Метаданные.РегистрыРасчета;
	ИначеЕсли Код = "business_process" Тогда
		Возврат Метаданные.БизнесПроцессы;
	ИначеЕсли Код = "task" Тогда
		Возврат Метаданные.Задачи;
	ИначеЕсли Код = "constant" Тогда
		Возврат Метаданные.Константы;
	ИначеЕсли Код = "report" Тогда
		Возврат Метаданные.Отчеты;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

Функция ЭтоСкрытыйОбъект(ОбъектМД)

	// Служебные объекты самого расширения (п. 7.6 ТЗ, глобальные запреты).
	Возврат СтрНачинаетсяС(НРег(ОбъектМД.Имя), "mcp1c_");

КонецФункции

// Разделы описания, которые существуют у объектов данного вида.
// Обращение к отсутствующему свойству объекта метаданных вызывает исключение,
// поэтому разделы определяются по виду заранее.
//
// Параметры:
//  Код - Строка - код вида объекта, см. ВидыОбъектов.
//
// Возвращаемое значение:
//  Массив из Строка - коды разделов (properties, attributes, ...).
//
Функция ПрименимыеРазделы(Код)

	ОбъектныеВиды = СтрРазделить("catalog,document,chart_of_characteristic_types,chart_of_accounts,"
		+ "chart_of_calculation_types,business_process,task", ",");
	Регистры = СтрРазделить("information_register,accumulation_register,accounting_register,calculation_register", ",");

	Разделы = Новый Массив;
	Разделы.Добавить("properties");
	Если ОбъектныеВиды.Найти(Код) <> Неопределено Тогда
		Разделы.Добавить("standard_attributes");
		Разделы.Добавить("attributes");
		Разделы.Добавить("tabular_sections");
		Разделы.Добавить("search_fields");
		Если Код = "document" Тогда
			Разделы.Добавить("movements");
		КонецЕсли;
	ИначеЕсли Регистры.Найти(Код) <> Неопределено Тогда
		Разделы.Добавить("standard_attributes");
		Разделы.Добавить("dimensions");
		Разделы.Добавить("resources");
		Разделы.Добавить("attributes");
	ИначеЕсли Код = "document_journal" Тогда
		Разделы.Добавить("standard_attributes");
	ИначеЕсли Код = "enum" Тогда
		Разделы.Добавить("enum_values");
	КонецЕсли;
	Возврат Разделы;

КонецФункции

#КонецОбласти

#Область Описание

Функция РазделНужен(Разделы, Применимые, Раздел)

	Если Применимые.Найти(Раздел) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Разделы.Количество() = 0 Или Разделы.Найти(Раздел) <> Неопределено;

КонецФункции

Процедура ДобавитьПоля(Результат, Ключ, Значения)

	Если ТипЗнч(Значения) = Тип("Массив") И Значения.Количество() > 0 Тогда
		Результат.Вставить(Ключ, Значения);
	КонецЕсли;

КонецПроцедуры

// Коллекция свойства объекта метаданных.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект.
//  ИмяСвойства - Строка - имя свойства-коллекции (Реквизиты, ТабличныеЧасти и т. п.).
//
// Возвращаемое значение:
//  КоллекцияОбъектовМетаданных, Неопределено - коллекция или Неопределено, если получить ее не удалось.
//
Функция КоллекцияСвойства(ОбъектМД, ИмяСвойства)

	Попытка
		Если ИмяСвойства = "Реквизиты" Тогда
			Возврат ОбъектМД.Реквизиты;
		ИначеЕсли ИмяСвойства = "СтандартныеРеквизиты" Тогда
			Возврат ОбъектМД.СтандартныеРеквизиты;
		ИначеЕсли ИмяСвойства = "ТабличныеЧасти" Тогда
			Возврат ОбъектМД.ТабличныеЧасти;
		ИначеЕсли ИмяСвойства = "Измерения" Тогда
			Возврат ОбъектМД.Измерения;
		ИначеЕсли ИмяСвойства = "Ресурсы" Тогда
			Возврат ОбъектМД.Ресурсы;
		ИначеЕсли ИмяСвойства = "ЗначенияПеречисления" Тогда
			Возврат ОбъектМД.ЗначенияПеречисления;
		ИначеЕсли ИмяСвойства = "Движения" Тогда
			Возврат ОбъектМД.Движения;
		ИначеЕсли ИмяСвойства = "ВводПоСтроке" Тогда
			Возврат ОбъектМД.ВводПоСтроке;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ОписаниеПоля(Имя, Синоним, ТипыПоля, Стандартное = Ложь)

	Поле = Новый Соответствие;
	Поле.Вставить("name", Имя);
	Если Не ПустаяСтрока(Синоним) И Синоним <> Имя Тогда
		Поле.Вставить("synonym", Синоним);
	КонецЕсли;
	Поле.Вставить("types", ПредставленияТипов(ТипыПоля));
	Если Стандартное Тогда
		Поле.Вставить("standard", Истина);
	КонецЕсли;
	Возврат Поле;

КонецФункции

Функция ОписанияПолей(Коллекция, Счетчик)

	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ПолеМД Из Коллекция Цикл
		Если Не ЕстьМестоДляПоля(Счетчик) Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(ОписаниеПоля(ПолеМД.Имя, ПолеМД.Синоним, ПолеМД.Тип));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписанияСтандартныхРеквизитов(ОбъектМД, Счетчик)

	Результат = Новый Массив;
	Коллекция = КоллекцияСвойства(ОбъектМД, "СтандартныеРеквизиты");
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Реквизит Из Коллекция Цикл
		Если Не ЕстьМестоДляПоля(Счетчик) Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(ОписаниеПоля(Реквизит.Имя, Реквизит.Синоним, Реквизит.Тип, Истина));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписанияТабличныхЧастей(ОбъектМД, Счетчик)

	Результат = Новый Массив;
	Коллекция = КоллекцияСвойства(ОбъектМД, "ТабличныеЧасти");
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ТабличнаяЧасть Из Коллекция Цикл
		Если Не ЕстьМестоДляПоля(Счетчик) Тогда
			Прервать;
		КонецЕсли;
		Описание = Новый Соответствие;
		Описание.Вставить("name", ТабличнаяЧасть.Имя);
		Если Не ПустаяСтрока(ТабличнаяЧасть.Синоним) И ТабличнаяЧасть.Синоним <> ТабличнаяЧасть.Имя Тогда
			Описание.Вставить("synonym", ТабличнаяЧасть.Синоним);
		КонецЕсли;
		Описание.Вставить("attributes", ОписанияПолей(ТабличнаяЧасть.Реквизиты, Счетчик));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписанияЗначенийПеречисления(ОбъектМД)

	Результат = Новый Массив;
	Коллекция = КоллекцияСвойства(ОбъектМД, "ЗначенияПеречисления");
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ЗначениеМД Из Коллекция Цикл
		Описание = Новый Соответствие;
		Описание.Вставить("name", ЗначениеМД.Имя);
		Описание.Вставить("synonym", ?(ПустаяСтрока(ЗначениеМД.Синоним), ЗначениеМД.Имя, ЗначениеМД.Синоним));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолныеИменаОбъектов(Коллекция)

	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ОбъектМД Из Коллекция Цикл
		Если Не ЭтоСкрытыйОбъект(ОбъектМД) Тогда
			Результат.Добавить(ОбъектМД.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИменаОбъектов(Коллекция)

	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ОбъектМД Из Коллекция Цикл
		Результат.Добавить(ОбъектМД.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьМестоДляПоля(Счетчик)

	Если Счетчик.Количество >= Счетчик.Максимум Тогда
		Счетчик.Обрезано = Истина;
		Возврат Ложь;
	КонецЕсли;
	Счетчик.Количество = Счетчик.Количество + 1;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СвойстваВидов

Функция СвойстваОбъекта(ОбъектМД, Код)

	Свойства = Новый Соответствие;
	Попытка
		ЗаполнитьСвойстваВида(Свойства, ОбъектМД, Код);
	Исключение
		// Свойство недоступно в этой версии платформы: описание остается без него.
		Свойства.Вставить("properties_incomplete", Истина);
	КонецПопытки;
	Возврат Свойства;

КонецФункции

Процедура ЗаполнитьСвойстваВида(Свойства, ОбъектМД, Код)

	Если Код = "catalog" Тогда
		ЗаполнитьСвойстваСправочника(Свойства, ОбъектМД);
	ИначеЕсли Код = "document" Тогда
		Свойства.Вставить("posting_allowed",
			ОбъектМД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить);
	ИначеЕсли СтрЗаканчиваетсяНа(Код, "_register") Тогда
		ЗаполнитьСвойстваРегистра(Свойства, ОбъектМД, Код);
	ИначеЕсли Код = "chart_of_accounts" Тогда
		Свойства.Вставить("max_subconto", ОбъектМД.МаксКоличествоСубконто);
		ДобавитьПолноеИмя(Свойства, "subconto_types", ОбъектМД.ВидыСубконто);
		Свойства.Вставить("accounting_flags", ИменаОбъектов(ОбъектМД.ПризнакиУчета));
	ИначеЕсли Код = "chart_of_characteristic_types" Тогда
		Свойства.Вставить("value_types", ПредставленияТипов(ОбъектМД.Тип));
	ИначеЕсли Код = "document_journal" Тогда
		Свойства.Вставить("documents", ПолныеИменаОбъектов(ОбъектМД.РегистрируемыеДокументы));
		Свойства.Вставить("columns", ИменаОбъектов(ОбъектМД.Графы));
	ИначеЕсли Код = "constant" Тогда
		Свойства.Вставить("types", ПредставленияТипов(ОбъектМД.Тип));
	ИначеЕсли Код = "report" Тогда
		Свойства.Вставить("has_main_dcs_schema", ОбъектМД.ОсновнаяСхемаКомпоновкиДанных <> Неопределено);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСвойстваРегистра(Свойства, ОбъектМД, Код)

	СвойстваОбъектов = Метаданные.СвойстваОбъектов;
	Если Код = "information_register" Тогда
		Свойства.Вставить("periodicity", КодПериодичности(ОбъектМД.ПериодичностьРегистраСведений));
		Свойства.Вставить("write_mode", ?(ОбъектМД.РежимЗаписи
			= СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору, "recorder", "independent"));
	ИначеЕсли Код = "accumulation_register" Тогда
		Свойства.Вставить("register_type", ?(ОбъектМД.ВидРегистра
			= СвойстваОбъектов.ВидРегистраНакопления.Остатки, "balance", "turnovers"));
	ИначеЕсли Код = "accounting_register" Тогда
		ДобавитьПолноеИмя(Свойства, "chart_of_accounts", ОбъектМД.ПланСчетов);
		Свойства.Вставить("correspondence", ОбъектМД.Корреспонденция);
	ИначеЕсли Код = "calculation_register" Тогда
		ДобавитьПолноеИмя(Свойства, "chart_of_calculation_types", ОбъектМД.ПланВидовРасчета);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПолноеИмя(Свойства, Ключ, ОбъектМД)

	Если ОбъектМД <> Неопределено Тогда
		Свойства.Вставить(Ключ, ОбъектМД.ПолноеИмя());
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСвойстваСправочника(Свойства, ОбъектМД)

	Свойства.Вставить("hierarchical", ОбъектМД.Иерархический);
	Если ОбъектМД.Иерархический Тогда
		Свойства.Вставить("hierarchy_type", ?(ОбъектМД.ВидИерархии
			= Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов, "folders_and_items", "items"));
	КонецЕсли;
	Владельцы = ПолныеИменаОбъектов(ОбъектМД.Владельцы);
	Если Владельцы.Количество() > 0 Тогда
		Свойства.Вставить("owners", Владельцы);
	КонецЕсли;
	Свойства.Вставить("code_length", ОбъектМД.ДлинаКода);
	Свойства.Вставить("description_length", ОбъектМД.ДлинаНаименования);

КонецПроцедуры

Функция КодПериодичности(Периодичность)

	Варианты = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений;
	Если Периодичность = Варианты.Непериодический Тогда
		Возврат "none";
	ИначеЕсли Периодичность = Варианты.Секунда Тогда
		Возврат "second";
	ИначеЕсли Периодичность = Варианты.День Тогда
		Возврат "day";
	ИначеЕсли Периодичность = Варианты.Месяц Тогда
		Возврат "month";
	ИначеЕсли Периодичность = Варианты.Квартал Тогда
		Возврат "quarter";
	ИначеЕсли Периодичность = Варианты.Год Тогда
		Возврат "year";
	ИначеЕсли Периодичность = Варианты.ПозицияРегистратора Тогда
		Возврат "recorder_position";
	КонецЕсли;
	Возврат Строка(Периодичность);

КонецФункции

Функция ПредставлениеТипа(ТекущийТип, ОписаниеТипов)

	Если ТекущийТип = Тип("Строка") Тогда
		Длина = ОписаниеТипов.КвалификаторыСтроки.Длина;
		Возврат ?(Длина = 0, "Строка", СтрШаблон("Строка(%1)", Формат(Длина, "ЧГ=0")));
	ИначеЕсли ТекущийТип = Тип("Число") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Возврат СтрШаблон("Число(%1,%2)",
			Формат(Квалификаторы.Разрядность, "ЧН=0; ЧГ=0"),
			Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=0"));
	ИначеЕсли ТекущийТип = Тип("Дата") Тогда
		Части = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
		Если Части = ЧастиДаты.Дата Тогда
			Возврат "Дата";
		ИначеЕсли Части = ЧастиДаты.Время Тогда
			Возврат "Время";
		КонецЕсли;
		Возврат "ДатаВремя";
	ИначеЕсли ТекущийТип = Тип("Булево") Тогда
		Возврат "Булево";
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоТипу(ТекущийТип);
	Если ОбъектМД <> Неопределено Тогда
		Возврат ОбъектМД.ПолноеИмя();
	КонецЕсли;
	Возврат Строка(ТекущийТип);

КонецФункции


///////////////////////////////////////////////////////////////////////////////
// mcp1c_Метаданные: универсальная интроспекция метаданных конфигурации.
// Работает с любой конфигурацией: сведения берутся из Метаданные во время выполнения.
// Служебные объекты расширения (префикс mcp1c_) и планы обмена не показываются.
// Перечни объектов и полей фильтруются политикой клиента (п. 5.1, 7.4 ТЗ): скрытое
// не показывается. Описания таблиц для запросов (см. ОписаниеТаблицы) строятся по правилам
// языка запросов для каждого вида объекта.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Поддерживаемые виды объектов метаданных в порядке вывода.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Код - Строка - код вида для MCP (catalog, document, ...).
//   * Класс - Строка - первая часть полного имени (Справочник, Документ, ...).
//   * КлассАнгл - Строка - то же на английском (Catalog, Document, ...).
//
Функция ВидыОбъектов() Экспорт

	Виды = Новый Массив;
	ДобавитьВид(Виды, "catalog", "Справочник", "Catalog");
	ДобавитьВид(Виды, "document", "Документ", "Document");
	ДобавитьВид(Виды, "document_journal", "ЖурналДокументов", "DocumentJournal");
	ДобавитьВид(Виды, "enum", "Перечисление", "Enum");
	ДобавитьВид(Виды, "chart_of_characteristic_types", "ПланВидовХарактеристик", "ChartOfCharacteristicTypes");
	ДобавитьВид(Виды, "chart_of_accounts", "ПланСчетов", "ChartOfAccounts");
	ДобавитьВид(Виды, "chart_of_calculation_types", "ПланВидовРасчета", "ChartOfCalculationTypes");
	ДобавитьВид(Виды, "information_register", "РегистрСведений", "InformationRegister");
	ДобавитьВид(Виды, "accumulation_register", "РегистрНакопления", "AccumulationRegister");
	ДобавитьВид(Виды, "accounting_register", "РегистрБухгалтерии", "AccountingRegister");
	ДобавитьВид(Виды, "calculation_register", "РегистрРасчета", "CalculationRegister");
	ДобавитьВид(Виды, "business_process", "БизнесПроцесс", "BusinessProcess");
	ДобавитьВид(Виды, "task", "Задача", "Task");
	ДобавитьВид(Виды, "constant", "Константа", "Constant");
	ДобавитьВид(Виды, "report", "Отчет", "Report");
	Возврат Виды;

КонецФункции

// Коды поддерживаемых видов объектов.
//
// Возвращаемое значение:
//  Массив из Строка - коды видов.
//
Функция КодыВидов() Экспорт

	Результат = Новый Массив;
	Для Каждого Вид Из ВидыОбъектов() Цикл
		Результат.Добавить(Вид.Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Коды разделов описания объекта (аргумент include инструмента describe_object).
//
// Возвращаемое значение:
//  Массив из Строка - коды разделов.
//
Функция КодыРазделов() Экспорт

	Возврат СтрРазделить("properties,standard_attributes,attributes,tabular_sections,dimensions,resources,"
		+ "enum_values,movements,search_fields", ",");

КонецФункции

// Список объектов метаданных с фильтром по видам и строке поиска.
//
// Параметры:
//  Коды - Массив из Строка - коды видов; пустой массив - все виды.
//  СтрокаПоиска - Строка - подстрока имени или синонима (без учета регистра).
//  Смещение - Число - сколько найденных объектов пропустить.
//  Лимит - Число - максимальное количество объектов в ответе.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика - показываются только доступные объекты.
//
// Возвращаемое значение:
//  Структура:
//   * Элементы - Массив из Соответствие - object, kind, synonym.
//   * Всего - Число - количество найденных объектов.
//   * СледующееСмещение - Число, Неопределено - смещение следующей страницы.
//
Функция СписокОбъектов(Коды, Знач СтрокаПоиска, Смещение, Лимит, Политика) Экспорт

	СтрокаПоиска = НРег(СокрЛП(СтрокаПоиска));
	Найденные = Новый Массив;

	Для Каждого Вид Из ВидыОбъектов() Цикл
		Если Коды.Количество() > 0 И Коды.Найти(Вид.Код) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОбъектМД Из КоллекцияВида(Вид.Код) Цикл
			Если Не ОбъектВидимКлиенту(ОбъектМД, Политика) Тогда
				Продолжить;
			КонецЕсли;
			Синоним = СинонимОбъекта(ОбъектМД);
			Если Не СоответствуетПоиску(ОбъектМД.Имя, Синоним, СтрокаПоиска) Тогда
				Продолжить;
			КонецЕсли;
			Элемент = Новый Соответствие;
			Элемент.Вставить("object", ПолноеИмяОбъекта(ОбъектМД));
			Элемент.Вставить("kind", Вид.Код);
			Элемент.Вставить("synonym", Синоним);
			Найденные.Добавить(Элемент);
		КонецЦикла;
	КонецЦикла;

	Элементы = Новый Массив;
	Граница = Мин(Смещение + Лимит, Найденные.Количество());
	Для Индекс = Смещение По Граница - 1 Цикл
		Элементы.Добавить(Найденные[Индекс]);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Элементы", Элементы);
	Результат.Вставить("Всего", Найденные.Количество());
	Результат.Вставить("СледующееСмещение", ?(Граница < Найденные.Количество(), Граница, Неопределено));
	Возврат Результат;

КонецФункции

// Находит объект метаданных по полному имени. Допускаются русские и английские
// имена классов ("Справочник.Контрагенты", "Catalog.Контрагенты"), регистр не важен.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - найденный объект; Неопределено, если объекта нет,
//                                   вид не поддерживается или объект скрыт.
//
Функция НайтиОбъект(Знач ПолноеИмя) Экспорт

	Части = СтрРазделить(СокрЛП(ПолноеИмя), ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вид = ВидПоКлассу(Части[0]);
	Если Вид = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяОбъекта = НРег(Части[1]);
	Для Каждого ОбъектМД Из КоллекцияВида(Вид.Код) Цикл
		Если НРег(ОбъектМД.Имя) = ИмяОбъекта Тогда
			Возврат ?(ЭтоСкрытыйОбъект(ОбъектМД), Неопределено, ОбъектМД);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Описание структуры объекта метаданных для модели. Скрытые политикой поля, табличные части
// и регистры движений не показываются (п. 7.4 ТЗ).
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - описываемый объект, доступный клиенту.
//  Разделы - Массив из Строка - включаемые разделы (см. КодыРазделов); пустой массив - все.
//  МаксимумПолей - Число - ограничение общего количества полей в ответе.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Соответствие - описание объекта (object, kind, name, synonym, properties, attributes, ...).
//
Функция ОписаниеОбъекта(ОбъектМД, Разделы, МаксимумПолей, Политика) Экспорт

	Код = КодВида(ОбъектМД);
	ПолноеИмя = ПолноеИмяОбъекта(ОбъектМД);
	Результат = Новый Соответствие;
	Результат.Вставить("object", ПолноеИмя);
	Результат.Вставить("kind", Код);
	Результат.Вставить("name", ОбъектМД.Имя);
	Результат.Вставить("synonym", СинонимОбъекта(ОбъектМД));
	Если Не ПустаяСтрока(ОбъектМД.Комментарий) Тогда
		Результат.Вставить("comment", ОбъектМД.Комментарий);
	КонецЕсли;

	Контекст = Новый Структура("Количество, Максимум, Обрезано, Политика, Объект, Префикс", 0, МаксимумПолей, Ложь,
		Политика, ПолноеИмя, "");
	Применимые = ПрименимыеРазделы(Код);

	Если РазделНужен(Разделы, Применимые, "properties") Тогда
		Свойства = СвойстваОбъекта(ОбъектМД, Код);
		Если Свойства.Количество() > 0 Тогда
			Результат.Вставить("properties", Свойства);
		КонецЕсли;
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "standard_attributes") Тогда
		ДобавитьПоля(Результат, "standard_attributes", ОписанияСтандартныхРеквизитов(ОбъектМД, Код, Контекст));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "dimensions") Тогда
		ДобавитьПоля(Результат, "dimensions", ОписанияПолей(КоллекцияСвойства(ОбъектМД, "Измерения"), Контекст));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "resources") Тогда
		ДобавитьПоля(Результат, "resources", ОписанияПолей(КоллекцияСвойства(ОбъектМД, "Ресурсы"), Контекст));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "attributes") Тогда
		ДобавитьПоля(Результат, "attributes", ОписанияПолей(КоллекцияСвойства(ОбъектМД, "Реквизиты"), Контекст));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "tabular_sections") Тогда
		ДобавитьПоля(Результат, "tabular_sections", ОписанияТабличныхЧастей(ОбъектМД, Контекст));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "enum_values") Тогда
		ДобавитьПоля(Результат, "enum_values", ОписанияЗначенийПеречисления(ОбъектМД));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "movements") Тогда
		ДобавитьПоля(Результат, "movements", ПолныеИменаОбъектов(КоллекцияСвойства(ОбъектМД, "Движения"), Политика));
	КонецЕсли;
	Если РазделНужен(Разделы, Применимые, "search_fields") Тогда
		ДобавитьПоля(Результат, "search_fields", ДоступныеПоляПоиска(ОбъектМД, Код, Политика));
	КонецЕсли;
	ДобавитьПоля(Результат, "tools", ИнструментыОбъекта(ОбъектМД, Код, Политика));

	Если Контекст.Обрезано Тогда
		Результат.Вставить("truncated", Истина);
		Результат.Вставить("note", СтрШаблон(
			"Показано %1 полів; збільште max_fields або обмежте include", Контекст.Максимум));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Код вида объекта метаданных.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект.
//
// Возвращаемое значение:
//  Строка - код вида; пустая строка, если вид не поддерживается.
//
Функция КодВида(ОбъектМД) Экспорт

	Класс = СтрРазделить(ОбъектМД.ПолноеИмя(), ".")[0]; // имя класса может быть английским
	Вид = ВидПоКлассу(Класс);
	Возврат ?(Вид = Неопределено, "", Вид.Код);

КонецФункции

// Полное имя объекта метаданных с русским именем класса ("Справочник.Контрагенты") - независимо
// от варианта встроенного языка конфигурации. Так имена записываются в профилях, типах полей
// и текстах запросов (язык запросов принимает русские имена классов в любой конфигурации).
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект.
//
// Возвращаемое значение:
//  Строка - полное имя.
//
Функция ПолноеИмяОбъекта(ОбъектМД) Экспорт

	Части = СтрРазделить(ОбъектМД.ПолноеИмя(), ".");
	Вид = ВидПоКлассу(Части[0]);
	Если Вид <> Неопределено Тогда
		Части[0] = Вид.Класс;
	ИначеЕсли НРег(Части[0]) = "exchangeplan" Тогда
		Части[0] = "ПланОбмена";
	КонецЕсли;
	Возврат СтрСоединить(Части, ".");

КонецФункции

// Синоним объекта метаданных на языке сеанса, а если он пуст - имя.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект.
//
// Возвращаемое значение:
//  Строка - синоним или имя.
//
Функция СинонимОбъекта(ОбъектМД) Экспорт

	Синоним = ОбъектМД.Синоним;
	Возврат ?(ПустаяСтрока(Синоним), ОбъектМД.Имя, Синоним);

КонецФункции

// Описание таблицы для разбора путей полей и построения запросов (см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы).
// Поддерживаются таблицы справочников, документов, планов видов характеристик, планов счетов,
// планов видов расчета, бизнес-процессов и задач, их табличные части, основные таблицы регистров
// сведений и накопления, виртуальные таблицы Остатки, Обороты и ОстаткиИОбороты регистров накопления
// и бухгалтерии, СрезПоследних и СрезПервых периодических регистров сведений.
//
// Параметры:
//  ИмяТаблицы - Строка - "Справочник.Контрагенты", "Документ.РеализацияТоваровУслуг.Товары",
//               "РегистрНакопления.ТоварыНаСкладах.Остатки"; регистр букв и язык класса не важны.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание; Неопределено, если таблицы нет, она скрыта или не поддерживается.
//
Функция ОписаниеТаблицы(Знач ИмяТаблицы) Экспорт

	Части = СтрРазделить(СокрЛП(ИмяТаблицы), ".", Ложь);
	Если Части.Количество() < 2 Или Части.Количество() > 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбъектМД = НайтиОбъект(Части[0] + "." + Части[1]);
	Если ОбъектМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Код = КодВида(ОбъектМД);
	Если Части.Количество() = 2 Тогда
		Возврат ОписаниеОсновнойТаблицы(ОбъектМД, Код);
	КонецЕсли;

	Если ОбъектныйВид(Код) Тогда
		Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
			Если НРег(ТабличнаяЧасть.Имя) = НРег(Части[2]) Тогда
				Возврат ОписаниеТабличнойЧасти(ОбъектМД, Код, ТабличнаяЧасть);
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;

	ИмяВиртуальной = ИмяВиртуальнойТаблицы(ОбъектМД, Код, Части[2]);
	Если ИмяВиртуальной = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОписаниеВиртуальнойТаблицы(ОбъектМД, Код, ИмяВиртуальной);

КонецФункции

// Поля, из которых строится представление ссылки на объект (для проверки ПредставлениеДоступно).
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Массив из Строка - имена полей; пустой массив для перечислений и неизвестных объектов.
//
Функция ПоляПредставления(ПолноеИмя) Экспорт

	ОбъектМД = НайтиОбъект(ПолноеИмя);
	Если ОбъектМД = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ПоляПредставленияОбъекта(ОбъектМД, КодВида(ОбъектМД));

КонецФункции

// Все поддерживаемые объекты метаданных, кроме служебных объектов расширения.
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - объекты.
//
Функция ВсеОбъекты() Экспорт

	Результат = Новый Массив;
	Для Каждого Вид Из ВидыОбъектов() Цикл
		Для Каждого ОбъектМД Из КоллекцияВида(Вид.Код) Цикл
			Если Не ЭтоСкрытыйОбъект(ОбъектМД) Тогда
				Результат.Добавить(ОбъектМД);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена типов для разбора путей и проверок политики: Строка, Число, Дата, Булево,
// УникальныйИдентификатор, ХранилищеЗначения или полное имя объекта метаданных.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов - описание типов поля.
//
// Возвращаемое значение:
//  Массив из Строка - имена типов без повторов.
//
Функция ИменаТипов(ОписаниеТипов) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(ОписаниеТипов) <> Тип("ОписаниеТипов") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ТекущийТип Из ОписаниеТипов.Типы() Цикл
		Имя = ИмяТипа(ТекущийТип);
		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строковые представления типов из описания типов.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов - описание типов поля.
//
// Возвращаемое значение:
//  Массив из Строка - например, "Строка(150)", "Число(15,2)", "Справочник.Контрагенты".
//
Функция ПредставленияТипов(ОписаниеТипов) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(ОписаниеТипов) <> Тип("ОписаниеТипов") Тогда
		Возврат Результат;
	КонецЕсли;

	МаксимумТипов = 20;
	Типы = ОписаниеТипов.Типы();
	Для Каждого ТекущийТип Из Типы Цикл
		Если Результат.Количество() >= МаксимумТипов Тогда
			Результат.Добавить(СтрШаблон("... ще %1", Типы.Количество() - МаксимумТипов));
			Прервать;
		КонецЕсли;
		Результат.Добавить(ПредставлениеТипа(ТекущийТип, ОписаниеТипов));
	КонецЦикла;
	Возврат Результат;

КонецФункции


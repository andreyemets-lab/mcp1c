Функция ДоступныеПоляПоиска(ОбъектМД, Код, Политика)

	Результат = Новый Массив;
	Таблица = ОписаниеОсновнойТаблицы(ОбъектМД, Код);
	Если Таблица = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Имя Из Таблица.ПоляПоиска Цикл
		Поле = mcp1c_ПутиПолей.НайтиПоле(Таблица, Имя);
		Если Поле <> Неопределено
			И mcp1c_ПравилаДоступа.ПолеДоступно(Политика, Таблица.Объект, Поле.ПолеПолитики, Поле.Типы) Тогда
			Результат.Добавить(Поле.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИнструментыОбъекта(ОбъектМД, Код, Политика)
	// Инструменты чтения, применимые к объекту и доступные клиенту, - подсказка модели.

	Кандидаты = Новый Массив;
	Если ОбъектныйВид(Код) Тогда
		Кандидаты = СтрРазделить("find_objects,get_object,query_records", ",");
	ИначеЕсли Код = "information_register" Тогда
		Кандидаты.Добавить("query_records");
		Если ЭтоПериодическийРегистрСведений(ОбъектМД) Тогда
			Кандидаты.Добавить("get_slice");
		КонецЕсли;
	ИначеЕсли Код = "accumulation_register" Тогда
		Кандидаты.Добавить("query_records");
		Если ЭтоРегистрОстатков(ОбъектМД) Тогда
			Кандидаты.Добавить("get_balances");
		КонецЕсли;
		Кандидаты.Добавить("get_turnovers");
	ИначеЕсли Код = "accounting_register" Тогда
		Кандидаты.Добавить("get_balances");
		Кандидаты.Добавить("get_turnovers");
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Имя Из Кандидаты Цикл
		Если mcp1c_ПравилаДоступа.ИнструментДоступен(Политика, Имя) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьМестоДляПоля(Контекст)

	Если Контекст.Количество >= Контекст.Максимум Тогда
		Контекст.Обрезано = Истина;
		Возврат Ложь;
	КонецЕсли;
	Контекст.Количество = Контекст.Количество + 1;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ОписанияТаблиц

Функция ОписаниеОсновнойТаблицы(ОбъектМД, Код)
	// Описание основной таблицы объекта; Неопределено для видов, которые не читаются query_records.

	Если ОбъектныйВид(Код) Тогда
		Возврат ОписаниеТаблицыОбъекта(ОбъектМД, Код);
	ИначеЕсли Код = "information_register" Тогда
		Возврат ОписаниеТаблицыРегистраСведений(ОбъектМД);
	ИначеЕсли Код = "accumulation_register" Тогда
		Возврат ОписаниеТаблицыРегистраНакопления(ОбъектМД);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ОписаниеТаблицыОбъекта(ОбъектМД, Код)

	ПолноеИмя = ПолноеИмяОбъекта(ОбъектМД);
	Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы(ПолноеИмя, ПолноеИмя, Код);
	Описание.ЕстьПометкаУдаления = Истина;
	ДобавитьСтандартноеПоле(Описание, "Ссылка", ПолноеИмя);
	ДобавитьСтандартноеПоле(Описание, "ПометкаУдаления", "Булево");

	Если Код = "document" Или Код = "business_process" Или Код = "task" Тогда
		ДобавитьПолеНомера(Описание, ОбъектМД, Код);
		ДобавитьСтандартноеПоле(Описание, "Дата", "Дата");
		Описание.ПолеПериода = "Дата";
	Иначе
		ДобавитьСтандартноеПоле(Описание, "Предопределенный", "Булево");
		ДобавитьПолеКода(Описание, ОбъектМД, Код);
	КонецЕсли;
	Если Код <> "document" И Код <> "business_process" Тогда
		ДобавитьПолеНаименования(Описание, ОбъектМД);
	КонецЕсли;
	ДобавитьСтандартныеПоляВида(Описание, ОбъектМД, Код);
	ДобавитьПоляКоллекции(Описание, ОбъектМД.Реквизиты, "attribute");

	Описание.ПоляПредставления = ПоляПредставленияОбъекта(ОбъектМД, Код);
	Для Каждого Имя Из СтрРазделить("Ссылка,Дата,Номер,Проведен,Код,Наименование,Родитель,Владелец", ",") Цикл
		Если mcp1c_ПутиПолей.НайтиПоле(Описание, Имя) <> Неопределено Тогда
			Описание.КлючевыеПоля.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Если Описание.ПолеПериода = "Дата" Тогда
		Описание.ПоляПорядка.Добавить("Дата");
	КонецЕсли;
	Описание.ПоляПорядка.Добавить("Ссылка");
	ЗаполнитьПоляПоиска(Описание, ОбъектМД);
	Возврат Описание;

КонецФункции

Процедура ДобавитьСтандартныеПоляВида(Описание, ОбъектМД, Код)
	// Стандартные поля, зависящие от вида объекта: проведение документа, иерархия, владельцы,
	// признаки бизнес-процесса и задачи, признаки учета плана счетов.

	ПолноеИмя = Описание.Объект;
	Если Код = "document" Тогда
		Если ОбъектМД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			ДобавитьСтандартноеПоле(Описание, "Проведен", "Булево");
			Описание.ЕстьПроведен = Истина;
		КонецЕсли;
	ИначеЕсли Код = "catalog" Тогда
		ДобавитьПоляСправочника(Описание, ОбъектМД);
	ИначеЕсли Код = "chart_of_characteristic_types" И ОбъектМД.Иерархический Тогда
		ДобавитьСтандартноеПоле(Описание, "Родитель", ПолноеИмя);
		ДобавитьСтандартноеПоле(Описание, "ЭтоГруппа", "Булево");
	ИначеЕсли Код = "chart_of_accounts" Тогда
		ДобавитьСтандартноеПоле(Описание, "Родитель", ПолноеИмя);
		ДобавитьСтандартноеПоле(Описание, "Забалансовый", "Булево");
		Для Каждого Признак Из ОбъектМД.ПризнакиУчета Цикл
			mcp1c_ПутиПолей.ДобавитьПоле(Описание, Признак.Имя, "Булево", "attribute");
		КонецЦикла;
	ИначеЕсли Код = "business_process" Тогда
		ДобавитьСтандартноеПоле(Описание, "Стартован", "Булево");
		ДобавитьСтандартноеПоле(Описание, "Завершен", "Булево");
	ИначеЕсли Код = "task" Тогда
		ДобавитьСтандартноеПоле(Описание, "Выполнена", "Булево");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоляСправочника(Описание, ОбъектМД)
	// Иерархия и владельцы справочника.

	Если ОбъектМД.Иерархический Тогда
		ДобавитьСтандартноеПоле(Описание, "Родитель", Описание.Объект);
		Если ОбъектМД.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			ДобавитьСтандартноеПоле(Описание, "ЭтоГруппа", "Булево");
		КонецЕсли;
	КонецЕсли;
	Владельцы = ПолныеИменаОбъектов(ОбъектМД.Владельцы);
	Если Владельцы.Количество() > 0 Тогда
		ДобавитьСтандартноеПоле(Описание, "Владелец", Владельцы);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПолеКода(Описание, ОбъектМД, Код)

	Если ОбъектМД.ДлинаКода > 0 Тогда
		ТипКода = ТипКодаИлиНомера(ОбъектМД, Код, Ложь);
		mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Код", ТипКода, "standard",
			?(ТипКода = "Строка", ОбъектМД.ДлинаКода, 0));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПолеНомера(Описание, ОбъектМД, Код)

	Если ОбъектМД.ДлинаНомера > 0 Тогда
		ТипНомера = ТипКодаИлиНомера(ОбъектМД, Код, Истина);
		mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Номер", ТипНомера, "standard",
			?(ТипНомера = "Строка", ОбъектМД.ДлинаНомера, 0));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПолеНаименования(Описание, ОбъектМД)

	Попытка
		Длина = ОбъектМД.ДлинаНаименования;
	Исключение
		Длина = 0;
	КонецПопытки;
	Если Длина > 0 Тогда
		mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Наименование", "Строка", "standard", Длина);
	КонецЕсли;

КонецПроцедуры

Функция ТипКодаИлиНомера(ОбъектМД, Код, ЭтоНомер)
	// "Число" или "Строка" для кода справочника или номера документа, бизнес-процесса, задачи.

	СвойстваОбъектов = Метаданные.СвойстваОбъектов;
	Попытка
		Если Код = "catalog" И Не ЭтоНомер Тогда
			ЭтоЧисло = (ОбъектМД.ТипКода = СвойстваОбъектов.ТипКодаСправочника.Число);
		ИначеЕсли Код = "document" Тогда
			ЭтоЧисло = (ОбъектМД.ТипНомера = СвойстваОбъектов.ТипНомераДокумента.Число);
		ИначеЕсли Код = "business_process" Тогда
			ЭтоЧисло = (ОбъектМД.ТипНомера = СвойстваОбъектов.ТипНомераБизнесПроцесса.Число);
		ИначеЕсли Код = "task" Тогда
			ЭтоЧисло = (ОбъектМД.ТипНомера = СвойстваОбъектов.ТипНомераЗадачи.Число);
		Иначе
			ЭтоЧисло = Ложь; // коды планов видов характеристик, счетов и видов расчета - строки
		КонецЕсли;
	Исключение
		ЭтоЧисло = Ложь;
	КонецПопытки;
	Возврат ?(ЭтоЧисло, "Число", "Строка");

КонецФункции

Функция ПоляПредставленияОбъекта(ОбъектМД, Код)

	Результат = Новый Массив;
	Если Код = "document" Или Код = "business_process" Или Код = "task" Тогда
		Если ОбъектМД.ДлинаНомера > 0 Тогда
			Результат.Добавить("Номер");
		КонецЕсли;
		Результат.Добавить("Дата");
		Если Код = "task" И ОбъектМД.ДлинаНаименования > 0 Тогда
			Результат.Добавить("Наименование");
		КонецЕсли;
	ИначеЕсли ОбъектныйВид(Код) Тогда
		Если ОбъектМД.ДлинаКода > 0 Тогда
			Результат.Добавить("Код");
		КонецЕсли;
		Если ОбъектМД.ДлинаНаименования > 0 Тогда
			Результат.Добавить("Наименование");
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ЗаполнитьПоляПоиска(Описание, ОбъектМД)

	Кандидаты = Новый Массив;
	Коллекция = КоллекцияСвойства(ОбъектМД, "ВводПоСтроке");
	Если Коллекция <> Неопределено Тогда
		Для Каждого ПолеМД Из Коллекция Цикл
			Кандидаты.Добавить(ПолеМД.Имя);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Наименование,Код,Номер", ",") Цикл
		Кандидаты.Добавить(Имя);
	КонецЦикла;
	Для Каждого Имя Из Кандидаты Цикл
		Поле = mcp1c_ПутиПолей.НайтиПоле(Описание, Имя);
		Если Поле <> Неопределено И Описание.ПоляПоиска.Найти(Поле.Имя) = Неопределено Тогда
			Описание.ПоляПоиска.Добавить(Поле.Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеТабличнойЧасти(ОбъектМД, Код, ТабличнаяЧасть)

	ПолноеИмя = ПолноеИмяОбъекта(ОбъектМД);
	Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы(ПолноеИмя + "." + ТабличнаяЧасть.Имя, ПолноеИмя, Код,
		"tabular_section");
	Описание.ПрефиксПолейПолитики = ТабличнаяЧасть.Имя + ".";
	Описание.ЕстьПометкаУдаления = Истина;
	ДобавитьСтандартноеПоле(Описание, "Ссылка", ПолноеИмя);
	ДобавитьСтандартноеПоле(Описание, "НомерСтроки", "Число");
	ДобавитьПоляКоллекции(Описание, ТабличнаяЧасть.Реквизиты, "attribute");

	Если Код = "document" Тогда
		Описание.ЕстьПроведен = (ОбъектМД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить);
	КонецЕсли;
	Если Код = "document" Или Код = "business_process" Или Код = "task" Тогда
		Описание.ПолеПериода = "Ссылка.Дата";
	КонецЕсли;
	Описание.КлючевыеПоля.Добавить("Ссылка");
	Описание.КлючевыеПоля.Добавить("НомерСтроки");
	Описание.ПоляПорядка.Добавить("Ссылка");
	Описание.ПоляПорядка.Добавить("НомерСтроки");
	Возврат Описание;

КонецФункции

Функция ОписаниеТаблицыРегистраСведений(ОбъектМД)

	ПолноеИмя = ПолноеИмяОбъекта(ОбъектМД);
	Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы(ПолноеИмя, ПолноеИмя, "information_register", "register");
	Периодический = ЭтоПериодическийРегистрСведений(ОбъектМД);
	Подчиненный = (ОбъектМД.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору);
	Если Периодический Тогда
		ДобавитьСтандартноеПоле(Описание, "Период", "Дата");
		Описание.ПолеПериода = "Период";
		Описание.КлючевыеПоля.Добавить("Период");
		Описание.ПоляПорядка.Добавить("Период");
	КонецЕсли;
	Если Подчиненный Тогда
		ДобавитьПоляЗаписейРегистратора(Описание, ОбъектМД);
	КонецЕсли;
	ДобавитьПоляКоллекции(Описание, ОбъектМД.Измерения, "dimension");
	ДобавитьПоляКоллекции(Описание, ОбъектМД.Ресурсы, "resource");
	ДобавитьПоляКоллекции(Описание, ОбъектМД.Реквизиты, "attribute");

	Для Каждого ИзмерениеМД Из ОбъектМД.Измерения Цикл
		Описание.КлючевыеПоля.Добавить(ИзмерениеМД.Имя);
		Если Не Подчиненный Тогда
			Описание.ПоляПорядка.Добавить(ИзмерениеМД.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Описание;

КонецФункции

Функция ОписаниеТаблицыРегистраНакопления(ОбъектМД)

	ПолноеИмя = ПолноеИмяОбъекта(ОбъектМД);
	Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы(ПолноеИмя, ПолноеИмя, "accumulation_register", "register");
	Описание.ВидРегистра = ?(ЭтоРегистрОстатков(ОбъектМД), "balance", "turnovers");
	ДобавитьСтандартноеПоле(Описание, "Период", "Дата");
	Описание.ПолеПериода = "Период";
	Описание.КлючевыеПоля.Добавить("Период");
	Описание.ПоляПорядка.Добавить("Период");
	ДобавитьПоляЗаписейРегистратора(Описание, ОбъектМД);
	Если Описание.ВидРегистра = "balance" Тогда
		ДобавитьСтандартноеПоле(Описание, "ВидДвижения", "ВидДвиженияНакопления");
		Описание.КлючевыеПоля.Добавить("ВидДвижения");
	КонецЕсли;
	ДобавитьПоляКоллекции(Описание, ОбъектМД.Измерения, "dimension");
	ДобавитьПоляКоллекции(Описание, ОбъектМД.Ресурсы, "resource");
	ДобавитьПоляКоллекции(Описание, ОбъектМД.Реквизиты, "attribute");
	Для Каждого ИзмерениеМД Из ОбъектМД.Измерения Цикл
		Описание.КлючевыеПоля.Добавить(ИзмерениеМД.Имя);
	КонецЦикла;
	Возврат Описание;

КонецФункции

Процедура ДобавитьПоляЗаписейРегистратора(Описание, ОбъектМД)
	// Регистратор, номер строки и активность записей регистра, подчиненного регистратору.

	ДобавитьСтандартноеПоле(Описание, "Регистратор", ТипыРегистраторов(ОбъектМД));
	ДобавитьСтандартноеПоле(Описание, "НомерСтроки", "Число");
	ДобавитьСтандартноеПоле(Описание, "Активность", "Булево");
	Описание.ЕстьАктивность = Истина;
	Описание.КлючевыеПоля.Добавить("Регистратор");
	Описание.ПоляПорядка.Добавить("Регистратор");
	Описание.ПоляПорядка.Добавить("НомерСтроки");

КонецПроцедуры

Функция ТипыРегистраторов(РегистрМД)
	// Документы, которые пишут движения в регистр.

	Результат = Новый Массив;
	Для Каждого ДокументМД Из Метаданные.Документы Цикл
		Если ДокументМД.Движения.Содержит(РегистрМД) И Не ЭтоСкрытыйОбъект(ДокументМД) Тогда
			Результат.Добавить(ПолноеИмяОбъекта(ДокументМД));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИмяВиртуальнойТаблицы(ОбъектМД, Код, Знач Имя)
	// Каноническое имя виртуальной таблицы регистра; Неопределено, если у регистра ее нет.

	Имя = НРег(СокрЛП(Имя));
	Синонимы = Новый Соответствие;
	Синонимы.Вставить("balance", "остатки");
	Синонимы.Вставить("turnovers", "обороты");
	Синонимы.Вставить("balanceandturnovers", "остаткииобороты");
	Синонимы.Вставить("slicelast", "срезпоследних");
	Синонимы.Вставить("slicefirst", "срезпервых");
	Если Синонимы.Получить(Имя) <> Неопределено Тогда
		Имя = Синонимы.Получить(Имя);
	КонецЕсли;

	Доступные = Новый Массив;
	Если Код = "information_register" И ЭтоПериодическийРегистрСведений(ОбъектМД) Тогда
		Доступные = СтрРазделить("СрезПоследних,СрезПервых", ",");
	ИначеЕсли Код = "accumulation_register" Тогда
		Если ЭтоРегистрОстатков(ОбъектМД) Тогда
			Доступные = СтрРазделить("Остатки,Обороты,ОстаткиИОбороты", ",");
		Иначе
			Доступные.Добавить("Обороты");
		КонецЕсли;
	ИначеЕсли Код = "accounting_register" Тогда
		Доступные = СтрРазделить("Остатки,Обороты,ОстаткиИОбороты", ",");
	КонецЕсли;
	Для Каждого Вариант Из Доступные Цикл
		Если НРег(Вариант) = Имя Тогда
			Возврат Вариант;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ОписаниеВиртуальнойТаблицы(ОбъектМД, Код, ИмяВиртуальной)

	ПолноеИмя = ПолноеИмяОбъекта(ОбъектМД);
	Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы(ПолноеИмя + "." + ИмяВиртуальной, ПолноеИмя, Код, "virtual");
	Описание.ВиртуальнаяТаблица = ИмяВиртуальной;

	Если Код = "information_register" Тогда
		ДобавитьСтандартноеПоле(Описание, "Период", "Дата");
		Описание.КлючевыеПоля.Добавить("Период");
		ДобавитьПоляКоллекции(Описание, ОбъектМД.Измерения, "dimension");
		ДобавитьПоляКоллекции(Описание, ОбъектМД.Ресурсы, "resource");
		ДобавитьПоляКоллекции(Описание, ОбъектМД.Реквизиты, "attribute");
		Для Каждого ИзмерениеМД Из ОбъектМД.Измерения Цикл
			Описание.КлючевыеПоля.Добавить(ИзмерениеМД.Имя);
			Описание.ПоляПорядка.Добавить(ИзмерениеМД.Имя);
		КонецЦикла;
		Если Описание.ПоляПорядка.Количество() = 0 Тогда
			Описание.ПоляПорядка.Добавить("Период");
		КонецЕсли;
		Возврат Описание;
	КонецЕсли;

	Если ИмяВиртуальной <> "Остатки" Тогда
		mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Период", "Дата", "period");
	КонецЕсли;
	Если Код = "accounting_register" Тогда
		ДобавитьПоляСчетов(Описание, ОбъектМД, ИмяВиртуальной);
	Иначе
		Описание.ВидРегистра = ?(ЭтоРегистрОстатков(ОбъектМД), "balance", "turnovers");
	КонецЕсли;
	ДобавитьПоляКоллекции(Описание, ОбъектМД.Измерения, "dimension");

	Для Каждого РесурсМД Из ОбъектМД.Ресурсы Цикл
		Для Каждого Показатель Из ПоказателиРесурса(Код, ИмяВиртуальной, Описание.ВидРегистра) Цикл
			Поле = mcp1c_ПутиПолей.ДобавитьПоле(Описание, РесурсМД.Имя + Показатель, "Число", "resource", 0, РесурсМД.Имя);
			Поле.Показатель = Показатель;
		КонецЦикла;
	КонецЦикла;
	Возврат Описание;

КонецФункции

Процедура ДобавитьПоляСчетов(Описание, ОбъектМД, ИмяВиртуальной)
	// Счет и субконто виртуальной таблицы регистра бухгалтерии; для оборотов регистра
	// с корреспонденцией - корреспондирующий счет и субконто.

	ПланСчетовМД = ОбъектМД.ПланСчетов;
	ИмяПланаСчетов = ПолноеИмяОбъекта(ПланСчетовМД);
	Описание.ПланСчетов = ИмяПланаСчетов;
	ДобавитьСтандартноеПоле(Описание, "Счет", ИмяПланаСчетов);

	ТипыСубконто = Новый Массив;
	Если ПланСчетовМД.ВидыСубконто <> Неопределено Тогда
		ТипыСубконто = ИменаТипов(ПланСчетовМД.ВидыСубконто.Тип);
	КонецЕсли;
	Количество = ?(ТипыСубконто.Количество() = 0, 0, ПланСчетовМД.МаксКоличествоСубконто);
	Для Номер = 1 По Количество Цикл
		mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Субконто" + Формат(Номер, "ЧГ=0"), ТипыСубконто, "dimension");
	КонецЦикла;

	Если ИмяВиртуальной = "Обороты" И ОбъектМД.Корреспонденция Тогда
		ДобавитьСтандартноеПоле(Описание, "КорСчет", ИмяПланаСчетов);
		Для Номер = 1 По Количество Цикл
			ДобавитьСтандартноеПоле(Описание, "КорСубконто" + Формат(Номер, "ЧГ=0"), ТипыСубконто);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ПоказателиРесурса(Код, ИмяВиртуальной, ВидРегистра)
	// Суффиксы полей ресурса в виртуальной таблице.

	Если Код = "accounting_register" Тогда
		Если ИмяВиртуальной = "Остатки" Тогда
			Возврат СтрРазделить("ОстатокДт,ОстатокКт", ",");
		ИначеЕсли ИмяВиртуальной = "Обороты" Тогда
			Возврат СтрРазделить("ОборотДт,ОборотКт", ",");
		КонецЕсли;
		Возврат СтрРазделить("НачальныйОстатокДт,НачальныйОстатокКт,ОборотДт,ОборотКт,КонечныйОстатокДт,КонечныйОстатокКт", ",");
	КонецЕсли;

	Если ИмяВиртуальной = "Остатки" Тогда
		Возврат СтрРазделить("Остаток", ",");
	ИначеЕсли ИмяВиртуальной = "Обороты" Тогда
		Возврат ?(ВидРегистра = "balance", СтрРазделить("Приход,Расход,Оборот", ","), СтрРазделить("Оборот", ","));
	КонецЕсли;
	Возврат СтрРазделить("НачальныйОстаток,Приход,Расход,КонечныйОстаток", ",");

КонецФункции

Процедура ДобавитьСтандартноеПоле(Описание, Имя, Типы)

	mcp1c_ПутиПолей.ДобавитьПоле(Описание, Имя, Типы, "standard");

КонецПроцедуры

Процедура ДобавитьПоляКоллекции(Описание, Коллекция, Роль)
	// Поля коллекции метаданных (реквизиты, измерения, ресурсы) с типами и длиной строки.

	Для Каждого ПолеМД Из Коллекция Цикл
		Типы = ИменаТипов(ПолеМД.Тип);
		Длина = 0;
		Если Типы.Найти("Строка") <> Неопределено Тогда
			Длина = ПолеМД.Тип.КвалификаторыСтроки.Длина;
		КонецЕсли;
		mcp1c_ПутиПолей.ДобавитьПоле(Описание, ПолеМД.Имя, Типы, Роль, Длина);
	КонецЦикла;

КонецПроцедуры

Функция ИмяТипа(ТекущийТип)

	Простые = СтрРазделить("Строка,Число,Дата,Булево,УникальныйИдентификатор,ХранилищеЗначения,ДвоичныеДанные", ",");
	Для Каждого Имя Из Простые Цикл
		Если ТекущийТип = Тип(Имя) Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	ОбъектМД = Метаданные.НайтиПоТипу(ТекущийТип);
	Если ОбъектМД <> Неопределено Тогда
		Возврат ПолноеИмяОбъекта(ОбъектМД);
	КонецЕсли;
	// Системные перечисления и прочие типы: без точки, чтобы не считаться ссылкой.
	Возврат СтрЗаменить(Строка(ТекущийТип), ".", " ");

КонецФункции

Функция ПредставленияТиповПоля(Поле)

	Результат = Новый Массив;
	Для Каждого Имя Из Поле.Типы Цикл
		Если Имя = "Строка" И Поле.ДлинаСтроки > 0 Тогда
			Результат.Добавить(СтрШаблон("Строка(%1)", Формат(Поле.ДлинаСтроки, "ЧГ=0")));
		Иначе
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОбъектныйВид(Код)

	Возврат СтрРазделить("catalog,document,chart_of_characteristic_types,chart_of_accounts,"
		+ "chart_of_calculation_types,business_process,task", ",").Найти(Код) <> Неопределено;

КонецФункции

Функция ЭтоПериодическийРегистрСведений(ОбъектМД)

	Возврат ОбъектМД.ПериодичностьРегистраСведений
		<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;

КонецФункции

Функция ЭтоРегистрОстатков(ОбъектМД)

	Возврат ОбъектМД.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;

КонецФункции

#КонецОбласти

#Область СвойстваВидов

Функция СвойстваОбъекта(ОбъектМД, Код)

	Свойства = Новый Соответствие;
	Попытка
		ЗаполнитьСвойстваВида(Свойства, ОбъектМД, Код);
	Исключение
		// Свойство недоступно в этой версии платформы: описание остается без него.
		Свойства.Вставить("properties_incomplete", Истина);
	КонецПопытки;
	Возврат Свойства;

КонецФункции

Процедура ЗаполнитьСвойстваВида(Свойства, ОбъектМД, Код)

	Если Код = "catalog" Тогда
		ЗаполнитьСвойстваСправочника(Свойства, ОбъектМД);
	ИначеЕсли Код = "document" Тогда
		Свойства.Вставить("posting_allowed",
			ОбъектМД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить);
	ИначеЕсли СтрЗаканчиваетсяНа(Код, "_register") Тогда
		ЗаполнитьСвойстваРегистра(Свойства, ОбъектМД, Код);
	ИначеЕсли Код = "chart_of_accounts" Тогда
		Свойства.Вставить("max_subconto", ОбъектМД.МаксКоличествоСубконто);
		ДобавитьПолноеИмя(Свойства, "subconto_types", ОбъектМД.ВидыСубконто);
		Свойства.Вставить("accounting_flags", ИменаОбъектов(ОбъектМД.ПризнакиУчета));
	ИначеЕсли Код = "chart_of_characteristic_types" Тогда
		Свойства.Вставить("value_types", ПредставленияТипов(ОбъектМД.Тип));
	ИначеЕсли Код = "document_journal" Тогда
		Свойства.Вставить("documents", ПолныеИменаОбъектов(ОбъектМД.РегистрируемыеДокументы));
		Свойства.Вставить("columns", ИменаОбъектов(ОбъектМД.Графы));
	ИначеЕсли Код = "constant" Тогда
		Свойства.Вставить("types", ПредставленияТипов(ОбъектМД.Тип));
	ИначеЕсли Код = "report" Тогда
		Свойства.Вставить("has_main_dcs_schema", ОбъектМД.ОсновнаяСхемаКомпоновкиДанных <> Неопределено);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСвойстваРегистра(Свойства, ОбъектМД, Код)

	СвойстваОбъектов = Метаданные.СвойстваОбъектов;
	Если Код = "information_register" Тогда
		Свойства.Вставить("periodicity", КодПериодичности(ОбъектМД.ПериодичностьРегистраСведений));
		Свойства.Вставить("write_mode", ?(ОбъектМД.РежимЗаписи
			= СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору, "recorder", "independent"));
	ИначеЕсли Код = "accumulation_register" Тогда
		Свойства.Вставить("register_type", ?(ОбъектМД.ВидРегистра
			= СвойстваОбъектов.ВидРегистраНакопления.Остатки, "balance", "turnovers"));
	ИначеЕсли Код = "accounting_register" Тогда
		ДобавитьПолноеИмя(Свойства, "chart_of_accounts", ОбъектМД.ПланСчетов);
		Свойства.Вставить("correspondence", ОбъектМД.Корреспонденция);
	ИначеЕсли Код = "calculation_register" Тогда
		ДобавитьПолноеИмя(Свойства, "chart_of_calculation_types", ОбъектМД.ПланВидовРасчета);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПолноеИмя(Свойства, Ключ, ОбъектМД)

	Если ОбъектМД <> Неопределено Тогда
		Свойства.Вставить(Ключ, ПолноеИмяОбъекта(ОбъектМД));
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСвойстваСправочника(Свойства, ОбъектМД)

	Свойства.Вставить("hierarchical", ОбъектМД.Иерархический);
	Если ОбъектМД.Иерархический Тогда
		Свойства.Вставить("hierarchy_type", ?(ОбъектМД.ВидИерархии
			= Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов, "folders_and_items", "items"));
	КонецЕсли;
	Владельцы = ПолныеИменаОбъектов(ОбъектМД.Владельцы);
	Если Владельцы.Количество() > 0 Тогда
		Свойства.Вставить("owners", Владельцы);
	КонецЕсли;
	Свойства.Вставить("code_length", ОбъектМД.ДлинаКода);
	Свойства.Вставить("description_length", ОбъектМД.ДлинаНаименования);

КонецПроцедуры

Функция КодПериодичности(Периодичность)

	Варианты = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений;
	Если Периодичность = Варианты.Непериодический Тогда
		Возврат "none";
	ИначеЕсли Периодичность = Варианты.Секунда Тогда
		Возврат "second";
	ИначеЕсли Периодичность = Варианты.День Тогда
		Возврат "day";
	ИначеЕсли Периодичность = Варианты.Месяц Тогда
		Возврат "month";
	ИначеЕсли Периодичность = Варианты.Квартал Тогда
		Возврат "quarter";
	ИначеЕсли Периодичность = Варианты.Год Тогда
		Возврат "year";
	ИначеЕсли Периодичность = Варианты.ПозицияРегистратора Тогда
		Возврат "recorder_position";
	КонецЕсли;
	Возврат Строка(Периодичность);

КонецФункции

Функция ПредставлениеТипа(ТекущийТип, ОписаниеТипов)

	Если ТекущийТип = Тип("Строка") Тогда
		Длина = ОписаниеТипов.КвалификаторыСтроки.Длина;
		Возврат ?(Длина = 0, "Строка", СтрШаблон("Строка(%1)", Формат(Длина, "ЧГ=0")));
	ИначеЕсли ТекущийТип = Тип("Число") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Возврат СтрШаблон("Число(%1,%2)",
			Формат(Квалификаторы.Разрядность, "ЧН=0; ЧГ=0"),
			Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=0"));
	ИначеЕсли ТекущийТип = Тип("Дата") Тогда
		Части = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
		Если Части = ЧастиДаты.Дата Тогда
			Возврат "Дата";
		ИначеЕсли Части = ЧастиДаты.Время Тогда
			Возврат "Время";
		КонецЕсли;
		Возврат "ДатаВремя";
	ИначеЕсли ТекущийТип = Тип("Булево") Тогда
		Возврат "Булево";
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоТипу(ТекущийТип);
	Если ОбъектМД <> Неопределено Тогда
		Возврат ПолноеИмяОбъекта(ОбъектМД);
	КонецЕсли;
	Возврат Строка(ТекущийТип);

КонецФункции


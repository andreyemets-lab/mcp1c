///////////////////////////////////////////////////////////////////////////////
// mcp1c_ВыполнениеЗапросов: выполнение запросов к данным ИБ (п. 3.2 шаг 8, 7.2 ТЗ).
//
// Модель B: технический пользователь публикации не имеет прав на прикладные данные,
// запрос выполняется в привилегированном режиме, который включается только на время
// Запрос.Выполнить(). Тексты запросов строит только mcp1c_КонструкторЗапросов из проверенной
// спецификации; значения передаются только параметрами.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет запрос по спецификации.
//
// Параметры:
//  Спецификация - см. mcp1c_КонструкторЗапросов.НоваяСпецификация
//  ЗначенияПараметров - Соответствие из КлючИЗначение - имя параметра и значение.
//
// Возвращаемое значение:
//  РезультатЗапроса - результат.
//
Функция ВыполнитьЗапрос(Спецификация, ЗначенияПараметров) Экспорт

	Запрос = Новый Запрос(mcp1c_КонструкторЗапросов.ТекстЗапроса(Спецификация));
	Для Каждого Элемент Из ЗначенияПараметров Цикл
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Возврат ВыполнитьПривилегированно(Запрос);

КонецФункции

// Выполняет подготовленный запрос в привилегированном режиме и сразу выключает режим.
//
// Параметры:
//  Запрос - Запрос - запрос с текстом от mcp1c_КонструкторЗапросов или с фиксированным текстом модуля.
//
// Возвращаемое значение:
//  РезультатЗапроса - результат.
//
Функция ВыполнитьПривилегированно(Запрос) Экспорт

	// Модель B (п. 7.2 ТЗ): права на данные проверяет политика клиента, не роль технического пользователя.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	Возврат Результат;

КонецФункции

// Выполняет схему компоновки данных пользовательского инструмента (п. 5.5 ТЗ) с настройками
// по умолчанию в привилегированном режиме. Внешние функции (вызовы общих модулей
// из выражений схемы) запрещены.
//
// Параметры:
//  ТекстСхемы - Строка - схема компоновки данных в XML.
//  Параметры - Соответствие из КлючИЗначение - имя параметра схемы и значение; массив передается
//              списком значений.
//
// Возвращаемое значение:
//  ТаблицаЗначений - результат компоновки.
//
Функция ВыполнитьКомпоновку(ТекстСхемы, Параметры) Экспорт

	Схема = СхемаКомпоновкиИзXML(ТекстСхемы);
	Настройки = Схема.НастройкиПоУмолчанию;
	Для Каждого Элемент Из Параметры Цикл
		Значение = Элемент.Значение;
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Список = Новый СписокЗначений;
			Список.ЗагрузитьЗначения(Значение);
			Значение = Список;
		КонецЕсли;
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Элемент.Ключ, Значение);
	КонецЦикла;

	Таблица = Новый ТаблицаЗначений;
	// Модель B (п. 7.2 ТЗ): права на данные проверяет политика клиента, не роль технического пользователя.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
		Макет = Компоновщик.Выполнить(Схема, Настройки, , ,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(Макет, , , Ложь);
		Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		Вывод.УстановитьОбъект(Таблица);
		Вывод.Вывести(Процессор);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	Возврат Таблица;

КонецФункции

// Вызывает метод пользовательского инструмента: экспортную функцию серверного общего модуля
// Функция(Параметры, Контекст) (п. 5.5 ТЗ). Вызов идет в привилегированном режиме внутри
// транзакции, которая всегда отменяется: изменения данных, если метод их сделал, не сохраняются.
//
// Параметры:
//  ИмяМодуля - Строка - имя общего модуля.
//  ИмяМетода - Строка - имя экспортной функции.
//  Параметры - Структура - значения параметров по именам.
//  КонтекстВызова - Структура - сведения о вызове для метода.
//
// Возвращаемое значение:
//  Произвольный - результат функции.
//
Функция ВызватьМетодМодуля(ИмяМодуля, ИмяМетода, Параметры, КонтекстВызова) Экспорт

	МодульМД = МодульДляВызова(ИмяМодуля);
	Если МодульМД = Неопределено Или Не mcp1c_Служебный.ЭтоИдентификатор(ИмяМетода) Тогда
		ВызватьИсключение СтрШаблон("Метод %1.%2 недоступен для вызова: нужен серверный неглобальный общий модуль",
			ИмяМодуля, ИмяМетода);
	КонецЕсли;
	// Имя модуля взято из метаданных, имя метода - идентификатор: в выражение не попадает ничего
	// от модели; ее аргументы передаются только значениями в Параметры.
	Выражение = МодульМД.Имя + "." + ИмяМетода + "(Параметры, КонтекстВызова)";

	// BSLLS:SetPrivilegedMode-off
	// BSLLS:ExecuteExternalCodeInCommonModule-off
	// BSLLS:PairingBrokenTransaction-off
	// BSLLS:WrongUseOfRollbackTransactionMethod-off
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		// Безопасный режим не включается намеренно: в нем отключается привилегированный режим, без которого
		// технический пользователь не читает прикладные данные (модель B). Выражение собрано из имени модуля
		// из метаданных и идентификатора метода; аргументы модели передаются только значениями.
		// @skip-check server-execution-safe-mode
		Результат = Вычислить(Выражение);
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:WrongUseOfRollbackTransactionMethod-on
	// BSLLS:PairingBrokenTransaction-on
	// BSLLS:ExecuteExternalCodeInCommonModule-on
	// BSLLS:SetPrivilegedMode-on
	Возврат Результат;

КонецФункции

// Схема компоновки данных из XML.
//
// Параметры:
//  ТекстСхемы - Строка - схема компоновки данных в XML.
//
// Возвращаемое значение:
//  СхемаКомпоновкиДанных - схема; при некорректном XML - исключение.
//
Функция СхемаКомпоновкиИзXML(ТекстСхемы) Экспорт

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстСхемы);
	Схема = СериализаторXDTO.ПрочитатьXML(Чтение, Тип("СхемаКомпоновкиДанных"));
	Чтение.Закрыть();
	Возврат Схема;

КонецФункции

// Общий модуль, функцию которого может вызвать пользовательский инструмент: серверный
// и не глобальный.
//
// Параметры:
//  ИмяМодуля - Строка - имя общего модуля.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - модуль; Неопределено, если такого модуля нет или он не подходит.
//
Функция МодульДляВызова(ИмяМодуля) Экспорт

	Если ТипЗнч(ИмяМодуля) <> Тип("Строка") Или ПустаяСтрока(ИмяМодуля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МодульМД = Метаданные.ОбщиеМодули.Найти(СокрЛП(ИмяМодуля));
	Если МодульМД = Неопределено Или Не МодульМД.Сервер Или МодульМД.Глобальный Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат МодульМД;

КонецФункции

#КонецОбласти

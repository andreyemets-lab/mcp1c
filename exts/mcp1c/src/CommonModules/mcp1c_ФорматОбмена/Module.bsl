///////////////////////////////////////////////////////////////////////////////
// mcp1c_ФорматОбмена: формат JSON выгрузки и загрузки настроек MCP-сервера (п. 5.5, 9.2 ТЗ) -
// профили доступа, пользовательские инструменты, промпты, инструкции, глоссарий и глобальные
// запреты. Токены, клиенты, секреты и привязка к ИБ не выгружаются.
//
// Документ:
//  {"format": "mcp1c.settings", "formatVersion": 1, "exportedAt": "...", "source": {...},
//   "settings": {"instructions", "glossary", "bannedFieldPatterns", "bannedObjectPatterns"},
//   "profiles": [...], "tools": [...], "prompts": [...]}
// Ключа settings.* нет - настройка при загрузке не меняется. Профили, инструменты и промпты
// сопоставляются по имени: найденные заменяются целиком, остальные создаются.
// Модуль проверяет документ и приводит его к каноническому виду (значения по умолчанию, коды в нижнем
// регистре, строки без пробелов по краям); чтение и запись справочников - mcp1c_ОбменНастройками.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Имя формата в поле format.
//
// Возвращаемое значение:
//  Строка - mcp1c.settings.
//
Функция ИмяФормата() Экспорт

	Возврат "mcp1c.settings";

КонецФункции

// Версия формата, которую выгружает и понимает сервер.
//
// Возвращаемое значение:
//  Число - версия.
//
Функция ВерсияФормата() Экспорт

	Возврат 1;

КонецФункции

// Разбирает и проверяет документ загрузки, приводит его к каноническому виду.
//
// Параметры:
//  Документ - Произвольный - разобранный JSON (Соответствие).
//
// Возвращаемое значение:
//  Структура:
//   * Документ - Соответствие из КлючИЗначение - канонический документ: format, formatVersion, settings,
//                profiles, tools, prompts.
//   * Ошибки - Массив из Строка - ошибки с путем к значению; документ с ошибками не загружается.
//   * ВнешниеПрофили - Массив из Строка - профили, на которые ссылаются инструменты и промпты, но которых
//                      нет в документе (должны быть в базе).
//
Функция РазобратьДокумент(Документ) Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Документ", Новый Соответствие);
	Итог.Вставить("Ошибки", Новый Массив);
	Итог.Вставить("ВнешниеПрофили", Новый Массив);
	Если ТипЗнч(Документ) <> Тип("Соответствие") Тогда
		Итог.Ошибки.Добавить("Очікується об'єкт JSON з налаштуваннями mcp1c");
		Возврат Итог;
	КонецЕсли;
	Ошибки = Итог.Ошибки;
	Если Документ.Получить("format") <> ИмяФормата() Тогда
		Ошибки.Добавить(СтрШаблон("format: очікується ""%1"" - це не файл налаштувань mcp1c", ИмяФормата()));
		Возврат Итог;
	КонецЕсли;
	Версия = Документ.Получить("formatVersion");
	Если ТипЗнч(Версия) <> Тип("Число") Или Версия < 1 Тогда
		Ошибки.Добавить("formatVersion: очікується число від 1");
		Возврат Итог;
	ИначеЕсли Версия > ВерсияФормата() Тогда
		Ошибки.Добавить(СтрШаблон("formatVersion: файл версії %1, сервер розуміє версію до %2 - оновіть розширення",
			Формат(Версия, "ЧН=0; ЧГ=0"), ВерсияФормата()));
		Возврат Итог;
	КонецЕсли;

	Результат = Итог.Документ;
	Результат.Вставить("format", ИмяФормата());
	Результат.Вставить("formatVersion", ВерсияФормата());
	Результат.Вставить("settings", РазобратьНастройки(Документ.Получить("settings"), Ошибки));
	Профили = РазобратьСписок(Документ, "profiles", "", Ошибки, "Профиль");
	Результат.Вставить("profiles", Профили);
	Результат.Вставить("tools", РазобратьСписок(Документ, "tools", "", Ошибки, "Инструмент"));
	Результат.Вставить("prompts", РазобратьСписок(Документ, "prompts", "", Ошибки, "Промпт"));
	ПроверитьУникальность(Результат.Получить("profiles"), "profiles", Ложь, Ошибки);
	ПроверитьУникальность(Результат.Получить("tools"), "tools", Истина, Ошибки);
	ПроверитьУникальность(Результат.Получить("prompts"), "prompts", Истина, Ошибки);

	ИменаПрофилей = Новый Соответствие;
	Для Каждого Профиль Из Профили Цикл
		ИменаПрофилей.Вставить(НРег(Профиль.Получить("name")), Истина);
	КонецЦикла;
	Для Каждого Раздел Из СтрРазделить("tools,prompts", ",") Цикл
		Для Каждого Элемент Из Результат.Получить(Раздел) Цикл
			Для Каждого Имя Из Элемент.Получить("profiles") Цикл
				Если ИменаПрофилей.Получить(НРег(Имя)) = Неопределено И Итог.ВнешниеПрофили.Найти(Имя) = Неопределено Тогда
					Итог.ВнешниеПрофили.Добавить(Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Коды режимов доступа к объекту.
//
// Возвращаемое значение:
//  Массив из Строка - read, aggregates, deny.
//
Функция РежимыОбъектов() Экспорт

	Возврат СтрРазделить("read,aggregates,deny", ",");

КонецФункции

// Коды действий с полем.
//
// Возвращаемое значение:
//  Массив из Строка - allow, deny, mask.
//
Функция ДействияСПолями() Экспорт

	Возврат СтрРазделить("allow,deny,mask", ",");

КонецФункции

// Коды видов сравнения ограничений строк.
//
// Возвращаемое значение:
//  Массив из Строка - eq, ne, in_hierarchy.
//
Функция ВидыСравнения() Экспорт

	Возврат СтрРазделить("eq,ne,in_hierarchy", ",");

КонецФункции

// Коды видов пользовательских инструментов.
//
// Возвращаемое значение:
//  Массив из Строка - query, dcs, method.
//
Функция ВидыИнструментов() Экспорт

	Возврат СтрРазделить("query,dcs,method", ",");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Разделы

Функция РазобратьНастройки(Настройки, Ошибки)
	// Общие настройки: есть только переданные ключи.

	Результат = Новый Соответствие;
	Если Настройки = Неопределено Тогда
		Возврат Результат;
	ИначеЕсли ТипЗнч(Настройки) <> Тип("Соответствие") Тогда
		Ошибки.Добавить("settings: очікується об'єкт");
		Возврат Результат;
	КонецЕсли;
	Если Настройки.Получить("instructions") <> Неопределено Тогда
		Результат.Вставить("instructions", ПрочитатьСтроку(Настройки, "instructions", "settings", Ошибки));
	КонецЕсли;
	Глоссарий = Настройки.Получить("glossary");
	Если Глоссарий <> Неопределено Тогда
		Если ТипЗнч(Глоссарий) = Тип("Массив") Тогда
			Результат.Вставить("glossary", Глоссарий);
		Иначе
			Ошибки.Добавить("settings.glossary: очікується масив термінів {""term"", ""definition""}");
		КонецЕсли;
	КонецЕсли;
	Для Каждого Ключ Из СтрРазделить("bannedFieldPatterns,bannedObjectPatterns", ",") Цикл
		Если Настройки.Получить(Ключ) <> Неопределено Тогда
			Результат.Вставить(Ключ, ПрочитатьСтроки(Настройки, Ключ, "settings", Ошибки, 255));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазобратьСписок(Владелец, Ключ, ПутьВладельца, Ошибки, Вид)
	// Массив элементов раздела: каждый элемент - объект JSON, разобранный по виду.

	Результат = Новый Массив;
	Путь = ПутьКлюча(ПутьВладельца, Ключ);
	Элементы = Владелец.Получить(Ключ);
	Если Элементы = Неопределено Тогда
		Возврат Результат;
	ИначеЕсли ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Ошибки.Добавить(Путь + ": очікується масив");
		Возврат Результат;
	КонецЕсли;
	Для Индекс = 0 По Элементы.ВГраница() Цикл
		ПутьЭлемента = СтрШаблон("%1[%2]", Путь, Формат(Индекс, "ЧН=0; ЧГ=0"));
		Элемент = Элементы[Индекс];
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Ошибки.Добавить(ПутьЭлемента + ": очікується об'єкт");
			Продолжить;
		КонецЕсли;
		Результат.Добавить(РазобратьЭлемент(Вид, Элемент, ПутьЭлемента, Ошибки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазобратьЭлемент(Вид, Элемент, Путь, Ошибки)

	Если Вид = "Профиль" Тогда
		Возврат РазобратьПрофиль(Элемент, Путь, Ошибки);
	ИначеЕсли Вид = "Инструмент" Тогда
		Возврат РазобратьИнструмент(Элемент, Путь, Ошибки);
	ИначеЕсли Вид = "Промпт" Тогда
		Возврат РазобратьПромпт(Элемент, Путь, Ошибки);
	ИначеЕсли Вид = "ПравилоОбъекта" Тогда
		Возврат РазобратьПравилоОбъекта(Элемент, Путь, Ошибки);
	ИначеЕсли Вид = "ПравилоПоля" Тогда
		Возврат РазобратьПравилоПоля(Элемент, Путь, Ошибки);
	ИначеЕсли Вид = "ОграничениеСтрок" Тогда
		Возврат РазобратьОграничение(Элемент, Путь, Ошибки);
	ИначеЕсли Вид = "ПараметрПрофиля" Тогда
		Возврат РазобратьПараметрПрофиля(Элемент, Путь, Ошибки);
	ИначеЕсли Вид = "ПараметрИнструмента" Тогда
		Возврат РазобратьПараметрИнструмента(Элемент, Путь, Ошибки);
	КонецЕсли;
	Возврат РазобратьАргументПромпта(Элемент, Путь, Ошибки);

КонецФункции

Функция РазобратьПрофиль(Элемент, Путь, Ошибки)
	// Профиль доступа: реквизиты, лимиты (0 - по умолчанию) и табличные части.

	Результат = Новый Соответствие;
	Результат.Вставить("name", ПрочитатьИмя(Элемент, Путь, Ошибки, 100, ""));
	Результат.Вставить("description", ПрочитатьСтроку(Элемент, "description", Путь, Ошибки));
	Лимиты = Элемент.Получить("limits");
	ПутьЛимитов = ПутьКлюча(Путь, "limits");
	Если Лимиты <> Неопределено И ТипЗнч(Лимиты) <> Тип("Соответствие") Тогда
		Ошибки.Добавить(ПутьЛимитов + ": очікується об'єкт");
		Лимиты = Неопределено;
	КонецЕсли;
	Если Лимиты = Неопределено Тогда
		Лимиты = Новый Соответствие;
	КонецЕсли;
	НормализованныеЛимиты = Новый Соответствие;
	Для Каждого Ключ Из КлючиЛимитов() Цикл
		НормализованныеЛимиты.Вставить(Ключ, ПрочитатьЧисло(Лимиты, Ключ, ПутьЛимитов, Ошибки));
	КонецЦикла;
	Результат.Вставить("limits", НормализованныеЛимиты);
	Результат.Вставить("includeDeleted", ПрочитатьБулево(Элемент, "includeDeleted", Путь, Ошибки));
	Инструменты = ПрочитатьСтроки(Элемент, "tools", Путь, Ошибки, 64);
	Для Индекс = 0 По Инструменты.ВГраница() Цикл
		Если Не mcp1c_Служебный.ЭтоИмяMCP(Инструменты[Индекс]) Тогда
			Ошибки.Добавить(СтрШаблон("%1[%2]: «%3» - не ім'я інструмента MCP", ПутьКлюча(Путь, "tools"),
				Формат(Индекс, "ЧН=0; ЧГ=0"), Инструменты[Индекс]));
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("tools", Инструменты);
	Результат.Вставить("objects", РазобратьСписок(Элемент, "objects", Путь, Ошибки, "ПравилоОбъекта"));
	Результат.Вставить("fields", РазобратьСписок(Элемент, "fields", Путь, Ошибки, "ПравилоПоля"));
	Результат.Вставить("rowRestrictions", РазобратьСписок(Элемент, "rowRestrictions", Путь, Ошибки, "ОграничениеСтрок"));
	Параметры = РазобратьСписок(Элемент, "parameters", Путь, Ошибки, "ПараметрПрофиля");
	ПроверитьУникальность(Параметры, ПутьКлюча(Путь, "parameters"), Ложь, Ошибки);
	Результат.Вставить("parameters", Параметры);
	Возврат Результат;

КонецФункции

Функция РазобратьПравилоОбъекта(Элемент, Путь, Ошибки)

	Результат = Новый Соответствие;
	Результат.Вставить("object", ПрочитатьСтроку(Элемент, "object", Путь, Ошибки, 255, Истина));
	Результат.Вставить("mode", ПрочитатьКод(Элемент, "mode", Путь, Ошибки, РежимыОбъектов(), "read"));
	Результат.Вставить("fields", ПрочитатьКод(Элемент, "fields", Путь, Ошибки, СтрРазделить("all,allowed", ","), "all"));
	Результат.Вставить("requirePeriod", ПрочитатьБулево(Элемент, "requirePeriod", Путь, Ошибки));
	Результат.Вставить("minGroupSize", ПрочитатьЧисло(Элемент, "minGroupSize", Путь, Ошибки));
	Возврат Результат;

КонецФункции

Функция РазобратьПравилоПоля(Элемент, Путь, Ошибки)

	Результат = Новый Соответствие;
	Результат.Вставить("object", ПрочитатьСтроку(Элемент, "object", Путь, Ошибки, 255, Истина));
	Результат.Вставить("field", ПрочитатьСтроку(Элемент, "field", Путь, Ошибки, 255, Истина));
	Действие = ПрочитатьКод(Элемент, "action", Путь, Ошибки, ДействияСПолями(), "deny");
	Результат.Вставить("action", Действие);
	ВидМаски = ПрочитатьКод(Элемент, "mask", Путь, Ошибки, mcp1c_Маскирование.ВидыМасок(), "");
	Результат.Вставить("mask", ?(Действие = "mask" И ПустаяСтрока(ВидМаски), "full", ВидМаски));
	Результат.Вставить("maskParameter", ПрочитатьЧисло(Элемент, "maskParameter", Путь, Ошибки, Ложь));
	Возврат Результат;

КонецФункции

Функция РазобратьОграничение(Элемент, Путь, Ошибки)
	// Ограничение строк: значение - JSON в формате аргументов или параметр профиля.

	Результат = Новый Соответствие;
	Результат.Вставить("object", ПрочитатьСтроку(Элемент, "object", Путь, Ошибки, 255, Истина));
	Результат.Вставить("field", ПрочитатьСтроку(Элемент, "field", Путь, Ошибки, 255, Истина));
	Результат.Вставить("op", ПрочитатьКод(Элемент, "op", Путь, Ошибки, ВидыСравнения(), "eq"));
	Значение = ПрочитатьСтроку(Элемент, "value", Путь, Ошибки, 1000);
	Параметр = ПрочитатьСтроку(Элемент, "parameter", Путь, Ошибки, 64);
	Если ПустаяСтрока(Значение) И ПустаяСтрока(Параметр) Тогда
		Ошибки.Добавить(Путь + ": потрібне value (JSON у форматі аргументів) або parameter (параметр профілю)");
	ИначеЕсли Не ПустаяСтрока(Значение) И Не ЭтоJSON(Значение) Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, "value") + ": некоректний JSON");
	КонецЕсли;
	Результат.Вставить("value", Значение);
	Результат.Вставить("parameter", Параметр);
	Результат.Вставить("comment", ПрочитатьСтроку(Элемент, "comment", Путь, Ошибки, 255));
	Возврат Результат;

КонецФункции

Функция РазобратьПараметрПрофиля(Элемент, Путь, Ошибки)

	Результат = Новый Соответствие;
	Имя = ПрочитатьСтроку(Элемент, "name", Путь, Ошибки, 64, Истина);
	Если Не ПустаяСтрока(Имя) И Не mcp1c_Служебный.ЭтоИдентификатор(Имя) Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, "name") + ": ім'я параметра - ідентифікатор 1С (літери, цифри, _)");
	КонецЕсли;
	Результат.Вставить("name", Имя);
	Результат.Вставить("types", ПрочитатьСтроку(Элемент, "types", Путь, Ошибки, 255));
	Результат.Вставить("description", ПрочитатьСтроку(Элемент, "description", Путь, Ошибки, 255));
	Возврат Результат;

КонецФункции

Функция РазобратьИнструмент(Элемент, Путь, Ошибки)
	// Пользовательский инструмент; текст запроса, схема и модуль проверяются при записи элемента.

	Результат = Новый Соответствие;
	Результат.Вставить("name", ПрочитатьИмя(Элемент, Путь, Ошибки, 64, "mcp"));
	Результат.Вставить("title", ПрочитатьСтроку(Элемент, "title", Путь, Ошибки, 100));
	Результат.Вставить("kind", ПрочитатьКод(Элемент, "kind", Путь, Ошибки, ВидыИнструментов(), "query"));
	Результат.Вставить("description", ПрочитатьСтроку(Элемент, "description", Путь, Ошибки));
	Результат.Вставить("query", ПрочитатьСтроку(Элемент, "query", Путь, Ошибки, 0, Ложь, Ложь));
	Результат.Вставить("dcs", ПрочитатьСтроку(Элемент, "dcs", Путь, Ошибки, 0, Ложь, Ложь));
	Результат.Вставить("module", ПрочитатьСтроку(Элемент, "module", Путь, Ошибки, 80));
	Результат.Вставить("method", ПрочитатьСтроку(Элемент, "method", Путь, Ошибки, 80));
	Результат.Вставить("rowLimit", ПрочитатьЧисло(Элемент, "rowLimit", Путь, Ошибки));
	Параметры = РазобратьСписок(Элемент, "parameters", Путь, Ошибки, "ПараметрИнструмента");
	ПроверитьУникальность(Параметры, ПутьКлюча(Путь, "parameters"), Истина, Ошибки);
	Результат.Вставить("parameters", Параметры);
	Результат.Вставить("profiles", ПрочитатьСтроки(Элемент, "profiles", Путь, Ошибки, 100));
	Возврат Результат;

КонецФункции

Функция РазобратьПараметрИнструмента(Элемент, Путь, Ошибки)

	Результат = Новый Соответствие;
	Имя = ПрочитатьСтроку(Элемент, "name", Путь, Ошибки, 64, Истина);
	Если Не ПустаяСтрока(Имя) И Не mcp1c_Служебный.ЭтоИмяАргумента(Имя) Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, "name") + ": ім'я аргументу - латинські літери, цифри й _");
	КонецЕсли;
	Результат.Вставить("name", Имя);
	Результат.Вставить("queryParameter", ПрочитатьСтроку(Элемент, "queryParameter", Путь, Ошибки, 80));
	Результат.Вставить("types", ПрочитатьСтроку(Элемент, "types", Путь, Ошибки, 500));
	Результат.Вставить("description", ПрочитатьСтроку(Элемент, "description", Путь, Ошибки, 500));
	Результат.Вставить("required", ПрочитатьБулево(Элемент, "required", Путь, Ошибки));
	Результат.Вставить("list", ПрочитатьБулево(Элемент, "list", Путь, Ошибки));
	Результат.Вставить("default", ПрочитатьСтроку(Элемент, "default", Путь, Ошибки, 1000));
	Результат.Вставить("allowed", ПрочитатьСтроку(Элемент, "allowed", Путь, Ошибки, 1000));
	Результат.Вставить("profileParameter", ПрочитатьСтроку(Элемент, "profileParameter", Путь, Ошибки, 100));
	Возврат Результат;

КонецФункции

Функция РазобратьПромпт(Элемент, Путь, Ошибки)

	Результат = Новый Соответствие;
	Результат.Вставить("name", ПрочитатьИмя(Элемент, Путь, Ошибки, 64, "mcp"));
	Результат.Вставить("title", ПрочитатьСтроку(Элемент, "title", Путь, Ошибки, 100));
	Результат.Вставить("description", ПрочитатьСтроку(Элемент, "description", Путь, Ошибки));
	Результат.Вставить("text", ПрочитатьСтроку(Элемент, "text", Путь, Ошибки, 0, Истина, Ложь));
	Аргументы = РазобратьСписок(Элемент, "arguments", Путь, Ошибки, "АргументПромпта");
	ПроверитьУникальность(Аргументы, ПутьКлюча(Путь, "arguments"), Истина, Ошибки);
	Результат.Вставить("arguments", Аргументы);
	Результат.Вставить("profiles", ПрочитатьСтроки(Элемент, "profiles", Путь, Ошибки, 100));
	Возврат Результат;

КонецФункции

Функция РазобратьАргументПромпта(Элемент, Путь, Ошибки)

	Результат = Новый Соответствие;
	Имя = ПрочитатьСтроку(Элемент, "name", Путь, Ошибки, 64, Истина);
	Если Не ПустаяСтрока(Имя) И Не mcp1c_Служебный.ЭтоИмяАргумента(Имя) Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, "name") + ": ім'я аргументу - латинські літери, цифри й _");
	КонецЕсли;
	Результат.Вставить("name", Имя);
	Результат.Вставить("description", ПрочитатьСтроку(Элемент, "description", Путь, Ошибки, 255));
	Результат.Вставить("required", ПрочитатьБулево(Элемент, "required", Путь, Ошибки));
	Результат.Вставить("default", ПрочитатьСтроку(Элемент, "default", Путь, Ошибки, 255));
	Возврат Результат;

КонецФункции

Функция КлючиЛимитов()
	// Лимиты профиля в выгрузке; 0 - значение по умолчанию.

	Возврат СтрРазделить("rowsPerCall,callsPerMinute,rowsPerDay,periodDays,responseKb,dereferenceDepth", ",");

КонецФункции

Процедура ПроверитьУникальность(Элементы, Путь, СУчетомРегистра, Ошибки)
	// Имена элементов раздела не повторяются: профили - без учета регистра, как наименования.

	Имена = Новый Соответствие;
	Индекс = -1;
	Для Каждого Элемент Из Элементы Цикл
		Индекс = Индекс + 1;
		Имя = Элемент.Получить("name");
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ?(СУчетомРегистра, Имя, НРег(Имя));
		Если Имена.Получить(Ключ) <> Неопределено Тогда
			Ошибки.Добавить(СтрШаблон("%1[%2].name: «%3» повторюється", Путь, Формат(Индекс, "ЧН=0; ЧГ=0"), Имя));
		Иначе
			Имена.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЧтениеЗначений

Функция ПрочитатьИмя(Элемент, Путь, Ошибки, МаксимальнаяДлина, Шаблон)
	// Обязательное имя элемента; для инструментов и промптов - имя MCP.

	Имя = ПрочитатьСтроку(Элемент, "name", Путь, Ошибки, МаксимальнаяДлина, Истина);
	Если Шаблон = "mcp" И Не ПустаяСтрока(Имя) И Не mcp1c_Служебный.ЭтоИмяMCP(Имя) Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, "name") + ": латинські малі літери, цифри й _, починається з літери, від 3 до 64 "
			+ "символів");
	КонецЕсли;
	Возврат Имя;

КонецФункции

Функция ПрочитатьСтроку(Элемент, Ключ, Путь, Ошибки, МаксимальнаяДлина = 0, Обязательная = Ложь, Обрезать = Истина)
	// Строка; отсутствующее значение - пустая строка. Длина проверяется, а не обрезается.

	Значение = Элемент.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Значение = "";
	ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, Ключ) + ": очікується рядок");
		Возврат "";
	КонецЕсли;
	Если Обрезать Тогда
		Значение = СокрЛП(Значение);
	КонецЕсли;
	Если Обязательная И ПустаяСтрока(Значение) Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, Ключ) + ": значення обов'язкове");
	ИначеЕсли МаксимальнаяДлина > 0 И СтрДлина(Значение) > МаксимальнаяДлина Тогда
		Ошибки.Добавить(СтрШаблон("%1: довше %2 символів", ПутьКлюча(Путь, Ключ), МаксимальнаяДлина));
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ПрочитатьСтроки(Элемент, Ключ, Путь, Ошибки, МаксимальнаяДлина)
	// Массив непустых строк.

	Результат = Новый Массив;
	Значение = Элемент.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) <> Тип("Массив") Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, Ключ) + ": очікується масив рядків");
		Возврат Результат;
	КонецЕсли;
	Для Индекс = 0 По Значение.ВГраница() Цикл
		Строка_ = Значение[Индекс];
		ПутьЭлемента = СтрШаблон("%1[%2]", ПутьКлюча(Путь, Ключ), Формат(Индекс, "ЧН=0; ЧГ=0"));
		Если ТипЗнч(Строка_) <> Тип("Строка") Тогда
			Ошибки.Добавить(ПутьЭлемента + ": очікується рядок");
		ИначеЕсли СтрДлина(СокрЛП(Строка_)) > МаксимальнаяДлина Тогда
			Ошибки.Добавить(СтрШаблон("%1: довше %2 символів", ПутьЭлемента, МаксимальнаяДлина));
		ИначеЕсли Не ПустаяСтрока(Строка_) Тогда
			Результат.Добавить(СокрЛП(Строка_));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПрочитатьЧисло(Элемент, Ключ, Путь, Ошибки, Целое = Истина)
	// Неотрицательное число; отсутствующее значение - 0.

	Значение = Элемент.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат 0;
	ИначеЕсли ТипЗнч(Значение) <> Тип("Число") Или Значение < 0 Или Целое И Значение <> Цел(Значение) Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, Ключ) + ?(Целое, ": очікується ціле число від 0", ": очікується число від 0"));
		Возврат 0;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ПрочитатьБулево(Элемент, Ключ, Путь, Ошибки)
	// true или false; отсутствующее значение - false.

	Значение = Элемент.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	ИначеЕсли ТипЗнч(Значение) <> Тип("Булево") Тогда
		Ошибки.Добавить(ПутьКлюча(Путь, Ключ) + ": очікується true або false");
		Возврат Ложь;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ПрочитатьКод(Элемент, Ключ, Путь, Ошибки, Допустимые, ПоУмолчанию)
	// Код из списка допустимых (без учета регистра); отсутствующее значение - по умолчанию.

	Значение = Элемент.Получить(Ключ);
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Строка") И ПустаяСтрока(Значение) Тогда
		Возврат ПоУмолчанию;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И Допустимые.Найти(НРег(СокрЛП(Значение))) <> Неопределено Тогда
		Возврат НРег(СокрЛП(Значение));
	КонецЕсли;
	Ошибки.Добавить(СтрШаблон("%1: очікується одне зі значень %2", ПутьКлюча(Путь, Ключ), СтрСоединить(Допустимые, ", ")));
	Возврат ПоУмолчанию;

КонецФункции

Функция ЭтоJSON(Текст)

	Попытка
		mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

Функция ПутьКлюча(Путь, Ключ)

	Возврат ?(ПустаяСтрока(Путь), Ключ, Путь + "." + Ключ);


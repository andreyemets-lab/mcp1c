///////////////////////////////////////////////////////////////////////////////
// mcp1c_Статистика: расчеты панели мониторинга рабочего места (п. 8.3, 9.2 ТЗ) без обращений
// к данным: сводка длительностей и перцентили по гистограмме, топ объектов по спискам журнала
// вызовов, представления длительности, объема и срока, предупреждения рабочего места.
// Чистая логика; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Длительности

// Строка гистограммы длительностей: сколько вызовов длились столько миллисекунд.
//
// Параметры:
//  Значение - Число - длительность, мс.
//  Количество - Число - вызовов.
//  Ключ - Строка - группа строки (имя инструмента); пустая строка - без группы.
//
// Возвращаемое значение:
//  Структура:
//   * Значение - Число - длительность, мс.
//   * Количество - Число - вызовов.
//   * Ключ - Строка - группа строки.
//
Функция НоваяСтрокаГистограммы(Значение, Количество, Ключ = "") Экспорт

	Строка_ = Новый Структура;
	Строка_.Вставить("Значение", Значение);
	Строка_.Вставить("Количество", Количество);
	Строка_.Вставить("Ключ", Ключ);
	Возврат Строка_;

КонецФункции

// Сводка длительностей по гистограмме: число вызовов, среднее, медиана, 95-й перцентиль и максимум.
// Перцентиль - по ближайшему рангу: наименьшая длительность, не меньше которой длятся заданная доля
// вызовов. Порядок строк гистограммы не важен, строки с одинаковой длительностью складываются.
//
// Параметры:
//  Гистограмма - Массив из см. НоваяСтрокаГистограммы
//
// Возвращаемое значение:
//  см. НоваяСводкаДлительностей
//
Функция СводкаДлительностей(Гистограмма) Экспорт

	Сводка = НоваяСводкаДлительностей();
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");
	Таблица.Колонки.Добавить("Количество");
	Сумма = 0;
	Для Каждого Строка_ Из Гистограмма Цикл
		Если Строка_.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка_);
		Сводка.Количество = Сводка.Количество + Строка_.Количество;
		Сумма = Сумма + Строка_.Значение * Строка_.Количество;
	КонецЦикла;
	Если Сводка.Количество = 0 Тогда
		Возврат Сводка;
	КонецЕсли;

	Таблица.Сортировать("Значение");
	Сводка.Среднее = Окр(Сумма / Сводка.Количество);
	Сводка.Медиана = Число(ЗначениеРанга(Таблица, РангПерцентиля(Сводка.Количество, 50)));
	Сводка.P95 = Число(ЗначениеРанга(Таблица, РангПерцентиля(Сводка.Количество, 95)));
	Сводка.Максимум = Число(Таблица[Таблица.Количество() - 1].Значение);
	Возврат Сводка;

КонецФункции

// Сводки длительностей по группам гистограммы (по инструментам).
//
// Параметры:
//  Гистограмма - Массив из см. НоваяСтрокаГистограммы
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - группа.
//   * Значение - см. НоваяСводкаДлительностей
//
Функция СводкиДлительностейПоКлючам(Гистограмма) Экспорт

	Группы = Новый Соответствие;
	Для Каждого Строка_ Из Гистограмма Цикл
		Строки = Группы.Получить(Строка_.Ключ);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			Группы.Вставить(Строка_.Ключ, Строки);
		КонецЕсли;
		Строки.Добавить(Строка_);
	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого Группа Из Группы Цикл
		Результат.Вставить(Группа.Ключ, СводкаДлительностей(Группа.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ранг перцентиля по ближайшему рангу: наименьший номер вызова в порядке возрастания длительности,
// до которого включительно набирается заданная доля вызовов.
//
// Параметры:
//  Количество - Число - вызовов.
//  Процент - Число - перцентиль, от 1 до 100.
//
// Возвращаемое значение:
//  Число - ранг от 1 до Количество.
//
Функция РангПерцентиля(Количество, Процент) Экспорт

	Ранг = Цел(Количество * Процент / 100);
	Если Ранг * 100 < Количество * Процент Тогда
		Ранг = Ранг + 1;
	КонецЕсли;
	Возврат Макс(Ранг, 1);

КонецФункции

// Пустая сводка длительностей.
//
// Возвращаемое значение:
//  Структура:
//   * Количество - Число - вызовов.
//   * Среднее - Число - средняя длительность, мс, округлена до целого.
//   * Медиана - Число - медиана, мс.
//   * P95 - Число - 95-й перцентиль, мс.
//   * Максимум - Число - наибольшая длительность, мс.
//
Функция НоваяСводкаДлительностей() Экспорт

	Сводка = Новый Структура;
	Сводка.Вставить("Количество", 0);
	Сводка.Вставить("Среднее", 0);
	Сводка.Вставить("Медиана", 0);
	Сводка.Вставить("P95", 0);
	Сводка.Вставить("Максимум", 0);
	Возврат Сводка;

КонецФункции

#КонецОбласти

#Область Объекты

// Строка группировки журнала вызовов по списку объектов.
//
// Параметры:
//  Объекты - Строка - полные имена объектов через запятую, как в журнале вызовов.
//  Количество - Число - вызовов с этим списком.
//
// Возвращаемое значение:
//  Структура:
//   * Объекты - Строка - имена объектов через запятую.
//   * Количество - Число - вызовов.
//
Функция НоваяСтрокаОбъектов(Объекты, Количество) Экспорт

	Строка_ = Новый Структура;
	Строка_.Вставить("Объекты", Объекты);
	Строка_.Вставить("Количество", Количество);
	Возврат Строка_;

КонецФункции

// Объекты, к которым чаще всего обращались: вызов с несколькими объектами засчитывается каждому.
// При равном числе обращений объекты упорядочены по имени.
//
// Параметры:
//  Строки - Массив из см. НоваяСтрокаОбъектов
//  Предел - Число - сколько объектов вернуть.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Объект - Строка - полное имя объекта.
//   * Обращений - Число - вызовов с этим объектом.
//
Функция ТопОбъектов(Строки, Предел) Экспорт

	Счетчики = Новый Соответствие;
	Для Каждого Строка_ Из Строки Цикл
		Для Каждого Часть Из СтрРазделить(Строка_.Объекты, ",", Ложь) Цикл
			Имя = СокрЛП(Часть);
			Если ПустаяСтрока(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Было = Счетчики.Получить(Имя);
			Счетчики.Вставить(Имя, ?(Было = Неопределено, 0, Было) + Строка_.Количество);
		КонецЦикла;
	КонецЦикла;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Объект");
	Таблица.Колонки.Добавить("Обращений");
	Для Каждого Счетчик Из Счетчики Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Объект = Счетчик.Ключ;
		НоваяСтрока.Обращений = Счетчик.Значение;
	КонецЦикла;
	Таблица.Сортировать("Обращений Убыв, Объект");

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Результат.Количество() >= Предел Тогда
			Прервать;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("Объект", Строка(СтрокаТаблицы.Объект));
		Элемент.Вставить("Обращений", Число(СтрокаТаблицы.Обращений));
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Представления

// Длительность для панели: «350 мс», «1,3 с», «2 хв 05 с».
//
// Параметры:
//  Миллисекунд - Число - длительность.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ПредставлениеДлительности(Миллисекунд) Экспорт

	Мс = Макс(Окр(Миллисекунд), 0);
	Если Мс < 1000 Тогда
		Возврат ЧислоСтрокой(Мс) + " мс";
	ИначеЕсли Мс < 59950 Тогда
		Десятых = Окр(Мс / 100);
		Возврат ЧислоСтрокой(Цел(Десятых / 10)) + "," + ЧислоСтрокой(Десятых % 10) + " с";
	КонецЕсли;
	Секунд = Окр(Мс / 1000);
	Остаток = Секунд % 60;
	Возврат ЧислоСтрокой(Цел(Секунд / 60)) + " хв " + ?(Остаток < 10, "0", "") + ЧислоСтрокой(Остаток) + " с";

КонецФункции

// Объем ответа для панели: «512 Б», «12,5 КБ», «3,2 МБ».
//
// Параметры:
//  Байт - Число - объем.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ПредставлениеОбъема(Байт) Экспорт

	Значение = Макс(Окр(Байт), 0);
	Если Значение < 1024 Тогда
		Возврат ЧислоСтрокой(Значение) + " Б";
	ИначеЕсли Значение < 1024 * 1024 Тогда
		Возврат ДесятыеСтрокой(Значение / 1024) + " КБ";
	ИначеЕсли Значение < 1024 * 1024 * 1024 Тогда
		Возврат ДесятыеСтрокой(Значение / 1024 / 1024) + " МБ";
	КонецЕсли;
	Возврат ДесятыеСтрокой(Значение / 1024 / 1024 / 1024) + " ГБ";

КонецФункции

// Сколько осталось до момента: «3 дн. 4 год.», «5 год. 20 хв», «12 хв», «менше хвилини».
//
// Параметры:
//  Секунд - Число - секунд до момента; не больше нуля - момент наступил.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ПредставлениеОстатка(Секунд) Экспорт

	Если Секунд <= 0 Тогда
		Возврат "минуло";
	ИначеЕсли Секунд < 60 Тогда
		Возврат "менше хвилини";
	КонецЕсли;
	Минут = Цел(Секунд / 60);
	Часов = Цел(Минут / 60);
	Дней = Цел(Часов / 24);
	Если Дней > 0 Тогда
		Возврат ЧислоСтрокой(Дней) + " дн." + ?(Часов % 24 > 0, " " + ЧислоСтрокой(Часов % 24) + " год.", "");
	ИначеЕсли Часов > 0 Тогда
		Возврат ЧислоСтрокой(Часов) + " год." + ?(Минут % 60 > 0, " " + ЧислоСтрокой(Минут % 60) + " хв", "");
	КонецЕсли;
	Возврат ЧислоСтрокой(Минут) + " хв";

КонецФункции

#КонецОбласти

#Область Предупреждения

// Факты о сервере для предупреждений рабочего места.
//
// Возвращаемое значение:
//  Структура:
//   * НастройкиДоступны - Булево - пользователь может читать настройки сервера; без них предупреждения
//                         о настройках не формируются.
//   * Включен - Булево - сервер обрабатывает запросы.
//   * АдресЗадан - Булево - задан публичный адрес сервера.
//   * ТребуетсяПодтверждениеПереноса - Булево - последний запрос отклонен из-за смены расположения базы.
//   * ЗаголовокАдресаКлиента - Строка - заголовок с IP клиента, который ставит прокси.
//   * ЗапросовСАдресом - Число - запросов за неделю с IP клиента.
//   * ЗапросовБезАдреса - Число - запросов за неделю без IP клиента.
//   * ДействующихТокенов - Число - токенов, которыми можно подключиться.
//   * ИстекающихТокенов - Число - действующих токенов, срок которых истекает в ближайшие дни.
//   * ДнейДоИстечения - Число - сколько дней считается «ближайшими».
//   * ПрофилиСЧувствительнымиПолями - Неопределено, Массив из Строка - профили, которые показывают
//                                     чувствительные поля без маски; Неопределено - не проверялись.
//
Функция НовыеФактыРабочегоМеста() Экспорт

	Факты = Новый Структура;
	Факты.Вставить("НастройкиДоступны", Истина);
	Факты.Вставить("Включен", Ложь);
	Факты.Вставить("АдресЗадан", Ложь);
	Факты.Вставить("ТребуетсяПодтверждениеПереноса", Ложь);
	Факты.Вставить("ЗаголовокАдресаКлиента", "");
	Факты.Вставить("ЗапросовСАдресом", 0);
	Факты.Вставить("ЗапросовБезАдреса", 0);
	Факты.Вставить("ДействующихТокенов", 0);
	Факты.Вставить("ИстекающихТокенов", 0);
	Факты.Вставить("ДнейДоИстечения", 7);
	Факты.Вставить("ПрофилиСЧувствительнымиПолями", Неопределено);
	Возврат Факты;

КонецФункции

// Предупреждения рабочего места (п. 9.2 ТЗ): сервер выключен или ждет подтверждения переноса базы,
// не задан публичный адрес, IP клиента не доходит от прокси, токены истекают, профили показывают
// чувствительные поля без маски.
//
// Параметры:
//  Факты - см. НовыеФактыРабочегоМеста
//
// Возвращаемое значение:
//  Массив из Строка - тексты предупреждений в порядке важности.
//
Функция ПредупрежденияРабочегоМеста(Факты) Экспорт

	Результат = Новый Массив;
	Если Факты.НастройкиДоступны Тогда
		Если Факты.ТребуетсяПодтверждениеПереноса Тогда
			Результат.Добавить("Розташування бази змінилося: сервер відповідає 503, доки адміністратор не підтвердить "
				+ "перенесення (команда «Підтвердити перенесення»).");
		КонецЕсли;
		Если Не Факты.Включен Тогда
			Результат.Добавить("Сервер вимкнено: клієнти отримують 503.");
		КонецЕсли;
		Если Не Факты.АдресЗадан Тогда
			Результат.Добавить("Не задано публічну адресу сервера: у фрагментах підключення буде заглушка "
				+ "замість адреси.");
		КонецЕсли;
		ПредупреждениеОбАдресеКлиента(Факты, Результат);
	КонецЕсли;

	Если Факты.Включен И Факты.ДействующихТокенов = 0 И Факты.НастройкиДоступны Тогда
		Результат.Добавить("Немає діючих токенів: жоден клієнт не може підключитися.");
	КонецЕсли;
	Если Факты.ИстекающихТокенов > 0 Тогда
		Результат.Добавить(СтрШаблон("Протягом %1 дн. спливає токенів: %2 (вкладка «Токени»).",
			ЧислоСтрокой(Факты.ДнейДоИстечения), ЧислоСтрокой(Факты.ИстекающихТокенов)));
	КонецЕсли;
	Профили = Факты.ПрофилиСЧувствительнымиПолями;
	Если Профили <> Неопределено И Профили.Количество() > 0 Тогда
		Результат.Добавить(СтрШаблон("Профілі показують чутливі поля без маски: %1. Відкрийте профіль і виконайте "
			+ "«Аналіз ризиків».", СтрСоединить(Профили, ", ")));
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеРанга(Таблица, Ранг)
	// Длительность вызова с заданным рангом в таблице, упорядоченной по длительности.

	Накоплено = 0;
	Для Каждого Строка_ Из Таблица Цикл
		Накоплено = Накоплено + Строка_.Количество;
		Если Накоплено >= Ранг Тогда
			Возврат Строка_.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица[Таблица.Количество() - 1].Значение;

КонецФункции

Процедура ПредупреждениеОбАдресеКлиента(Факты, Результат)
	// Заголовок IP не задан или не приходит от прокси: ограничения и блокировки по IP не действуют.

	Заголовок = Факты.ЗаголовокАдресаКлиента;
	Если ПустаяСтрока(Заголовок) Тогда
		Результат.Добавить("Заголовок IP клієнта не задано: дозволені IP-адреси клієнтів і блокування перебору "
			+ "токенів не діють.");
	ИначеЕсли Факты.ЗапросовБезАдреса > 0 И Факты.ЗапросовСАдресом = 0 Тогда
		Результат.Добавить(СтрШаблон("Запити надходять без заголовка %1: проксі не передає IP клієнта, дозволені "
			+ "IP-адреси й блокування перебору токенів не діють.", Заголовок));
	ИначеЕсли Факты.ЗапросовБезАдреса > 0 Тогда
		Результат.Добавить(СтрШаблон("За тиждень %1 запитів надійшли без заголовка %2: перевірте, чи немає доступу "
			+ "до публікації в обхід проксі.", ЧислоСтрокой(Факты.ЗапросовБезАдреса), Заголовок));
	КонецЕсли;

КонецПроцедуры

Функция ЧислоСтрокой(Число)

	Возврат Формат(Число, "ЧН=0; ЧГ=0");

КонецФункции

Функция ДесятыеСтрокой(Число)
	// Число с одним знаком после запятой: 12,5; целое - без дробной части: 12.

	Десятых = Окр(Число * 10);
	Если Десятых % 10 = 0 Тогда
		Возврат ЧислоСтрокой(Цел(Десятых / 10));
	КонецЕсли;
	Возврат ЧислоСтрокой(Цел(Десятых / 10)) + "," + ЧислоСтрокой(Десятых % 10);

КонецФункции

#КонецОбласти

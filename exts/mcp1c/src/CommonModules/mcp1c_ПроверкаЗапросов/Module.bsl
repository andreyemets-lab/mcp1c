///////////////////////////////////////////////////////////////////////////////
// mcp1c_ПроверкаЗапросов: тексты запросов модели (execute_query, п. 5.2 ТЗ) и запросы наборов
// данных отчетов на СКД (list_reports, describe_report, run_report): разбор на лексемы, проверка
// путей полей и таблиц правилами профиля (п. 7.4-7.6 ТЗ).
//
// execute_query. Пакет разбирает схема запроса платформы (mcp1c_ИнструментыДанных): она находит
// источники - таблицы ИБ, временные таблицы пакета и вложенные запросы - с псевдонимами и возвращает
// текст, в котором поля указаны через псевдонимы. Этот текст и проверяется, и выполняется.
// Путь «Псевдоним.Поле.Поле» разбирается mcp1c_ПутиПолей по описанию таблицы источника: каждое звено
// проверяет политика, замаскированные поля недоступны. Полное имя таблицы в тексте должно быть
// проверенным источником: так отсекаются вложенные запросы в условиях - их источники схема запроса
// не показывает. Имена после КАК и ССЫЛКА, внутри ЗНАЧЕНИЕ() и ТИП() - псевдонимы и типы, а не поля;
// неизвестное имя - ошибка.
// Отчеты. Таблицы запроса набора данных - полные имена таблиц в тексте (с расширением языка
// запросов компоновки); имена в тексте проверяются глобальными запретами полей.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Лексемы

// Лексемы текста запроса: имена, числа, строки, параметры и знаки. Пробелы и комментарии
// пропускаются.
//
// Параметры:
//  Текст - Строка - текст запроса.
//
// Возвращаемое значение:
//  Структура:
//   * Лексемы - Массив из см. НоваяЛексема
//   * Ошибка - Строка - текст ошибки для модели (незакрытая строка); пустая строка, если текст разобран.
//
Функция Лексемы(Знач Текст) Экспорт

	Результат = Новый Структура("Лексемы, Ошибка", Новый Массив, "");
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ПустаяСтрока(Символ) Тогда
			Позиция = Позиция + 1;
		ИначеЕсли Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/" Тогда
			Позиция = КонецСтроки(Текст, Позиция, Длина) + 1;
		ИначеЕсли Символ = """" Тогда
			Позиция = ПрочитатьСтроку(Текст, Позиция, Длина, Результат);
		ИначеЕсли ЭтоБуква(Символ) Тогда
			Конец = КонецИмени(Текст, Позиция + 1, Длина);
			Результат.Лексемы.Добавить(НоваяЛексема("name", Сред(Текст, Позиция, Конец - Позиция)));
			Позиция = Конец;
		ИначеЕсли ЭтоЦифра(Символ) Тогда
			Конец = КонецЧисла(Текст, Позиция, Длина);
			Результат.Лексемы.Добавить(НоваяЛексема("number", Сред(Текст, Позиция, Конец - Позиция)));
			Позиция = Конец;
		ИначеЕсли Символ = "&" И ЭтоБуква(Сред(Текст, Позиция + 1, 1)) Тогда
			Конец = КонецИмени(Текст, Позиция + 2, Длина);
			Результат.Лексемы.Добавить(НоваяЛексема("param", Сред(Текст, Позиция + 1, Конец - Позиция - 1)));
			Позиция = Конец;
		Иначе
			Пара = Сред(Текст, Позиция, 2);
			Если Пара = "<=" Или Пара = ">=" Или Пара = "<>" Тогда
				Результат.Лексемы.Добавить(НоваяЛексема("sign", Пара));
				Позиция = Позиция + 2;
			Иначе
				Результат.Лексемы.Добавить(НоваяЛексема("sign", Символ));
				Позиция = Позиция + 1;
			КонецЕсли;
		КонецЕсли;
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Лексема текста запроса.
//
// Параметры:
//  Вид - Строка - name (имя или ключевое слово), number, string, param или sign.
//  Текст - Строка - имя как в тексте, число, содержимое строки, имя параметра без &, знак.
//
// Возвращаемое значение:
//  Структура:
//   * Вид - Строка - вид лексемы.
//   * Текст - Строка - текст лексемы.
//   * Ключ - Строка - для имен - текст в верхнем регистре (сравнение с ключевыми словами), для прочих - текст.
//
Функция НоваяЛексема(Вид, Текст) Экспорт

	Лексема = Новый Структура;
	Лексема.Вставить("Вид", Вид);
	Лексема.Вставить("Текст", Текст);
	Лексема.Вставить("Ключ", ?(Вид = "name", ВРег(Текст), Текст));
	Возврат Лексема;

КонецФункции

#КонецОбласти

#Область ЗапросМодели

// Пустой разбор пакета запросов модели: источники, временные таблицы и колонки, которые нашла схема запроса.
//
// Возвращаемое значение:
//  Структура:
//   * Источники - Массив из см. НовыйИсточник
//   * ВременныеТаблицы - Соответствие из КлючИЗначение - временные таблицы, созданные в пакете:
//     ** Ключ - Строка - имя таблицы в нижнем регистре.
//     ** Значение - Массив из Строка - псевдонимы колонок.
//   * Колонки - Массив из Строка - псевдонимы колонок всех запросов пакета.
//   * Ошибка - Строка - ошибка разбора для модели; пустая строка - разбор удался.
//
Функция НовыйРазборПакета() Экспорт

	Разбор = Новый Структура;
	Разбор.Вставить("Источники", Новый Массив);
	Разбор.Вставить("ВременныеТаблицы", Новый Соответствие);
	Разбор.Вставить("Колонки", Новый Массив);
	Разбор.Вставить("Ошибка", "");
	Возврат Разбор;

КонецФункции

// Источник запроса пакета.
//
// Параметры:
//  Вид - Строка - table (таблица ИБ), temporary (временная таблица пакета) или nested (вложенный запрос).
//  Псевдоним - Строка - псевдоним источника в запросе.
//  Имя - Строка - имя таблицы, как его возвращает схема запроса; для вложенного запроса - пустая строка.
//  Колонки - Неопределено, Массив из Строка - колонки временной таблицы или вложенного запроса.
//
// Возвращаемое значение:
//  Структура:
//   * Вид - Строка - table, temporary или nested.
//   * Псевдоним - Строка - псевдоним источника.
//   * Имя - Строка - имя таблицы.
//   * Колонки - Массив из Строка - колонки временной таблицы или вложенного запроса.
//   * Описание - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//              - Неопределено - таблица ИБ не поддерживается или источник - не таблица ИБ.
//
Функция НовыйИсточник(Вид, Псевдоним, Имя = "", Колонки = Неопределено) Экспорт

	Источник = Новый Структура;
	Источник.Вставить("Вид", Вид);
	Источник.Вставить("Псевдоним", Псевдоним);
	Источник.Вставить("Имя", Имя);
	Источник.Вставить("Колонки", Новый Массив);
	Источник.Вставить("Описание", Неопределено);
	Если ТипЗнч(Колонки) = Тип("Массив") Тогда
		Для Каждого Колонка Из Колонки Цикл
			Источник.Колонки.Добавить(Строка(Колонка));
		КонецЦикла;
	КонецЕсли;
	Возврат Источник;

КонецФункции

// Ошибка исходного текста запроса модели, которую не видно в тексте схемы запроса: схема раскрывает
// «*» в перечень всех полей таблицы.
//
// Параметры:
//  Текст - Строка - текст запроса от модели.
//
// Возвращаемое значение:
//  Строка - текст ошибки для модели; пустая строка - ошибки нет.
//
Функция ОшибкаИсходногоТекста(Текст) Экспорт

	Разобранный = Лексемы(Текст);
	Если Не ПустаяСтрока(Разобранный.Ошибка) Тогда
		Возврат Разобранный.Ошибка;
	КонецЕсли;
	Поток = Разобранный.Лексемы;
	Для Индекс = 0 По Поток.ВГраница() Цикл
		Если Поток[Индекс].Текст = "*" И Поток[Индекс].Вид = "sign" И ЗвездочкаВместоПолей(Поток, Индекс) Тогда
			Возврат ОшибкаЗвездочки();
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Проверяет пакет запросов модели правилами профиля (п. 5.2, 7.4-7.6 ТЗ): источники - таблицы, которые
// профиль дает читать без ограничений строк, обязательного отбора по периоду и режима «только агрегаты»;
// каждое поле и звено разыменования доступно и не замаскировано; нет ИТОГИ, ДЛЯ ИЗМЕНЕНИЯ, ПРЕДСТАВЛЕНИЕ,
// разыменования выражений и таблиц вне источников.
//
// Параметры:
//  Разбор - см. НовыйРазборПакета
//  Текст - Строка - текст пакета, который вернула схема запроса (его и выполняет сервер).
//  Описания - Соответствие из КлючИЗначение - описания объектов для разыменования (см. mcp1c_ПутиПолей.РазобратьПуть):
//   * Ключ - Строка - полное имя объекта.
//   * Значение - см. mcp1c_ПутиПолей.НовоеОписаниеТаблицы
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - текст можно выполнять.
//   * НужноОписание - Строка - полное имя объекта, описание которого нужно загрузить и повторить проверку.
//   * Ошибка - Строка - текст ошибки для модели.
//   * Причина - Строка - причина отказа по политике для журнала; пустая строка - отказа по политике нет.
//   * Объекты - Массив из Строка - объекты метаданных, таблицы которых читает пакет.
//
Функция ПроверитьПакет(Разбор, Текст, Описания, Политика) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("НужноОписание", "");
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Причина", "");
	Результат.Вставить("Объекты", Новый Массив);

	Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
		Результат.Ошибка = Разбор.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Проверка = НоваяПроверка(Разбор, Описания, Политика, Результат);
	ПроверитьИсточники(Разбор, Проверка);
	Если Остановлена(Проверка) Тогда
		Возврат Результат;
	КонецЕсли;
	Разобранный = Лексемы(Текст);
	Если Не ПустаяСтрока(Разобранный.Ошибка) Тогда
		Результат.Ошибка = Разобранный.Ошибка;
		Возврат Результат;
	КонецЕсли;
	ПроверитьТаблицыТекста(Разобранный.Лексемы, Проверка);
	Если Не Остановлена(Проверка) Тогда
		ПроверитьЛексемы(Разобранный.Лексемы, Проверка);
	КонецЕсли;
	Результат.Успех = Не Остановлена(Проверка);
	Возврат Результат;

КонецФункции

// Спецификации значений параметров запроса модели: аргумент parameters по типам, которые платформа
// вывела из текста запроса (п. 5.4 ТЗ: значения - только параметрами).
//
// Параметры:
//  Аргумент - Произвольный - значение аргумента parameters: объект JSON (Соответствие) или Неопределено.
//  ТипыПараметров - Соответствие из КлючИЗначение - параметры запроса:
//   * Ключ - Строка - имя параметра, как в тексте запроса.
//   * Значение - Массив из Строка - имена типов (Строка, Число, Дата, Булево, полное имя объекта);
//                пустой массив - тип не выведен, он определяется по значению JSON.
//
// Возвращаемое значение:
//  Структура:
//   * Значения - Соответствие из КлючИЗначение - спецификации по именам параметров:
//     ** Ключ - Строка - имя параметра.
//     ** Значение - см. mcp1c_ЗапросыДанных.НовоеЗначение
//   * Ошибка - Строка - текст ошибки для модели; пустая строка - значения получены.
//
Функция ЗначенияПараметров(Аргумент, ТипыПараметров) Экспорт

	Результат = Новый Структура("Значения, Ошибка", Новый Соответствие, "");
	Переданные = Новый Соответствие;
	Если ТипЗнч(Аргумент) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Аргумент Цикл
			Переданные.Вставить(НРег(Элемент.Ключ), Элемент);
		КонецЦикла;
	КонецЕсли;
	Известные = Новый Соответствие;
	Для Каждого Параметр Из ТипыПараметров Цикл
		Известные.Вставить(НРег(Параметр.Ключ), Истина);
		Элемент = Переданные.Получить(НРег(Параметр.Ключ));
		Если Элемент = Неопределено Тогда
			Результат.Ошибка = СтрШаблон("Не задано значення параметра &%1: передайте його в parameters", Параметр.Ключ);
			Возврат Результат;
		КонецЕсли;
		Разбор = СпецификацияЗначения(Элемент.Значение, Параметр.Значение, "parameters." + Элемент.Ключ);
		Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
			Результат.Ошибка = Разбор.Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат.Значения.Вставить(Параметр.Ключ, Разбор.Значение);
	КонецЦикла;
	Для Каждого Элемент Из Переданные Цикл
		Если Известные.Получить(Элемент.Ключ) = Неопределено Тогда
			Результат.Ошибка = СтрШаблон("Параметра &%1 немає в тексті запиту", Элемент.Значение.Ключ);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Спецификация одного значения параметра запроса или отчета по типам параметра: массив - список
// значений, null - Неопределено; без типов тип определяется по значению JSON (строка в формате даты -
// дата, объект с type - ссылка или перечисление).
//
// Параметры:
//  Значение - Произвольный - значение JSON.
//  Типы - Массив из Строка - имена типов параметра; пустой массив - тип не известен.
//  Путь - Строка - путь к значению для текста ошибки.
//
// Возвращаемое значение:
//  Структура:
//   * Значение - см. mcp1c_ЗапросыДанных.НовоеЗначение
//              - Неопределено - при ошибке.
//   * Ошибка - Строка - текст ошибки для модели.
//
Функция СпецификацияЗначения(Значение, Типы, Путь) Экспорт

	Результат = Новый Структура("Значение, Ошибка", Неопределено, "");
	Если Значение = Неопределено Тогда
		Результат.Значение = mcp1c_ЗапросыДанных.НовоеЗначение("value");
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() > МаксимумЗначенийСписка() Тогда
			Результат.Ошибка = СтрШаблон("%1: не більше %2 значень у списку", Путь, МаксимумЗначенийСписка());
			Возврат Результат;
		КонецЕсли;
		Список = mcp1c_ЗапросыДанных.НовоеЗначение("list");
		Для Индекс = 0 По Значение.ВГраница() Цикл
			Элемент = Значение[Индекс];
			Если ТипЗнч(Элемент) = Тип("Массив") Тогда
				Результат.Ошибка = СтрШаблон("%1[%2]: вкладені масиви не підтримуються", Путь, Формат(Индекс, "ЧН=0; ЧГ=0"));
				Возврат Результат;
			КонецЕсли;
			РазборЭлемента = СпецификацияЗначения(Элемент, Типы, СтрШаблон("%1[%2]", Путь, Формат(Индекс, "ЧН=0; ЧГ=0")));
			Если Не ПустаяСтрока(РазборЭлемента.Ошибка) Тогда
				Возврат РазборЭлемента;
			КонецЕсли;
			Список.Элементы.Добавить(РазборЭлемента.Значение);
		КонецЦикла;
		Результат.Значение = Список;
		Возврат Результат;
	КонецЕсли;

	ТипыЗначения = Типы;
	Если ТипыЗначения.Количество() = 0 Тогда
		ТипыЗначения = ТипыПоЗначению(Значение);
	КонецЕсли;
	Разбор = mcp1c_ЗапросыДанных.РазобратьЗначение(Значение, ТипыЗначения, Путь);
	Результат.Значение = Разбор.Значение;
	Результат.Ошибка = Разбор.Ошибка;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЗапросыОтчетов

// Таблицы ИБ, которые читает запрос набора данных отчета (с расширением языка запросов компоновки),
// и имена, которые в нем встречаются. Таблица - путь, который начинается с класса таблицы
// (Справочник, РегистрНакопления, Catalog...), вне ЗНАЧЕНИЕ(), ТИП() и типов после КАК и ССЫЛКА.
//
// Параметры:
//  Текст - Строка - текст запроса набора данных.
//
// Возвращаемое значение:
//  Структура:
//   * Таблицы - Массив из Строка - полные имена таблиц без параметров («РегистрНакопления.Продажи.Обороты»).
//   * ВозможныеТаблицы - Массив из Строка - пути, первое имя которых - и класс таблицы, и псевдоним
//                        в этом запросе: таблица, если такой объект есть в метаданных.
//   * Имена - Массив из Строка - имена и части путей без повторов (для глобальных запретов полей).
//   * Ошибка - Строка - текст ошибки; пустая строка - текст разобран.
//
Функция ТаблицыЗапроса(Текст) Экспорт

	Разобранный = Лексемы(Текст);
	Если Не ПустаяСтрока(Разобранный.Ошибка) Тогда
		Результат = Новый Структура;
		Результат.Вставить("Таблицы", Новый Массив);
		Результат.Вставить("ВозможныеТаблицы", Новый Массив);
		Результат.Вставить("Имена", Новый Массив);
		Результат.Вставить("Ошибка", Разобранный.Ошибка);
		Возврат Результат;
	КонецЕсли;
	Возврат ТаблицыЛексем(Разобранный.Лексемы, СловаЯзыка());

КонецФункции

// Имена выражения схемы компоновки (вычисляемого поля, пути к данным): части путей без повторов
// для проверки глобальными запретами полей.
//
// Параметры:
//  Текст - Строка - выражение.
//
// Возвращаемое значение:
//  Массив из Строка - имена.
//
Функция ИменаВыражения(Текст) Экспорт

	Результат = Новый Массив;
	Слова = СловаЯзыка();
	Для Каждого Лексема Из Лексемы(Текст).Лексемы Цикл
		Если Лексема.Вид = "name" И Слова.Ключевые.Получить(Лексема.Ключ) = Неопределено Тогда
			ДобавитьБезПовтора(Результат, Лексема.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РазборЛексем

Функция КонецСтроки(Текст, Позиция, Длина)
	// Позиция последнего символа строки текста (перед переводом строки).

	Конец = Позиция;
	Пока Конец < Длина И Сред(Текст, Конец + 1, 1) <> Символы.ПС Цикл
		Конец = Конец + 1;
	КонецЦикла;
	Возврат Конец;

КонецФункции

Функция ПрочитатьСтроку(Текст, Позиция, Длина, Результат)
	// Строковый литерал с удвоенными кавычками внутри; возвращает позицию после закрывающей кавычки.

	Значение = Новый Массив;
	Текущая = Позиция + 1;
	Пока Текущая <= Длина Цикл
		Символ = Сред(Текст, Текущая, 1);
		Если Символ = """" Тогда
			Если Сред(Текст, Текущая + 1, 1) = """" Тогда
				Значение.Добавить("""");
				Текущая = Текущая + 2;
				Продолжить;
			КонецЕсли;
			Результат.Лексемы.Добавить(НоваяЛексема("string", СтрСоединить(Значение, "")));
			Возврат Текущая + 1;
		КонецЕсли;
		Значение.Добавить(Символ);
		Текущая = Текущая + 1;
	КонецЦикла;
	Результат.Ошибка = "Текст запиту містить незакритий рядок";
	Возврат Длина + 1;

КонецФункции

Функция КонецИмени(Текст, Позиция, Длина)
	// Позиция первого символа после имени.

	Конец = Позиция;
	Пока Конец <= Длина Цикл
		Символ = Сред(Текст, Конец, 1);
		Если Не ЭтоБуква(Символ) И Не ЭтоЦифра(Символ) Тогда
			Прервать;
		КонецЕсли;
		Конец = Конец + 1;
	КонецЦикла;
	Возврат Конец;

КонецФункции

Функция КонецЧисла(Текст, Позиция, Длина)
	// Позиция первого символа после числа с необязательной дробной частью.

	Конец = Позиция;
	Пока Конец <= Длина И ЭтоЦифра(Сред(Текст, Конец, 1)) Цикл
		Конец = Конец + 1;
	КонецЦикла;
	Если Сред(Текст, Конец, 1) = "." И ЭтоЦифра(Сред(Текст, Конец + 1, 1)) Тогда
		Конец = Конец + 1;
		Пока Конец <= Длина И ЭтоЦифра(Сред(Текст, Конец, 1)) Цикл
			Конец = Конец + 1;
		КонецЦикла;
	КонецЕсли;
	Возврат Конец;

КонецФункции

Функция ЭтоБуква(Символ)

	Возврат Символ = "_" Или (Символ <> "" И НРег(Символ) <> ВРег(Символ));

КонецФункции

Функция ЭтоЦифра(Символ)

	Возврат Символ <> "" И СтрНайти("0123456789", Символ) > 0;

КонецФункции

Функция ЭтоЗнак(Поток, Индекс, Знак)

	Возврат Индекс >= 0 И Индекс <= Поток.ВГраница() И Поток[Индекс].Вид = "sign" И Поток[Индекс].Текст = Знак;

КонецФункции

Функция ЭтоИмя(Поток, Индекс)

	Возврат Индекс >= 0 И Индекс <= Поток.ВГраница() И Поток[Индекс].Вид = "name";

КонецФункции

Функция КонецПути(Поток, Индекс)
	// Индекс последнего имени пути «Имя.Имя.Имя», который начинается с Индекс; если там не имя - Индекс - 1.

	Если Не ЭтоИмя(Поток, Индекс) Тогда
		Возврат Индекс - 1;
	КонецЕсли;
	Последний = Индекс;
	Пока ЭтоЗнак(Поток, Последний + 1, ".") И ЭтоИмя(Поток, Последний + 2) Цикл
		Последний = Последний + 2;
	КонецЦикла;
	Возврат Последний;

КонецФункции

Функция ЧастиПути(Поток, Первый, Последний)

	Части = Новый Массив;
	Индекс = Первый;
	Пока Индекс <= Последний Цикл
		Части.Добавить(Поток[Индекс].Текст);
		Индекс = Индекс + 2;
	КонецЦикла;
	Возврат Части;

КонецФункции

Функция ЗакрывающаяСкобка(Поток, Открывающая)
	// Индекс скобки, закрывающей скобку Открывающая; без пары - последний индекс.

	Глубина = 0;
	Для Индекс = Открывающая По Поток.ВГраница() Цикл
		Если ЭтоЗнак(Поток, Индекс, "(") Тогда
			Глубина = Глубина + 1;
		ИначеЕсли ЭтоЗнак(Поток, Индекс, ")") Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Индекс;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Поток.ВГраница();

КонецФункции

Функция ЗвездочкаВместоПолей(Поток, Индекс)
	// «*» вместо перечня полей: «Т.*», «ВЫБРАТЬ *», «, *», «ПЕРВЫЕ 10 *». КОЛИЧЕСТВО(*) и умножение - не перечень.

	Если Индекс = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Предыдущая = Поток[Индекс - 1];
	Если Предыдущая.Вид = "sign" Тогда
		Возврат Предыдущая.Текст = "." Или Предыдущая.Текст = ",";
	ИначеЕсли Предыдущая.Вид = "name" Тогда
		Возврат СловаЯзыка().ПередЗвездочкой.Получить(Предыдущая.Ключ) <> Неопределено;
	ИначеЕсли Предыдущая.Вид = "number" И Индекс > 1 Тогда
		Возврат Поток[Индекс - 2].Вид = "name" И (Поток[Индекс - 2].Ключ = "ПЕРВЫЕ" Или Поток[Индекс - 2].Ключ = "TOP");
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Таблицы и имена в лексемах запроса (см. ТаблицыЗапроса).
//
// Параметры:
//  Поток - Массив из см. НоваяЛексема
//  Слова - Структура - ключевые слова по группам (см. СловаЯзыка).
//
// Возвращаемое значение:
//  Структура:
//   * Таблицы - Массив из Строка - полные имена таблиц без параметров.
//   * ВозможныеТаблицы - Массив из Строка - пути, первое имя которых - и класс таблицы, и псевдоним.
//   * Имена - Массив из Строка - имена и части путей без повторов.
//   * Ошибка - Строка - текст ошибки; пустая строка - таблиц Константы нет.
//
Функция ТаблицыЛексем(Поток, Слова)

	Результат = Новый Структура;
	Результат.Вставить("Таблицы", Новый Массив);
	Результат.Вставить("ВозможныеТаблицы", Новый Массив);
	Результат.Вставить("Имена", Новый Массив);
	Результат.Вставить("Ошибка", "");
	Псевдонимы = ПсевдонимыТекста(Поток, Слова);
	Индекс = 0;
	Пока Индекс <= Поток.ВГраница() Цикл
		Лексема = Поток[Индекс];
		Если Лексема.Вид <> "name" Тогда
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Слова.ПередТипом.Получить(Лексема.Ключ) <> Неопределено Тогда
			Индекс = КонецПути(Поток, Индекс + 1) + 1;
			Продолжить;
		ИначеЕсли Слова.ТаблицаКонстант.Получить(Лексема.Ключ) <> Неопределено И Не ЭтоЗнак(Поток, Индекс - 1, ".") Тогда
			Результат.Ошибка = СтрШаблон("Запит читає таблицю %1: вона не підтримується", Лексема.Текст);
			Возврат Результат;
		КонецЕсли;
		Последний = КонецПути(Поток, Индекс);
		Части = ЧастиПути(Поток, Индекс, Последний);
		Если Части.Количество() = 1 И ЭтоЗнак(Поток, Последний + 1, "(") Тогда
			Если Слова.ТипИлиЗначение.Получить(Лексема.Ключ) <> Неопределено Тогда
				Индекс = ЗакрывающаяСкобка(Поток, Последний + 1) + 1;
			Иначе
				Индекс = Последний + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Части.Количество() > 1 И Слова.Классы.Получить(ВРег(Части[0])) <> Неопределено Тогда
			Таблица = СтрСоединить(Части, ".");
			Если Псевдонимы.Получить(НРег(Части[0])) <> Неопределено Тогда
				ДобавитьБезПовтора(Результат.ВозможныеТаблицы, Таблица);
			Иначе
				ДобавитьБезПовтора(Результат.Таблицы, Таблица);
			КонецЕсли;
		ИначеЕсли Части.Количество() > 1 Или Слова.Ключевые.Получить(Лексема.Ключ) = Неопределено Тогда
			Для Каждого Часть Из Части Цикл
				ДобавитьБезПовтора(Результат.Имена, Часть);
			КонецЦикла;
		КонецЕсли;
		Индекс = Последний + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПсевдонимыТекста(Поток, Слова)
	// Имена после КАК без точки: псевдонимы источников и колонок в нижнем регистре (тип в ВЫРАЗИТЬ -
	// путь через точку или имя примитивного типа).

	Результат = Новый Соответствие;
	Для Индекс = 0 По Поток.ВГраница() - 1 Цикл
		Если Поток[Индекс].Вид = "name" И Слова.ПередТипом.Получить(Поток[Индекс].Ключ) <> Неопределено
			И ЭтоИмя(Поток, Индекс + 1) И Не ЭтоЗнак(Поток, Индекс + 2, ".") Тогда
			Результат.Вставить(НРег(Поток[Индекс + 1].Текст), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Проверка

Функция НоваяПроверка(Разбор, Описания, Политика, Результат)
	// Состояние проверки пакета: псевдонимы, таблицы по именам, колонки и временные таблицы.

	Проверка = Новый Структура;
	Проверка.Вставить("Политика", Политика);
	Проверка.Вставить("Описания", Описания);
	Проверка.Вставить("Результат", Результат);
	Проверка.Вставить("Слова", СловаЯзыка());
	Проверка.Вставить("Псевдонимы", Новый Соответствие);
	Проверка.Вставить("Таблицы", Новый Соответствие);
	Проверка.Вставить("ВременныеТаблицы", Разбор.ВременныеТаблицы);
	Колонки = Новый Соответствие;
	Для Каждого Колонка Из Разбор.Колонки Цикл
		Колонки.Вставить(НРег(Колонка), Истина);
	КонецЦикла;
	Проверка.Вставить("Колонки", Колонки);
	Проверка.Вставить("ИсточникиТаблиц", Новый Массив);
	Возврат Проверка;

КонецФункции

Функция Остановлена(Проверка)

	Результат = Проверка.Результат;
	Возврат Не ПустаяСтрока(Результат.Ошибка) Или Не ПустаяСтрока(Результат.НужноОписание);

КонецФункции

Процедура Остановить(Проверка, ТекстОшибки, Причина = "")

	Если ПустаяСтрока(Проверка.Результат.Ошибка) Тогда
		Проверка.Результат.Ошибка = ТекстОшибки;
		Проверка.Результат.Причина = Причина;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИсточники(Разбор, Проверка)
	// Таблицы источников - по правилам объектов профиля; псевдоним - одно источник на весь пакет.

	Для Каждого Источник Из Разбор.Источники Цикл
		Если Источник.Вид = "table" Тогда
			ПроверитьТаблицуИсточника(Источник, Проверка);
		КонецЕсли;
		Если Остановлена(Проверка) Тогда
			Возврат;
		КонецЕсли;
		ЗарегистрироватьПсевдоним(Источник, Проверка);
		Если Остановлена(Проверка) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТаблицуИсточника(Источник, Проверка)
	// Таблица ИБ: поддерживается, читается профилем без ограничений строк и обязательного отбора по периоду.

	Политика = Проверка.Политика;
	Описание = Источник.Описание;
	ТекстНедоступна = СтрШаблон("Таблицю «%1» не знайдено, вона недоступна або не читається execute_query. "
		+ "Перевірте ім'я через list_objects.", Источник.Имя);
	Если Описание = Неопределено Тогда
		Остановить(Проверка, ТекстНедоступна);
		Возврат;
	КонецЕсли;
	Объект = Описание.Объект;
	Если mcp1c_ПравилаДоступа.ТолькоАгрегаты(Политика, Объект) Тогда
		Остановить(Проверка, СтрШаблон("«%1» доступний лише в агрегатах: execute_query такі об'єкти не читає, "
			+ "використовуйте query_records з aggregates і group_by", Объект), "Лише агрегати: " + Объект);
		Возврат;
	КонецЕсли;
	Доступна = mcp1c_ПравилаДоступа.ОбъектЧитается(Политика, Объект);
	Если Доступна И Описание.ВидТаблицы = "tabular_section" Тогда
		Доступна = mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(Политика, Объект,
			Лев(Описание.ПрефиксПолейПолитики, СтрДлина(Описание.ПрефиксПолейПолитики) - 1));
	КонецЕсли;
	Если Не Доступна Тогда
		Остановить(Проверка, ТекстНедоступна, "Об'єкт заборонений політикою: " + Описание.Имя);
		Возврат;
	КонецЕсли;
	Если mcp1c_ПравилаДоступа.ОграниченияСтрок(Политика, Объект).Количество() > 0 Тогда
		Остановить(Проверка, СтрШаблон("До «%1» профіль застосовує обмеження рядків: execute_query такі об'єкти "
			+ "не читає, використовуйте query_records", Объект), "Обмеження рядків: " + Объект);
		Возврат;
	КонецЕсли;
	Если mcp1c_ПравилаДоступа.ТребуетсяОтборПоПериоду(Политика, Объект) Тогда
		Остановить(Проверка, СтрШаблон("«%1» вимагає відбору за періодом: execute_query такі об'єкти не читає, "
			+ "використовуйте query_records з period", Объект), "Обов'язковий фільтр періоду: " + Объект);
		Возврат;
	КонецЕсли;
	ДобавитьБезПовтора(Проверка.Результат.Объекты, Объект);
	Проверка.Таблицы.Вставить(НРег(Источник.Имя), Источник);
	Проверка.ИсточникиТаблиц.Добавить(Источник);

КонецПроцедуры

Процедура ЗарегистрироватьПсевдоним(Источник, Проверка)
	// Псевдоним задает источник для путей во всем пакете: один псевдоним - одна таблица.

	Ключ = НРег(Источник.Псевдоним);
	Если Проверка.Слова.Классы.Получить(ВРег(Источник.Псевдоним)) <> Неопределено Тогда
		Остановить(Проверка, СтрШаблон("Псевдонім «%1» збігається з класом таблиць: задайте інший псевдонім",
			Источник.Псевдоним));
		Возврат;
	КонецЕсли;
	Прежний = Проверка.Псевдонимы.Получить(Ключ);
	Если Прежний = Неопределено Тогда
		Проверка.Псевдонимы.Вставить(Ключ, Источник);
		Возврат;
	КонецЕсли;
	Если Источник.Вид = "nested" Или Прежний.Вид <> Источник.Вид Или НРег(Прежний.Имя) <> НРег(Источник.Имя) Тогда
		Остановить(Проверка, СтрШаблон("Псевдонім «%1» використано для різних джерел: задайте унікальні псевдоніми "
			+ "в усьому пакеті запитів", Источник.Псевдоним));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьТаблицыТекста(Поток, Проверка)
	// Каждая таблица в тексте - проверенный источник: таблицы вложенных запросов в условиях схема запроса
	// не показывает.

	Таблицы = ТаблицыЛексем(Поток, Проверка.Слова);
	Если Не ПустаяСтрока(Таблицы.Ошибка) Тогда
		Остановить(Проверка, Таблицы.Ошибка);
		Возврат;
	КонецЕсли;
	Для Каждого Список Из Новый Структура("Таблицы, ВозможныеТаблицы", Таблицы.Таблицы, Таблицы.ВозможныеТаблицы) Цикл
		Для Каждого Таблица Из Список.Значение Цикл
			Если Проверка.Таблицы.Получить(НРег(Таблица)) = Неопределено Тогда
				Остановить(Проверка, ОшибкаТаблицыВнеИсточников(Таблица));
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЛексемы(Поток, Проверка)
	// Обход лексем: каждое имя и путь вне типов и псевдонимов проверяется политикой.

	Слова = Проверка.Слова;
	ПараметрыТаблицы = Неопределено;
	Индекс = 0;
	Пока Индекс <= Поток.ВГраница() И Не Остановлена(Проверка) Цикл
		Если ПараметрыТаблицы <> Неопределено И Индекс > ПараметрыТаблицы.Конец Тогда
			ПараметрыТаблицы = Неопределено;
		КонецЕсли;
		Лексема = Поток[Индекс];
		Если Лексема.Вид <> "name" Тогда
			ПроверитьЗнак(Поток, Индекс, Проверка);
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Слова.ПередТипом.Получить(Лексема.Ключ) <> Неопределено Тогда
			Индекс = КонецПути(Поток, Индекс + 1) + 1;
			Продолжить;
		ИначеЕсли Слова.ПередИменемТаблицы.Получить(Лексема.Ключ) <> Неопределено Тогда
			Индекс = Индекс + 2;
			Продолжить;
		КонецЕсли;
		ПроверитьКлючевоеСлово(Поток, Индекс, Проверка);
		Если Остановлена(Проверка) Тогда
			Возврат;
		КонецЕсли;

		Последний = КонецПути(Поток, Индекс);
		Части = ЧастиПути(Поток, Индекс, Последний);
		Далее = Последний + 1;
		Если Части.Количество() = 1 И ЭтоЗнак(Поток, Далее, "(") Тогда
			// Функция или ключевое слово перед скобкой (В, ИЕРАРХИИ); в ЗНАЧЕНИЕ() и ТИП() - имена метаданных.
			Если Слова.ТипИлиЗначение.Получить(Лексема.Ключ) <> Неопределено Тогда
				Индекс = ЗакрывающаяСкобка(Поток, Далее) + 1;
			ИначеЕсли Слова.ЗапрещенныеФункции.Получить(Лексема.Ключ) <> Неопределено Тогда
				Остановить(Проверка, СтрШаблон("Функція %1 не підтримується: посилання в результаті повертаються "
					+ "з представленням, яке дозволяє профіль", ВРег(Лексема.Текст)));
			Иначе
				Индекс = Далее;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ЭтоЗнак(Поток, Далее, ".") Тогда
			Если ЭтоЗнак(Поток, Далее + 1, "*") Тогда
				Остановить(Проверка, ОшибкаЗвездочки());
			Иначе
				Остановить(Проверка, СтрШаблон("Вибірка табличної частини через «%1.(...)» не підтримується: "
					+ "вибирайте з таблиці табличної частини (Документ.<Ім'я>.<ТабличнаяЧасть>)", СтрСоединить(Части, ".")));
			КонецЕсли;
			Возврат;
		КонецЕсли;
		Если Части.Количество() = 1 И Слова.Ключевые.Получить(Лексема.Ключ) <> Неопределено Тогда
			Индекс = Далее;
			Продолжить;
		КонецЕсли;

		Если Части.Количество() > 1 И Слова.Классы.Получить(ВРег(Части[0])) <> Неопределено Тогда
			Источник = Проверка.Таблицы.Получить(НРег(СтрСоединить(Части, ".")));
			Если Источник = Неопределено Тогда
				Остановить(Проверка, ОшибкаТаблицыВнеИсточников(СтрСоединить(Части, ".")));
				Возврат;
			КонецЕсли;
			Если ЭтоЗнак(Поток, Далее, "(") Тогда
				ПараметрыТаблицы = Новый Структура("Источник, Конец", Источник, ЗакрывающаяСкобка(Поток, Далее));
			КонецЕсли;
		ИначеЕсли ПараметрыТаблицы <> Неопределено Тогда
			ПроверитьПутьВПараметрахТаблицы(Части, ПараметрыТаблицы.Источник, Проверка);
		Иначе
			ПроверитьПуть(Части, Проверка);
		КонецЕсли;
		Индекс = Далее;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЗнак(Поток, Индекс, Проверка)
	// Разыменование результата выражения и параметра, «*» вместо полей.

	Лексема = Поток[Индекс];
	Если (Лексема.Вид = "param" Или ЭтоЗнак(Поток, Индекс, ")")) И ЭтоЗнак(Поток, Индекс + 1, ".") Тогда
		Остановить(Проверка, "Розіменування результату виразу або параметра («ВЫРАЗИТЬ(...).Поле») не підтримується: "
			+ "з'єднайте таблицю, поле якої потрібне, і перевірте тип через ССЫЛКА");
	ИначеЕсли ЭтоЗнак(Поток, Индекс, "*") И ЗвездочкаВместоПолей(Поток, Индекс) Тогда
		Остановить(Проверка, ОшибкаЗвездочки());
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКлючевоеСлово(Поток, Индекс, Проверка)
	// Конструкции, которые не читают данные или не выдаются: ИТОГИ, ДЛЯ ИЗМЕНЕНИЯ.

	Ключ = Поток[Индекс].Ключ;
	Если Ключ = "ИТОГИ" Или Ключ = "TOTALS" Тогда
		Остановить(Проверка, "ИТОГИ не підтримуються: підсумки рахуйте агрегатними функціями з СГРУППИРОВАТЬ ПО");
	ИначеЕсли ЭтоИмя(Поток, Индекс + 1)
		И (Ключ = "ДЛЯ" И Поток[Индекс + 1].Ключ = "ИЗМЕНЕНИЯ" Или Ключ = "FOR" И Поток[Индекс + 1].Ключ = "UPDATE") Тогда
		Остановить(Проверка, "ДЛЯ ИЗМЕНЕНИЯ не дозволено: запити лише читають дані");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПуть(Части, Проверка)
	// Имя или путь вне параметров виртуальной таблицы: псевдоним источника, временная таблица
	// или поле без псевдонима.

	Первое = НРег(Части[0]);
	Если Части.Количество() = 1 Тогда
		Если Проверка.Колонки.Получить(Первое) <> Неопределено Или Проверка.Псевдонимы.Получить(Первое) <> Неопределено
			Или Проверка.ВременныеТаблицы.Получить(Первое) <> Неопределено
			Или Проверка.Слова.Мягкие.Получить(ВРег(Части[0])) <> Неопределено Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Источник = Проверка.Псевдонимы.Получить(Первое);
		Если Источник <> Неопределено Тогда
			ПроверитьПолеИсточника(Источник, Части, 1, Проверка);
			Возврат;
		КонецЕсли;
		Колонки = Проверка.ВременныеТаблицы.Получить(Первое);
		Если Колонки <> Неопределено Тогда
			ПроверитьКолонку(Части, 1, Части[0], Колонки, Проверка);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Не ПроверитьПолеВИсточниках(Части, Проверка) И Не Остановлена(Проверка) Тогда
		Остановить(Проверка, СтрШаблон("Невідоме ім'я «%1» у запиті: поля вказуйте з псевдонімом таблиці (Т.Поле)",
			СтрСоединить(Части, ".")));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПутьВПараметрахТаблицы(Части, Источник, Проверка)
	// Имя в параметрах виртуальной таблицы (условие, периодичность): поле этой таблицы проверяется всегда,
	// даже если так же называется колонка результата.

	Если mcp1c_ПутиПолей.НайтиПоле(Источник.Описание, Части[0]) <> Неопределено Тогда
		ПроверитьПолеИсточника(Источник, Части, 0, Проверка);
	ИначеЕсли Части.Количество() > 1 Или Проверка.Слова.Мягкие.Получить(ВРег(Части[0])) = Неопределено Тогда
		ПроверитьПуть(Части, Проверка);
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьПолеВИсточниках(Части, Проверка)
	// Поле без псевдонима: проверяется в каждом источнике, где оно есть. Ложь - такого поля нет.

	Найдено = Ложь;
	Для Каждого Источник Из Проверка.ИсточникиТаблиц Цикл
		Если mcp1c_ПутиПолей.НайтиПоле(Источник.Описание, Части[0]) <> Неопределено Тогда
			Найдено = Истина;
			ПроверитьПолеИсточника(Источник, Части, 0, Проверка);
			Если Остановлена(Проверка) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Проверка.Псевдонимы Цикл
		Источник = Элемент.Значение;
		Если Источник.Вид <> "table" И ЕстьСтрокаБезУчетаРегистра(Источник.Колонки, Части[0]) Тогда
			Найдено = Истина;
			ПроверитьКолонку(Части, 0, Источник.Псевдоним, Источник.Колонки, Проверка);
			Если Остановлена(Проверка) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

Процедура ПроверитьПолеИсточника(Источник, Части, Начало, Проверка)
	// Путь от поля источника: для таблицы ИБ - разбор с проверкой каждого звена, для временной таблицы
	// и вложенного запроса - колонка без разыменования.

	Если Источник.Вид <> "table" Тогда
		ПроверитьКолонку(Части, Начало, Источник.Псевдоним, Источник.Колонки, Проверка);
		Возврат;
	КонецЕсли;
	ЧастиПоля = Новый Массив;
	Для Индекс = Начало По Части.ВГраница() Цикл
		ЧастиПоля.Добавить(Части[Индекс]);
	КонецЦикла;
	Разбор = mcp1c_ПутиПолей.РазобратьПуть(Источник.Описание, СтрСоединить(ЧастиПоля, "."), Проверка.Описания,
		Проверка.Политика);
	Если Не ПустаяСтрока(Разбор.НужноОписание) Тогда
		Проверка.Результат.НужноОписание = Разбор.НужноОписание;
	ИначеЕсли Не Разбор.Успех Тогда
		Остановить(Проверка, Разбор.Ошибка);
	ИначеЕсли Разбор.Маска <> Неопределено Тогда
		Остановить(Проверка, СтрШаблон("Поле «%1» масковане профілем: execute_query не читає замасковані поля, "
			+ "їх повертає query_records", Разбор.Путь));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКолонку(Части, Начало, ИмяИсточника, Колонки, Проверка)
	// Колонка временной таблицы или вложенного запроса: без разыменования (типы колонок неизвестны).

	Если Части.Количество() - Начало > 1 Тогда
		Остановить(Проверка, СтрШаблон("Розіменування колонок тимчасових таблиць і вкладених запитів не підтримується "
			+ "(«%1»): розіменуйте поле в запиті, який їх створює", СтрСоединить(Части, ".")));
	ИначеЕсли Части.Количество() = Начало Или Не ЕстьСтрокаБезУчетаРегистра(Колонки, Части[Начало]) Тогда
		Остановить(Проверка, СтрШаблон("Колонку «%1» не знайдено в «%2»", СтрСоединить(Части, "."), ИмяИсточника));
	КонецЕсли;

КонецПроцедуры

Функция ОшибкаТаблицыВнеИсточников(Таблица)

	Возврат СтрШаблон("Таблиця «%1» - не джерело, яке перевірив сервер: вкладені запити в умовах (В (ВЫБРАТЬ ...)) "
		+ "не підтримуються - помістіть вибірку в тимчасову таблицю (ПОМЕСТИТЬ) і з'єднайте з нею", Таблица);

КонецФункции

Функция ОшибкаЗвездочки()

	Возврат "«*» не підтримується: перелічіть поля явно (перелік полів дає describe_object)";

КонецФункции

#КонецОбласти

#Область ЗначенияПараметров

Функция ТипыПоЗначению(Значение)
	// Типы параметра, которые платформа не вывела: по значению JSON.

	Типы = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Типы.Добавить(?(mcp1c_Служебный.РазобратьДату(Значение) = Неопределено, "Строка", "Дата"));
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Типы.Добавить("Число");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Типы.Добавить("Булево");
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") И ТипЗнч(Значение.Получить("type")) = Тип("Строка") Тогда
		Типы.Добавить(mcp1c_ЗапросыДанных.НормализованноеИмяТипа(Значение.Получить("type")));
	КонецЕсли;
	Возврат Типы;

КонецФункции

Функция МаксимумЗначенийСписка()

	Возврат 1000;

КонецФункции

#КонецОбласти

#Область Слова

Функция СловаЯзыка()
	// Ключевые слова языка запросов (русские и английские) по группам; ключи - в верхнем регистре.

	Слова = Новый Структура;
	Слова.Вставить("Ключевые", НаборСлов("ВЫБРАТЬ,РАЗРЕШЕННЫЕ,РАЗЛИЧНЫЕ,ПЕРВЫЕ,ИЗ,ГДЕ,И,ИЛИ,НЕ,В,ИЕРАРХИИ,МЕЖДУ,ПОДОБНО,"
		+ "СПЕЦСИМВОЛ,ЕСТЬ,NULL,СГРУППИРОВАТЬ,ПО,ИМЕЮЩИЕ,УПОРЯДОЧИТЬ,ВОЗР,УБЫВ,ИТОГИ,ОБЩИЕ,ТОЛЬКО,ИЕРАРХИЯ,"
		+ "ПЕРИОДАМИ,ОБЪЕДИНИТЬ,ВСЕ,ЛЕВОЕ,ПРАВОЕ,ПОЛНОЕ,ВНУТРЕННЕЕ,ВНЕШНЕЕ,СОЕДИНЕНИЕ,ВЫБОР,КОГДА,ТОГДА,ИНАЧЕ,"
		+ "КОНЕЦ,ИСТИНА,ЛОЖЬ,НЕОПРЕДЕЛЕНО,ИНДЕКСИРОВАТЬ,АВТОУПОРЯДОЧИВАНИЕ,ДЛЯ,ИЗМЕНЕНИЯ,ГРУППИРУЮЩИМ,НАБОРАМ,"
		+ "SELECT,ALLOWED,DISTINCT,TOP,FROM,WHERE,AND,OR,NOT,IN,HIERARCHY,BETWEEN,LIKE,ESCAPE,IS,GROUP,BY,HAVING,"
		+ "ORDER,ASC,DESC,TOTALS,OVERALL,ONLY,PERIODS,UNION,ALL,LEFT,RIGHT,FULL,INNER,OUTER,JOIN,ON,CASE,WHEN,"
		+ "THEN,ELSE,END,TRUE,FALSE,UNDEFINED,INDEX,AUTOORDER,FOR,UPDATE,GROUPING,SETS"));
	// Периодичности и границы - ключевые слова только в аргументах функций дат и параметрах виртуальных
	// таблиц; так же могут называться поля.
	Слова.Вставить("Мягкие", НаборСлов("СЕКУНДА,МИНУТА,ЧАС,ДЕНЬ,НЕДЕЛЯ,МЕСЯЦ,КВАРТАЛ,ГОД,ДЕКАДА,ПОЛУГОДИЕ,АВТО,"
		+ "РЕГИСТРАТОР,ЗАПИСЬ,SECOND,MINUTE,HOUR,DAY,WEEK,MONTH,QUARTER,YEAR,TENDAYS,HALFYEAR,AUTO,RECORDER,RECORD"));
	Слова.Вставить("ПередТипом", НаборСлов("КАК,AS,ССЫЛКА,REFS"));
	Слова.Вставить("ПередИменемТаблицы", НаборСлов("ПОМЕСТИТЬ,INTO,УНИЧТОЖИТЬ,DROP"));
	Слова.Вставить("ТипИлиЗначение", НаборСлов("ЗНАЧЕНИЕ,VALUE,ТИП,TYPE"));
	Слова.Вставить("ЗапрещенныеФункции", НаборСлов("ПРЕДСТАВЛЕНИЕ,ПРЕДСТАВЛЕНИЕССЫЛКИ,PRESENTATION,REFPRESENTATION,"
		+ "СТРОКА,STRING,УНИКАЛЬНЫЙИДЕНТИФИКАТОР,UUID"));
	Слова.Вставить("ПередЗвездочкой", НаборСлов("ВЫБРАТЬ,РАЗЛИЧНЫЕ,РАЗРЕШЕННЫЕ,SELECT,DISTINCT,ALLOWED"));
	Слова.Вставить("ТаблицаКонстант", НаборСлов("КОНСТАНТЫ,CONSTANTS"));
	Слова.Вставить("Классы", НаборСлов("СПРАВОЧНИК,ДОКУМЕНТ,ЖУРНАЛДОКУМЕНТОВ,ПЕРЕЧИСЛЕНИЕ,ПЛАНВИДОВХАРАКТЕРИСТИК,"
		+ "ПЛАНСЧЕТОВ,ПЛАНВИДОВРАСЧЕТА,РЕГИСТРСВЕДЕНИЙ,РЕГИСТРНАКОПЛЕНИЯ,РЕГИСТРБУХГАЛТЕРИИ,РЕГИСТРРАСЧЕТА,"
		+ "БИЗНЕСПРОЦЕСС,ЗАДАЧА,КОНСТАНТА,ПЛАНОБМЕНА,ПОСЛЕДОВАТЕЛЬНОСТЬ,КРИТЕРИЙОТБОРА,ВНЕШНИЙИСТОЧНИКДАННЫХ,"
		+ "CATALOG,DOCUMENT,DOCUMENTJOURNAL,ENUM,CHARTOFCHARACTERISTICTYPES,CHARTOFACCOUNTS,CHARTOFCALCULATIONTYPES,"
		+ "INFORMATIONREGISTER,ACCUMULATIONREGISTER,ACCOUNTINGREGISTER,CALCULATIONREGISTER,BUSINESSPROCESS,TASK,"
		+ "CONSTANT,EXCHANGEPLAN,SEQUENCE,FILTERCRITERION,EXTERNALDATASOURCE"));
	Возврат Слова;

КонецФункции

Функция НаборСлов(Список)

	Результат = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить(Список, ",", Ложь) Цикл
		Результат.Вставить(ВРег(СокрЛП(Слово)), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Прочее

Процедура ДобавитьБезПовтора(Массив, Значение)

	Если Не ЕстьСтрокаБезУчетаРегистра(Массив, Значение) Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Функция ЕстьСтрокаБезУчетаРегистра(Массив, Значение)

	Искомое = НРег(Значение);
	Для Каждого Элемент Из Массив Цикл
		Если НРег(Элемент) = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#КонецОбласти

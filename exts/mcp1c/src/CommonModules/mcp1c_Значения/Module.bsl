///////////////////////////////////////////////////////////////////////////////
// mcp1c_Значения: значения параметров запросов из спецификаций mcp1c_ЗапросыДанных
// и значения результата в формате JSON (п. 5.4 ТЗ).
//
// Ссылки - {"type", "ref", "presentation"}; перечисления - {"type", "value", "presentation"};
// ссылка на объект, представление которого клиенту недоступно, - {"type", "presentation": "<приховано>"};
// если поля представления замаскированы - {"type", "ref", "presentation": "***"}.
// Значения замаскированных колонок проходят через mcp1c_Маскирование (п. 7.4 ТЗ).
// Представления берутся только из колонок запроса (ПРЕДСТАВЛЕНИЕССЫЛКИ): обращение к ссылке
// вне привилегированного режима читало бы данные по правам технического пользователя.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область ПараметрыЗапроса

// Значения параметров запроса по спецификациям.
//
// Параметры:
//  Параметры - Соответствие из КлючИЗначение - параметры запроса:
//   * Ключ - Строка - имя параметра.
//   * Значение - см. mcp1c_ЗапросыДанных.НовоеЗначение
//
// Возвращаемое значение:
//  Структура:
//   * Значения - Соответствие из КлючИЗначение - имя параметра и значение платформы.
//   * Ошибка - Строка - текст ошибки для модели; пустая строка, если все значения получены.
//
Функция ЗначенияПараметров(Параметры) Экспорт

	Результат = Новый Структура("Значения, Ошибка", Новый Соответствие, "");
	Для Каждого Элемент Из Параметры Цикл
		Ошибка = "";
		Значение = ЗначениеПараметра(Элемент.Значение, Ошибка);
		Если Не ПустаяСтрока(Ошибка) Тогда
			Результат.Ошибка = Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат.Значения.Вставить(Элемент.Ключ, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ссылка на объект по полному имени и уникальному идентификатору (п. 5.2 ТЗ:
// менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ref))).
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных из описания поля.
//  Идентификатор - Строка - уникальный идентификатор в формате 8-4-4-4-12.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - ссылка; Неопределено, если вид объекта не поддерживается.
//
Функция СсылкаПоИдентификатору(ПолноеИмя, Идентификатор) Экспорт

	Менеджер = МенеджерОбъекта(ПолноеИмя);
	Если Менеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));

КонецФункции

#КонецОбласти

#Область Результат

// Контекст преобразования значений результата: кеш имен типов и доступности представлений.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  МаксимальнаяДлинаСтроки - Число - длина строк, после которой они обрезаются.
//
// Возвращаемое значение:
//  Структура:
//   * Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//   * МаксимальнаяДлинаСтроки - Число - длина строк, после которой они обрезаются.
//   * ИменаТипов - Соответствие из КлючИЗначение - кеш полных имен ссылочных типов:
//     ** Ключ - Тип - тип значения.
//     ** Значение - Строка - полное имя объекта метаданных; пустая строка - тип не ссылочный.
//   * ДоступностьПредставлений - Соответствие из КлючИЗначение - кеш доступа к представлениям:
//     ** Ключ - Строка - полное имя объекта метаданных.
//     ** Значение - Строка - visible, masked или hidden (см. mcp1c_ПравилаДоступа.ДоступПредставления).
//
Функция НовыйКонтекстПреобразования(Политика, МаксимальнаяДлинаСтроки) Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Политика", Политика);
	Контекст.Вставить("МаксимальнаяДлинаСтроки", МаксимальнаяДлинаСтроки);
	Контекст.Вставить("ИменаТипов", Новый Соответствие);
	Контекст.Вставить("ДоступностьПредставлений", Новый Соответствие);
	Возврат Контекст;

КонецФункции

// Значение результата запроса в формате JSON.
//
// Параметры:
//  Значение - Произвольный - значение из выборки.
//  Представление - Строка, Неопределено - представление ссылки из колонки запроса.
//  Контекст - см. НовыйКонтекстПреобразования
//  Маска - Неопределено, Структура - маска колонки (см. mcp1c_Маскирование.НоваяМаска).
//
// Возвращаемое значение:
//  - Строка, Число, Булево, Неопределено - простое значение.
//  - Соответствие из КлючИЗначение - ссылка или перечисление: type, ref, value, presentation.
//
Функция ЗначениеВJSON(Значение, Представление, Контекст, Маска = Неопределено) Экспорт

	Результат = ЗначениеБезМаски(Значение, Представление, Контекст);
	Если Маска = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Возврат mcp1c_Маскирование.ЗамаскированноеЗначение(Результат, Маска, Контекст.Политика.СольМаскирования,
		КлючХеша(Значение, Контекст));

КонецФункции

// Представление ссылки на объект, представление которого клиенту недоступно.
//
// Возвращаемое значение:
//  Строка - текст.
//
Функция ПредставлениеСкрытого() Экспорт

	Возврат "<приховано>";

КонецФункции

// Представления ссылок для результата, колонки которого задал не построитель запросов
// (пользовательский инструмент): ПРЕДСТАВЛЕНИЕ по таблицам объектов одним запросом
// в привилегированном режиме. Ссылки на объекты со скрытым представлением не читаются.
//
// Параметры:
//  Значения - Массив из Произвольный - значения результата; прочие типы и пустые ссылки пропускаются.
//  Контекст - см. НовыйКонтекстПреобразования
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - представления по ссылкам:
//   * Ключ - Произвольный - ссылка.
//   * Значение - Строка - представление.
//
Функция ПредставленияСсылок(Значения, Контекст) Экспорт

	Результат = Новый Соответствие;
	Ссылки = Новый Массив;
	Таблицы = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		ИмяТипа = ИмяТипаДляПредставления(Значение, Контекст);
		Если ИмяТипа = Неопределено Или Результат.Получить(Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Значение, "");
		Ссылки.Добавить(Значение);
		Если Таблицы.Найти(ИмяТипа) = Неопределено Тогда
			Таблицы.Добавить(ИмяТипа);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Имена таблиц - полные имена объектов метаданных, значения - только параметром.
	Строки = Новый Массив;
	Для Каждого ИмяТаблицы Из Таблицы Цикл
		Если Строки.Количество() > 0 Тогда
			Строки.Добавить("ОБЪЕДИНИТЬ ВСЕ");
		КонецЕсли;
		Строки.Добавить("ВЫБРАТЬ");
		Строки.Добавить("	Т.Ссылка КАК Ссылка,");
		Строки.Добавить("	ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК Представление");
		Строки.Добавить("ИЗ");
		Строки.Добавить("	" + ИмяТаблицы + " КАК Т");
		Строки.Добавить("ГДЕ");
		Строки.Добавить("	Т.Ссылка В (&Ссылки)");
	КонецЦикла;
	Запрос = Новый Запрос(СтрСоединить(Строки, Символы.ПС));
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = mcp1c_ВыполнениеЗапросов.ВыполнитьПривилегированно(Запрос).Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Строка(Выборка.Представление));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеБезМаски(Значение, Представление, Контекст)

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат mcp1c_Сериализация.ОчищенныйТекст(Значение, Контекст.МаксимальнаяДлинаСтроки);
	ИначеЕсли ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ?(Значение = Дата(1, 1, 1), Неопределено, mcp1c_Служебный.ДатаВСтроку(Значение));
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	ИмяТипа = ИмяСсылочногоТипа(ТипЗначения, Контекст);
	Если ИмяТипа = Неопределено Тогда
		// Системные перечисления (вид движения и т. п.) и прочие типы - строкой.
		Возврат mcp1c_Сериализация.ОчищенныйТекст(Строка(Значение), Контекст.МаксимальнаяДлинаСтроки);
	КонецЕсли;
	Если Значение.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Соответствие;
	Результат.Вставить("type", ИмяТипа);
	ТекстПредставления = ?(ТипЗнч(Представление) = Тип("Строка"), Представление, "");
	Если mcp1c_ПутиПолей.ЭтоПеречисление(ИмяТипа) Тогда
		Результат.Вставить("value", XMLСтрока(Значение));
		Результат.Вставить("presentation", mcp1c_Сериализация.ОчищенныйТекст(ТекстПредставления, 200));
		Возврат Результат;
	КонецЕсли;
	Доступ = ДоступПредставления(ИмяТипа, Контекст);
	Если Доступ = "hidden" Тогда
		Результат.Вставить("presentation", ПредставлениеСкрытого());
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("ref", Строка(Значение.УникальныйИдентификатор()));
	Если Доступ = "masked" Тогда
		Результат.Вставить("presentation", mcp1c_Маскирование.ПолнаяМаска());
	Иначе
		Результат.Вставить("presentation", mcp1c_Сериализация.ОчищенныйТекст(ТекстПредставления, 500));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция КлючХеша(Значение, Контекст)
	// Исходное значение для хеш-маски: строка без обрезки, ссылка - тип и идентификатор (в том числе
	// ссылка на объект со скрытым представлением), перечисление - тип и имя значения. Для остальных
	// типов - пустая строка: ключ строится по значению JSON.

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли Значение = Неопределено Или Значение = NULL Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Или ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат "";
	КонецЕсли;
	ИмяТипа = ИмяСсылочногоТипа(ТипЗначения, Контекст);
	Если ИмяТипа = Неопределено Или Значение.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Если mcp1c_ПутиПолей.ЭтоПеречисление(ИмяТипа) Тогда
		Возврат ИмяТипа + ":" + XMLСтрока(Значение);
	КонецЕсли;
	Возврат ИмяТипа + ":" + Строка(Значение.УникальныйИдентификатор());

КонецФункции

Функция ЗначениеПараметра(Спецификация, Ошибка)

	Вид = Спецификация.Вид;
	Если Вид = "value" Тогда
		Возврат Спецификация.Значение;
	ИначеЕсли Вид = "uuid" Тогда
		Возврат Новый УникальныйИдентификатор(Спецификация.Значение);
	ИначеЕсли Вид = "ref" Тогда
		Ссылка = СсылкаПоИдентификатору(Спецификация.Тип, Спецификация.Идентификатор);
		Если Ссылка = Неопределено Тогда
			Ошибка = СтрШаблон("Тип «%1» не підтримується у значеннях фільтрів", Спецификация.Тип);
		КонецЕсли;
		Возврат Ссылка;
	ИначеЕсли Вид = "enum" Тогда
		Возврат ЗначениеПеречисления(Спецификация.Тип, Спецификация.Имя, Ошибка);
	ИначеЕсли Вид = "list" Тогда
		Список = Новый Массив;
		Для Каждого Элемент Из Спецификация.Элементы Цикл
			Список.Добавить(ЗначениеПараметра(Элемент, Ошибка));
			Если Не ПустаяСтрока(Ошибка) Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЦикла;
		Возврат Список;
	ИначеЕсли Вид = "empty" Тогда
		Возврат ПустоеЗначение(Спецификация.Типы);
	ИначеЕсли Вид = "account_code" Тогда
		Возврат СчетПоКоду(Спецификация.Тип, Спецификация.Значение, Ошибка);
	КонецЕсли;
	ВызватьИсключение СтрШаблон("Невідомий вид значення параметра: %1", Вид);

КонецФункции

Функция ЗначениеПеречисления(ПолноеИмя, Имя, Ошибка)

	ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМД = Неопределено Тогда
		Ошибка = СтрШаблон("Перерахування «%1» не знайдено", ПолноеИмя);
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ЗначениеМД Из ОбъектМД.ЗначенияПеречисления Цикл
		Если НРег(ЗначениеМД.Имя) = НРег(Имя) Тогда
			Возврат Перечисления[ОбъектМД.Имя][ЗначениеМД.Имя];
		КонецЕсли;
	КонецЦикла;

	Имена = Новый Массив;
	Для Каждого ЗначениеМД Из ОбъектМД.ЗначенияПеречисления Цикл
		Если Имена.Количество() >= 30 Тогда
			Имена.Добавить("...");
			Прервать;
		КонецЕсли;
		Имена.Добавить(ЗначениеМД.Имя);
	КонецЦикла;
	Ошибка = СтрШаблон("У перерахуванні «%1» немає значення «%2»; допустимі: %3", ПолноеИмя, Лев(Имя, 100),
		СтрСоединить(Имена, ", "));
	Возврат Неопределено;

КонецФункции

Функция ПустоеЗначение(Типы)
	// Пустое значение для is_empty: для одного типа - его пустое значение, для составного - Неопределено.

	Если Типы.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = Типы[0];
	Если Имя = "Строка" Тогда
		Возврат "";
	ИначеЕсли Имя = "Число" Тогда
		Возврат 0;
	ИначеЕсли Имя = "Дата" Тогда
		Возврат Дата(1, 1, 1);
	ИначеЕсли Имя = "Булево" Тогда
		Возврат Ложь;
	КонецЕсли;
	Менеджер = МенеджерОбъекта(Имя);
	Если Менеджер <> Неопределено Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция СчетПоКоду(ПолноеИмя, Код, Ошибка)
	// Счет по коду (субсчета включаются условием В ИЕРАРХИИ). Читается в привилегированном режиме:
	// у технического пользователя нет прав на данные.

	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(ПолноеИмя);
	Если ОбъектМД = Неопределено Тогда
		Ошибка = "План рахунків регістра не знайдено";
		Возврат Неопределено;
	КонецЕсли;
	Спецификация = mcp1c_КонструкторЗапросов.НоваяСпецификация(mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД));
	Спецификация.Первые = 2;
	Спецификация.Поля.Добавить(mcp1c_КонструкторЗапросов.НовоеПолеВыборки("Т.Ссылка", "Ссылка"));
	Параметры = Новый Массив;
	Параметры.Добавить("Код");
	Спецификация.Условия.Добавить(mcp1c_КонструкторЗапросов.НовоеУсловие("Т.Код", "eq", Параметры));
	Значения = Новый Соответствие;
	Значения.Вставить("Код", Код);
	Таблица = mcp1c_ВыполнениеЗапросов.ВыполнитьЗапрос(Спецификация, Значения).Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Возврат Таблица[0].Ссылка;
	ИначеЕсли Таблица.Количество() = 0 Тогда
		Ошибка = СтрШаблон("Рахунок з кодом «%1» не знайдено в «%2»", Лев(Код, 50), ПолноеИмя);
	Иначе
		Ошибка = СтрШаблон("Код рахунку «%1» неоднозначний: передайте account як посилання", Лев(Код, 50));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция МенеджерОбъекта(ПолноеИмя)
	// Менеджер объекта по полному имени; Неопределено для видов без ссылок.

	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Класс = Части[0];
	Имя = Части[1];
	Если Класс = "Справочник" Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Класс = "Документ" Тогда
		Возврат Документы[Имя];
	ИначеЕсли Класс = "Перечисление" Тогда
		Возврат Перечисления[Имя];
	ИначеЕсли Класс = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Класс = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя];
	ИначеЕсли Класс = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Имя];
	ИначеЕсли Класс = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[Имя];
	ИначеЕсли Класс = "Задача" Тогда
		Возврат Задачи[Имя];
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ИмяСсылочногоТипа(ТипЗначения, Контекст)
	// Полное имя объекта для ссылочного типа; Неопределено для прочих типов.

	Если Контекст.ИменаТипов.Получить(ТипЗначения) <> Неопределено Тогда
		Имя = Контекст.ИменаТипов.Получить(ТипЗначения);
		Возврат ?(Имя = "", Неопределено, Имя);
	КонецЕсли;
	ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
	Имя = "";
	Если ОбъектМД <> Неопределено Тогда
		ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД);
		Класс = СтрРазделить(ПолноеИмя, ".")[0];
		Если КлассыСсылочныхТипов().Найти(Класс) <> Неопределено Тогда
			Имя = ПолноеИмя;
		КонецЕсли;
	КонецЕсли;
	Контекст.ИменаТипов.Вставить(ТипЗначения, Имя);
	Возврат ?(Имя = "", Неопределено, Имя);

КонецФункции

Функция ИмяТипаДляПредставления(Значение, Контекст)
	// Полное имя объекта для непустой ссылки, представление которой будет показано клиенту;
	// Неопределено - значение не ссылка, пустая ссылка или представление скрыто или замаскировано.

	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяТипа = ИмяСсылочногоТипа(ТипЗнч(Значение), Контекст);
	Если ИмяТипа = Неопределено Или Значение.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не mcp1c_ПутиПолей.ЭтоПеречисление(ИмяТипа) И ДоступПредставления(ИмяТипа, Контекст) <> "visible" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИмяТипа;

КонецФункции

Функция КлассыСсылочныхТипов()

	Возврат СтрРазделить("Справочник,Документ,Перечисление,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,"
		+ "БизнесПроцесс,Задача,ПланОбмена", ",");

КонецФункции

Функция ДоступПредставления(ИмяТипа, Контекст)
	// visible, masked или hidden; кешируется на время вызова инструмента.

	Доступ = Контекст.ДоступностьПредставлений.Получить(ИмяТипа);
	Если Доступ = Неопределено Тогда
		Доступ = mcp1c_ПравилаДоступа.ДоступПредставления(Контекст.Политика, ИмяТипа,
			mcp1c_Метаданные.ПоляПредставления(ИмяТипа));
		Контекст.ДоступностьПредставлений.Вставить(ИмяТипа, Доступ);
	КонецЕсли;
	Возврат Доступ;

КонецФункции

#КонецОбласти

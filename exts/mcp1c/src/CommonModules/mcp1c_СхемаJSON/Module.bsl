///////////////////////////////////////////////////////////////////////////////
// mcp1c_СхемаJSON: схемы аргументов инструментов (подмножество JSON Schema) и проверка
// аргументов по ним (п. 3.2 ТЗ, шаг 5): типы, границы, обязательные свойства,
// additionalProperties = false, enum.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Проверка

// Проверяет значение по подмножеству JSON Schema: type (object, string, integer,
// number, boolean, array), properties, required, additionalProperties = false, enum,
// minLength, maxLength, minimum, maximum, items, minItems, maxItems.
// Схема без type допускает любое значение.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение (разобранный JSON).
//  Схема - Соответствие из КлючИЗначение - схема.
//  Путь - Строка - путь к значению для текста ошибки.
//  Ошибки - Массив из Строка - сюда добавляются ошибки.
//
Процедура Проверить(Значение, Схема, Путь, Ошибки) Экспорт

	Если ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ТипСхемы = Схема.Получить("type");
	Если ТипСхемы = "object" Тогда
		ПроверитьОбъект(Значение, Схема, Путь, Ошибки);
	ИначеЕсли ТипСхемы = "array" Тогда
		ПроверитьМассив(Значение, Схема, Путь, Ошибки);
	ИначеЕсли ТипСхемы = "string" Тогда
		ПроверитьСтроку(Значение, Схема, Путь, Ошибки);
	ИначеЕсли ТипСхемы = "integer" Или ТипСхемы = "number" Тогда
		ПроверитьЧисло(Значение, Схема, Путь, Ошибки, ТипСхемы = "integer");
	ИначеЕсли ТипСхемы = "boolean" И ТипЗнч(Значение) <> Тип("Булево") Тогда
		Ошибки.Добавить(Путь + ": очікується true або false");
	КонецЕсли;

	Варианты = Схема.Получить("enum");
	Если ТипЗнч(Варианты) = Тип("Массив") И Варианты.Найти(Значение) = Неопределено Тогда
		Ошибки.Добавить(СтрШаблон("%1: допустимі значення: %2", Путь, СтрСоединить(Варианты, ", ")));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Конструкторы

// Схема объекта без дополнительных свойств.
//
// Параметры:
//  Свойства - Соответствие из КлючИЗначение - схемы свойств.
//  Обязательные - Строка - имена обязательных свойств через запятую.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаОбъекта(Свойства, Обязательные = "") Экспорт

	Схема = СхемаТипа("object");
	Схема.Вставить("properties", Свойства);
	ИменаОбязательных = СтрРазделить(Обязательные, ",", Ложь);
	Если ИменаОбязательных.Количество() > 0 Тогда
		Схема.Вставить("required", ИменаОбязательных);
	КонецЕсли;
	Схема.Вставить("additionalProperties", Ложь);
	Возврат Схема;

КонецФункции

// Схема результата инструмента (outputSchema).
//
// Параметры:
//  Свойства - Соответствие из КлючИЗначение - схемы свойств.
//  Обязательные - Строка - имена обязательных свойств через запятую.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаВыхода(Свойства, Обязательные) Экспорт

	Схема = СхемаТипа("object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(Обязательные, ",", Ложь));
	Возврат Схема;

КонецФункции

// Схема с одним ключом type.
//
// Параметры:
//  ИмяТипа - Строка - object, array, string, integer, number, boolean.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаТипа(ИмяТипа) Экспорт

	Схема = Новый Соответствие;
	Схема.Вставить("type", ИмяТипа);
	Возврат Схема;

КонецФункции

// Схема строки.
//
// Параметры:
//  ТекстОписания - Строка - описание для модели.
//  МаксимальнаяДлина - Число - максимальная длина.
//  Варианты - Массив из Строка, Неопределено - допустимые значения.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаСтроки(ТекстОписания, МаксимальнаяДлина, Варианты = Неопределено) Экспорт

	Схема = СхемаТипа("string");
	Схема.Вставить("description", ТекстОписания);
	Схема.Вставить("maxLength", МаксимальнаяДлина);
	Если Варианты <> Неопределено Тогда
		Схема.Вставить("enum", Варианты);
	КонецЕсли;
	Возврат Схема;

КонецФункции

// Схема целого числа.
//
// Параметры:
//  ТекстОписания - Строка - описание для модели.
//  Минимум - Число - минимальное значение.
//  Максимум - Число - максимальное значение.
//  ПоУмолчанию - Число, Неопределено - значение по умолчанию.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаЦелого(ТекстОписания, Минимум, Максимум, ПоУмолчанию = Неопределено) Экспорт

	Схема = СхемаТипа("integer");
	Схема.Вставить("description", ТекстОписания);
	Схема.Вставить("minimum", Минимум);
	Схема.Вставить("maximum", Максимум);
	Если ПоУмолчанию <> Неопределено Тогда
		Схема.Вставить("default", ПоУмолчанию);
	КонецЕсли;
	Возврат Схема;

КонецФункции

// Схема логического значения.
//
// Параметры:
//  ТекстОписания - Строка - описание для модели.
//  ПоУмолчанию - Булево - значение по умолчанию.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаБулево(ТекстОписания, ПоУмолчанию = Ложь) Экспорт

	Схема = СхемаТипа("boolean");
	Схема.Вставить("description", ТекстОписания);
	Схема.Вставить("default", ПоУмолчанию);
	Возврат Схема;

КонецФункции

// Схема массива.
//
// Параметры:
//  ТекстОписания - Строка - описание для модели.
//  СхемаЭлемента - Соответствие из КлючИЗначение - схема элемента.
//  МаксимумЭлементов - Число - максимальное число элементов.
//  МинимумЭлементов - Число - минимальное число элементов.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаМассива(ТекстОписания, СхемаЭлемента, МаксимумЭлементов, МинимумЭлементов = 0) Экспорт

	Схема = СхемаТипа("array");
	Схема.Вставить("description", ТекстОписания);
	Схема.Вставить("items", СхемаЭлемента);
	Схема.Вставить("maxItems", МаксимумЭлементов);
	Если МинимумЭлементов > 0 Тогда
		Схема.Вставить("minItems", МинимумЭлементов);
	КонецЕсли;
	Возврат Схема;

КонецФункции

// Схема массива строк с допустимыми значениями.
//
// Параметры:
//  ТекстОписания - Строка - описание для модели.
//  Варианты - Массив из Строка - допустимые значения.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаМассиваСтрок(ТекстОписания, Варианты) Экспорт

	Элемент = СхемаТипа("string");
	Элемент.Вставить("enum", Варианты);
	Возврат СхемаМассива(ТекстОписания, Элемент, Варианты.Количество());

КонецФункции

// Схема произвольного значения JSON (без проверки типа).
//
// Параметры:
//  ТекстОписания - Строка - описание для модели.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - схема.
//
Функция СхемаЗначения(ТекстОписания) Экспорт

	Схема = Новый Соответствие;
	Схема.Вставить("description", ТекстОписания);
	Возврат Схема;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОбъект(Значение, Схема, Путь, Ошибки)

	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Ошибки.Добавить(Путь + ": очікується об'єкт");
		Возврат;
	КонецЕсли;

	Свойства = Схема.Получить("properties");
	Если ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		Свойства = Новый Соответствие;
	КонецЕсли;

	ПроверитьОбязательныеСвойства(Значение, Схема, Путь, Ошибки);

	ЗапретитьЛишние = (Схема.Получить("additionalProperties") = Ложь);
	Для Каждого Элемент Из Значение Цикл
		СхемаСвойства = Свойства.Получить(Элемент.Ключ);
		Если СхемаСвойства = Неопределено Тогда
			Если ЗапретитьЛишние Тогда
				Ошибки.Добавить(СтрШаблон("%1.%2: невідомий параметр", Путь, Элемент.Ключ));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Элемент.Значение = Неопределено Тогда
			Продолжить; // null трактуется как отсутствие необязательного параметра
		КонецЕсли;
		Проверить(Элемент.Значение, СхемаСвойства, Путь + "." + Элемент.Ключ, Ошибки);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОбязательныеСвойства(Значение, Схема, Путь, Ошибки)

	Обязательные = Схема.Получить("required");
	Если ТипЗнч(Обязательные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ИмяСвойства Из Обязательные Цикл
		Если Значение.Получить(ИмяСвойства) = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон("%1.%2: обов'язковий параметр", Путь, ИмяСвойства));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьМассив(Значение, Схема, Путь, Ошибки)

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Ошибки.Добавить(Путь + ": очікується масив");
		Возврат;
	КонецЕсли;

	Минимум = Схема.Получить("minItems");
	Если ТипЗнч(Минимум) = Тип("Число") И Значение.Количество() < Минимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: щонайменше %2 елементів", Путь, Минимум));
	КонецЕсли;
	Максимум = Схема.Получить("maxItems");
	Если ТипЗнч(Максимум) = Тип("Число") И Значение.Количество() > Максимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: не більше %2 елементів", Путь, Максимум));
	КонецЕсли;

	СхемаЭлемента = Схема.Получить("items");
	Если ТипЗнч(СхемаЭлемента) = Тип("Соответствие") Тогда
		Для Индекс = 0 По Значение.ВГраница() Цикл
			Проверить(Значение[Индекс], СхемаЭлемента, СтрШаблон("%1[%2]", Путь, Формат(Индекс, "ЧН=0; ЧГ=0")), Ошибки);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСтроку(Значение, Схема, Путь, Ошибки)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Ошибки.Добавить(Путь + ": очікується рядок");
		Возврат;
	КонецЕсли;

	Минимум = Схема.Получить("minLength");
	Если ТипЗнч(Минимум) = Тип("Число") И СтрДлина(Значение) < Минимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: щонайменше %2 символів", Путь, Минимум));
	КонецЕсли;
	Максимум = Схема.Получить("maxLength");
	Если ТипЗнч(Максимум) = Тип("Число") И СтрДлина(Значение) > Максимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: не більше %2 символів", Путь, Максимум));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЧисло(Значение, Схема, Путь, Ошибки, ТолькоЦелое)

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Ошибки.Добавить(Путь + ": очікується число");
		Возврат;
	КонецЕсли;
	Если ТолькоЦелое И Цел(Значение) <> Значение Тогда
		Ошибки.Добавить(Путь + ": очікується ціле число");
	КонецЕсли;

	Минимум = Схема.Получить("minimum");
	Если ТипЗнч(Минимум) = Тип("Число") И Значение < Минимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: не менше %2", Путь, Минимум));
	КонецЕсли;
	Максимум = Схема.Получить("maximum");
	Если ТипЗнч(Максимум) = Тип("Число") И Значение > Максимум Тогда
		Ошибки.Добавить(СтрШаблон("%1: не більше %2", Путь, Максимум));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

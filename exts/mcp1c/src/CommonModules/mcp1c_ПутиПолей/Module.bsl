///////////////////////////////////////////////////////////////////////////////
// mcp1c_ПутиПолей: разбор путей полей ("Контрагент.ГоловнойКонтрагент.Наименование")
// по описаниям таблиц и проверка каждого звена политикой (п. 5.3, 7.4 ТЗ).
//
// В текст запроса попадают только канонические имена из описаний метаданных:
// строка из аргументов модели используется лишь для поиска поля по имени.
// Описания таблиц строит mcp1c_Метаданные; если для разыменования нужно описание
// еще одной таблицы, разбор возвращает ее имя в НужноОписание, вызывающий код
// загружает описание и повторяет разбор.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область ОписанияТаблиц

// Описание таблицы для разбора путей.
//
// Параметры:
//  Имя - Строка - имя таблицы в запросе ("Справочник.Контрагенты", "Документ.Реализация.Товары",
//                 "РегистрНакопления.ТоварыНаСкладах.Остатки").
//  Объект - Строка - полное имя объекта метаданных для политики (для табличной части - владелец).
//  Вид - Строка - код вида объекта (catalog, document, accumulation_register, ...).
//  ВидТаблицы - Строка - object, tabular_section, register или virtual.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя таблицы в запросе.
//   * Объект - Строка - полное имя объекта для политики.
//   * Вид - Строка - код вида объекта.
//   * ВидТаблицы - Строка - object, tabular_section, register, virtual.
//   * ПрефиксПолейПолитики - Строка - "Товары." для табличной части, иначе пустая строка.
//   * Поля - Массив из см. НовоеПоле - поля таблицы.
//   * ПолеПериода - Строка - поле для отбора по периоду ("Дата", "Период") или пустая строка.
//   * ЕстьПометкаУдаления - Булево - у строк есть пометка удаления (для табличной части - у владельца).
//   * ЕстьПроведен - Булево - строки принадлежат документу с признаком проведения.
//   * ЕстьАктивность - Булево - у записей регистра есть признак активности.
//   * КлючевыеПоля - Массив из Строка - поля выборки по умолчанию.
//   * ПоляПорядка - Массив из Строка - поля, задающие однозначный порядок строк.
//   * ПоляПредставления - Массив из Строка - поля, из которых строится представление ссылки.
//   * ПоляПоиска - Массив из Строка - поля поиска по строке (ввод по строке, Код, Наименование, Номер).
//   * ВиртуальнаяТаблица - Строка - Остатки, Обороты, ОстаткиИОбороты, СрезПоследних, СрезПервых
//                          или пустая строка для основной таблицы.
//   * ВидРегистра - Строка - balance или turnovers для регистров накопления.
//   * ПланСчетов - Строка - полное имя плана счетов регистра бухгалтерии.
//
Функция НовоеОписаниеТаблицы(Имя, Объект, Вид, ВидТаблицы = "object") Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Объект", Объект);
	Описание.Вставить("Вид", Вид);
	Описание.Вставить("ВидТаблицы", ВидТаблицы);
	Описание.Вставить("ПрефиксПолейПолитики", "");
	Описание.Вставить("Поля", Новый Массив);
	Описание.Вставить("ПолеПериода", "");
	Описание.Вставить("ЕстьПометкаУдаления", Ложь);
	Описание.Вставить("ЕстьПроведен", Ложь);
	Описание.Вставить("ЕстьАктивность", Ложь);
	Описание.Вставить("КлючевыеПоля", Новый Массив);
	Описание.Вставить("ПоляПорядка", Новый Массив);
	Описание.Вставить("ПоляПредставления", Новый Массив);
	Описание.Вставить("ПоляПоиска", Новый Массив);
	Описание.Вставить("ВиртуальнаяТаблица", "");
	Описание.Вставить("ВидРегистра", "");
	Описание.Вставить("ПланСчетов", "");
	Возврат Описание;

КонецФункции

// Описание поля таблицы.
//
// Параметры:
//  Имя - Строка - имя поля в запросе.
//  Типы - Массив из Строка - типы: Строка, Число, Дата, Булево, УникальныйИдентификатор,
//         ХранилищеЗначения, ДвоичныеДанные или полное имя объекта ("Справочник.Контрагенты").
//  Роль - Строка - standard, attribute, dimension, resource или period (поле Период виртуальной
//         таблицы оборотов, доступное только при заданной периодичности).
//  ДлинаСтроки - Число - длина строки; 0 - неограниченная.
//  ПолеПолитики - Строка - имя поля для правил профиля; по умолчанию - Имя. Для полей виртуальных
//                 таблиц ("КоличествоОстаток") - имя ресурса ("Количество").
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя поля.
//   * Типы - Массив из Строка - типы значения.
//   * Роль - Строка - роль поля.
//   * ДлинаСтроки - Число - длина строки.
//   * ПолеПолитики - Строка - имя для правил профиля.
//   * Показатель - Строка - для полей ресурсов виртуальных таблиц - суффикс показателя
//                  (Остаток, ОстатокДт, Приход, Оборот, ...); иначе пустая строка.
//
Функция НовоеПоле(Имя, Типы, Роль = "attribute", ДлинаСтроки = 0, ПолеПолитики = "") Экспорт

	Поле = Новый Структура;
	Поле.Вставить("Имя", Имя);
	Поле.Вставить("Типы", Типы);
	Поле.Вставить("Роль", Роль);
	Поле.Вставить("ДлинаСтроки", ДлинаСтроки);
	Поле.Вставить("ПолеПолитики", ?(ПустаяСтрока(ПолеПолитики), Имя, ПолеПолитики));
	Поле.Вставить("Показатель", "");
	Возврат Поле;

КонецФункции

// Добавляет поле в описание таблицы.
//
// Параметры:
//  Описание - см. НовоеОписаниеТаблицы
//  Имя - Строка - имя поля.
//  Типы - Массив из Строка, Строка - типы; строка - типы через запятую.
//  Роль - Строка - роль поля.
//  ДлинаСтроки - Число - длина строки.
//  ПолеПолитики - Строка - имя поля для правил профиля.
//
// Возвращаемое значение:
//  см. НовоеПоле
//
Функция ДобавитьПоле(Описание, Имя, Типы, Роль = "attribute", ДлинаСтроки = 0, ПолеПолитики = "") Экспорт

	МассивТипов = Типы;
	Если ТипЗнч(Типы) = Тип("Строка") Тогда
		МассивТипов = Новый Массив;
		Для Каждого ИмяТипа Из СтрРазделить(Типы, ",", Ложь) Цикл
			МассивТипов.Добавить(СокрЛП(ИмяТипа));
		КонецЦикла;
	КонецЕсли;
	Поле = НовоеПоле(Имя, МассивТипов, Роль, ДлинаСтроки, ПолеПолитики);
	Описание.Поля.Добавить(Поле);
	Возврат Поле;

КонецФункции

// Поле таблицы по имени без учета регистра.
//
// Параметры:
//  Описание - см. НовоеОписаниеТаблицы
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  см. НовоеПоле, Неопределено - поле или Неопределено, если его нет.
//
Функция НайтиПоле(Описание, Имя) Экспорт

	ИмяПоиска = НРег(СокрЛП(Имя));
	Для Каждого Поле Из Описание.Поля Цикл
		Если НРег(Поле.Имя) = ИмяПоиска Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Разбор

// Разбирает путь поля и проверяет политикой каждое звено.
//
// Параметры:
//  Таблица - см. НовоеОписаниеТаблицы - таблица, от которой строится путь.
//  Путь - Строка - путь из аргументов, например "Контрагент.ИНН".
//  Описания - Соответствие из КлючИЗначение - загруженные описания объектов для разыменования:
//   * Ключ - Строка - полное имя объекта.
//   * Значение - см. НовоеОписаниеТаблицы.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - путь разобран и доступен.
//   * НужноОписание - Строка - полное имя объекта, описание которого нужно загрузить и повторить разбор.
//   * Ошибка - Строка - текст ошибки для модели (скрытые поля не отличаются от отсутствующих).
//   * Путь - Строка - канонический путь ("Контрагент.ИНН").
//   * Выражение - Строка - выражение для запроса ("Т.Контрагент.ИНН").
//   * Типы - Массив из Строка - типы значения.
//   * ДлинаСтроки - Число - длина строки (0 - неограниченная или не строка).
//   * НеограниченнаяСтрока - Булево - среди типов есть строка неограниченной длины.
//   * Поле - см. НовоеПоле, Неопределено - последнее поле пути.
//   * Разыменований - Число - число точек в пути.
//
Функция РазобратьПуть(Таблица, Знач Путь, Описания, Политика) Экспорт

	Результат = НовыйРезультатРазбора();
	Путь = СокрЛП(Путь);
	Части = СтрРазделить(Путь, ".", Истина);
	Для Каждого Часть Из Части Цикл
		Если Не ЭтоИдентификатор(Часть) Тогда
			Результат.Ошибка = СтрШаблон(НСтр("ru = 'Неприпустиме ім''я поля «%1»: очікується ім''я з метаданих, частини через крапку'"),
				Лев(Путь, 100));
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	МаксимумРазыменований = Политика.Лимиты.ГлубинаРазыменования;
	Если Части.Количество() - 1 > МаксимумРазыменований Тогда
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Шлях «%1» має забагато рівнів: дозволено не більше %2 крапок'"),
			Путь, МаксимумРазыменований);
		Возврат Результат;
	КонецЕсли;

	Таблицы = Новый Массив;
	Таблицы.Добавить(Новый Структура("Таблица, ЧерезСобственнуюСсылку", Таблица, Ложь));
	КаноническиеЧасти = Новый Массив;
	Для Индекс = 0 По Части.ВГраница() Цикл
		Найденные = НайденныеПоля(Таблицы, Части[Индекс]);
		Если Найденные.Количество() = 0 Или Не ЗвеньяДоступны(Найденные, Индекс > 0, Политика) Тогда
			Результат.Ошибка = ОшибкаПоля(Путь, Таблица);
			Возврат Результат;
		КонецЕсли;
		КаноническиеЧасти.Добавить(Найденные[0].Поле.Имя);

		Если Индекс = Части.ВГраница() Тогда
			ЗаполнитьТипыРезультата(Результат, Найденные);
			Прервать;
		КонецЕсли;

		Таблицы = ТаблицыРазыменования(Найденные, Описания, Политика, Результат);
		Если Не ПустаяСтрока(Результат.НужноОписание) Тогда
			Возврат Результат;
		КонецЕсли;
		Если Таблицы = Неопределено Тогда
			Результат.Ошибка = ОшибкаПоля(Путь, Таблица);
			Возврат Результат;
		КонецЕсли;
		Если Таблицы.Количество() = 0 Тогда
			Результат.Ошибка = СтрШаблон(НСтр("ru = 'Поле «%1» не є посиланням: розіменування через крапку неможливе'"),
				СтрСоединить(КаноническиеЧасти, "."));
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Результат.Успех = Истина;
	Результат.Путь = СтрСоединить(КаноническиеЧасти, ".");
	Результат.Выражение = ПсевдонимТаблицы() + "." + Результат.Путь;
	Результат.Разыменований = Части.Количество() - 1;
	Возврат Результат;

КонецФункции

// Псевдоним основной таблицы в запросах.
//
// Возвращаемое значение:
//  Строка - псевдоним.
//
Функция ПсевдонимТаблицы() Экспорт

	Возврат "Т";

КонецФункции

#КонецОбласти

#Область Типы

// Является ли тип ссылкой на объект метаданных (включая перечисления).
//
// Параметры:
//  Тип - Строка - тип из описания поля.
//
// Возвращаемое значение:
//  Булево - Истина для ссылочных типов.
//
Функция ЭтоСсылочныйТип(Тип) Экспорт

	Возврат СтрНайти(Тип, ".") > 0;

КонецФункции

// Является ли тип перечислением.
//
// Параметры:
//  Тип - Строка - тип из описания поля.
//
// Возвращаемое значение:
//  Булево - Истина для перечислений.
//
Функция ЭтоПеречисление(Тип) Экспорт

	Возврат СтрНачинаетсяС(Тип, "Перечисление.");

КонецФункции

// Вид значений поля для колонки результата.
//
// Параметры:
//  Типы - Массив из Строка - типы поля.
//
// Возвращаемое значение:
//  Строка - ref, enum, string, number, datetime, boolean, uuid или mixed.
//
Функция ВидЗначений(Типы) Экспорт

	Виды = Новый Массив;
	Для Каждого Тип Из Типы Цикл
		Вид = ВидТипа(Тип);
		Если Виды.Найти(Вид) = Неопределено Тогда
			Виды.Добавить(Вид);
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Виды.Количество() = 1, Виды[0], "mixed");

КонецФункции

// Есть ли среди типов ссылочный (включая перечисления).
//
// Параметры:
//  Типы - Массив из Строка - типы поля.
//
// Возвращаемое значение:
//  Булево - Истина, если есть ссылочный тип.
//
Функция ЕстьСсылочныйТип(Типы) Экспорт

	Для Каждого Тип Из Типы Цикл
		Если ЭтоСсылочныйТип(Тип) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатРазбора()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("НужноОписание", "");
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Путь", "");
	Результат.Вставить("Выражение", "");
	Результат.Вставить("Типы", Новый Массив);
	Результат.Вставить("ДлинаСтроки", 0);
	Результат.Вставить("НеограниченнаяСтрока", Ложь);
	Результат.Вставить("Поле", Неопределено);
	Результат.Вставить("Разыменований", 0);
	Возврат Результат;

КонецФункции

Функция НайденныеПоля(Таблицы, Имя)
	// Поля с указанным именем во всех таблицах текущего звена.

	Результат = Новый Массив;
	Для Каждого Элемент Из Таблицы Цикл
		Поле = НайтиПоле(Элемент.Таблица, Имя);
		Если Поле <> Неопределено Тогда
			Результат.Добавить(Новый Структура("Таблица, Поле, ЧерезСобственнуюСсылку",
				Элемент.Таблица, Поле, Элемент.ЧерезСобственнуюСсылку));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗвеньяДоступны(Найденные, ЭтоРазыменование, Политика)
	// Доступны ли все найденные звенья. Разыменование через объект с ограничениями строк
	// запрещено: ограничения действуют только на строки основной таблицы запроса.
	// Исключение - переход по полю Ссылка к самому объекту (табличная часть -> владелец).

	Для Каждого Элемент Из Найденные Цикл
		Таблица = Элемент.Таблица;
		ПутьПолитики = Таблица.ПрефиксПолейПолитики + Элемент.Поле.ПолеПолитики;
		Если Не mcp1c_ПравилаДоступа.ПолеДоступно(Политика, Таблица.Объект, ПутьПолитики, Элемент.Поле.Типы) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ЭтоРазыменование И Не Элемент.ЧерезСобственнуюСсылку
			И mcp1c_ПравилаДоступа.ОграниченияСтрок(Политика, Таблица.Объект).Количество() > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ТаблицыРазыменования(Найденные, Описания, Политика, Результат)
	// Таблицы, на которые ссылаются найденные поля. Неопределено - звено недоступно;
	// пустой массив - среди типов нет ссылок, через которые возможно разыменование.

	Таблицы = Новый Массив;
	Имена = Новый Массив;
	Для Каждого Элемент Из Найденные Цикл
		Для Каждого Тип Из Элемент.Поле.Типы Цикл
			Если Не ЭтоСсылочныйТип(Тип) Или ЭтоПеречисление(Тип) Или Имена.Найти(Тип) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Не mcp1c_ПравилаДоступа.ОбъектДоступен(Политика, Тип) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Описание = Описания.Получить(Тип);
			Если Описание = Неопределено Тогда
				Результат.НужноОписание = Тип;
				Возврат Таблицы;
			КонецЕсли;
			Имена.Добавить(Тип);
			// Переход по полю Ссылка ведет к той же строке объекта, ограничения которой уже применены.
			ЧерезСобственнуюСсылку = (НРег(Элемент.Поле.Имя) = "ссылка" И НРег(Тип) = НРег(Элемент.Таблица.Объект));
			Таблицы.Добавить(Новый Структура("Таблица, ЧерезСобственнуюСсылку", Описание, ЧерезСобственнуюСсылку));
		КонецЦикла;
	КонецЦикла;
	Возврат Таблицы;

КонецФункции

Процедура ЗаполнитьТипыРезультата(Результат, Найденные)

	Типы = Новый Массив;
	ДлинаСтроки = 0;
	Неограниченная = Ложь;
	Для Каждого Элемент Из Найденные Цикл
		Для Каждого Тип Из Элемент.Поле.Типы Цикл
			Если Типы.Найти(Тип) = Неопределено Тогда
				Типы.Добавить(Тип);
			КонецЕсли;
			Если Тип = "Строка" Тогда
				Если Элемент.Поле.ДлинаСтроки = 0 Тогда
					Неограниченная = Истина;
				КонецЕсли;
				ДлинаСтроки = Макс(ДлинаСтроки, Элемент.Поле.ДлинаСтроки);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Результат.Типы = Типы;
	Результат.ДлинаСтроки = ?(Неограниченная, 0, ДлинаСтроки);
	Результат.НеограниченнаяСтрока = Неограниченная;
	Результат.Поле = Найденные[0].Поле;

КонецПроцедуры

Функция ОшибкаПоля(Путь, Таблица)

	Возврат СтрШаблон(НСтр("ru = 'Поле «%1» не знайдено або недоступне в «%2». Перелік полів дає describe_object.'"),
		Лев(Путь, 100), Таблица.Имя);

КонецФункции

Функция ВидТипа(Тип)

	Если ЭтоПеречисление(Тип) Тогда
		Возврат "enum";
	ИначеЕсли ЭтоСсылочныйТип(Тип) Тогда
		Возврат "ref";
	ИначеЕсли Тип = "Строка" Тогда
		Возврат "string";
	ИначеЕсли Тип = "Число" Тогда
		Возврат "number";
	ИначеЕсли Тип = "Дата" Тогда
		Возврат "datetime";
	ИначеЕсли Тип = "Булево" Тогда
		Возврат "boolean";
	ИначеЕсли Тип = "УникальныйИдентификатор" Тогда
		Возврат "uuid";
	КонецЕсли;
	Возврат "other";

КонецФункции

Функция ЭтоИдентификатор(Текст)
	// Имя из букв, цифр и подчеркиваний, начинается не с цифры.

	Если ПустаяСтрока(Текст) Или СтрДлина(Текст) > 128 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		ТекущийСимвол = Сред(Текст, Позиция, 1);
		ЭтоБуква = НРег(ТекущийСимвол) <> ВРег(ТекущийСимвол) Или ТекущийСимвол = "_";
		ЭтоЦифра = СтрНайти("0123456789", ТекущийСимвол) > 0;
		Если Не ЭтоБуква И Не (ЭтоЦифра И Позиция > 1) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

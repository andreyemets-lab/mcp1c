///////////////////////////////////////////////////////////////////////////////
// mcp1c_РесурсыИПромпты: чтение ресурсов (resources/read) и промпты (prompts/*) MCP (п. 5.6 ТЗ).
//
// Ресурс - представление инструмента: onec://context - get_context, onec://metadata/{object} -
// describe_object, onec://object/{object}/{ref} - get_object (см. mcp1c_ОписанияРесурсов).
// Содержимое получается вызовом инструмента, поэтому для ресурса действуют те же доступность
// инструмента профилю, правила объектов и полей, маски, ограничения строк и лимит размера ответа.
// onec://glossary - глоссарий из настроек сервера.
// Промпты - элементы справочника mcp1c_Промпты, доступные профилю клиента (без профилей в списке -
// всем клиентам с профилем); справочник читается по правам роли mcp1c_Сервис.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Ресурсы

// Содержимое ресурса для resources/read.
//
// Параметры:
//  URI - Строка - params.uri.
//  Разбор - см. mcp1c_ОписанияРесурсов.РазобратьURI
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - содержимое получено.
//   * ВнутренняяОшибка - Булево - инструмент завершился исключением (ответ -32603).
//   * Причина - Строка - почему ресурс не получен: текст ошибки инструмента для модели.
//   * Содержимое - Массив из Произвольный - contents (Соответствие): uri, mimeType, text.
//
Функция ПрочитатьРесурс(URI, Разбор, Контекст) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ВнутренняяОшибка", Ложь);
	Результат.Вставить("Причина", "");
	Результат.Вставить("Содержимое", Новый Массив);

	Если Разбор = Неопределено Тогда
		Результат.Причина = "Невідомий ресурс: доступні onec://context, onec://glossary, onec://metadata/{object} "
			+ "і onec://object/{object}/{ref} (див. resources/list і resources/templates/list)";
		Возврат Результат;
	КонецЕсли;

	Инструмент = mcp1c_ОписанияРесурсов.ИнструментРесурса(Разбор);
	Если Не mcp1c_ПравилаДоступа.ИнструментДоступен(Контекст.Политика, Инструмент) Тогда
		Контекст.Причина = "Инструмент ресурса не разрешен профилем: " + Инструмент;
		Результат.Причина = "Ресурс недоступний профілю: див. resources/list і resources/templates/list";
		Возврат Результат;
	КонецЕсли;

	Если Разбор.Вид = "glossary" Тогда
		Текст = ТекстГлоссария(Контекст, Результат);
		Если ПустаяСтрока(Текст) Тогда
			Возврат Результат;
		КонецЕсли;
	Иначе
		Итог = mcp1c_Инструменты.Вызвать(Инструмент, mcp1c_ОписанияРесурсов.АргументыИнструмента(Разбор), Контекст);
		Текст = ТекстРезультата(Итог);
		Если Итог.Получить("isError") = Истина Тогда
			Результат.ВнутренняяОшибка = ЗначениеЗаполнено(Контекст.ТекстОшибки);
			Результат.Причина = Текст;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Содержимое = Новый Соответствие;
	Содержимое.Вставить("uri", URI);
	Содержимое.Вставить("mimeType", mcp1c_ОписанияРесурсов.ТипСодержимого());
	Содержимое.Вставить("text", Текст);
	Результат.Содержимое.Добавить(Содержимое);
	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Промпты

// Промпты, доступные профилю клиента, для prompts/list - по имени.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Массив из Произвольный - описания (Соответствие): name, title, description, arguments.
//
Функция СписокПромптов(Политика) Экспорт

	Результат = Новый Массив;
	Для Каждого Промпт Из ДоступныеПромпты(Политика, "") Цикл
		Результат.Добавить(mcp1c_ОписанияРесурсов.ОписаниеПромпта(Промпт.Имя, Промпт.Заголовок, Промпт.Описание,
			Промпт.Аргументы));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Промпт с подставленными аргументами для prompts/get.
//
// Параметры:
//  Имя - Строка - params.name.
//  Аргументы - Произвольный - params.arguments: Соответствие строковых значений или Неопределено.
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Структура:
//   * Результат - Соответствие из КлючИЗначение - description и messages; пустое при ошибке.
//   * Ошибка - Строка - сообщение для ответа -32602; пустая строка при успехе.
//
Функция ПолучитьПромпт(Имя, Аргументы, Политика) Экспорт

	Итог = Новый Структура("Результат, Ошибка", Новый Соответствие, "");
	Промпты = ДоступныеПромпты(Политика, Имя);
	Если Промпты.Количество() = 0 Тогда
		// Промпт, недоступный профилю, не отличается от несуществующего.
		Итог.Ошибка = "Unknown prompt: " + Лев(Имя, 64);
		Возврат Итог;
	КонецЕсли;
	Промпт = Промпты[0];
	Текст = mcp1c_ОписанияРесурсов.ТекстПромпта(Промпт.Текст, Промпт.Аргументы, Аргументы,
		mcp1c_ОписанияРесурсов.ВстроенныеПодстановки(ТекущаяДатаСеанса()));
	Если Не ПустаяСтрока(Текст.Ошибка) Тогда
		Итог.Ошибка = "Invalid params: " + Текст.Ошибка;
		Возврат Итог;
	КонецЕсли;

	Содержимое = Новый Соответствие;
	Содержимое.Вставить("type", "text");
	Содержимое.Вставить("text", Текст.Текст);
	Сообщение = Новый Соответствие;
	Сообщение.Вставить("role", "user");
	Сообщение.Вставить("content", Содержимое);
	Сообщения = Новый Массив;
	Сообщения.Добавить(Сообщение);

	Если Не ПустаяСтрока(Промпт.Описание) Тогда
		Итог.Результат.Вставить("description", Промпт.Описание);
	КонецЕсли;
	Итог.Результат.Вставить("messages", Сообщения);
	Возврат Итог;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстРезультата(Итог)
	// Текст первого блока content результата инструмента: JSON данных или текст ошибки.

	Содержимое = Итог.Получить("content");
	Если ТипЗнч(Содержимое) = Тип("Массив") И Содержимое.Количество() > 0 Тогда
		Возврат mcp1c_Служебный.СвойствоСтрока(Содержимое[0], "text");
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ТекстГлоссария(Контекст, Результат)
	// JSON глоссария; пустая строка, если он больше лимита ответа (причина - в Результат.Причина).

	Данные = Новый Соответствие;
	Данные.Вставить("terms", mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(
		mcp1c_Служебный.Свойство(Контекст.Настройки, "glossary")));
	Текст = mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Данные);

	// Лимит размера ответа профиля (п. 7.3 ТЗ) действует и для глоссария.
	Размер = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Размер();
	Предел = Контекст.Политика.Лимиты.РазмерОтветаБайт;
	Если Размер > Предел Тогда
		Контекст.Причина = СтрШаблон("Размер ответа %1 байт больше лимита %2", Размер, Предел);
		Результат.Причина = СтрШаблон("Глосарій завеликий для ліміту відповіді профілю (%1 КБ, ліміт %2 КБ)",
			Окр(Размер / 1024, 0), Окр(Предел / 1024, 0));
		Возврат "";
	КонецЕсли;
	Контекст.РазмерОтвета = Размер;
	Возврат Текст;

КонецФункции

Функция ДоступныеПромпты(Политика, Имя)
	// Промпты профиля клиента по имени (пустое имя - все): структуры Имя, Заголовок, Описание, Текст, Аргументы.

	Результат = Новый Массив;
	// Клиент без профиля не получает промптов, в том числе доступных всем профилям.
	Если Не ЗначениеЗаполнено(Политика.Профиль) Тогда
		Возврат Результат;
	КонецЕсли;

	// Промпт без профилей в списке доступен всем профилям; строки без профиля не учитываются.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Промпты.Ссылка КАК Ссылка,
	|	Промпты.Имя КАК Имя,
	|	Промпты.Наименование КАК Заголовок,
	|	Промпты.Описание КАК Описание,
	|	Промпты.Текст КАК Текст
	|ПОМЕСТИТЬ ВТПромпты
	|ИЗ
	|	Справочник.mcp1c_Промпты КАК Промпты
	|ГДЕ
	|	НЕ Промпты.ПометкаУдаления
	|	И (&ВсеИмена
	|			ИЛИ Промпты.Имя = &Имя)
	|	И (НЕ Промпты.Ссылка В
	|				(ВЫБРАТЬ
	|					Профили.Ссылка
	|				ИЗ
	|					Справочник.mcp1c_Промпты.Профили КАК Профили
	|				ГДЕ
	|					Профили.Профиль <> ЗНАЧЕНИЕ(Справочник.mcp1c_ПрофилиДоступа.ПустаяСсылка))
	|			ИЛИ Промпты.Ссылка В
	|				(ВЫБРАТЬ
	|					Профили.Ссылка
	|				ИЗ
	|					Справочник.mcp1c_Промпты.Профили КАК Профили
	|				ГДЕ
	|					Профили.Профиль = &Профиль))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПромпты.Ссылка КАК Ссылка,
	|	ВТПромпты.Имя КАК Имя,
	|	ВТПромпты.Заголовок КАК Заголовок,
	|	ВТПромпты.Описание КАК Описание,
	|	ВТПромпты.Текст КАК Текст
	|ИЗ
	|	ВТПромпты КАК ВТПромпты
	|
	|УПОРЯДОЧИТЬ ПО
	|	Имя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Аргументы.Ссылка КАК Ссылка,
	|	Аргументы.Имя КАК Имя,
	|	Аргументы.Описание КАК Описание,
	|	Аргументы.Обязательный КАК Обязательный,
	|	Аргументы.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
	|ИЗ
	|	Справочник.mcp1c_Промпты.Аргументы КАК Аргументы
	|ГДЕ
	|	Аргументы.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТПромпты.Ссылка
	|			ИЗ
	|				ВТПромпты КАК ВТПромпты)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Аргументы.НомерСтроки");
	Запрос.УстановитьПараметр("ВсеИмена", ПустаяСтрока(Имя));
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Профиль", Политика.Профиль);
	Результаты = Запрос.ВыполнитьПакет();

	Аргументы = Новый Соответствие;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Аргументы.Получить(Выборка.Ссылка);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Аргументы.Вставить(Выборка.Ссылка, Список);
		КонецЕсли;
		Список.Добавить(mcp1c_ОписанияРесурсов.НовыйАргументПромпта(Строка(Выборка.Имя), Строка(Выборка.Описание),
			Выборка.Обязательный = Истина, Строка(Выборка.ЗначениеПоУмолчанию)));
	КонецЦикла;

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ИмяПромпта = СокрЛП(Выборка.Имя);
		// Сравнение строк в запросе не учитывает регистр; имя проверяется и при записи, но запись
		// загрузкой данных могла обойти проверку.
		Если Не mcp1c_Служебный.ЭтоИмяMCP(ИмяПромпта) Или Не ПустаяСтрока(Имя) И ИмяПромпта <> Имя Тогда
			Продолжить;
		КонецЕсли;
		Список = Аргументы.Получить(Выборка.Ссылка);
		Промпт = Новый Структура;
		Промпт.Вставить("Имя", ИмяПромпта);
		Промпт.Вставить("Заголовок", Строка(Выборка.Заголовок));
		Промпт.Вставить("Описание", Строка(Выборка.Описание));
		Промпт.Вставить("Текст", Строка(Выборка.Текст));
		Промпт.Вставить("Аргументы", ?(Список = Неопределено, Новый Массив, Список));
		Результат.Добавить(Промпт);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

Функция ЭтоБуква(Символ)

	Возврат НРег(Символ) <> ВРег(Символ);

КонецФункции

Функция ЭтоЦифра(Символ)

	Возврат СтрНайти("0123456789", Символ) > 0;

КонецФункции

Функция ЭтоПрописная(Символ)

	Возврат ЭтоБуква(Символ) И Символ = ВРег(Символ);

КонецФункции

Функция ЭтоСтрочная(Символ)

	Возврат ЭтоБуква(Символ) И Символ = НРег(Символ);

КонецФункции

Функция НачинаетсяНовоеСлово(Текст, Позиция, Символ)
	// Граница слов CamelCase: строчная или цифра перед прописной (aB); в серии прописных новое слово
	// начинается с последней прописной перед строчной (ИННФиз - ИНН и Физ).

	Если Не ЭтоПрописная(Символ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Предыдущий = Сред(Текст, Позиция - 1, 1);
	Если ЭтоСтрочная(Предыдущий) Или ЭтоЦифра(Предыдущий) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЭтоПрописная(Предыдущий) И ЭтоСтрочная(Сред(Текст, Позиция + 1, 1));

КонецФункции

Процедура ДобавитьСлово(Слова, Слово)

	Если Не ПустаяСтрока(Слово) Тогда
		Слова.Добавить(НРег(Слово));
	КонецЕсли;

КонецПроцедуры

Функция ВсеКатегории()
	// Категории для отчета, включая контактную информацию.

	Результат = Новый Массив;
	Для Каждого Код Из КодыКатегорий() Цикл
		Результат.Добавить(ОписаниеКатегории(Код));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьСтрокиКатегории(Строки, Категория, Кандидаты)
	// Кандидаты категории: сначала видимые без маски.

	Отобранные = Новый Массив;
	Для Каждого Состояние Из СтрРазделить("visible,masked,,hidden", ",") Цикл
		Для Каждого Кандидат Из Кандидаты Цикл
			Если Кандидат.Категория = Категория.Код И Кандидат.Состояние = Состояние Тогда
				Отобранные.Добавить(Кандидат);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Отобранные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Строки.Добавить(СтрШаблон("  %1 (%2), рекомендована маска: %3", Категория.Представление, Отобранные.Количество(),
		ПредставлениеМаски(Категория.ВидМаски, Категория.ПараметрМаски)));
	Для Каждого Кандидат Из Отобранные Цикл
		Строки.Добавить(СтрШаблон("    %1.%2%3 - %4", Кандидат.Объект, Кандидат.Поле,
			?(ПустаяСтрока(Кандидат.Синоним), "", " («" + Кандидат.Синоним + "»)"), ПредставлениеСостояния(Кандидат)));
	КонецЦикла;

КонецПроцедуры

Функция ПредставлениеСостояния(Кандидат)

	Если Кандидат.Состояние = "visible" Тогда
		Возврат "ВИДНО БЕЗ МАСКИ";
	ИначеЕсли Кандидат.Состояние = "masked" Тогда
		Возврат "масковано: " + ПредставлениеМаски(Кандидат.Маска);
	ИначеЕсли Кандидат.Состояние = "hidden" Тогда
		Возврат "приховано";
	КонецЕсли;
	Возврат "рішення адміністратора";

КонецФункции

Функция ПредставлениеУровня(Уровень)

	Если Уровень = "high" Тогда
		Возврат "ВИСОКИЙ";
	ИначеЕсли Уровень = "medium" Тогда
		Возврат "СЕРЕДНІЙ";
	КонецЕсли;
	Возврат "ІНФО";

КонецФункции

Процедура ДобавитьПредупрежденияЧувствительныхПолей(Результат, Кандидаты, ВнешниеПровайдеры)
	// Чувствительные поля без маски по категориям; внешний провайдер усиливает риск.

	Видимые = КоличествоВСостоянии(Кандидаты, "visible");
	Если Видимые > 0 Тогда
		Результат.Добавить(НовоеПредупреждение("high", СтрШаблон("%1 чутливих полів видно без маски: %2", Видимые,
			ВидимыеПоКатегориям(Кандидаты))));
	КонецЕсли;

	Если ВнешниеПровайдеры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Видимые > 0 Тогда
		Результат.Добавить(НовоеПредупреждение("high", СтрШаблон("Профіль використовують клієнти із зовнішнім "
			+ "AI-провайдером (%1): персональні дані без маски підуть провайдеру; замаскуйте або заборонте "
			+ "чутливі поля чи використовуйте локальну модель", Перечень(ВнешниеПровайдеры, 5))));
	Иначе
		Результат.Добавить(НовоеПредупреждение("info", СтрШаблон("Профіль використовують клієнти із зовнішнім "
			+ "AI-провайдером (%1); чутливих полів без маски не знайдено", Перечень(ВнешниеПровайдеры, 5))));
	КонецЕсли;

КонецПроцедуры

Функция ВидимыеПоКатегориям(Кандидаты)
	// Видимые без маски поля по категориям: количество и первые примеры.

	Части = Новый Массив;
	Для Каждого Категория Из ВсеКатегории() Цикл
		Примеры = Новый Массив;
		Для Каждого Кандидат Из Кандидаты Цикл
			Если Кандидат.Категория = Категория.Код И Кандидат.Состояние = "visible" Тогда
				Примеры.Добавить(Кандидат.Объект + "." + Кандидат.Поле);
			КонецЕсли;
		КонецЦикла;
		Если Примеры.Количество() > 0 Тогда
			Части.Добавить(СтрШаблон("%1 - %2 (%3)", Категория.Представление, Примеры.Количество(), Перечень(Примеры, 3)));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

Процедура ДобавитьПредупрежденияПравилОбъектов(Результат, Политика)
	// Правило «*» и малый размер группы в режиме «только агрегаты».

	Для Каждого Правило Из Политика.Объекты Цикл
		Если Правило.Шаблон = "*" И Правило.Режим = "read" Тогда
			Результат.Добавить(НовоеПредупреждение("medium", "Правило «*» відкриває для читання всі об'єкти "
				+ "конфігурації, крім заборонених: краще перелічити потрібні об'єкти або шаблони за видами"));
		КонецЕсли;
		Если Правило.Режим = "aggregates" И Правило.МинимальныйРазмерГруппы > 0 И Правило.МинимальныйРазмерГруппы < 3 Тогда
			Результат.Добавить(НовоеПредупреждение("medium", СтрШаблон("Мінімальний розмір групи %1 для «%2»: "
				+ "агрегати по групах з одного-двох записів розкривають окремі значення",
				Формат(Правило.МинимальныйРазмерГруппы, "ЧН=0; ЧГ=0"), Правило.Шаблон)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПредупрежденияОграниченийСтрок(Результат, Политика)
	// Ошибки настройки ограничений строк. Параметры профиля без значений здесь не ошибка: значения
	// задает клиент, а политика профиля строится без клиента.

	Для Каждого Ограничение Из Политика.ОграниченияСтрок Цикл
		Если Ограничение.ВидСравнения <> "invalid" Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Ограничение.Параметр)
			И Политика.ПараметрыПрофиля.Получить(НРег(Ограничение.Параметр)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(НовоеПредупреждение("medium", СтрШаблон("Обмеження рядків «%1» за полем %2 некоректне "
			+ "(%3): об'єкт закрито для читання всім клієнтам профілю", Ограничение.Объект, Ограничение.Поле,
			Ограничение.Ошибка)));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПредупрежденияЛимитов(Результат, Лимиты)
	// Лимиты профиля больше значений по умолчанию.

	ПоУмолчанию = mcp1c_ПравилаДоступа.НовыеЛимиты();
	Имена = Новый Соответствие;
	Имена.Вставить("СтрокЗаВызов", "рядків за виклик");
	Имена.Вставить("ВызововВМинуту", "викликів за хвилину");
	Имена.Вставить("СтрокВСутки", "рядків на добу");
	Имена.Вставить("ГлубинаПериодаДней", "днів періоду");
	Имена.Вставить("РазмерОтветаБайт", "байт відповіді");
	Имена.Вставить("ГлубинаРазыменования", "розіменувань");
	Для Каждого Ключ Из СтрРазделить("СтрокЗаВызов,ВызововВМинуту,СтрокВСутки,ГлубинаПериодаДней,РазмерОтветаБайт,"
		+ "ГлубинаРазыменования", ",") Цикл
		Значение = Лимиты[Ключ];
		Типовое = ПоУмолчанию[Ключ];
		Если Значение > Типовое Тогда
			Уровень = ?(Значение >= Типовое * 4, "medium", "info");
			Результат.Добавить(НовоеПредупреждение(Уровень, СтрШаблон("Ліміт «%1» = %2 (типово %3)", Имена.Получить(Ключ),
				Формат(Значение, "ЧН=0; ЧГ=0"), Формат(Типовое, "ЧН=0; ЧГ=0"))));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция Перечень(Значения, Максимум)
	// Первые значения списка через запятую и число остальных.

	Первые = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если Первые.Количество() >= Максимум Тогда
			Прервать;
		КонецЕсли;
		Первые.Добавить(Значение);
	КонецЦикла;
	Текст = СтрСоединить(Первые, ", ");
	Если Значения.Количество() > Максимум Тогда
		Текст = Текст + СтрШаблон(" і ще %1", Значения.Количество() - Максимум);
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти

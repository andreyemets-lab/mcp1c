///////////////////////////////////////////////////////////////////////////////
// mcp1c_ЧувствительныеДанные: кандидаты в чувствительные поля и анализ рисков профиля
// (п. 7.6, 7.7, 9.2 ТЗ).
//
// Кандидат определяется по словам имени и синонима поля, имени табличной части и объекта:
// ИНН/РНОКПП, документ личности, адрес, телефон, e-mail, банковский счет или карта, дата и место
// рождения, оплата труда, контактная информация. Тип значения должен подходить категории: номер
// и адрес - строка, оплата труда - число; флаги и ссылки с похожими именами (EMAILСжиматьФайл,
// БанковскийСчет) кандидатами не считаются. Для категории предлагается маска; решение -
// замаскировать, запретить или оставить поле - принимает администратор.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Категории

// Коды категорий чувствительных полей в порядке проверки: e-mail раньше адреса (АдресЭП - почта);
// контактная информация определяется по таблице, а не по имени поля, поэтому она последняя.
//
// Возвращаемое значение:
//  Массив из Строка - коды категорий.
//
Функция КодыКатегорий() Экспорт

	Возврат СтрРазделить("email,tax_id,passport,phone,account,birth,salary,address,contacts", ",");

КонецФункции

// Категории, которые определяются по имени и синониму поля, в порядке проверки.
//
// Возвращаемое значение:
//  Массив из см. НоваяКатегория
//
Функция Категории() Экспорт

	Результат = Новый Массив;
	Для Каждого Код Из КодыКатегорий() Цикл
		Если Код <> "contacts" Тогда
			Результат.Добавить(ОписаниеКатегории(Код));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Описание категории: название, рекомендуемая маска и признаки в имени и синониме поля.
//
// Параметры:
//  Код - Строка - код категории (см. КодыКатегорий); неизвестный код - категория без признаков
//        с полной маской.
//
// Возвращаемое значение:
//  см. НоваяКатегория
//
Функция ОписаниеКатегории(Код) Экспорт

	Если Код = "email" Тогда
		Возврат НоваяКатегория("email", "E-mail", "full", 0, "емейл,имейл",
			"email,электроннаяпочт,электроннойпочт,електроннапошт,електронноїпошт,адресэп,адресаэп");
	ИначеЕсли Код = "tax_id" Тогда
		Возврат НоваяКатегория("tax_id", "ІПН / РНОКПП", "hash", 0, "инн,іпн,ипн,рнокпп,дрфо",
			"идентификационныйкод,идентификационныйномер,ідентифікаційнийкод,ідентифікаційнийномер,"
			+ "налоговыйномер,податковийномер");
	ИначеЕсли Код = "passport" Тогда
		Возврат НоваяКатегория("passport", "Документ особи", "full", 0, "",
			"паспорт,удостоверяющ,удостоверениеличност,посвідченняособ,документличност,документаличност",
			"полномоч,повноваж");
	ИначеЕсли Код = "phone" Тогда
		Возврат НоваяКатегория("phone", "Телефон", "partial", 4, "тел,факс,fax", "телефон,phone");
	ИначеЕсли Код = "account" Тогда
		Возврат НоваяКатегория("account", "Банківський рахунок або картка", "partial", 4, "iban,pan",
			"номерсчета,номеррахунку,расчетныйсчет,розрахунковийрахунок,банковскийсчет,банківськийрахунок,"
			+ "лицевойсчет,особовийрахунок,номеркарт,банковскаякарт,банківськакарт,платежнаякарт,платіжнакарт",
			"фактур,наоплат");
	ИначеЕсли Код = "birth" Тогда
		Возврат НоваяКатегория("birth", "Дата або місце народження", "full", 0, "",
			"датарожд,датанародж,месторожд,місценародж,birthdate,dateofbirth");
	ИначеЕсли Код = "salary" Тогда
		Возврат НоваяКатегория("salary", "Оплата праці", "round", 1000, "оклад*",
			"зарплат,заработн,заробітн,тарифнаяставк,тарифнаставк,тарифнуставк");
	ИначеЕсли Код = "address" Тогда
		Возврат НоваяКатегория("address", "Адреса", "full", 0, "",
			"адрес,address,местожительств,местопроживан,місцепроживан,прописк,почтовыйиндекс,поштовийіндекс",
			"адресхранен,адресноехран,адресныйсклад,адресат,хранилищ,временн,зберіганн,сервер,ресурс,сайт,url,http,веб");
	ИначеЕсли Код = "contacts" Тогда
		Возврат НоваяКатегория("contacts", "Контактна інформація", "full", 0, "", "");
	КонецЕсли;
	Возврат НоваяКатегория(Код, Код, "full", 0, "", "");

КонецФункции

// Категория чувствительного поля.
//
// Параметры:
//  Код - Строка - код категории (email, tax_id, ...).
//  Представление - Строка - название для администратора.
//  ВидМаски - Строка - рекомендуемая маска: full, partial, hash или round.
//  ПараметрМаски - Число - параметр рекомендуемой маски; 0 - по умолчанию.
//  Слова - Строка - слова имени или синонима через запятую (в нижнем регистре); слово со звездочкой
//          в конце - начало слова: «оклад*» - оклад, оклады, но не «докладний».
//  Подстроки - Строка - фрагменты слитного имени или синонима через запятую.
//  Исключения - Строка - фрагменты, при которых поле к категории не относится.
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - код категории.
//   * Представление - Строка - название категории.
//   * ВидМаски - Строка - рекомендуемая маска.
//   * ПараметрМаски - Число - параметр маски.
//   * Слова - Массив из Строка - слова имени или синонима.
//   * Подстроки - Массив из Строка - фрагменты слитного имени или синонима.
//   * Исключения - Массив из Строка - фрагменты-исключения.
//
Функция НоваяКатегория(Код, Представление, ВидМаски, ПараметрМаски, Слова, Подстроки, Исключения = "") Экспорт

	Категория = Новый Структура;
	Категория.Вставить("Код", Код);
	Категория.Вставить("Представление", Представление);
	Категория.Вставить("ВидМаски", ВидМаски);
	Категория.Вставить("ПараметрМаски", ПараметрМаски);
	Категория.Вставить("Слова", СтрРазделить(Слова, ",", Ложь));
	Категория.Вставить("Подстроки", СтрРазделить(Подстроки, ",", Ложь));
	Категория.Вставить("Исключения", СтрРазделить(Исключения, ",", Ложь));
	Возврат Категория;

КонецФункции

// Категория поля по имени, синониму, табличной части и объекту.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных ("Справочник.ФизическиеЛица").
//  ПутьПоля - Строка - имя поля или ТабличнаяЧасть.Поле.
//  Синоним - Строка - синоним поля.
//  ВсеКатегории - Неопределено, Массив из см. НоваяКатегория - результат Категории(), чтобы не строить
//                 его для каждого поля при обходе метаданных.
//  Типы - Неопределено, Массив из Строка - имена типов значения поля (см. mcp1c_Метаданные.ИменаТипов);
//         Неопределено - тип не проверяется.
//
// Возвращаемое значение:
//  Строка - код категории (см. КодыКатегорий); пустая строка - поле не похоже на чувствительное.
//
Функция КатегорияПоля(ПолноеИмяОбъекта, ПутьПоля, Синоним = "", ВсеКатегории = Неопределено,
	Типы = Неопределено) Экспорт

	Части = СтрРазделить(ПутьПоля, ".", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ИсходноеИмя = СокрЛП(Части[Части.ВГраница()]);
	ИмяПоля = НРег(ИсходноеИмя);
	Если ПоляБезДанных().Найти(ИмяПоля) <> Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Контактная информация (табличная часть или регистр) и документы физических лиц определяются
	// по таблице: у их полей общие имена (Представление, Серия, Номер).
	КодПоТаблице = КатегорияПоТаблице(НРег(КраткоеИмяОбъекта(ПолноеИмяОбъекта)),
		?(Части.Количество() > 1, НРег(СокрЛП(Части[0])), ""), ИмяПоля);
	Если Не ПустаяСтрока(КодПоТаблице) Тогда
		Возврат ?(ТипПодходит(КодПоТаблице, Типы), КодПоТаблице, "");
	КонецЕсли;

	// Слова - по исходному имени: границы CamelCase видны только до приведения к нижнему регистру.
	Слова = СловаИмени(ИсходноеИмя);
	СловаСинонима = СловаИмени(Синоним);
	Для Каждого Слово Из СловаСинонима Цикл
		Слова.Добавить(Слово);
	КонецЦикла;
	Слитно = ИмяПоля + " " + СтрСоединить(СловаСинонима, "");
	Для Каждого Категория Из ?(ВсеКатегории = Неопределено, Категории(), ВсеКатегории) Цикл
		Если ТипПодходит(Категория.Код, Типы) И ПодходитКатегории(Категория, Слова, Слитно) Тогда
			Возврат Строка(Категория.Код);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Слова идентификатора или текста в нижнем регистре: ИННФизЛица - инн, физ, лица;
// «Номер телефону» - номер, телефону. Разделители - все, кроме букв и цифр.
//
// Параметры:
//  Текст - Строка - имя или синоним.
//
// Возвращаемое значение:
//  Массив из Строка - слова.
//
Функция СловаИмени(Знач Текст) Экспорт

	Результат = Новый Массив;
	Слово = "";
	Длина = СтрДлина(Текст);
	Для Позиция = 1 По Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Не ЭтоБуква(Символ) И Не ЭтоЦифра(Символ) Тогда
			ДобавитьСлово(Результат, Слово);
			Слово = "";
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Слово) И НачинаетсяНовоеСлово(Текст, Позиция, Символ) Тогда
			ДобавитьСлово(Результат, Слово);
			Слово = "";
		КонецЕсли;
		Слово = Слово + Символ;
	КонецЦикла;
	ДобавитьСлово(Результат, Слово);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Кандидаты

// Кандидат в чувствительные поля для отчета и решения администратора.
//
// Параметры:
//  Объект - Строка - полное имя объекта.
//  Поле - Строка - имя поля или ТабличнаяЧасть.Поле.
//  Синоним - Строка - синоним поля.
//  КодКатегории - Строка - код категории (см. КатегорияПоля).
//
// Возвращаемое значение:
//  Структура:
//   * Объект - Строка - полное имя объекта.
//   * Поле - Строка - путь поля.
//   * Синоним - Строка - синоним поля.
//   * Категория - Строка - код категории.
//   * ПредставлениеКатегории - Строка - название категории.
//   * ВидМаски - Строка - рекомендуемая маска.
//   * ПараметрМаски - Число - параметр рекомендуемой маски.
//   * Состояние - Строка - visible (видно без маски), masked, hidden (скрыто) или пустая строка (не оценено).
//   * Маска - Строка - вид действующей маски для masked.
//
Функция НовыйКандидат(Объект, Поле, Синоним, КодКатегории) Экспорт

	Категория = ОписаниеКатегории(КодКатегории);
	Кандидат = Новый Структура;
	Кандидат.Вставить("Объект", Объект);
	Кандидат.Вставить("Поле", Поле);
	Кандидат.Вставить("Синоним", Синоним);
	Кандидат.Вставить("Категория", Категория.Код);
	Кандидат.Вставить("ПредставлениеКатегории", Категория.Представление);
	Кандидат.Вставить("ВидМаски", Категория.ВидМаски);
	Кандидат.Вставить("ПараметрМаски", Категория.ПараметрМаски);
	Кандидат.Вставить("Состояние", "");
	Кандидат.Вставить("Маска", "");
	Возврат Кандидат;

КонецФункции

// Заполняет состояние кандидата по политике профиля: видно без маски, замаскировано или скрыто.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Кандидат - см. НовыйКандидат
//  ТипыПоля - Неопределено, Массив из Строка - типы поля для глобальных запретов по типу.
//
Процедура ЗаполнитьСостояние(Политика, Кандидат, ТипыПоля = Неопределено) Экспорт

	Если Не mcp1c_ПравилаДоступа.ПолеДоступно(Политика, Кандидат.Объект, Кандидат.Поле, ТипыПоля) Тогда
		Кандидат.Состояние = "hidden";
		Возврат;
	КонецЕсли;
	Маска = mcp1c_ПравилаДоступа.МаскаПоля(Политика, Кандидат.Объект, Кандидат.Поле);
	Если Маска = Неопределено Тогда
		Кандидат.Состояние = "visible";
	Иначе
		Кандидат.Состояние = "masked";
		Кандидат.Маска = Маска.Вид;
	КонецЕсли;

КонецПроцедуры

// Представление маски для отчета: «повна», «часткова (4)», «хеш», «округлення до 1000».
//
// Параметры:
//  ВидМаски - Строка - full, partial, hash или round.
//  ПараметрМаски - Число - параметр маски.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ПредставлениеМаски(ВидМаски, ПараметрМаски = 0) Экспорт

	Возврат mcp1c_Маскирование.Представление(mcp1c_Маскирование.НоваяМаска(ВидМаски, ПараметрМаски));

КонецФункции

#КонецОбласти

#Область АнализРисков

// Предупреждения анализа рисков профиля (п. 9.2 ТЗ): чувствительные поля без маски, клиенты
// с внешним AI-провайдером, правило «*», документы и регистры без обязательного отбора по периоду,
// малый размер группы в режиме агрегатов, ошибки ограничений строк, увеличенные лимиты,
// пустые глобальные запреты полей.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//  Кандидаты - Массив из см. НовыйКандидат - с заполненным состоянием.
//  БезОтбораПериода - Массив из Строка - читаемые документы и регистры без обязательного отбора по периоду.
//  ВнешниеПровайдеры - Массив из Строка - клиенты профиля с внешним AI-провайдером.
//
// Возвращаемое значение:
//  Массив из см. НовоеПредупреждение
//
Функция ПредупрежденияПрофиля(Политика, Кандидаты, БезОтбораПериода, ВнешниеПровайдеры) Экспорт

	Результат = Новый Массив;
	Если Политика.Объекты.Количество() = 0 Тогда
		Результат.Добавить(НовоеПредупреждение("info", "Профіль не відкриває жодного об'єкта: клієнтам доступні лише "
			+ "get_context і, якщо дозволено, метадані без даних"));
	КонецЕсли;
	Если Политика.ЗапрещенныеПоля.Количество() = 0 Тогда
		Результат.Добавить(НовоеПредупреждение("high", "Глобальні заборони полів порожні: паролі, токени й ключі "
			+ "не закриті шаблонами (п. 7.6 ТЗ); поверніть типові шаблони в налаштуваннях сервера"));
	КонецЕсли;
	ДобавитьПредупрежденияЧувствительныхПолей(Результат, Кандидаты, ВнешниеПровайдеры);
	ДобавитьПредупрежденияПравилОбъектов(Результат, Политика);
	Если БезОтбораПериода.Количество() > 0 Тогда
		Результат.Добавить(НовоеПредупреждение("medium", СтрШаблон(
			"%1 документів і регістрів читаються без обов'язкового фільтра періоду: %2. Клієнт може вивантажити "
			+ "всю історію в межах лімітів; для великих об'єктів увімкніть «Обязательный фильтр периода»",
			БезОтбораПериода.Количество(), Перечень(БезОтбораПериода, 5))));
	КонецЕсли;
	ДобавитьПредупрежденияОграниченийСтрок(Результат, Политика);
	ДобавитьПредупрежденияЛимитов(Результат, Политика.Лимиты);
	Возврат Результат;

КонецФункции

// Предупреждение анализа рисков.
//
// Параметры:
//  Уровень - Строка - high, medium или info.
//  Текст - Строка - текст для администратора.
//
// Возвращаемое значение:
//  Структура:
//   * Уровень - Строка - high, medium или info.
//   * Текст - Строка - текст для администратора.
//
Функция НовоеПредупреждение(Уровень, Текст) Экспорт

	Возврат Новый Структура("Уровень, Текст", Уровень, Текст);

КонецФункции

// Текст отчета анализа рисков или поиска чувствительных полей.
//
// Параметры:
//  Заголовок - Строка - первая строка отчета.
//  Предупреждения - Массив из см. НовоеПредупреждение
//  Кандидаты - Массив из см. НовыйКандидат
//
// Возвращаемое значение:
//  Строка - текст отчета.
//
Функция ТекстОтчета(Заголовок, Предупреждения, Кандидаты) Экспорт

	Строки = Новый Массив;
	Строки.Добавить(Заголовок);
	Если Предупреждения.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить("Попередження:");
		Для Каждого Уровень Из СтрРазделить("high,medium,info", ",") Цикл
			Для Каждого Предупреждение Из Предупреждения Цикл
				Если Предупреждение.Уровень = Уровень Тогда
					Строки.Добавить(СтрШаблон("  [%1] %2", ПредставлениеУровня(Уровень), Предупреждение.Текст));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Строки.Добавить("");
	Если Кандидаты.Количество() = 0 Тогда
		Строки.Добавить("Кандидатів у чутливі поля не знайдено.");
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	Строки.Добавить(СтрШаблон("Кандидати в чутливі поля (%1, без маски - %2):", Кандидаты.Количество(),
		КоличествоВСостоянии(Кандидаты, "visible")));
	Для Каждого Категория Из ВсеКатегории() Цикл
		ДобавитьСтрокиКатегории(Строки, Категория, Кандидаты);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Количество кандидатов в состоянии.
//
// Параметры:
//  Кандидаты - Массив из см. НовыйКандидат
//  Состояние - Строка - visible, masked, hidden или пустая строка.
//
// Возвращаемое значение:
//  Число - количество.
//
Функция КоличествоВСостоянии(Кандидаты, Состояние) Экспорт

	Количество = 0;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Состояние = Состояние Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КатегорияПоТаблице(ИмяОбъекта, ИмяТабличнойЧасти, ИмяПоля)
	// contacts или passport по таблице поля; пустая строка - по таблице категория не определяется.

	Если (ЕстьФрагмент(ИмяТабличнойЧасти, ФрагментыКонтактнойИнформации())
		Или ЕстьФрагмент(ИмяОбъекта, ФрагментыКонтактнойИнформации()))
		И СлужебныеПоляКонтактнойИнформации().Найти(ИмяПоля) = Неопределено Тогда
		Возврат "contacts";
	КонецЕсли;
	Если ЕстьФрагмент(ИмяОбъекта, ФрагментыДокументовФизическихЛиц())
		И ПоляДокументаЛичности().Найти(ИмяПоля) <> Неопределено Тогда
		Возврат "passport";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПодходитКатегории(Категория, Слова, Слитно)
	// Совпало слово или фрагмент и нет фрагмента-исключения.

	Совпало = Ложь;
	Для Каждого Образец Из Категория.Слова Цикл
		Если ЕстьСлово(Слова, Образец) Тогда
			Совпало = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не Совпало И Не ЕстьФрагмент(Слитно, Категория.Подстроки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЕстьФрагмент(Слитно, Категория.Исключения);

КонецФункции

Функция ЕстьСлово(Слова, Образец)
	// Слово целиком или, для образца со звездочкой в конце, начало слова.

	Если Не СтрЗаканчиваетсяНа(Образец, "*") Тогда
		Возврат Слова.Найти(Образец) <> Неопределено;
	КонецЕсли;
	Начало = Лев(Образец, СтрДлина(Образец) - 1);
	Для Каждого Слово Из Слова Цикл
		Если СтрНачинаетсяС(Слово, Начало) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ТипПодходит(КодКатегории, Типы)
	// Может ли значение поля таких типов содержать данные категории; без типов - не проверяется.

	Если Типы = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого ИмяТипа Из ТипыЗначенийКатегории(КодКатегории) Цикл
		Если Типы.Найти(ИмяТипа) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ТипыЗначенийКатегории(КодКатегории)
	// Типы значений с данными категории: номера, адреса и контакты - строки; дата рождения и дата
	// выдачи документа - даты (место рождения и номер документа - строки); оплата труда - число.

	Если КодКатегории = "birth" Или КодКатегории = "passport" Тогда
		Возврат СтрРазделить("Строка,Дата", ",");
	ИначеЕсли КодКатегории = "salary" Тогда
		Возврат СтрРазделить("Число", ",");
	ИначеЕсли КодКатегории = "tax_id" Тогда
		Возврат СтрРазделить("Строка,Число", ",");
	КонецЕсли;
	Возврат СтрРазделить("Строка", ",");

КонецФункции

Функция ЕстьФрагмент(Текст, Фрагменты)
	// Содержит ли текст хотя бы один фрагмент.

	Для Каждого Фрагмент Из Фрагменты Цикл
		Если СтрНайти(Текст, Фрагмент) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция КраткоеИмяОбъекта(ПолноеИмя)
	// Имя объекта без класса: "Справочник.ФизическиеЛица" - "ФизическиеЛица".

	Позиция = СтрНайти(ПолноеИмя, ".");
	Возврат ?(Позиция = 0, ПолноеИмя, Сред(ПолноеИмя, Позиция + 1));


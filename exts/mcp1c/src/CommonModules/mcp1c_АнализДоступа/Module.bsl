///////////////////////////////////////////////////////////////////////////////
// mcp1c_АнализДоступа: поиск чувствительных полей в метаданных конфигурации и анализ рисков
// профиля доступа (п. 7.6, 7.7, 9.2 ТЗ); маскирование найденных полей по решению администратора;
// профиль «Только метаданные» для первого подключения.
//
// Категории полей и тексты предупреждений - в чистом модуле mcp1c_ЧувствительныеДанные; здесь -
// обход метаданных, политика профиля из справочников и запись решений администратора.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Кандидаты в чувствительные поля по метаданным конфигурации и их состояние в профиле.
//
// Параметры:
//  Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа, Неопределено - профиль; без профиля поля
//            оцениваются только по глобальным запретам (hidden - запрещено глобально).
//
// Возвращаемое значение:
//  Массив из см. mcp1c_ЧувствительныеДанные.НовыйКандидат
//
Функция ЧувствительныеПоля(Профиль = Неопределено) Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Возврат НайтиЧувствительныеПоля(Профиль, mcp1c_Настройки.Получить());

КонецФункции

// Анализ рисков профиля (п. 9.2 ТЗ): чувствительные поля без маски, клиенты с внешним
// AI-провайдером, правило «*», объекты без обязательного отбора по периоду, лимиты.
//
// Параметры:
//  Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа - профиль.
//
// Возвращаемое значение:
//  Структура:
//   * Предупреждения - Массив из см. mcp1c_ЧувствительныеДанные.НовоеПредупреждение
//   * Кандидаты - Массив из см. mcp1c_ЧувствительныеДанные.НовыйКандидат
//   * БезМаски - Число - чувствительных полей, видимых без маски.
//   * Текст - Строка - отчет для администратора.
//
Функция АнализРисков(Профиль) Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	ПроверитьПрофиль(Профиль);
	Настройки = mcp1c_Настройки.Получить();
	Политика = mcp1c_Политики.ПолитикаПрофиля(Профиль, Настройки);
	Кандидаты = НайтиЧувствительныеПоля(Профиль, Настройки);
	Предупреждения = mcp1c_ЧувствительныеДанные.ПредупрежденияПрофиля(Политика, Кандидаты,
		ОбъектыБезОтбораПериода(Политика), КлиентыСВнешнимПровайдером(Профиль));

	Результат = Новый Структура;
	Результат.Вставить("Предупреждения", Предупреждения);
	Результат.Вставить("Кандидаты", Кандидаты);
	Результат.Вставить("БезМаски", mcp1c_ЧувствительныеДанные.КоличествоВСостоянии(Кандидаты, "visible"));
	Результат.Вставить("Текст", mcp1c_ЧувствительныеДанные.ТекстОтчета(
		СтрШаблон("Аналіз ризиків профілю «%1»", Профиль), Предупреждения, Кандидаты));
	Возврат Результат;

КонецФункции

// Отчет о кандидатах в чувствительные поля по всей конфигурации - для решения администратора
// (маски в профилях или глобальные запреты).
//
// Возвращаемое значение:
//  Строка - отчет.
//
Функция ОтчетЧувствительныхПолей() Экспорт

	Кандидаты = ЧувствительныеПоля();
	Предупреждения = Новый Массив;
	Предупреждения.Добавить(mcp1c_ЧувствительныеДанные.НовоеПредупреждение("info",
		"Кандидати знайдено за іменами й синонімами полів: перевірте список і вирішіть для кожного профілю - "
		+ "маскувати, заборонити чи залишити (команда «Аналіз ризиків» на формі профілю)"));
	Возврат mcp1c_ЧувствительныеДанные.ТекстОтчета("Чутливі поля конфігурації", Предупреждения, Кандидаты);

КонецФункции

// Добавляет в профиль маски для чувствительных полей, которые профиль показывает без маски
// (решение администратора по итогам анализа рисков). Вид маски - рекомендованный для категории.
//
// Параметры:
//  Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа - профиль.
//  Поля - Неопределено, Массив из Строка - поля "Объект.Поле" или "Объект.ТабличнаяЧасть.Поле";
//         Неопределено - все видимые без маски.
//
// Возвращаемое значение:
//  Число - добавлено правил маскирования.
//
Функция ЗамаскироватьЧувствительныеПоля(Профиль, Поля = Неопределено) Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	ПроверитьПрофиль(Профиль);
	Кандидаты = НайтиЧувствительныеПоля(Профиль, mcp1c_Настройки.Получить());

	Объект = Профиль.ПолучитьОбъект();
	Объект.Заблокировать();
	Добавлено = 0;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Состояние <> "visible"
			Или Поля <> Неопределено И Поля.Найти(Кандидат.Объект + "." + Кандидат.Поле) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка_ = Объект.Поля.Добавить();
		Строка_.Объект = Кандидат.Объект;
		Строка_.Поле = Кандидат.Поле;
		Строка_.Действие = Перечисления.mcp1c_ДействияСПолями.Маскировать;
		Строка_.ВидМаски = ВидМаски(Кандидат.ВидМаски);
		Строка_.ПараметрМаски = Кандидат.ПараметрМаски;
		Добавлено = Добавлено + 1;
	КонецЦикла;
	Если Добавлено = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Объект.Записать();
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Пользователь %1 добавил в профиль %2 маски %3 чувствительных полей",
		ИмяПользователя(), Профиль, Добавлено));
	Возврат Добавлено;

КонецФункции

// Создает профиль «Тільки метадані»: get_context, list_objects и describe_object для всех объектов,
// без инструментов чтения данных, - для первого подключения клиента (п. 9.2 ТЗ, мастер).
//
// Параметры:
//  Наименование - Строка - наименование профиля.
//
// Возвращаемое значение:
//  СправочникСсылка.mcp1c_ПрофилиДоступа - созданный или найденный профиль.
//
Функция ПрофильТолькоМетаданные(Наименование = "Тільки метадані") Экспорт

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Найденный = Справочники.mcp1c_ПрофилиДоступа.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Найденный) Тогда
		Возврат Найденный;
	КонецЕсли;
	Объект = Справочники.mcp1c_ПрофилиДоступа.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.Описание = "Лише структура бази: об'єкти, реквізити й табличні частини без даних. Для першого "
		+ "підключення й перевірки клієнта.";
	Для Каждого Инструмент Из СтрРазделить("get_context,list_objects,describe_object", ",") Цикл
		Объект.Инструменты.Добавить().Инструмент = Инструмент;
	КонецЦикла;
	Строка_ = Объект.Объекты.Добавить();
	Строка_.Объект = "*";
	Строка_.Режим = Перечисления.mcp1c_РежимыДоступаКОбъектам.Чтение;
	Строка_.ПолитикаПолей = Перечисления.mcp1c_ПолитикиПолей.ВсеКромеЗапрещенных;
	Объект.Записать();
	mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Пользователь %1 создал профиль доступа %2",
		ИмяПользователя(), Объект.Ссылка));
	Возврат Объект.Ссылка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиЧувствительныеПоля(Профиль, Настройки)
	// Обход метаданных: реквизиты, табличные части, измерения и ресурсы. С профилем - только объекты,
	// которые профиль открывает (остальные клиенту не видны).

	ЕстьПрофиль = ЗначениеЗаполнено(Профиль);
	Политика = mcp1c_Политики.ПолитикаПрофиля(?(ЕстьПрофиль, Профиль, Неопределено), Настройки);
	Категории = mcp1c_ЧувствительныеДанные.Категории();
	Результат = Новый Массив;
	Для Каждого ОбъектМД Из mcp1c_Метаданные.ВсеОбъекты() Цикл
		ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД);
		Если ЕстьПрофиль И Не mcp1c_ПравилаДоступа.ОбъектДоступен(Политика, ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Поле Из ПоляОбъекта(ОбъектМД) Цикл
			КодКатегории = mcp1c_ЧувствительныеДанные.КатегорияПоля(ПолноеИмя, Поле.Путь, Поле.Синоним, Категории);
			Если ПустаяСтрока(КодКатегории) Тогда
				Продолжить;
			КонецЕсли;
			Кандидат = mcp1c_ЧувствительныеДанные.НовыйКандидат(ПолноеИмя, Поле.Путь, Поле.Синоним, КодКатегории);
			Если ЕстьПрофиль Тогда
				mcp1c_ЧувствительныеДанные.ЗаполнитьСостояние(Политика, Кандидат, Поле.Типы);
			ИначеЕсли mcp1c_ПравилаДоступа.ОбъектЗапрещенГлобально(Политика, ПолноеИмя)
				Или mcp1c_ПравилаДоступа.ПолеЗапрещеноГлобально(Политика, Поле.Путь, Поле.Типы) Тогда
				Кандидат.Состояние = "hidden";
			КонецЕсли;
			Результат.Добавить(Кандидат);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоляОбъекта(ОбъектМД)
	// Поля объекта с путями для правил профиля: Поле или ТабличнаяЧасть.Поле.

	Результат = Новый Массив;
	Код = mcp1c_Метаданные.КодВида(ОбъектМД);
	Если ОбъектныеВиды().Найти(Код) <> Неопределено Тогда
		ДобавитьПоля(Результат, ОбъектМД.Реквизиты, "");
		Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
			ДобавитьПоля(Результат, ТабличнаяЧасть.Реквизиты, ТабличнаяЧасть.Имя + ".");
		КонецЦикла;
	ИначеЕсли Регистры().Найти(Код) <> Неопределено Тогда
		ДобавитьПоля(Результат, ОбъектМД.Измерения, "");
		ДобавитьПоля(Результат, ОбъектМД.Ресурсы, "");
		ДобавитьПоля(Результат, ОбъектМД.Реквизиты, "");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДобавитьПоля(Результат, Коллекция, Префикс)

	Для Каждого ПолеМД Из Коллекция Цикл
		Поле = Новый Структура;
		Поле.Вставить("Путь", Префикс + ПолеМД.Имя);
		Поле.Вставить("Синоним", ПолеМД.Синоним);
		Поле.Вставить("Типы", mcp1c_Метаданные.ИменаТипов(ПолеМД.Тип));
		Результат.Добавить(Поле);
	КонецЦикла;

КонецПроцедуры

Функция ОбъектныеВиды()

	Возврат СтрРазделить("catalog,document,chart_of_characteristic_types,chart_of_accounts,chart_of_calculation_types,"
		+ "business_process,task", ",");

КонецФункции

Функция Регистры()

	Возврат СтрРазделить("information_register,accumulation_register,accounting_register,calculation_register", ",");

КонецФункции

Функция ОбъектыБезОтбораПериода(Политика)
	// Документы, регистры накопления, бухгалтерии, расчета и периодические регистры сведений,
	// которые профиль открывает без обязательного отбора по периоду.

	Результат = Новый Массив;
	Непериодический = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	Для Каждого ОбъектМД Из mcp1c_Метаданные.ВсеОбъекты() Цикл
		Код = mcp1c_Метаданные.КодВида(ОбъектМД);
		СПериодом = Код = "document" Или Код = "accumulation_register" Или Код = "accounting_register"
			Или Код = "calculation_register"
			Или Код = "information_register" И ОбъектМД.ПериодичностьРегистраСведений <> Непериодический;
		Если Не СПериодом Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД);
		Если mcp1c_ПравилаДоступа.ОбъектДоступен(Политика, ПолноеИмя)
			И Не mcp1c_ПравилаДоступа.ТребуетсяОтборПоПериоду(Политика, ПолноеИмя) Тогда
			Результат.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлиентыСВнешнимПровайдером(Профиль)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Клиенты.Наименование КАК Наименование
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|ГДЕ
	|	Клиенты.Профиль = &Профиль
	|	И Клиенты.ВнешнийПровайдер
	|	И НЕ Клиенты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование");

КонецФункции

Функция ВидМаски(Код)
	// Значение перечисления вида маски по коду mcp1c_Маскирование.

	Если Код = "partial" Тогда
		Возврат Перечисления.mcp1c_ВидыМасок.Частичная;
	ИначеЕсли Код = "hash" Тогда
		Возврат Перечисления.mcp1c_ВидыМасок.Хеш;
	ИначеЕсли Код = "round" Тогда
		Возврат Перечисления.mcp1c_ВидыМасок.Округление;
	КонецЕсли;
	Возврат Перечисления.mcp1c_ВидыМасок.Полная;

КонецФункции

Процедура ПроверитьПрофиль(Профиль)

	Если ТипЗнч(Профиль) <> Тип("СправочникСсылка.mcp1c_ПрофилиДоступа") Или Профиль.Пустая() Тогда
		ВызватьИсключение "Не вказано профіль доступу";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// mcp1c_Политики: политика клиента из справочников mcp1c_КлиентыДоступа и mcp1c_ПрофилиДоступа
// (п. 7.1-7.6 ТЗ). Справочники читаются по правам роли mcp1c_Сервис; решения по политике
// принимает чистый модуль mcp1c_ПравилаДоступа.
//
// Ошибки настройки закрывают доступ: строка профиля без режима - объект запрещен, строка поля
// без действия - поле запрещено, ограничение строк с некорректным значением или без значения
// параметра в клиенте - объект недоступен для чтения (см. mcp1c_ЗапросыДанных).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Политика клиента: профиль, ограничения строк, глобальные запреты и эффективные лимиты.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент доступа.
//  Настройки - см. mcp1c_Настройки.Получить
//
// Возвращаемое значение:
//  см. mcp1c_ПравилаДоступа.НоваяПолитика
//
Функция ПолитикаКлиента(Клиент, Настройки) Экспорт

	Политика = mcp1c_ПравилаДоступа.НоваяПолитика();
	Политика.Клиент = Клиент;
	Для Каждого Шаблон Из mcp1c_Служебный.СвойствоМассив(Настройки, "bannedFieldPatterns") Цикл
		Если ТипЗнч(Шаблон) = Тип("Строка") И Не ПустаяСтрока(Шаблон) Тогда
			Политика.ЗапрещенныеПоля.Добавить(Шаблон);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Шаблон Из mcp1c_Служебный.СвойствоМассив(Настройки, "bannedObjectPatterns") Цикл
		Если ТипЗнч(Шаблон) = Тип("Строка") И Не ПустаяСтрока(Шаблон) Тогда
			Политика.ЗапрещенныеОбъекты.Добавить(Шаблон);
		КонецЕсли;
	КонецЦикла;

	Данные = ДанныеКлиента(Клиент);
	Если Данные = Неопределено Тогда
		Возврат Политика; // клиента нет: все запрещено
	КонецЕсли;
	Политика.ИмяКлиента = Данные.ИмяКлиента;
	Если Не ЗначениеЗаполнено(Данные.Профиль) Или Данные.ПрофильУдален Тогда
		Возврат Политика;
	КонецЕсли;
	Политика.Профиль = Данные.Профиль;
	Политика.ИмяПрофиля = Данные.ИмяПрофиля;
	Политика.ВерсияПрофиля = Данные.ВерсияПрофиля;
	Политика.РазрешитьПомеченныеНаУдаление = Данные.РазрешитьПомеченныеНаУдаление;
	ЗаполнитьЛимиты(Политика.Лимиты, Данные);
	ЗаполнитьПравилаПрофиля(Политика, Данные.Профиль, Клиент);
	ЗаполнитьСольМаскирования(Политика, Данные.Профиль);

	Если Не ПустаяСтрока(Данные.ИмяПользователяИБ) Тогда
		ОграничитьПравамиПользователя(Политика, Данные.ИмяПользователяИБ);
	КонецЕсли;
	Возврат Политика;

КонецФункции

// Описание политики для get_context: профиль и лимиты без перечня правил.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - profile, profile_version, limits.
//
Функция ОписаниеДляМодели(Политика) Экспорт

	Лимиты = Новый Соответствие;
	Лимиты.Вставить("rows_per_call", Политика.Лимиты.СтрокЗаВызов);
	Лимиты.Вставить("calls_per_minute", Политика.Лимиты.ВызововВМинуту);
	Лимиты.Вставить("rows_per_day", Политика.Лимиты.СтрокВСутки);
	Лимиты.Вставить("max_period_days", Политика.Лимиты.ГлубинаПериодаДней);
	Лимиты.Вставить("max_response_kb", Окр(Политика.Лимиты.РазмерОтветаБайт / 1024, 0));
	Лимиты.Вставить("max_path_depth", Политика.Лимиты.ГлубинаРазыменования);

	Результат = Новый Соответствие;
	Результат.Вставить("profile", Политика.ИмяПрофиля);
	Результат.Вставить("profile_version", Политика.ВерсияПрофиля);
	Результат.Вставить("limits", Лимиты);
	Результат.Вставить("include_deleted_allowed", Политика.РазрешитьПомеченныеНаУдаление);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеКлиента(Клиент)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Клиенты.Наименование КАК ИмяКлиента,
	|	Клиенты.Профиль КАК Профиль,
	|	Клиенты.ИмяПользователяИБ КАК ИмяПользователяИБ,
	|	Клиенты.ЛимитСтрок КАК ЛимитСтрокКлиента,
	|	Клиенты.ВызововВМинуту КАК ВызововВМинутуКлиента,
	|	Клиенты.СтрокВСутки КАК СтрокВСуткиКлиента,
	|	ЕСТЬNULL(Профили.Наименование, """") КАК ИмяПрофиля,
	|	ЕСТЬNULL(Профили.Версия, 0) КАК ВерсияПрофиля,
	|	ЕСТЬNULL(Профили.ПометкаУдаления, ИСТИНА) КАК ПрофильУдален,
	|	ЕСТЬNULL(Профили.ЛимитСтрок, 0) КАК ЛимитСтрок,
	|	ЕСТЬNULL(Профили.ВызововВМинуту, 0) КАК ВызововВМинуту,
	|	ЕСТЬNULL(Профили.СтрокВСутки, 0) КАК СтрокВСутки,
	|	ЕСТЬNULL(Профили.ГлубинаПериодаДней, 0) КАК ГлубинаПериодаДней,
	|	ЕСТЬNULL(Профили.РазмерОтветаКБ, 0) КАК РазмерОтветаКБ,
	|	ЕСТЬNULL(Профили.ГлубинаРазыменования, 0) КАК ГлубинаРазыменования,
	|	ЕСТЬNULL(Профили.РазрешитьПомеченныеНаУдаление, ЛОЖЬ) КАК РазрешитьПомеченныеНаУдаление
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.mcp1c_ПрофилиДоступа КАК Профили
	|		ПО Клиенты.Профиль = Профили.Ссылка
	|ГДЕ
	|	Клиенты.Ссылка = &Клиент");
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = Новый Структура;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Данные.Вставить(Колонка.Имя, Таблица[0][Колонка.Имя]);
	КонецЦикла;
	Данные.ИмяПользователяИБ = СокрЛП(Данные.ИмяПользователяИБ);
	Возврат Данные;

КонецФункции

Процедура ЗаполнитьЛимиты(Лимиты, Данные)
	// Лимиты профиля (п. 7.3 ТЗ) и лимиты клиента, которые могут их только уменьшить (п. 7.1 ТЗ).

	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "СтрокЗаВызов", Данные.ЛимитСтрок);
	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "ВызововВМинуту", Данные.ВызововВМинуту);
	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "СтрокВСутки", Данные.СтрокВСутки);
	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "ГлубинаПериодаДней", Данные.ГлубинаПериодаДней);
	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "РазмерОтветаБайт", Данные.РазмерОтветаКБ * 1024);
	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "ГлубинаРазыменования", Данные.ГлубинаРазыменования);

	mcp1c_ПравилаДоступа.УменьшитьЛимит(Лимиты, "СтрокЗаВызов", Данные.ЛимитСтрокКлиента);
	mcp1c_ПравилаДоступа.УменьшитьЛимит(Лимиты, "ВызововВМинуту", Данные.ВызововВМинутуКлиента);
	mcp1c_ПравилаДоступа.УменьшитьЛимит(Лимиты, "СтрокВСутки", Данные.СтрокВСуткиКлиента);

КонецПроцедуры

Процедура ЗаполнитьПравилаПрофиля(Политика, Профиль, Клиент)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Инструмент КАК Инструмент
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.Инструменты КАК Т
	|ГДЕ
	|	Т.Ссылка = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Объект КАК Объект,
	|	Т.Режим КАК Режим,
	|	Т.ПолитикаПолей КАК ПолитикаПолей,
	|	Т.ОбязательныйФильтрПериода КАК ОбязательныйФильтрПериода,
	|	Т.МинимальныйРазмерГруппы КАК МинимальныйРазмерГруппы
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.Объекты КАК Т
	|ГДЕ
	|	Т.Ссылка = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Объект КАК Объект,
	|	Т.Поле КАК Поле,
	|	Т.Действие КАК Действие,
	|	Т.ВидМаски КАК ВидМаски,
	|	Т.ПараметрМаски КАК ПараметрМаски
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.Поля КАК Т
	|ГДЕ
	|	Т.Ссылка = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Объект КАК Объект,
	|	Т.Поле КАК Поле,
	|	Т.ВидСравнения КАК ВидСравнения,
	|	Т.Значение КАК Значение,
	|	Т.Параметр КАК Параметр,
	|	Т.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.ОграниченияСтрок КАК Т
	|ГДЕ
	|	Т.Ссылка = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Имя КАК Имя,
	|	Т.ТипЗначения КАК ТипЗначения,
	|	Т.Описание КАК Описание
	|ИЗ
	|	Справочник.mcp1c_ПрофилиДоступа.Параметры КАК Т
	|ГДЕ
	|	Т.Ссылка = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Параметр КАК Параметр,
	|	Т.Значение КАК Значение
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа.ЗначенияПараметров КАК Т
	|ГДЕ
	|	Т.Ссылка = &Клиент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Результаты = Запрос.ВыполнитьПакет();

	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Выборка.Инструмент);
		Если Не ПустаяСтрока(Имя) И Политика.Инструменты.Найти(Имя) = Неопределено Тогда
			Политика.Инструменты.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	ТолькоРазрешенные = Перечисления.mcp1c_ПолитикиПолей.ТолькоРазрешенные;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Объект) Тогда
			Продолжить;
		КонецЕсли;
		Правило = mcp1c_ПравилаДоступа.НовоеПравилоОбъекта(Выборка.Объект, КодРежима(Выборка.Режим),
			Выборка.ПолитикаПолей = ТолькоРазрешенные, Выборка.ОбязательныйФильтрПериода = Истина);
		Правило.МинимальныйРазмерГруппы = Число(Выборка.МинимальныйРазмерГруппы);
		Политика.Объекты.Добавить(Правило);
	КонецЦикла;

	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Объект) Или ПустаяСтрока(Выборка.Поле) Тогда
			Продолжить;
		КонецЕсли;
		Политика.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля(Выборка.Объект, Выборка.Поле,
			КодДействия(Выборка.Действие), КодВидаМаски(Выборка.ВидМаски), Число(Выборка.ПараметрМаски)));
	КонецЦикла;

	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Объект) Тогда
			Продолжить;
		КонецЕсли;
		Политика.ОграниченияСтрок.Добавить(НовоеОграничение(Выборка));
	КонецЦикла;

	Выборка = Результаты[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Выборка.Имя);
		Если Не ПустаяСтрока(Имя) Тогда
			Политика.ПараметрыПрофиля.Вставить(НРег(Имя), mcp1c_ПравилаДоступа.НовыйПараметрПрофиля(Имя,
				Выборка.ТипЗначения, Выборка.Описание));
		КонецЕсли;
	КонецЦикла;

	Выборка = Результаты[5].Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Выборка.Параметр);
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Значения = Политика.ЗначенияПараметров.Получить(НРег(Имя));
		Если Значения = Неопределено Тогда
			Значения = Новый Массив;
			Политика.ЗначенияПараметров.Вставить(НРег(Имя), Значения);
		КонецЕсли;
		Для Каждого Значение Из mcp1c_ПравилаДоступа.ЗначенияПараметраИзJSON(Выборка.Значение) Цикл
			Значения.Добавить(Значение);
		КонецЦикла;
	КонецЦикла;
	mcp1c_ПравилаДоступа.ПодставитьПараметры(Политика);

КонецПроцедуры

Функция КодРежима(Режим)
	// Режим объекта для mcp1c_ПравилаДоступа; строка без режима запрещает объект:
	// ошибка настройки не открывает доступ.

	Если Режим = Перечисления.mcp1c_РежимыДоступаКОбъектам.Чтение Тогда
		Возврат "read";
	ИначеЕсли Режим = Перечисления.mcp1c_РежимыДоступаКОбъектам.ТолькоАгрегаты Тогда
		Возврат "aggregates";
	КонецЕсли;
	Возврат "deny";

КонецФункции

Функция КодДействия(Действие)
	// Действие правила поля; строка без действия запрещает поле.

	Если Действие = Перечисления.mcp1c_ДействияСПолями.Разрешить Тогда
		Возврат "allow";
	ИначеЕсли Действие = Перечисления.mcp1c_ДействияСПолями.Маскировать Тогда
		Возврат "mask";
	КонецЕсли;
	Возврат "deny";

КонецФункции

Функция КодВидаМаски(ВидМаски)
	// Вид маски для mcp1c_Маскирование; не задан - полная маска.

	Если ВидМаски = Перечисления.mcp1c_ВидыМасок.Частичная Тогда
		Возврат "partial";
	ИначеЕсли ВидМаски = Перечисления.mcp1c_ВидыМасок.Хеш Тогда
		Возврат "hash";
	ИначеЕсли ВидМаски = Перечисления.mcp1c_ВидыМасок.Округление Тогда
		Возврат "round";
	КонецЕсли;
	Возврат "full";

КонецФункции

Процедура ЗаполнитьСольМаскирования(Политика, Профиль)
	// Соль хеш-маски (п. 7.4 ТЗ) выводится из секрета сервера и идентификатора профиля: клиенту
	// она неизвестна, одинаковые значения в профиле дают одинаковый хеш, в разных профилях - разный.
	// Секрет читается (и при первом обращении создается) только для профилей с хеш-маской.

	Для Каждого Правило Из Политика.Поля Цикл
		Если Правило.Действие = "mask" И Правило.ВидМаски = "hash" Тогда
			Политика.СольМаскирования = mcp1c_Служебный.ХешSHA256(mcp1c_Настройки.СекретМаскирования() + "|"
				+ Строка(Профиль.УникальныйИдентификатор()));
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция НовоеОграничение(Выборка)
	// Ограничение строк из строки профиля. Значение - JSON в формате значений аргументов
	// ({"type": "Справочник.Организации", "ref": "<uuid>"} или массив таких значений) либо параметр
	// профиля, значения которого подставляются из клиента (см. mcp1c_ПравилаДоступа.ПодставитьПараметры).

	Оператор = "invalid";
	Если Выборка.ВидСравнения = Перечисления.mcp1c_ВидыСравнения.Равно Тогда
		Оператор = "eq";
	ИначеЕсли Выборка.ВидСравнения = Перечисления.mcp1c_ВидыСравнения.НеРавно Тогда
		Оператор = "ne";
	ИначеЕсли Выборка.ВидСравнения = Перечисления.mcp1c_ВидыСравнения.ВИерархии Тогда
		Оператор = "in_hierarchy";
	КонецЕсли;

	Значение = Неопределено;
	Ошибка = "";
	Параметр = СокрЛП(Выборка.Параметр);
	Если ПустаяСтрока(Выборка.Поле) Тогда
		Ошибка = "Не задано поле ограничения";
	ИначеЕсли ПустаяСтрока(Параметр) И ПустаяСтрока(Выборка.Значение) Тогда
		Ошибка = СтрШаблон("Не задано значение ограничения по полю %1", Выборка.Поле);
	ИначеЕсли ПустаяСтрока(Параметр) Тогда
		Попытка
			Значение = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Выборка.Значение);
		Исключение
			Ошибка = СтрШаблон("Значение ограничения по полю %1 - некорректный JSON", Выборка.Поле);
		КонецПопытки;
	КонецЕсли;
	Ограничение = mcp1c_ПравилаДоступа.НовоеОграничениеСтрок(Выборка.Объект, Выборка.Поле,
		?(ПустаяСтрока(Ошибка), Оператор, "invalid"), Значение, Выборка.Комментарий, Параметр);
	Ограничение.Ошибка = Ошибка;
	Возврат Ограничение;

КонецФункции

Процедура ОграничитьПравамиПользователя(Политика, ИмяПользователя)
	// Права привязанного пользователя ИБ - верхняя граница доступа клиента (модель B, п. 7.1-7.2 ТЗ):
	// объекты, которые пользователь не может читать, недоступны и клиенту.

	// Поиск пользователя и проверка чужих прав требуют административных прав.
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
		Если Пользователь <> Неопределено Тогда
			Для Каждого ОбъектМД Из mcp1c_Метаданные.ВсеОбъекты() Цикл
				ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД);
				Если mcp1c_ПравилаДоступа.ОбъектДоступен(Политика, ПолноеИмя) И Не ЕстьПравоЧтения(ОбъектМД, Пользователь) Тогда
					Политика.НедоступныеОбъекты.Вставить(НРег(ПолноеИмя), Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on

	Если Пользователь = Неопределено Тогда
		Политика.Объекты.Очистить();
		mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон(
			"Пользователь ИБ ""%1"" клиента ""%2"" не найден: доступ к данным закрыт", ИмяПользователя,
			Политика.ИмяКлиента));
	КонецЕсли;

КонецПроцедуры

Функция ЕстьПравоЧтения(ОбъектМД, Пользователь)

	Попытка
		Возврат ПравоДоступа("Чтение", ОбъектМД, Пользователь);
	Исключение
		// Право "Чтение" не применяется к виду (перечисления): ограничивать нечего.
		Возврат Истина;
	КонецПопытки;

КонецФункции

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// mcp1c_КонструкторЗапросов: текст запроса из проверенной спецификации (п. 3.2, 7.7 ТЗ).
//
// Спецификацию собирают инструменты из путей, разобранных mcp1c_ПутиПолей: в текст
// попадают только канонические имена метаданных, фиксированные ключевые слова и имена
// параметров. Значения из аргументов передаются только параметрами запроса.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область Спецификация

// Новая спецификация запроса к одной таблице.
//
// Параметры:
//  Таблица - Строка - имя таблицы ("Справочник.Контрагенты", "РегистрНакопления.Х.Остатки").
//
// Возвращаемое значение:
//  Структура:
//   * Таблица - Строка - имя таблицы.
//   * ПараметрыТаблицы - Массив из Строка - параметры виртуальной таблицы; элемент "{Условие}"
//                         заменяется условием на поля таблицы, пустые хвостовые параметры отбрасываются.
//   * Поля - Массив из см. НовоеПолеВыборки - выбираемые поля.
//   * Условия - Массив из см. НовоеУсловие - условия, объединяемые через И.
//   * Группировки - Массив из см. НовоеВыражение - выражения группировки.
//   * Имеющие - Массив из см. НовоеУсловие - условия на группы (ИМЕЮЩИЕ), объединяемые через И;
//               выражение - агрегат, например КОЛИЧЕСТВО(*).
//   * Порядок - Массив из см. НовыйЭлементПорядка - упорядочивание.
//   * Первые - Число - ограничение числа строк; 0 - без ограничения.
//
Функция НоваяСпецификация(Таблица) Экспорт

	Спецификация = Новый Структура;
	Спецификация.Вставить("Таблица", Таблица);
	Спецификация.Вставить("ПараметрыТаблицы", Новый Массив);
	Спецификация.Вставить("Поля", Новый Массив);
	Спецификация.Вставить("Условия", Новый Массив);
	Спецификация.Вставить("Группировки", Новый Массив);
	Спецификация.Вставить("Имеющие", Новый Массив);
	Спецификация.Вставить("Порядок", Новый Массив);
	Спецификация.Вставить("Первые", 0);
	Возврат Спецификация;

КонецФункции

// Выражение для группировки или упорядочивания.
//
// Параметры:
//  Выражение - Строка - выражение из разбора пути ("Т.Контрагент") или псевдоним поля выборки.
//  НеограниченнаяСтрока - Булево - строка неограниченной длины: приводится к СТРОКА(1024).
//
// Возвращаемое значение:
//  Структура:
//   * Выражение - Строка - выражение.
//   * НеограниченнаяСтрока - Булево - нужно приведение типа.
//
Функция НовоеВыражение(Выражение, НеограниченнаяСтрока = Ложь) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Выражение", Выражение);
	Результат.Вставить("НеограниченнаяСтрока", НеограниченнаяСтрока);
	Возврат Результат;

КонецФункции

// Поле выборки.
//
// Параметры:
//  Выражение - Строка - выражение из разбора пути; "*" - для КОЛИЧЕСТВО(*).
//  Псевдоним - Строка - псевдоним колонки.
//  Агрегат - Строка - "", СУММА, КОЛИЧЕСТВО, КОЛИЧЕСТВО РАЗЛИЧНЫЕ, СРЕДНЕЕ, МИНИМУМ, МАКСИМУМ.
//  Представление - Строка - "", "ссылки" (ПРЕДСТАВЛЕНИЕССЫЛКИ) или "общее" (ПРЕДСТАВЛЕНИЕ);
//                  колонка представления получает псевдоним <Псевдоним>_П.
//  НеограниченнаяСтрока - Булево - строка неограниченной длины.
//
// Возвращаемое значение:
//  Структура:
//   * Выражение - Строка - выражение.
//   * Псевдоним - Строка - псевдоним.
//   * Агрегат - Строка - агрегатная функция.
//   * Представление - Строка - вид колонки представления.
//   * НеограниченнаяСтрока - Булево - строка неограниченной длины.
//
Функция НовоеПолеВыборки(Выражение, Псевдоним, Агрегат = "", Представление = "", НеограниченнаяСтрока = Ложь) Экспорт

	Поле = Новый Структура;
	Поле.Вставить("Выражение", Выражение);
	Поле.Вставить("Псевдоним", Псевдоним);
	Поле.Вставить("Агрегат", Агрегат);
	Поле.Вставить("Представление", Представление);
	Поле.Вставить("НеограниченнаяСтрока", НеограниченнаяСтрока);
	Возврат Поле;

КонецФункции

// Условие отбора.
//
// Параметры:
//  Выражение - Строка - выражение из разбора пути ("Т.Контрагент").
//  Оператор - Строка - eq, ne, gt, gte, lt, lte, between, in, not_in, in_hierarchy, contains,
//             starts_with, is_empty, not_empty или or (группа условий в Элементы через ИЛИ).
//  Параметры - Массив из Строка - имена параметров без &: два для between, по одному для остальных.
//  ВУсловииТаблицы - Булево - условие передается в параметр виртуальной таблицы.
//  НеограниченнаяСтрока - Булево - строка неограниченной длины: приводится к СТРОКА(1024).
//
// Возвращаемое значение:
//  Структура:
//   * Выражение - Строка - выражение.
//   * Оператор - Строка - оператор.
//   * Параметры - Массив из Строка - имена параметров.
//   * ВУсловииТаблицы - Булево - условие виртуальной таблицы.
//   * НеограниченнаяСтрока - Булево - нужно приведение типа.
//   * Элементы - Массив из Структура - условия группы для оператора or.
//
Функция НовоеУсловие(Выражение, Оператор, Параметры = Неопределено, ВУсловииТаблицы = Ложь,
	НеограниченнаяСтрока = Ложь) Экспорт

	ИменаПараметров = Новый Массив;
	Если Параметры <> Неопределено Тогда
		Для Каждого Имя Из Параметры Цикл
			ИменаПараметров.Добавить(Имя);
		КонецЦикла;
	КонецЕсли;

	Условие = Новый Структура;
	Условие.Вставить("Выражение", Выражение);
	Условие.Вставить("Оператор", Оператор);
	Условие.Вставить("Параметры", ИменаПараметров);
	Условие.Вставить("ВУсловииТаблицы", ВУсловииТаблицы);
	Условие.Вставить("НеограниченнаяСтрока", НеограниченнаяСтрока);
	Условие.Вставить("Элементы", Новый Массив);
	Возврат Условие;

КонецФункции

// Элемент упорядочивания.
//
// Параметры:
//  Выражение - Строка - выражение из разбора пути или псевдоним поля выборки.
//  Убывание - Булево - по убыванию.
//  ПоПредставлению - Булево - упорядочивать ссылки по представлению.
//  НеограниченнаяСтрока - Булево - строка неограниченной длины.
//
// Возвращаемое значение:
//  Структура:
//   * Выражение - Строка - выражение.
//   * Убывание - Булево - по убыванию.
//   * ПоПредставлению - Булево - по представлению.
//   * НеограниченнаяСтрока - Булево - нужно приведение типа.
//
Функция НовыйЭлементПорядка(Выражение, Убывание = Ложь, ПоПредставлению = Ложь, НеограниченнаяСтрока = Ложь) Экспорт

	Элемент = Новый Структура;
	Элемент.Вставить("Выражение", Выражение);
	Элемент.Вставить("Убывание", Убывание);
	Элемент.Вставить("ПоПредставлению", ПоПредставлению);
	Элемент.Вставить("НеограниченнаяСтрока", НеограниченнаяСтрока);
	Возврат Элемент;

КонецФункции

#КонецОбласти

#Область Текст

// Текст запроса по спецификации.
//
// Параметры:
//  Спецификация - см. НоваяСпецификация
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапроса(Спецификация) Экспорт

	ПереводСтроки = Символы.ПС;
	Таб = Символы.Таб;
	Группировка = ЕстьГруппировка(Спецификация);

	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ" + ?(Спецификация.Первые > 0,
		" ПЕРВЫЕ " + Формат(Спецификация.Первые, "ЧН=0; ЧГ=0"), ""));
	Строки.Добавить(Таб + СтрСоединить(ТекстыПолей(Спецификация, Группировка), "," + ПереводСтроки + Таб));
	Строки.Добавить("ИЗ");
	Строки.Добавить(Таб + ТекстИсточника(Спецификация) + " КАК " + mcp1c_ПутиПолей.ПсевдонимТаблицы());

	УсловияЗапроса = Новый Массив;
	Для Каждого Условие Из Спецификация.Условия Цикл
		Если Не Условие.ВУсловииТаблицы Тогда
			УсловияЗапроса.Добавить(ТекстУсловия(Условие, Ложь));
		КонецЕсли;
	КонецЦикла;
	Если УсловияЗапроса.Количество() > 0 Тогда
		Строки.Добавить("ГДЕ");
		Строки.Добавить(Таб + СтрСоединить(УсловияЗапроса, ПереводСтроки + Таб + "И "));
	КонецЕсли;

	Если Спецификация.Группировки.Количество() > 0 Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Спецификация.Группировки Цикл
			Части.Добавить(ТекстВыражения(Элемент.Выражение, Элемент.НеограниченнаяСтрока));
		КонецЦикла;
		Строки.Добавить("СГРУППИРОВАТЬ ПО");
		Строки.Добавить(Таб + СтрСоединить(Части, "," + ПереводСтроки + Таб));
	КонецЕсли;

	Если Спецификация.Имеющие.Количество() > 0 Тогда
		Части = Новый Массив;
		Для Каждого Условие Из Спецификация.Имеющие Цикл
			Части.Добавить(ТекстУсловия(Условие, Ложь));
		КонецЦикла;
		Строки.Добавить("ИМЕЮЩИЕ");
		Строки.Добавить(Таб + СтрСоединить(Части, ПереводСтроки + Таб + "И "));
	КонецЕсли;

	Если Спецификация.Порядок.Количество() > 0 Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Спецификация.Порядок Цикл
			Части.Добавить(ТекстПорядка(Элемент));
		КонецЦикла;
		Строки.Добавить("УПОРЯДОЧИТЬ ПО");
		Строки.Добавить(Таб + СтрСоединить(Части, "," + ПереводСтроки + Таб));
	КонецЕсли;

	Возврат СтрСоединить(Строки, ПереводСтроки);

КонецФункции

// Экранирует служебные символы шаблона ПОДОБНО символом "~" (см. СПЕЦСИМВОЛ в ТекстЗапроса).
//
// Параметры:
//  Текст - Строка - текст из аргументов.
//
// Возвращаемое значение:
//  Строка - текст, безопасный для шаблона ПОДОБНО.
//
Функция ЭкранироватьДляПодобно(Знач Текст) Экспорт

	Текст = СтрЗаменить(Текст, "~", "~~");
	Текст = СтрЗаменить(Текст, "%", "~%");
	Текст = СтрЗаменить(Текст, "_", "~_");
	Текст = СтрЗаменить(Текст, "[", "~[");
	Возврат Текст;

КонецФункции

// Псевдоним колонки представления для поля выборки.
//
// Параметры:
//  Псевдоним - Строка - псевдоним поля.
//
// Возвращаемое значение:
//  Строка - псевдоним колонки представления.
//
Функция ПсевдонимПредставления(Псевдоним) Экспорт

	Возврат Псевдоним + "_П";

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьГруппировка(Спецификация)

	Если Спецификация.Группировки.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Поле Из Спецификация.Поля Цикл
		Если Не ПустаяСтрока(Поле.Агрегат) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ТекстыПолей(Спецификация, Группировка)

	Результат = Новый Массив;
	Для Каждого Поле Из Спецификация.Поля Цикл
		Результат.Добавить(ТекстПоля(Поле, Группировка) + " КАК " + Поле.Псевдоним);
		Если ПустаяСтрока(Поле.Представление) Или Не ПустаяСтрока(Поле.Агрегат) Тогда
			Продолжить;
		КонецЕсли;
		ИмяФункции = ?(Поле.Представление = "ссылки", "ПРЕДСТАВЛЕНИЕССЫЛКИ", "ПРЕДСТАВЛЕНИЕ");
		Результат.Добавить(ИмяФункции + "(" + Поле.Выражение + ") КАК " + ПсевдонимПредставления(Поле.Псевдоним));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТекстПоля(Поле, Группировка)

	Если ПустаяСтрока(Поле.Агрегат) Тогда
		// В группировке строка неограниченной длины участвует только после приведения типа.
		Возврат ТекстВыражения(Поле.Выражение, Поле.НеограниченнаяСтрока И Группировка);
	КонецЕсли;
	Если Поле.Выражение = "*" Тогда
		Возврат "КОЛИЧЕСТВО(*)";
	КонецЕсли;
	Если Поле.Агрегат = "КОЛИЧЕСТВО РАЗЛИЧНЫЕ" Тогда
		Возврат "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ " + ТекстВыражения(Поле.Выражение, Поле.НеограниченнаяСтрока) + ")";
	КонецЕсли;
	Возврат Поле.Агрегат + "(" + ТекстВыражения(Поле.Выражение, Поле.НеограниченнаяСтрока) + ")";

КонецФункции

Функция ТекстИсточника(Спецификация)

	Если Спецификация.ПараметрыТаблицы.Количество() = 0 Тогда
		Возврат Спецификация.Таблица;
	КонецЕсли;

	УсловияТаблицы = Новый Массив;
	Для Каждого Условие Из Спецификация.Условия Цикл
		Если Условие.ВУсловииТаблицы Тогда
			УсловияТаблицы.Добавить(ТекстУсловия(Условие, Истина));
		КонецЕсли;
	КонецЦикла;

	Параметры = Новый Массив;
	Для Каждого Параметр Из Спецификация.ПараметрыТаблицы Цикл
		Если Параметр = "{Условие}" Тогда
			Параметры.Добавить(СтрСоединить(УсловияТаблицы, " И "));
		Иначе
			Параметры.Добавить(Параметр);
		КонецЕсли;
	КонецЦикла;
	Пока Параметры.Количество() > 0 И ПустаяСтрока(Параметры[Параметры.ВГраница()]) Цикл
		Параметры.Удалить(Параметры.ВГраница());
	КонецЦикла;
	Если Параметры.Количество() = 0 Тогда
		Возврат Спецификация.Таблица;
	КонецЕсли;
	Возврат Спецификация.Таблица + "(" + СтрСоединить(Параметры, ", ") + ")";

КонецФункции

Функция ТекстУсловия(Условие, ВУсловииТаблицы)

	Если Условие.Оператор = "or" Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Условие.Элементы Цикл
			Части.Добавить(ТекстУсловия(Элемент, ВУсловииТаблицы));
		КонецЦикла;
		Возврат "(" + СтрСоединить(Части, " ИЛИ ") + ")";
	КонецЕсли;

	Выражение = Условие.Выражение;
	Если ВУсловииТаблицы Тогда
		// В параметрах виртуальной таблицы поля указываются без псевдонима таблицы.
		Выражение = БезПсевдонима(Выражение);
	КонецЕсли;
	Выражение = ТекстВыражения(Выражение, Условие.НеограниченнаяСтрока);
	ПараметрыУсловия = Новый Массив;
	Для Каждого Имя Из Условие.Параметры Цикл
		ПараметрыУсловия.Добавить("&" + Имя);
	КонецЦикла;

	Сравнения = ОператорыСравнения();
	Если Сравнения.Получить(Условие.Оператор) <> Неопределено Тогда
		Возврат Выражение + " " + Сравнения.Получить(Условие.Оператор) + " " + ПараметрыУсловия[0];
	КонецЕсли;
	Возврат ТекстОсобогоУсловия(Условие.Оператор, Выражение, ПараметрыУсловия);

КонецФункции

Функция ТекстОсобогоУсловия(Оператор, Выражение, ПараметрыУсловия)

	Если Оператор = "between" Тогда
		Возврат Выражение + " МЕЖДУ " + ПараметрыУсловия[0] + " И " + ПараметрыУсловия[1];
	ИначеЕсли Оператор = "in" Тогда
		Возврат Выражение + " В (" + ПараметрыУсловия[0] + ")";
	ИначеЕсли Оператор = "not_in" Тогда
		Возврат "НЕ " + Выражение + " В (" + ПараметрыУсловия[0] + ")";
	ИначеЕсли Оператор = "in_hierarchy" Тогда
		Возврат Выражение + " В ИЕРАРХИИ (" + ПараметрыУсловия[0] + ")";
	ИначеЕсли Оператор = "contains" Или Оператор = "starts_with" Тогда
		Возврат Выражение + " ПОДОБНО " + ПараметрыУсловия[0] + " СПЕЦСИМВОЛ ""~""";
	ИначеЕсли Оператор = "is_empty" Тогда
		Возврат "(" + Выражение + " ЕСТЬ NULL ИЛИ " + Выражение + " = " + ПараметрыУсловия[0] + ")";
	ИначеЕсли Оператор = "not_empty" Тогда
		Возврат "(НЕ " + Выражение + " ЕСТЬ NULL И " + Выражение + " <> " + ПараметрыУсловия[0] + ")";
	КонецЕсли;
	ВызватьИсключение СтрШаблон("Невідомий оператор умови: %1", Оператор);

КонецФункции

Функция ОператорыСравнения()

	Результат = Новый Соответствие;
	Результат.Вставить("eq", "=");
	Результат.Вставить("ne", "<>");
	Результат.Вставить("gt", ">");
	Результат.Вставить("gte", ">=");
	Результат.Вставить("lt", "<");
	Результат.Вставить("lte", "<=");
	Возврат Результат;

КонецФункции

Функция ТекстПорядка(Элемент)

	Если Элемент.ПоПредставлению Тогда
		Текст = "ПРЕДСТАВЛЕНИЕССЫЛКИ(" + Элемент.Выражение + ")";
	Иначе
		Текст = ТекстВыражения(Элемент.Выражение, Элемент.НеограниченнаяСтрока);
	КонецЕсли;
	Возврат Текст + ?(Элемент.Убывание, " УБЫВ", "");

КонецФункции

Функция ТекстВыражения(Выражение, НеограниченнаяСтрока)

	Если НеограниченнаяСтрока Тогда
		Возврат "ВЫРАЗИТЬ(" + Выражение + " КАК СТРОКА(1024))";
	КонецЕсли;
	Возврат Выражение;

КонецФункции

Функция БезПсевдонима(Выражение)

	Префикс = mcp1c_ПутиПолей.ПсевдонимТаблицы() + ".";
	Если Лев(Выражение, СтрДлина(Префикс)) = Префикс Тогда
		Возврат Сред(Выражение, СтрДлина(Префикс) + 1);
	КонецЕсли;
	Возврат Выражение;

КонецФункции

#КонецОбласти

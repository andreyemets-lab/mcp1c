///////////////////////////////////////////////////////////////////////////////
// mcp1c_ИнструментыДанных: инструменты чтения данных find_objects, get_object, query_records,
// get_balances, get_turnovers, get_slice (п. 5.2-5.4 ТЗ).
//
// Порядок выполнения: таблица и ее доступность по политике -> лимит строк и курсор ->
// построение запроса (mcp1c_ЗапросыДанных, с подгрузкой описаний для разыменования) ->
// значения параметров (mcp1c_Значения) -> выполнение (mcp1c_ВыполнениеЗапросов) ->
// значения результата в JSON -> курсор следующей страницы.
// Каждая функция возвращает итог - структуру с полями Данные (structuredContent)
// и Ошибка (текст для модели, isError).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// find_objects: поиск объектов по строке в нескольких таблицах.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция НайтиОбъекты(Аргументы, Контекст) Экспорт

	Политика = Контекст.Политика;
	ТекстПоиска = СокрЛП(mcp1c_Служебный.СвойствоСтрока(Аргументы, "query"));
	Лимит = ЛимитСтрок(Аргументы, Контекст, 20);
	Если Лимит = 0 Тогда
		Возврат ИтогКвотаИсчерпана();
	КонецЕсли;
	КонтекстПреобразования = НовыйКонтекстПреобразования(Контекст);

	Элементы = Новый Массив;
	Просмотренные = Новый Массив;
	ЕстьЕще = Ложь;
	Примечания = Новый Массив;
	Для Каждого ИмяОбъекта Из mcp1c_Служебный.СвойствоМассив(Аргументы, "objects") Цикл
		Таблица = ТаблицаДляЧтения(ИмяОбъекта, Контекст, "object");
		Если ТипЗнч(Таблица) = Тип("Строка") Тогда
			Возврат ИтогОшибка(Таблица);
		КонецЕсли;
		Если Элементы.Количество() >= Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Дополнительно = Новый Структура("ТекстПоиска", ТекстПоиска);
		Построение = ПостроитьЗапрос("find", Аргументы, Таблица, Политика, Лимит - Элементы.Количество(), 0, Дополнительно);
		Если Не ПустаяСтрока(Построение.Ошибка) Тогда
			Возврат ИтогОшибкаПостроения(Построение, Контекст);
		КонецЕсли;
		Выполнение = ВыполнитьПостроение(Построение, КонтекстПреобразования, Контекст);
		Если Не ПустаяСтрока(Выполнение.Ошибка) Тогда
			Возврат ИтогОшибка(Выполнение.Ошибка);
		КонецЕсли;
		Для Каждого Строка_ Из Выполнение.Строки Цикл
			Элементы.Добавить(ЭлементПоиска(Таблица.Объект, Построение.Колонки, Строка_));
		КонецЦикла;
		ЕстьЕще = ЕстьЕще Или Выполнение.ЕстьЕще;
		Просмотренные.Добавить(Таблица.Объект);
		ДобавитьПримечания(Примечания, Построение.Примечания);
	КонецЦикла;

	Данные = Новый Соответствие;
	Данные.Вставить("query", ТекстПоиска);
	Данные.Вставить("items", Элементы);
	Данные.Вставить("returned", Элементы.Количество());
	Данные.Вставить("has_more", ЕстьЕще);
	Данные.Вставить("searched", Просмотренные);
	Если ЕстьЕще Тогда
		Примечания.Добавить("Знайдено більше: уточніть рядок пошуку або збільште limit");
	КонецЕсли;
	Если Элементы.Количество() = 0 Тогда
		Примечания.Добавить("Нічого не знайдено: спробуйте коротший рядок або query_records з фільтрами");
	КонецЕсли;
	ДобавитьПримечанияВДанные(Данные, Примечания);
	Возврат ИтогУспех(Данные);

КонецФункции

// get_object: реквизиты объекта и строки табличных частей.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ПолучитьОбъект(Аргументы, Контекст) Экспорт

	Политика = Контекст.Политика;
	Таблица = ТаблицаДляЧтения(mcp1c_Служебный.СвойствоСтрока(Аргументы, "object"), Контекст, "object");
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Идентификатор = mcp1c_Служебный.СвойствоСтрока(Аргументы, "ref");
	КонтекстПреобразования = НовыйКонтекстПреобразования(Контекст);

	Дополнительно = Новый Структура("Идентификатор", Идентификатор);
	Построение = ПостроитьЗапрос("card", Аргументы, Таблица, Политика, 1, 0, Дополнительно);
	Если Не ПустаяСтрока(Построение.Ошибка) Тогда
		Возврат ИтогОшибкаПостроения(Построение, Контекст);
	КонецЕсли;
	Выполнение = ВыполнитьПостроение(Построение, КонтекстПреобразования, Контекст);
	Если Не ПустаяСтрока(Выполнение.Ошибка) Тогда
		Возврат ИтогОшибка(Выполнение.Ошибка);
	КонецЕсли;
	Если Выполнение.Строки.Количество() = 0 Тогда
		Возврат ИтогОшибка(СтрШаблон("Об'єкт не знайдено або недоступний: %1 %2", Таблица.Объект, Лев(Идентификатор, 36)));
	КонецЕсли;

	Поля = Новый Соответствие;
	Ссылка = Неопределено;
	Строка_ = Выполнение.Строки[0];
	Для Индекс = 0 По Построение.Колонки.ВГраница() Цикл
		Если Построение.Колонки[Индекс].Имя = "Ссылка" Тогда
			Ссылка = Строка_[Индекс];
		Иначе
			Поля.Вставить(Построение.Колонки[Индекс].Имя, Строка_[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Данные = Новый Соответствие;
	Данные.Вставить("object", Таблица.Объект);
	Данные.Вставить("ref", Ссылка);
	Данные.Вставить("fields", Поля);
	Примечания = Новый Массив;
	ЛимитСтрокЧастей = Мин(mcp1c_Служебный.СвойствоЧисло(Аргументы, "tabular_limit", 20), Политика.Лимиты.СтрокЗаВызов);
	Если ЛимитСтрокЧастей > 0 Тогда
		Части = СтрокиТабличныхЧастей(Таблица, Аргументы, Идентификатор, ЛимитСтрокЧастей, КонтекстПреобразования,
			Контекст, Примечания);
		Если ТипЗнч(Части) = Тип("Строка") Тогда
			Возврат ИтогОшибка(Части);
		КонецЕсли;
		Если Части.Количество() > 0 Тогда
			Данные.Вставить("tabular_sections", Части);
		КонецЕсли;
	КонецЕсли;
	ДобавитьПримечанияВДанные(Данные, Примечания);
	Возврат ИтогУспех(Данные);

КонецФункции

// query_records: выборка из одной таблицы.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ВыбратьЗаписи(Аргументы, Контекст) Экспорт

	Таблица = ТаблицаДляЧтения(mcp1c_Служебный.СвойствоСтрока(Аргументы, "object"), Контекст, "object,tabular_section,register");
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить("object", Таблица.Имя);
	Возврат ВыполнитьСтраничныйЗапрос("records", "query_records", Аргументы, Таблица, Данные, Контекст);

КонецФункции

// get_balances: остатки регистра накопления или бухгалтерии.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ПолучитьОстатки(Аргументы, Контекст) Экспорт

	Регистр = mcp1c_Служебный.СвойствоСтрока(Аргументы, "register");
	Таблица = ТаблицаРегистра(Регистр, "Остатки", Контекст,
		"Залишки є лише в регістрів накопичення виду «залишки» і регістрів бухгалтерії");
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить("register", Таблица.Объект);
	Если Аргументы.Получить("date") <> Неопределено Тогда
		Данные.Вставить("date", Аргументы.Получить("date"));
	КонецЕсли;
	Возврат ВыполнитьСтраничныйЗапрос("balances", "get_balances", Аргументы, Таблица, Данные, Контекст);

КонецФункции

// get_turnovers: обороты регистра накопления или бухгалтерии за период.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ПолучитьОбороты(Аргументы, Контекст) Экспорт

	Регистр = mcp1c_Служебный.СвойствоСтрока(Аргументы, "register");
	СОстатками = mcp1c_Служебный.СвойствоБулево(Аргументы, "with_balances", Ложь);
	Таблица = ТаблицаРегистра(Регистр, ?(СОстатками, "ОстаткиИОбороты", "Обороты"), Контекст,
		?(СОстатками, "Залишки й обороти є лише в регістрів накопичення виду «залишки» і регістрів бухгалтерії",
		"Обороти є лише в регістрів накопичення і бухгалтерії"));
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить("register", Таблица.Объект);
	Данные.Вставить("period", Аргументы.Получить("period"));
	Данные.Вставить("periodicity", mcp1c_Служебный.СвойствоСтрока(Аргументы, "periodicity", "none"));
	Возврат ВыполнитьСтраничныйЗапрос("turnovers", "get_turnovers", Аргументы, Таблица, Данные, Контекст);

КонецФункции

// get_slice: срез последних или первых записей периодического регистра сведений.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ПолучитьСрез(Аргументы, Контекст) Экспорт

	Режим = mcp1c_Служебный.СвойствоСтрока(Аргументы, "mode", "last");
	Таблица = ТаблицаРегистра(mcp1c_Служебный.СвойствоСтрока(Аргументы, "register"),
		?(Режим = "first", "СрезПервых", "СрезПоследних"), Контекст,
		"Зріз є лише в періодичних регістрів відомостей; для інших використовуйте query_records");
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить("register", Таблица.Объект);
	Данные.Вставить("mode", Режим);
	Если Аргументы.Получить("date") <> Неопределено Тогда
		Данные.Вставить("date", Аргументы.Получить("date"));
	КонецЕсли;
	Возврат ВыполнитьСтраничныйЗапрос("slice", "get_slice", Аргументы, Таблица, Данные, Контекст);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Таблицы

Функция ТаблицаДляЧтения(ИмяТаблицы, Контекст, ДопустимыеВиды)
	// Описание таблицы, доступной клиенту, или текст ошибки. Скрытый объект не отличается
	// от отсутствующего (п. 4.4 ТЗ); причина отказа пишется в журнал.

	ТекстОшибки = СтрШаблон("Об'єкт не знайдено або недоступний: %1. Перевірте ім'я через list_objects.",
		Лев(ИмяТаблицы, 300));
	Таблица = mcp1c_Метаданные.ОписаниеТаблицы(ИмяТаблицы);
	Если Таблица = Неопределено Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Политика = Контекст.Политика;
	Доступен = mcp1c_ПравилаДоступа.ОбъектДоступен(Политика, Таблица.Объект);
	Если Доступен И Таблица.ВидТаблицы = "tabular_section" Тогда
		Доступен = mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(Политика, Таблица.Объект,
			Лев(Таблица.ПрефиксПолейПолитики, СтрДлина(Таблица.ПрефиксПолейПолитики) - 1));
	КонецЕсли;
	Если Не Доступен Тогда
		Контекст.ОтказДоступа = Истина;
		Контекст.Причина = "Объект запрещен политикой: " + Таблица.Имя;
		Возврат ТекстОшибки;
	КонецЕсли;
	Если СтрРазделить(ДопустимыеВиды, ",").Найти(Таблица.ВидТаблицы) = Неопределено Тогда
		Возврат СтрШаблон("Таблиця %1 не читається цим інструментом: для регістрів використовуйте get_balances, "
			+ "get_turnovers або get_slice; для об'єктів - query_records або get_object", Таблица.Имя);
	КонецЕсли;
	ДобавитьОбъектВКонтекст(Контекст, Таблица.Имя);
	Возврат Таблица;

КонецФункции

Функция ТаблицаРегистра(ИмяРегистра, ВиртуальнаяТаблица, Контекст, Пояснение)

	ТекстОшибки = СтрШаблон("Об'єкт не знайдено або недоступний: %1. Перевірте ім'я через list_objects.",
		Лев(ИмяРегистра, 300));
	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(ИмяРегистра);
	Если ОбъектМД = Неопределено Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД);
	Если Не mcp1c_ПравилаДоступа.ОбъектДоступен(Контекст.Политика, ПолноеИмя) Тогда
		Контекст.ОтказДоступа = Истина;
		Контекст.Причина = "Объект запрещен политикой: " + ПолноеИмя;
		Возврат ТекстОшибки;
	КонецЕсли;
	Таблица = mcp1c_Метаданные.ОписаниеТаблицы(ПолноеИмя + "." + ВиртуальнаяТаблица);
	Если Таблица = Неопределено Тогда
		Возврат СтрШаблон("%1: %2", ПолноеИмя, Пояснение);
	КонецЕсли;
	ДобавитьОбъектВКонтекст(Контекст, ПолноеИмя);
	Возврат Таблица;

КонецФункции

Процедура ДобавитьОбъектВКонтекст(Контекст, Имя)

	Если Контекст.Объекты.Найти(Имя) = Неопределено Тогда
		Контекст.Объекты.Добавить(Имя);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Выполнение

Функция ВыполнитьСтраничныйЗапрос(ВидПостроения, Инструмент, Аргументы, Таблица, Данные, Контекст)
	// Запрос со страницами: лимит, курсор, построение, выполнение и курсор следующей страницы.

	Лимит = ЛимитСтрок(Аргументы, Контекст, 50);
	Если Лимит = 0 Тогда
		Возврат ИтогКвотаИсчерпана();
	КонецЕсли;
	Страницы = ПрочитатьКурсор(Аргументы, Инструмент, Контекст);
	Если Не ПустаяСтрока(Страницы.Ошибка) Тогда
		Возврат ИтогОшибка(Страницы.Ошибка);
	КонецЕсли;

	Построение = ПостроитьЗапрос(ВидПостроения, Аргументы, Таблица, Контекст.Политика, Лимит, Страницы.Смещение, Неопределено);
	Если Не ПустаяСтрока(Построение.Ошибка) Тогда
		Возврат ИтогОшибкаПостроения(Построение, Контекст);
	КонецЕсли;
	Выполнение = ВыполнитьПостроение(Построение, НовыйКонтекстПреобразования(Контекст), Контекст);
	Если Не ПустаяСтрока(Выполнение.Ошибка) Тогда
		Возврат ИтогОшибка(Выполнение.Ошибка);
	КонецЕсли;

	Данные.Вставить("columns", mcp1c_ЗапросыДанных.ОписаниеКолонок(Построение));
	Данные.Вставить("rows", Выполнение.Строки);
	Данные.Вставить("row_count", Выполнение.Строки.Количество());
	Данные.Вставить("has_more", Выполнение.ЕстьЕще);
	Примечания = Новый Массив;
	ДобавитьПримечания(Примечания, Построение.Примечания);
	Если Выполнение.ЕстьЕще Тогда
		Данные.Вставить("next_cursor", mcp1c_Курсор.Сформировать(Страницы.Секрет, Страницы.Привязка, Инструмент,
			Страницы.Отпечаток, Страницы.Смещение + Выполнение.Строки.Количество(), Страницы.Время));
		Примечания.Добавить("Є ще рядки: повторіть виклик з cursor = next_cursor або уточніть фільтри");
	КонецЕсли;
	Если Лимит < mcp1c_Служебный.СвойствоЧисло(Аргументы, "limit", 50) Тогда
		Примечания.Добавить(СтрШаблон("Кількість рядків обмежено до %1 профілем або добовою квотою", Лимит));
	КонецЕсли;
	ДобавитьПримечанияВДанные(Данные, Примечания);
	Возврат ИтогУспех(Данные);

КонецФункции

Функция ПостроитьЗапрос(ВидПостроения, Аргументы, Таблица, Политика, Лимит, Смещение, Дополнительно)
	// Строит запрос, подгружая описания таблиц для разыменования, пока построение их запрашивает.

	Описания = Новый Соответствие;
	Попыток = 0;
	Пока Попыток < 20 Цикл
		Попыток = Попыток + 1;
		Если ВидПостроения = "records" Тогда
			Построение = mcp1c_ЗапросыДанных.ВыборкаЗаписей(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		ИначеЕсли ВидПостроения = "find" Тогда
			Построение = mcp1c_ЗапросыДанных.ПоискОбъектов(Дополнительно.ТекстПоиска, Таблица, Описания, Политика, Лимит);
		ИначеЕсли ВидПостроения = "card" Тогда
			Построение = mcp1c_ЗапросыДанных.КарточкаОбъекта(Таблица, Описания, Политика, Дополнительно.Идентификатор);
		ИначеЕсли ВидПостроения = "tabular" Тогда
			Построение = mcp1c_ЗапросыДанных.СтрокиТабличнойЧасти(Таблица, Описания, Политика, Дополнительно.Идентификатор, Лимит);
		ИначеЕсли ВидПостроения = "balances" Тогда
			Построение = mcp1c_ЗапросыДанных.Остатки(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		ИначеЕсли ВидПостроения = "turnovers" Тогда
			Построение = mcp1c_ЗапросыДанных.Обороты(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		Иначе
			Построение = mcp1c_ЗапросыДанных.Срез(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		КонецЕсли;
		Если ПустаяСтрока(Построение.НужноОписание) Тогда
			Возврат Построение;
		КонецЕсли;
		Описание = mcp1c_Метаданные.ОписаниеТаблицы(Построение.НужноОписание);
		Если Описание = Неопределено Тогда
			// Ссылка на объект вида, который не читается (план обмена и т. п.): разыменование невозможно.
			Построение.Ошибка = СтрШаблон("Розіменування через посилання на %1 не підтримується", Построение.НужноОписание);
			Построение.НужноОписание = "";
			Возврат Построение;
		КонецЕсли;
		Описания.Вставить(Построение.НужноОписание, Описание);
	КонецЦикла;
	ВызватьИсключение "Построение запроса не завершилось: слишком много описаний для разыменования";

КонецФункции

// Выполняет построенный запрос: пропускает строки предыдущих страниц, берет не больше лимита.
//
// Параметры:
//  Построение - см. mcp1c_ЗапросыДанных.ВыборкаЗаписей
//  КонтекстПреобразования - см. mcp1c_Значения.НовыйКонтекстПреобразования
//  Контекст - см. mcp1c_Протокол.НовыйКонтекст
//
// Возвращаемое значение:
//  Структура:
//   * Строки - Массив из Произвольный - строки: массивы значений JSON по колонкам.
//   * ЕстьЕще - Булево - есть строки следующей страницы.
//   * Ошибка - Строка - текст ошибки для модели.
//
Функция ВыполнитьПостроение(Построение, КонтекстПреобразования, Контекст)

	Результат = Новый Структура;
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("ЕстьЕще", Ложь);
	Результат.Вставить("Ошибка", "");
	Параметры = mcp1c_Значения.ЗначенияПараметров(Построение.Параметры);
	Если Не ПустаяСтрока(Параметры.Ошибка) Тогда
		Результат.Ошибка = Параметры.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Таблица = mcp1c_ВыполнениеЗапросов.ВыполнитьЗапрос(Построение.Спецификация, Параметры.Значения).Выгрузить();
	Последняя = Построение.Смещение + Построение.Лимит - 1;
	Если Последняя > Таблица.Количество() - 1 Тогда
		Последняя = Таблица.Количество() - 1;
	КонецЕсли;
	Для Индекс = Построение.Смещение По Последняя Цикл
		СтрокаТаблицы = Таблица[Индекс];
		Значения = Новый Массив;
		Для Каждого Колонка Из Построение.Колонки Цикл
			Представление = ?(Колонка.Представление,
				СтрокаТаблицы[mcp1c_КонструкторЗапросов.ПсевдонимПредставления(Колонка.Псевдоним)], Неопределено);
			Значения.Добавить(mcp1c_Значения.ЗначениеВJSON(СтрокаТаблицы[Колонка.Псевдоним], Представление,
				КонтекстПреобразования));
		КонецЦикла;
		Результат.Строки.Добавить(Значения);
	КонецЦикла;
	Результат.ЕстьЕще = Таблица.Количество() > Построение.Смещение + Построение.Лимит;
	Контекст.КоличествоСтрок = Контекст.КоличествоСтрок + Результат.Строки.Количество();
	Возврат Результат;

КонецФункции

Функция СтрокиТабличныхЧастей(Таблица, Аргументы, Идентификатор, Лимит, КонтекстПреобразования, Контекст, Примечания)

	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(Таблица.Объект);
	Запрошенные = mcp1c_Служебный.СвойствоМассив(Аргументы, "tabular_sections");
	Результат = Новый Соответствие;
	Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
		Если Запрошенные.Количество() > 0 И Не ЕстьИмя(Запрошенные, ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если Не mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(Контекст.Политика, Таблица.Объект, ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ТаблицаЧасти = mcp1c_Метаданные.ОписаниеТаблицы(Таблица.Объект + "." + ТабличнаяЧасть.Имя);
		Дополнительно = Новый Структура("Идентификатор", Идентификатор);
		Построение = ПостроитьЗапрос("tabular", Аргументы, ТаблицаЧасти, Контекст.Политика, Лимит, 0, Дополнительно);
		Если Не ПустаяСтрока(Построение.Ошибка) Тогда
			Примечания.Добавить(СтрШаблон("Таблична частина %1 пропущена: %2", ТабличнаяЧасть.Имя, Построение.Ошибка));
			Продолжить;
		КонецЕсли;
		Выполнение = ВыполнитьПостроение(Построение, КонтекстПреобразования, Контекст);
		Если Не ПустаяСтрока(Выполнение.Ошибка) Тогда
			Возврат Выполнение.Ошибка;
		КонецЕсли;
		Часть = Новый Соответствие;
		Часть.Вставить("columns", mcp1c_ЗапросыДанных.ОписаниеКолонок(Построение));
		Часть.Вставить("rows", Выполнение.Строки);
		Часть.Вставить("row_count", Выполнение.Строки.Количество());
		Часть.Вставить("has_more", Выполнение.ЕстьЕще);
		Если Выполнение.ЕстьЕще Тогда
			Примечания.Добавить(СтрШаблон("У табличній частині %1 є ще рядки: query_records з object %2 і фільтром "
				+ "за Ссылка", ТабличнаяЧасть.Имя, ТаблицаЧасти.Имя));
		КонецЕсли;
		Результат.Вставить(ТабличнаяЧасть.Имя, Часть);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьИмя(Имена, Имя)

	Для Каждого Элемент Из Имена Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") И НРег(СокрЛП(Элемент)) = НРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭлементПоиска(ИмяОбъекта, Колонки, Строка_)

	Элемент = Новый Соответствие;
	Элемент.Вставить("object", ИмяОбъекта);
	Поля = Новый Соответствие;
	Для Индекс = 0 По Колонки.ВГраница() Цикл
		Если Колонки[Индекс].Имя = "Ссылка" Тогда
			Элемент.Вставить("ref", Строка_[Индекс]);
		Иначе
			Поля.Вставить(Колонки[Индекс].Имя, Строка_[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Элемент.Вставить("fields", Поля);
	Возврат Элемент;

КонецФункции

#КонецОбласти

#Область ЛимитыИКурсоры

Функция ЛимитСтрок(Аргументы, Контекст, ПоУмолчанию)
	// Строк на странице: аргумент limit, не больше лимита профиля и остатка суточной квоты.
	// 0 - квота исчерпана.

	Лимит = Мин(mcp1c_Служебный.СвойствоЧисло(Аргументы, "limit", ПоУмолчанию), Контекст.Политика.Лимиты.СтрокЗаВызов);
	Если Контекст.ОстатокКвотыСтрок <> Неопределено Тогда
		Лимит = Мин(Лимит, Контекст.ОстатокКвотыСтрок);
	КонецЕсли;
	Возврат Макс(Лимит, 0);

КонецФункции

Функция ПрочитатьКурсор(Аргументы, Инструмент, Контекст)
	// Параметры страниц по курсору из аргументов: Секрет, Привязка, Отпечаток, Время, Смещение
	// и Ошибка - текст ошибки для модели (пустая строка, если курсора нет или он действителен).

	Страницы = Новый Структура;
	Страницы.Вставить("Секрет", mcp1c_Настройки.СекретКурсоров());
	Страницы.Вставить("Привязка", Строка(Контекст.Политика.Клиент.УникальныйИдентификатор()));
	Страницы.Вставить("Отпечаток", mcp1c_Курсор.ОтпечатокАргументов(Аргументы));
	Страницы.Вставить("Время", mcp1c_Курсор.СекундыОтНачалаЭпохи(ТекущаяУниверсальнаяДата()));
	Страницы.Вставить("Смещение", 0);
	Страницы.Вставить("Ошибка", "");

	Курсор = mcp1c_Служебный.СвойствоСтрока(Аргументы, "cursor");
	Если ПустаяСтрока(Курсор) Тогда
		Возврат Страницы;
	КонецЕсли;
	Проверка = mcp1c_Курсор.Проверить(Страницы.Секрет, Страницы.Привязка, Курсор, Инструмент, Страницы.Отпечаток,
		Страницы.Время);
	Если Не Проверка.Успех Тогда
		Контекст.Причина = Проверка.Причина;
		Страницы.Ошибка = "Курсор недійсний: повторіть запит без cursor (курсор діє 1 годину і лише для тих самих аргументів)";
		Возврат Страницы;
	КонецЕсли;
	МаксимумСмещения = mcp1c_Служебный.СвойствоЧисло(Контекст.Настройки, "maxOffset", 10000);
	Если Проверка.Смещение > МаксимумСмещения Тогда
		Страницы.Ошибка = СтрШаблон("Далі ніж %1 рядків гортати не можна: уточніть фільтри або період", МаксимумСмещения);
		Возврат Страницы;
	КонецЕсли;
	Страницы.Смещение = Проверка.Смещение;
	Возврат Страницы;

КонецФункции

#КонецОбласти

#Область Итоги

Функция НовыйКонтекстПреобразования(Контекст)

	Возврат mcp1c_Значения.НовыйКонтекстПреобразования(Контекст.Политика,
		mcp1c_Служебный.СвойствоЧисло(Контекст.Настройки, "maxStringLength", 2000));


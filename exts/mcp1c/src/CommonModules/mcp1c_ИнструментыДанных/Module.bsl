Функция НовыйКонтекстПреобразования(Контекст)

	Возврат mcp1c_Значения.НовыйКонтекстПреобразования(Контекст.Политика,
		mcp1c_Служебный.СвойствоЧисло(Контекст.Настройки, "maxStringLength", 2000));

КонецФункции

Процедура ДобавитьПримечания(Примечания, Новые)

	Для Каждого Текст Из Новые Цикл
		Если Примечания.Найти(Текст) = Неопределено Тогда
			Примечания.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПримечанияВДанные(Данные, Примечания)

	Если Примечания.Количество() > 0 Тогда
		Данные.Вставить("notes", Примечания);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьМаскированныеВДанные(Данные, Маскированные)
	// masked_fields (п. 5.3 ТЗ): колонки, значения которых замаскированы профилем.

	Если Маскированные.Количество() > 0 Тогда
		Данные.Вставить("masked_fields", Маскированные);
	КонецЕсли;


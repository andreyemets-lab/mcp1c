#Область Таблицы

Функция ТаблицаДляЧтения(ИмяТаблицы, Контекст, ДопустимыеВиды)
	// Описание таблицы, доступной клиенту, или текст ошибки. Скрытый объект не отличается
	// от отсутствующего (п. 4.4 ТЗ); причина отказа пишется в журнал.

	ТекстОшибки = СтрШаблон("Об'єкт не знайдено або недоступний: %1. Перевірте ім'я через list_objects.",
		Лев(ИмяТаблицы, 300));
	Таблица = mcp1c_Метаданные.ОписаниеТаблицы(ИмяТаблицы);
	Если Таблица = Неопределено Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Политика = Контекст.Политика;
	Доступен = mcp1c_ПравилаДоступа.ОбъектДоступен(Политика, Таблица.Объект);
	Если Доступен И Таблица.ВидТаблицы = "tabular_section" Тогда
		Доступен = mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(Политика, Таблица.Объект,
			Лев(Таблица.ПрефиксПолейПолитики, СтрДлина(Таблица.ПрефиксПолейПолитики) - 1));
	КонецЕсли;
	Если Не Доступен Тогда
		Контекст.ОтказДоступа = Истина;
		Контекст.Причина = "Об'єкт заборонений політикою: " + Таблица.Имя;
		Возврат ТекстОшибки;
	КонецЕсли;
	Если СтрРазделить(ДопустимыеВиды, ",").Найти(Таблица.ВидТаблицы) = Неопределено Тогда
		Возврат СтрШаблон("Таблиця %1 не читається цим інструментом: для регістрів використовуйте get_balances, "
			+ "get_turnovers або get_slice; для об'єктів - query_records або get_object", Таблица.Имя);
	КонецЕсли;
	ДобавитьОбъектВКонтекст(Контекст, Таблица.Имя);
	Возврат Таблица;

КонецФункции

Функция ТаблицаРегистра(ИмяРегистра, ВиртуальнаяТаблица, Контекст, Пояснение)

	ТекстОшибки = СтрШаблон("Об'єкт не знайдено або недоступний: %1. Перевірте ім'я через list_objects.",
		Лев(ИмяРегистра, 300));
	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(ИмяРегистра);
	Если ОбъектМД = Неопределено Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД);
	Если Не mcp1c_ПравилаДоступа.ОбъектДоступен(Контекст.Политика, ПолноеИмя) Тогда
		Контекст.ОтказДоступа = Истина;
		Контекст.Причина = "Об'єкт заборонений політикою: " + ПолноеИмя;
		Возврат ТекстОшибки;
	КонецЕсли;
	Таблица = mcp1c_Метаданные.ОписаниеТаблицы(ПолноеИмя + "." + ВиртуальнаяТаблица);
	Если Таблица = Неопределено Тогда
		Возврат СтрШаблон("%1: %2", ПолноеИмя, Пояснение);
	КонецЕсли;
	ДобавитьОбъектВКонтекст(Контекст, ПолноеИмя);
	Возврат Таблица;


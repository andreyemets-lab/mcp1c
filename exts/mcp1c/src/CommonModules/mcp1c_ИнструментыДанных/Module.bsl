Процедура ДобавитьОбъектВКонтекст(Контекст, Имя)

	Если Контекст.Объекты.Найти(Имя) = Неопределено Тогда
		Контекст.Объекты.Добавить(Имя);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Выполнение

Функция ВыполнитьСтраничныйЗапрос(ВидПостроения, Инструмент, Аргументы, Таблица, Данные, Контекст)
	// Запрос со страницами: лимит, курсор, построение, выполнение и курсор следующей страницы.

	Лимит = ЛимитСтрок(Аргументы, Контекст, 50);
	Если Лимит = 0 Тогда
		Возврат ИтогКвотаИсчерпана();
	КонецЕсли;
	Страницы = ПрочитатьКурсор(Аргументы, Инструмент, Контекст);
	Если Не ПустаяСтрока(Страницы.Ошибка) Тогда
		Возврат ИтогОшибка(Страницы.Ошибка);
	КонецЕсли;

	Построение = ПостроитьЗапрос(ВидПостроения, Аргументы, Таблица, Контекст.Политика, Лимит, Страницы.Смещение, Неопределено);
	Если Не ПустаяСтрока(Построение.Ошибка) Тогда
		Возврат ИтогОшибкаПостроения(Построение, Контекст);
	КонецЕсли;
	Выполнение = ВыполнитьПостроение(Построение, НовыйКонтекстПреобразования(Контекст), Контекст);
	Если Не ПустаяСтрока(Выполнение.Ошибка) Тогда
		Возврат ИтогОшибка(Выполнение.Ошибка);
	КонецЕсли;

	Данные.Вставить("columns", mcp1c_ЗапросыДанных.ОписаниеКолонок(Построение));
	Данные.Вставить("rows", Выполнение.Строки);
	Данные.Вставить("row_count", Выполнение.Строки.Количество());
	Данные.Вставить("has_more", Выполнение.ЕстьЕще);
	ДобавитьМаскированныеВДанные(Данные, mcp1c_ЗапросыДанных.МаскированныеКолонки(Построение));
	Примечания = Новый Массив;
	ДобавитьПримечания(Примечания, Построение.Примечания);
	Если Выполнение.ЕстьЕще Тогда
		Данные.Вставить("next_cursor", mcp1c_Курсор.Сформировать(Страницы.Секрет, Страницы.Привязка, Инструмент,
			Страницы.Отпечаток, Страницы.Смещение + Выполнение.Строки.Количество(), Страницы.Время));
		Примечания.Добавить("Є ще рядки: повторіть виклик з cursor = next_cursor або уточніть фільтри");
	КонецЕсли;
	Если Лимит < mcp1c_Служебный.СвойствоЧисло(Аргументы, "limit", 50) Тогда
		Примечания.Добавить(СтрШаблон("Кількість рядків обмежено до %1 профілем або добовою квотою", Лимит));
	КонецЕсли;
	ДобавитьПримечанияВДанные(Данные, Примечания);
	Возврат ИтогУспех(Данные);

КонецФункции

Функция ПостроитьЗапрос(ВидПостроения, Аргументы, Таблица, Политика, Лимит, Смещение, Дополнительно)
	// Строит запрос, подгружая описания таблиц для разыменования, пока построение их запрашивает.

	Описания = Новый Соответствие;
	Попыток = 0;
	Пока Попыток < 20 Цикл
		Попыток = Попыток + 1;
		Если ВидПостроения = "records" Тогда
			Построение = mcp1c_ЗапросыДанных.ВыборкаЗаписей(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		ИначеЕсли ВидПостроения = "find" Тогда
			Построение = mcp1c_ЗапросыДанных.ПоискОбъектов(Дополнительно.ТекстПоиска, Таблица, Описания, Политика, Лимит);
		ИначеЕсли ВидПостроения = "card" Тогда
			Построение = mcp1c_ЗапросыДанных.КарточкаОбъекта(Таблица, Описания, Политика, Дополнительно.Идентификатор);
		ИначеЕсли ВидПостроения = "tabular" Тогда
			Построение = mcp1c_ЗапросыДанных.СтрокиТабличнойЧасти(Таблица, Описания, Политика, Дополнительно.Идентификатор, Лимит);
		ИначеЕсли ВидПостроения = "balances" Тогда
			Построение = mcp1c_ЗапросыДанных.Остатки(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		ИначеЕсли ВидПостроения = "turnovers" Тогда
			Построение = mcp1c_ЗапросыДанных.Обороты(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		Иначе
			Построение = mcp1c_ЗапросыДанных.Срез(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		КонецЕсли;
		Если ПустаяСтрока(Построение.НужноОписание) Тогда
			Возврат Построение;
		КонецЕсли;
		Описание = mcp1c_Метаданные.ОписаниеТаблицы(Построение.НужноОписание);
		Если Описание = Неопределено Тогда
			// Ссылка на объект вида, который не читается (план обмена и т. п.): разыменование невозможно.
			Построение.Ошибка = СтрШаблон("Розіменування через посилання на %1 не підтримується", Построение.НужноОписание);
			Построение.НужноОписание = "";
			Возврат Построение;
		КонецЕсли;
		Описания.Вставить(Построение.НужноОписание, Описание);
	КонецЦикла;
	ВызватьИсключение "Побудова запиту не завершилася: забагато описів для розіменування";

КонецФункции

// Выполняет построенный запрос: пропускает строки предыдущих страниц, берет не больше лимита.
//
// Параметры:
//  Построение - см. mcp1c_ЗапросыДанных.ВыборкаЗаписей
//  КонтекстПреобразования - см. mcp1c_Значения.НовыйКонтекстПреобразования
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Строки - Массив из Произвольный - строки: массивы значений JSON по колонкам.
//   * ЕстьЕще - Булево - есть строки следующей страницы.
//   * Ошибка - Строка - текст ошибки для модели.
//
Функция ВыполнитьПостроение(Построение, КонтекстПреобразования, Контекст)

	Результат = Новый Структура;
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("ЕстьЕще", Ложь);
	Результат.Вставить("Ошибка", "");
	Параметры = mcp1c_Значения.ЗначенияПараметров(Построение.Параметры);
	Если Не ПустаяСтрока(Параметры.Ошибка) Тогда
		Результат.Ошибка = Параметры.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Таблица = mcp1c_ВыполнениеЗапросов.ВыполнитьЗапрос(Построение.Спецификация, Параметры.Значения).Выгрузить();
	Последняя = Построение.Смещение + Построение.Лимит - 1;
	Если Последняя > Таблица.Количество() - 1 Тогда
		Последняя = Таблица.Количество() - 1;
	КонецЕсли;
	Для Индекс = Построение.Смещение По Последняя Цикл
		СтрокаТаблицы = Таблица[Индекс];
		Значения = Новый Массив;
		Для Каждого Колонка Из Построение.Колонки Цикл
			Представление = ?(Колонка.Представление,
				СтрокаТаблицы[mcp1c_КонструкторЗапросов.ПсевдонимПредставления(Колонка.Псевдоним)], Неопределено);
			Значения.Добавить(mcp1c_Значения.ЗначениеВJSON(СтрокаТаблицы[Колонка.Псевдоним], Представление,
				КонтекстПреобразования, Колонка.Маска));
		КонецЦикла;
		Результат.Строки.Добавить(Значения);
	КонецЦикла;
	Результат.ЕстьЕще = Таблица.Количество() > Построение.Смещение + Построение.Лимит;
	Контекст.КоличествоСтрок = Контекст.КоличествоСтрок + Результат.Строки.Количество();
	Возврат Результат;

КонецФункции

Функция СтрокиТабличныхЧастей(Таблица, Аргументы, Идентификатор, Лимит, КонтекстПреобразования, Контекст, Примечания)

	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(Таблица.Объект);
	Запрошенные = mcp1c_Служебный.СвойствоМассив(Аргументы, "tabular_sections");
	Результат = Новый Соответствие;
	Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
		Если Запрошенные.Количество() > 0 И Не ЕстьИмя(Запрошенные, ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если Не mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(Контекст.Политика, Таблица.Объект, ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ТаблицаЧасти = mcp1c_Метаданные.ОписаниеТаблицы(Таблица.Объект + "." + ТабличнаяЧасть.Имя);
		Дополнительно = Новый Структура("Идентификатор", Идентификатор);
		Построение = ПостроитьЗапрос("tabular", Аргументы, ТаблицаЧасти, Контекст.Политика, Лимит, 0, Дополнительно);
		Если Не ПустаяСтрока(Построение.Ошибка) Тогда
			Примечания.Добавить(СтрШаблон("Таблична частина %1 пропущена: %2", ТабличнаяЧасть.Имя, Построение.Ошибка));
			Продолжить;
		КонецЕсли;
		Выполнение = ВыполнитьПостроение(Построение, КонтекстПреобразования, Контекст);
		Если Не ПустаяСтрока(Выполнение.Ошибка) Тогда
			Возврат Выполнение.Ошибка;
		КонецЕсли;
		Часть = Новый Соответствие;
		Часть.Вставить("columns", mcp1c_ЗапросыДанных.ОписаниеКолонок(Построение));
		Часть.Вставить("rows", Выполнение.Строки);
		Часть.Вставить("row_count", Выполнение.Строки.Количество());
		Часть.Вставить("has_more", Выполнение.ЕстьЕще);
		ДобавитьМаскированныеВДанные(Часть, mcp1c_ЗапросыДанных.МаскированныеКолонки(Построение));
		Если Выполнение.ЕстьЕще Тогда
			Примечания.Добавить(СтрШаблон("У табличній частині %1 є ще рядки: query_records з object %2 і фільтром "
				+ "за Ссылка", ТабличнаяЧасть.Имя, ТаблицаЧасти.Имя));
		КонецЕсли;
		Результат.Вставить(ТабличнаяЧасть.Имя, Часть);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьИмя(Имена, Имя)

	Для Каждого Элемент Из Имена Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") И НРег(СокрЛП(Элемент)) = НРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭлементПоиска(ИмяОбъекта, Колонки, Строка_)

	Элемент = Новый Соответствие;
	Элемент.Вставить("object", ИмяОбъекта);
	Поля = Новый Соответствие;
	Для Индекс = 0 По Колонки.ВГраница() Цикл
		Если Колонки[Индекс].Имя = "Ссылка" Тогда
			Элемент.Вставить("ref", Строка_[Индекс]);
		Иначе
			Поля.Вставить(Колонки[Индекс].Имя, Строка_[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Элемент.Вставить("fields", Поля);
	Возврат Элемент;

КонецФункции

#КонецОбласти

#Область ЛимитыИКурсоры

Функция ЛимитСтрок(Аргументы, Контекст, ПоУмолчанию)
	// Строк на странице: аргумент limit, не больше лимита профиля и остатка суточной квоты.
	// 0 - квота исчерпана.

	Лимит = Мин(mcp1c_Служебный.СвойствоЧисло(Аргументы, "limit", ПоУмолчанию), Контекст.Политика.Лимиты.СтрокЗаВызов);
	Если Контекст.ОстатокКвотыСтрок <> Неопределено Тогда
		Лимит = Мин(Лимит, Контекст.ОстатокКвотыСтрок);
	КонецЕсли;
	Возврат Макс(Лимит, 0);

КонецФункции

Функция ПрочитатьКурсор(Аргументы, Инструмент, Контекст)
	// Параметры страниц по курсору из аргументов: Секрет, Привязка, Отпечаток, Время, Смещение
	// и Ошибка - текст ошибки для модели (пустая строка, если курсора нет или он действителен).

	Страницы = Новый Структура;
	Страницы.Вставить("Секрет", mcp1c_Настройки.СекретКурсоров());
	Страницы.Вставить("Привязка", Строка(Контекст.Политика.Клиент.УникальныйИдентификатор()));
	Страницы.Вставить("Отпечаток", mcp1c_Курсор.ОтпечатокАргументов(Аргументы));
	Страницы.Вставить("Время", mcp1c_Курсор.СекундыОтНачалаЭпохи(ТекущаяУниверсальнаяДата()));
	Страницы.Вставить("Смещение", 0);
	Страницы.Вставить("Ошибка", "");

	Курсор = mcp1c_Служебный.СвойствоСтрока(Аргументы, "cursor");
	Если ПустаяСтрока(Курсор) Тогда
		Возврат Страницы;
	КонецЕсли;
	Проверка = mcp1c_Курсор.Проверить(Страницы.Секрет, Страницы.Привязка, Курсор, Инструмент, Страницы.Отпечаток,
		Страницы.Время);
	Если Не Проверка.Успех Тогда
		Контекст.Причина = Проверка.Причина;
		Страницы.Ошибка = "Курсор недійсний: повторіть запит без cursor (курсор діє 1 годину і лише для тих самих аргументів)";
		Возврат Страницы;
	КонецЕсли;
	МаксимумСмещения = mcp1c_Служебный.СвойствоЧисло(Контекст.Настройки, "maxOffset", 10000);
	Если Проверка.Смещение > МаксимумСмещения Тогда
		Страницы.Ошибка = СтрШаблон("Далі ніж %1 рядків гортати не можна: уточніть фільтри або період", МаксимумСмещения);
		Возврат Страницы;
	КонецЕсли;
	Страницы.Смещение = Проверка.Смещение;
	Возврат Страницы;

КонецФункции

#КонецОбласти


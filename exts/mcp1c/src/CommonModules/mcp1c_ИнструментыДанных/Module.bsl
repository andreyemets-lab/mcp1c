#КонецОбласти

#Область ПользовательскиеИнструменты

// Таблица результата пользовательского инструмента: колонки и до Лимит + 1 строк
// (лишняя строка показывает, что строк больше лимита).
//
// Возвращаемое значение:
//  Структура:
//   * Колонки - Массив из Строка - имена колонок.
//   * Строки - Массив из Произвольный - строки: массивы значений по колонкам.
//
Функция НоваяТаблицаРезультата()

	Возврат Новый Структура("Колонки, Строки", Новый Массив, Новый Массив);

КонецФункции

Функция ТаблицаИзРезультата(Результат, Лимит)
	// Первые Лимит + 1 строк результата запроса.

	Таблица = НоваяТаблицаРезультата();
	Для Каждого Колонка Из Результат.Колонки Цикл
		Таблица.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Выборка = Результат.Выбрать();
	Пока Таблица.Строки.Количество() <= Лимит И Выборка.Следующий() Цикл
		Значения = Новый Массив;
		Для Индекс = 0 По Таблица.Колонки.ВГраница() Цикл
			Значения.Добавить(Выборка.Получить(Индекс));
		КонецЦикла;
		Таблица.Строки.Добавить(Значения);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Функция ТаблицаИзТаблицыЗначений(ТаблицаЗначений, Лимит)
	// Первые Лимит + 1 строк таблицы значений.

	Таблица = НоваяТаблицаРезультата();
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Таблица.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ТаблицаЗначений Цикл
		Если Таблица.Строки.Количество() > Лимит Тогда
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Индекс = 0 По Таблица.Колонки.ВГраница() Цикл
			Значения.Добавить(СтрокаТаблицы.Получить(Индекс));
		КонецЦикла;
		Таблица.Строки.Добавить(Значения);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Функция ТаблицаИзМассива(Массив, Лимит)
	// Первые Лимит + 1 элементов массива: колонки - ключи структур и соответствий в порядке появления,
	// у простых значений - колонка value.

	Таблица = НоваяТаблицаРезультата();
	Последний = Мин(Массив.Количество(), Лимит + 1) - 1;
	Для Индекс = 0 По Последний Цикл
		ДобавитьКолонкиЭлемента(Таблица.Колонки, Массив[Индекс]);
	КонецЦикла;
	Для Индекс = 0 По Последний Цикл
		Значения = Новый Массив;
		Для Каждого Имя Из Таблица.Колонки Цикл
			Значения.Добавить(ЗначениеЭлемента(Массив[Индекс], Имя));
		КонецЦикла;
		Таблица.Строки.Добавить(Значения);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Процедура ДобавитьКолонкиЭлемента(Колонки, Элемент)

	Если ТипЗнч(Элемент) = Тип("Структура") Или ТипЗнч(Элемент) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Элемент Цикл
			Имя = Строка(КлючИЗначение.Ключ);
			Если Колонки.Количество() < 100 И Колонки.Найти(Имя) = Неопределено Тогда
				Колонки.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Колонки.Найти("value") = Неопределено Тогда
		Колонки.Добавить("value");
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеЭлемента(Элемент, Имя)

	Если ТипЗнч(Элемент) = Тип("Структура") Тогда
		Значение = Неопределено;
		Элемент.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Элемент) = Тип("Соответствие") Тогда
		Возврат Элемент.Получить(Имя);
	КонецЕсли;
	Возврат ?(Имя = "value", Элемент, Неопределено);

КонецФункции

Функция ТаблицаРезультатаМетода(Результат, Лимит)
	// Таблица из результата метода модуля; Неопределено - результат не табличный.

	Если ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
		Возврат ТаблицаИзТаблицыЗначений(Результат, Лимит);
	ИначеЕсли ТипЗнч(Результат) = Тип("РезультатЗапроса") Тогда
		Возврат ТаблицаИзРезультата(Результат, Лимит);
	ИначеЕсли ТипЗнч(Результат) = Тип("Массив") Тогда
		Возврат ТаблицаИзМассива(Результат, Лимит);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ДанныеТаблицы(Таблица, Лимит, Контекст)
	// columns, rows, row_count и has_more (п. 5.3 ТЗ); ссылки - с представлениями по правилам профиля.

	ЕстьЕще = Таблица.Строки.Количество() > Лимит;
	Если ЕстьЕще Тогда
		Таблица.Строки.Удалить(Таблица.Строки.ВГраница());
	КонецЕсли;
	КонтекстПреобразования = НовыйКонтекстПреобразования(Контекст);
	Все = Новый Массив;
	Для Каждого Значения Из Таблица.Строки Цикл
		Для Каждого Значение Из Значения Цикл
			Все.Добавить(Значение);
		КонецЦикла;
	КонецЦикла;
	Представления = mcp1c_Значения.ПредставленияСсылок(Все, КонтекстПреобразования);

	Колонки = Новый Массив;
	Для Каждого Имя Из Таблица.Колонки Цикл
		Описание = Новый Соответствие;
		Описание.Вставить("name", Имя);
		Колонки.Добавить(Описание);
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого Значения Из Таблица.Строки Цикл
		СтрокаJSON = Новый Массив;
		Для Каждого Значение Из Значения Цикл
			СтрокаJSON.Добавить(mcp1c_Значения.ЗначениеВJSON(Значение, Представления.Получить(Значение),
				КонтекстПреобразования));
		КонецЦикла;
		Строки.Добавить(СтрокаJSON);
	КонецЦикла;
	Контекст.КоличествоСтрок = Контекст.КоличествоСтрок + Строки.Количество();

	Данные = Новый Соответствие;
	Данные.Вставить("columns", Колонки);
	Данные.Вставить("rows", Строки);
	Данные.Вставить("row_count", Строки.Количество());
	Данные.Вставить("has_more", ЕстьЕще);
	Если ЕстьЕще Тогда
		Примечания = Новый Массив;
		Примечания.Добавить(СтрШаблон("Показано перші %1 рядків: уточніть аргументи, щоб звузити вибірку",
			Формат(Лимит, "ЧГ=0")));
		Данные.Вставить("notes", Примечания);
	КонецЕсли;
	Возврат Данные;

КонецФункции

Функция ЗначениеРезультатаМетода(Значение, Лимит, Контекст)
	// result метода модуля: структура или соответствие - объект JSON из простых значений и ссылок
	// (до Лимит свойств), прочее - одно значение.

	КонтекстПреобразования = НовыйКонтекстПреобразования(Контекст);
	Значения = Новый Массив;
	ЭтоОбъект = (ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие"));
	Если ЭтоОбъект Тогда
		Для Каждого КлючИЗначение Из Значение Цикл
			Значения.Добавить(КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		Значения.Добавить(Значение);
	КонецЕсли;
	Представления = mcp1c_Значения.ПредставленияСсылок(Значения, КонтекстПреобразования);
	Если Не ЭтоОбъект Тогда
		Возврат mcp1c_Значения.ЗначениеВJSON(Значение, Представления.Получить(Значение), КонтекстПреобразования);
	КонецЕсли;
	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из Значение Цикл
		Если Результат.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Результат.Вставить(Строка(КлючИЗначение.Ключ), mcp1c_Значения.ЗначениеВJSON(КлючИЗначение.Значение,
			Представления.Получить(КлючИЗначение.Значение), КонтекстПреобразования));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПараметрыМетода(Определение, Значения)
	// Параметры метода модуля по именам параметров инструмента; без значения - Неопределено.

	Результат = Новый Структура;
	Для Каждого Параметр Из Определение.Параметры Цикл
		Результат.Вставить(Параметр.ИмяПараметра, Значения.Получить(Параметр.ИмяПараметра));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КонтекстМетода(Определение, Лимит, Контекст)
	// Сведения о вызове для метода модуля: Инструмент, Клиент, Профиль, ЛимитСтрок, ИдентификаторЗапроса.

	Результат = Новый Структура;
	Результат.Вставить("Инструмент", Определение.Имя);
	Результат.Вставить("Клиент", Контекст.Клиент);
	Результат.Вставить("Профиль", Контекст.Политика.ИмяПрофиля);
	Результат.Вставить("ЛимитСтрок", Лимит);
	Результат.Вставить("ИдентификаторЗапроса", Контекст.ИдентификаторЗапроса);
	Возврат Результат;

КонецФункции


///////////////////////////////////////////////////////////////////////////////
// mcp1c_ИнструментыДанных: инструменты чтения данных find_objects, get_object, query_records,
// get_balances, get_turnovers, get_slice (п. 5.2-5.4 ТЗ).
//
// Порядок выполнения: таблица и ее доступность по политике -> лимит строк и курсор ->
// построение запроса (mcp1c_ЗапросыДанных, с подгрузкой описаний для разыменования) ->
// значения параметров (mcp1c_Значения) -> выполнение (mcp1c_ВыполнениеЗапросов) ->
// значения результата в JSON -> курсор следующей страницы.
// Каждая функция возвращает итог - структуру с полями Данные (structuredContent)
// и Ошибка (текст для модели, isError). Имена замаскированных колонок - в masked_fields.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// find_objects: поиск объектов по строке в нескольких таблицах.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция НайтиОбъекты(Аргументы, Контекст) Экспорт

	Политика = Контекст.Политика;
	ТекстПоиска = СокрЛП(mcp1c_Служебный.СвойствоСтрока(Аргументы, "query"));
	Лимит = ЛимитСтрок(Аргументы, Контекст, 20);
	Если Лимит = 0 Тогда
		Возврат ИтогКвотаИсчерпана();
	КонецЕсли;
	КонтекстПреобразования = НовыйКонтекстПреобразования(Контекст);

	Элементы = Новый Массив;
	Просмотренные = Новый Массив;
	Маскированные = Новый Массив;
	ЕстьЕще = Ложь;
	Примечания = Новый Массив;
	Для Каждого ИмяОбъекта Из mcp1c_Служебный.СвойствоМассив(Аргументы, "objects") Цикл
		Таблица = ТаблицаДляЧтения(ИмяОбъекта, Контекст, "object");
		Если ТипЗнч(Таблица) = Тип("Строка") Тогда
			Возврат ИтогОшибка(Таблица);
		КонецЕсли;
		Если mcp1c_ПравилаДоступа.ТолькоАгрегаты(Политика, Таблица.Объект) Тогда
			Примечания.Добавить(СтрШаблон("«%1» доступний лише в агрегатах і в пошуку не бере участі", Таблица.Объект));
			Продолжить;
		КонецЕсли;
		Если Элементы.Количество() >= Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Дополнительно = Новый Структура("ТекстПоиска", ТекстПоиска);
		Построение = ПостроитьЗапрос("find", Аргументы, Таблица, Политика, Лимит - Элементы.Количество(), 0, Дополнительно);
		Если Не ПустаяСтрока(Построение.Ошибка) Тогда
			Возврат ИтогОшибкаПостроения(Построение, Контекст);
		КонецЕсли;
		Выполнение = ВыполнитьПостроение(Построение, КонтекстПреобразования, Контекст);
		Если Не ПустаяСтрока(Выполнение.Ошибка) Тогда
			Возврат ИтогОшибка(Выполнение.Ошибка);
		КонецЕсли;
		Для Каждого Строка_ Из Выполнение.Строки Цикл
			Элементы.Добавить(ЭлементПоиска(Таблица.Объект, Построение.Колонки, Строка_));
		КонецЦикла;
		ЕстьЕще = ЕстьЕще Или Выполнение.ЕстьЕще;
		Просмотренные.Добавить(Таблица.Объект);
		ДобавитьПримечания(Примечания, Построение.Примечания);
		ДобавитьПримечания(Маскированные, mcp1c_ЗапросыДанных.МаскированныеКолонки(Построение));
	КонецЦикла;

	Данные = Новый Соответствие;
	Данные.Вставить("query", ТекстПоиска);
	Данные.Вставить("items", Элементы);
	Данные.Вставить("returned", Элементы.Количество());
	Данные.Вставить("has_more", ЕстьЕще);
	Данные.Вставить("searched", Просмотренные);
	ДобавитьМаскированныеВДанные(Данные, Маскированные);
	Если ЕстьЕще Тогда
		Примечания.Добавить("Знайдено більше: уточніть рядок пошуку або збільште limit");
	КонецЕсли;
	Если Элементы.Количество() = 0 Тогда
		Примечания.Добавить("Нічого не знайдено: спробуйте коротший рядок або query_records з фільтрами");
	КонецЕсли;
	ДобавитьПримечанияВДанные(Данные, Примечания);
	Возврат ИтогУспех(Данные);

КонецФункции

// get_object: реквизиты объекта и строки табличных частей.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ПолучитьОбъект(Аргументы, Контекст) Экспорт

	Политика = Контекст.Политика;
	Таблица = ТаблицаДляЧтения(mcp1c_Служебный.СвойствоСтрока(Аргументы, "object"), Контекст, "object");
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Идентификатор = mcp1c_Служебный.СвойствоСтрока(Аргументы, "ref");
	КонтекстПреобразования = НовыйКонтекстПреобразования(Контекст);

	Дополнительно = Новый Структура("Идентификатор", Идентификатор);
	Построение = ПостроитьЗапрос("card", Аргументы, Таблица, Политика, 1, 0, Дополнительно);
	Если Не ПустаяСтрока(Построение.Ошибка) Тогда
		Возврат ИтогОшибкаПостроения(Построение, Контекст);
	КонецЕсли;
	Выполнение = ВыполнитьПостроение(Построение, КонтекстПреобразования, Контекст);
	Если Не ПустаяСтрока(Выполнение.Ошибка) Тогда
		Возврат ИтогОшибка(Выполнение.Ошибка);
	КонецЕсли;
	Если Выполнение.Строки.Количество() = 0 Тогда
		Возврат ИтогОшибка(СтрШаблон("Об'єкт не знайдено або недоступний: %1 %2", Таблица.Объект, Лев(Идентификатор, 36)));
	КонецЕсли;

	Поля = Новый Соответствие;
	Ссылка = Неопределено;
	Строка_ = Выполнение.Строки[0];
	Для Индекс = 0 По Построение.Колонки.ВГраница() Цикл
		Если Построение.Колонки[Индекс].Имя = "Ссылка" Тогда
			Ссылка = Строка_[Индекс];
		Иначе
			Поля.Вставить(Построение.Колонки[Индекс].Имя, Строка_[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Данные = Новый Соответствие;
	Данные.Вставить("object", Таблица.Объект);
	Данные.Вставить("ref", Ссылка);
	Данные.Вставить("fields", Поля);
	ДобавитьМаскированныеВДанные(Данные, mcp1c_ЗапросыДанных.МаскированныеКолонки(Построение));
	Примечания = Новый Массив;
	ДобавитьПримечания(Примечания, Построение.Примечания);
	ЛимитСтрокЧастей = Мин(mcp1c_Служебный.СвойствоЧисло(Аргументы, "tabular_limit", 20), Политика.Лимиты.СтрокЗаВызов);
	Если ЛимитСтрокЧастей > 0 Тогда
		Части = СтрокиТабличныхЧастей(Таблица, Аргументы, Идентификатор, ЛимитСтрокЧастей, КонтекстПреобразования,
			Контекст, Примечания);
		Если ТипЗнч(Части) = Тип("Строка") Тогда
			Возврат ИтогОшибка(Части);
		КонецЕсли;
		Если Части.Количество() > 0 Тогда
			Данные.Вставить("tabular_sections", Части);
		КонецЕсли;
	КонецЕсли;
	ДобавитьПримечанияВДанные(Данные, Примечания);
	Возврат ИтогУспех(Данные);

КонецФункции

// query_records: выборка из одной таблицы.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ВыбратьЗаписи(Аргументы, Контекст) Экспорт

	Таблица = ТаблицаДляЧтения(mcp1c_Служебный.СвойствоСтрока(Аргументы, "object"), Контекст, "object,tabular_section,register");
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить("object", Таблица.Имя);
	Возврат ВыполнитьСтраничныйЗапрос("records", "query_records", Аргументы, Таблица, Данные, Контекст);

КонецФункции

// get_balances: остатки регистра накопления или бухгалтерии.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ПолучитьОстатки(Аргументы, Контекст) Экспорт

	Регистр = mcp1c_Служебный.СвойствоСтрока(Аргументы, "register");
	Таблица = ТаблицаРегистра(Регистр, "Остатки", Контекст,
		"Залишки є лише в регістрів накопичення виду «залишки» і регістрів бухгалтерії");
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить("register", Таблица.Объект);
	Если Аргументы.Получить("date") <> Неопределено Тогда
		Данные.Вставить("date", Аргументы.Получить("date"));
	КонецЕсли;
	Возврат ВыполнитьСтраничныйЗапрос("balances", "get_balances", Аргументы, Таблица, Данные, Контекст);

КонецФункции

// get_turnovers: обороты регистра накопления или бухгалтерии за период.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ПолучитьОбороты(Аргументы, Контекст) Экспорт

	Регистр = mcp1c_Служебный.СвойствоСтрока(Аргументы, "register");
	СОстатками = mcp1c_Служебный.СвойствоБулево(Аргументы, "with_balances", Ложь);
	Таблица = ТаблицаРегистра(Регистр, ?(СОстатками, "ОстаткиИОбороты", "Обороты"), Контекст,
		?(СОстатками, "Залишки й обороти є лише в регістрів накопичення виду «залишки» і регістрів бухгалтерії",
		"Обороти є лише в регістрів накопичення і бухгалтерії"));
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить("register", Таблица.Объект);
	Данные.Вставить("period", Аргументы.Получить("period"));
	Данные.Вставить("periodicity", mcp1c_Служебный.СвойствоСтрока(Аргументы, "periodicity", "none"));
	Возврат ВыполнитьСтраничныйЗапрос("turnovers", "get_turnovers", Аргументы, Таблица, Данные, Контекст);

КонецФункции

// get_slice: срез последних или первых записей периодического регистра сведений.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ПолучитьСрез(Аргументы, Контекст) Экспорт

	Режим = mcp1c_Служебный.СвойствоСтрока(Аргументы, "mode", "last");
	Таблица = ТаблицаРегистра(mcp1c_Служебный.СвойствоСтрока(Аргументы, "register"),
		?(Режим = "first", "СрезПервых", "СрезПоследних"), Контекст,
		"Зріз є лише в періодичних регістрів відомостей; для інших використовуйте query_records");
	Если ТипЗнч(Таблица) = Тип("Строка") Тогда
		Возврат ИтогОшибка(Таблица);
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить("register", Таблица.Объект);
	Данные.Вставить("mode", Режим);
	Если Аргументы.Получить("date") <> Неопределено Тогда
		Данные.Вставить("date", Аргументы.Получить("date"));
	КонецЕсли;
	Возврат ВыполнитьСтраничныйЗапрос("slice", "get_slice", Аргументы, Таблица, Данные, Контекст);

КонецФункции

// Пользовательский инструмент администратора (п. 5.5 ТЗ): значения параметров из аргументов
// и параметров профиля, выполнение запроса, схемы компоновки или метода модуля, результат -
// columns и rows не больше лимита строк (у метода модуля может быть result).
//
// Параметры:
//  Имя - Строка - имя инструмента, назначенного профилю клиента.
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ВыполнитьПользовательский(Имя, Аргументы, Контекст) Экспорт

	Политика = Контекст.Политика;
	Определение = Политика.ПользовательскиеИнструменты.Получить(Имя);
	Значения = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(Определение, Аргументы, Политика);
	Если Не ПустаяСтрока(Значения.Причина) Тогда
		Контекст.ОтказДоступа = Истина;
		Контекст.Причина = Значения.Причина;
	КонецЕсли;
	Если Не ПустаяСтрока(Значения.Ошибка) Тогда
		Возврат ИтогОшибка(Значения.Ошибка);
	КонецЕсли;
	Параметры = mcp1c_Значения.ЗначенияПараметров(Значения.Значения);
	Если Не ПустаяСтрока(Параметры.Ошибка) Тогда
		Возврат ИтогОшибка(Параметры.Ошибка);
	КонецЕсли;
	Лимит = mcp1c_ПользовательскиеИнструменты.ЛимитСтрок(Определение, Политика.Лимиты.СтрокЗаВызов,
		Контекст.ОстатокКвотыСтрок);
	Если Лимит = 0 Тогда
		Возврат ИтогКвотаИсчерпана();
	КонецЕсли;

	Если Определение.Вид = "query" Тогда
		Запрос = Новый Запрос(Определение.ТекстЗапроса);
		// Параметр без значения - Неопределено: в тексте запроса его можно проверить (&Склад = НЕОПРЕДЕЛЕНО).
		Для Каждого Параметр Из Определение.Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.ИмяПараметра, Параметры.Значения.Получить(Параметр.ИмяПараметра));
		КонецЦикла;
		Таблица = ТаблицаИзРезультата(mcp1c_ВыполнениеЗапросов.ВыполнитьПривилегированно(Запрос), Лимит);
	ИначеЕсли Определение.Вид = "dcs" Тогда
		Таблица = ТаблицаИзТаблицыЗначений(
			mcp1c_ВыполнениеЗапросов.ВыполнитьКомпоновку(Определение.СхемаКомпоновки, Параметры.Значения), Лимит);
	Иначе
		Результат = mcp1c_ВыполнениеЗапросов.ВызватьМетодМодуля(Определение.ИмяМодуля, Определение.ИмяМетода,
			ПараметрыМетода(Определение, Параметры.Значения), КонтекстМетода(Определение, Лимит, Контекст));
		Таблица = ТаблицаРезультатаМетода(Результат, Лимит);
		Если Таблица = Неопределено Тогда
			Данные = Новый Соответствие;
			Данные.Вставить("result", ЗначениеРезультатаМетода(Результат, Лимит, Контекст));
			Контекст.КоличествоСтрок = Контекст.КоличествоСтрок + 1;
			Возврат ИтогУспех(Данные);
		КонецЕсли;
	КонецЕсли;
	Возврат ИтогУспех(ДанныеТаблицы(Таблица, Лимит, Контекст));

КонецФункции


Процедура ДобавитьПримечания(Примечания, Новые)

	Для Каждого Текст Из Новые Цикл
		Если Примечания.Найти(Текст) = Неопределено Тогда
			Примечания.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПримечанияВДанные(Данные, Примечания)

	Если Примечания.Количество() > 0 Тогда
		Данные.Вставить("notes", Примечания);
	КонецЕсли;

КонецПроцедуры

Функция ИтогУспех(Данные)

	Возврат Новый Структура("Данные, Ошибка", Данные, "");

КонецФункции

Функция ИтогОшибка(ТекстОшибки)

	Возврат Новый Структура("Данные, Ошибка", Неопределено, ТекстОшибки);

КонецФункции

Функция ИтогОшибкаПостроения(Построение, Контекст)

	Если Не ПустаяСтрока(Построение.Причина) Тогда
		Контекст.ОтказДоступа = Истина;
		Контекст.Причина = Построение.Причина;
	КонецЕсли;
	Возврат ИтогОшибка(Построение.Ошибка);

КонецФункции

Функция ИтогКвотаИсчерпана()

	Возврат ИтогОшибка("Добову квоту рядків вичерпано: спробуйте завтра або зверніться до адміністратора");

КонецФункции


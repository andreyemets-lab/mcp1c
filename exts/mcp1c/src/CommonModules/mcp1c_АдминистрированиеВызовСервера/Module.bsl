// Текст файла, помещенного во временное хранилище.
//
// Параметры:
//  Адрес - Строка - адрес во временном хранилище.
//
// Возвращаемое значение:
//  Строка - текст файла в UTF-8.
//
Функция ТекстФайла(Адрес) Экспорт

	Данные = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);

КонецФункции

// Загружает настройки MCP из JSON или проверяет загрузку без записи.
//
// Параметры:
//  Текст - Строка - документ JSON.
//  ТолькоПроверка - Булево - проверить без записи.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - ошибок нет.
//   * Текст - Строка - протокол и ошибки для показа.
//
Функция ЗагрузитьНастройки(Текст, ТолькоПроверка) Экспорт

	Итог = mcp1c_ОбменНастройками.Загрузить(Текст, ТолькоПроверка);
	Строки = Новый Массив;
	Если Итог.Ошибки.Количество() > 0 Тогда
		Строки.Добавить("Помилки (нічого не записано):");
		Для Каждого Ошибка Из Итог.Ошибки Цикл
			Строки.Добавить("  " + Ошибка);
		КонецЦикла;
		Строки.Добавить("");
	КонецЕсли;
	Строки.Добавить(?(ТолькоПроверка, "Буде змінено:", "Змінено:"));
	Для Каждого Запись Из Итог.Протокол Цикл
		Строки.Добавить("  " + Запись);
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("Успех", Итог.Успех = Истина);
	Результат.Вставить("Текст", СтрСоединить(Строки, Символы.ПС));
	Возврат Результат;

КонецФункции


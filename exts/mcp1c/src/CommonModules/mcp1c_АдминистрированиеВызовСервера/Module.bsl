///////////////////////////////////////////////////////////////////////////////
// mcp1c_АдминистрированиеВызовСервера: серверные вызовы команд администрирования.
// Права администратора проверяет mcp1c_Администрирование.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Выпускает токен для клиента доступа.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент.
//  СрокДействияДней - Число - срок действия.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - токен и фрагменты подключения для показа один раз.
//
Функция ВыпуститьТокен(Клиент, СрокДействияДней) Экспорт

	Выпуск = mcp1c_Администрирование.ВыпуститьТокен(Клиент, СрокДействияДней);
	Результат = Новый Структура;
	Результат.Вставить("Текст", Выпуск.ФрагментыПодключения);
	Возврат Результат;

КонецФункции

// Отзывает токен.
//
// Параметры:
//  Токен - СправочникСсылка.mcp1c_ТокеныДоступа - токен.
//
Процедура ОтозватьТокен(Токен) Экспорт

	mcp1c_Администрирование.ОтозватьТокен(Токен);

КонецПроцедуры

// Состояние сервера для окна команды.
//
// Возвращаемое значение:
//  Структура:
//   * Включен - Булево - сервер обрабатывает запросы.
//   * КаноническийАдрес - Строка - публичный адрес.
//   * ТребуетсяПодтверждениеПереноса - Булево - текущая ИБ отличается от зафиксированной.
//   * ЕстьПраваАдминистратора - Булево - пользователь может менять состояние.
//   * Текст - Строка - описание состояния.
//
Функция СостояниеСервера() Экспорт

	Возврат mcp1c_Администрирование.СостояниеСервера();

КонецФункции

// Включает сервер.
//
// Параметры:
//  КаноническийАдрес - Строка - публичный адрес MCP-эндпоинта.
//
Процедура ВключитьСервер(КаноническийАдрес) Экспорт

	mcp1c_Администрирование.ВключитьСервер(КаноническийАдрес);

КонецПроцедуры

// Выключает сервер.
//
Процедура ВыключитьСервер() Экспорт

	mcp1c_Администрирование.ВыключитьСервер();

КонецПроцедуры

// Подтверждает перенос информационной базы с отзывом всех токенов.
//
Процедура ПодтвердитьПереносИнформационнойБазы() Экспорт

	mcp1c_Администрирование.ПодтвердитьПереносИнформационнойБазы(Истина);

КонецПроцедуры

#КонецОбласти

// Выполняет вызов в песочнице от имени клиента.
//
// Параметры:
//  Клиент - СправочникСсылка.mcp1c_КлиентыДоступа - клиент.
//  Метод - Строка - метод MCP.
//  Имя - Строка - инструмент или промпт.
//  Текст - Строка - arguments в JSON или uri ресурса.
//
// Возвращаемое значение:
//  Строка - отчет: предупреждения, примененные правила и ответ модели.
//
Функция ВыполнитьВПесочнице(Клиент, Метод, Имя, Текст) Экспорт

	Попытка
		Параметры = mcp1c_Песочница.ПараметрыВызова(Метод, Имя, Текст);
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат mcp1c_Песочница.ТекстОтчета(mcp1c_Песочница.ВыполнитьМетод(Клиент, Метод, Параметры));

КонецФункции

// Анализ рисков профиля.
//
// Параметры:
//  Профиль - СправочникСсылка.mcp1c_ПрофилиДоступа - профиль.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - отчет.
//   * БезМаски - Число - чувствительных полей, видимых без маски.
//
Функция АнализРисковПрофиля(Профиль) Экспорт

	Анализ = mcp1c_АнализДоступа.АнализРисков(Профиль);
	Результат = Новый Структура;
	Результат.Вставить("Текст", Строка(Анализ.Текст));
	Результат.Вставить("БезМаски", Число(Анализ.БезМаски));
	Возврат Результат;

КонецФункции


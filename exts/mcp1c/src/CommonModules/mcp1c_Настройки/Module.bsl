///////////////////////////////////////////////////////////////////////////////
// mcp1c_Настройки: хранение настроек сервера.
// Настройки хранятся в JSON в регистре сведений mcp1c_НастройкиСервера (ключ "server"):
// константы в расширениях недоступны в режиме совместимости ниже 8.3.16. Изменяют
// настройки mcp1c_Администрирование, фиксация привязки к ИБ при первом запросе и выпуск
// секретов (подпись курсоров, соль хеш-маски, подпись страниц OAuth). Клиенты, профили и токены - в справочниках.
// Чтение и запись - по правам ролей mcp1c_Администратор и mcp1c_Сервис.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Текущие настройки сервера: значения по умолчанию, дополненные сохраненными.
// Если сохраненные настройки повреждены, сервер считается выключенным.
//
// Возвращаемое значение:
//  см. НастройкиПоУмолчанию
//
Функция Получить() Экспорт

	Настройки = НастройкиПоУмолчанию();
	Текст = ТекстНастроек();
	Если ПустаяСтрока(Текст) Тогда
		Возврат Настройки;
	КонецЕсли;

	Попытка
		Сохраненные = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
	Исключение
		mcp1c_Аудит.ЗаписатьОшибку("Налаштування сервера пошкоджено, сервер вимкнено до виправлення",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Настройки.Вставить("enabled", Ложь);
		Возврат Настройки;
	КонецПопытки;

	Если ТипЗнч(Сохраненные) <> Тип("Соответствие") Тогда
		Настройки.Вставить("enabled", Ложь);
		Возврат Настройки;
	КонецЕсли;

	Для Каждого Элемент Из Сохраненные Цикл
		Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Возврат Настройки;

КонецФункции

// Настройки по умолчанию: сервер выключен.
// Ключи настроек:
//  schemaVersion - Число - версия структуры настроек.
//  enabled - Булево - сервер обрабатывает запросы.
//  canonicalUrl - Строка - публичный адрес MCP-эндпоинта: фрагменты подключения и ресурс OAuth (RFC 8707).
//  ibBinding - Строка - расположение ИБ (File, Srvr, Ref), к которому привязан сервер;
//    пустая строка - привязку зафиксирует первый аутентифицированный запрос.
//  allowedOrigins - Массив из Строка - разрешенные значения заголовка Origin.
//  clientIpHeader - Строка - заголовок с IP клиента, который ставит доверенный прокси.
//  maxBodyBytes - Число - максимальный размер тела запроса.
//  defaultTokenDays - Число - срок действия токена по умолчанию.
//  maxTokenDays - Число - максимальный срок действия токена.
//  listTtlMs - Число - подсказка клиенту о сроке кеширования списков.
//  instructions - Строка - дополнительный текст инструкций для модели.
//  glossary - Массив - глоссарий базы (п. 5.6 ТЗ): термины Соответствие с ключами term и definition
//    (см. mcp1c_ОписанияРесурсов.НормализованныйГлоссарий) для инструкций, get_context и onec://glossary.
//  bannedFieldPatterns - Массив из Строка - глобально запрещенные поля (п. 7.6 ТЗ).
//  bannedObjectPatterns - Массив из Строка - глобально запрещенные объекты (п. 7.6 ТЗ).
//  logArguments - Булево - записывать аргументы вызовов в журнал.
//  logRetentionDays - Число - срок хранения журнала вызовов в днях (п. 8.1 ТЗ); 0 - не очищается.
//  maxStringLength - Число - длина строковых значений в ответе, после которой они обрезаются.
//  authFailuresLimit - Число - неудачных аутентификаций с одного IP до блокировки (п. 6.5 ТЗ).
//  authFailuresWindowMinutes - Число - окно подсчета неудачных аутентификаций.
//  ipBlockMinutes - Число - срок блокировки IP.
//  policyDenialsLimit - Число - отказов политики у клиента до автоблокировки; 0 - без автоблокировки.
//  policyDenialsWindowMinutes - Число - окно подсчета отказов политики.
//  clientBlockMinutes - Число - срок автоблокировки клиента.
//  maxOffset - Число - предельная глубина пагинации (строк).
//  connectionTemplates - Массив - шаблоны фрагментов подключения клиентов (п. 9.3 ТЗ): Соответствие с ключами
//    title и text (см. mcp1c_ПодключениеКлиентов); пустой массив - шаблоны по умолчанию.
//  oauthEnabled - Булево - OAuth 2.1 для веб-коннекторов (п. 6.4 ТЗ): метаданные, сервер авторизации и токены
//    OAuth; нужен canonicalUrl.
//  oauthAccessTokenMinutes - Число - срок токена доступа OAuth в минутах (5-1440).
//  oauthRefreshTokenDays - Число - срок токена обновления OAuth в днях; при каждом обновлении токен меняется.
//  oauthConnectionDays - Число - абсолютный срок подключения OAuth в днях.
//  oauthConnectionCodeMinutes - Число - сколько минут действует код подключения.
//  oauthCimdPrefixes - Массив из Строка - доверенные префиксы адресов документов метаданных клиентов (CIMD).
//  oauthDynamicRegistration - Булево - динамическая регистрация клиентов (RFC 7591), только для совместимости.
//  cursorSecret - Строка - секрет подписи курсоров; не показывается администратору.
//  maskingSecret - Строка - секрет, из которого выводится соль хеш-маски профиля; не показывается.
//  oauthSecret - Строка - секрет подписи данных страниц авторизации OAuth; не показывается.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя настройки.
//   * Значение - Строка, Число, Булево, Массив из Строка - значение настройки.
//
Функция НастройкиПоУмолчанию() Экспорт

	Настройки = Новый Соответствие;
	Настройки.Вставить("schemaVersion", 2);
	Настройки.Вставить("enabled", Ложь);
	Настройки.Вставить("canonicalUrl", "");
	Настройки.Вставить("ibBinding", "");
	Настройки.Вставить("allowedOrigins", Новый Массив);
	Настройки.Вставить("clientIpHeader", "X-Real-IP");
	Настройки.Вставить("maxBodyBytes", 262144);
	Настройки.Вставить("defaultTokenDays", 30);
	Настройки.Вставить("maxTokenDays", 90);
	Настройки.Вставить("listTtlMs", 300000);
	Настройки.Вставить("instructions", "");
	Настройки.Вставить("glossary", Новый Массив);
	Настройки.Вставить("bannedFieldPatterns", ЗапрещенныеПоляПоУмолчанию());
	Настройки.Вставить("bannedObjectPatterns", ЗапрещенныеОбъектыПоУмолчанию());
	Настройки.Вставить("logArguments", Истина);
	Настройки.Вставить("logRetentionDays", 180);
	Настройки.Вставить("maxStringLength", 2000);
	Настройки.Вставить("authFailuresLimit", 10);
	Настройки.Вставить("authFailuresWindowMinutes", 5);
	Настройки.Вставить("ipBlockMinutes", 15);
	Настройки.Вставить("policyDenialsLimit", 30);
	Настройки.Вставить("policyDenialsWindowMinutes", 10);
	Настройки.Вставить("clientBlockMinutes", 15);
	Настройки.Вставить("maxOffset", 10000);
	Настройки.Вставить("connectionTemplates", Новый Массив);
	Настройки.Вставить("oauthEnabled", Ложь);
	Настройки.Вставить("oauthAccessTokenMinutes", 60);
	Настройки.Вставить("oauthRefreshTokenDays", 30);
	Настройки.Вставить("oauthConnectionDays", 90);
	Настройки.Вставить("oauthConnectionCodeMinutes", 10);
	Настройки.Вставить("oauthCimdPrefixes", ПрефиксыCIMDПоУмолчанию());
	Настройки.Вставить("oauthDynamicRegistration", Ложь);
	Настройки.Вставить("cursorSecret", "");
	Настройки.Вставить("maskingSecret", "");
	Настройки.Вставить("oauthSecret", "");
	Возврат Настройки;

КонецФункции

// Ключи настроек, которые не показываются администратору и не выгружаются.
//
// Возвращаемое значение:
//  Массив из Строка - ключи.
//
Функция СекретныеКлючи() Экспорт

	Результат = Новый Массив;
	Результат.Добавить("cursorSecret");
	Результат.Добавить("maskingSecret");
	Результат.Добавить("oauthSecret");
	Результат.Добавить("tokens"); // токены этапа 0: хеши больше не используются
	Возврат Результат;

КонецФункции

// Заполняет секреты сервера (подпись курсоров, соль хеш-маски, подпись страниц OAuth), если они не заданы.
// Вызывается внутри транзакции после ЗаблокироватьИПрочитать.
//
// Параметры:
//  Настройки - см. НастройкиПоУмолчанию
//
Процедура ЗаполнитьСекреты(Настройки) Экспорт

	Для Каждого Ключ Из КлючиСекретовСервера() Цикл
		Если ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Настройки, Ключ)) Тогда
			Настройки.Вставить(Ключ, mcp1c_Служебный.КодироватьBase64URL(mcp1c_Служебный.СлучайныеДанные()));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Секрет подписи курсоров; если сервер включен до появления секрета, секрет создается.
//
// Возвращаемое значение:
//  Строка - секрет.
//
Функция СекретКурсоров() Экспорт

	Возврат СекретСервера("cursorSecret");

КонецФункции

// Секрет, из которого выводится соль хеш-маски профиля (см. mcp1c_Политики); создается при первом
// обращении. Смена секрета меняет все хеши масок.
//
// Возвращаемое значение:
//  Строка - секрет.
//
Функция СекретМаскирования() Экспорт

	Возврат СекретСервера("maskingSecret");

КонецФункции

// Секрет подписи данных страниц авторизации OAuth (mcp1c_ПравилаOAuth.ПодписанныеДанные); создается при первом
// обращении. Смена секрета делает недействительными открытые страницы авторизации.
//
// Возвращаемое значение:
//  Строка - секрет.
//
Функция СекретOAuth() Экспорт

	Возврат СекретСервера("oauthSecret");

КонецФункции

// Блокирует настройки и читает их. Вызывается только внутри транзакции
// перед изменением настроек.
//
// Возвращаемое значение:
//  см. НастройкиПоУмолчанию
//
Функция ЗаблокироватьИПрочитать() Экспорт

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.mcp1c_НастройкиСервера");
	ЭлементБлокировки.УстановитьЗначение("Ключ", КлючНастроек());
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение СтрШаблон("Не вдалося заблокувати налаштування MCP-сервера: %1",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Получить();

КонецФункции

// Записывает настройки.
//
// Параметры:
//  Настройки - см. НастройкиПоУмолчанию
//
Процедура Записать(Настройки) Экспорт

	Запись = РегистрыСведений.mcp1c_НастройкиСервера.СоздатьМенеджерЗаписи();
	Запись.Ключ = КлючНастроек();
	Запись.Значение = mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Настройки);
	Запись.Записать(Истина);

КонецПроцедуры

// Расположение текущей ИБ для защиты от копий базы (п. 6.6 ТЗ): параметры File, Srvr и Ref
// строки соединения в нижнем регистре, без кавычек и прочих параметров.
// Вычисляется в сеансе веб-публикации: строка соединения в сеансе администратора может отличаться
// (имя сервера, порт), поэтому привязку фиксирует первый аутентифицированный MCP-запрос.
//
// Возвращаемое значение:
//  Строка - например, "srvr=app01;ref=erp".
//
Функция ПривязкаКИнформационнойБазе() Экспорт

	Значения = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(СокрЛП(Лев(Часть, Позиция - 1)));
		Значение = НРег(СокрЛП(СтрЗаменить(Сред(Часть, Позиция + 1), """", "")));
		Значения.Вставить(Ключ, Значение);
	КонецЦикла;

	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("file,srvr,ref", ",") Цикл
		Значение = Значения.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Части.Добавить(Ключ + "=" + Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ";");

КонецФункции

// Фиксирует привязку к текущей ИБ, если она еще не задана.
//
// Параметры:
//  Привязка - Строка - см. ПривязкаКИнформационнойБазе.
//
Процедура ЗафиксироватьПривязку(Привязка) Экспорт

	Зафиксирована = Ложь;
	НачатьТранзакцию();
	Попытка
		Настройки = ЗаблокироватьИПрочитать();
		Если ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Настройки, "ibBinding")) Тогда
			Настройки.Вставить("ibBinding", Привязка);
			Записать(Настройки);
			Зафиксирована = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Зафиксирована Тогда
		mcp1c_Аудит.ЗаписатьСобытиеБезопасности("Сервер прив'язано до інформаційної бази: " + Привязка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючНастроек()

	Возврат "server";

КонецФункции

Функция КлючиСекретовСервера()

	Возврат СтрРазделить("cursorSecret,maskingSecret,oauthSecret", ",");

КонецФункции

Функция СекретСервера(Ключ)
	// Секрет из настроек; если его нет, все отсутствующие секреты создаются в одной транзакции.

	Секрет = mcp1c_Служебный.СвойствоСтрока(Получить(), Ключ);
	Если Не ПустаяСтрока(Секрет) Тогда
		Возврат Секрет;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Настройки = ЗаблокироватьИПрочитать();
		ЗаполнитьСекреты(Настройки);
		Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат mcp1c_Служебный.СвойствоСтрока(Настройки, Ключ);

КонецФункции

Функция ТекстНастроек()

	Отбор = Новый Структура("Ключ", КлючНастроек());
	Возврат РегистрыСведений.mcp1c_НастройкиСервера.Получить(Отбор).Значение;

КонецФункции

Функция ЗапрещенныеПоляПоУмолчанию()

	Результат = Новый Массив;
	Для Каждого Шаблон Из СтрРазделить("*Пароль*,*Password*,*Токен*,*Token*,*Secret*,*Секрет*,*ApiKey*,*ПИН*,*CVV*", ",") Цикл
		Результат.Добавить(Шаблон);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПрефиксыCIMDПоУмолчанию()
	// Документы метаданных клиентов Claude (claude.ai, Claude Code) и ChatGPT.

	Результат = Новый Массив;
	Результат.Добавить("https://claude.ai/");
	Результат.Добавить("https://chatgpt.com/");
	Возврат Результат;

КонецФункции

Функция ЗапрещенныеОбъектыПоУмолчанию()

	Результат = Новый Массив;
	Результат.Добавить("ПланОбмена.*");
	Возврат Результат;

КонецФункции

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// mcp1c_Настройки: хранение настроек сервера.
// Настройки хранятся в JSON в регистре сведений mcp1c_НастройкиСервера (ключ "server"):
// константы в расширениях недоступны в режиме совместимости ниже 8.3.16. Изменяют
// настройки mcp1c_Администрирование, фиксация привязки к ИБ при первом запросе и выпуск
// секрета подписи курсоров. Клиенты, профили и токены - в справочниках.
// Чтение и запись - по правам ролей mcp1c_Администратор и mcp1c_Сервис.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Текущие настройки сервера: значения по умолчанию, дополненные сохраненными.
// Если сохраненные настройки повреждены, сервер считается выключенным.
//
// Возвращаемое значение:
//  см. НастройкиПоУмолчанию
//
Функция Получить() Экспорт

	Настройки = НастройкиПоУмолчанию();
	Текст = ТекстНастроек();
	Если ПустаяСтрока(Текст) Тогда
		Возврат Настройки;
	КонецЕсли;

	Попытка
		Сохраненные = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(Текст);
	Исключение
		mcp1c_Аудит.ЗаписатьОшибку("Настройки сервера повреждены, сервер выключен до исправления",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Настройки.Вставить("enabled", Ложь);
		Возврат Настройки;
	КонецПопытки;

	Если ТипЗнч(Сохраненные) <> Тип("Соответствие") Тогда
		Настройки.Вставить("enabled", Ложь);
		Возврат Настройки;
	КонецЕсли;

	Для Каждого Элемент Из Сохраненные Цикл
		Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Возврат Настройки;

КонецФункции

// Настройки по умолчанию: сервер выключен.
// Ключи настроек:
//  schemaVersion - Число - версия структуры настроек.
//  enabled - Булево - сервер обрабатывает запросы.
//  canonicalUrl - Строка - публичный адрес MCP-эндпоинта (для ссылок и OAuth на этапе 3).
//  ibBinding - Строка - расположение ИБ (File, Srvr, Ref), к которому привязан сервер;
//    пустая строка - привязку зафиксирует первый аутентифицированный запрос.
//  allowedOrigins - Массив из Строка - разрешенные значения заголовка Origin.
//  clientIpHeader - Строка - заголовок с IP клиента, который ставит доверенный прокси.
//  maxBodyBytes - Число - максимальный размер тела запроса.
//  defaultTokenDays - Число - срок действия токена по умолчанию.
//  maxTokenDays - Число - максимальный срок действия токена.
//  listTtlMs - Число - подсказка клиенту о сроке кеширования списков.
//  instructions - Строка - дополнительный текст инструкций для модели.
//  bannedFieldPatterns - Массив из Строка - глобально запрещенные поля (п. 7.6 ТЗ).
//  bannedObjectPatterns - Массив из Строка - глобально запрещенные объекты (п. 7.6 ТЗ).
//  logArguments - Булево - записывать аргументы вызовов в журнал.
//  maxStringLength - Число - длина строковых значений в ответе, после которой они обрезаются.
//  authFailuresLimit - Число - неудачных аутентификаций с одного IP до блокировки (п. 6.5 ТЗ).
//  authFailuresWindowMinutes - Число - окно подсчета неудачных аутентификаций.
//  ipBlockMinutes - Число - срок блокировки IP.
//  maxOffset - Число - предельная глубина пагинации (строк).
//  cursorSecret - Строка - секрет подписи курсоров; не показывается администратору.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя настройки.
//   * Значение - Строка, Число, Булево, Массив из Строка - значение настройки.
//
Функция НастройкиПоУмолчанию() Экспорт

	Настройки = Новый Соответствие;
	Настройки.Вставить("schemaVersion", 2);
	Настройки.Вставить("enabled", Ложь);
	Настройки.Вставить("canonicalUrl", "");
	Настройки.Вставить("ibBinding", "");
	Настройки.Вставить("allowedOrigins", Новый Массив);
	Настройки.Вставить("clientIpHeader", "X-Real-IP");
	Настройки.Вставить("maxBodyBytes", 262144);
	Настройки.Вставить("defaultTokenDays", 30);
	Настройки.Вставить("maxTokenDays", 90);
	Настройки.Вставить("listTtlMs", 300000);
	Настройки.Вставить("instructions", "");
	Настройки.Вставить("bannedFieldPatterns", ЗапрещенныеПоляПоУмолчанию());
	Настройки.Вставить("bannedObjectPatterns", ЗапрещенныеОбъектыПоУмолчанию());
	Настройки.Вставить("logArguments", Истина);
	Настройки.Вставить("maxStringLength", 2000);
	Настройки.Вставить("authFailuresLimit", 10);
	Настройки.Вставить("authFailuresWindowMinutes", 5);
	Настройки.Вставить("ipBlockMinutes", 15);
	Настройки.Вставить("maxOffset", 10000);
	Настройки.Вставить("cursorSecret", "");
	Возврат Настройки;

КонецФункции

// Ключи настроек, которые не показываются администратору и не выгружаются.
//
// Возвращаемое значение:
//  Массив из Строка - ключи.
//
Функция СекретныеКлючи() Экспорт

	Результат = Новый Массив;
	Результат.Добавить("cursorSecret");
	Результат.Добавить("tokens"); // токены этапа 0: хеши больше не используются
	Возврат Результат;

КонецФункции

// Заполняет секрет подписи курсоров, если он не задан. Вызывается внутри транзакции
// после ЗаблокироватьИПрочитать.
//
// Параметры:
//  Настройки - см. НастройкиПоУмолчанию
//
Процедура ЗаполнитьСекретКурсоров(Настройки) Экспорт

	Если ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Настройки, "cursorSecret")) Тогда
		Настройки.Вставить("cursorSecret", mcp1c_Служебный.КодироватьBase64URL(mcp1c_Служебный.СлучайныеДанные()));
	КонецЕсли;

КонецПроцедуры

// Секрет подписи курсоров; если сервер включен до появления секрета, секрет создается.
//
// Возвращаемое значение:
//  Строка - секрет.
//
Функция СекретКурсоров() Экспорт

	Секрет = mcp1c_Служебный.СвойствоСтрока(Получить(), "cursorSecret");
	Если Не ПустаяСтрока(Секрет) Тогда
		Возврат Секрет;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Настройки = ЗаблокироватьИПрочитать();
		ЗаполнитьСекретКурсоров(Настройки);
		Записать(Настройки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат mcp1c_Служебный.СвойствоСтрока(Настройки, "cursorSecret");

КонецФункции

// Блокирует настройки и читает их. Вызывается только внутри транзакции
// перед изменением настроек.
//
// Возвращаемое значение:
//  см. НастройкиПоУмолчанию
//
Функция ЗаблокироватьИПрочитать() Экспорт

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.mcp1c_НастройкиСервера");
	ЭлементБлокировки.УстановитьЗначение("Ключ", КлючНастроек());
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не вдалося заблокувати налаштування MCP-сервера: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Получить();

КонецФункции

// Записывает настройки.
//
// Параметры:
//  Настройки - см. НастройкиПоУмолчанию
//
Процедура Записать(Настройки) Экспорт

	Запись = РегистрыСведений.mcp1c_НастройкиСервера.СоздатьМенеджерЗаписи();
	Запись.Ключ = КлючНастроек();
	Запись.Значение = mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Настройки);
	Запись.Записать(Истина);

КонецПроцедуры

// Расположение текущей ИБ для защиты от копий базы (п. 6.6 ТЗ): параметры File, Srvr и Ref
// строки соединения в нижнем регистре, без кавычек и прочих параметров.
// Вычисляется в сеансе веб-публикации: строка соединения в сеансе администратора может отличаться
// (имя сервера, порт), поэтому привязку фиксирует первый аутентифицированный MCP-запрос.
//
// Возвращаемое значение:
//  Строка - например, "srvr=app01;ref=erp".
//
Функция ПривязкаКИнформационнойБазе() Экспорт

	Значения = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(СокрЛП(Лев(Часть, Позиция - 1)));
		Значение = НРег(СокрЛП(СтрЗаменить(Сред(Часть, Позиция + 1), """", "")));
		Значения.Вставить(Ключ, Значение);
	КонецЦикла;

	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("file,srvr,ref", ",") Цикл
		Значение = Значения.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Части.Добавить(Ключ + "=" + Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ";");

КонецФункции

// Фиксирует привязку к текущей ИБ, если она еще не задана.
//
// Параметры:
//  Привязка - Строка - см. ПривязкаКИнформационнойБазе.
//
Процедура ЗафиксироватьПривязку(Привязка) Экспорт

	Зафиксирована = Ложь;
	НачатьТранзакцию();
	Попытка
		Настройки = ЗаблокироватьИПрочитать();
		Если ПустаяСтрока(mcp1c_Служебный.СвойствоСтрока(Настройки, "ibBinding")) Тогда
			Настройки.Вставить("ibBinding", Привязка);
			Записать(Настройки);
			Зафиксирована = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Зафиксирована Тогда
		mcp1c_Аудит.ЗаписатьСобытиеБезопасности("Сервер привязан к информационной базе: " + Привязка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючНастроек()

	Возврат "server";

КонецФункции

Функция ТекстНастроек()

	Отбор = Новый Структура("Ключ", КлючНастроек());
	Возврат РегистрыСведений.mcp1c_НастройкиСервера.Получить(Отбор).Значение;

КонецФункции

Функция ЗапрещенныеПоляПоУмолчанию()

	Результат = Новый Массив;
	Для Каждого Шаблон Из СтрРазделить("*Пароль*,*Password*,*Токен*,*Token*,*Secret*,*Секрет*,*ApiKey*,*ПИН*,*CVV*", ",") Цикл
		Результат.Добавить(Шаблон);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗапрещенныеОбъектыПоУмолчанию()

	Результат = Новый Массив;
	Результат.Добавить("ПланОбмена.*");
	Возврат Результат;

КонецФункции

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// mcp1c_Сеть: разбор IP-адресов (IPv4, IPv6) и проверка вхождения в подсети CIDR
// для ограничений клиента по адресу (п. 6.3, 6.5 ТЗ).
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет, входит ли адрес в один из диапазонов списка.
//
// Параметры:
//  Адрес - Строка - IP-адрес клиента.
//  Список - Строка - адреса и подсети CIDR через запятую, точку с запятой, пробел или перевод строки.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес входит хотя бы в один диапазон; некорректные элементы списка пропускаются.
//
Функция АдресВСписке(Адрес, Список) Экспорт

	РазобранныйАдрес = РазобратьАдрес(Адрес);
	Если РазобранныйАдрес = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Элемент Из ЭлементыСписка(Список) Цикл
		Диапазон = РазобратьДиапазон(Элемент);
		Если Диапазон <> Неопределено И АдресВДиапазоне(РазобранныйАдрес, Диапазон) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Проверяет, что каждый элемент списка - корректный адрес или подсеть CIDR.
//
// Параметры:
//  Список - Строка - адреса и подсети.
//
// Возвращаемое значение:
//  Массив из Строка - некорректные элементы.
//
Функция НекорректныеЭлементыСписка(Список) Экспорт

	Результат = Новый Массив;
	Для Каждого Элемент Из ЭлементыСписка(Список) Цикл
		Если РазобратьДиапазон(Элемент) = Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Элементы списка, разделенные запятой, точкой с запятой, пробелом, табуляцией или переводом строки.
//
// Параметры:
//  Список - Строка - исходный текст.
//
// Возвращаемое значение:
//  Массив из Строка - непустые элементы без пробелов по краям.
//
Функция ЭлементыСписка(Список) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(Список) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;

	Текст = Список;
	Для Каждого Разделитель Из РазделителиСписка() Цикл
		Текст = СтрЗаменить(Текст, Разделитель, " ");
	КонецЦикла;
	Для Каждого Часть Из СтрРазделить(Текст, " ", Ложь) Цикл
		Значение = СокрЛП(Часть);
		Если Не ПустаяСтрока(Значение) Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Разбирает IP-адрес. IPv4, отображенный в IPv6 (::ffff:a.b.c.d), приводится к IPv4.
//
// Параметры:
//  Текст - Строка - адрес, например "10.0.0.1", "2001:db8::1", "[::1]".
//
// Возвращаемое значение:
//  - Неопределено - если адрес некорректен.
//  - Структура:
//   * Версия - Число - 4 или 6.
//   * Байты - Массив из Число - 4 или 16 байтов адреса.
//
Функция РазобратьАдрес(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = СокрЛП(Текст);
	Если СтрНачинаетсяС(Текст, "[") И СтрЗаканчиваетсяНа(Текст, "]") Тогда
		Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
	КонецЕсли;
	ПозицияЗоны = СтрНайти(Текст, "%");
	Если ПозицияЗоны > 0 Тогда
		Текст = Лев(Текст, ПозицияЗоны - 1);
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если СтрНайти(Текст, ":") = 0 Тогда
		Байты = БайтыIPv4(Текст);
		Возврат ?(Байты = Неопределено, Неопределено, НовыйАдрес(4, Байты));
	КонецЕсли;

	Байты = БайтыIPv6(Текст);
	Если Байты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоОтображенныйIPv4(Байты) Тогда
		Возврат НовыйАдрес(4, ПоследниеБайты(Байты, 4));
	КонецЕсли;
	Возврат НовыйАдрес(6, Байты);

КонецФункции

// Разбирает адрес или подсеть CIDR.
//
// Параметры:
//  Текст - Строка - например "10.0.0.0/8", "2001:db8::/32", "192.168.1.10".
//
// Возвращаемое значение:
//  - Неопределено - если запись некорректна.
//  - Структура:
//   * Версия - Число - 4 или 6.
//   * Байты - Массив из Число - байты адреса подсети.
//   * ДлинаПрефикса - Число - число значащих битов.
//
Функция РазобратьДиапазон(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = СокрЛП(Текст);
	ДлинаПрефикса = Неопределено;
	ПозицияКосой = СтрНайти(Текст, "/");
	Если ПозицияКосой > 0 Тогда
		ДлинаПрефикса = ЧислоИзЦифр(Сред(Текст, ПозицияКосой + 1), 3);
		Если ДлинаПрефикса = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Текст = Лев(Текст, ПозицияКосой - 1);
	КонецЕсли;

	ЭтоЗаписьIPv6 = СтрНайти(Текст, ":") > 0;
	Адрес = РазобратьАдрес(Текст);
	Если Адрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ДлинаПрефикса = Неопределено Тогда
		ДлинаПрефикса = Адрес.Байты.Количество() * 8;
	ИначеЕсли ЭтоЗаписьIPv6 И Адрес.Версия = 4 Тогда
		// Подсеть отображенных адресов ::ffff:a.b.c.d/N: первые 96 битов фиксированы.
		ДлинаПрефикса = ДлинаПрефикса - 96;
		Если ДлинаПрефикса < 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если ДлинаПрефикса > Адрес.Байты.Количество() * 8 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Версия", Адрес.Версия);
	Результат.Вставить("Байты", ПоследниеБайты(Адрес.Байты, Адрес.Байты.Количество()));
	Результат.Вставить("ДлинаПрефикса", ДлинаПрефикса);
	Возврат Результат;

КонецФункции

// Проверяет вхождение разобранного адреса в подсеть.
//
// Параметры:
//  Адрес - см. РазобратьАдрес
//  Диапазон - см. РазобратьДиапазон
//
// Возвращаемое значение:
//  Булево - Истина, если адрес входит в подсеть.
//
Функция АдресВДиапазоне(Адрес, Диапазон) Экспорт

	Если Адрес.Версия <> Диапазон.Версия Тогда
		Возврат Ложь;
	КонецЕсли;

	ПолныхБайтов = Цел(Диапазон.ДлинаПрефикса / 8);
	Для Индекс = 0 По ПолныхБайтов - 1 Цикл
		Если Адрес.Байты[Индекс] <> Диапазон.Байты[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	ОстатокБитов = Диапазон.ДлинаПрефикса % 8;
	Если ОстатокБитов = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Делитель = СтепеньДвойки(8 - ОстатокБитов);
	Возврат Цел(Адрес.Байты[ПолныхБайтов] / Делитель) = Цел(Диапазон.Байты[ПолныхБайтов] / Делитель);

КонецФункции

// Нормализованное представление адреса: IPv4 - в точечной записи, IPv6 - восемь групп в нижнем регистре.
//
// Параметры:
//  Текст - Строка - адрес.
//
// Возвращаемое значение:
//  Строка - нормализованный адрес; пустая строка, если адрес некорректен.
//
Функция НормализоватьАдрес(Текст) Экспорт

	Адрес = РазобратьАдрес(Текст);
	Если Адрес = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Если Адрес.Версия = 4 Тогда
		Для Каждого Байт Из Адрес.Байты Цикл
			Части.Добавить(Формат(Байт, "ЧН=0; ЧГ=0"));
		КонецЦикла;
		Возврат СтрСоединить(Части, ".");
	КонецЕсли;

	Для Индекс = 0 По 7 Цикл
		Группа = Адрес.Байты[Индекс * 2] * 256 + Адрес.Байты[Индекс * 2 + 1];
		Части.Добавить(ЧислоВHex(Группа));
	КонецЦикла;
	Возврат СтрСоединить(Части, ":");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйАдрес(Версия, Байты)

	Результат = Новый Структура;
	Результат.Вставить("Версия", Версия);
	Результат.Вставить("Байты", Байты);
	Возврат Результат;

КонецФункции

Функция РазделителиСписка()

	Результат = Новый Массив;
	Результат.Добавить(Символы.ВК);
	Результат.Добавить(Символы.ПС);
	Результат.Добавить(Символы.Таб);
	Результат.Добавить(";");
	Результат.Добавить(",");
	Возврат Результат;

КонецФункции

Функция БайтыIPv4(Текст)

	Части = СтрРазделить(Текст, ".", Истина);
	Если Части.Количество() <> 4 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Байты = Новый Массив;
	Для Каждого Часть Из Части Цикл
		// Ведущие нули запрещены: "010" в разных системах читается по-разному.
		Если СтрДлина(Часть) > 1 И Лев(Часть, 1) = "0" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значение = ЧислоИзЦифр(Часть, 3);
		Если Значение = Неопределено Или Значение > 255 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Байты.Добавить(Значение);
	КонецЦикла;
	Возврат Байты;

КонецФункции

Функция БайтыIPv6(Текст)

	// Встроенный IPv4 в последних 32 битах: ::ffff:192.0.2.1, 64:ff9b::192.0.2.1.
	ХвостIPv4 = Неопределено;
	ПозицияПоследнегоДвоеточия = ПозицияПоследнегоСимвола(Текст, ":");
	Если СтрНайти(Сред(Текст, ПозицияПоследнегоДвоеточия + 1), ".") > 0 Тогда
		ХвостIPv4 = БайтыIPv4(Сред(Текст, ПозицияПоследнегоДвоеточия + 1));
		Если ХвостIPv4 = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Текст = Лев(Текст, ПозицияПоследнегоДвоеточия) + "0:0";
	КонецЕсли;

	Группы = ГруппыIPv6(Текст);
	Если Группы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Байты = Новый Массив;
	Для Каждого Группа Из Группы Цикл
		Байты.Добавить(Цел(Группа / 256));
		Байты.Добавить(Группа % 256);
	КонецЦикла;
	Если ХвостIPv4 <> Неопределено Тогда
		Для Индекс = 0 По 3 Цикл
			Байты[12 + Индекс] = ХвостIPv4[Индекс];
		КонецЦикла;
	КонецЕсли;
	Возврат Байты;

КонецФункции

Функция ГруппыIPv6(Текст)
	// Восемь 16-битных групп адреса IPv6 с раскрытым сокращением "::".

	ЧислоСокращений = СтрЧислоВхождений(Текст, "::");
	Если ЧислоСокращений > 1 Или СтрНайти(Текст, ":::") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЧислоСокращений = 0 Тогда
		Группы = ЗначенияГруппIPv6(Текст);
		Если Группы = Неопределено Или Группы.Количество() <> 8 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Группы;
	КонецЕсли;

	Позиция = СтрНайти(Текст, "::");
	Начало = ЗначенияГруппIPv6(Лев(Текст, Позиция - 1));
	Конец = ЗначенияГруппIPv6(Сред(Текст, Позиция + 2));
	Если Начало = Неопределено Или Конец = Неопределено
		Или Начало.Количество() + Конец.Количество() > 7 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Группы = Новый Массив;
	Для Каждого Группа Из Начало Цикл
		Группы.Добавить(Группа);
	КонецЦикла;
	Пока Группы.Количество() < 8 - Конец.Количество() Цикл
		Группы.Добавить(0);
	КонецЦикла;
	Для Каждого Группа Из Конец Цикл
		Группы.Добавить(Группа);
	КонецЦикла;
	Возврат Группы;

КонецФункции

Функция ЗначенияГруппIPv6(Текст)
	// Значения групп, разделенных двоеточием; пустая строка - ни одной группы.

	Результат = Новый Массив;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Текст, ":", Истина) Цикл
		Значение = ЧислоИзHex(Часть, 4);
		Если Значение = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтоОтображенныйIPv4(Байты)

	Для Индекс = 0 По 9 Цикл
		Если Байты[Индекс] <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Байты[10] = 255 И Байты[11] = 255;

КонецФункции

Функция ПоследниеБайты(Байты, Количество)

	Результат = Новый Массив;
	Для Индекс = Байты.Количество() - Количество По Байты.Количество() - 1 Цикл
		Результат.Добавить(Байты[Индекс]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЧислоИзЦифр(Текст, МаксимумЦифр)
	// Неотрицательное целое из десятичных цифр (не более МаксимумЦифр); иначе Неопределено.

	Если СтрДлина(Текст) = 0 Или СтрДлина(Текст) > МаксимумЦифр Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Цифра = СтрНайти("0123456789", Сред(Текст, Позиция, 1)) - 1;
		Если Цифра < 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значение = Значение * 10 + Цифра;
	КонецЦикла;
	Возврат Значение;

КонецФункции

Функция ЧислоИзHex(Текст, МаксимумЦифр)
	// Неотрицательное целое из шестнадцатеричных цифр (не более МаксимумЦифр); иначе Неопределено.

	Если СтрДлина(Текст) = 0 Или СтрДлина(Текст) > МаксимумЦифр Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Цифра = СтрНайти("0123456789abcdef", НРег(Сред(Текст, Позиция, 1))) - 1;
		Если Цифра < 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значение = Значение * 16 + Цифра;
	КонецЦикла;
	Возврат Значение;

КонецФункции

Функция ЧислоВHex(Знач Значение)

	Если Значение = 0 Тогда
		Возврат "0";
	КонецЕсли;
	Результат = "";
	Пока Значение > 0 Цикл
		Результат = Сред("0123456789abcdef", Значение % 16 + 1, 1) + Результат;
		Значение = Цел(Значение / 16);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПозицияПоследнегоСимвола(Текст, Символ)

	Позиция = СтрДлина(Текст);
	Пока Позиция > 0 Цикл
		Если Сред(Текст, Позиция, 1) = Символ Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция СтепеньДвойки(Показатель)

	Результат = 1;
	Осталось = Показатель;
	Пока Осталось > 0 Цикл
		Результат = Результат * 2;
		Осталось = Осталось - 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

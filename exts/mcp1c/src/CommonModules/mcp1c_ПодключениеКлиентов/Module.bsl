///////////////////////////////////////////////////////////////////////////////
// mcp1c_ПодключениеКлиентов: фрагменты подключения MCP-клиентов, которые показываются при выпуске
// токена (п. 9.3 ТЗ). Шаблоны задаются в настройках сервера (connectionTemplates), чтобы обновлять
// синтаксис клиентов без изменения кода; без настроек действуют шаблоны по умолчанию.
//
// Подстановки в тексте шаблона: {url} - публичный адрес сервера, {token} - токен, {header} - заголовок
// токена, {allow_http} - аргумент «"--allow-http", » для mcp-remote, если адрес начинается с http://.
// Публикация 1С без прокси (адрес с /hs/) забирает заголовок Authorization себе, поэтому для нее
// {header} - X-MCP-Authorization; за прокси - Authorization.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Фрагменты подключения клиентов с токеном.
//
// Параметры:
//  Шаблоны - Массив из Произвольный - шаблоны из настроек (Соответствие или Структура с ключами title и text);
//            пустой массив - шаблоны по умолчанию (см. ШаблоныПоУмолчанию).
//  Токен - Строка - значение токена.
//  Адрес - Строка - публичный адрес MCP-эндпоинта; пустая строка - заглушка.
//
// Возвращаемое значение:
//  Строка - фрагменты: заголовок шаблона, текст и пустая строка между фрагментами.
//
Функция ФрагментыПодключения(Шаблоны, Токен, Знач Адрес) Экспорт

	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "https://<адреса-сервера>/mcp";
	КонецЕсли;
	Подстановки = Новый Соответствие;
	Подстановки.Вставить("{url}", Адрес);
	Подстановки.Вставить("{token}", Токен);
	Подстановки.Вставить("{header}", ЗаголовокТокена(Адрес));
	Подстановки.Вставить("{allow_http}", ?(СтрНачинаетсяС(НРег(Адрес), "http://"), """--allow-http"", ", ""));

	Части = Новый Массив;
	Для Каждого Шаблон Из ?(Шаблоны.Количество() = 0, ШаблоныПоУмолчанию(), Шаблоны) Цикл
		Текст = Строка(Шаблон["text"]);
		Для Каждого Подстановка Из Подстановки Цикл
			Текст = СтрЗаменить(Текст, Подстановка.Ключ, Подстановка.Значение);
		КонецЦикла;
		Части.Добавить(Строка(Шаблон["title"]) + ":" + Символы.ПС + Текст);
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

// Заголовок, в котором клиент передает токен: публикация 1С без прокси (адрес с /hs/) забирает
// Authorization себе, поэтому токен идет в X-MCP-Authorization.
//
// Параметры:
//  Адрес - Строка - публичный адрес MCP-эндпоинта.
//
// Возвращаемое значение:
//  Строка - Authorization или X-MCP-Authorization.
//
Функция ЗаголовокТокена(Адрес) Экспорт

	Возврат ?(СтрНайти(НРег(Адрес), "/hs/") > 0, "X-MCP-Authorization", "Authorization");

КонецФункции

// Шаблоны по умолчанию: Claude Code, Cursor и клиенты только со stdio через mcp-remote (Claude Desktop).
//
// Возвращаемое значение:
//  Массив из Соответствие - шаблоны с ключами title и text.
//
Функция ШаблоныПоУмолчанию() Экспорт

	Результат = Новый Массив;
	Результат.Добавить(НовыйШаблон("Claude Code",
		"claude mcp add --transport http onec {url} --header ""{header}: Bearer {token}"""));
	Результат.Добавить(НовыйШаблон("Cursor (~/.cursor/mcp.json)",
		"{""mcpServers"": {""onec"": {""url"": ""{url}"", ""headers"": {""{header}"": ""Bearer {token}""}}}}"));
	Результат.Добавить(НовыйШаблон("Claude Desktop та інші клієнти лише зі stdio (через mcp-remote)",
		"{""mcpServers"": {""onec"": {""command"": ""npx"", ""args"": [""-y"", ""mcp-remote"", ""{url}"", {allow_http}"
		+ """--header"", ""{header}:${MCP1C_AUTH}""], ""env"": {""MCP1C_AUTH"": ""Bearer {token}""}}}}"));
	Возврат Результат;

КонецФункции

// Ошибки шаблонов подключения перед записью в настройки.
//
// Параметры:
//  Шаблоны - Массив из Произвольный - шаблоны (Соответствие или Структура с ключами title и text).
//
// Возвращаемое значение:
//  Массив из Строка - описания ошибок; пустой массив - шаблоны корректны.
//
Функция ОшибкиШаблонов(Шаблоны) Экспорт

	Ошибки = Новый Массив;
	Номер = 0;
	Для Каждого Шаблон Из Шаблоны Цикл
		Номер = Номер + 1;
		Если ТипЗнч(Шаблон) <> Тип("Соответствие") И ТипЗнч(Шаблон) <> Тип("Структура") Тогда
			Ошибки.Добавить(СтрШаблон("Шаблон %1: очікується об'єкт з полями title і text", Номер));
			Продолжить;
		КонецЕсли;
		Для Каждого Ключ Из СтрРазделить("title,text", ",") Цикл
			Значение = Неопределено;
			Если ТипЗнч(Шаблон) = Тип("Структура") Тогда
				Шаблон.Свойство(Ключ, Значение);
			Иначе
				Значение = Шаблон.Получить(Ключ);
			КонецЕсли;
			Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
				Ошибки.Добавить(СтрШаблон("Шаблон %1: не заповнено %2", Номер, Ключ));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйШаблон(Заголовок, Текст)

	Шаблон = Новый Соответствие;
	Шаблон.Вставить("title", Заголовок);
	Шаблон.Вставить("text", Текст);
	Возврат Шаблон;

КонецФункции

#КонецОбласти

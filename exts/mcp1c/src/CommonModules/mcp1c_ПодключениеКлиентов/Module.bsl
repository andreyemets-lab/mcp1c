///////////////////////////////////////////////////////////////////////////////
// mcp1c_ПодключениеКлиентов: фрагменты подключения MCP-клиентов, которые показываются при выпуске
// токена (п. 9.3 ТЗ). Шаблоны задаются в настройках сервера (connectionTemplates), чтобы обновлять
// синтаксис клиентов без изменения кода; без настроек действуют шаблоны по умолчанию.
//
// Подстановки в тексте шаблона: {url} - публичный адрес сервера, {token} - токен, {header} - заголовок
// токена, {allow_http} - аргумент «"--allow-http", » для mcp-remote, если адрес начинается с http://.
// Публикация 1С без прокси (адрес с /hs/) забирает заголовок Authorization себе, поэтому для нее
// {header} - X-MCP-Authorization; за прокси - Authorization.
// Чистая логика без обращений к данным; покрыта тестами OneScript (tests/unit).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Фрагменты подключения клиентов с токеном.
//
// Параметры:
//  Шаблоны - Массив из Произвольный - шаблоны из настроек (Соответствие или Структура с ключами title и text);
//            пустой массив - шаблоны по умолчанию (см. ШаблоныПоУмолчанию).
//  Токен - Строка - значение токена.
//  Адрес - Строка - публичный адрес MCP-эндпоинта; пустая строка - заглушка.
//
// Возвращаемое значение:
//  Строка - фрагменты: заголовок шаблона, текст и пустая строка между фрагментами.
//
Функция ФрагментыПодключения(Шаблоны, Токен, Знач Адрес) Экспорт

	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "https://<адреса-сервера>/mcp";
	КонецЕсли;
	Подстановки = Новый Соответствие;
	Подстановки.Вставить("{url}", Адрес);
	Подстановки.Вставить("{token}", Токен);
	Подстановки.Вставить("{header}", ЗаголовокТокена(Адрес));
	Подстановки.Вставить("{allow_http}", ?(СтрНачинаетсяС(НРег(Адрес), "http://"), """--allow-http"", ", ""));

	Части = Новый Массив;
	Для Каждого Шаблон Из ?(Шаблоны.Количество() = 0, ШаблоныПоУмолчанию(), Шаблоны) Цикл
		Текст = Строка(Шаблон["text"]);
		Для Каждого Подстановка Из Подстановки Цикл
			Текст = СтрЗаменить(Текст, Подстановка.Ключ, Подстановка.Значение);
		КонецЦикла;
		Части.Добавить(Строка(Шаблон["title"]) + ":" + Символы.ПС + Текст);
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

// Заголовок, в котором клиент передает токен: публикация 1С без прокси (адрес с /hs/) забирает
// Authorization себе, поэтому токен идет в X-MCP-Authorization.
//
// Параметры:
//  Адрес - Строка - публичный адрес MCP-эндпоинта.
//
// Возвращаемое значение:
//  Строка - Authorization или X-MCP-Authorization.
//
Функция ЗаголовокТокена(Адрес) Экспорт

	Возврат ?(СтрНайти(НРег(Адрес), "/hs/") > 0, "X-MCP-Authorization", "Authorization");

КонецФункции

// Шаблоны по умолчанию: Claude Code, Cursor и клиенты только со stdio через mcp-remote (Claude Desktop).
//
// Возвращаемое значение:
//  Массив из Произвольный - шаблоны (Соответствие) с ключами title и text.
//
Функция ШаблоныПоУмолчанию() Экспорт

	Результат = Новый Массив;
	Результат.Добавить(НовыйШаблон("Claude Code",
		"claude mcp add --transport http onec {url} --header ""{header}: Bearer {token}"""));
	Результат.Добавить(НовыйШаблон("Cursor (~/.cursor/mcp.json)",
		"{""mcpServers"": {""onec"": {""url"": ""{url}"", ""headers"": {""{header}"": ""Bearer {token}""}}}}"));
	Результат.Добавить(НовыйШаблон("Claude Desktop та інші клієнти лише зі stdio (через mcp-remote)",
		"{""mcpServers"": {""onec"": {""command"": ""npx"", ""args"": [""-y"", ""mcp-remote"", ""{url}"", {allow_http}"
		+ """--header"", ""{header}:${MCP1C_AUTH}""], ""env"": {""MCP1C_AUTH"": ""Bearer {token}""}}}}"));
	Возврат Результат;

КонецФункции

// Ошибки шаблонов подключения перед записью в настройки.
//
// Параметры:
//  Шаблоны - Массив из Произвольный - шаблоны (Соответствие или Структура с ключами title и text).
//
// Возвращаемое значение:
//  Массив из Строка - описания ошибок; пустой массив - шаблоны корректны.
//
Функция ОшибкиШаблонов(Шаблоны) Экспорт

	Ошибки = Новый Массив;
	Номер = 0;
	Для Каждого Шаблон Из Шаблоны Цикл
		Номер = Номер + 1;
		Если ТипЗнч(Шаблон) <> Тип("Соответствие") И ТипЗнч(Шаблон) <> Тип("Структура") Тогда
			Ошибки.Добавить(СтрШаблон("Шаблон %1: очікується об'єкт з полями title і text", Номер));
			Продолжить;
		КонецЕсли;
		Для Каждого Ключ Из СтрРазделить("title,text", ",") Цикл
			Значение = Неопределено;
			Если ТипЗнч(Шаблон) = Тип("Структура") Тогда
				Шаблон.Свойство(Ключ, Значение);
			Иначе
				Значение = Шаблон.Получить(Ключ);
			КонецЕсли;
			Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
				Ошибки.Добавить(СтрШаблон("Шаблон %1: не заповнено %2", Номер, Ключ));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

// Части адреса MCP-эндпоинта для проверки публикации (мастер настройки, п. 9.2 ТЗ).
//
// Параметры:
//  Адрес - Строка - адрес вида http(s)://хост[:порт]/путь.
//
// Возвращаемое значение:
//  - Неопределено - адрес не http и не https или без хоста.
//  - Структура:
//   * Защищенное - Булево - https.
//   * Хост - Строка - имя хоста или IP-адрес (IPv6 - без квадратных скобок).
//   * Порт - Число - порт; без порта в адресе - 443 для https и 80 для http.
//   * Путь - Строка - путь с запросом, начинается с /.
//
Функция РазобратьАдрес(Знач Адрес) Экспорт

	Адрес = СокрЛП(Адрес);
	Разделитель = СтрНайти(Адрес, "://");
	Схема = ?(Разделитель > 1, НРег(Лев(Адрес, Разделитель - 1)), "");
	Если Схема <> "http" И Схема <> "https" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(Адрес, СтрДлина(Схема) + 4);
	Позиция = СтрНайти(Остаток, "/");
	Узел = РазобратьУзел(?(Позиция = 0, Остаток, Лев(Остаток, Позиция - 1)), ?(Схема = "https", 443, 80));
	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Защищенное", Схема = "https");
	Результат.Вставить("Хост", Узел.Хост);
	Результат.Вставить("Порт", Узел.Порт);
	Результат.Вставить("Путь", ?(Позиция = 0, "/", Сред(Остаток, Позиция)));
	Возврат Результат;

КонецФункции

// Итог проверки публикации по ответу на запрос без токена (мастер настройки): сервер MCP отвечает 401
// с заголовком WWW-Authenticate «Bearer realm="mcp1c"».
//
// Параметры:
//  КодСостояния - Число - код HTTP-ответа.
//  ВызовАутентификации - Строка - значение заголовка WWW-Authenticate; пустая строка - заголовка нет.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - адрес отвечает как сервер MCP.
//   * Текст - Строка - пояснение для администратора.
//
Функция ИтогПроверкиАдреса(КодСостояния, ВызовАутентификации) Экспорт

	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Вызов = НРег(ВызовАутентификации);
	Если КодСостояния = 401 И СтрНайти(Вызов, "realm=""mcp1c""") > 0 Тогда
		Итог.Успех = Истина;
		Итог.Текст = "Адреса відповідає: сервер MCP вимагає токен (401). Клієнти підключаються за нею.";
	ИначеЕсли КодСостояния = 401 И СтрНачинаетсяС(Вызов, "basic") Тогда
		Итог.Текст = "Адреса вимагає автентифікації 1С (Basic, 401): запит не дійшов до сервера MCP. Для клієнтів "
			+ "публікація має входити технічним користувачем, заданим у публікації чи проксі (README, «Публікація»).";
	ИначеЕсли КодСостояния = 503 Тогда
		Итог.Текст = "Сервер MCP вимкнено або базу перенесено (503): увімкніть сервер чи підтвердьте перенесення "
			+ "на робочому місці.";
	ИначеЕсли КодСостояния = 404 Тогда
		Итог.Текст = "Адресу не знайдено (404): шлях публікації HTTP-сервісу закінчується на /hs/mcp1c, проксі має "
			+ "передавати запити саме на нього.";
	ИначеЕсли КодСостояния >= 200 И КодСостояния < 300 Тогда
		Итог.Текст = СтрШаблон("Адреса відповіла без токена (%1): перевірте, що вона веде на сервер MCP, а не на "
			+ "інший сервіс.", КодСостояния);
	Иначе
		Итог.Текст = СтрШаблон("Неочікувана відповідь %1: сервер MCP на запит без токена відповідає 401.",
			КодСостояния);
	КонецЕсли;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Хост и порт из части адреса между схемой и путем.
//
// Параметры:
//  Узел - Строка - хост[:порт] или [IPv6-адрес][:порт].
//  ПортПоУмолчанию - Число - порт схемы.
//
// Возвращаемое значение:
//  - Неопределено - хост пустой или порт некорректен.
//  - Структура:
//   * Хост - Строка - имя хоста или IP-адрес без квадратных скобок.
//   * Порт - Число - порт.
//
Функция РазобратьУзел(Узел, ПортПоУмолчанию)

	Если СтрНачинаетсяС(Узел, "[") Тогда
		Конец = СтрНайти(Узел, "]");
		Если Конец = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Хост = Сред(Узел, 2, Конец - 2);
		ТекстПорта = Сред(Узел, Конец + 2);
	Иначе
		Двоеточие = СтрНайти(Узел, ":");
		Хост = ?(Двоеточие = 0, Узел, Лев(Узел, Двоеточие - 1));
		ТекстПорта = ?(Двоеточие = 0, "", Сред(Узел, Двоеточие + 1));
	КонецЕсли;
	Порт = ПортПоУмолчанию;
	Если Не ПустаяСтрока(ТекстПорта) Тогда
		Если СтрДлина(ТекстПорта) > 5 Или Не СтрокаИзЦифр(ТекстПорта) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Порт = Число(ТекстПорта);
	КонецЕсли;
	Если ПустаяСтрока(Хост) Или Порт = 0 Или Порт > 65535 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Хост, Порт", Хост, Порт);

КонецФункции

Функция СтрокаИзЦифр(Текст)
	// Только цифры 0-9.

	Для Номер = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Номер, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция НовыйШаблон(Заголовок, Текст)

	Шаблон = Новый Соответствие;
	Шаблон.Вставить("title", Заголовок);
	Шаблон.Вставить("text", Текст);
	Возврат Шаблон;

КонецФункции

#КонецОбласти

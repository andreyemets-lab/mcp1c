#Область Результат

// Непустые строки табличного документа, начиная со строки НомерСтроки: тексты ячеек без пустых в конце.
//
// Параметры:
//  Документ - ТабличныйДокумент - результат отчета.
//  НомерСтроки - Число - первая строка страницы.
//  Лимит - Число - сколько непустых строк вернуть.
//
// Возвращаемое значение:
//  Структура:
//   * Строки - Массив из Произвольный - строки: массивы текстов ячеек.
//   * Следующая - Число - номер следующей непустой строки; 0 - строк больше нет.
//   * ОбрезаноКолонок - Число - сколько колонок справа не показано.
//
Функция СтрокиДокумента(Документ, Знач НомерСтроки, Лимит)

	Результат = Новый Структура("Строки, Следующая, ОбрезаноКолонок", Новый Массив, 0, 0);
	Ширина = Мин(Документ.ШиринаТаблицы, МаксимумКолонок());
	Результат.ОбрезаноКолонок = Документ.ШиринаТаблицы - Ширина;
	Высота = Документ.ВысотаТаблицы;
	Пока НомерСтроки <= Высота Цикл
		Ячейки = ЯчейкиСтроки(Документ, НомерСтроки, Ширина);
		Если Ячейки.Количество() > 0 Тогда
			Если Результат.Строки.Количество() >= Лимит Тогда
				Результат.Следующая = НомерСтроки;
				Возврат Результат;
			КонецЕсли;
			Результат.Строки.Добавить(Ячейки);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЯчейкиСтроки(Документ, НомерСтроки, Ширина)
	// Тексты ячеек строки слева направо без пустых в конце; пустой массив - строка пустая. Область ячейки
	// внутри объединения - все объединение: его текст берется только в левой верхней ячейке.

	Ячейки = Новый Массив;
	Заполнено = 0;
	Для НомерКолонки = 1 По Ширина Цикл
		ОбластьЯчейки = Документ.Область(НомерСтроки, НомерКолонки);
		Текст = "";
		Если ОбластьЯчейки.Лево = НомерКолонки И ОбластьЯчейки.Верх = НомерСтроки Тогда
			Текст = СокрЛП(mcp1c_Сериализация.ОчищенныйТекст(ОбластьЯчейки.Текст, 500));
		КонецЕсли;
		Ячейки.Добавить(Текст);
		Если Не ПустаяСтрока(Текст) Тогда
			Заполнено = НомерКолонки;
		КонецЕсли;
	КонецЦикла;
	Пока Ячейки.Количество() > Заполнено Цикл
		Ячейки.Удалить(Ячейки.ВГраница());
	КонецЦикла;
	Возврат Ячейки;

КонецФункции

Функция МаксимумКолонок()

	Возврат 60;

КонецФункции

#КонецОбласти

#Область Прочее

Функция ОшибкаКомпоновки(Информация, ПолноеИмя, Контекст)
	// Ошибка компоновки или вывода отчета: подробности - в журнал вызовов, кратко - модели.

	Контекст.ТекстОшибки = ПодробноеПредставлениеОшибки(Информация);
	Возврат ИтогОшибка(СтрШаблон("Помилка формування звіту %1 (звіт виконується за схемою, без модуля звіту): %2",
		ПолноеИмя, Лев(СокрЛП(КраткоеПредставлениеОшибки(Информация)), 500)));

КонецФункции

Процедура ДобавитьОбъектВКонтекст(Контекст, Имя)

	Если Контекст.Объекты.Найти(Имя) = Неопределено Тогда
		Контекст.Объекты.Добавить(Имя);
	КонецЕсли;

КонецПроцедуры

Функция КурсорИзСмещения(Смещение)

	Возврат mcp1c_Служебный.КодироватьСтрокуBase64URL("list_reports:" + Формат(Смещение, "ЧН=0; ЧГ=0"));

КонецФункции

Функция СмещениеИзКурсора(Курсор)

	Текст = mcp1c_Служебный.ДекодироватьСтрокуBase64URL(Курсор);
	Префикс = "list_reports:";
	Если Текст = Неопределено Или Не СтрНачинаетсяС(Текст, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цифры = Сред(Текст, СтрДлина(Префикс) + 1);
	Если ПустаяСтрока(Цифры) Или СтрДлина(Цифры) > 9 Или Не mcp1c_Служебный.СостоитИзСимволов(Цифры, "0123456789") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

Функция ИтогУспех(Данные)

	Возврат Новый Структура("Данные, Ошибка", Данные, "");

КонецФункции

Функция ИтогОшибка(ТекстОшибки)

	Возврат Новый Структура("Данные, Ошибка", Неопределено, ТекстОшибки);

КонецФункции


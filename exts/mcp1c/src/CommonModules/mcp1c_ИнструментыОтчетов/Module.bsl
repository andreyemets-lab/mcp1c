///////////////////////////////////////////////////////////////////////////////
// mcp1c_ИнструментыОтчетов: отчеты на СКД - list_reports, describe_report, run_report
// (п. 5.2 ТЗ, этап 3).
//
// Отчет доступен клиенту, если профиль включает инструменты отчетов и разрешает сам отчет правилом
// «Отчет.<Имя>» или шаблоном «Отчет.*» в режиме чтения: правило «*» отчеты не открывает
// (см. mcp1c_ПравилаДоступа.ОтчетДоступен). У отчета должна быть основная схема компоновки данных,
// все наборы данных схемы - запросы, а их таблицы профиль должен давать читать без ограничений строк
// и обязательного отбора по периоду. Имена из глобальных запретов полей в запросах и вычисляемых
// полях схемы - отказ.
// Отчет выполняется по схеме и варианту настроек схемы с параметрами модели, без модуля отчета;
// внешние функции в выражениях схемы запрещены. Результат - текст ячеек табличного документа
// по строкам, страницы - по курсору (отчет формируется заново для каждой страницы).
// Правила полей и маски профиля к выводу отчета не применяются: отчет показывает все, что выводит
// его вариант.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// list_reports: отчеты на СКД, которые профиль разрешает клиенту.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция СписокОтчетов(Аргументы, Контекст) Экспорт

	СтрокаПоиска = НРег(СокрЛП(mcp1c_Служебный.СвойствоСтрока(Аргументы, "search")));
	Лимит = mcp1c_Служебный.СвойствоЧисло(Аргументы, "limit", 50);
	Смещение = 0;
	Курсор = mcp1c_Служебный.СвойствоСтрока(Аргументы, "cursor");
	Если Не ПустаяСтрока(Курсор) Тогда
		Смещение = СмещениеИзКурсора(Курсор);
		Если Смещение = Неопределено Тогда
			Возврат ИтогОшибка("Курсор недійсний: повторіть запит без cursor");
		КонецЕсли;
	КонецЕсли;

	Найденные = Новый Массив;
	Для Каждого ОтчетМД Из Метаданные.Отчеты Цикл
		Если СтрНачинаетсяС(НРег(ОтчетМД.Имя), "mcp1c_") Или ОтчетМД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОтчетМД);
		Если Не mcp1c_ПравилаДоступа.ОтчетДоступен(Контекст.Политика, ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Синоним = mcp1c_Метаданные.СинонимОбъекта(ОтчетМД);
		Если Не ПустаяСтрока(СтрокаПоиска) И СтрНайти(НРег(ОтчетМД.Имя), СтрокаПоиска) = 0
			И СтрНайти(НРег(Синоним), СтрокаПоиска) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Соответствие;
		Элемент.Вставить("report", ПолноеИмя);
		Элемент.Вставить("synonym", Синоним);
		Найденные.Добавить(Элемент);
	КонецЦикла;

	Элементы = Новый Массив;
	Последний = Мин(Смещение + Лимит, Найденные.Количество()) - 1;
	Для Индекс = Смещение По Последний Цикл
		Элементы.Добавить(Найденные[Индекс]);
	КонецЦикла;
	Данные = Новый Соответствие;
	Данные.Вставить("items", Элементы);
	Данные.Вставить("total", Найденные.Количество());
	Данные.Вставить("returned", Элементы.Количество());
	Если Смещение + Лимит < Найденные.Количество() Тогда
		Данные.Вставить("next_cursor", КурсорИзСмещения(Смещение + Лимит));
	КонецЕсли;
	Если Найденные.Количество() = 0 И ПустаяСтрока(СтрокаПоиска) Тогда
		Примечания = Новый Массив;
		Примечания.Добавить("Профіль не відкриває жодного звіту на СКД: звіти дозволяються правилом «Отчет.<Ім'я>» "
			+ "або «Отчет.*».");
		Данные.Вставить("notes", Примечания);
	КонецЕсли;
	Возврат ИтогУспех(Данные);

КонецФункции

// describe_report: варианты настроек и параметры отчета.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ОписаниеОтчета(Аргументы, Контекст) Экспорт

	Отчет = ОтчетКлиента(mcp1c_Служебный.СвойствоСтрока(Аргументы, "report"), Контекст);
	Если Не ПустаяСтрока(Отчет.Ошибка) Тогда
		Возврат ИтогОшибка(Отчет.Ошибка);
	КонецЕсли;
	Вариант = ВариантНастроек(Отчет.Схема, mcp1c_Служебный.СвойствоСтрока(Аргументы, "variant"));
	Если Не ПустаяСтрока(Вариант.Ошибка) Тогда
		Возврат ИтогОшибка(Вариант.Ошибка);
	КонецЕсли;
	Компоновщик = КомпоновщикНастроек(Отчет.Схема, Вариант.Настройки);

	Варианты = Новый Массив;
	Для Каждого ВариантСхемы Из Отчет.Схема.ВариантыНастроек Цикл
		ОписаниеВарианта = Новый Соответствие;
		ОписаниеВарианта.Вставить("key", ВариантСхемы.Имя);
		ОписаниеВарианта.Вставить("title", Строка(ВариантСхемы.Представление));
		Варианты.Добавить(ОписаниеВарианта);
	КонецЦикла;

	Данные = Новый Соответствие;
	Данные.Вставить("report", Отчет.ПолноеИмя);
	Данные.Вставить("synonym", mcp1c_Метаданные.СинонимОбъекта(Отчет.ОбъектМД));
	Данные.Вставить("variants", Варианты);
	Данные.Вставить("variant", Вариант.Имя);
	Данные.Вставить("parameters", ОписанияПараметров(Отчет.Схема, Компоновщик, Контекст));
	Примечания = Новый Массив;
	Примечания.Добавить("Період (тип СтандартныйПериод) передавайте в run_report як {""from"": ""2026-09-01"", "
		+ """to"": ""2026-09-30""}; дата без часу в to - кінець дня.");
	Примечания.Добавить("Параметри, яких немає в переліку, задає сам звіт.");
	Данные.Вставить("notes", Примечания);
	Возврат ИтогУспех(Данные);

КонецФункции

// run_report: выполняет отчет и возвращает текст ячеек результата по строкам.
//
// Параметры:
//  Аргументы - Соответствие из КлючИЗначение - проверенные аргументы.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Данные - Неопределено, Соответствие из КлючИЗначение - structuredContent; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели (isError); пустая строка при успехе.
//
Функция ВыполнитьОтчет(Аргументы, Контекст) Экспорт

	Лимит = mcp1c_ИнструментыДанных.ЛимитСтрок(Аргументы, Контекст, 50);
	Если Лимит = 0 Тогда
		Возврат ИтогОшибка("Добову квоту рядків вичерпано: спробуйте завтра або зверніться до адміністратора");
	КонецЕсли;
	Страницы = mcp1c_ИнструментыДанных.ПрочитатьКурсор(Аргументы, "run_report", Контекст);
	Если Не ПустаяСтрока(Страницы.Ошибка) Тогда
		Возврат ИтогОшибка(Страницы.Ошибка);
	КонецЕсли;
	Отчет = ОтчетКлиента(mcp1c_Служебный.СвойствоСтрока(Аргументы, "report"), Контекст);
	Если Не ПустаяСтрока(Отчет.Ошибка) Тогда
		Возврат ИтогОшибка(Отчет.Ошибка);
	КонецЕсли;
	Вариант = ВариантНастроек(Отчет.Схема, mcp1c_Служебный.СвойствоСтрока(Аргументы, "variant"));
	Если Не ПустаяСтрока(Вариант.Ошибка) Тогда
		Возврат ИтогОшибка(Вариант.Ошибка);
	КонецЕсли;
	Компоновщик = КомпоновщикНастроек(Отчет.Схема, Вариант.Настройки);
	Ошибка = УстановитьПараметры(Компоновщик, Отчет.Схема, mcp1c_Служебный.Свойство(Аргументы, "parameters"), Контекст);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат ИтогОшибка(Ошибка);
	КонецЕсли;

	Попытка
		Документ = mcp1c_ВыполнениеЗапросов.ВыполнитьКомпоновкуОтчета(Отчет.Схема, Компоновщик.ПолучитьНастройки());
	Исключение
		Контекст.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат ИтогОшибка("Помилка виконання звіту: " + Лев(СокрЛП(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), 500));
	КонецПопытки;
	Страница = СтрокиДокумента(Документ, Страницы.Смещение + 1, Лимит);
	Контекст.КоличествоСтрок = Контекст.КоличествоСтрок + Страница.Строки.Количество();

	Данные = Новый Соответствие;
	Данные.Вставить("report", Отчет.ПолноеИмя);
	Данные.Вставить("variant", Вариант.Имя);
	Данные.Вставить("rows", Страница.Строки);
	Данные.Вставить("row_count", Страница.Строки.Количество());
	Данные.Вставить("has_more", Страница.Следующая > 0);
	Данные.Вставить("grid_rows", Документ.ВысотаТаблицы);
	Примечания = Новый Массив;
	Примечания.Добавить("Рядки - текст комірок звіту зліва направо (порожні рядки пропущено, порожні комірки "
		+ "в кінці рядка відкинуто); числа - як у звіті.");
	Если Страница.Следующая > 0 Тогда
		Данные.Вставить("next_cursor", mcp1c_Курсор.Сформировать(Страницы.Секрет, Страницы.Привязка, "run_report",
			Страницы.Отпечаток, Страница.Следующая - 1, Страницы.Время));
		Примечания.Добавить("Є ще рядки: повторіть виклик з cursor = next_cursor або звузьте параметри звіту");
	КонецЕсли;
	Если Страница.ОбрезаноКолонок > 0 Тогда
		Примечания.Добавить(СтрШаблон("Показано перші %1 колонок звіту з %2", Формат(МаксимумКолонок(), "ЧГ=0"),
			Формат(МаксимумКолонок() + Страница.ОбрезаноКолонок, "ЧГ=0")));
	КонецЕсли;
	Если Лимит < mcp1c_Служебный.СвойствоЧисло(Аргументы, "limit", 50) Тогда
		Примечания.Добавить(СтрШаблон("Кількість рядків обмежено до %1 профілем або добовою квотою", Лимит));
	КонецЕсли;
	Данные.Вставить("notes", Примечания);
	Возврат ИтогУспех(Данные);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОтчетИСхема

// Отчет, доступный клиенту, и его схема компоновки после проверки наборов данных. Отчет вне профиля
// не отличается от отсутствующего.
//
// Параметры:
//  Имя - Строка - имя отчета из аргументов: «Отчет.Имя», «Report.Имя» или «Имя».
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * ОбъектМД - ОбъектМетаданных, Неопределено - отчет; Неопределено при ошибке.
//   * ПолноеИмя - Строка - полное имя отчета.
//   * Схема - СхемаКомпоновкиДанных, Неопределено - основная схема отчета; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели.
//
Функция ОтчетКлиента(Знач Имя, Контекст)

	Результат = Новый Структура;
	Результат.Вставить("ОбъектМД", Неопределено);
	Результат.Вставить("ПолноеИмя", "");
	Результат.Вставить("Схема", Неопределено);
	Результат.Вставить("Ошибка", "");
	Имя = СокрЛП(Имя);
	Если СтрНайти(Имя, ".") = 0 Тогда
		Имя = "Отчет." + Имя;
	КонецЕсли;
	ТекстОшибки = СтрШаблон("Звіт не знайдено або недоступний: %1. Перелік дає list_reports.", Лев(Имя, 300));
	ОтчетМД = mcp1c_Метаданные.НайтиОбъект(Имя);
	Если ОтчетМД = Неопределено Или Не Метаданные.Отчеты.Содержит(ОтчетМД) Тогда
		Результат.Ошибка = ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОтчетМД);
	Если Не mcp1c_ПравилаДоступа.ОтчетДоступен(Контекст.Политика, ПолноеИмя) Тогда
		Контекст.ОтказДоступа = Истина;
		Контекст.Причина = "Звіт не дозволений профілем: " + ПолноеИмя;
		Результат.Ошибка = ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Если ОтчетМД.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		Результат.Ошибка = СтрШаблон("Звіт %1 не на СКД (немає основної схеми компонування даних): такі звіти "
			+ "не підтримуються", ПолноеИмя);
		Возврат Результат;
	КонецЕсли;
	ДобавитьОбъектВКонтекст(Контекст, ПолноеИмя);

	Схема = mcp1c_ВыполнениеЗапросов.СхемаОтчета(ОтчетМД);
	Проверка = НоваяПроверкаСхемы(Контекст.Политика);
	ПроверитьСхему(Схема, Проверка);
	Если Не ПустаяСтрока(Проверка.Ошибка) Тогда
		Если Не ПустаяСтрока(Проверка.Причина) Тогда
			Контекст.ОтказДоступа = Истина;
			Контекст.Причина = Проверка.Причина;
		КонецЕсли;
		Результат.Ошибка = СтрШаблон("Звіт %1 недоступний: %2", ПолноеИмя, Проверка.Ошибка);
		Возврат Результат;
	КонецЕсли;
	Для Каждого Объект Из Проверка.Объекты Цикл
		ДобавитьОбъектВКонтекст(Контекст, Объект);
	КонецЦикла;
	Результат.ОбъектМД = ОтчетМД;
	Результат.ПолноеИмя = ПолноеИмя;
	Результат.Схема = Схема;
	Возврат Результат;

КонецФункции

// Состояние проверки схемы отчета.
//
// Параметры:
//  Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//
// Возвращаемое значение:
//  Структура:
//   * Политика - см. mcp1c_ПравилаДоступа.НоваяПолитика
//   * Ошибка - Строка - почему отчет недоступен (для модели).
//   * Причина - Строка - отказ по политике для журнала.
//   * Объекты - Массив из Строка - объекты метаданных, таблицы которых читают запросы схемы.
//
Функция НоваяПроверкаСхемы(Политика)

	Проверка = Новый Структура;
	Проверка.Вставить("Политика", Политика);
	Проверка.Вставить("Ошибка", "");
	Проверка.Вставить("Причина", "");
	Проверка.Вставить("Объекты", Новый Массив);
	Возврат Проверка;

КонецФункции

Процедура ПроверитьСхему(Схема, Проверка)
	// Наборы данных схемы и вложенных схем, вычисляемые поля.

	ПроверитьНаборыДанных(Схема.НаборыДанных, Проверка);
	Для Каждого Поле Из Схема.ВычисляемыеПоля Цикл
		Если ПустаяСтрока(Проверка.Ошибка) Тогда
			ПроверитьИмена(mcp1c_ПроверкаЗапросов.ИменаВыражения(Поле.Выражение),
				СтрШаблон("вираз поля «%1»", Поле.ПутьКДанным), Проверка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ВложеннаяСхема Из Схема.ВложенныеСхемыКомпоновкиДанных Цикл
		Если ПустаяСтрока(Проверка.Ошибка) Тогда
			ПроверитьСхему(ВложеннаяСхема.Схема, Проверка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНаборыДанных(Наборы, Проверка)
	// Только наборы-запросы и их объединения: набор-объект заполняет код отчета, его данные не проверить.

	Для Каждого Набор Из Наборы Цикл
		Если Не ПустаяСтрока(Проверка.Ошибка) Тогда
			Возврат;
		КонецЕсли;
		Если ТипЗнч(Набор) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
			ПроверитьЗапросНабора(Набор, Проверка);
		ИначеЕсли ТипЗнч(Набор) = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных") Тогда
			ПроверитьНаборыДанных(Набор.Элементы, Проверка);
		Иначе
			Проверка.Ошибка = СтрШаблон("набір даних «%1» заповнює код звіту, а не запит: такі звіти не підтримуються",
				Набор.Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЗапросНабора(Набор, Проверка)
	// Таблицы запроса - по правилам объектов профиля, имена - по глобальным запретам полей.

	Разбор = mcp1c_ПроверкаЗапросов.ТаблицыЗапроса(Набор.Запрос);
	Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
		Проверка.Ошибка = СтрШаблон("запит набору даних «%1»: %2", Набор.Имя, Разбор.Ошибка);
		Возврат;
	КонецЕсли;
	ПроверитьИмена(Разбор.Имена, СтрШаблон("запит набору даних «%1»", Набор.Имя), Проверка);
	Для Каждого Таблица Из Разбор.Таблицы Цикл
		ПроверитьТаблицу(Таблица, Истина, Проверка);
	КонецЦикла;
	Для Каждого Таблица Из Разбор.ВозможныеТаблицы Цикл
		ПроверитьТаблицу(Таблица, Ложь, Проверка);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИмена(Имена, Где, Проверка)
	// Имена полей из глобальных запретов (п. 7.6 ТЗ) отчет не читает ни при каком профиле.

	Для Каждого Имя Из Имена Цикл
		Если ПустаяСтрока(Проверка.Ошибка) И mcp1c_ПравилаДоступа.ПолеЗапрещеноГлобально(Проверка.Политика, Имя) Тогда
			Проверка.Ошибка = СтрШаблон("%1 використовує поле «%2» з глобальних заборон", Где, Имя);
			Проверка.Причина = СтрШаблон("Звіт читає поле з глобальних заборон: %1", Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТаблицу(Таблица, Обязательная, Проверка)
	// Таблица запроса отчета: объект поддерживаемого вида, который профиль дает читать без ограничений строк
	// и обязательного отбора по периоду; табличная часть - доступная. Необязательная таблица (путь мог быть
	// псевдонимом) проверяется, только если такой объект есть в метаданных.

	Если Не ПустаяСтрока(Проверка.Ошибка) Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(Таблица, ".");
	ИмяОбъекта = Части[0] + "." + Части[1];
	Если Метаданные.НайтиПоПолномуИмени(ИмяОбъекта) = Неопределено Тогда
		Если Обязательная Тогда
			Проверка.Ошибка = СтрШаблон("запит читає таблицю «%1», якої немає в метаданих", Таблица);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Политика = Проверка.Политика;
	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(ИмяОбъекта);
	ПолноеИмя = ?(ОбъектМД = Неопределено, ИмяОбъекта, mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД));
	Если ОбъектМД = Неопределено Или Не mcp1c_ПравилаДоступа.ОбъектЧитается(Политика, ПолноеИмя) Тогда
		Проверка.Ошибка = СтрШаблон("профіль не дає читати «%1», з якого звіт бере дані", ПолноеИмя);
		Проверка.Причина = "Звіт читає об'єкт поза профілем: " + ПолноеИмя;
	ИначеЕсли mcp1c_ПравилаДоступа.ОграниченияСтрок(Политика, ПолноеИмя).Количество() > 0 Тогда
		Проверка.Ошибка = СтрШаблон("до «%1» профіль застосовує обмеження рядків, а звіт їх не враховує", ПолноеИмя);
		Проверка.Причина = "Звіт читає об'єкт з обмеженнями рядків: " + ПолноеИмя;
	ИначеЕсли mcp1c_ПравилаДоступа.ТребуетсяОтборПоПериоду(Политика, ПолноеИмя) Тогда
		Проверка.Ошибка = СтрШаблон("«%1» вимагає відбору за періодом, а звіт його не гарантує", ПолноеИмя);
		Проверка.Причина = "Звіт читає об'єкт з обов'язковим фільтром періоду: " + ПолноеИмя;
	Иначе
		Описание = ?(Части.Количество() = 3, mcp1c_Метаданные.ОписаниеТаблицы(Таблица), Неопределено);
		Если Описание <> Неопределено И Описание.ВидТаблицы = "tabular_section"
			И Не mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(Политика, ПолноеИмя,
				Лев(Описание.ПрефиксПолейПолитики, СтрДлина(Описание.ПрефиксПолейПолитики) - 1)) Тогда
			Проверка.Ошибка = СтрШаблон("профіль не дає читати табличну частину «%1», з якої звіт бере дані", Таблица);
			Проверка.Причина = "Звіт читає табличну частину поза профілем: " + Таблица;
		ИначеЕсли Проверка.Объекты.Найти(ПолноеИмя) = Неопределено Тогда
			Проверка.Объекты.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ВариантыИПараметры

// Вариант настроек схемы по имени без учета регистра; без имени - первый вариант (у схемы без вариантов -
// настройки по умолчанию).
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - схема отчета.
//  Ключ - Строка - имя варианта из аргументов.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя варианта.
//   * Настройки - НастройкиКомпоновкиДанных, Неопределено - настройки варианта; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели.
//
Функция ВариантНастроек(Схема, Знач Ключ)

	Результат = Новый Структура("Имя, Настройки, Ошибка", "", Неопределено, "");
	Ключ = СокрЛП(Ключ);
	Для Каждого Вариант Из Схема.ВариантыНастроек Цикл
		Если ПустаяСтрока(Ключ) Или НРег(Вариант.Имя) = НРег(Ключ) Тогда
			Результат.Имя = Вариант.Имя;
			Результат.Настройки = Вариант.Настройки;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Ключ) Тогда
		Результат.Настройки = Схема.НастройкиПоУмолчанию;
	Иначе
		Результат.Ошибка = СтрШаблон("Варіант «%1» не знайдено: перелік варіантів дає describe_report", Лев(Ключ, 100));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция КомпоновщикНастроек(Схема, Настройки)
	// Компоновщик настроек схемы с загруженными настройками варианта.

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Настройки);
	Возврат Компоновщик;

КонецФункции

Функция ОписанияПараметров(Схема, Компоновщик, Контекст)
	// Параметры, которые задает пользователь (без ограничения использования): имя, заголовок, типы,
	// обязательность, список значений и значение в варианте.

	Параметры = ПараметрыДляМодели(Схема);
	Значения = Новый Массив;
	Для Каждого ПараметрСхемы Из Параметры Цикл
		Значения.Добавить(ЗначениеПараметраВНастройках(Компоновщик, ПараметрСхемы));
	КонецЦикла;
	КонтекстПреобразования = mcp1c_Значения.НовыйКонтекстПреобразования(Контекст.Политика, 500);
	Представления = mcp1c_Значения.ПредставленияСсылок(ПростыеЗначения(Значения), КонтекстПреобразования);

	Результат = Новый Массив;
	Для Индекс = 0 По Параметры.ВГраница() Цикл
		ПараметрСхемы = Параметры[Индекс];
		Описание = Новый Соответствие;
		Описание.Вставить("name", ПараметрСхемы.Имя);
		Описание.Вставить("title", Строка(ПараметрСхемы.Заголовок));
		Описание.Вставить("types", mcp1c_Метаданные.ПредставленияТипов(ПараметрСхемы.ТипЗначения));
		Описание.Вставить("required", ПараметрСхемы.ЗапрещатьНезаполненныеЗначения = Истина);
		Описание.Вставить("list", ПараметрСхемы.ДоступенСписокЗначений = Истина);
		Если Значения[Индекс] <> Неопределено Тогда
			Описание.Вставить("value", ЗначениеВJSON(Значения[Индекс], Представления, КонтекстПреобразования));
		КонецЕсли;
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПараметрыДляМодели(Схема)
	// Параметры схемы, которые можно задать: без ограничения использования.

	Результат = Новый Массив;
	Для Каждого ПараметрСхемы Из Схема.Параметры Цикл
		Если ПараметрСхемы.ОграничениеИспользования <> Истина Тогда
			Результат.Добавить(ПараметрСхемы);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗначениеПараметраВНастройках(Компоновщик, ПараметрСхемы)
	// Значение параметра, которое использует вариант, или значение схемы по умолчанию.

	ЗначениеНастройки = Компоновщик.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных(ПараметрСхемы.Имя));
	Если ЗначениеНастройки <> Неопределено И ЗначениеНастройки.Использование Тогда
		Возврат ЗначениеНастройки.Значение;
	КонецЕсли;
	Возврат ПараметрСхемы.Значение;

КонецФункции

Функция УстановитьПараметры(Компоновщик, Схема, Аргумент, Контекст)
	// Значения параметров из аргумента parameters по типам параметров схемы; текст ошибки или пустая строка.

	Если Аргумент = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Параметры = ПараметрыДляМодели(Схема);
	Для Каждого Элемент Из Аргумент Цикл
		ПараметрСхемы = Неопределено;
		Для Каждого Кандидат Из Параметры Цикл
			Если НРег(Кандидат.Имя) = НРег(Элемент.Ключ) Тогда
				ПараметрСхемы = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПараметрСхемы = Неопределено Тогда
			Возврат СтрШаблон("Параметра «%1» немає у звіті або його задає сам звіт: перелік дає describe_report",
				Лев(Элемент.Ключ, 100));
		КонецЕсли;
		Разбор = ЗначениеПараметра(Элемент.Значение, ПараметрСхемы, "parameters." + Элемент.Ключ, Контекст);
		Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
			Возврат Разбор.Ошибка;
		КонецЕсли;
		ПараметрыДанных = Компоновщик.Настройки.ПараметрыДанных;
		ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрСхемы.Имя, Разбор.Значение);
		ЗначениеНастройки = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ПараметрСхемы.Имя));
		Если ЗначениеНастройки <> Неопределено Тогда
			ЗначениеНастройки.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Значение параметра отчета из JSON по типу параметра схемы: период - {"from", "to"}, массив - список
// значений, остальное - как значения параметров запросов (дата, ссылка, перечисление, строка, число).
//
// Параметры:
//  Значение - Произвольный - значение JSON.
//  ПараметрСхемы - ПараметрСхемыКомпоновкиДанных - параметр.
//  Путь - Строка - путь к значению для текста ошибки.
//  Контекст - см. mcp1c_Инструменты.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура:
//   * Значение - Неопределено, Произвольный - значение параметра; Неопределено при ошибке.
//   * Ошибка - Строка - текст ошибки для модели.
//
Функция ЗначениеПараметра(Значение, ПараметрСхемы, Путь, Контекст)

	Результат = Новый Структура("Значение, Ошибка", Неопределено, "");
	ТипЗначения = ПараметрСхемы.ТипЗначения;
	Если ТипЗнч(Значение) = Тип("Соответствие") И ТипЗначения.СодержитТип(Тип("СтандартныйПериод")) Тогда
		Возврат ПериодИзJSON(Значение, Путь, Контекст);
	КонецЕсли;
	Типы = mcp1c_Метаданные.ИменаТипов(ТипЗначения);
	Если ТипЗначения.СодержитТип(Тип("СтандартнаяДатаНачала")) И Типы.Найти("Дата") = Неопределено Тогда
		Типы.Добавить("Дата");
	КонецЕсли;
	Разбор = mcp1c_ПроверкаЗапросов.СпецификацияЗначения(Значение, Типы, Путь);
	Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
		Результат.Ошибка = Разбор.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Спецификации = Новый Соответствие;
	Спецификации.Вставить("Значение", Разбор.Значение);
	Значения = mcp1c_Значения.ЗначенияПараметров(Спецификации);
	Если Не ПустаяСтрока(Значения.Ошибка) Тогда
		Результат.Ошибка = Значения.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Значение_ = Значения.Значения.Получить("Значение");
	Если ТипЗнч(Значение_) = Тип("Массив") Тогда
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(Значение_);
		Значение_ = Список;
	ИначеЕсли ТипЗнч(Значение_) = Тип("Дата") И ТипЗначения.СодержитТип(Тип("СтандартнаяДатаНачала"))
		И Не ТипЗначения.СодержитТип(Тип("Дата")) Тогда
		Значение_ = Новый СтандартнаяДатаНачала(Значение_);
	КонецЕсли;
	Результат.Значение = Значение_;
	Возврат Результат;

КонецФункции

Функция ПериодИзJSON(Значение, Путь, Контекст)
	// Произвольный стандартный период из {"from", "to"}: дата без времени в to - конец дня; длина периода -
	// не больше глубины периода профиля.

	Результат = Новый Структура("Значение, Ошибка", Неопределено, "");
	Начало = mcp1c_Служебный.РазобратьДату(mcp1c_Служебный.Свойство(Значение, "from"));
	Конец = mcp1c_Служебный.РазобратьДату(mcp1c_Служебный.Свойство(Значение, "to"));
	Если Начало = Неопределено Или Конец = Неопределено Тогда
		Результат.Ошибка = Путь + ": для періоду очікується {""from"": ""2026-09-01"", ""to"": ""2026-09-30""}";
		Возврат Результат;
	КонецЕсли;
	ДатаОкончания = ?(Конец.ТолькоДата, КонецДня(Конец.Дата), Конец.Дата);
	Если ДатаОкончания < Начало.Дата Тогда
		Результат.Ошибка = Путь + ": from пізніше за to";
		Возврат Результат;
	КонецЕсли;
	Глубина = Контекст.Политика.Лимиты.ГлубинаПериодаДней;
	Если (НачалоДня(ДатаОкончания) - НачалоДня(Начало.Дата)) / 86400 + 1 > Глубина Тогда
		Результат.Ошибка = СтрШаблон("%1: період довший за %2 днів (ліміт профілю)", Путь, Формат(Глубина, "ЧГ=0"));
		Возврат Результат;
	КонецЕсли;
	Результат.Значение = Новый СтандартныйПериод(Начало.Дата, ДатаОкончания);
	Возврат Результат;

КонецФункции

Функция ПростыеЗначения(Значения)
	// Значения параметров для поиска представлений ссылок: элементы списков - отдельно.

	Результат = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
			Для Каждого Элемент Из Значение Цикл
				Результат.Добавить(Элемент.Значение);
			КонецЦикла;
		Иначе
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗначениеВJSON(Значение, Представления, КонтекстПреобразования)
	// Значение параметра для describe_report: период - {from, to, variant}, список - массив.

	Если ТипЗнч(Значение) = Тип("СтандартныйПериод") Тогда
		Результат = Новый Соответствие;
		Результат.Вставить("variant", Строка(Значение.Вариант));
		Если ЗначениеЗаполнено(Значение.ДатаНачала) Тогда
			Результат.Вставить("from", mcp1c_Служебный.ДатаВСтроку(Значение.ДатаНачала));
		КонецЕсли;
		Если ЗначениеЗаполнено(Значение.ДатаОкончания) Тогда
			Результат.Вставить("to", mcp1c_Служебный.ДатаВСтроку(Значение.ДатаОкончания));
		КонецЕсли;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("СтандартнаяДатаНачала") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение.Дата), mcp1c_Служебный.ДатаВСтроку(Значение.Дата), Неопределено);
	ИначеЕсли ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(mcp1c_Значения.ЗначениеВJSON(Элемент.Значение, Представления.Получить(Элемент.Значение),
				КонтекстПреобразования));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат mcp1c_Значения.ЗначениеВJSON(Значение, Представления.Получить(Значение), КонтекстПреобразования);

КонецФункции

#КонецОбласти

#Область Результат

// Непустые строки табличного документа, начиная со строки НомерСтроки: тексты ячеек без пустых в конце.
//
// Параметры:
//  Документ - ТабличныйДокумент - результат отчета.
//  НомерСтроки - Число - первая строка страницы.
//  Лимит - Число - сколько непустых строк вернуть.
//
// Возвращаемое значение:
//  Структура:
//   * Строки - Массив из Произвольный - строки: массивы текстов ячеек.
//   * Следующая - Число - номер следующей непустой строки; 0 - строк больше нет.
//   * ОбрезаноКолонок - Число - сколько колонок справа не показано.
//
Функция СтрокиДокумента(Документ, Знач НомерСтроки, Лимит)

	Результат = Новый Структура("Строки, Следующая, ОбрезаноКолонок", Новый Массив, 0, 0);
	Ширина = Мин(Документ.ШиринаТаблицы, МаксимумКолонок());
	Результат.ОбрезаноКолонок = Документ.ШиринаТаблицы - Ширина;
	Высота = Документ.ВысотаТаблицы;
	Пока НомерСтроки <= Высота Цикл
		Ячейки = ЯчейкиСтроки(Документ, НомерСтроки, Ширина);
		Если Ячейки.Количество() > 0 Тогда
			Если Результат.Строки.Количество() >= Лимит Тогда
				Результат.Следующая = НомерСтроки;
				Возврат Результат;
			КонецЕсли;
			Результат.Строки.Добавить(Ячейки);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЯчейкиСтроки(Документ, НомерСтроки, Ширина)
	// Тексты ячеек строки слева направо без пустых в конце; пустой массив - строка пустая.

	Ячейки = Новый Массив;
	Заполнено = 0;
	Для НомерКолонки = 1 По Ширина Цикл
		Текст = СокрЛП(mcp1c_Сериализация.ОчищенныйТекст(Документ.Область(НомерСтроки, НомерКолонки).Текст, 500));
		Ячейки.Добавить(Текст);
		Если Не ПустаяСтрока(Текст) Тогда
			Заполнено = НомерКолонки;
		КонецЕсли;
	КонецЦикла;
	Пока Ячейки.Количество() > Заполнено Цикл
		Ячейки.Удалить(Ячейки.ВГраница());
	КонецЦикла;
	Возврат Ячейки;

КонецФункции

Функция МаксимумКолонок()

	Возврат 60;

КонецФункции

#КонецОбласти

#Область Прочее

Процедура ДобавитьОбъектВКонтекст(Контекст, Имя)

	Если Контекст.Объекты.Найти(Имя) = Неопределено Тогда
		Контекст.Объекты.Добавить(Имя);
	КонецЕсли;

КонецПроцедуры

Функция КурсорИзСмещения(Смещение)

	Возврат mcp1c_Служебный.КодироватьСтрокуBase64URL("list_reports:" + Формат(Смещение, "ЧН=0; ЧГ=0"));

КонецФункции

Функция СмещениеИзКурсора(Курсор)

	Текст = mcp1c_Служебный.ДекодироватьСтрокуBase64URL(Курсор);
	Префикс = "list_reports:";
	Если Текст = Неопределено Или Не СтрНачинаетсяС(Текст, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цифры = Сред(Текст, СтрДлина(Префикс) + 1);
	Если ПустаяСтрока(Цифры) Или СтрДлина(Цифры) > 9 Или Не mcp1c_Служебный.СостоитИзСимволов(Цифры, "0123456789") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

Функция ИтогУспех(Данные)

	Возврат Новый Структура("Данные, Ошибка", Данные, "");

КонецФункции

Функция ИтогОшибка(ТекстОшибки)

	Возврат Новый Структура("Данные, Ошибка", Неопределено, ТекстОшибки);

КонецФункции


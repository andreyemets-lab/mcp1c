#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Клиент = Параметры.Клиент;
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		ВызватьИсключение "Не вказано клієнта доступу";
	КонецЕсли;

	Настройки = mcp1c_Настройки.Получить();
	Политика = mcp1c_Политики.ПолитикаКлиента(Клиент, Настройки);
	Профиль = Политика.Профиль;
	МаксимумДней = mcp1c_Служебный.СвойствоЧисло(Настройки, "maxTokenDays", 90);
	СрокДействия = Мин(mcp1c_Служебный.СвойствоЧисло(Настройки, "defaultTokenDays", 30), МаксимумДней);
	Элементы.СрокДействия.МаксимальноеЗначение = МаксимумДней;
	Элементы.СрокДействия.Подсказка = СтрШаблон("Від 1 до %1 днів (налаштування maxTokenDays)",
		Формат(МаксимумДней, "ЧГ=0"));
	ОбновитьДатуОкончания();

	ВариантОбласти = "all";
	ЗаполнитьИнструменты(Политика);
	Элементы.Инструменты.Видимость = Ложь;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПараметры;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СрокДействияПриИзменении(Элемент)

	ОбновитьДатуОкончания();

КонецПроцедуры

&НаКлиенте
Процедура ВариантОбластиПриИзменении(Элемент)

	Элементы.Инструменты.Видимость = (ВариантОбласти = "custom");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выпустить(Команда)

	Если СрокДействия < 1 Или СрокДействия > МаксимумДней Тогда
		ПоказатьПредупреждение(, СтрШаблон("Термін дії - від 1 до %1 днів", Формат(МаксимумДней, "ЧГ=0")));
		Возврат;
	КонецЕсли;
	Если ВариантОбласти = "custom" И Инструменты.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Позначте інструменти, які відкриває токен");
		Возврат;
	КонецЕсли;

	ВыпуститьНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.mcp1c_ТокеныДоступа"));
	Оповестить(mcp1c_АдминистрированиеКлиент.СобытиеИзменениеТокенов(), Клиент);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыпуститьНаСервере()

	Выпуск = mcp1c_Администрирование.ВыпуститьТокен(Клиент, СрокДействия, Комментарий, ОбластьТокена());
	Токен = Выпуск.Токен;
	Фрагменты = Выпуск.Фрагменты;
	ДействуетДо = МестноеВремя(Выпуск.ДействуетДо, ЧасовойПоясСеанса());

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаРезультат;
	Элементы.ФормаВыпустить.Видимость = Ложь;
	Элементы.ФормаЗакрыть.КнопкаПоУмолчанию = Истина;

КонецПроцедуры

&НаСервере
Функция ОбластьТокена()
	// Область по выбору администратора; выбраны все инструменты профиля - область не нужна.

	Если ВариантОбласти = "metadata" Тогда
		Возврат СтрСоединить(mcp1c_ПравилаДоступа.ИнструментыМетаданных(), ",");
	ИначеЕсли ВариантОбласти <> "custom" Тогда
		Возврат "";
	КонецЕсли;
	Отмеченные = Новый Массив;
	Для Каждого Строка_ Из Инструменты Цикл
		Если Строка_.Пометка Тогда
			Отмеченные.Добавить(Строка_.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Отмеченные.Количество() = Инструменты.Количество(), "", СтрСоединить(Отмеченные, ","));

КонецФункции

&НаСервере
Процедура ЗаполнитьИнструменты(Политика)
	// Инструменты, которые профиль клиента разрешает: из них администратор выбирает область токена.

	Для Каждого Описание Из mcp1c_Инструменты.ОписанияИнструментов(Политика) Цикл
		Строка_ = Инструменты.Добавить();
		Строка_.Пометка = Истина;
		Строка_.Имя = Описание.Получить("name");
		Строка_.Описание = Описание.Получить("title");
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДатуОкончания()

	ДействуетДо = ТекущаяДатаСеанса() + Цел(СрокДействия) * 86400;

КонецПроцедуры

#КонецОбласти

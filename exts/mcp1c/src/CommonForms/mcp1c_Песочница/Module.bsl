#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Клиент = Параметры.Клиент;
	ЗаполнитьВызовы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)

	ЗаполнитьВызовы();

КонецПроцедуры

&НаКлиенте
Процедура ОбластьТокенаПриИзменении(Элемент)

	ЗаполнитьВызовы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВызовы

&НаКлиенте
Процедура ВызовыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Вызовы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Аргументы = ТекущиеДанные.Пример;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьВызов(Команда)

	ТекущиеДанные = Элементы.Вызовы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Виберіть, що викликати");
		Возврат;
	КонецЕсли;
	Ошибка = ВыполнитьВызовНаСервере(ТекущиеДанные.Метод, ТекущиеДанные.Имя);
	Если Не ПустаяСтрока(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыполнитьВызовНаСервере(Метод, Имя)
	// Вызов от имени клиента; ошибка ввода (некорректный JSON, область) возвращается текстом.

	Попытка
		ПараметрыВызова = mcp1c_Песочница.ПараметрыВызова(Метод, Имя, Аргументы);
		Итог = mcp1c_Песочница.ВыполнитьМетод(Клиент, Метод, ПараметрыВызова, ОбластьТокена);
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ответ = mcp1c_Сериализация.ФорматированныйJSON(Итог.Ответ);
	Правила = mcp1c_Песочница.ТекстПравил(Итог);
	Элементы.СтраницаОтвет.Заголовок = ?(Итог.ЕстьОшибка, "Відповідь для моделі: помилка JSON-RPC",
		?(Итог.ОшибкаИнструмента, "Відповідь для моделі: помилка інструмента", "Відповідь для моделі"));
	Элементы.СтраницаПравила.Заголовок = ?(Итог.Предупреждения.Количество() > 0,
		СтрШаблон("Правила і попередження (%1)", Итог.Предупреждения.Количество()), "Правила і попередження");
	Возврат "";

КонецФункции

&НаСервере
Процедура ЗаполнитьВызовы()
	// Вызовы, доступные клиенту с указанной областью токена: списки, инструменты, ресурсы и промпты.

	Вызовы.Очистить();
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Варианты = mcp1c_Песочница.ДоступныеВызовы(Клиент, ОбластьТокена);
	Исключение
		Правила = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	Для Каждого Вариант Из Варианты Цикл
		ЗаполнитьЗначенияСвойств(Вызовы.Добавить(), Вариант);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

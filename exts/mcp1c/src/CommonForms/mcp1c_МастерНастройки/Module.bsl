#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	Настройки = mcp1c_Настройки.Получить();
	ПубличныйАдрес = mcp1c_Служебный.СвойствоСтрока(Настройки, "canonicalUrl");
	ЗаголовокАдресаКлиента = mcp1c_Служебный.СвойствоСтрока(Настройки, "clientIpHeader");
	ТипКлиента = Перечисления.mcp1c_ТипыКлиентов.Агент;
	Профиль = Справочники.mcp1c_ПрофилиДоступа.НайтиПоНаименованию("Тільки метадані", Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Назад(Команда)

	ПерейтиНаШаг(-1);

КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)

	// Публичный адрес и заголовок IP сохраняются при уходе с первого шага: они нужны фрагментам подключения.
	Если Элементы.Шаги.ТекущаяСтраница = Элементы.СтраницаПубликация Тогда
		Ошибка = СохранитьПубликацию();
		Если Не ПустаяСтрока(Ошибка) Тогда
			ПоказатьПредупреждение(, Ошибка);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ПерейтиНаШаг(1);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАдрес(Команда)

	Итог = ПроверитьАдресНаСервере(ПубличныйАдрес);
	Элементы.ДекорацияРезультатПроверки.Заголовок = ?(Итог.Успех, "Так. ", "Ні. ") + Итог.Текст;

КонецПроцедуры

&НаКлиенте
Процедура Сканировать(Команда)

	НачатьСканированиеНаСервере();
	Элементы.КнопкаСканировать.Доступность = Ложь;
	ОтчетСканирования = "Сканування метаданих триває...";
	ПодключитьОбработчикОжидания("ПроверитьЗавершениеСканирования", 3);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПрофиль(Команда)

	Профиль = ПрофильТолькоМетаданные();
	ПоказатьОповещениеПользователя("Профіль «Тільки метадані» готовий", ПолучитьНавигационнуюСсылку(Профиль));
	ОповеститьОбИзменении(Профиль);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьКлиента(Команда)

	Если ПустаяСтрока(ИмяКлиента) Тогда
		ПоказатьПредупреждение(, "Вкажіть ім'я клієнта");
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(Профиль) Тогда
		ПоказатьПредупреждение(, "Виберіть профіль на кроці 3");
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(Клиент) Тогда
		mcp1c_АдминистрированиеКлиент.ВыпуститьТокен(Клиент);
		Возврат;
	КонецЕсли;
	Клиент = СоздатьКлиентаНаСервере(ИмяКлиента, Профиль, ТипКлиента, ВнешнийПровайдер);
	ОповеститьОбИзменении(Клиент);
	Элементы.КнопкаСоздатьКлиента.Заголовок = "Видати ще один токен";
	mcp1c_АдминистрированиеКлиент.ВыпуститьТокен(Клиент);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПерейтиНаШаг(Сдвиг)

	Шаги = ИменаШагов();
	Индекс = Шаги.Найти(Элементы.Шаги.ТекущаяСтраница.Имя) + Сдвиг;
	Если Индекс >= 0 И Индекс < Шаги.Количество() Тогда
		Элементы.Шаги.ТекущаяСтраница = Элементы[Шаги[Индекс]];
	КонецЕсли;
	ОбновитьКнопки();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКнопки()
	// Назад - со второго шага, Далее - до последнего.

	Шаги = ИменаШагов();
	Индекс = Шаги.Найти(Элементы.Шаги.ТекущаяСтраница.Имя);
	Элементы.ФормаНазад.Доступность = Индекс > 0;
	Элементы.ФормаДалее.Видимость = Индекс < Шаги.Количество() - 1;

КонецПроцедуры

&НаКлиенте
Функция ИменаШагов()
	// Страницы шагов по порядку.

	Возврат СтрРазделить("СтраницаПубликация,СтраницаЧувствительные,СтраницаПрофиль,СтраницаКлиент", ",");

КонецФункции

&НаСервере
Функция СохранитьПубликацию()
	// Публичный адрес и заголовок IP клиента в настройки сервера; текст ошибки - если адрес некорректен.

	Попытка
		mcp1c_Администрирование.УстановитьКаноническийАдрес(ПубличныйАдрес);
		mcp1c_Администрирование.УстановитьЗаголовокАдресаКлиента(ЗаголовокАдресаКлиента);
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

// Проверка публичного адреса с сервера 1С.
//
// Параметры:
//  Адрес - Строка - адрес эндпоинта.
//
// Возвращаемое значение:
//  см. mcp1c_ПодключениеКлиентов.ИтогПроверкиАдреса
//
&НаСервереБезКонтекста
Функция ПроверитьАдресНаСервере(Адрес)

	Возврат mcp1c_Мониторинг.ПроверкаПубличногоАдреса(Адрес);

КонецФункции

&НаСервере
Процедура НачатьСканированиеНаСервере()

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	АдресОтчета = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(АдресОтчета);
	Задание = ФоновыеЗадания.Выполнить("mcp1c_Мониторинг.ОтчетЧувствительныхПолейВФоне", ПараметрыЗадания, ,
		"MCP: пошук чутливих полів");
	ЗаданиеСканирования = Строка(Задание.УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеСканирования()
	// Ожидание фонового задания сканирования метаданных.

	Если Не ЗавершитьСканированиеНаСервере() Тогда
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ПроверитьЗавершениеСканирования");
	Элементы.КнопкаСканировать.Доступность = Истина;

КонецПроцедуры

&НаСервере
Функция ЗавершитьСканированиеНаСервере()
	// Ложь - задание еще выполняется; иначе отчет или ошибка - в ОтчетСканирования.

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ЗаданиеСканирования));
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Ложь;
	КонецЕсли;
	Отчет = ПолучитьИзВременногоХранилища(АдресОтчета);
	Если ТипЗнч(Отчет) = Тип("Строка") Тогда
		ОтчетСканирования = Отчет;
	ИначеЕсли Задание <> Неопределено И Задание.ИнформацияОбОшибке <> Неопределено Тогда
		ОтчетСканирования = "Сканування не вдалося: " + КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	Иначе
		ОтчетСканирования = "Сканування завершилося без результату";
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ПрофильТолькоМетаданные()

	Возврат mcp1c_АнализДоступа.ПрофильТолькоМетаданные();

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьКлиентаНаСервере(Наименование, Профиль, ТипКлиента, ВнешнийПровайдер)

	Возврат mcp1c_Администрирование.СоздатьКлиента(Наименование, Профиль, ТипКлиента, ВнешнийПровайдер);

КонецФункции

#КонецОбласти

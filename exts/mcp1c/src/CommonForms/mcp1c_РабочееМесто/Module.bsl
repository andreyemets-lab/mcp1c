// Обработчик подтверждения выключения сервера.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ВыключитьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ВыключитьНаСервере();
	ПоказатьОповещениеПользователя("MCP-сервер вимкнено");

КонецПроцедуры

// Обработчик подтверждения переноса информационной базы.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ПодтвердитьПереносПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПодтвердитьПереносНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.mcp1c_ТокеныДоступа"));
	ПоказатьОповещениеПользователя("Перенесення бази підтверджено, токени відкликано");

КонецПроцедуры


КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеПроверкиПолей()
	// Ожидание фонового задания проверки профилей на чувствительные поля.

	Итог = ЗавершитьПроверкуЧувствительныхПолейНаСервере();
	Если Итог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ПроверитьЗавершениеПроверкиПолей");
	Элементы.ФормаПроверитьЧувствительныеПоля.Доступность = Истина;
	Если Не ПустаяСтрока(Итог.Ошибка) Тогда
		ПоказатьПредупреждение(, "Перевірка профілів не вдалася: " + Итог.Ошибка);
	ИначеЕсли Итог.Найдено > 0 Тогда
		ПоказатьОповещениеПользователя(СтрШаблон("Профілів із чутливими полями без маски: %1", Итог.Найдено));
	Иначе
		ПоказатьОповещениеПользователя("Профілі клієнтів не показують чутливих полів без маски");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НачатьПроверкуЧувствительныхПолейНаСервере()

	mcp1c_Администрирование.ПроверитьПраваАдминистратора();
	АдресПроверки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(АдресПроверки);
	Задание = ФоновыеЗадания.Выполнить("mcp1c_Мониторинг.ПроверитьЧувствительныеПоляВФоне", ПараметрыЗадания, ,
		"MCP: перевірка профілів на чутливі поля");
	ЗаданиеПроверки = Строка(Задание.УникальныйИдентификатор);

КонецПроцедуры

// Итог фонового задания проверки профилей.
//
// Возвращаемое значение:
//  - Неопределено - задание еще выполняется.
//  - Структура:
//   * Ошибка - Строка - описание ошибки задания; пустая строка - задание выполнено.
//   * Найдено - Число - профилей с чувствительными полями без маски.
//
&НаСервере
Функция ЗавершитьПроверкуЧувствительныхПолейНаСервере()

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ЗаданиеПроверки));
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Неопределено;
	КонецЕсли;

	Итог = Новый Структура("Ошибка, Найдено", "", 0);
	Профили = ПолучитьИзВременногоХранилища(АдресПроверки);
	Если ТипЗнч(Профили) <> Тип("Массив") Тогда
		Если Задание <> Неопределено И Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Итог.Ошибка = КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		Иначе
			Итог.Ошибка = "фонове завдання завершилося без результату";
		КонецЕсли;
		Возврат Итог;
	КонецЕсли;

	ПрофилиСЧувствительнымиПолями = СтрСоединить(Профили, Символы.ПС);
	ЧувствительныеПоляПроверены = Истина;
	Итог.Найдено = Профили.Количество();
	ОбновитьНаСервере();
	Возврат Итог;

КонецФункции

&НаСервере
Процедура СнятьБлокировкуНаСервере(ВидБлокировки, Ключ, Клиент)

	Если ВидБлокировки = "client" Тогда
		mcp1c_Администрирование.СнятьБлокировкуКлиента(Клиент);
	Иначе
		mcp1c_Администрирование.СнятьБлокировкуАдреса(Ключ);
	КонецЕсли;
	ОбновитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Профили = Неопределено;
	Если ЧувствительныеПоляПроверены Тогда
		Профили = СтрРазделить(ПрофилиСЧувствительнымиПолями, Символы.ПС, Ложь);
	КонецЕсли;
	Данные = mcp1c_Мониторинг.ДанныеПанели(Профили);

	ЕстьПраваАдминистратора = Данные.ЕстьПраваАдминистратора;
	НастройкиДоступны = Данные.НастройкиДоступны;
	Включен = Данные.Включен;
	ТребуетсяПодтверждениеПереноса = Данные.ТребуетсяПодтверждениеПереноса;
	КаноническийАдрес = Данные.КаноническийАдрес;
	Привязка = ?(ПустаяСтрока(Данные.Привязка), "буде зафіксована першим запитом через публікацію", Данные.Привязка);

	Показатели.Загрузить(Данные.Показатели);
	Инструменты.Загрузить(Данные.Инструменты);
	Объекты.Загрузить(Данные.Объекты);
	Отказы.Загрузить(Данные.Отказы);
	Токены.Загрузить(Данные.Токены);
	Блокировки.Загрузить(Данные.Блокировки);

	ОформитьСостояние(Данные);
	ОформитьПредупреждения(Данные.Предупреждения);
	ОформитьСтраницы();
	ОформитьКоманды();

КонецПроцедуры

&НаСервере
Процедура ОформитьСостояние(Данные)

	Если Не НастройкиДоступны Тогда
		Текст = "Стан і налаштування сервера бачить лише адміністратор MCP-сервера.";
	ИначеЕсли ТребуетсяПодтверждениеПереноса Тогда
		Текст = "Сервер не приймає запити: розташування бази змінилося";
	ИначеЕсли Включен Тогда
		Текст = "Сервер увімкнено";
	Иначе
		Текст = "Сервер вимкнено";
	КонецЕсли;
	Элементы.ДекорацияСостояние.Заголовок = Текст;
	Если НастройкиДоступны И (Не Включен Или ТребуетсяПодтверждениеПереноса) Тогда
		Элементы.ДекорацияСостояние.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
	Иначе
		Элементы.ДекорацияСостояние.ЦветТекста = Новый Цвет;
	КонецЕсли;

	Подробности = Новый Массив;
	Если НастройкиДоступны Тогда
		Подробности.Добавить("Заголовок IP клієнта: " + ?(ПустаяСтрока(Данные.ЗаголовокАдресаКлиента), "не задано",
			Данные.ЗаголовокАдресаКлиента));
		Подробности.Добавить("журнал викликів: " + ?(Данные.СрокХраненияЖурнала > 0,
			СтрШаблон("зберігається %1 дн.", Формат(Данные.СрокХраненияЖурнала, "ЧГ=0")), "не очищається"));
	КонецЕсли;
	Подробности.Добавить("діючих токенів: " + Формат(Данные.ДействующихТокенов, "ЧН=0; ЧГ=0"));
	Элементы.ДекорацияПодробности.Заголовок = СтрСоединить(Подробности, " · ");

	Элементы.ГруппаАдрес.Видимость = НастройкиДоступны;
	Элементы.Привязка.Видимость = НастройкиДоступны;
	Элементы.КаноническийАдрес.ТолькоПросмотр = Не ЕстьПраваАдминистратора;
	Элементы.КнопкаЗаписатьАдрес.Видимость = ЕстьПраваАдминистратора;

КонецПроцедуры

&НаСервере
Процедура ОформитьПредупреждения(Предупреждения)

	Строки = Новый Массив;
	Для Каждого Текст Из Предупреждения Цикл
		Строки.Добавить("• " + Текст);
	КонецЦикла;
	Элементы.ДекорацияПредупреждения.Заголовок = СтрСоединить(Строки, Символы.ПС);
	Элементы.ГруппаПредупреждения.Видимость = Строки.Количество() > 0;

КонецПроцедуры

&НаСервере
Процедура ОформитьСтраницы()
	// Число строк в заголовках страниц со списками.

	Элементы.СтраницаОтказы.Заголовок = ЗаголовокСтраницы("Відмови і помилки", Отказы.Количество());
	Элементы.СтраницаТокены.Заголовок = ЗаголовокСтраницы("Токени, що спливають", Токены.Количество());
	Элементы.СтраницаБлокировки.Заголовок = ЗаголовокСтраницы("Блокування", Блокировки.Количество());

КонецПроцедуры

&НаСервере
Функция ЗаголовокСтраницы(Заголовок, Количество)

	Возврат ?(Количество > 0, СтрШаблон("%1 (%2)", Заголовок, Формат(Количество, "ЧГ=0")), Заголовок);

КонецФункции

&НаСервере
Процедура ОформитьКоманды()
	// Изменять состояние сервера и снимать блокировки может только администратор.

	Элементы.ФормаВключить.Видимость = ЕстьПраваАдминистратора И НастройкиДоступны И Не Включен;
	Элементы.ФормаВыключить.Видимость = ЕстьПраваАдминистратора И Включен;
	Элементы.ФормаПодтвердитьПеренос.Видимость = ЕстьПраваАдминистратора И ТребуетсяПодтверждениеПереноса;
	Элементы.ФормаПроверитьЧувствительныеПоля.Видимость = ЕстьПраваАдминистратора;
	Элементы.БлокировкиСнятьБлокировку.Видимость = ЕстьПраваАдминистратора;

КонецПроцедуры

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Пользовательский инструмент (п. 5.5 ТЗ): имя, вид, описание и параметры проверяет чистый модуль,
	// текст запроса, схему и метод - эта процедура. Источники вне профилей - предупреждение.
	Определение = ОпределениеИнструмента();
	Для Каждого Текст Из mcp1c_ПользовательскиеИнструменты.ОшибкиОпределения(Определение) Цикл
		СообщитьОбОшибке(Текст, "", Отказ);
	КонецЦикла;
	Если ЕстьДругойИнструментСИменем(Определение.Имя) Тогда
		СообщитьОбОшибке(СтрШаблон("Інструмент з ім'ям %1 уже є", Определение.Имя), "Имя", Отказ);
	КонецЕсли;
	Для Каждого Строка_ Из Профили Цикл
		Если Не ЗначениеЗаполнено(Строка_.Профиль) Тогда
			СообщитьОбОшибке(СтрШаблон("Профілі, рядок %1: не вказано профіль доступу", Строка_.НомерСтроки),
				СтрШаблон("Профили[%1].Профиль", Формат(Строка_.НомерСтроки - 1, "ЧН=0; ЧГ=0")), Отказ);
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Источники = Новый Массив;
	Если Определение.Вид = "query" Тогда
		ПроверитьЗапрос(Определение, Источники, Отказ);
	ИначеЕсли Определение.Вид = "dcs" Тогда
		ПроверитьСхемуКомпоновки(Определение, Источники, Отказ);
	ИначеЕсли mcp1c_ВыполнениеЗапросов.МодульДляВызова(ИмяМодуля) = Неопределено Тогда
		СообщитьОбОшибке(СтрШаблон("Загальний модуль %1 не знайдено або він не серверний чи глобальний", ИмяМодуля),
			"ИмяМодуля", Отказ);
	КонецЕсли;
	Если Не Отказ Тогда
		ПредупредитьОбИсточникахВнеПрофилей(Источники);
	КонецЕсли;
	Если Профили.Количество() = 0 Тогда
		Предупредить("Інструмент не призначено жодному профілю: клієнти його не побачать");
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Имя = СокрЛП(Имя);
	ИмяМодуля = СокрЛП(ИмяМодуля);
	ИмяМетода = СокрЛП(ИмяМетода);
	Для Каждого Строка_ Из Параметры Цикл
		Строка_.Имя = СокрЛП(Строка_.Имя);
		Строка_.ИмяПараметра = СокрЛП(Строка_.ИмяПараметра);
		Строка_.ПараметрПрофиля = СокрЛП(Строка_.ПараметрПрофиля);
	КонецЦикла;
	Колонки = ?(Вид = Перечисления.mcp1c_ВидыПользовательскихИнструментов.Запрос, КолонкиЗапроса(ТекстЗапроса), "");
	// Изменение того, что получает модель и что выполняет сервер, - событие безопасности (п. 5.5 ТЗ).
	ДополнительныеСвойства.Вставить("ИзмененияИнструмента", ИзмененияИнструмента());

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Изменения = Неопределено;
	ДополнительныеСвойства.Свойство("ИзмененияИнструмента", Изменения);
	Если ТипЗнч(Изменения) = Тип("Массив") И Изменения.Количество() > 0 Тогда
		mcp1c_Аудит.ЗаписатьСобытиеБезопасности(СтрШаблон("Користувач %3 змінив користувацький інструмент %1 (%2)",
			Имя, Наименование, ИмяПользователя()), "Змінено: " + СтрСоединить(Изменения, ", "));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Определение по реквизитам элемента, в том числе не записанным, - как его загрузит политика клиента
// (форма инструмента показывает по нему описание для модели).
//
// Возвращаемое значение:
//  см. mcp1c_ПользовательскиеИнструменты.НовоеОпределение
//
Функция ОпределениеИнструмента() Экспорт

	Определение = mcp1c_ПользовательскиеИнструменты.НовоеОпределение(Имя, mcp1c_Политики.КодВидаИнструмента(Вид));
	Определение.Заголовок = Наименование;
	Определение.Описание = Описание;
	Определение.ТекстЗапроса = ТекстЗапроса;
	Определение.СхемаКомпоновки = СхемаКомпоновки;
	Определение.ИмяМодуля = СокрЛП(ИмяМодуля);
	Определение.ИмяМетода = СокрЛП(ИмяМетода);
	Определение.ЛимитСтрок = ЛимитСтрок;
	Определение.Колонки = СтрРазделить(?(Вид = Перечисления.mcp1c_ВидыПользовательскихИнструментов.Запрос,
		КолонкиЗапроса(ТекстЗапроса), Колонки), ",", Ложь);
	Для Каждого Строка_ Из Параметры Цикл
		Параметр = mcp1c_ПользовательскиеИнструменты.НовыйПараметр(Строка_.Имя, Строка_.ИмяПараметра,
			Строка_.ТипЗначения);
		Параметр.Описание = Строка_.Описание;
		Параметр.Обязательный = Строка_.Обязательный;
		Параметр.Список = Строка_.Список;
		Параметр.ПараметрПрофиля = СокрЛП(Строка_.ПараметрПрофиля);
		mcp1c_ПользовательскиеИнструменты.УстановитьЗначенияПараметра(Параметр, Строка_.ЗначениеПоУмолчанию,
			Строка_.ДопустимыеЗначения);
		Определение.Параметры.Добавить(Параметр);
	КонецЦикла;
	Возврат Определение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗапрос(Определение, Источники, Отказ)
	// Текст разбирается схемой запроса: последний запрос пакета - выборка, параметры описаны.

	Схема = Новый СхемаЗапроса;
	Попытка
		Схема.УстановитьТекстЗапроса(Определение.ТекстЗапроса);
	Исключение
		СообщитьОбОшибке("Запит містить помилку: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "ТекстЗапроса",
			Отказ);
		Возврат;
	КонецПопытки;
	Пакет = Схема.ПакетЗапросов;
	Последний = Пакет[Пакет.Количество() - 1];
	Если ТипЗнч(Последний) <> Тип("ЗапросВыбораСхемыЗапроса") Или Не ПустаяСтрока(Последний.ТаблицаДляПомещения) Тогда
		СообщитьОбОшибке("Останній запит пакета має повертати вибірку (без ПОМЕСТИТЬ і УНИЧТОЖИТЬ)", "ТекстЗапроса",
			Отказ);
	КонецЕсли;
	Для Каждого ЗапросПакета Из Пакет Цикл
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
			ДобавитьИсточникиЗапроса(ЗапросПакета, Источники);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос(Определение.ТекстЗапроса);
	Попытка
		НайденныеПараметры = Запрос.НайтиПараметры();
	Исключение
		СообщитьОбОшибке("Запит містить помилку: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "ТекстЗапроса",
			Отказ);
		Возврат;
	КонецПопытки;
	ПроверитьПараметрыЗапроса(НайденныеПараметры, Определение, Отказ);

КонецПроцедуры

Процедура ПроверитьПараметрыЗапроса(НайденныеПараметры, Определение, Отказ)
	// Каждый параметр запроса описан в табличной части; описанный, но не используемый - предупреждение.

	Описанные = Новый Соответствие;
	Для Каждого Параметр Из Определение.Параметры Цикл
		Описанные.Вставить(НРег(Параметр.ИмяПараметра), Параметр.Имя);
	КонецЦикла;
	Найденные = Новый Соответствие;
	Для Каждого ОписаниеПараметра Из НайденныеПараметры Цикл
		Найденные.Вставить(НРег(ОписаниеПараметра.Имя), Истина);
		Если Описанные.Получить(НРег(ОписаниеПараметра.Имя)) = Неопределено Тогда
			СообщитьОбОшибке(СтрШаблон("Параметр запиту &%1 не описано в табличній частині «Параметри»",
				ОписаниеПараметра.Имя), "Параметры", Отказ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Параметр Из Определение.Параметры Цикл
		Если Найденные.Получить(НРег(Параметр.ИмяПараметра)) = Неопределено Тогда
			Предупредить(СтрШаблон("Параметр %1 (&%2) не використовується в запиті", Параметр.Имя, Параметр.ИмяПараметра));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСхемуКомпоновки(Определение, Источники, Отказ)
	// Схема читается из XML, параметры инструмента есть в схеме; запросы наборов данных дают источники.

	Попытка
		Схема = mcp1c_ВыполнениеЗапросов.СхемаКомпоновкиИзXML(Определение.СхемаКомпоновки);
	Исключение
		СообщитьОбОшибке("Схема компонування не читається: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			"СхемаКомпоновки", Отказ);
		Возврат;
	КонецПопытки;
	Для Каждого Параметр Из Определение.Параметры Цикл
		Если Схема.Параметры.Найти(Параметр.ИмяПараметра) = Неопределено Тогда
			СообщитьОбОшибке(СтрШаблон("Параметра %1 немає в схемі компонування", Параметр.ИмяПараметра), "Параметры",
				Отказ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого НаборДанных Из Схема.НаборыДанных Цикл
		Если ТипЗнч(НаборДанных) <> Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		СхемаЗапроса = Новый СхемаЗапроса;
		Попытка
			СхемаЗапроса.УстановитьТекстЗапроса(НаборДанных.Запрос);
		Исключение
			Продолжить; // расширение языка запросов компоновки схема запроса может не разобрать
		КонецПопытки;
		Для Каждого ЗапросПакета Из СхемаЗапроса.ПакетЗапросов Цикл
			Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
				ДобавитьИсточникиЗапроса(ЗапросПакета, Источники);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьИсточникиЗапроса(ЗапросВыбора, Источники)
	// Объекты метаданных, таблицы которых читает запрос, включая вложенные запросы в источниках.

	Для Каждого Оператор Из ЗапросВыбора.Операторы Цикл
		Для Каждого Источник Из Оператор.Источники Цикл
			ДобавитьИсточник(Источник.Источник, Источники);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьИсточник(Таблица, Источники)
	// Объект метаданных таблицы источника (Справочник.X из Справочник.X.ТабличнаяЧасть,
	// РегистрНакопления.Y из РегистрНакопления.Y.Остатки); временные таблицы пропускаются.

	Если ТипЗнч(Таблица) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
		ДобавитьИсточникиЗапроса(Таблица.Запрос, Источники);
		Возврат;
	ИначеЕсли ТипЗнч(Таблица) <> Тип("ТаблицаСхемыЗапроса") Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(Таблица.ИмяТаблицы, ".");
	Если Части.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	ИмяОбъекта = Части[0] + "." + Части[1];
	Если Источники.Найти(ИмяОбъекта) = Неопределено Тогда
		Источники.Добавить(ИмяОбъекта);
	КонецЕсли;

КонецПроцедуры

Процедура ПредупредитьОбИсточникахВнеПрофилей(Источники)
	// Запрос администратора выполняется как есть: правила объектов и ограничения строк профиля к нему
	// не применяются. Администратор видит, где инструмент выходит за пределы профиля.

	Настройки = mcp1c_Настройки.Получить();
	Для Каждого Строка_ Из Профили Цикл
		Политика = mcp1c_Политики.ПолитикаПрофиля(Строка_.Профиль, Настройки);
		Для Каждого ИмяОбъекта Из Источники Цикл
			Если Не mcp1c_ПравилаДоступа.ОбъектЧитается(Политика, ИмяОбъекта) Тогда
				Предупредить(СтрШаблон("Профіль «%1» не дає читати «%2», а інструмент повертає дані з нього",
					Строка_.Профиль, ИмяОбъекта));
			ИначеЕсли mcp1c_ПравилаДоступа.ОграниченияСтрок(Политика, ИмяОбъекта).Количество() > 0 Тогда
				Предупредить(СтрШаблон("Обмеження рядків профілю «%1» для «%2» до запиту інструмента не застосовуються: "
					+ "врахуйте їх у тексті запиту (наприклад, параметром, прив'язаним до параметра профілю)",
					Строка_.Профиль, ИмяОбъекта));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КолонкиЗапроса(Текст)
	// Имена колонок последнего запроса пакета через запятую - для outputSchema; пусто, если не разобрать.

	Схема = Новый СхемаЗапроса;
	Попытка
		Схема.УстановитьТекстЗапроса(Текст);
	Исключение
		Возврат "";
	КонецПопытки;
	Последний = Схема.ПакетЗапросов[Схема.ПакетЗапросов.Количество() - 1];
	Если ТипЗнч(Последний) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
		Возврат "";
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Колонка Из Последний.Колонки Цикл
		Имена.Добавить(Колонка.Псевдоним);
	КонецЦикла;
	Возврат Лев(СтрСоединить(Имена, ","), 1000);

КонецФункции

Функция ИзмененияИнструмента()
	// Что изменилось по сравнению с записанной версией: то, что видит модель и что выполняет сервер.

	Изменения = Новый Массив;
	Если ЭтоНовый() Тогда
		Изменения.Добавить("новий інструмент");
		Возврат Изменения;
	КонецЕсли;
	// Записанная версия читается одним пакетом: шапка и обе табличные части.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Инструменты.Имя КАК Имя,
	|	Инструменты.Вид КАК Вид,
	|	Инструменты.Описание КАК Описание,
	|	Инструменты.ТекстЗапроса КАК ТекстЗапроса,
	|	Инструменты.СхемаКомпоновки КАК СхемаКомпоновки,
	|	Инструменты.ИмяМодуля КАК ИмяМодуля,
	|	Инструменты.ИмяМетода КАК ИмяМетода,
	|	Инструменты.ЛимитСтрок КАК ЛимитСтрок,
	|	Инструменты.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты КАК Инструменты
	|ГДЕ
	|	Инструменты.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Параметры.Имя КАК Имя,
	|	Параметры.ИмяПараметра КАК ИмяПараметра,
	|	Параметры.ТипЗначения КАК ТипЗначения,
	|	Параметры.Описание КАК Описание,
	|	Параметры.Обязательный КАК Обязательный,
	|	Параметры.Список КАК Список,
	|	Параметры.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	Параметры.ДопустимыеЗначения КАК ДопустимыеЗначения,
	|	Параметры.ПараметрПрофиля КАК ПараметрПрофиля
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты.Параметры КАК Параметры
	|ГДЕ
	|	Параметры.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Параметры.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Профили.Профиль КАК Профиль
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты.Профили КАК Профили
	|ГДЕ
	|	Профили.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Профили.НомерСтроки");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[0].Выбрать();
	Если Не Выборка.Следующий() Тогда
		Изменения.Добавить("новий інструмент");
		Возврат Изменения;
	КонецЕсли;
	Для Каждого Реквизит Из СтрРазделить("Имя,Вид,Описание,ТекстЗапроса,СхемаКомпоновки,ИмяМодуля,ИмяМетода,ЛимитСтрок,"
		+ "ПометкаУдаления", ",") Цикл
		Если Выборка[Реквизит] <> ЭтотОбъект[Реквизит] Тогда
			Изменения.Добавить(Реквизит);
		КонецЕсли;
	КонецЦикла;
	КолонкиПараметров = "Имя,ИмяПараметра,ТипЗначения,Описание,Обязательный,Список,ЗначениеПоУмолчанию,"
		+ "ДопустимыеЗначения,ПараметрПрофиля";
	Если ПредставлениеТаблицы(Параметры.Выгрузить(, КолонкиПараметров))
		<> ПредставлениеТаблицы(Результаты[1].Выгрузить()) Тогда
		Изменения.Добавить("Параметры");
	КонецЕсли;
	Если ПредставлениеТаблицы(Профили.Выгрузить(, "Профиль")) <> ПредставлениеТаблицы(Результаты[2].Выгрузить()) Тогда
		Изменения.Добавить("Профили");
	КонецЕсли;
	Возврат Изменения;

КонецФункции

Функция ПредставлениеТаблицы(Таблица)
	// Строка с содержимым табличной части для сравнения версий.

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Значения = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если Колонка.Имя <> "НомерСтроки" Тогда
				Значения.Добавить(Строка(СтрокаТаблицы[Колонка.Имя]));
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Значения, Символы.Таб));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ЕстьДругойИнструментСИменем(ИмяИнструмента)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Инструменты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты КАК Инструменты
	|ГДЕ
	|	Инструменты.Имя = &Имя
	|	И Инструменты.Ссылка <> &Ссылка
	|	И НЕ Инструменты.ПометкаУдаления");
	Запрос.УстановитьПараметр("Имя", ИмяИнструмента);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура СообщитьОбОшибке(Текст_, Поле, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст_;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

Процедура Предупредить(Текст_)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Увага: " + Текст_;
	Сообщение.Сообщить();

КонецПроцедуры


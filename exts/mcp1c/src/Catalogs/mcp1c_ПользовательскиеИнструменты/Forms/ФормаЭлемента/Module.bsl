#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастроитьСтраницы();
	ОбновитьОписаниеНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьОписаниеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидПриИзменении(Элемент)

	НастроитьСтраницы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КонструкторЗапроса(Команда)

	#Если ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Тогда
	Конструктор = Новый КонструкторЗапроса;
	Если Не ПустаяСтрока(Объект.ТекстЗапроса) Тогда
		Попытка
			Конструктор.Текст = Объект.ТекстЗапроса;
		Исключение
			ПоказатьПредупреждение(, "Конструктор не розібрав запит: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	Конструктор.Показать(Новый ОписаниеОповещения("КонструкторЗапросаЗавершение", ЭтотОбъект));
	#Иначе
	ПоказатьПредупреждение(, "Конструктор запиту платформи доступний у товстому клієнті. У тонкому клієнті складіть "
		+ "запит у конструкторі конфігуратора чи в консолі запитів і вставте текст сюди; «Параметри з тексту» "
		+ "додасть його параметри.");
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметры(Команда)

	Итог = ЗаполнитьПараметрыНаСервере();
	Если Не ПустаяСтрока(Итог.Ошибка) Тогда
		ПоказатьПредупреждение(, Итог.Ошибка);
	ИначеЕсли Итог.Добавлено = 0 Тогда
		ПоказатьПредупреждение(, "Нових параметрів у тексті немає: усі вже є в «Параметри»");
	Иначе
		Модифицированность = Истина;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПараметры;
		ПоказатьОповещениеПользователя(СтрШаблон("Додано параметрів: %1", Итог.Добавлено), ,
			"Перевірте імена аргументів, типи й описи для моделі");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)

	Если ПроверитьЗаполнение() Тогда
		ПоказатьОповещениеПользователя("Помилок не знайдено", , "Попередження, якщо є, - у повідомленнях");
	КонецЕсли;
	ОбновитьОписаниеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Тест(Команда)

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ТестПослеВопроса", ЭтотОбъект),
			"Перед тестом інструмент потрібно записати. Записати?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	ОткрытьПесочницу();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОписание(Команда)

	ОбновитьОписаниеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик закрытия конструктора запроса.
//
// Параметры:
//  Текст - Строка, Неопределено - текст запроса; Неопределено - конструктор закрыт без сохранения.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура КонструкторЗапросаЗавершение(Текст, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Текст) = Тип("Строка") Тогда
		Объект.ТекстЗапроса = Текст;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

// Обработчик ответа на предложение записать инструмент перед тестом.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ТестПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да И Записать() Тогда
		ОткрытьПесочницу();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПесочницу()
	// Песочница с клиентом, профилю которого назначен инструмент, и выбранным вызовом инструмента.

	ПараметрыФормы = Новый Структура("Клиент, Инструмент", КлиентДляТеста(Объект.Ссылка), Объект.Имя);
	ОткрытьФорму("ОбщаяФорма.mcp1c_Песочница", ПараметрыФормы, ЭтотОбъект, Объект.Ссылка);

КонецПроцедуры

&НаСервереБезКонтекста
Функция КлиентДляТеста(Инструмент)
	// Первый по наименованию незаблокированный клиент, профилю которого назначен инструмент.

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Клиенты.Ссылка КАК Ссылка,
	|	Клиенты.Наименование КАК Наименование
	|ИЗ
	|	Справочник.mcp1c_КлиентыДоступа КАК Клиенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.mcp1c_ПользовательскиеИнструменты.Профили КАК ПрофилиИнструмента
	|		ПО Клиенты.Профиль = ПрофилиИнструмента.Профиль
	|ГДЕ
	|	ПрофилиИнструмента.Ссылка = &Инструмент
	|	И НЕ Клиенты.ПометкаУдаления
	|	И НЕ Клиенты.Заблокирован
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	Запрос.УстановитьПараметр("Инструмент", Инструмент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.mcp1c_КлиентыДоступа.ПустаяСсылка();

КонецФункции

&НаСервере
Процедура НастроитьСтраницы()
	// Страница текста - по виду инструмента: запрос, схема компоновки или метод модуля.

	Виды = Перечисления.mcp1c_ВидыПользовательскихИнструментов;
	Элементы.СтраницаЗапрос.Видимость = (Объект.Вид = Виды.Запрос Или Не ЗначениеЗаполнено(Объект.Вид));
	Элементы.СтраницаСхема.Видимость = (Объект.Вид = Виды.КомпоновкаДанных);
	Элементы.СтраницаМетод.Видимость = (Объект.Вид = Виды.МетодМодуля);

КонецПроцедуры

&НаСервере
Процедура ОбновитьОписаниеНаСервере()
	// Описание инструмента для tools/list по данным формы и ошибки определения, если они есть.

	Попытка
		Определение = РеквизитФормыВЗначение("Объект").ОпределениеИнструмента();
		Текст = mcp1c_Сериализация.ФорматированныйJSON(mcp1c_ПользовательскиеИнструменты.ОписаниеИнструмента(Определение));
		Ошибки = mcp1c_ПользовательскиеИнструменты.ОшибкиОпределения(Определение);
	Исключение
		ОписаниеДляМодели = "Опис не побудовано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	Если Ошибки.Количество() > 0 Тогда
		Текст = "Помилки визначення - інструмент не потрапить у tools/list:" + Символы.ПС + "- "
			+ СтрСоединить(Ошибки, Символы.ПС + "- ") + Символы.ПС + Символы.ПС + Текст;
	КонецЕсли;
	ОписаниеДляМодели = Текст;

КонецПроцедуры

// Добавляет в «Параметры» параметры из текста запроса или схемы компоновки, которых там еще нет.
//
// Возвращаемое значение:
//  Структура:
//   * Добавлено - Число - добавлено строк.
//   * Ошибка - Строка - текст не разобран; пустая строка - разобран.
//
&НаСервере
Функция ЗаполнитьПараметрыНаСервере()

	Итог = Новый Структура("Добавлено, Ошибка", 0, "");
	Попытка
		Найденные = НайденныеПараметры();
	Исключение
		Итог.Ошибка = "Текст не розібрано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	Описанные = Новый Соответствие;
	Для Каждого Строка_ Из Объект.Параметры Цикл
		Имя = ?(ПустаяСтрока(Строка_.ИмяПараметра), Строка_.Имя, Строка_.ИмяПараметра);
		Описанные.Вставить(НРег(СокрЛП(Имя)), Истина);
	КонецЦикла;
	Для Каждого Найденный Из Найденные Цикл
		Если Описанные.Получить(НРег(Найденный.Имя)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка_ = Объект.Параметры.Добавить();
		Строка_.ИмяПараметра = Найденный.Имя;
		Строка_.Имя = mcp1c_ПользовательскиеИнструменты.ИмяАргумента(Найденный.Имя);
		Строка_.ТипЗначения = Найденный.Типы;
		Строка_.Обязательный = Истина;
		Итог.Добавлено = Итог.Добавлено + 1;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Параметры текста запроса (Запрос.НайтиПараметры) или схемы компоновки.
//
// Возвращаемое значение:
//  Массив из см. НовыйНайденныйПараметр
//
&НаСервере
Функция НайденныеПараметры()

	Результат = Новый Массив;
	Если Объект.Вид = Перечисления.mcp1c_ВидыПользовательскихИнструментов.КомпоновкаДанных Тогда
		Схема = mcp1c_ВыполнениеЗапросов.СхемаКомпоновкиИзXML(Объект.СхемаКомпоновки);
		Для Каждого Параметр Из Схема.Параметры Цикл
			Результат.Добавить(НовыйНайденныйПараметр(Параметр.Имя, Параметр.ТипЗначения));
		КонецЦикла;
	Иначе
		Запрос = Новый Запрос(Объект.ТекстЗапроса);
		Для Каждого Параметр Из Запрос.НайтиПараметры() Цикл
			Результат.Добавить(НовыйНайденныйПараметр(Параметр.Имя, Параметр.ТипЗначения));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Найденный параметр текста.
//
// Параметры:
//  Имя - Строка - имя параметра.
//  ТипЗначения - ОписаниеТипов - типы значения параметра.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя параметра.
//   * Типы - Строка - типы значения через запятую; пустая строка - не определены.
//
&НаСервереБезКонтекста
Функция НовыйНайденныйПараметр(Имя, ТипЗначения)

	Параметр = Новый Структура;
	Параметр.Вставить("Имя", Строка(Имя));
	Параметр.Вставить("Типы", Лев(СтрСоединить(mcp1c_Метаданные.ИменаТипов(ТипЗначения), ","), 255));
	Возврат Параметр;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьПорядок(Журнал, "Момент");
	НастроитьФорму();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	НастроитьФорму();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = mcp1c_АдминистрированиеКлиент.СобытиеИзменениеТокенов() Тогда
		ЗаполнитьТокены();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяПользователяИБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Имена = ИменаПользователейИБ();
	Если Имена.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Список користувачів ІБ недоступний (потрібне право «Адміністрування»): "
			+ "введіть ім'я користувача вручну.");
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Имена);
	Текущий = Список.НайтиПоЗначению(Объект.ИмяПользователяИБ);
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ИмяПользователяИБПослеВыбора", ЭтотОбъект), Список, Элемент,
		Текущий);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыпуститьТокен(Команда)

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ВыпуститьТокенПослеВопроса", ЭтотОбъект),
			"Перед видачею токена клієнта потрібно записати. Записати?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеКлиент.ВыпуститьТокен(Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ОтозватьТокен(Команда)

	ТекущиеДанные = Элементы.Токены.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеКлиент.ОтозватьТокен(ТекущиеДанные.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТокены(Команда)

	ЗаполнитьТокены();

КонецПроцедуры

&НаКлиенте
Процедура СнятьБлокировку(Команда)

	СнятьБлокировкуНаСервере();
	ПоказатьОповещениеПользователя("Блокування клієнта знято");

КонецПроцедуры

&НаКлиенте
Процедура ВыдатьКодПодключенияOAuth(Команда)

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ВыдатьКодПодключенияOAuthПослеВопроса", ЭтотОбъект),
			"Перед видачею коду підключення клієнта потрібно записати. Записати?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	ВыдатьКодПодключенияOAuthНаСервере();
	ПоказатьОповещениеПользователя("Код підключення видано", , "Передайте його користувачу: код діє кілька хвилин");

КонецПроцедуры

&НаКлиенте
Процедура ОтозватьПодключениеOAuth(Команда)

	ТекущиеДанные = Элементы.ПодключенияOAuth.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтозватьПодключениеOAuthПослеВопроса", ЭтотОбъект, ТекущиеДанные.Ссылка),
		СтрШаблон("Відкликати підключення %1? AI-клієнт втратить доступ з наступного запиту.",
			ТекущиеДанные.Идентификатор), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПодключенияOAuth(Команда)

	ЗаполнитьПодключенияOAuth();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик выбора пользователя ИБ из списка.
//
// Параметры:
//  ВыбранныйЭлемент - ЭлементСпискаЗначений, Неопределено - выбранный пользователь.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ИмяПользователяИБПослеВыбора(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.ИмяПользователяИБ = ВыбранныйЭлемент.Значение;
	Модифицированность = Истина;

КонецПроцедуры

// Обработчик ответа на предложение записать клиента перед выпуском токена.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ВыпуститьТокенПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Или Не Записать() Тогда
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеКлиент.ВыпуститьТокен(Объект.Ссылка);

КонецПроцедуры

// Обработчик ответа на предложение записать клиента перед выдачей кода подключения OAuth.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ВыдатьКодПодключенияOAuthПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Или Не Записать() Тогда
		Возврат;
	КонецЕсли;
	ВыдатьКодПодключенияOAuthНаСервере();

КонецПроцедуры

// Обработчик подтверждения отзыва подключения OAuth.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  Подключение - СправочникСсылка.mcp1c_ПодключенияOAuth - подключение.
//
&НаКлиенте
Процедура ОтозватьПодключениеOAuthПослеВопроса(Ответ, Подключение) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОтозватьПодключениеOAuthНаСервере(Подключение);
	ПоказатьОповещениеПользователя("Підключення OAuth відкликано");

КонецПроцедуры

&НаСервере
Процедура ВыдатьКодПодключенияOAuthНаСервере()

	Итог = mcp1c_Администрирование.ВыдатьКодПодключенияOAuth(Объект.Ссылка);
	КодПодключенияOAuth = Итог.Инструкция;
	Элементы.КодПодключенияOAuth.Видимость = Истина;
	ЗаполнитьПодключенияOAuth();

КонецПроцедуры

&НаСервере
Процедура ОтозватьПодключениеOAuthНаСервере(Знач Подключение)

	mcp1c_Администрирование.ОтозватьПодключениеOAuth(Подключение);
	ЗаполнитьПодключенияOAuth();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодключенияOAuth()
	// Подключения OAuth клиента без хешей, новые сверху; даты - местное время сеанса.

	ПодключенияOAuth.Очистить();
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ЧасовойПояс = ЧасовойПоясСеанса();
	Для Каждого Описание Из mcp1c_Администрирование.СписокПодключенийOAuth(Объект.Ссылка) Цикл
		Строка_ = ПодключенияOAuth.Добавить();
		ЗаполнитьЗначенияСвойств(Строка_, Описание, "Ссылка, Идентификатор, Приложение, Состояние");
		ЗаполнитьЗначенияСвойств(Строка_, Описание, "Области, ХостВозврата, Автор");
		Строка_.ДатаПодключения = МестноеВремяЕслиЗадано(Описание.ДатаПодключения, ЧасовойПояс);
		Строка_.ДействуетДо = МестноеВремяЕслиЗадано(?(ЗначениеЗаполнено(Описание.ДатаПодключения),
			Описание.ДействуетДо, Описание.КодПодключенияДо), ЧасовойПояс);
		Если Описание.ПоследнееИспользование <> Неопределено Тогда
			Строка_.ПоследнееИспользование = МестноеВремя(Описание.ПоследнееИспользование, ЧасовойПояс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция МестноеВремяЕслиЗадано(Значение, ЧасовойПояс)
	// Местное время для заполненной даты; пустая дата остается пустой.

	Возврат ?(ЗначениеЗаполнено(Значение), МестноеВремя(Значение, ЧасовойПояс), Дата(1, 1, 1));

КонецФункции

&НаСервереБезКонтекста
Функция ИменаПользователейИБ()
	// Имена пользователей ИБ для выбора; без права Администрирование список недоступен.

	Имена = Новый Массив;
	Попытка
		Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение
		Возврат Имена;
	КонецПопытки;
	Для Каждого Пользователь Из Пользователи Цикл
		Имена.Добавить(Пользователь.Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

&НаСервере
Процедура НастроитьФорму()
	// Токены и журнал клиента, состояние блокировки и доступность команд.

	Клиент = Объект.Ссылка;
	Журнал.Параметры.УстановитьЗначениеПараметра("Клиент", Клиент);
	ЗаполнитьТокены();
	ЗаполнитьПодключенияOAuth();

	ЕстьПрава = mcp1c_Администрирование.ЕстьПраваАдминистратора();
	ЭтоНовый = Клиент.Пустая();
	Элементы.ДекорацияТокеныНовыйКлиент.Видимость = ЭтоНовый;
	Элементы.ТокеныВыпуститьТокен.Видимость = ЕстьПрава;
	Элементы.ТокеныОтозватьТокен.Видимость = ЕстьПрава;
	Элементы.ДекорацияOAuthНовыйКлиент.Видимость = ЭтоНовый;
	Элементы.ПодключенияOAuthВыдатьКод.Видимость = ЕстьПрава;
	Элементы.ПодключенияOAuthОтозвать.Видимость = ЕстьПрава;

	Секунд = ?(ЭтоНовый, 0, mcp1c_Лимиты.ОсталосьБлокировкиКлиента(Клиент));
	Элементы.ГруппаБлокировка.Видимость = Секунд > 0;
	Элементы.КнопкаСнятьБлокировку.Видимость = ЕстьПрава;
	Если Секунд > 0 Тогда
		Элементы.ДекорацияБлокировка.Заголовок = СтрШаблон(
			"Клієнта автоматично заблоковано після серії відмов політики: ще %1.",
			mcp1c_Статистика.ПредставлениеОстатка(Секунд));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СнятьБлокировкуНаСервере()

	mcp1c_Администрирование.СнятьБлокировкуКлиента(Объект.Ссылка);
	НастроитьФорму();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТокены()
	// Токены клиента без хешей, новые сверху; даты - местное время сеанса.

	Токены.Очистить();
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ЧасовойПояс = ЧасовойПоясСеанса();
	Сейчас = ТекущаяУниверсальнаяДата();
	Для Каждого Описание Из mcp1c_Администрирование.ОписанияТокенов(Объект.Ссылка) Цикл
		Строка_ = Токены.Добавить();
		ЗаполнитьЗначенияСвойств(Строка_, Описание, "Ссылка, Идентификатор, Наименование, ОбластьДоступа, Автор");
		Строка_.Состояние = СостояниеТокена(Описание, Сейчас);
		Строка_.ДатаВыпуска = МестноеВремя(Описание.ДатаВыпуска, ЧасовойПояс);
		Строка_.ДействуетДо = МестноеВремя(Описание.ДействуетДо, ЧасовойПояс);
		Если Описание.ПоследнееИспользование <> Неопределено Тогда
			Строка_.ПоследнееИспользование = МестноеВремя(Описание.ПоследнееИспользование, ЧасовойПояс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СостояниеТокена(Описание, Сейчас)
	// Состояние для списка; за 7 дней до окончания - сколько осталось (п. 6.3 ТЗ).

	Если Описание.Отозван Тогда
		Возврат "відкликано";
	ИначеЕсли Не Описание.Действует Тогда
		Возврат "минув термін";
	КонецЕсли;
	Секунд = Описание.ДействуетДо - Сейчас;
	Если Секунд < 7 * 86400 Тогда
		Возврат "діє, спливає за " + mcp1c_Статистика.ПредставлениеОстатка(Секунд);
	КонецЕсли;
	Возврат "діє";

КонецФункции

&НаСервере
Процедура УстановитьПорядок(Список, Поле)
	// Порядок списка по умолчанию: сначала новые записи.

	Элемент = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	Элемент.Поле = Новый ПолеКомпоновкиДанных(Поле);
	Элемент.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	Элемент.Использование = Истина;

КонецПроцедуры

#КонецОбласти

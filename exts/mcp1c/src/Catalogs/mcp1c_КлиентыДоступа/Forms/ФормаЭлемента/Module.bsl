#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьПорядок(Токены, "ДатаВыпуска");
	УстановитьПорядок(Журнал, "Момент");
	НастроитьСписки();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	НастроитьСписки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяПользователяИБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Имена = ИменаПользователейИБ();
	Если Имена.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Список користувачів ІБ недоступний (потрібне право «Адміністрування»): "
			+ "введіть ім'я користувача вручну.");
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Имена);
	Текущий = Список.НайтиПоЗначению(Объект.ИмяПользователяИБ);
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ИмяПользователяИБПослеВыбора", ЭтотОбъект), Список, Элемент,
		Текущий);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыпуститьТокен(Команда)

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ВыпуститьТокенПослеВопроса", ЭтотОбъект),
			"Перед видачею токена клієнта потрібно записати. Записати?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеКлиент.ВыпуститьТокен(Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ОтозватьТокен(Команда)

	ТекущиеДанные = Элементы.Токены.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеКлиент.ОтозватьТокен(ТекущиеДанные.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура СнятьБлокировку(Команда)

	СнятьБлокировкуНаСервере();
	ПоказатьОповещениеПользователя("Блокування клієнта знято");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик выбора пользователя ИБ из списка.
//
// Параметры:
//  ВыбранныйЭлемент - ЭлементСпискаЗначений, Неопределено - выбранный пользователь.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ИмяПользователяИБПослеВыбора(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.ИмяПользователяИБ = ВыбранныйЭлемент.Значение;
	Модифицированность = Истина;

КонецПроцедуры

// Обработчик ответа на предложение записать клиента перед выпуском токена.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ВыпуститьТокенПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Или Не Записать() Тогда
		Возврат;
	КонецЕсли;
	mcp1c_АдминистрированиеКлиент.ВыпуститьТокен(Объект.Ссылка);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИменаПользователейИБ()
	// Имена пользователей ИБ для выбора; без права Администрирование список недоступен.

	Имена = Новый Массив;
	Попытка
		Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение
		Возврат Имена;
	КонецПопытки;
	Для Каждого Пользователь Из Пользователи Цикл
		Имена.Добавить(Пользователь.Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

&НаСервере
Процедура НастроитьСписки()
	// Отбор списков по клиенту, состояние блокировки и доступность команд.

	Клиент = Объект.Ссылка;
	Токены.Параметры.УстановитьЗначениеПараметра("Клиент", Клиент);
	Токены.Параметры.УстановитьЗначениеПараметра("Сейчас", ТекущаяУниверсальнаяДата());
	Журнал.Параметры.УстановитьЗначениеПараметра("Клиент", Клиент);

	ЕстьПрава = mcp1c_Администрирование.ЕстьПраваАдминистратора();
	ЭтоНовый = Клиент.Пустая();
	Элементы.ДекорацияТокеныНовыйКлиент.Видимость = ЭтоНовый;
	Элементы.ТокеныВыпуститьТокен.Видимость = ЕстьПрава;
	Элементы.ТокеныОтозватьТокен.Видимость = ЕстьПрава;

	Секунд = ?(ЭтоНовый, 0, mcp1c_Лимиты.ОсталосьБлокировкиКлиента(Клиент));
	Элементы.ГруппаБлокировка.Видимость = Секунд > 0;
	Элементы.КнопкаСнятьБлокировку.Видимость = ЕстьПрава;
	Если Секунд > 0 Тогда
		Элементы.ДекорацияБлокировка.Заголовок = СтрШаблон(
			"Клієнта автоматично заблоковано після серії відмов політики: ще %1.",
			mcp1c_Статистика.ПредставлениеОстатка(Секунд));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СнятьБлокировкуНаСервере()

	mcp1c_Администрирование.СнятьБлокировкуКлиента(Объект.Ссылка);
	НастроитьСписки();

КонецПроцедуры

&НаСервере
Процедура УстановитьПорядок(Список, Поле)
	// Порядок списка по умолчанию: сначала новые записи.

	Элемент = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	Элемент.Поле = Новый ПолеКомпоновкиДанных(Поле);
	Элемент.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	Элемент.Использование = Истина;

КонецПроцедуры

#КонецОбласти

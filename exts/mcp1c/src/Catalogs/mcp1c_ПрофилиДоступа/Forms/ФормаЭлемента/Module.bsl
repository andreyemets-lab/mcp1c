#Область ОграниченияСтрок

// Обработчик выбора объекта ограничения.
//
// Параметры:
//  ВыбранныйЭлемент - ЭлементСпискаЗначений, Неопределено - выбранный объект.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ОбъектОграниченияПослеВыбора(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	ТекущиеДанные = Элементы.ОграниченияСтрок.ТекущиеДанные;
	Если ВыбранныйЭлемент <> Неопределено И ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Объект = ВыбранныйЭлемент.Значение;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры


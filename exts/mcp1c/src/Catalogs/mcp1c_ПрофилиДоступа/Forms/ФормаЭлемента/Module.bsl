&НаСервере
Функция ОбъектыПравил()
	// Объекты, для которых в профиле есть правило с именем (без шаблона), - кандидаты для ограничений.

	Результат = Новый Массив;
	Для Каждого СтрокаПравила Из Объект.Объекты Цикл
		Имя = СокрЛП(СтрокаПравила.Объект);
		Если Не ПустаяСтрока(Имя) И СтрНайти(Имя, "*") = 0 И Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПоляОграничения(ПолноеИмя)
	// Поля основной таблицы объекта (без табличных частей и служебных полей), по которым ограничиваются строки.

	Результат = Новый Массив;
	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(ПолноеИмя);
	Если ОбъектМД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Служебные = СтрРазделить("ссылка,пометкаудаления,предопределенный,номерстроки,активность", ",");
	Для Каждого Поле Из mcp1c_Метаданные.ПоляДляПравил(ОбъектМД) Цикл
		Если Поле.Роль <> "tabular_section" И СтрНайти(Поле.Путь, ".") = 0
			И Служебные.Найти(НРег(Поле.Путь)) = Неопределено Тогда
			Результат.Добавить(Поле.Путь);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Инструменты

&НаСервере
Процедура ЗаполнитьВстроенныеИнструменты()
	// Флажки встроенных инструментов: пустой перечень профиля - все встроенные (п. 7.3 ТЗ).

	Заданы = Новый Соответствие;
	Для Каждого Строка_ Из Объект.Инструменты Цикл
		Заданы.Вставить(НРег(СокрЛП(Строка_.Инструмент)), Истина);
	КонецЦикла;
	ВсеВстроенные = (Объект.Инструменты.Количество() = 0);

	Заголовки = Новый Соответствие;
	Для Каждого Описание Из mcp1c_Инструменты.ОписанияИнструментов(mcp1c_ПравилаДоступа.НоваяПолитика()) Цикл
		Заголовки.Вставить(Описание.Получить("name"), Описание.Получить("title"));
	КонецЦикла;

	ВстроенныеИнструменты.Очистить();
	Для Каждого Имя Из mcp1c_ПравилаДоступа.ВстроенныеИнструментыЧтения() Цикл
		Строка_ = ВстроенныеИнструменты.Добавить();
		Строка_.Имя = Имя;
		Строка_.Описание = Заголовки.Получить(Имя);
		Если Имя = "get_context" Тогда
			Строка_.Описание = Строка_.Описание + " (доступний завжди)";
		КонецЕсли;
		Строка_.Пометка = ВсеВстроенные Или Имя = "get_context" Или Заданы.Получить(Имя) <> Неопределено;
	КонецЦикла;
	Элементы.ВстроенныеИнструменты.ТолькоПросмотр = ВсеВстроенные;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПользовательскиеИнструменты()
	// Пользовательские инструменты и промпты, которым назначен этот профиль.

	ПользовательскиеИнструменты.Очистить();
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Инструменты.Ссылка КАК Ссылка,
	|	Инструменты.Имя КАК Имя,
	|	Инструменты.Наименование КАК Заголовок,
	|	ПРЕДСТАВЛЕНИЕ(Инструменты.Вид) КАК Вид
	|ИЗ
	|	Справочник.mcp1c_ПользовательскиеИнструменты КАК Инструменты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.mcp1c_ПользовательскиеИнструменты.Профили КАК ПрофилиИнструментов
	|		ПО Инструменты.Ссылка = ПрофилиИнструментов.Ссылка
	|ГДЕ
	|	ПрофилиИнструментов.Профиль = &Профиль
	|	И НЕ Инструменты.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Промпты.Ссылка,
	|	Промпты.Имя,
	|	Промпты.Наименование,
	|	&ВидПромпт
	|ИЗ
	|	Справочник.mcp1c_Промпты КАК Промпты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.mcp1c_Промпты.Профили КАК ПрофилиПромптов
	|		ПО Промпты.Ссылка = ПрофилиПромптов.Ссылка
	|ГДЕ
	|	ПрофилиПромптов.Профиль = &Профиль
	|	И НЕ Промпты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Имя");
	Запрос.УстановитьПараметр("Профиль", Объект.Ссылка);
	Запрос.УстановитьПараметр("ВидПромпт", "промпт");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПользовательскиеИнструменты.Добавить(), Выборка);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Оформление

&НаСервере
Процедура НастроитьУсловноеОформление()
	// Ячейки, которые не относятся к виду строки, пустые и не редактируются (видимость ячеек условным
	// оформлением скрыла бы заголовки колонок); глобальные запреты и служебные поля не редактируются;
	// недоступное - серым.

	Сравнение = ВидСравненияКомпоновкиДанных;
	Виды = Новый СписокЗначений;
	Виды.Добавить(0);
	Виды.Добавить(9);
	Скрыть("ДеревоРежим, ДеревоВидМаски, ДеревоПараметрМаски", "Дерево.Вид", Сравнение.ВСписке, Виды);
	Скрыть("ДеревоВидМаски, ДеревоПараметрМаски", "Дерево.Вид", Сравнение.Равно, 1);
	Скрыть("ДеревоРежим, ДеревоВидМаски, ДеревоПараметрМаски", "Дерево.Вид", Сравнение.Равно, 2);
	Скрыть("ДеревоРежим", "Дерево.Вид", Сравнение.Равно, 3);

	Элемент = ДобавитьОформление("ДеревоДоступ", "Дерево.Вид", Сравнение.ВСписке, Виды, "ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);

	ДобавитьОформление("ДеревоДоступ, ДеревоРежим, ДеревоВидМаски, ДеревоПараметрМаски", "Дерево.ТолькоПросмотр",
		Сравнение.Равно, Истина, "ТолькоПросмотр", Истина);
	ДобавитьОформление("ДеревоПредставление, ДеревоИмя", "Дерево.Доступ", Сравнение.Равно, Ложь,
		"ЦветТекста", WebЦвета.Серый);

КонецПроцедуры

&НаСервере
Процедура Скрыть(Поля, ПолеОтбора, ВидСравнения, Значение)
	// Пустые нередактируемые ячейки.

	Элемент = ДобавитьОформление(Поля, ПолеОтбора, ВидСравнения, Значение, "ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "");

КонецПроцедуры

&НаСервере
Функция ДобавитьОформление(Поля, ПолеОтбора, ВидСравнения, Значение, Параметр, ЗначениеПараметра)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Для Каждого ИмяПоля Из СтрРазделить(Поля, ",", Ложь) Цикл
		ПолеОформления = Элемент.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(СокрЛП(ИмяПоля));
	КонецЦикла;
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеОтбора);
	Отбор.ВидСравнения = ВидСравнения;
	Отбор.ПравоеЗначение = Значение;
	Элемент.Оформление.УстановитьЗначениеПараметра(Параметр, ЗначениеПараметра);
	Возврат Элемент;

КонецФункции

&НаСервере
Процедура ЗаполнитьПодсказкиЛимитов()
	// Типовые и предельные значения лимитов (п. 7.3 ТЗ) рядом с полями.

	Типовые = mcp1c_ПравилаДоступа.НовыеЛимиты();
	Предельные = mcp1c_ПравилаДоступа.ПредельныеЛимиты();
	РеквизитыЛимитов = Новый Соответствие;
	РеквизитыЛимитов.Вставить("ЛимитСтрок", "СтрокЗаВызов");
	РеквизитыЛимитов.Вставить("ВызововВМинуту", "ВызововВМинуту");
	РеквизитыЛимитов.Вставить("СтрокВСутки", "СтрокВСутки");
	РеквизитыЛимитов.Вставить("ГлубинаПериодаДней", "ГлубинаПериодаДней");
	РеквизитыЛимитов.Вставить("РазмерОтветаКБ", "РазмерОтветаБайт");
	РеквизитыЛимитов.Вставить("ГлубинаРазыменования", "ГлубинаРазыменования");
	Для Каждого Элемент Из РеквизитыЛимитов Цикл
		Делитель = ?(Элемент.Значение = "РазмерОтветаБайт", 1024, 1);
		Элементы["Подсказка" + Элемент.Ключ].Заголовок = СтрШаблон("типово %1, щонайбільше %2",
			Формат(Типовые[Элемент.Значение] / Делитель, "ЧДЦ=0"), Формат(Предельные[Элемент.Значение] / Делитель, "ЧДЦ=0"));
	КонецЦикла;

КонецПроцедуры


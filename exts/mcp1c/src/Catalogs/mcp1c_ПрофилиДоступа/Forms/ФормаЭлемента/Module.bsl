	Представления.Вставить("chart_of_calculation_types", "Плани видів розрахунку");
	Представления.Вставить("information_register", "Регістри відомостей");
	Представления.Вставить("accumulation_register", "Регістри накопичення");
	Представления.Вставить("accounting_register", "Регістри бухгалтерії");
	Представления.Вставить("calculation_register", "Регістри розрахунку");

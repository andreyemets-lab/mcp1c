КонецФункции

&НаСервереБезКонтекста
Функция РежимПоКоду(Код)

	Режимы = Перечисления.mcp1c_РежимыДоступаКОбъектам;
	Если Код = "read" Тогда
		Возврат Режимы.Чтение;
	ИначеЕсли Код = "aggregates" Тогда
		Возврат Режимы.ТолькоАгрегаты;
	ИначеЕсли Код = "deny" Тогда
		Возврат Режимы.Запрещено;
	КонецЕсли;
	Возврат Режимы.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область ИзменениеПравил

&НаСервере
Функция ИзменитьДоступ(ИдентификаторСтроки, Доступ)
	// Флажок «Доступ» объекта или поля: меняется только правило, заданное именем объекта и путем поля.

	СтрокаДерева = Дерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Сообщение = "";
	Политика = ПолитикаФормы();
	Если СтрокаДерева.Вид = 1 Тогда
		ПрименитьИзменениеОбъекта(СтрокаДерева.ПолноеИмя,
			mcp1c_ПравилаДоступа.ИзменениеДоступаОбъекта(Политика, СтрокаДерева.ПолноеИмя, Доступ));
	ИначеЕсли СтрокаДерева.Вид = 2 Или СтрокаДерева.Вид = 3 Тогда
		Изменение = mcp1c_ПравилаДоступа.ИзменениеДоступаПоля(Политика, СтрокаДерева.ПолноеИмя, СтрокаДерева.Путь, Доступ,
			СтрРазделить(СтрокаДерева.Типы, ",", Ложь));
		Если Изменение = "blocked" Тогда
			Сообщение = "Поле приховує правило для шаблону чи табличної частини або глобальна заборона: "
				+ "змініть правила на вкладці «Правила і шаблони»";
		Иначе
			ПрименитьИзменениеПоля(СтрокаДерева.ПолноеИмя, СтрокаДерева.Путь, Изменение);
		КонецЕсли;
	КонецЕсли;
	ОбновитьСостоянияНаСервере();
	Возврат Сообщение;

КонецФункции

&НаСервере
Процедура ИзменитьРежим(ИдентификаторСтроки)
	// Режим объекта задается правилом с его именем; очищенный режим удаляет это правило.

	СтрокаДерева = Дерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Или СтрокаДерева.Вид <> 1 Тогда
		Возврат;
	КонецЕсли;
	СтрокаПравила = ПравилоОбъекта(СтрокаДерева.ПолноеИмя);
	Если Не ЗначениеЗаполнено(СтрокаДерева.Режим) Тогда
		Если СтрокаПравила <> Неопределено Тогда
			Объект.Объекты.Удалить(СтрокаПравила);
		КонецЕсли;
	Иначе
		Если СтрокаПравила = Неопределено Тогда
			СтрокаПравила = НовоеПравилоОбъекта(СтрокаДерева.ПолноеИмя);
		КонецЕсли;
		СтрокаПравила.Режим = СтрокаДерева.Режим;
	КонецЕсли;
	Модифицированность = Истина;
	ОбновитьСостоянияНаСервере();

КонецПроцедуры

&НаСервере
Функция ИзменитьМаску(ИдентификаторСтроки)
	// Маска поля задается правилом с именем объекта и путем поля; очищенная маска снимает это правило.

	СтрокаДерева = Дерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Или СтрокаДерева.Вид <> 3 Тогда
		Возврат "";
	КонецЕсли;
	Возврат УстановитьМаску(СтрокаДерева, СтрокаДерева.ВидМаски, СтрокаДерева.ПараметрМаски);

КонецФункции

&НаСервере
Функция ЗамаскироватьРекомендуемойНаСервере(ИдентификаторСтроки)

	СтрокаДерева = Дерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Или СтрокаДерева.Вид <> 3 Или ПустаяСтрока(СтрокаДерева.КатегорияЧувствительности) Тогда
		Возврат "Виберіть у дереві чутливе поле (заповнена колонка «Чутливе поле»)";
	КонецЕсли;
	Категория = mcp1c_ЧувствительныеДанные.ОписаниеКатегории(СтрокаДерева.КатегорияЧувствительности);
	Возврат УстановитьМаску(СтрокаДерева, mcp1c_АнализДоступа.ВидМаскиПоКоду(Категория.ВидМаски),
		Категория.ПараметрМаски);

КонецФункции

&НаСервере
Функция УстановитьМаску(СтрокаДерева, ВидМаски, ПараметрМаски)
	// Маска в правиле поля с именем объекта и путем; пустой вид маски снимает маску этого правила.

	Действия = Перечисления.mcp1c_ДействияСПолями;
	СтрокаПравила = ПравилоПоля(СтрокаДерева.ПолноеИмя, СтрокаДерева.Путь);
	Сообщение = "";
	Если ЗначениеЗаполнено(ВидМаски) Тогда
		Если СтрокаПравила = Неопределено Тогда
			СтрокаПравила = Объект.Поля.Добавить();
			СтрокаПравила.Объект = СтрокаДерева.ПолноеИмя;
			СтрокаПравила.Поле = СтрокаДерева.Путь;
		КонецЕсли;
		СтрокаПравила.Действие = Действия.Маскировать;
		СтрокаПравила.ВидМаски = ВидМаски;
		СтрокаПравила.ПараметрМаски = ПараметрМаски;
		Модифицированность = Истина;
	ИначеЕсли СтрокаПравила <> Неопределено И СтрокаПравила.Действие = Действия.Маскировать Тогда
		Состояние = mcp1c_ПравилаДоступа.СостояниеОбъекта(ПолитикаФормы(), СтрокаДерева.ПолноеИмя);
		Если Состояние.ТолькоРазрешенныеПоля Тогда
			СтрокаПравила.Действие = Действия.Разрешить;
			СтрокаПравила.ВидМаски = Перечисления.mcp1c_ВидыМасок.ПустаяСсылка();
			СтрокаПравила.ПараметрМаски = 0;
		Иначе
			Объект.Поля.Удалить(СтрокаПравила);
		КонецЕсли;
		Модифицированность = Истина;
	Иначе
		Состояние = mcp1c_ПравилаДоступа.СостояниеПоля(ПолитикаФормы(), СтрокаДерева.ПолноеИмя, СтрокаДерева.Путь,
			СтрРазделить(СтрокаДерева.Типы, ",", Ложь));
		Если Не ПустаяСтрока(Состояние.ВидМаски) Тогда
			Сообщение = "Маску задає правило для шаблону об'єкта чи табличної частини: змініть його на вкладці "
				+ "«Правила і шаблони»";
		КонецЕсли;
	КонецЕсли;
	ОбновитьСостоянияНаСервере();
	Возврат Сообщение;

КонецФункции

&НаСервере
Процедура ПрименитьИзменениеОбъекта(ПолноеИмя, Изменение)
	// Изменение правила объекта (см. mcp1c_ПравилаДоступа.ИзменениеДоступаОбъекта).

	Режимы = Перечисления.mcp1c_РежимыДоступаКОбъектам;
	СтрокаПравила = ПравилоОбъекта(ПолноеИмя);
	Если Изменение = "add_read" Или Изменение = "add_deny" Тогда
		СтрокаПравила = НовоеПравилоОбъекта(ПолноеИмя);
		СтрокаПравила.Режим = ?(Изменение = "add_read", Режимы.Чтение, Режимы.Запрещено);
	ИначеЕсли СтрокаПравила = Неопределено Тогда
		Возврат;
	ИначеЕсли Изменение = "delete" Тогда
		Объект.Объекты.Удалить(СтрокаПравила);
	ИначеЕсли Изменение = "set_read" Тогда
		СтрокаПравила.Режим = Режимы.Чтение;
	ИначеЕсли Изменение = "set_deny" Тогда
		СтрокаПравила.Режим = Режимы.Запрещено;
	Иначе
		Возврат;
	КонецЕсли;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ПрименитьИзменениеПоля(ПолноеИмя, Путь, Изменение)
	// Изменение правила поля (см. mcp1c_ПравилаДоступа.ИзменениеДоступаПоля).

	Действия = Перечисления.mcp1c_ДействияСПолями;
	СтрокаПравила = ПравилоПоля(ПолноеИмя, Путь);
	Если Изменение = "add_allow" Или Изменение = "add_deny" Тогда
		СтрокаПравила = Объект.Поля.Добавить();
		СтрокаПравила.Объект = ПолноеИмя;
		СтрокаПравила.Поле = Путь;
		СтрокаПравила.Действие = ?(Изменение = "add_allow", Действия.Разрешить, Действия.Запретить);
	ИначеЕсли СтрокаПравила = Неопределено Тогда
		Возврат;
	ИначеЕсли Изменение = "delete" Тогда
		Объект.Поля.Удалить(СтрокаПравила);
	ИначеЕсли Изменение = "set_allow" Или Изменение = "set_deny" Тогда
		СтрокаПравила.Действие = ?(Изменение = "set_allow", Действия.Разрешить, Действия.Запретить);
		СтрокаПравила.ВидМаски = Перечисления.mcp1c_ВидыМасок.ПустаяСсылка();
		СтрокаПравила.ПараметрМаски = 0;
	Иначе
		Возврат;
	КонецЕсли;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Функция НовоеПравилоОбъекта(ПолноеИмя)
	// Правило с именем объекта; свойства - как у действующего правила (шаблона), если оно есть.

	Состояние = mcp1c_ПравилаДоступа.СостояниеОбъекта(ПолитикаФормы(), ПолноеИмя);
	СтрокаПравила = Объект.Объекты.Добавить();
	СтрокаПравила.Объект = ПолноеИмя;
	СтрокаПравила.Режим = РежимПоКоду(Состояние.Режим);
	СтрокаПравила.ПолитикаПолей = ?(Состояние.ТолькоРазрешенныеПоля,
		Перечисления.mcp1c_ПолитикиПолей.ТолькоРазрешенные, Перечисления.mcp1c_ПолитикиПолей.ВсеКромеЗапрещенных);
	СтрокаПравила.ОбязательныйФильтрПериода = Состояние.ОбязательныйФильтрПериода;
	СтрокаПравила.МинимальныйРазмерГруппы = Состояние.МинимальныйРазмерГруппы;
	Возврат СтрокаПравила;

КонецФункции

&НаСервере
Функция ПравилоОбъекта(ПолноеИмя)
	// Строка правила с именем объекта (без шаблона); Неопределено - такой нет.

	Имя = НРег(СокрЛП(ПолноеИмя));
	Для Каждого СтрокаПравила Из Объект.Объекты Цикл
		Если НРег(СокрЛП(СтрокаПравила.Объект)) = Имя Тогда
			Возврат СтрокаПравила;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПравилоПоля(ПолноеИмя, Путь)
	// Строка правила поля с именем объекта и путем поля; Неопределено - такой нет.

	Имя = НРег(СокрЛП(ПолноеИмя));
	ПутьПоля = НРег(СокрЛП(Путь));
	Для Каждого СтрокаПравила Из Объект.Поля Цикл
		Если НРег(СокрЛП(СтрокаПравила.Объект)) = Имя И НРег(СокрЛП(СтрокаПравила.Поле)) = ПутьПоля Тогда
			Возврат СтрокаПравила;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции


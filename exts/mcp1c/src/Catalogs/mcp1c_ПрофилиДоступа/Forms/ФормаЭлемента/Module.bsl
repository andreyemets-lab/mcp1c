#Область АнализРисков

// Анализ рисков данных формы и предложение замаскировать чувствительные поля, видимые без маски.
//
&НаКлиенте
Процедура ПоказатьАнализРисков()

	Анализ = АнализРисковНаСервере();
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Анализ.Текст);
	Документ.Показать("Аналіз ризиків профілю");
	Если Анализ.БезМаски > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗамаскироватьПослеВопроса", ЭтотОбъект),
			СтрШаблон("Замаскувати рекомендованими масками %1 чутливих полів, які профіль показує без маски? "
				+ "Правила діятимуть після запису профілю.", Анализ.БезМаски),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	КонецЕсли;

КонецПроцедуры

// Обработчик ответа на предложение замаскировать чувствительные поля.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ЗамаскироватьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Добавлено = ДобавитьРекомендуемыеМаски();
	ПоказатьОповещениеПользователя(СтрШаблон("Додано правил маскування: %1", Добавлено), ,
		"Запишіть профіль, щоб правила почали діяти");

КонецПроцедуры

// Текст анализа рисков и количество чувствительных полей без маски.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - отчет.
//   * БезМаски - Число - чувствительных полей, видимых без маски.
//
&НаСервере
Функция АнализРисковНаСервере()

	Анализ = mcp1c_АнализДоступа.АнализРисковДанных(Объект);
	Результат = Новый Структура;
	Результат.Вставить("Текст", Строка(Анализ.Текст));
	Результат.Вставить("БезМаски", Число(Анализ.БезМаски));
	Возврат Результат;

КонецФункции

&НаСервере
Функция ДобавитьРекомендуемыеМаски()
	// Правила маскирования для чувствительных полей без маски: рекомендованный для категории вид маски.

	Добавлено = 0;
	Маскировать = Перечисления.mcp1c_ДействияСПолями.Маскировать;
	Для Каждого Маска Из mcp1c_АнализДоступа.РекомендуемыеМаскиДанных(Объект) Цикл
		СтрокаПравила = ПравилоПоля(Маска.Объект, Маска.Поле);
		Если СтрокаПравила = Неопределено Тогда
			СтрокаПравила = Объект.Поля.Добавить();
			СтрокаПравила.Объект = Маска.Объект;
			СтрокаПравила.Поле = Маска.Поле;
		КонецЕсли;
		СтрокаПравила.Действие = Маскировать;
		СтрокаПравила.ВидМаски = Маска.ВидМаски;
		СтрокаПравила.ПараметрМаски = Маска.ПараметрМаски;
		Добавлено = Добавлено + 1;
	КонецЦикла;
	Если Добавлено > 0 Тогда
		Модифицированность = Истина;
		ОбновитьСостоянияНаСервере();
	КонецЕсли;
	Возврат Добавлено;

КонецФункции

#КонецОбласти

#Область Дерево

&НаКлиенте
Процедура ПрименитьМаскуТекущейСтроки()

	Если Элементы.Дерево.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Сообщение = ИзменитьМаску(Элементы.Дерево.ТекущаяСтрока);
	Если Не ПустаяСтрока(Сообщение) Тогда
		ПоказатьПредупреждение(, Сообщение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПостроитьДерево()
	// При поиске найденные виды разворачиваются: их объекты уже загружены.

	ПостроитьДеревоНаСервере();
	Если Не ПустаяСтрока(СтрокаПоиска) Тогда
		Для Каждого СтрокаВида Из Дерево.ПолучитьЭлементы() Цикл
			Элементы.Дерево.Развернуть(СтрокаВида.ПолучитьИдентификатор());
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояния()

	ОбновитьСостоянияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПостроитьДеревоНаСервере()
	// Корень - виды объектов; объекты вида загружаются при разворачивании, при поиске - сразу.

	Корень = Дерево.ПолучитьЭлементы();
	Корень.Очистить();
	Политика = ПолитикаФормы();
	Поиск = НРег(СокрЛП(СтрокаПоиска));
	Для Каждого Вид Из mcp1c_Метаданные.ВидыОбъектов() Цикл
		Объекты = ОтобранныеОбъекты(Вид.Код, Политика, Поиск);
		Если Объекты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаВида = Корень.Добавить();
		СтрокаВида.Вид = 0;
		СтрокаВида.КодВида = Вид.Код;
		СтрокаВида.Представление = СтрШаблон("%1 (%2)", ПредставлениеВида(Вид.Код), Формат(Объекты.Количество(), "ЧГ=0"));
		СтрокаВида.Доступ = Истина;
		СтрокаВида.ТолькоПросмотр = Истина;
		Если ПустаяСтрока(Поиск) Тогда
			ДобавитьЗаглушку(СтрокаВида);
		Иначе
			ЗаполнитьОбъекты(СтрокаВида, Объекты, Политика);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПодчиненные(ИдентификаторСтроки)
	// Объекты вида или поля объекта для строки, которую разворачивают.

	СтрокаДерева = Дерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Или СтрокаДерева.Загружено Тогда
		Возврат;
	КонецЕсли;
	Политика = ПолитикаФормы();
	СтрокаДерева.ПолучитьЭлементы().Очистить();
	Если СтрокаДерева.Вид = 0 Тогда
		ЗаполнитьОбъекты(СтрокаДерева, ОтобранныеОбъекты(СтрокаДерева.КодВида, Политика, НРег(СокрЛП(СтрокаПоиска))),
			Политика);
	ИначеЕсли СтрокаДерева.Вид = 1 Тогда
		ЗаполнитьПоля(СтрокаДерева, Политика);
	КонецЕсли;
	СтрокаДерева.Загружено = Истина;

КонецПроцедуры

&НаСервере
Функция ОтобранныеОбъекты(КодВида, Политика, Поиск)
	// Объекты вида по строке поиска и отбору «лише відкриті профілем».

	Результат = Новый Массив;
	Для Каждого ОбъектМД Из mcp1c_Метаданные.ОбъектыВида(КодВида) Цикл
		Если Не ПустаяСтрока(Поиск) И СтрНайти(НРег(ОбъектМД.Имя), Поиск) = 0
			И СтрНайти(НРег(ОбъектМД.Синоним), Поиск) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТолькоДоступные
			И Не mcp1c_ПравилаДоступа.ОбъектДоступен(Политика, mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД)) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ОбъектМД);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьОбъекты(СтрокаВида, Объекты, Политика)
	// Строки объектов вида; поля загружаются при разворачивании объекта.

	ЕстьПоля = ВидыСПолями().Найти(СтрокаВида.КодВида) <> Неопределено;
	Для Каждого ОбъектМД Из Объекты Цикл
		СтрокаОбъекта = СтрокаВида.ПолучитьЭлементы().Добавить();
		СтрокаОбъекта.Вид = 1;
		СтрокаОбъекта.ПолноеИмя = mcp1c_Метаданные.ПолноеИмяОбъекта(ОбъектМД);
		СтрокаОбъекта.Имя = СтрокаОбъекта.ПолноеИмя;
		СтрокаОбъекта.Представление = mcp1c_Метаданные.СинонимОбъекта(ОбъектМД);
		ЗаполнитьСостояниеОбъекта(СтрокаОбъекта, Политика);
		Если ЕстьПоля Тогда
			ДобавитьЗаглушку(СтрокаОбъекта);
		Иначе
			СтрокаОбъекта.Загружено = Истина;
		КонецЕсли;
	КонецЦикла;
	СтрокаВида.Загружено = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоля(СтрокаОбъекта, Политика)
	// Поля объекта и табличные части с их полями (пути - как в правилах полей профиля).

	ОбъектМД = mcp1c_Метаданные.НайтиОбъект(СтрокаОбъекта.ПолноеИмя);
	Если ОбъектМД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Категории = mcp1c_ЧувствительныеДанные.Категории();
	СтрокаТабличнойЧасти = Неопределено;
	Для Каждого Поле Из mcp1c_Метаданные.ПоляДляПравил(ОбъектМД) Цикл
		ЭтоТабличнаяЧасть = (Поле.Роль = "tabular_section");
		Если ЭтоТабличнаяЧасть Или СтрНайти(Поле.Путь, ".") = 0 Или СтрокаТабличнойЧасти = Неопределено Тогда
			СтрокаПоля = СтрокаОбъекта.ПолучитьЭлементы().Добавить();
		Иначе
			СтрокаПоля = СтрокаТабличнойЧасти.ПолучитьЭлементы().Добавить();
		КонецЕсли;
		Если ЭтоТабличнаяЧасть Тогда
			СтрокаТабличнойЧасти = СтрокаПоля;
		КонецЕсли;
		Части = СтрРазделить(Поле.Путь, ".");
		СтрокаПоля.Вид = ?(ЭтоТабличнаяЧасть, 2, 3);
		СтрокаПоля.ПолноеИмя = СтрокаОбъекта.ПолноеИмя;
		СтрокаПоля.Путь = Поле.Путь;
		СтрокаПоля.Имя = Поле.Путь;
		СтрокаПоля.Представление = ?(ПустаяСтрока(Поле.Синоним), Части[Части.ВГраница()], Поле.Синоним);
		СтрокаПоля.Типы = СтрСоединить(Поле.Типы, ",");
		СтрокаПоля.Загружено = Истина;
		Если Не ЭтоТабличнаяЧасть Тогда
			Код = mcp1c_ЧувствительныеДанные.КатегорияПоля(СтрокаОбъекта.ПолноеИмя, Поле.Путь, Поле.Синоним, Категории,
				Поле.Типы);
			Если Не ПустаяСтрока(Код) Тогда
				СтрокаПоля.КатегорияЧувствительности = Код;
				СтрокаПоля.Чувствительное = mcp1c_ЧувствительныеДанные.ОписаниеКатегории(Код).Представление;
			КонецЕсли;
		КонецЕсли;
		ЗаполнитьСостояниеПоля(СтрокаПоля, Политика);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЗаглушку(СтрокаДерева)
	// Пустая подчиненная строка: у строки есть «+», подчиненные загружаются при разворачивании.

	Заглушка = СтрокаДерева.ПолучитьЭлементы().Добавить();
	Заглушка.Вид = 9;
	Заглушка.ТолькоПросмотр = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСостоянияНаСервере()

	ОбновитьСостоянияСтрок(Дерево.ПолучитьЭлементы(), ПолитикаФормы());

КонецПроцедуры

&НаСервере
Процедура ОбновитьСостоянияСтрок(Строки, Политика)
	// Состояние загруженных строк объектов и полей по текущим правилам формы.

	Для Каждого СтрокаДерева Из Строки Цикл
		Если СтрокаДерева.Вид = 1 Тогда
			ЗаполнитьСостояниеОбъекта(СтрокаДерева, Политика);
		ИначеЕсли СтрокаДерева.Вид = 2 Или СтрокаДерева.Вид = 3 Тогда
			ЗаполнитьСостояниеПоля(СтрокаДерева, Политика);
		КонецЕсли;
		Если СтрокаДерева.Загружено Тогда
			ОбновитьСостоянияСтрок(СтрокаДерева.ПолучитьЭлементы(), Политика);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостояниеОбъекта(СтрокаОбъекта, Политика)

	Состояние = mcp1c_ПравилаДоступа.СостояниеОбъекта(Политика, СтрокаОбъекта.ПолноеИмя);
	СтрокаОбъекта.Доступ = Состояние.Доступен;
	СтрокаОбъекта.Режим = РежимПоКоду(Состояние.Режим);
	СтрокаОбъекта.Пояснение = Состояние.Пояснение;
	СтрокаОбъекта.ТолькоПросмотр = Состояние.ЗапрещенГлобально;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостояниеПоля(СтрокаПоля, Политика)

	Состояние = mcp1c_ПравилаДоступа.СостояниеПоля(Политика, СтрокаПоля.ПолноеИмя, СтрокаПоля.Путь,
		СтрРазделить(СтрокаПоля.Типы, ",", Ложь), СтрокаПоля.Вид = 2);
	СтрокаПоля.Доступ = Состояние.Доступно;
	СтрокаПоля.Пояснение = Состояние.Пояснение;
	СтрокаПоля.ТолькоПросмотр = Состояние.Служебное;
	СтрокаПоля.ВидМаски = mcp1c_АнализДоступа.ВидМаскиПоКоду(Состояние.ВидМаски);
	Если ПустаяСтрока(Состояние.ВидМаски) Тогда
		СтрокаПоля.ВидМаски = Перечисления.mcp1c_ВидыМасок.ПустаяСсылка();
	КонецЕсли;
	СтрокаПоля.ПараметрМаски = Состояние.ПараметрМаски;

КонецПроцедуры

&НаСервере
Функция ПолитикаФормы()
	// Политика по данным формы, в том числе не записанным.

	Возврат mcp1c_Политики.ПолитикаДанныхПрофиля(Объект, mcp1c_Настройки.Получить());

КонецФункции

&НаСервереБезКонтекста
Функция ВидыСПолями()
	// Виды объектов, у которых есть поля для правил профиля.

	Возврат СтрРазделить("catalog,document,chart_of_characteristic_types,chart_of_accounts,chart_of_calculation_types,"
		+ "information_register,accumulation_register,accounting_register,calculation_register,business_process,task",
		",");


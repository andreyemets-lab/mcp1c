#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОграниченияСтрок

&НаКлиенте
Процедура ОграниченияСтрокОбъектНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ОбъектыПравил());
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "У профілі немає правил для окремих об'єктів: введіть повне ім'я об'єкта, "
			+ "наприклад Документ.РеализацияТоваровУслуг");
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ОбъектОграниченияПослеВыбора", ЭтотОбъект), Список, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ОграниченияСтрокПолеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ОграниченияСтрок.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.Объект) Тогда
		ПоказатьПредупреждение(, "Спершу вкажіть об'єкт обмеження");
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ПоляОграничения(ТекущиеДанные.Объект));
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Об'єкт не знайдено або в нього немає полів для обмеження");
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПолеОграниченияПослеВыбора", ЭтотОбъект), Список, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ОграниченияСтрокПараметрНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Список = Новый СписокЗначений;
	Для Каждого Строка_ Из Объект.Параметры Цикл
		Если Не ПустаяСтрока(Строка_.Имя) Тогда
			Список.Добавить(СокрЛП(Строка_.Имя));
		КонецЕсли;
	КонецЦикла;
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Параметри профілю не задано: додайте їх у таблицю «Параметри профілю»");
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПараметрОграниченияПослеВыбора", ЭтотОбъект), Список, Элемент);


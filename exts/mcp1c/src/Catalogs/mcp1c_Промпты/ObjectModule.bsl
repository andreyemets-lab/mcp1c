#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Имя - идентификатор промпта для клиента (п. 5.6 ТЗ): шаблон и уникальность.
	Имя = СокрЛП(Имя);
	Если Не mcp1c_Служебный.ЭтоИмяMCP(Имя) Тогда
		СообщитьОбОшибке("Ім'я промпту: латинські малі літери, цифри й _, починається з літери, від 3 до 64 символів "
			+ "(наприклад, debtors_on_date)", "Имя", Отказ);
	ИначеЕсли ЕстьДругойПромптСИменем(Имя) Тогда
		СообщитьОбОшибке(СтрШаблон("Промпт з ім'ям %1 уже є", Имя), "Имя", Отказ);
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		СообщитьОбОшибке("Не заповнено текст промпту", "Текст", Отказ);
	КонецЕсли;

	Имена = Новый Массив;
	Для Каждого Строка_ Из Аргументы Цикл
		ИмяАргумента = СокрЛП(Строка_.Имя);
		Поле = СтрШаблон("Аргументы[%1].Имя", Формат(Строка_.НомерСтроки - 1, "ЧН=0; ЧГ=0"));
		Если Не mcp1c_Служебный.ЭтоИмяАргумента(ИмяАргумента) Тогда
			СообщитьОбОшибке(СтрШаблон("Аргументи, рядок %1: ім'я аргументу - латинські літери, цифри й _, "
				+ "починається з літери або _", Строка_.НомерСтроки), Поле, Отказ);
		ИначеЕсли Имена.Найти(ИмяАргумента) <> Неопределено Тогда
			СообщитьОбОшибке(СтрШаблон("Аргументи, рядок %1: аргумент %2 уже є", Строка_.НомерСтроки, ИмяАргумента),
				Поле, Отказ);
		Иначе
			Имена.Добавить(ИмяАргумента);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Строка_ Из Профили Цикл
		Если Не ЗначениеЗаполнено(Строка_.Профиль) Тогда
			СообщитьОбОшибке(СтрШаблон("Профілі, рядок %1: не вказано профіль доступу", Строка_.НомерСтроки),
				СтрШаблон("Профили[%1].Профиль", Формат(Строка_.НомерСтроки - 1, "ЧН=0; ЧГ=0")), Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Имя = СокрЛП(Имя);
	Для Каждого Строка_ Из Аргументы Цикл
		Строка_.Имя = СокрЛП(Строка_.Имя);
	КонецЦикла;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Текст промпта уходит модели: изменения фиксируются в журнале регистрации.
	mcp1c_Аудит.ЗаписатьИзменениеНастроек(СтрШаблон("Промпт %1 (%2) записан пользователем %3", Имя, Наименование,
		ИмяПользователя()));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьОбОшибке(Текст_, Поле, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст_;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

Функция ЕстьДругойПромптСИменем(ИмяПромпта)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Промпты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.mcp1c_Промпты КАК Промпты
	|ГДЕ
	|	Промпты.Имя = &Имя
	|	И Промпты.Ссылка <> &Ссылка
	|	И НЕ Промпты.ПометкаУдаления");
	Запрос.УстановитьПараметр("Имя", ИмяПромпта);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение "Неприпустимий виклик об'єкта на клієнті.";
#КонецЕсли

// Модульные тесты чистой логики mcp1c (OneScript 2.x).
// Запуск: python tools/run_unit_tests.py - скрипт копирует модули расширения в build/oslib.
#Использовать "../build/oslib"

Перем Пройдено;
Перем Ошибки;

Процедура ВыполнитьФайл(Файл, Рефлектор)

	Попытка
		Тесты = ЗагрузитьСценарий(Файл.ПолноеИмя);
	Исключение
		Ошибки.Добавить(Файл.Имя + ": не удалось загрузить: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Для Каждого Метод Из Рефлектор.ПолучитьТаблицуМетодов(Тесты) Цикл
		Если Не Метод.Экспорт Или Не СтрНачинаетсяС(Метод.Имя, "Тест") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Рефлектор.ВызватьМетод(Тесты, Метод.Имя);
			Пройдено = Пройдено + 1;
			Сообщить("  ok    " + Файл.ИмяБезРасширения + "." + Метод.Имя);
		Исключение
			Текст = Файл.ИмяБезРасширения + "." + Метод.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Ошибки.Добавить(Текст);
			Сообщить("  FAIL  " + Текст);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Пройдено = 0;
Ошибки = Новый Массив;
Рефлектор = Новый Рефлектор;
Каталог = ОбъединитьПути(СтартовыйСценарий().Каталог, "unit");
Для Каждого Файл Из НайтиФайлы(Каталог, "*.os") Цикл
	ВыполнитьФайл(Файл, Рефлектор);
КонецЦикла;

Сообщить(СтрШаблон("Пройдено: %1, ошибок: %2", Пройдено, Ошибки.Количество()));
Для Каждого Текст Из Ошибки Цикл
	Сообщить("FAIL " + Текст);
КонецЦикла;
ЗавершитьРаботу(?(Ошибки.Количество() = 0 И Пройдено > 0, 0, 1));

// Утверждения для модульных тестов mcp1c (OneScript).

Процедура Равно(Фактическое, Ожидаемое, Описание = "") Экспорт

	Если Фактическое <> Ожидаемое Тогда
		ВызватьИсключение СтрШаблон("%1: ожидалось <%2>, получено <%3>", Описание, Ожидаемое, Фактическое);
	КонецЕсли;

КонецПроцедуры

Процедура НеРавно(Фактическое, НеОжидаемое, Описание = "") Экспорт

	Если Фактическое = НеОжидаемое Тогда
		ВызватьИсключение СтрШаблон("%1: значение не должно быть <%2>", Описание, НеОжидаемое);
	КонецЕсли;

КонецПроцедуры

Процедура Истинно(Значение, Описание = "") Экспорт

	Если Значение <> Истина Тогда
		ВызватьИсключение СтрШаблон("%1: ожидалось Истина, получено <%2>", Описание, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура Ложно(Значение, Описание = "") Экспорт

	Если Значение <> Ложь Тогда
		ВызватьИсключение СтрШаблон("%1: ожидалось Ложь, получено <%2>", Описание, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура Неопределено_(Значение, Описание = "") Экспорт

	Если Значение <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("%1: ожидалось Неопределено, получено <%2>", Описание, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура Определено(Значение, Описание = "") Экспорт

	Если Значение = Неопределено Тогда
		ВызватьИсключение СтрШаблон("%1: ожидалось значение, получено Неопределено", Описание);
	КонецЕсли;

КонецПроцедуры

Процедура Содержит(Строка, Подстрока, Описание = "") Экспорт

	Если СтрНайти(Строка, Подстрока) = 0 Тогда
		ВызватьИсключение СтрШаблон("%1: строка <%2> не содержит <%3>", Описание, Строка, Подстрока);
	КонецЕсли;

КонецПроцедуры

Процедура НеСодержит(Строка, Подстрока, Описание = "") Экспорт

	Если СтрНайти(Строка, Подстрока) > 0 Тогда
		ВызватьИсключение СтрШаблон("%1: строка <%2> не должна содержать <%3>", Описание, Строка, Подстрока);
	КонецЕсли;

КонецПроцедуры

Процедура МассивРавен(Фактический, ОжидаемыйСтрокой, Описание = "") Экспорт

	Части = Новый Массив;
	Для Каждого Элемент Из Фактический Цикл
		Части.Добавить(Строка(Элемент));
	КонецЦикла;
	Равно(СтрСоединить(Части, ","), ОжидаемыйСтрокой, Описание);

КонецПроцедуры

// Тесты mcp1c_ФорматОбмена: проверка и канонический вид документа выгрузки настроек.
#Использовать "../../build/oslib"

Функция J(Текст)

	Возврат mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(СтрЗаменить(Текст, "'", """"));

КонецФункции

Функция Разобрать(ТекстРазделов)

	Текст = "{'format': 'mcp1c.settings', 'formatVersion': 1" + ?(ПустаяСтрока(ТекстРазделов), "", ", " + ТекстРазделов) + "}";
	Возврат mcp1c_ФорматОбмена.РазобратьДокумент(J(Текст));

КонецФункции

Функция Ошибки(Разбор)

	Возврат СтрСоединить(Разбор.Ошибки, Символы.ПС);

КонецФункции

Процедура ТестМинимальныйДокумент() Экспорт

	Разбор = Разобрать("");
	Утв.Равно(Ошибки(Разбор), "");
	Документ = Разбор.Документ;
	Утв.Равно(Документ.Получить("format"), "mcp1c.settings");
	Утв.Равно(Документ.Получить("formatVersion"), 1);
	Утв.Равно(Документ.Получить("settings").Количество(), 0, "настроек нет - не меняются");
	Утв.Равно(Документ.Получить("profiles").Количество(), 0);
	Утв.Равно(Документ.Получить("tools").Количество(), 0);
	Утв.Равно(Документ.Получить("prompts").Количество(), 0);

КонецПроцедуры

Процедура ТестЧужойИлиНовыйФормат() Экспорт

	Утв.Содержит(Ошибки(mcp1c_ФорматОбмена.РазобратьДокумент(J("{'profiles': []}"))), "format");
	Утв.Содержит(Ошибки(mcp1c_ФорматОбмена.РазобратьДокумент(J("[1, 2]"))), "Очікується об'єкт JSON");
	Утв.Содержит(Ошибки(mcp1c_ФорматОбмена.РазобратьДокумент(J("{'format': 'mcp1c.settings', 'formatVersion': 2}"))),
		"оновіть розширення");
	Утв.Содержит(Ошибки(mcp1c_ФорматОбмена.РазобратьДокумент(J("{'format': 'mcp1c.settings'}"))), "formatVersion");

КонецПроцедуры

Процедура ТестПрофильПоУмолчанию() Экспорт

	Разбор = Разобрать("'profiles': [{'name': ' Продажі ', 'objects': [{'object': 'Документ.*'}],
		|'fields': [{'object': 'Справочник.Контрагенты', 'field': 'ИНН', 'action': 'MASK'}],
		|'rowRestrictions': [{'object': 'Документ.Реализация', 'field': 'Организация', 'parameter': 'Организации'}]}]");
	Утв.Равно(Ошибки(Разбор), "");
	Профиль = Разбор.Документ.Получить("profiles")[0];
	Утв.Равно(Профиль.Получить("name"), "Продажі", "пробелы по краям убираются");
	Утв.Равно(Профиль.Получить("description"), "");
	Утв.Равно(Профиль.Получить("limits").Получить("rowsPerCall"), 0, "лимит по умолчанию");
	Утв.Равно(Профиль.Получить("includeDeleted"), Ложь);
	Утв.Равно(Профиль.Получить("tools").Количество(), 0);
	Объект = Профиль.Получить("objects")[0];
	Утв.Равно(Объект.Получить("mode"), "read", "режим по умолчанию");
	Утв.Равно(Объект.Получить("fields"), "all");
	Утв.Равно(Объект.Получить("requirePeriod"), Ложь);
	Поле = Профиль.Получить("fields")[0];
	Утв.Равно(Поле.Получить("action"), "mask", "код без учета регистра");
	Утв.Равно(Поле.Получить("mask"), "full", "маска без вида - полная");
	Ограничение = Профиль.Получить("rowRestrictions")[0];
	Утв.Равно(Ограничение.Получить("op"), "eq");
	Утв.Равно(Ограничение.Получить("value"), "");
	Утв.Равно(Ограничение.Получить("parameter"), "Организации");

КонецПроцедуры

Процедура ТестОшибкиПрофилей() Экспорт

	Разбор = Разобрать("'profiles': [{'name': 'Продажі', 'tools': ['Query Records', 'query_records'],
		|'limits': {'rowsPerCall': -1, 'rowsPerDay': 1.5},
		|'objects': [{'object': 'Документ.*', 'mode': 'write', 'minGroupSize': 'five'}, {'mode': 'read'}],
		|'fields': [{'object': 'Справочник.Контрагенты', 'field': 'ИНН', 'action': 'mask', 'mask': 'blur'}],
		|'rowRestrictions': [{'object': 'Документ.Реализация', 'field': 'Организация'},
		|  {'object': 'Документ.Реализация', 'field': 'Склад', 'value': '{не json'}],
		|'parameters': [{'name': 'Організації ТОВ'}, {'name': 'Регион'}, {'name': 'регион'}]},
		|{'name': 'продажі'}, {'description': 'без имени'}]");
	Текст = Ошибки(Разбор);
	Утв.Содержит(Текст, "profiles[0].tools[0]: «Query Records» - не ім'я інструмента MCP");
	Утв.НеСодержит(Текст, "tools[1]");
	Утв.Содержит(Текст, "profiles[0].limits.rowsPerCall: очікується ціле число від 0");
	Утв.Содержит(Текст, "profiles[0].limits.rowsPerDay");
	Утв.Содержит(Текст, "profiles[0].objects[0].mode: очікується одне зі значень read, aggregates, deny");
	Утв.Содержит(Текст, "profiles[0].objects[0].minGroupSize");
	Утв.Содержит(Текст, "profiles[0].objects[1].object: значення обов'язкове");
	Утв.Содержит(Текст, "profiles[0].fields[0].mask");
	Утв.Содержит(Текст, "profiles[0].rowRestrictions[0]: потрібне value");
	Утв.Содержит(Текст, "profiles[0].rowRestrictions[1].value: некоректний JSON");
	Утв.Содержит(Текст, "profiles[0].parameters[0].name: ім'я параметра - ідентифікатор 1С");
	Утв.Содержит(Текст, "profiles[0].parameters[2].name: «регион» повторюється", "имена параметров без учета регистра");
	Утв.Содержит(Текст, "profiles[1].name: «продажі» повторюється", "наименования профилей без учета регистра");
	Утв.Содержит(Текст, "profiles[2].name: значення обов'язкове");

КонецПроцедуры

Процедура ТестИнструментыИПромпты() Экспорт

	Разбор = Разобрать("'profiles': [{'name': 'Продажі'}],
		|'tools': [{'name': 'customer_debt', 'title': 'Борг клієнта', 'query': '  ВЫБРАТЬ 1  ',
		|  'parameters': [{'name': 'counterparty', 'queryParameter': 'Контрагент', 'types': 'Catalog.Контрагенты',
		|    'required': true}],
		|  'profiles': ['ПРОДАЖІ', 'Фінанси']},
		|  {'name': 'Bad Name', 'kind': 'script', 'parameters': [{'name': 'a b'}, {'name': 'x'}, {'name': 'x'}]}],
		|'prompts': [{'name': 'debtors', 'text': 'Боржники на {{date}}', 'arguments': [{'name': 'date', 'required': true}],
		|  'profiles': ['Фінанси', 'Склад']}, {'name': 'no_text'}]");
	Текст = Ошибки(Разбор);
	Утв.Содержит(Текст, "tools[1].name: латинські малі літери");
	Утв.Содержит(Текст, "tools[1].kind: очікується одне зі значень query, dcs, method");
	Утв.Содержит(Текст, "tools[1].parameters[0].name: ім'я аргументу");
	Утв.Содержит(Текст, "tools[1].parameters[2].name: «x» повторюється");
	Утв.Содержит(Текст, "prompts[1].text: значення обов'язкове");
	Утв.НеСодержит(Текст, "tools[0]");

	Инструмент = Разбор.Документ.Получить("tools")[0];
	Утв.Равно(Инструмент.Получить("kind"), "query", "вид по умолчанию");
	Утв.Равно(Инструмент.Получить("query"), "  ВЫБРАТЬ 1  ", "текст запроса не обрезается");
	Утв.Равно(Инструмент.Получить("parameters")[0].Получить("required"), Истина);
	Утв.МассивРавен(Разбор.ВнешниеПрофили, "Фінанси,Склад", "профили не из файла - каждый один раз; ПРОДАЖІ есть в файле");

КонецПроцедуры

Процедура ТестОбщиеНастройки() Экспорт

	Разбор = Разобрать("'settings': {'instructions': ' Валюта обліку - гривня ', 'bannedFieldPatterns': ['*Пароль*', ' ', '*ПИН*'],
		|'glossary': [{'term': 'ДЗ', 'definition': 'Дебіторська заборгованість'}]}");
	Утв.Равно(Ошибки(Разбор), "");
	Настройки = Разбор.Документ.Получить("settings");
	Утв.Равно(Настройки.Получить("instructions"), "Валюта обліку - гривня");
	Утв.МассивРавен(Настройки.Получить("bannedFieldPatterns"), "*Пароль*,*ПИН*", "пустые шаблоны пропускаются");
	Утв.Равно(Настройки.Получить("glossary").Количество(), 1);
	Утв.Неопределено_(Настройки.Получить("bannedObjectPatterns"), "не переданная настройка не меняется");

	Разбор = Разобрать("'settings': {'glossary': 'ДЗ - дебіторка', 'bannedObjectPatterns': [1]}");
	Текст = Ошибки(Разбор);
	Утв.Содержит(Текст, "settings.glossary: очікується масив");
	Утв.Содержит(Текст, "settings.bannedObjectPatterns[0]: очікується рядок");

КонецПроцедуры

Процедура ТестКаноническийВидУстойчив() Экспорт

	Разбор = Разобрать("'profiles': [{'name': 'Продажі', 'objects': [{'object': 'Документ.*', 'mode': 'AGGREGATES',
		|'minGroupSize': 3}], 'tools': ['query_records']}], 'prompts': [{'name': 'debtors', 'text': 'Текст'}]");
	Утв.Равно(Ошибки(Разбор), "");
	Повторно = mcp1c_ФорматОбмена.РазобратьДокумент(Разбор.Документ);
	Утв.Равно(Ошибки(Повторно), "");
	Утв.Равно(mcp1c_Сериализация.КаноническийJSON(Повторно.Документ), mcp1c_Сериализация.КаноническийJSON(Разбор.Документ),
		"канонический документ разбирается в себя");

КонецПроцедуры

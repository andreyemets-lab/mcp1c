// Тесты mcp1c_ПодключениеКлиентов: фрагменты подключения MCP-клиентов при выпуске токена.
#Использовать "../../build/oslib"

Процедура ТестЗаПрокси() Экспорт

	Текст = mcp1c_ПодключениеКлиентов.ФрагментыПодключения(Новый Массив, "mcp1c_ID_SECRET", " https://mcp.company.ua/mcp ");
	Утв.Содержит(Текст, "claude mcp add --transport http onec https://mcp.company.ua/mcp --header ""Authorization: Bearer mcp1c_ID_SECRET""");
	Утв.Содержит(Текст, "{""Authorization"": ""Bearer mcp1c_ID_SECRET""}", "Cursor");
	Утв.Содержит(Текст, """mcp-remote"", ""https://mcp.company.ua/mcp"", ""--header"", ""Authorization:${MCP1C_AUTH}""",
		"mcp-remote без --allow-http");
	Для Каждого Подстановка Из СтрРазделить("{url},{token},{header},{allow_http}", ",") Цикл
		Утв.НеСодержит(Текст, Подстановка, "подстановка заменена");
	КонецЦикла;

КонецПроцедуры

Процедура ТестПубликацияБезПрокси() Экспорт

	// Публикация 1С забирает Authorization себе: токен - в X-MCP-Authorization; http - с --allow-http.
	Адрес = "http://192.168.1.10:8085/erp-mcp/hs/mcp1c";
	Утв.Равно(mcp1c_ПодключениеКлиентов.ЗаголовокТокена(Адрес), "X-MCP-Authorization");
	Текст = mcp1c_ПодключениеКлиентов.ФрагментыПодключения(Новый Массив, "T", Адрес);
	Утв.Содержит(Текст, "--header ""X-MCP-Authorization: Bearer T""");
	Утв.Содержит(Текст, """" + Адрес + """, ""--allow-http"", ""--header"", ""X-MCP-Authorization:${MCP1C_AUTH}""");

КонецПроцедуры

Процедура ТестАдресНеЗадан() Экспорт

	Текст = mcp1c_ПодключениеКлиентов.ФрагментыПодключения(Новый Массив, "T", "");
	Утв.Содержит(Текст, "https://<адреса-сервера>/mcp");

КонецПроцедуры

Процедура ТестШаблоныИзНастроек() Экспорт

	Шаблон = Новый Соответствие;
	Шаблон.Вставить("title", "VS Code");
	Шаблон.Вставить("text", "code --add-mcp {url} {header} {token}");
	Шаблоны = Новый Массив;
	Шаблоны.Добавить(Шаблон);
	Утв.Равно(mcp1c_ПодключениеКлиентов.ФрагментыПодключения(Шаблоны, "T", "https://x/mcp"),
		"VS Code:" + Символы.ПС + "code --add-mcp https://x/mcp Authorization T");
	Утв.Равно(mcp1c_ПодключениеКлиентов.ОшибкиШаблонов(Шаблоны).Количество(), 0);

	Неполный = Новый Структура("title", "Без тексту");
	Шаблоны.Добавить(Неполный);
	Шаблоны.Добавить("рядок");
	Ошибки = mcp1c_ПодключениеКлиентов.ОшибкиШаблонов(Шаблоны);
	Утв.Равно(Ошибки.Количество(), 2);
	Утв.Содержит(Ошибки[0], "Шаблон 2: не заповнено text");
	Утв.Содержит(Ошибки[1], "Шаблон 3");

КонецПроцедуры

Процедура ТестРазобратьАдрес() Экспорт

	Части = mcp1c_ПодключениеКлиентов.РазобратьАдрес("https://mcp.company.ua/mcp");
	Утв.Истинно(Части.Защищенное);
	Утв.Равно(Части.Хост, "mcp.company.ua");
	Утв.Равно(Части.Порт, 443);
	Утв.Равно(Части.Путь, "/mcp");

	Части = mcp1c_ПодключениеКлиентов.РазобратьАдрес(" HTTP://192.168.1.103:8085/DemoBASERP/hs/mcp1c ");
	Утв.Ложно(Части.Защищенное);
	Утв.Равно(Части.Хост, "192.168.1.103");
	Утв.Равно(Части.Порт, 8085);
	Утв.Равно(Части.Путь, "/DemoBASERP/hs/mcp1c");

	Части = mcp1c_ПодключениеКлиентов.РазобратьАдрес("http://[::1]:8080");
	Утв.Равно(Части.Хост, "::1");
	Утв.Равно(Части.Порт, 8080);
	Утв.Равно(Части.Путь, "/");

	Утв.Равно(mcp1c_ПодключениеКлиентов.РазобратьАдрес("ftp://host/mcp"), Неопределено);
	Утв.Равно(mcp1c_ПодключениеКлиентов.РазобратьАдрес("mcp.company.ua/mcp"), Неопределено);
	Утв.Равно(mcp1c_ПодключениеКлиентов.РазобратьАдрес("https://host:99999/mcp"), Неопределено);
	Утв.Равно(mcp1c_ПодключениеКлиентов.РазобратьАдрес("https://:443/mcp"), Неопределено);

КонецПроцедуры

Процедура ТестИтогПроверкиАдреса() Экспорт

	Итог = mcp1c_ПодключениеКлиентов.ИтогПроверкиАдреса(401, "Bearer realm=""mcp1c""");
	Утв.Истинно(Итог.Успех);
	Итог = mcp1c_ПодключениеКлиентов.ИтогПроверкиАдреса(401, "Basic realm=""1C""");
	Утв.Ложно(Итог.Успех);
	Утв.Содержит(Итог.Текст, "Basic");
	Утв.Содержит(mcp1c_ПодключениеКлиентов.ИтогПроверкиАдреса(503, "").Текст, "503");
	Утв.Содержит(mcp1c_ПодключениеКлиентов.ИтогПроверкиАдреса(404, "").Текст, "/hs/mcp1c");
	Утв.Ложно(mcp1c_ПодключениеКлиентов.ИтогПроверкиАдреса(200, "").Успех);

КонецПроцедуры

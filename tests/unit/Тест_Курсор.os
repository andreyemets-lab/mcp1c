// Тесты mcp1c_Курсор: HMAC-SHA256 (RFC 4231) и курсоры пагинации.
#Использовать "../../build/oslib"

Функция Hex(Данные)

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Данные));

КонецФункции

Функция Повтор(Hex, Количество)

	Части = Новый Массив;
	Для Номер = 1 По Количество Цикл
		Части.Добавить(Hex);
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(СтрСоединить(Части, ""));

КонецФункции

Процедура ТестHMACRFC4231() Экспорт

	// Случай 1: ключ 0x0b * 20.
	Утв.Равно(Hex(mcp1c_Курсор.HMACSHA256(Повтор("0b", 20), "Hi There")),
		"b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", "RFC 4231, случай 1");
	// Случай 2: короткий ключ.
	Утв.Равно(Hex(mcp1c_Курсор.HMACSHA256("Jefe", "what do ya want for nothing?")),
		"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", "RFC 4231, случай 2");
	// Случай 6: ключ длиннее блока хешируется.
	Утв.Равно(Hex(mcp1c_Курсор.HMACSHA256(Повтор("aa", 131), "Test Using Larger Than Block-Size Key - Hash Key First")),
		"60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", "RFC 4231, случай 6");

КонецПроцедуры

Процедура ТестКурсорТудаИОбратно() Экспорт

	Курсор = mcp1c_Курсор.Сформировать("секрет", "клиент-1", "query_records", "abc", 50, 1000);
	Проверка = mcp1c_Курсор.Проверить("секрет", "клиент-1", Курсор, "query_records", "abc", 1500);
	Утв.Истинно(Проверка.Успех, Проверка.Причина);
	Утв.Равно(Проверка.Смещение, 50, "смещение");
	Утв.Ложно(СтрНайти(Курсор, "+") > 0 Или СтрНайти(Курсор, "/") > 0 Или СтрНайти(Курсор, "=") > 0, "base64url");

КонецПроцедуры

Процедура ТестЧужойИлиИзмененныйКурсор() Экспорт

	Курсор = mcp1c_Курсор.Сформировать("секрет", "клиент-1", "query_records", "abc", 50, 1000);

	Утв.Ложно(mcp1c_Курсор.Проверить("секрет", "клиент-2", Курсор, "query_records", "abc", 1000).Успех,
		"курсор другого клиента");
	Утв.Ложно(mcp1c_Курсор.Проверить("другой", "клиент-1", Курсор, "query_records", "abc", 1000).Успех,
		"другой секрет");
	Утв.Ложно(mcp1c_Курсор.Проверить("секрет", "клиент-1", Курсор, "get_balances", "abc", 1000).Успех,
		"другой инструмент");
	Утв.Ложно(mcp1c_Курсор.Проверить("секрет", "клиент-1", Курсор, "query_records", "abd", 1000).Успех,
		"другие аргументы");
	Утв.Ложно(mcp1c_Курсор.Проверить("секрет", "клиент-1", Курсор, "query_records", "abc", 1000 + 3601).Успех,
		"истек срок");

	Части = СтрРазделить(Курсор, ".");
	Подмена = mcp1c_Служебный.КодироватьСтрокуBase64URL(
		"{""v"":1,""t"":""query_records"",""h"":""abc"",""o"":0,""x"":99999999999}");
	Утв.Ложно(mcp1c_Курсор.Проверить("секрет", "клиент-1", Подмена + "." + Части[1], "query_records", "abc", 1000).Успех,
		"подмена тела");

	Для Каждого Мусор Из СтрРазделить("abc|a.b.c|.|" + Части[0] + ".", "|") Цикл
		Утв.Ложно(mcp1c_Курсор.Проверить("секрет", "клиент-1", Мусор, "query_records", "abc", 1000).Успех, Мусор);
	КонецЦикла;
	Утв.Ложно(mcp1c_Курсор.Проверить("секрет", "клиент-1", 123, "query_records", "abc", 1000).Успех, "не строка");

КонецПроцедуры

Процедура ТестОтпечатокАргументов() Экспорт

	Первый = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(
		"{""object"":""Справочник.Контрагенты"",""filters"":[{""field"":""ИНН"",""op"":""eq"",""value"":""123""}],""limit"":10}");
	Второй = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(
		"{""limit"":50,""filters"":[{""value"":""123"",""op"":""eq"",""field"":""ИНН""}],""cursor"":""x.y"",""object"":""Справочник.Контрагенты""}");
	Третий = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(
		"{""object"":""Справочник.Контрагенты"",""filters"":[{""field"":""ИНН"",""op"":""eq"",""value"":""124""}]}");

	Утв.Равно(mcp1c_Курсор.ОтпечатокАргументов(Первый), mcp1c_Курсор.ОтпечатокАргументов(Второй),
		"порядок ключей, limit и cursor не влияют");
	Утв.НеРавно(mcp1c_Курсор.ОтпечатокАргументов(Первый), mcp1c_Курсор.ОтпечатокАргументов(Третий),
		"другой отбор - другой отпечаток");
	Утв.Равно(СтрДлина(mcp1c_Курсор.ОтпечатокАргументов(Первый)), 32);

КонецПроцедуры

Процедура ТестСекундыОтНачалаЭпохи() Экспорт

	Утв.Равно(mcp1c_Курсор.СекундыОтНачалаЭпохи(Дата(1970, 1, 2, 0, 0, 1)), 86401);

КонецПроцедуры

// Тесты mcp1c_ОписанияИнструментов: состав и порядок инструментов, схемы аргументов.
#Использовать "../../build/oslib"

Функция Описания()

	Возврат mcp1c_ОписанияИнструментов.Описания(СтрРазделить("catalog,document,enum", ","),
		СтрРазделить("properties,attributes", ","));

КонецФункции

Функция Описание(Имя)

	Для Каждого Элемент Из Описания() Цикл
		Если Элемент.Получить("name") = Имя Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет инструмента " + Имя;

КонецФункции

Функция Ошибки(Имя, ТекстJSON)

	Результат = Новый Массив;
	Аргументы = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(СтрЗаменить(ТекстJSON, "'", """"));
	mcp1c_СхемаJSON.Проверить(Аргументы, Описание(Имя).Получить("inputSchema"), "arguments", Результат);
	Возврат СтрСоединить(Результат, "; ");

КонецФункции

Процедура ТестСоставИПорядок() Экспорт

	Имена = Новый Массив;
	Для Каждого Элемент Из Описания() Цикл
		Имена.Добавить(Элемент.Получить("name"));
	КонецЦикла;
	Утв.Равно(СтрСоединить(Имена, ","), "get_context,list_objects,describe_object,find_objects,get_object,"
		+ "query_records,get_balances,get_turnovers,get_slice");
	Утв.МассивРавен(Имена, СтрСоединить(mcp1c_ПравилаДоступа.ВстроенныеИнструментыЧтения(), ","),
		"тот же перечень, что разрешается профилем без явного списка");

КонецПроцедуры

Процедура ТестОписанияКорректны() Экспорт

	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789_";
	Для Каждого Элемент Из Описания() Цикл
		Имя = Элемент.Получить("name");
		Утв.Истинно(mcp1c_Служебный.СостоитИзСимволов(Имя, Допустимые) И СтрДлина(Имя) <= 64, Имя);
		Утв.Истинно(СтрДлина(Элемент.Получить("description")) > 50, "описание для модели: " + Имя);
		Схема = Элемент.Получить("inputSchema");
		Утв.Равно(Схема.Получить("type"), "object", Имя);
		Утв.Равно(Схема.Получить("additionalProperties"), Ложь, "лишние аргументы запрещены: " + Имя);
		Утв.Равно(Элемент.Получить("outputSchema").Получить("type"), "object", Имя);
		Аннотации = Элемент.Получить("annotations");
		Утв.Равно(Аннотации.Получить("readOnlyHint"), Истина, Имя);
		Утв.Равно(Аннотации.Получить("destructiveHint"), Ложь, Имя);
		Утв.Равно(Аннотации.Получить("openWorldHint"), Ложь, Имя);
		// Описание сериализуется в JSON без ошибок.
		Утв.Содержит(mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Элемент), """name"":""" + Имя + """");
	КонецЦикла;

КонецПроцедуры

Процедура ТестАргументыQueryRecords() Экспорт

	Утв.Равно(Ошибки("query_records", "{'object':'Документ.РеализацияТоваровУслуг','fields':['Дата','Контрагент'],
	|'filters':[{'field':'Контрагент','op':'eq','value':{'type':'Справочник.Контрагенты','ref':'9b1f'}}],
	|'period':{'from':'2026-09-01','to':'2026-09-30'},'group_by':['Контрагент'],
	|'aggregates':[{'field':'СуммаДокумента','func':'sum','as':'Сума'}],'order_by':[{'field':'Сума','desc':true}],
	|'include_deleted':false,'only_posted':true,'limit':100,'cursor':'abc'}"), "");
	Утв.Содержит(Ошибки("query_records", "{}"), "arguments.object: обов'язковий параметр");
	Утв.Содержит(Ошибки("query_records", "{'object':'X','filters':[{'field':'a','op':'like'}]}"), "допустимі значення");
	Утв.Содержит(Ошибки("query_records", "{'object':'X','limit':1001}"), "не більше 1000");
	Утв.Содержит(Ошибки("query_records", "{'object':'X','period':{'from':'2026-01-01','till':'x'}}"), "невідомий параметр");
	Утв.Содержит(Ошибки("query_records", "{'object':'X','aggregates':[{'field':'a'}]}"), "func: обов'язковий");

КонецПроцедуры

Процедура ТестАргументыРегистров() Экспорт

	Утв.Равно(Ошибки("get_balances", "{'register':'РегистрНакопления.ТоварыНаСкладах','date':'2026-10-19',
	|'group_by':['Номенклатура'],'resources':['Количество']}"), "");
	Утв.Равно(Ошибки("get_balances", "{'register':'РегистрБухгалтерии.Хозрасчетный','account':'361'}"), "");
	Утв.Равно(Ошибки("get_turnovers", "{'register':'РегистрНакопления.Продажи','period':{'from':'2026-01-01',
	|'to':'2026-09-30'},'periodicity':'month','with_balances':true}"), "");
	Утв.Содержит(Ошибки("get_turnovers", "{'register':'X'}"), "arguments.period: обов'язковий параметр");
	Утв.Содержит(Ошибки("get_turnovers", "{'register':'X','period':{'from':'2026-01-01'}}"), "period.to: обов'язковий");
	Утв.Содержит(Ошибки("get_turnovers", "{'register':'X','period':{'from':'a','to':'b'},'periodicity':'decade'}"),
		"допустимі значення");
	Утв.Равно(Ошибки("get_slice", "{'register':'РегистрСведений.КурсыВалют','mode':'first'}"), "");
	Утв.Содержит(Ошибки("get_slice", "{'register':'X','mode':'middle'}"), "допустимі значення");

КонецПроцедуры

Процедура ТестАргументыПоискаИКарточки() Экспорт

	Утв.Равно(Ошибки("find_objects", "{'query':'альфа','objects':['Справочник.Контрагенты'],'limit':5}"), "");
	Утв.Содержит(Ошибки("find_objects", "{'query':'альфа','objects':[]}"), "щонайменше 1");
	Утв.Содержит(Ошибки("find_objects", "{'query':'','objects':['X']}"), "щонайменше 1 символів");
	Утв.Равно(Ошибки("get_object", "{'object':'Документ.X','ref':'4e0c1d2a-0000-0000-0000-000000000001',
	|'tabular_sections':['Товары'],'tabular_limit':0}"), "");
	Утв.Содержит(Ошибки("get_object", "{'object':'Документ.X'}"), "arguments.ref: обов'язковий параметр");

КонецПроцедуры

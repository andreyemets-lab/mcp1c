// Тесты mcp1c_ОписанияРесурсов: URI ресурсов, доступность ресурсов профилю, глоссарий, промпты.
#Использовать "../../build/oslib"

Функция ПолитикаСИнструментами(Имена)

	Политика = mcp1c_ПравилаДоступа.НоваяПолитика();
	Если Не ПустаяСтрока(Имена) Тогда
		Политика.Инструменты = СтрРазделить(Имена, ",");
	КонецЕсли;
	Возврат Политика;

КонецФункции

Функция Значения(Описания, Ключ)

	Результат = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Результат.Добавить(Описание.Получить(Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Повтор(Символ, Количество)

	Результат = "";
	Для Номер = 1 По Количество Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Термин(Термин, Определение)

	Результат = Новый Соответствие;
	Результат.Вставить("term", Термин);
	Результат.Вставить("definition", Определение);
	Возврат Результат;

КонецФункции

Функция АргументыДебиторки()

	Аргументы = Новый Массив;
	Аргументы.Добавить(mcp1c_ОписанияРесурсов.НовыйАргументПромпта("date", "Дата звіту", Истина, "{{today}}"));
	Аргументы.Добавить(mcp1c_ОписанияРесурсов.НовыйАргументПромпта("counterparty", "", Истина));
	Аргументы.Добавить(mcp1c_ОписанияРесурсов.НовыйАргументПромпта("note"));
	Возврат Аргументы;

КонецФункции

Процедура ТестРазборURI() Экспорт

	Утв.Равно(mcp1c_ОписанияРесурсов.РазобратьURI("onec://context").Вид, "context");
	Утв.Равно(mcp1c_ОписанияРесурсов.РазобратьURI("ONEC://Glossary").Вид, "glossary", "схема и вид без учета регистра");

	Разбор = mcp1c_ОписанияРесурсов.РазобратьURI("onec://metadata/Справочник.Контрагенты");
	Утв.Равно(Разбор.Вид, "metadata");
	Утв.Равно(Разбор.Объект, "Справочник.Контрагенты", "кириллица как есть");
	Утв.Равно(Разбор.Ссылка, "");

	Разбор = mcp1c_ОписанияРесурсов.РазобратьURI(
		"onec://metadata/%D0%A1%D0%BF%D1%80%D0%B0%D0%B2%D0%BE%D1%87%D0%BD%D0%B8%D0%BA.%D0%A1%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B");
	Утв.Равно(Разбор.Объект, "Справочник.Склады", "кодировка URL (раскрытие шаблона по RFC 6570)");
	Утв.Равно(mcp1c_ОписанияРесурсов.РазобратьURI("onec://metadata/%d0%a1%d0%ba%d0%bb%d0%b0%d0%b4").Объект, "Склад",
		"шестнадцатеричные цифры в нижнем регистре");
	Утв.Равно(mcp1c_ОписанияРесурсов.РазобратьURI("onec://metadata/%20Справочник.Склады%20").Объект,
		"Справочник.Склады", "пробелы по краям");

	Разбор = mcp1c_ОписанияРесурсов.РазобратьURI("onec://object/Документ.Заказ/4e0c1d2a-0000-4000-8000-000000000001");
	Утв.Равно(Разбор.Вид, "object");
	Утв.Равно(Разбор.Объект, "Документ.Заказ");
	Утв.Равно(Разбор.Ссылка, "4e0c1d2a-0000-4000-8000-000000000001");

КонецПроцедуры

Процедура ТестНекорректныеURI() Экспорт

	Некорректные = Новый Массив;
	Некорректные.Добавить("file:///etc/passwd");
	Некорректные.Добавить("onec:/context");
	Некорректные.Добавить("onec://");
	Некорректные.Добавить("onec://context/");
	Некорректные.Добавить("onec://context?x=1");
	Некорректные.Добавить("onec://context#top");
	Некорректные.Добавить("onec://unknown");
	Некорректные.Добавить("onec://metadata");
	Некорректные.Добавить("onec://metadata/");
	Некорректные.Добавить("onec://metadata/%20");
	Некорректные.Добавить("onec://metadata/a/b");
	Некорректные.Добавить("onec://metadata/%ZZ");
	Некорректные.Добавить("onec://metadata/%4");
	Некорректные.Добавить("onec://object/Документ.Заказ");
	Некорректные.Добавить("onec://object/Документ.Заказ//");
	Некорректные.Добавить("onec://object/Документ.Заказ/1/2");
	Некорректные.Добавить("onec://metadata/" + Повтор("а", 2000));
	Для Каждого URI Из Некорректные Цикл
		Утв.Неопределено_(mcp1c_ОписанияРесурсов.РазобратьURI(URI), URI);
	КонецЦикла;
	Утв.Неопределено_(mcp1c_ОписанияРесурсов.РазобратьURI(5), "не строка");
	Утв.Неопределено_(mcp1c_ОписанияРесурсов.РазобратьURI(Неопределено), "нет uri");

КонецПроцедуры

Процедура ТестИнструментыИАргументыРесурсов() Экспорт

	Контекст = mcp1c_ОписанияРесурсов.РазобратьURI("onec://context");
	Глоссарий = mcp1c_ОписанияРесурсов.РазобратьURI("onec://glossary");
	Метаданные_ = mcp1c_ОписанияРесурсов.РазобратьURI("onec://metadata/Справочник.Склады");
	Объект = mcp1c_ОписанияРесурсов.РазобратьURI(
		"onec://object/%D0%A1%D0%BF%D1%80%D0%B0%D0%B2%D0%BE%D1%87%D0%BD%D0%B8%D0%BA.%D0%A1%D0%BA%D0%BB%D0%B0%D0%B4%D1%8B/"
		+ "4e0c1d2a-0000-4000-8000-000000000001");

	Утв.Равно(mcp1c_ОписанияРесурсов.ИнструментРесурса(Контекст), "get_context");
	Утв.Равно(mcp1c_ОписанияРесурсов.ИнструментРесурса(Глоссарий), "get_context", "глоссарий входит в get_context");
	Утв.Равно(mcp1c_ОписанияРесурсов.ИнструментРесурса(Метаданные_), "describe_object");
	Утв.Равно(mcp1c_ОписанияРесурсов.ИнструментРесурса(Объект), "get_object");
	Утв.Равно(mcp1c_ОписанияРесурсов.ИнструментРесурса(Неопределено), "");

	Утв.Равно(mcp1c_ОписанияРесурсов.АргументыИнструмента(Контекст).Количество(), 0);
	Аргументы = mcp1c_ОписанияРесурсов.АргументыИнструмента(Метаданные_);
	Утв.Равно(Аргументы.Количество(), 1);
	Утв.Равно(Аргументы.Получить("object"), "Справочник.Склады");
	Аргументы = mcp1c_ОписанияРесурсов.АргументыИнструмента(Объект);
	Утв.Равно(Аргументы.Количество(), 2);
	Утв.Равно(Аргументы.Получить("object"), "Справочник.Склады");
	Утв.Равно(Аргументы.Получить("ref"), "4e0c1d2a-0000-4000-8000-000000000001");

	Утв.Равно(mcp1c_ОписанияРесурсов.ПредставлениеURI(Объект, "x"),
		"onec://object/Справочник.Склады/4e0c1d2a-0000-4000-8000-000000000001", "без кодировки URL");
	Утв.Равно(mcp1c_ОписанияРесурсов.ПредставлениеURI(Контекст, "ONEC://Context"), "onec://context");
	Утв.Равно(mcp1c_ОписанияРесурсов.ПредставлениеURI(Неопределено, "file:///x"), "file:///x");
	Утв.Равно(mcp1c_ОписанияРесурсов.ПредставлениеURI(Неопределено, 5), "");

	Утв.Равно(mcp1c_ОписанияРесурсов.СрокКешированияРесурса(Контекст, 300000), 0, "время сервера");
	Утв.Равно(mcp1c_ОписанияРесурсов.СрокКешированияРесурса(Объект, 300000), 0, "данные");
	Утв.Равно(mcp1c_ОписанияРесурсов.СрокКешированияРесурса(Метаданные_, 300000), 300000);
	Утв.Равно(mcp1c_ОписанияРесурсов.СрокКешированияРесурса(Глоссарий, 300000), 300000);
	Утв.Равно(mcp1c_ОписанияРесурсов.СрокКешированияРесурса(Глоссарий, -5), 0, "не меньше 0");
	Утв.Равно(mcp1c_ОписанияРесурсов.СрокКешированияРесурса(Неопределено, 300000), 0);

КонецПроцедуры

Процедура ТестРесурсыПоИнструментамПрофиля() Экспорт

	Политика = ПолитикаСИнструментами("");
	Ресурсы = mcp1c_ОписанияРесурсов.ОписанияРесурсов(Политика);
	Утв.МассивРавен(Значения(Ресурсы, "uri"), "onec://context,onec://glossary", "встроенные инструменты чтения");
	Шаблоны = mcp1c_ОписанияРесурсов.ШаблоныРесурсов(Политика);
	Утв.МассивРавен(Значения(Шаблоны, "uriTemplate"), "onec://metadata/{object},onec://object/{object}/{ref}");
	Для Каждого Описание Из Ресурсы Цикл
		Утв.Равно(Описание.Получить("mimeType"), "application/json");
		Утв.Истинно(СтрДлина(Описание.Получить("description")) > 30, Описание.Получить("name"));
		Утв.Определено(mcp1c_ОписанияРесурсов.РазобратьURI(Описание.Получить("uri")), "uri разбирается");
	КонецЦикла;
	Утв.МассивРавен(Значения(Шаблоны, "name"), "metadata,object");

	Политика = ПолитикаСИнструментами("get_context,query_records");
	Утв.Равно(mcp1c_ОписанияРесурсов.ОписанияРесурсов(Политика).Количество(), 2, "get_context доступен всегда");
	Утв.Равно(mcp1c_ОписанияРесурсов.ШаблоныРесурсов(Политика).Количество(), 0, "нет describe_object и get_object");

	Политика = ПолитикаСИнструментами("describe_object");
	Утв.МассивРавен(Значения(mcp1c_ОписанияРесурсов.ШаблоныРесурсов(Политика), "name"), "metadata");

КонецПроцедуры

Процедура ТестГлоссарийИзСоответствия() Экспорт

	Термины = Новый Соответствие;
	Термины.Вставить("  дебіторка ", " залишок за рахунком 361 у розрізі контрагентів ");
	Термины.Вставить("", "без терміна");
	Термины.Вставить("кредиторка", "  ");
	Глоссарий = mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(Термины);
	Утв.Равно(Глоссарий.Количество(), 1, "пустые термины и определения пропускаются");
	Утв.Равно(Глоссарий[0].Получить("term"), "дебіторка");
	Утв.Равно(Глоссарий[0].Получить("definition"), "залишок за рахунком 361 у розрізі контрагентів");

КонецПроцедуры

Процедура ТестГлоссарийИзМассива() Экспорт

	Термины = Новый Массив;
	Термины.Добавить(Новый Структура("term, definition", "ПДВ", "податок"));
	Термины.Добавить(Термин("пдв", "податок на додану вартість"));
	Термины.Добавить(Новый Структура("term", "без визначення"));
	Термины.Добавить(5);
	Термины.Добавить(Термин(1, "число замість терміна"));
	Термины.Добавить(Термин("ЄДРПОУ", "код юридичної особи"));
	Глоссарий = mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(Термины);
	Утв.МассивРавен(Значения(Глоссарий, "term"), "ПДВ,ЄДРПОУ", "повтор без учета регистра, некорректные пропущены");
	Утв.Равно(Глоссарий[0].Получить("definition"), "податок на додану вартість", "последнее определение");

	Термины = Новый Массив;
	Для Номер = 1 По 501 Цикл
		Термины.Добавить(Термин("t" + Формат(Номер, "ЧГ=0"), "d"));
	КонецЦикла;
	Термины.Добавить(Термин("t1", "повтор сверх предела заменяет определение"));
	Термины.Добавить(Термин(Повтор("т", 300), Повтор("о", 3000)));
	Глоссарий = mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(Термины);
	Утв.Равно(Глоссарий.Количество(), 500, "не больше 500 терминов");
	Утв.Равно(Глоссарий[0].Получить("definition"), "d", "после предела обработка остановлена");

	Глоссарий = mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(
		ЗначениеВМассиве(Термин(Повтор("т", 300), Повтор("о", 3000))));
	Утв.Равно(СтрДлина(Глоссарий[0].Получить("term")), 200);
	Утв.Равно(СтрДлина(Глоссарий[0].Получить("definition")), 2000);

	Утв.Равно(mcp1c_ОписанияРесурсов.НормализованныйГлоссарий("текст").Количество(), 0);
	Утв.Равно(mcp1c_ОписанияРесурсов.НормализованныйГлоссарий(Неопределено).Количество(), 0);

КонецПроцедуры

Функция ЗначениеВМассиве(Значение)

	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;

КонецФункции

Процедура ТестТекстГлоссария() Экспорт

	Глоссарий = Новый Массив;
	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстГлоссария(Глоссарий, 2000), "", "пустой глоссарий");

	Глоссарий.Добавить(Термин("дебіторка", "залишок за рахунком 361"));
	Глоссарий.Добавить(Термин("ПДВ", "податок на додану вартість"));
	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстГлоссария(Глоссарий, 2000),
		"Глосарій бази: дебіторка - залишок за рахунком 361; ПДВ - податок на додану вартість.");

	Текст = mcp1c_ОписанияРесурсов.ТекстГлоссария(Глоссарий, 40);
	Утв.Содержит(Текст, "дебіторка - залишок за рахунком 361");
	Утв.НеСодержит(Текст, "ПДВ", "обрезано по границе термина");
	Утв.Содержит(Текст, "onec://glossary", "ссылка на полный глоссарий");

	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстГлоссария(Глоссарий, 10), "Глосарій бази - ресурс onec://glossary.",
		"первый термин длиннее предела");

КонецПроцедуры

Процедура ТестНачалоГлоссария() Экспорт

	Глоссарий = Новый Массив;
	Глоссарий.Добавить(Термин("аа", "бб"));
	Глоссарий.Добавить(Термин("вв", "гг"));
	Глоссарий.Добавить(Термин("дд", "ее"));
	Утв.Равно(mcp1c_ОписанияРесурсов.НачалоГлоссария(Глоссарий, 100).Количество(), 3);
	Утв.Равно(mcp1c_ОписанияРесурсов.НачалоГлоссария(Глоссарий, 8).Количество(), 2, "по 4 символа на термин");
	Утв.Равно(mcp1c_ОписанияРесурсов.НачалоГлоссария(Глоссарий, 3).Количество(), 0);

КонецПроцедуры

Процедура ТестОписаниеПромпта() Экспорт

	Описание = mcp1c_ОписанияРесурсов.ОписаниеПромпта("debtors_on_date", " Дебіторка на дату ", "",
		АргументыДебиторки());
	Утв.Равно(Описание.Получить("name"), "debtors_on_date");
	Утв.Равно(Описание.Получить("title"), "Дебіторка на дату");
	Утв.Неопределено_(Описание.Получить("description"), "пустое описание не передается");

	Аргументы = Описание.Получить("arguments");
	Утв.МассивРавен(Значения(Аргументы, "name"), "date,counterparty,note");
	Утв.Равно(Аргументы[0].Получить("required"), Ложь, "есть значение по умолчанию");
	Утв.Равно(Аргументы[0].Получить("description"), "Дата звіту");
	Утв.Равно(Аргументы[1].Получить("required"), Истина);
	Утв.Неопределено_(Аргументы[1].Получить("description"));
	Утв.Равно(Аргументы[2].Получить("required"), Ложь);
	Утв.Содержит(mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Описание), """name"":""debtors_on_date""");

	Описание = mcp1c_ОписанияРесурсов.ОписаниеПромпта("simple_prompt", "", "Опис", Новый Массив);
	Утв.Неопределено_(Описание.Получить("arguments"), "без аргументов");
	Утв.Неопределено_(Описание.Получить("title"));
	Утв.Равно(Описание.Получить("description"), "Опис");

КонецПроцедуры

Процедура ТестТекстПромпта() Экспорт

	Встроенные = mcp1c_ОписанияРесурсов.ВстроенныеПодстановки(Дата(2026, 10, 22, 15, 30, 0));
	Утв.Равно(Встроенные.Получить("today"), "2026-10-22");

	Шаблон = "Дебіторка {{counterparty}} на {{ date }};{{note}}; сьогодні {{today}}; {{unknown}}; {{незакрита";
	Значения = Новый Соответствие;
	Значения.Вставить("counterparty", "Добро {{date}}");
	Итог = mcp1c_ОписанияРесурсов.ТекстПромпта(Шаблон, АргументыДебиторки(), Значения, Встроенные);
	Утв.Равно(Итог.Ошибка, "");
	Утв.Равно(Итог.Текст, "Дебіторка Добро {{date}} на 2026-10-22;; сьогодні 2026-10-22; {{unknown}}; {{незакрита",
		"значения по умолчанию, встроенные подстановки; подставленное значение повторно не разбирается");

	Значения.Вставить("date", "2026-09-30");
	Значения.Вставить("note", "без ПДВ");
	Итог = mcp1c_ОписанияРесурсов.ТекстПромпта("{{date}} {{note}}", АргументыДебиторки(), Значения, Встроенные);
	Утв.Равно(Итог.Текст, "2026-09-30 без ПДВ");

КонецПроцедуры

Процедура ТестОшибкиАргументовПромпта() Экспорт

	Встроенные = mcp1c_ОписанияРесурсов.ВстроенныеПодстановки(Дата(2026, 10, 22));
	Аргументы = АргументыДебиторки();

	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстПромпта("x", Аргументы, "рядок", Встроенные).Ошибка,
		"arguments must be an object");
	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстПромпта("x", Аргументы, Неопределено, Встроенные).Ошибка,
		"Missing required argument: counterparty", "без значения и без значения по умолчанию");

	Значения = Новый Соответствие;
	Значения.Вставить("counterparty", "");
	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстПромпта("x", Аргументы, Значения, Встроенные).Ошибка,
		"Missing required argument: counterparty", "пустая строка - нет значения");

	Значения.Вставить("counterparty", 5);
	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстПромпта("x", Аргументы, Значения, Встроенные).Ошибка,
		"Argument counterparty must be a string");

	Значения.Вставить("counterparty", Повтор("а", 4001));
	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстПромпта("x", Аргументы, Значения, Встроенные).Ошибка,
		"Argument counterparty is longer than 4000 characters");

	Значения.Вставить("counterparty", "Добро");
	Значения.Вставить("other", "1");
	Утв.Равно(mcp1c_ОписанияРесурсов.ТекстПромпта("x", Аргументы, Значения, Встроенные).Ошибка,
		"Unknown argument: other");

КонецПроцедуры

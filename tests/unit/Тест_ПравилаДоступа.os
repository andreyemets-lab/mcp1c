// Тесты mcp1c_ПравилаДоступа: объекты и режимы, поля и маски, глобальные запреты, инструменты,
// параметры ограничений строк.
#Использовать "../../build/oslib"

Функция Политика()

	Политика = mcp1c_ПравилаДоступа.НоваяПолитика();
	Политика.ЗапрещенныеПоля = СтрРазделить("*Пароль*,*Token*", ",");
	Политика.ЗапрещенныеОбъекты.Добавить("ПланОбмена.*");
	Возврат Политика;

КонецФункции

Процедура ТестПоУмолчаниюЗапрещеноВсе() Экспорт

	П = Политика();
	Утв.Ложно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "Справочник.Контрагенты"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Контрагенты", "Наименование"));

КонецПроцедуры

Процедура ТестШаблоныОбъектов() Экспорт

	П = Политика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("*"));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.*", "deny"));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("справочник.контрагенты"));

	Утв.Истинно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "Документ.РеализацияТоваровУслуг"), "* разрешает");
	Утв.Ложно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "Справочник.Номенклатура"), "вид запрещен");
	Утв.Истинно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "Справочник.Контрагенты"), "точное имя важнее шаблона");
	Утв.Ложно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "ПланОбмена.Полный"), "глобальный запрет");
	Утв.Ложно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "Справочник.mcp1c_ТокеныДоступа"), "служебные объекты");
	Утв.Ложно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "РегистрСведений.MCP1C_ЖурналВызовов"), "служебные объекты без учета регистра");

КонецПроцедуры

Процедура ТестПоляВсеКромеЗапрещенных() Экспорт

	П = Политика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.Контрагенты"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "ИНН", "deny"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.*", "КонтактнаяИнформация", "deny"));

	Утв.Истинно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Контрагенты", "Наименование"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Контрагенты", "инн"), "запрет без учета регистра");
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Контрагенты", "ПарольКабинета"), "глобальный шаблон");
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Контрагенты", "ApiTokenValue"), "шаблон без учета регистра");
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Контрагенты", "Скан", СтрРазделить("ХранилищеЗначения", ",")),
		"запрет по типу");
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Контрагенты", "КонтактнаяИнформация.Представление"),
		"запрет табличной части распространяется на ее поля");
	Утв.Ложно(mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(П, "Справочник.Контрагенты", "КонтактнаяИнформация"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Номенклатура", "Наименование"), "объект не разрешен");

КонецПроцедуры

Процедура ТестПоляТолькоРазрешенные() Экспорт

	П = Политика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Документ.РеализацияТоваровУслуг", "read", Истина));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.РеализацияТоваровУслуг", "Дата", "allow"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.РеализацияТоваровУслуг", "Товары", "allow"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.РеализацияТоваровУслуг", "Товары.Цена", "deny"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.РеализацияТоваровУслуг", "Услуги.Сумма", "allow"));

	Объект = "Документ.РеализацияТоваровУслуг";
	Утв.Истинно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Дата"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Контрагент"), "не перечислено");
	Утв.Истинно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Ссылка"), "служебное поле");
	Утв.Истинно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Товары.Количество"), "разрешена табличная часть");
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Товары.Цена"), "запрет важнее разрешения");
	Утв.Истинно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Товары.НомерСтроки"));
	Утв.Истинно(mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(П, Объект, "Товары"));
	Утв.Истинно(mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(П, Объект, "Услуги"), "разрешено поле табличной части");
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Услуги.Количество"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(П, Объект, "Агентские"));

КонецПроцедуры

Процедура ТестОграниченияИОтборПериода() Экспорт

	П = Политика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Документ.*", "read", Ложь, Истина));
	П.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок(
		"Документ.РеализацияТоваровУслуг", "Организация", "eq", "x"));

	Утв.Равно(mcp1c_ПравилаДоступа.ОграниченияСтрок(П, "документ.реализацияТоваровУслуг").Количество(), 1);
	Утв.Равно(mcp1c_ПравилаДоступа.ОграниченияСтрок(П, "Документ.ПоступлениеТоваровУслуг").Количество(), 0);
	Утв.Истинно(mcp1c_ПравилаДоступа.ТребуетсяОтборПоПериоду(П, "Документ.ПоступлениеТоваровУслуг"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ТребуетсяОтборПоПериоду(П, "Справочник.Контрагенты"));

КонецПроцедуры

Процедура ТестИнструменты() Экспорт

	П = Политика();
	Утв.Истинно(mcp1c_ПравилаДоступа.ИнструментДоступен(П, "query_records"), "пустой перечень - встроенные инструменты");
	Утв.Ложно(mcp1c_ПравилаДоступа.ИнструментДоступен(П, "execute_query"), "опасные инструменты только явно");

	П.Инструменты.Добавить("query_records");
	Утв.Истинно(mcp1c_ПравилаДоступа.ИнструментДоступен(П, "query_records"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ИнструментДоступен(П, "list_objects"));
	Утв.Истинно(mcp1c_ПравилаДоступа.ИнструментДоступен(П, "get_context"), "get_context доступен всегда");

КонецПроцедуры

Процедура ТестПредставлениеСсылок() Экспорт

	П = Политика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.*"));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.Сотрудники", "aggregates"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.ФизическиеЛица", "Наименование", "deny"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.БанковскиеСчета", "Наименование", "mask", "partial"));

	Поля = СтрРазделить("Наименование", ",");
	Утв.Равно(mcp1c_ПравилаДоступа.ДоступПредставления(П, "Справочник.Контрагенты", Поля), "visible");
	Утв.Равно(mcp1c_ПравилаДоступа.ДоступПредставления(П, "Справочник.ФизическиеЛица", Поля), "hidden",
		"скрыто поле представления");
	Утв.Равно(mcp1c_ПравилаДоступа.ДоступПредставления(П, "Справочник.БанковскиеСчета", Поля), "masked",
		"поле представления замаскировано");
	Утв.Равно(mcp1c_ПравилаДоступа.ДоступПредставления(П, "Справочник.Сотрудники", Поля), "hidden",
		"объект только в агрегатах");
	Утв.Равно(mcp1c_ПравилаДоступа.ДоступПредставления(П, "Документ.Заказ", СтрРазделить("Номер,Дата", ",")), "hidden",
		"объект недоступен");

КонецПроцедуры

Процедура ТестРежимТолькоАгрегаты() Экспорт

	П = Политика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("РегистрНакопления.*", "aggregates"));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("РегистрНакопления.Зарплата", "aggregates", Ложь, Ложь, 10));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.Контрагенты"));

	Объект = "РегистрНакопления.Продажи";
	Утв.Истинно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, Объект), "виден в перечнях");
	Утв.Ложно(mcp1c_ПравилаДоступа.ОбъектЧитается(П, Объект), "записи не читаются");
	Утв.Истинно(mcp1c_ПравилаДоступа.ТолькоАгрегаты(П, Объект));
	Утв.Истинно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Сумма"), "поля доступны для агрегатов");
	Утв.Равно(mcp1c_ПравилаДоступа.МинимальныйРазмерГруппы(П, Объект), 5, "по умолчанию");
	Утв.Равно(mcp1c_ПравилаДоступа.МинимальныйРазмерГруппы(П, "РегистрНакопления.Зарплата"), 10);

	Утв.Истинно(mcp1c_ПравилаДоступа.ОбъектЧитается(П, "Справочник.Контрагенты"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ТолькоАгрегаты(П, "Справочник.Контрагенты"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ТолькоАгрегаты(П, "Справочник.Номенклатура"), "объект не разрешен");
	Утв.Ложно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "Справочник.Номенклатура"));

КонецПроцедуры

Процедура ТестМаскиПолей() Экспорт

	П = Политика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.*"));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Документ.Зарплата", "read", Истина));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.*", "ИНН", "mask", "hash"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.ФизическиеЛица", "ИНН", "mask", "partial", 3));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.ФизическиеЛица", "Паспорт", "mask", "partial"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.ФизическиеЛица", "Паспорт", "deny"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.ФизическиеЛица", "Ссылка", "mask"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.Зарплата", "Начисления", "mask", "round", 1000));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.Зарплата", "Начисления.Сотрудник", "mask", "full"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.Зарплата", "Дата", "allow"));

	Маска = mcp1c_ПравилаДоступа.МаскаПоля(П, "Справочник.Контрагенты", "инн");
	Утв.Равно(Маска.Вид, "hash", "шаблон объекта, без учета регистра");
	Маска = mcp1c_ПравилаДоступа.МаскаПоля(П, "Справочник.ФизическиеЛица", "ИНН");
	Утв.Равно(Маска.Вид, "partial", "точное имя объекта важнее шаблона");
	Утв.Равно(Маска.Параметр, 3);
	Утв.Неопределено_(mcp1c_ПравилаДоступа.МаскаПоля(П, "Справочник.Контрагенты", "Наименование"));
	Утв.Неопределено_(mcp1c_ПравилаДоступа.МаскаПоля(П, "Справочник.ФизическиеЛица", "Ссылка"),
		"служебные поля не маскируются");
	Утв.Истинно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Контрагенты", "ИНН"), "замаскированное поле видно");
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.ФизическиеЛица", "Паспорт"), "запрет важнее маски");

	Объект = "Документ.Зарплата";
	Утв.Истинно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Начисления.Сумма"),
		"только разрешенные: маска разрешает поле");
	Утв.Равно(mcp1c_ПравилаДоступа.МаскаПоля(П, Объект, "Начисления.Сумма").Вид, "round", "маска табличной части");
	Утв.Равно(mcp1c_ПравилаДоступа.МаскаПоля(П, Объект, "Начисления.Сотрудник").Вид, "full", "правило поля важнее");
	Утв.Неопределено_(mcp1c_ПравилаДоступа.МаскаПоля(П, Объект, "Начисления.НомерСтроки"));
	Утв.Истинно(mcp1c_ПравилаДоступа.ТабличнаяЧастьДоступна(П, Объект, "Начисления"));
	Утв.Неопределено_(mcp1c_ПравилаДоступа.МаскаПоля(П, Объект, "Дата"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, Объект, "Комментарий"), "не перечислено");

КонецПроцедуры

Функция ПолитикаСПараметрами()

	П = Политика();
	П.ПараметрыПрофиля.Вставить("разрешенныеорганизации", mcp1c_ПравилаДоступа.НовыйПараметрПрофиля(
		"РазрешенныеОрганизации", "Справочник.Организации", "Организации клиента"));
	П.ПараметрыПрофиля.Вставить("регион", mcp1c_ПравилаДоступа.НовыйПараметрПрофиля("Регион"));
	Возврат П;

КонецФункции

Функция СсылкаОрганизации(Номер)

	Значение = Новый Соответствие;
	Значение.Вставить("type", "Справочник.Организации");
	Значение.Вставить("ref", "4e0c1d2a-0000-0000-0000-00000000000" + Номер);
	Возврат Значение;

КонецФункции

Функция Ограничение(П, Параметр, Значение = Неопределено)

	Ограничение = mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.Реализация", "Организация", "eq", Значение, "",
		Параметр);
	П.ОграниченияСтрок.Добавить(Ограничение);
	Возврат Ограничение;

КонецФункции

Процедура ТестПараметрыОграничений() Экспорт

	П = ПолитикаСПараметрами();
	Значения = Новый Массив;
	Значения.Добавить(mcp1c_ПравилаДоступа.НовоеЗначениеПараметра(СсылкаОрганизации(1), "Справочник.Организации"));
	Значения.Добавить(mcp1c_ПравилаДоступа.НовоеЗначениеПараметра(СсылкаОрганизации(2), "справочник.организации"));
	П.ЗначенияПараметров.Вставить("разрешенныеорганизации", Значения);
	Одно = Новый Массив;
	Одно.Добавить(mcp1c_ПравилаДоступа.НовоеЗначениеПараметра("Захід", "Строка"));
	П.ЗначенияПараметров.Вставить("регион", Одно);

	Список = Ограничение(П, "РазрешенныеОрганизации");
	Единственное = Ограничение(П, "регион");
	Постоянное = Ограничение(П, "", "значение профиля");
	mcp1c_ПравилаДоступа.ПодставитьПараметры(П);

	Утв.Равно(Список.ВидСравнения, "eq");
	Утв.Равно(ТипЗнч(Список.Значение), Тип("Массив"), "несколько значений - список");
	Утв.Равно(Список.Значение.Количество(), 2);
	Утв.Равно(Список.Значение[1].Получить("ref"), "4e0c1d2a-0000-0000-0000-000000000002");
	Утв.Равно(Единственное.Значение, "Захід", "одно значение - само значение; типы не заданы - любые");
	Утв.Равно(Постоянное.Значение, "значение профиля", "ограничение без параметра не меняется");
	Утв.Равно(Список.Ошибка, "");

КонецПроцедуры

Процедура ТестОшибкиПараметровЗакрываютДоступ() Экспорт

	// Параметр не описан в профиле.
	П = ПолитикаСПараметрами();
	Ограничение = Ограничение(П, "НеизвестныйПараметр");
	mcp1c_ПравилаДоступа.ПодставитьПараметры(П);
	Утв.Равно(Ограничение.ВидСравнения, "invalid");
	Утв.Содержит(Ограничение.Ошибка, "не описан");

	// Значения в клиенте не заданы.
	П = ПолитикаСПараметрами();
	Ограничение = Ограничение(П, "РазрешенныеОрганизации");
	mcp1c_ПравилаДоступа.ПодставитьПараметры(П);
	Утв.Равно(Ограничение.ВидСравнения, "invalid");
	Утв.Содержит(Ограничение.Ошибка, "не заданы значения");

	// Значение другого типа.
	П = ПолитикаСПараметрами();
	Значения = Новый Массив;
	Значения.Добавить(mcp1c_ПравилаДоступа.НовоеЗначениеПараметра(СсылкаОрганизации(1), "Справочник.Организации"));
	Значения.Добавить(mcp1c_ПравилаДоступа.НовоеЗначениеПараметра("ТОВ", "Строка"));
	П.ЗначенияПараметров.Вставить("разрешенныеорганизации", Значения);
	Ограничение = Ограничение(П, "РазрешенныеОрганизации");
	mcp1c_ПравилаДоступа.ПодставитьПараметры(П);
	Утв.Равно(Ограничение.ВидСравнения, "invalid");
	Утв.Содержит(Ограничение.Ошибка, "не соответствует");
	Утв.Неопределено_(Ограничение.Значение, "значения не остаются в ограничении");

	// Пустое значение в клиенте.
	П = ПолитикаСПараметрами();
	Значения = Новый Массив;
	Значения.Добавить(mcp1c_ПравилаДоступа.НовоеЗначениеПараметра(Неопределено, "Справочник.Организации", "пустая ссылка"));
	П.ЗначенияПараметров.Вставить("разрешенныеорганизации", Значения);
	Ограничение = Ограничение(П, "РазрешенныеОрганизации");
	mcp1c_ПравилаДоступа.ПодставитьПараметры(П);
	Утв.Равно(Ограничение.ВидСравнения, "invalid");
	Утв.Содержит(Ограничение.Ошибка, "пустая ссылка");

КонецПроцедуры

Процедура ТестСоответствуетШаблону() Экспорт

	Утв.Истинно(mcp1c_ПравилаДоступа.СоответствуетШаблону("Справочник.Контрагенты", "справочник.*"));
	Утв.Ложно(mcp1c_ПравилаДоступа.СоответствуетШаблону("Документ.Заказ", "Справочник.*"));
	Утв.Истинно(mcp1c_ПравилаДоступа.СоответствуетШаблону("ИНН", "*инн*"));
	Утв.Истинно(mcp1c_ПравилаДоступа.СоответствуетШаблону("abc", "a*c"));
	Утв.Истинно(mcp1c_ПравилаДоступа.СоответствуетШаблону("ac", "a*c"));
	Утв.Ложно(mcp1c_ПравилаДоступа.СоответствуетШаблону("a", "a*a"));
	Утв.Истинно(mcp1c_ПравилаДоступа.СоответствуетШаблону("aXbYc", "a*b*c"));
	Утв.Ложно(mcp1c_ПравилаДоступа.СоответствуетШаблону("aXcYb", "a*b*c"));
	Утв.Истинно(mcp1c_ПравилаДоступа.СоответствуетШаблону("любое", "*"));
	Утв.Ложно(mcp1c_ПравилаДоступа.СоответствуетШаблону("Справочник.Контрагенты", "Справочник.Контрагент"));

КонецПроцедуры

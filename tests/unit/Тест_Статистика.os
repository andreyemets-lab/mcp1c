// Тесты mcp1c_Статистика: сводка длительностей, топ объектов, представления и предупреждения панели.
#Использовать "../../build/oslib"

Функция Гистограмма(Текст, Ключ = "")
	// "значение:количество, ..." -> строки гистограммы.

	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл
		Пара = СтрРазделить(СокрЛП(Часть), ":");
		Результат.Добавить(mcp1c_Статистика.НоваяСтрокаГистограммы(Число(Пара[0]), Число(Пара[1]), Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ТестРангПерцентиля() Экспорт

	Утв.Равно(mcp1c_Статистика.РангПерцентиля(1, 95), 1, "один вызов");
	Утв.Равно(mcp1c_Статистика.РангПерцентиля(20, 95), 19, "19 из 20 - ровно 95%");
	Утв.Равно(mcp1c_Статистика.РангПерцентиля(21, 95), 20, "19,95 округляется вверх");
	Утв.Равно(mcp1c_Статистика.РангПерцентиля(100, 95), 95);
	Утв.Равно(mcp1c_Статистика.РангПерцентиля(10, 50), 5, "медиана четного числа - нижняя");
	Утв.Равно(mcp1c_Статистика.РангПерцентиля(3, 1), 1, "ранг не меньше 1");
	Утв.Равно(mcp1c_Статистика.РангПерцентиля(7, 100), 7, "100% - последний вызов");

КонецПроцедуры

Процедура ТестСводкаДлительностей() Экспорт

	// 100 вызовов: 90 по 10 мс, 5 по 200 мс, 5 по 3000 мс.
	Сводка = mcp1c_Статистика.СводкаДлительностей(Гистограмма("3000:5, 10:90, 200:5"));
	Утв.Равно(Сводка.Количество, 100, "количество");
	Утв.Равно(Сводка.Среднее, 169, "среднее (900 + 1000 + 15000) / 100");
	Утв.Равно(Сводка.Медиана, 10, "медиана");
	Утв.Равно(Сводка.P95, 200, "95-й вызов длится 200 мс");
	Утв.Равно(Сводка.Максимум, 3000, "максимум");

КонецПроцедуры

Процедура ТестСводкаСкладываетОдинаковыеДлительности() Экспорт

	// Строки с одной длительностью (разные периоды журнала) складываются; пустые пропускаются.
	Сводка = mcp1c_Статистика.СводкаДлительностей(Гистограмма("50:1, 50:1, 70:0, 40:2"));
	Утв.Равно(Сводка.Количество, 4);
	Утв.Равно(Сводка.Медиана, 40, "ранг 2 из 4");
	Утв.Равно(Сводка.P95, 50);
	Утв.Равно(Сводка.Максимум, 50, "строка с нулевым количеством не считается");

КонецПроцедуры

Процедура ТестПустаяСводка() Экспорт

	Сводка = mcp1c_Статистика.СводкаДлительностей(Новый Массив);
	Утв.Равно(Сводка.Количество, 0);
	Утв.Равно(Сводка.Среднее, 0);
	Утв.Равно(Сводка.P95, 0);

КонецПроцедуры

Процедура ТестСводкиПоКлючам() Экспорт

	Строки = Гистограмма("10:3, 1000:1", "query_records");
	Для Каждого Строка_ Из Гистограмма("5:2", "list_objects") Цикл
		Строки.Добавить(Строка_);
	КонецЦикла;
	Сводки = mcp1c_Статистика.СводкиДлительностейПоКлючам(Строки);
	Утв.Равно(Сводки.Количество(), 2, "две группы");
	Утв.Равно(Сводки["query_records"].Количество, 4);
	Утв.Равно(Сводки["query_records"].P95, 1000);
	Утв.Равно(Сводки["list_objects"].Среднее, 5);

КонецПроцедуры

Процедура ТестТопОбъектов() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(mcp1c_Статистика.НоваяСтрокаОбъектов("Catalog.B, Catalog.A", 3));
	Строки.Добавить(mcp1c_Статистика.НоваяСтрокаОбъектов("Catalog.A", 2));
	Строки.Добавить(mcp1c_Статистика.НоваяСтрокаОбъектов("Document.C,  ,Catalog.B", 1));
	Строки.Добавить(mcp1c_Статистика.НоваяСтрокаОбъектов("", 10));
	Топ = mcp1c_Статистика.ТопОбъектов(Строки, 10);
	Утв.Равно(Топ.Количество(), 3, "пустые имена пропускаются");
	Утв.Равно(Топ[0].Объект, "Catalog.A");
	Утв.Равно(Топ[0].Обращений, 5);
	Утв.Равно(Топ[1].Объект, "Catalog.B");
	Утв.Равно(Топ[1].Обращений, 4);
	Утв.Равно(Топ[2].Объект, "Document.C");

	Утв.Равно(mcp1c_Статистика.ТопОбъектов(Строки, 1).Количество(), 1, "предел");

КонецПроцедуры

Процедура ТестТопОбъектовПриРавенстве() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(mcp1c_Статистика.НоваяСтрокаОбъектов("Catalog.Zeta", 2));
	Строки.Добавить(mcp1c_Статистика.НоваяСтрокаОбъектов("Catalog.Alpha", 2));
	Топ = mcp1c_Статистика.ТопОбъектов(Строки, 5);
	Утв.Равно(Топ[0].Объект, "Catalog.Alpha", "при равенстве - по имени");

КонецПроцедуры

Процедура ТестПредставлениеДлительности() Экспорт

	Утв.Равно(mcp1c_Статистика.ПредставлениеДлительности(0), "0 мс");
	Утв.Равно(mcp1c_Статистика.ПредставлениеДлительности(350), "350 мс");
	Утв.Равно(mcp1c_Статистика.ПредставлениеДлительности(999), "999 мс");
	Утв.Равно(mcp1c_Статистика.ПредставлениеДлительности(1000), "1,0 с");
	Утв.Равно(mcp1c_Статистика.ПредставлениеДлительности(1260), "1,3 с");
	Утв.Равно(mcp1c_Статистика.ПредставлениеДлительности(59940), "59,9 с");
	Утв.Равно(mcp1c_Статистика.ПредставлениеДлительности(59960), "1 хв 00 с");
	Утв.Равно(mcp1c_Статистика.ПредставлениеДлительности(125000), "2 хв 05 с");

КонецПроцедуры

Процедура ТестПредставлениеОбъема() Экспорт

	Утв.Равно(mcp1c_Статистика.ПредставлениеОбъема(512), "512 Б");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОбъема(1024), "1 КБ");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОбъема(12800), "12,5 КБ");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОбъема(3 * 1024 * 1024 + 200 * 1024), "3,2 МБ");

КонецПроцедуры

Процедура ТестПредставлениеОстатка() Экспорт

	Утв.Равно(mcp1c_Статистика.ПредставлениеОстатка(0), "минуло");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОстатка(30), "менше хвилини");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОстатка(12 * 60 + 5), "12 хв");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОстатка(5 * 3600 + 20 * 60), "5 год. 20 хв");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОстатка(2 * 3600), "2 год.");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОстатка(3 * 86400 + 4 * 3600 + 59), "3 дн. 4 год.");
	Утв.Равно(mcp1c_Статистика.ПредставлениеОстатка(86400), "1 дн.");

КонецПроцедуры

Процедура ТестНастроенныйСерверБезПредупреждений() Экспорт

	Факты = mcp1c_Статистика.НовыеФактыРабочегоМеста();
	Факты.Включен = Истина;
	Факты.АдресЗадан = Истина;
	Факты.ЗаголовокАдресаКлиента = "X-Real-IP";
	Факты.ЗапросовСАдресом = 10;
	Факты.ДействующихТокенов = 2;
	Факты.ПрофилиСЧувствительнымиПолями = Новый Массив;
	Утв.Равно(mcp1c_Статистика.ПредупрежденияРабочегоМеста(Факты).Количество(), 0);

КонецПроцедуры

Процедура ТестПредупрежденияНовогоСервера() Экспорт

	Факты = mcp1c_Статистика.НовыеФактыРабочегоМеста();
	Тексты = СтрСоединить(mcp1c_Статистика.ПредупрежденияРабочегоМеста(Факты), Символы.ПС);
	Утв.Содержит(Тексты, "Сервер вимкнено");
	Утв.Содержит(Тексты, "публічну адресу");
	Утв.Содержит(Тексты, "Заголовок IP клієнта не задано");
	Утв.НеСодержит(Тексты, "Немає діючих токенів", "о токенах - только для включенного сервера");
	Утв.НеСодержит(Тексты, "чутливі поля", "профили не проверялись");

КонецПроцедуры

Процедура ТестПредупрежденияОбАдресеКлиента() Экспорт

	Факты = mcp1c_Статистика.НовыеФактыРабочегоМеста();
	Факты.Включен = Истина;
	Факты.АдресЗадан = Истина;
	Факты.ДействующихТокенов = 1;
	Факты.ЗаголовокАдресаКлиента = "X-Real-IP";
	Факты.ЗапросовБезАдреса = 5;
	Тексты = mcp1c_Статистика.ПредупрежденияРабочегоМеста(Факты);
	Утв.Равно(Тексты.Количество(), 1);
	Утв.Содержит(Тексты[0], "без заголовка X-Real-IP: проксі не передає");

	Факты.ЗапросовСАдресом = 100;
	Тексты = mcp1c_Статистика.ПредупрежденияРабочегоМеста(Факты);
	Утв.Содержит(Тексты[0], "5 запитів надійшли без заголовка X-Real-IP", "часть запитів в обход прокси");

КонецПроцедуры

Процедура ТестПредупрежденияПереносаТокеновИПрофилей() Экспорт

	Факты = mcp1c_Статистика.НовыеФактыРабочегоМеста();
	Факты.Включен = Истина;
	Факты.АдресЗадан = Истина;
	Факты.ЗаголовокАдресаКлиента = "X-Real-IP";
	Факты.ТребуетсяПодтверждениеПереноса = Истина;
	Факты.ДействующихТокенов = 3;
	Факты.ИстекающихТокенов = 2;
	Профили = Новый Массив;
	Профили.Добавить("Продажі");
	Профили.Добавить("Кадри");
	Факты.ПрофилиСЧувствительнымиПолями = Профили;
	Тексты = mcp1c_Статистика.ПредупрежденияРабочегоМеста(Факты);
	Утв.Равно(Тексты.Количество(), 3);
	Утв.Содержит(Тексты[0], "Розташування бази змінилося", "перенос - первым");
	Утв.Содержит(Тексты[1], "Протягом 7 дн. спливає токенів: 2");
	Утв.Содержит(Тексты[2], "Продажі, Кадри");

КонецПроцедуры

Процедура ТестБезПраваНаНастройки() Экспорт

	// Аудитор не читает настройки: предупреждения о них не формируются, о токенах - формируются.
	Факты = mcp1c_Статистика.НовыеФактыРабочегоМеста();
	Факты.НастройкиДоступны = Ложь;
	Факты.ИстекающихТокенов = 1;
	Тексты = mcp1c_Статистика.ПредупрежденияРабочегоМеста(Факты);
	Утв.Равно(Тексты.Количество(), 1);
	Утв.Содержит(Тексты[0], "спливає токенів: 1");

КонецПроцедуры

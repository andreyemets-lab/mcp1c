// Тесты mcp1c_ПутиПолей: разбор путей полей, разыменование, проверка политикой.
#Использовать "../../build/oslib"

Функция ОписаниеРеализации()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Документ.РеализацияТоваровУслуг", "Документ.РеализацияТоваровУслуг", "document");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Документ.РеализацияТоваровУслуг", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Дата", "Дата", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Номер", "Строка", "standard", 11);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Контрагент", "Справочник.Контрагенты");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Организация", "Справочник.Организации");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Комментарий", "Строка", , 0);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "СуммаДокумента", "Число");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ВидОперации", "Перечисление.ВидыОпераций");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Основание", "Документ.ЗаказПокупателя, Справочник.Договоры, Строка", , 50);
	Возврат Т;

КонецФункции

Функция ОписаниеТоваров()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Документ.РеализацияТоваровУслуг.Товары", "Документ.РеализацияТоваровУслуг",
		"document", "tabular_section");
	Т.ПрефиксПолейПолитики = "Товары.";
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Документ.РеализацияТоваровУслуг", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "НомерСтроки", "Число", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Номенклатура", "Справочник.Номенклатура");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Цена", "Число");
	Возврат Т;

КонецФункции

Функция ОписаниеКонтрагентов()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Справочник.Контрагенты", "Справочник.Контрагенты", "catalog");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Справочник.Контрагенты", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Наименование", "Строка", "standard", 100);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ИНН", "Строка", , 12);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ГоловнойКонтрагент", "Справочник.Контрагенты");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ПарольКабинета", "Строка", , 50);
	Возврат Т;

КонецФункции

Функция Политика(ГлубинаРазыменования = 2)

	П = mcp1c_ПравилаДоступа.НоваяПолитика();
	П.ЗапрещенныеПоля.Добавить("*Пароль*");
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("*"));
	П.Лимиты.ГлубинаРазыменования = ГлубинаРазыменования;
	Возврат П;

КонецФункции

// Разбирает путь, подгружая описания по запросу, как это делает вызывающий код.
Функция Разобрать(Таблица, Путь, Политика)

	Описания = Новый Соответствие;
	Для Попытка_ = 1 По 10 Цикл
		Результат = mcp1c_ПутиПолей.РазобратьПуть(Таблица, Путь, Описания, Политика);
		Если ПустаяСтрока(Результат.НужноОписание) Тогда
			Возврат Результат;
		КонецЕсли;
		Если Результат.НужноОписание = "Справочник.Контрагенты" Тогда
			Описания.Вставить(Результат.НужноОписание, ОписаниеКонтрагентов());
		ИначеЕсли Результат.НужноОписание = "Документ.РеализацияТоваровУслуг" Тогда
			Описания.Вставить(Результат.НужноОписание, ОписаниеРеализации());
		Иначе
			Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы(Результат.НужноОписание, Результат.НужноОписание, "catalog");
			mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Ссылка", Результат.НужноОписание, "standard");
			mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Номер", "Строка", "standard", 11);
			Описания.Вставить(Результат.НужноОписание, Описание);
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Разбор не завершился";

КонецФункции

Процедура ТестПростоеПоле() Экспорт

	Результат = Разобрать(ОписаниеРеализации(), "контрагент", Политика());
	Утв.Истинно(Результат.Успех, Результат.Ошибка);
	Утв.Равно(Результат.Путь, "Контрагент", "каноническое имя");
	Утв.Равно(Результат.Выражение, "Т.Контрагент");
	Утв.МассивРавен(Результат.Типы, "Справочник.Контрагенты");
	Утв.Равно(mcp1c_ПутиПолей.ВидЗначений(Результат.Типы), "ref");

КонецПроцедуры

Процедура ТестРазыменование() Экспорт

	Результат = Разобрать(ОписаниеРеализации(), "Контрагент.ГоловнойКонтрагент.наименование", Политика());
	Утв.Истинно(Результат.Успех, Результат.Ошибка);
	Утв.Равно(Результат.Выражение, "Т.Контрагент.ГоловнойКонтрагент.Наименование");
	Утв.Равно(Результат.Разыменований, 2);
	Утв.Равно(Результат.ДлинаСтроки, 100);

	Результат = Разобрать(ОписаниеРеализации(), "Контрагент.ГоловнойКонтрагент.Наименование", Политика(1));
	Утв.Ложно(Результат.Успех, "глубина разыменования ограничена профилем");
	Утв.Содержит(Результат.Ошибка, "не більше 1");

КонецПроцедуры

Процедура ТестИнъекцияВИмениПоля() Экспорт

	Для Каждого Путь Из СтрРазделить("Наименование ИЗ Справочник.Пользователи|Наименование; ВЫБРАТЬ|Т.Ссылка|"
		+ "|Контрагент..ИНН|Контрагент.ИНН)|1Поле|Поле-1|&Параметр|Контрагент /*", "|") Цикл
		Результат = Разобрать(ОписаниеРеализации(), Путь, Политика());
		Утв.Ложно(Результат.Успех, Путь);
		Утв.Равно(Результат.Выражение, "", Путь);
	КонецЦикла;

КонецПроцедуры

Процедура ТестСкрытыеПоляНеОтличаютсяОтОтсутствующих() Экспорт

	П = Политика();
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "ИНН", "deny"));

	Скрытое = Разобрать(ОписаниеРеализации(), "Контрагент.ИНН", П);
	Отсутствующее = Разобрать(ОписаниеРеализации(), "Контрагент.КПП", П);
	Утв.Ложно(Скрытое.Успех);
	Утв.Ложно(Отсутствующее.Успех);
	Утв.Равно(СтрЗаменить(Скрытое.Ошибка, "ИНН", "КПП"), Отсутствующее.Ошибка, "одинаковый текст ошибки");

	Глобально = Разобрать(ОписаниеРеализации(), "Контрагент.ПарольКабинета", П);
	Утв.Ложно(Глобально.Успех, "глобальный запрет");

КонецПроцедуры

Процедура ТестНедоступныйОбъектВЦепочке() Экспорт

	П = Политика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.Контрагенты", "deny"));
	Утв.Истинно(Разобрать(ОписаниеРеализации(), "Контрагент", П).Успех, "само поле-ссылка доступно");
	Утв.Ложно(Разобрать(ОписаниеРеализации(), "Контрагент.Наименование", П).Успех, "разыменование в запрещенный объект");

КонецПроцедуры

Процедура ТестРазыменованиеЧерезОбъектСОграничениями() Экспорт

	П = Политика();
	П.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок(
		"Справочник.Контрагенты", "ИНН", "eq", "123"));
	П.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок(
		"Документ.РеализацияТоваровУслуг", "Организация", "eq", "x"));

	Утв.Ложно(Разобрать(ОписаниеРеализации(), "Контрагент.Наименование", П).Успех,
		"ограничения строк связанного объекта не обходятся разыменованием");
	Утв.Истинно(Разобрать(ОписаниеКонтрагентов(), "Наименование", П).Успех, "основная таблица запроса");
	Результат = Разобрать(ОписаниеТоваров(), "Ссылка.Дата", П);
	Утв.Истинно(Результат.Успех, "табличная часть -> владелец: ограничения применяются к основной таблице");
	Утв.Равно(Результат.Выражение, "Т.Ссылка.Дата");

КонецПроцедуры

Процедура ТестНеСсылочноеПоле() Экспорт

	Результат = Разобрать(ОписаниеРеализации(), "Дата.Год", Политика());
	Утв.Ложно(Результат.Успех);
	Утв.Содержит(Результат.Ошибка, "не є посиланням");
	Утв.Ложно(Разобрать(ОписаниеРеализации(), "ВидОперации.Порядок", Политика()).Успех, "через перечисление нельзя");

КонецПроцедуры

Процедура ТестСоставнойТипИСтроки() Экспорт

	Результат = Разобрать(ОписаниеРеализации(), "Основание.Номер", Политика());
	Утв.Истинно(Результат.Успех, Результат.Ошибка);
	Утв.Равно(Результат.Выражение, "Т.Основание.Номер");

	Результат = Разобрать(ОписаниеРеализации(), "Комментарий", Политика());
	Утв.Истинно(Результат.НеограниченнаяСтрока, "строка неограниченной длины");
	Утв.Равно(mcp1c_ПутиПолей.ВидЗначений(Разобрать(ОписаниеРеализации(), "Основание", Политика()).Типы), "mixed");
	Утв.Равно(mcp1c_ПутиПолей.ВидЗначений(Разобрать(ОписаниеРеализации(), "ВидОперации", Политика()).Типы), "enum");

КонецПроцедуры

Процедура ТестПолеТабличнойЧастиПроверяетсяСПрефиксом() Экспорт

	П = Политика();
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.РеализацияТоваровУслуг", "Товары.Цена", "deny"));
	Утв.Ложно(Разобрать(ОписаниеТоваров(), "Цена", П).Успех, "Товары.Цена запрещено");
	Утв.Истинно(Разобрать(ОписаниеРеализации(), "СуммаДокумента", П).Успех);

КонецПроцедуры

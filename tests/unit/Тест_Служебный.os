// Тесты вспомогательных функций: даты аргументов, очистка текстов, лимиты профиля,
// виртуальные таблицы без параметров, имена промптов и аргументов.
#Использовать "../../build/oslib"

Процедура ТестИменаMCPИАргументов() Экспорт

	Длинное = "a";
	Пока СтрДлина(Длинное) < 64 Цикл
		Длинное = Длинное + "b";
	КонецЦикла;

	Для Каждого Имя Из СтрРазделить("debtors_on_date,abc,a1_,customer_debt2", ",") Цикл
		Утв.Истинно(mcp1c_Служебный.ЭтоИмяMCP(Имя), Имя);
	КонецЦикла;
	Утв.Истинно(mcp1c_Служебный.ЭтоИмяMCP(Длинное), "64 символа");
	Для Каждого Имя Из СтрРазделить("ab|Debtors|debtorS|1abc|_abc|abc-def|abc def|дебіторка|", "|") Цикл
		Утв.Ложно(mcp1c_Служебный.ЭтоИмяMCP(Имя), Имя);
	КонецЦикла;
	Утв.Ложно(mcp1c_Служебный.ЭтоИмяMCP(Длинное + "c"), "65 символов");
	Утв.Ложно(mcp1c_Служебный.ЭтоИмяMCP(5), "не строка");

	Для Каждого Имя Из СтрРазделить("date,_Date1,D,counterparty_ref", ",") Цикл
		Утв.Истинно(mcp1c_Служебный.ЭтоИмяАргумента(Имя), Имя);
	КонецЦикла;
	Утв.Истинно(mcp1c_Служебный.ЭтоИмяАргумента(Длинное), "64 символа");
	Для Каждого Имя Из СтрРазделить("|1date|дата|da te|date-from|{{x}}", "|") Цикл
		Утв.Ложно(mcp1c_Служебный.ЭтоИмяАргумента(Имя), Имя);
	КонецЦикла;
	Утв.Ложно(mcp1c_Служебный.ЭтоИмяАргумента(Длинное + "c"), "65 символов");
	Утв.Ложно(mcp1c_Служебный.ЭтоИмяАргумента(Неопределено), "не строка");

	Для Каждого Имя Из СтрРазделить("Контрагент,ОтчетыСервер,_Дата1,Value,ЄДРПОУ,Ґанок", ",") Цикл
		Утв.Истинно(mcp1c_Служебный.ЭтоИдентификатор(Имя), Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("|1Дата|&Контрагент|Модуль.Метод|Долг-Клиента|Имя метода|Метод()", "|") Цикл
		Утв.Ложно(mcp1c_Служебный.ЭтоИдентификатор(Имя), Имя);
	КонецЦикла;
	Утв.Ложно(mcp1c_Служебный.ЭтоИдентификатор(5), "не строка");

КонецПроцедуры

Процедура ТестРазборДат() Экспорт

	Р = mcp1c_Служебный.РазобратьДату("2026-09-30");
	Утв.Равно(Р.Дата, Дата(2026, 9, 30));
	Утв.Истинно(Р.ТолькоДата);

	Р = mcp1c_Служебный.РазобратьДату(" 2026-09-30T14:05 ");
	Утв.Равно(Р.Дата, Дата(2026, 9, 30, 14, 5, 0));
	Утв.Ложно(Р.ТолькоДата);

	Утв.Равно(mcp1c_Служебный.РазобратьДату("2026-09-30 14:05:07.123").Дата, Дата(2026, 9, 30, 14, 5, 7));
	Утв.Равно(mcp1c_Служебный.РазобратьДату("2024-02-29").Дата, Дата(2024, 2, 29), "високосный год");

	Для Каждого Текст Из СтрРазделить("2026-02-30|2025-02-29|2026-13-01|2026-09-30T25:00|2026-09-30T14:60|"
		+ "2026-09-30T14:05:00Z|2026-09-30T14:05:00+03:00|2026-9-30|30.09.2026|2026-09-30T|2026-09-30T1:05|"
		+ "2026-09-30T14:05:07.|abcd-ef-gh", "|") Цикл
		Утв.Неопределено_(mcp1c_Служебный.РазобратьДату(Текст), Текст);
	КонецЦикла;
	Утв.Неопределено_(mcp1c_Служебный.РазобратьДату(20260930), "не строка");

КонецПроцедуры

Процедура ТестОчисткаТекста() Экспорт

	Текст = "А" + Символ(0) + "Б" + Символ(8203) + "В" + Символ(8238) + "Г" + Символ(65279) + "Д" + Символ(7);
	Утв.Равно(mcp1c_Сериализация.ОчищенныйТекст(Текст), "АБВГД", "управляющие и невидимые символы удалены");
	Утв.Равно(mcp1c_Сериализация.ОчищенныйТекст("а" + Символы.Таб + "б" + Символы.ПС + "в" + Символы.ВК),
		"а" + Символы.Таб + "б" + Символы.ПС + "в" + Символы.ВК, "табуляция и переводы строк сохраняются");
	Утв.Равно(mcp1c_Сериализация.ОчищенныйТекст("абвгд", 3), "абв…[обрізано]");
	Утв.Равно(mcp1c_Сериализация.ОчищенныйТекст("абв", 3), "абв", "ровно по пределу - без пометки");
	Утв.Равно(mcp1c_Сериализация.ОчищенныйТекст(Символ(8203) + Символ(8203)), "", "только невидимые символы");
	Утв.Равно(mcp1c_Сериализация.ОчищенныйТекст(""), "");

КонецПроцедуры

Процедура ТестЛимитыПрофиля() Экспорт

	Лимиты = mcp1c_ПравилаДоступа.НовыеЛимиты();
	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "СтрокЗаВызов", 5000);
	Утв.Равно(Лимиты.СтрокЗаВызов, 1000, "не больше предельного");
	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "ВызововВМинуту", 0);
	Утв.Равно(Лимиты.ВызововВМинуту, 30, "0 - значение по умолчанию");
	mcp1c_ПравилаДоступа.УстановитьЛимит(Лимиты, "ГлубинаРазыменования", 1);
	Утв.Равно(Лимиты.ГлубинаРазыменования, 1);

	mcp1c_ПравилаДоступа.УменьшитьЛимит(Лимиты, "СтрокЗаВызов", 10);
	Утв.Равно(Лимиты.СтрокЗаВызов, 10, "клиент сужает лимит");
	mcp1c_ПравилаДоступа.УменьшитьЛимит(Лимиты, "СтрокЗаВызов", 100);
	Утв.Равно(Лимиты.СтрокЗаВызов, 10, "клиент не может расширить лимит");
	mcp1c_ПравилаДоступа.УменьшитьЛимит(Лимиты, "СтрокВСутки", 0);
	Утв.Равно(Лимиты.СтрокВСутки, 20000);

КонецПроцедуры

Процедура ТестПраваПользователяОграничиваютПрофиль() Экспорт

	П = mcp1c_ПравилаДоступа.НоваяПолитика();
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("*"));
	П.НедоступныеОбъекты.Вставить("справочник.сотрудники", Истина);
	Утв.Ложно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "Справочник.Сотрудники"));
	Утв.Ложно(mcp1c_ПравилаДоступа.ПолеДоступно(П, "Справочник.Сотрудники", "Наименование"));
	Утв.Истинно(mcp1c_ПравилаДоступа.ОбъектДоступен(П, "Справочник.Контрагенты"));

КонецПроцедуры

Процедура ТестВиртуальнаяТаблицаБезПараметров() Экспорт

	К = mcp1c_КонструкторЗапросов;
	С = К.НоваяСпецификация("РегистрНакопления.ТоварыНаСкладах.Остатки");
	С.ПараметрыТаблицы = СтрРазделить("|{Условие}", "|");
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.КоличествоОстаток", "К1", "СУММА"));
	Утв.Содержит(К.ТекстЗапроса(С), "РегистрНакопления.ТоварыНаСкладах.Остатки КАК Т");

КонецПроцедуры

// Тесты mcp1c_Маскирование: маски значений полей (п. 7.4 ТЗ).
#Использовать "../../build/oslib"

Функция Ссылка(Представление, Идентификатор = "4e0c1d2a-0000-0000-0000-000000000001")

	Значение = Новый Соответствие;
	Значение.Вставить("type", "Справочник.БанковскиеСчета");
	Значение.Вставить("ref", Идентификатор);
	Значение.Вставить("presentation", Представление);
	Возврат Значение;

КонецФункции

Функция Маскировать(Значение, Вид, Параметр = 0, Соль = "соль", КлючХеша = "")

	Возврат mcp1c_Маскирование.ЗамаскированноеЗначение(Значение, mcp1c_Маскирование.НоваяМаска(Вид, Параметр), Соль,
		КлючХеша);

КонецФункции

Процедура ТестНоваяМаска() Экспорт

	Маска = mcp1c_Маскирование.НоваяМаска("partial");
	Утв.Равно(Маска.Вид, "partial");
	Утв.Равно(Маска.Параметр, 4, "по умолчанию видны 4 последних символа");
	Утв.Равно(mcp1c_Маскирование.НоваяМаска("partial", 2.7).Параметр, 2, "целое число символов");
	Утв.Равно(mcp1c_Маскирование.НоваяМаска("partial", 0.5).Параметр, 1, "хотя бы один символ");
	Утв.Равно(mcp1c_Маскирование.НоваяМаска("round").Параметр, 1000, "шаг округления по умолчанию");
	Утв.Равно(mcp1c_Маскирование.НоваяМаска("round", 0.5).Параметр, 0.5);
	Утв.Равно(mcp1c_Маскирование.НоваяМаска("hash", 7).Параметр, 0);
	Утв.Равно(mcp1c_Маскирование.НоваяМаска("неизвестная").Вид, "full", "неизвестный вид - полная маска");
	Утв.Равно(mcp1c_Маскирование.НоваяМаска("").Вид, "full");

КонецПроцедуры

Процедура ТестПолнаяМаска() Экспорт

	Утв.Равно(Маскировать("АА123456", "full"), "***");
	Утв.Равно(Маскировать(15000, "full"), "***");
	Утв.Равно(Маскировать(Истина, "full"), "***");
	Утв.Равно(Маскировать(Ссылка("UA213223130000026007233566001"), "full"), "***");
	Утв.Неопределено_(Маскировать(Неопределено, "full"), "пустое значение остается пустым");

КонецПроцедуры

Процедура ТестЧастичнаяМаска() Экспорт

	Утв.Равно(Маскировать("UA213223130000026007233566001", "partial"), "***6001");
	Утв.Равно(Маскировать(" +380 50 123 45 67 ", "partial", 2), "***67", "пробелы по краям не считаются");
	Утв.Равно(Маскировать("1234", "partial"), "***", "значение не длиннее N скрывается полностью");
	Утв.Равно(Маскировать(380501234567, "partial"), "***4567", "число");
	Утв.Равно(Маскировать(1234.5, "partial", 3), "***4.5", "дробная часть через точку");
	Утв.Равно(Маскировать(Ссылка("Рахунок UA21...6001"), "partial"), "***6001", "ссылка - по представлению");

	Скрытая = Ссылка("<приховано>");
	Скрытая.Удалить("ref");
	Утв.Равно(Маскировать(Скрытая, "partial"), "***", "представление скрытого объекта не раскрывается");
	Утв.Равно(Маскировать(Ссылка("***"), "partial", 2), "***", "замаскированное представление не раскрывается");
	Утв.Равно(Маскировать(Истина, "partial"), "***");

КонецПроцедуры

Процедура ТестХеш() Экспорт

	Хеш = Маскировать("1234567890", "hash");
	Утв.Равно(Лев(Хеш, 2), "h:");
	Утв.Равно(СтрДлина(Хеш), 14, "h: и 12 символов");
	Утв.Равно(Сред(Хеш, 3), Лев(mcp1c_Служебный.ХешSHA256("1234567890" + "соль"), 12), "SHA-256(значение + соль)");
	Утв.Равно(Маскировать("1234567890", "hash"), Хеш, "одинаковые значения - одинаковый хеш");
	Утв.НеРавно(Маскировать("1234567891", "hash"), Хеш, "разные значения - разный хеш");
	Утв.НеРавно(Маскировать("1234567890", "hash", , "другая соль"), Хеш, "соль другого профиля");
	Утв.Равно(Маскировать(15, "hash"), Маскировать("15", "hash"), "число - по десятичной записи");

	// Ключ хеша от исходного значения: ссылки на скрытые объекты различаются по идентификатору.
	Первая = Маскировать(Ссылка("А"), "hash", , , "Справочник.Б:1");
	Вторая = Маскировать(Ссылка("А"), "hash", , , "Справочник.Б:2");
	Утв.НеРавно(Первая, Вторая);
	Утв.Равно(Маскировать(Ссылка("А"), "hash"), Маскировать(Ссылка("Б"), "hash"),
		"без ключа - по типу и идентификатору, а не по представлению");
	Утв.НеРавно(Маскировать(Ссылка("А", "4e0c1d2a-0000-0000-0000-000000000002"), "hash"), Маскировать(Ссылка("А"), "hash"));
	Утв.Неопределено_(Маскировать(Неопределено, "hash"));

КонецПроцедуры

Процедура ТестОкругление() Экспорт

	Утв.Равно(Маскировать(12345.67, "round"), 12000);
	Утв.Равно(Маскировать(12500, "round"), 13000, "половина - от нуля");
	Утв.Равно(Маскировать(-1499, "round"), -1000);
	Утв.Равно(Маскировать(1.26, "round", 0.5), 1.5);
	Утв.Равно(Маскировать(0, "round"), 0);
	Утв.Равно(Маскировать("12345", "round"), "***", "не число - полная маска");
	Утв.Равно(mcp1c_Маскирование.Округлить(149, 100), 100);
	Утв.Равно(mcp1c_Маскирование.Округлить(150, 0), 0, "шаг 0 - 1000");

КонецПроцедуры

Процедура ТестОписаниеДляМодели() Экспорт

	Описание = mcp1c_Маскирование.ОписаниеДляМодели(mcp1c_Маскирование.НоваяМаска("partial", 2));
	Утв.Равно(Описание.Получить("kind"), "partial");
	Утв.Равно(Описание.Получить("visible_chars"), 2);
	Описание = mcp1c_Маскирование.ОписаниеДляМодели(mcp1c_Маскирование.НоваяМаска("round", 500));
	Утв.Равно(Описание.Получить("step"), 500);
	Описание = mcp1c_Маскирование.ОписаниеДляМодели(mcp1c_Маскирование.НоваяМаска("hash"));
	Утв.Равно(Описание.Количество(), 1, "у хеша только вид");

КонецПроцедуры

Процедура ТестПредставлениеМаски() Экспорт

	Утв.Равно(mcp1c_Маскирование.Представление(mcp1c_Маскирование.НоваяМаска("full")), "повна");
	Утв.Равно(mcp1c_Маскирование.Представление(mcp1c_Маскирование.НоваяМаска("partial", 2)), "часткова (видно 2 симв.)");
	Утв.Равно(mcp1c_Маскирование.Представление(mcp1c_Маскирование.НоваяМаска("hash")), "хеш");
	Утв.Равно(mcp1c_Маскирование.Представление(mcp1c_Маскирование.НоваяМаска("round", 0.5)), "округлення до 0.5");
	Утв.Равно(mcp1c_Маскирование.Представление(mcp1c_Маскирование.НоваяМаска("blur")), "повна", "неизвестный вид - полная");

КонецПроцедуры

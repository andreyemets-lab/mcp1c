// Тесты mcp1c_КонструкторЗапросов. Ожидаемые тексты проверены валидатором запросов EDT
// на метаданных типовой конфигурации (BAS Бухгалтерия).
#Использовать "../../build/oslib"

Функция Текст(Строки)

	Возврат СтрЗаменить(СтрСоединить(Строки, Символы.ПС), "\t", Символы.Таб);

КонецФункции

Функция Массив(Знач Значения)

	Возврат СтрРазделить(Значения, ",");

КонецФункции

Процедура ТестВыборкаСОтборамиИПорядком() Экспорт

	К = mcp1c_КонструкторЗапросов;
	С = К.НоваяСпецификация("Документ.РеализацияТоваровУслуг");
	С.Первые = 51;
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Ссылка", "П1", "", "ссылки"));
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Дата", "П2"));
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Контрагент", "П3", "", "ссылки"));
	С.Условия.Добавить(К.НовоеУсловие("Т.ПометкаУдаления", "eq", Массив("ПометкаУдаления")));
	С.Условия.Добавить(К.НовоеУсловие("Т.Дата", "between", Массив("Ф1,Ф2")));
	С.Условия.Добавить(К.НовоеУсловие("Т.Комментарий", "contains", Массив("Ф3"), Ложь, Истина));
	С.Условия.Добавить(К.НовоеУсловие("Т.Организация", "in", Массив("Ф4")));
	С.Порядок.Добавить(К.НовыйЭлементПорядка("Т.Дата", Истина));
	С.Порядок.Добавить(К.НовыйЭлементПорядка("Т.Ссылка"));

	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Ссылка КАК П1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Ссылка) КАК П1_П,");
	Ожидается.Добавить("\tТ.Дата КАК П2,");
	Ожидается.Добавить("\tТ.Контрагент КАК П3,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Контрагент) КАК П3_П");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tДокумент.РеализацияТоваровУслуг КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.ПометкаУдаления = &ПометкаУдаления");
	Ожидается.Добавить("\tИ Т.Дата МЕЖДУ &Ф1 И &Ф2");
	Ожидается.Добавить("\tИ ВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(1024)) ПОДОБНО &Ф3 СПЕЦСИМВОЛ ""~""");
	Ожидается.Добавить("\tИ Т.Организация В (&Ф4)");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tТ.Дата УБЫВ,");
	Ожидается.Добавить("\tТ.Ссылка");
	Утв.Равно(К.ТекстЗапроса(С), Текст(Ожидается));

КонецПроцедуры

Процедура ТестГруппировкаИАгрегаты() Экспорт

	К = mcp1c_КонструкторЗапросов;
	С = К.НоваяСпецификация("Документ.РеализацияТоваровУслуг");
	С.Первые = 11;
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Контрагент", "П1", "", "ссылки"));
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.СуммаДокумента", "П2", "СУММА"));
	С.Поля.Добавить(К.НовоеПолеВыборки("*", "П3", "КОЛИЧЕСТВО"));
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Ссылка", "П4", "КОЛИЧЕСТВО РАЗЛИЧНЫЕ"));
	С.Группировки.Добавить(К.НовоеВыражение("Т.Контрагент"));
	С.Порядок.Добавить(К.НовыйЭлементПорядка("П2", Истина));
	С.Порядок.Добавить(К.НовыйЭлементПорядка("Т.Контрагент", Ложь, Истина));

	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 11");
	Ожидается.Добавить("\tТ.Контрагент КАК П1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Контрагент) КАК П1_П,");
	Ожидается.Добавить("\tСУММА(Т.СуммаДокумента) КАК П2,");
	Ожидается.Добавить("\tКОЛИЧЕСТВО(*) КАК П3,");
	Ожидается.Добавить("\tКОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Ссылка) КАК П4");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tДокумент.РеализацияТоваровУслуг КАК Т");
	Ожидается.Добавить("СГРУППИРОВАТЬ ПО");
	Ожидается.Добавить("\tТ.Контрагент");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tП2 УБЫВ,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Контрагент)");
	Утв.Равно(К.ТекстЗапроса(С), Текст(Ожидается));

КонецПроцедуры

Процедура ТестВиртуальнаяТаблица() Экспорт

	К = mcp1c_КонструкторЗапросов;
	С = К.НоваяСпецификация("РегистрБухгалтерии.Хозрасчетный.Остатки");
	С.Первые = 51;
	С.ПараметрыТаблицы = СтрРазделить("&Период|Счет В ИЕРАРХИИ (&Счет)||{Условие}", "|");
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Счет", "П1", "", "ссылки"));
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.СуммаОстатокДт", "П2", "СУММА"));
	С.Условия.Добавить(К.НовоеУсловие("Т.Организация", "eq", Массив("Ф1"), Истина));
	С.Условия.Добавить(К.НовоеУсловие("Т.Субконто1", "in", Массив("Ф2"), Истина));
	С.Группировки.Добавить(К.НовоеВыражение("Т.Счет"));
	С.Порядок.Добавить(К.НовыйЭлементПорядка("П1"));

	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Счет КАК П1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Счет) КАК П1_П,");
	Ожидается.Добавить("\tСУММА(Т.СуммаОстатокДт) КАК П2");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tРегистрБухгалтерии.Хозрасчетный.Остатки(&Период, Счет В ИЕРАРХИИ (&Счет), , Организация = &Ф1 И Субконто1 В (&Ф2)) КАК Т");
	Ожидается.Добавить("СГРУППИРОВАТЬ ПО");
	Ожидается.Добавить("\tТ.Счет");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tП1");
	Утв.Равно(К.ТекстЗапроса(С), Текст(Ожидается));

	// Без условий пустые хвостовые параметры отбрасываются.
	С.Условия.Очистить();
	Утв.Содержит(К.ТекстЗапроса(С), "РегистрБухгалтерии.Хозрасчетный.Остатки(&Период, Счет В ИЕРАРХИИ (&Счет)) КАК Т");

КонецПроцедуры

Процедура ТестГруппаИЛИПустоеЗначениеИНеограниченнаяСтрока() Экспорт

	К = mcp1c_КонструкторЗапросов;
	С = К.НоваяСпецификация("Документ.РеализацияТоваровУслуг");
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Комментарий", "П1", "", "", Истина));
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.СуммаДокумента", "П2", "СУММА"));
	Группа = К.НовоеУсловие("", "or");
	Группа.Элементы.Добавить(К.НовоеУсловие("Т.Организация", "eq", Массив("О1")));
	Группа.Элементы.Добавить(К.НовоеУсловие("Т.Организация", "in_hierarchy", Массив("О2")));
	С.Условия.Добавить(Группа);
	С.Условия.Добавить(К.НовоеУсловие("Т.Контрагент.ИНН", "is_empty", Массив("Ф5")));
	С.Условия.Добавить(К.НовоеУсловие("Т.Номер", "not_empty", Массив("Ф6")));
	С.Условия.Добавить(К.НовоеУсловие("Т.Контрагент", "not_in", Массив("Ф7")));
	С.Группировки.Добавить(К.НовоеВыражение("Т.Комментарий", Истина));

	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ");
	Ожидается.Добавить("\tВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(1024)) КАК П1,");
	Ожидается.Добавить("\tСУММА(Т.СуммаДокумента) КАК П2");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tДокумент.РеализацияТоваровУслуг КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\t(Т.Организация = &О1 ИЛИ Т.Организация В ИЕРАРХИИ (&О2))");
	Ожидается.Добавить("\tИ (Т.Контрагент.ИНН ЕСТЬ NULL ИЛИ Т.Контрагент.ИНН = &Ф5)");
	Ожидается.Добавить("\tИ (НЕ Т.Номер ЕСТЬ NULL И Т.Номер <> &Ф6)");
	Ожидается.Добавить("\tИ НЕ Т.Контрагент В (&Ф7)");
	Ожидается.Добавить("СГРУППИРОВАТЬ ПО");
	Ожидается.Добавить("\tВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(1024))");
	Утв.Равно(К.ТекстЗапроса(С), Текст(Ожидается));

КонецПроцедуры

Процедура ТестЭкранированиеДляПодобно() Экспорт

	Утв.Равно(mcp1c_КонструкторЗапросов.ЭкранироватьДляПодобно("50%_[a]~"), "50~%~_~[a]~~");

КонецПроцедуры

Процедура ТестМинимальныйРазмерГруппы() Экспорт

	К = mcp1c_КонструкторЗапросов;
	С = К.НоваяСпецификация("РегистрНакопления.Зарплата");
	С.Первые = 51;
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Подразделение", "К1", "", "ссылки"));
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Сумма", "К2", "СУММА"));
	С.Условия.Добавить(К.НовоеУсловие("Т.Активность", "eq", Массив("П1")));
	С.Группировки.Добавить(К.НовоеВыражение("Т.Подразделение"));
	С.Имеющие.Добавить(К.НовоеУсловие("КОЛИЧЕСТВО(*)", "gte", Массив("П2")));
	С.Порядок.Добавить(К.НовыйЭлементПорядка("К1"));

	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Подразделение КАК К1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Подразделение) КАК К1_П,");
	Ожидается.Добавить("\tСУММА(Т.Сумма) КАК К2");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tРегистрНакопления.Зарплата КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.Активность = &П1");
	Ожидается.Добавить("СГРУППИРОВАТЬ ПО");
	Ожидается.Добавить("\tТ.Подразделение");
	Ожидается.Добавить("ИМЕЮЩИЕ");
	Ожидается.Добавить("\tКОЛИЧЕСТВО(*) >= &П2");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tК1");
	Утв.Равно(К.ТекстЗапроса(С), Текст(Ожидается));

	// Итог без группировки: ИМЕЮЩИЕ относится ко всей выборке (проверено на платформе 8.3.27).
	С = К.НоваяСпецификация("РегистрНакопления.Зарплата");
	С.Поля.Добавить(К.НовоеПолеВыборки("Т.Сумма", "К1", "СУММА"));
	С.Имеющие.Добавить(К.НовоеУсловие("КОЛИЧЕСТВО(*)", "gte", Массив("П1")));
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ");
	Ожидается.Добавить("\tСУММА(Т.Сумма) КАК К1");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tРегистрНакопления.Зарплата КАК Т");
	Ожидается.Добавить("ИМЕЮЩИЕ");
	Ожидается.Добавить("\tКОЛИЧЕСТВО(*) >= &П1");
	Утв.Равно(К.ТекстЗапроса(С), Текст(Ожидается));

КонецПроцедуры

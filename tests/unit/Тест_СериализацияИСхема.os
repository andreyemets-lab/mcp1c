// Тесты mcp1c_Сериализация и mcp1c_СхемаJSON.
#Использовать "../../build/oslib"

Процедура ТестКаноническийJSON() Экспорт

	Значение = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON("{""b"":1,""a"":[true,null,""x""],""c"":{""z"":1,""y"":""Привіт""}}");
	Утв.Равно(mcp1c_Сериализация.КаноническийJSON(Значение),
		"{""a"":[true,null,""x""],""b"":1,""c"":{""y"":""Привіт"",""z"":1}}");
	Утв.Равно(mcp1c_Сериализация.КаноническийJSON(Новый Соответствие), "{}");
	Утв.Равно(mcp1c_Сериализация.КаноническийJSON(Новый Массив), "[]");

КонецПроцедуры

Процедура ТестЗаписьБезЭкранированияКириллицы() Экспорт

	Данные = Новый Соответствие;
	Данные.Вставить("name", "Контрагенты ""А""");
	Утв.Равно(mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Данные), "{""name"":""Контрагенты \""А\""""}");

КонецПроцедуры

Процедура ТестГлубинаВложенности() Экспорт

	Утв.Равно(mcp1c_Сериализация.ГлубинаВложенности(mcp1c_Сериализация.ПрочитатьИзСтрокиJSON("1")), 0);
	Утв.Равно(mcp1c_Сериализация.ГлубинаВложенности(mcp1c_Сериализация.ПрочитатьИзСтрокиJSON("{""a"":[{""b"":[]}]}")), 4);

КонецПроцедуры

Функция СхемаАргументов()

	Фильтр = Новый Соответствие;
	Фильтр.Вставить("field", mcp1c_СхемаJSON.СхемаСтроки("поле", 10));
	Фильтр.Вставить("op", mcp1c_СхемаJSON.СхемаСтроки("оператор", 20, СтрРазделить("eq,ne", ",")));
	Фильтр.Вставить("value", mcp1c_СхемаJSON.СхемаЗначения("значение"));

	Свойства = Новый Соответствие;
	Свойства.Вставить("object", mcp1c_СхемаJSON.СхемаСтроки("объект", 50));
	Свойства.Вставить("limit", mcp1c_СхемаJSON.СхемаЦелого("лимит", 1, 100, 50));
	Свойства.Вставить("flag", mcp1c_СхемаJSON.СхемаБулево("флаг"));
	Свойства.Вставить("filters", mcp1c_СхемаJSON.СхемаМассива("отборы",
		mcp1c_СхемаJSON.СхемаОбъекта(Фильтр, "field,op"), 2));
	Возврат mcp1c_СхемаJSON.СхемаОбъекта(Свойства, "object");

КонецФункции

Функция Ошибки(ТекстJSON)

	Результат = Новый Массив;
	mcp1c_СхемаJSON.Проверить(mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(ТекстJSON), СхемаАргументов(), "arguments", Результат);
	Возврат СтрСоединить(Результат, "; ");

КонецФункции

Процедура ТестКорректныеАргументы() Экспорт

	Утв.Равно(Ошибки("{""object"":""Справочник.Контрагенты""}"), "");
	Утв.Равно(Ошибки("{""object"":""X"",""limit"":5,""flag"":true,""filters"":[{""field"":""ИНН"",""op"":""eq"",""value"":{""a"":1}}]}"), "");
	Утв.Равно(Ошибки("{""object"":""X"",""limit"":null}"), "", "null - как отсутствие параметра");

КонецПроцедуры

Процедура ТестНекорректныеАргументы() Экспорт

	Утв.Содержит(Ошибки("{}"), "arguments.object: обов'язковий параметр");
	Утв.Содержит(Ошибки("{""object"":1}"), "arguments.object: очікується рядок");
	Утв.Содержит(Ошибки("{""object"":""X"",""extra"":1}"), "arguments.extra: невідомий параметр");
	Утв.Содержит(Ошибки("{""object"":""X"",""limit"":0}"), "arguments.limit: не менше 1");
	Утв.Содержит(Ошибки("{""object"":""X"",""limit"":101}"), "arguments.limit: не більше 100");
	Утв.Содержит(Ошибки("{""object"":""X"",""limit"":1.5}"), "ціле число");
	Утв.Содержит(Ошибки("{""object"":""X"",""flag"":""так""}"), "arguments.flag: очікується true або false");
	Утв.Содержит(Ошибки("{""object"":""12345678901234567890123456789012345678901234567890X""}"), "не більше 50 символів");
	Утв.Содержит(Ошибки("{""object"":""X"",""filters"":[{""field"":""a"",""op"":""like""}]}"), "допустимі значення: eq, ne");
	Утв.Содержит(Ошибки("{""object"":""X"",""filters"":[{""op"":""eq""},{""field"":""a"",""op"":""eq""},{""field"":""b"",""op"":""eq""}]}"),
		"не більше 2 елементів");
	Утв.Содержит(Ошибки("{""object"":""X"",""filters"":[{""op"":""eq""}]}"), "arguments.filters[0].field: обов'язковий параметр");
	Утв.Содержит(Ошибки("[]"), "arguments: очікується об'єкт");

КонецПроцедуры

// Тесты mcp1c_ПроверкаЗапросов: лексемы, проверка пакета запросов модели правилами профиля,
// таблицы запросов отчетов, значения параметров.
#Использовать "../../build/oslib"

Функция Описания()

	Описания = Новый Соответствие;

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Справочник.Контрагенты", "Справочник.Контрагенты", "catalog");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Справочник.Контрагенты", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Наименование", "Строка", "standard", 100);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ИНН", "Строка", , 12);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Комментарий", "Строка", , 0);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ГоловнойКонтрагент", "Справочник.Контрагенты");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ПарольКабинета", "Строка", , 50);
	Описания.Вставить(Т.Имя, Т);

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Документ.Реализация", "Документ.Реализация", "document");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Документ.Реализация", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Дата", "Дата", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Проведен", "Булево", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Контрагент", "Справочник.Контрагенты");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Организация", "Справочник.Организации");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "СуммаДокумента", "Число");
	Описания.Вставить(Т.Имя, Т);

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Документ.Реализация.Товары", "Документ.Реализация", "document",
		"tabular_section");
	Т.ПрефиксПолейПолитики = "Товары.";
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Документ.Реализация", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Количество", "Число");
	Описания.Вставить(Т.Имя, Т);

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Справочник.Организации", "Справочник.Организации", "catalog");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Справочник.Организации", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Наименование", "Строка", "standard", 100);
	Описания.Вставить(Т.Имя, Т);

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("РегистрНакопления.ТоварыНаСкладах.Остатки",
		"РегистрНакопления.ТоварыНаСкладах", "accumulation_register", "virtual");
	Т.ВиртуальнаяТаблица = "Остатки";
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Номенклатура", "Справочник.Номенклатура", "dimension");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Склад", "Справочник.Склады", "dimension");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ПарольСклада", "Строка", "dimension", 20);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "КоличествоОстаток", "Число", "resource", 0, "Количество");
	Описания.Вставить(Т.Имя, Т);

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Справочник.Склады", "Справочник.Склады", "catalog");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Справочник.Склады", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Наименование", "Строка", "standard", 100);
	Описания.Вставить(Т.Имя, Т);

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Документ.Поступление", "Документ.Поступление", "document");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Документ.Поступление", "standard");
	Описания.Вставить(Т.Имя, Т);
	Возврат Описания;

КонецФункции

Функция Политика()

	П = mcp1c_ПравилаДоступа.НоваяПолитика();
	П.ЗапрещенныеПоля.Добавить("*Пароль*");
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("*"));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.Номенклатура", "aggregates"));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Справочник.Сотрудники", "deny"));
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Документ.Заказ", "read", Ложь, Истина));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "Комментарий", "mask", "full"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Организации", "Наименование", "deny"));
	П.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.Поступление", "Организация",
		"eq", "x"));
	Возврат П;

КонецФункции

// Источник таблицы ИБ с описанием из тестового набора (Неопределено - таблица не поддерживается).
Функция Таблица(Псевдоним, Имя)

	Источник = mcp1c_ПроверкаЗапросов.НовыйИсточник("table", Псевдоним, Имя);
	Источник.Описание = Описания().Получить(Имя);
	Возврат Источник;

КонецФункции

// Разбор пакета: источники и псевдонимы колонок через запятую, как их находит схема запроса.
Функция Разбор(Источник1, Источник2 = Неопределено, Колонки = "")

	Разбор = mcp1c_ПроверкаЗапросов.НовыйРазборПакета();
	Разбор.Источники.Добавить(Источник1);
	Если Источник2 <> Неопределено Тогда
		Разбор.Источники.Добавить(Источник2);
	КонецЕсли;
	Для Каждого Колонка Из СтрРазделить(Колонки, ",", Ложь) Цикл
		Разбор.Колонки.Добавить(Колонка);
	КонецЦикла;
	Возврат Разбор;

КонецФункции

// Проверка с подгрузкой описаний для разыменования, как это делает mcp1c_ИнструментыДанных.
Функция Проверить(Разбор, Текст, Политика = Неопределено)

	Если Политика = Неопределено Тогда
		Политика = Политика();
	КонецЕсли;
	Все = Описания();
	Загруженные = Новый Соответствие;
	Для Попытка_ = 1 По 10 Цикл
		Результат = mcp1c_ПроверкаЗапросов.ПроверитьПакет(Разбор, Текст, Загруженные, Политика);
		Если ПустаяСтрока(Результат.НужноОписание) Тогда
			Возврат Результат;
		КонецЕсли;
		Описание = Все.Получить(Результат.НужноОписание);
		Если Описание = Неопределено Тогда
			Результат.Ошибка = "нет описания " + Результат.НужноОписание;
			Возврат Результат;
		КонецЕсли;
		Загруженные.Вставить(Результат.НужноОписание, Описание);
	КонецЦикла;
	ВызватьИсключение "Проверка не завершилась";

КонецФункции

Функция Ошибка(Разбор, Текст, Политика = Неопределено)

	Результат = Проверить(Разбор, Текст, Политика);
	Утв.Ложно(Результат.Успех, "ожидается отказ: " + Текст);
	Возврат Результат.Ошибка;

КонецФункции

Процедура ТестЛексемы() Экспорт

	Разобранный = mcp1c_ПроверкаЗапросов.Лексемы("ВЫБРАТЬ Т.Поле // комментарий Т.Пароль" + Символы.ПС
		+ "ГДЕ Т.Имя = ""а""""б"" И &Пар_1 >= 1.5 И Т.Код <> 7");
	Утв.Равно(Разобранный.Ошибка, "");
	Части = Новый Массив;
	Для Каждого Лексема Из Разобранный.Лексемы Цикл
		Части.Добавить(Лексема.Вид + ":" + Лексема.Текст);
	КонецЦикла;
	Утв.Равно(СтрСоединить(Части, " "), "name:ВЫБРАТЬ name:Т sign:. name:Поле name:ГДЕ name:Т sign:. name:Имя sign:= "
		+ "string:а""б name:И param:Пар_1 sign:>= number:1.5 name:И name:Т sign:. name:Код sign:<> number:7",
		"комментарий пропущен, кавычки удвоены");
	Утв.Равно(Разобранный.Лексемы[0].Ключ, "ВЫБРАТЬ");
	Утв.Содержит(mcp1c_ПроверкаЗапросов.Лексемы("ВЫБРАТЬ ""а").Ошибка, "незакритий рядок");

КонецПроцедуры

Процедура ТестДопустимыйЗапрос() Экспорт

	Текст = "ВЫБРАТЬ ПЕРВЫЕ 51
	|	Р.Ссылка КАК Ссылка,
	|	Р.Контрагент.ГоловнойКонтрагент.Наименование КАК Головной,
	|	ЕСТЬNULL(СУММА(Р.СуммаДокумента), 0) КАК Сумма,
	|	НАЧАЛОПЕРИОДА(Р.Дата, МЕСЯЦ) КАК Месяц,
	|	ВЫБОР КОГДА Р.Проведен ТОГДА ""так"" ИНАЧЕ ""ні"" КОНЕЦ КАК Стан
	|ИЗ
	|	Документ.Реализация КАК Р
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК К
	|		ПО (Р.Контрагент = К.Ссылка)
	|ГДЕ
	|	Р.Дата МЕЖДУ &Начало И &Конец
	|	И Р.Проведен
	|	И Р.Контрагент ССЫЛКА Справочник.Контрагенты
	|	И Р.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И ТИПЗНАЧЕНИЯ(Р.Контрагент) = ТИП(Справочник.Контрагенты)
	|	И НЕ К.Наименование ПОДОБНО ""%тест%""
	|	И ВЫРАЗИТЬ(К.ИНН КАК СТРОКА(12)) <> """"
	|	И К.Ссылка В ИЕРАРХИИ (&Группа)
	|
	|СГРУППИРОВАТЬ ПО
	|	Р.Ссылка,
	|	Р.Контрагент.ГоловнойКонтрагент.Наименование,
	|	НАЧАЛОПЕРИОДА(Р.Дата, МЕСЯЦ),
	|	Р.Проведен
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ";
	Результат = Проверить(Разбор(Таблица("Р", "Документ.Реализация"), Таблица("К", "Справочник.Контрагенты"),
		"Ссылка,Головной,Сумма,Месяц,Стан"), Текст);
	Утв.Равно(Результат.Ошибка, "");
	Утв.Истинно(Результат.Успех);
	Утв.МассивРавен(Результат.Объекты, "Документ.Реализация,Справочник.Контрагенты");

КонецПроцедуры

Процедура ТестПоляПоПолитике() Экспорт

	Р = Разбор(Таблица("Р", "Документ.Реализация"), Таблица("К", "Справочник.Контрагенты"));
	Из = " ИЗ Документ.Реализация КАК Р ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК К ПО Р.Контрагент = К.Ссылка";
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ К.ПарольКабинета КАК П" + Из), "не знайдено або недоступне",
		"глобальный запрет не отличается от отсутствующего поля");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ К.Ссылка КАК С" + Из + " ГДЕ К.ПарольКабинета = &П"), "ПарольКабинета",
		"запрещенное поле в условии");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ Р.Контрагент.ПарольКабинета КАК П" + Из), "не знайдено або недоступне",
		"запрещенное поле через разыменование");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ К.Комментарий КАК К1" + Из), "масковане профілем", "маска");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ Р.Ссылка КАК С" + Из + " УПОРЯДОЧИТЬ ПО К.Комментарий"), "масковане",
		"маска в сортировке");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ Р.Организация.Наименование КАК О" + Из), "не знайдено або недоступне",
		"поле, запрещенное правилом профиля");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ Р.Нет КАК Н" + Из), "«Нет» не знайдено");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ Нечто КАК Н" + Из), "Невідоме ім'я «Нечто»");

	// Поле без псевдонима проверяется в каждом источнике, где оно есть.
	Утв.Истинно(Проверить(Р, "ВЫБРАТЬ Наименование КАК Н" + Из).Успех, "Наименование есть только у контрагентов");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ ПарольКабинета КАК Н" + Из), "не знайдено або недоступне");

КонецПроцедуры

Процедура ТестИсточникиПоПолитике() Экспорт

	Утв.Содержит(Ошибка(Разбор(Таблица("Н", "Справочник.Номенклатура")), "ВЫБРАТЬ Н.Ссылка ИЗ Справочник.Номенклатура КАК Н"),
		"«Справочник.Номенклатура» не знайдено", "нет описания - как недоступная таблица");

	Источник = mcp1c_ПроверкаЗапросов.НовыйИсточник("table", "Н", "Справочник.Номенклатура");
	Источник.Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Справочник.Номенклатура", "Справочник.Номенклатура",
		"catalog");
	Результат = Проверить(Разбор(Источник), "ВЫБРАТЬ 1 ИЗ Справочник.Номенклатура КАК Н");
	Утв.Содержит(Результат.Ошибка, "лише в агрегатах");
	Утв.Содержит(Результат.Причина, "Лише агрегати");

	Источник = mcp1c_ПроверкаЗапросов.НовыйИсточник("table", "С", "Справочник.Сотрудники");
	Источник.Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Справочник.Сотрудники", "Справочник.Сотрудники", "catalog");
	Результат = Проверить(Разбор(Источник), "ВЫБРАТЬ 1 ИЗ Справочник.Сотрудники КАК С");
	Утв.Содержит(Результат.Ошибка, "не знайдено, вона недоступна");
	Утв.Содержит(Результат.Причина, "заборонений політикою");

	Результат = Проверить(Разбор(Таблица("П", "Документ.Поступление")), "ВЫБРАТЬ П.Ссылка ИЗ Документ.Поступление КАК П");
	Утв.Содержит(Результат.Ошибка, "обмеження рядків");
	Утв.Содержит(Результат.Причина, "Обмеження рядків");

	Источник = mcp1c_ПроверкаЗапросов.НовыйИсточник("table", "З", "Документ.Заказ");
	Источник.Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Документ.Заказ", "Документ.Заказ", "document");
	Утв.Содержит(Ошибка(Разбор(Источник), "ВЫБРАТЬ 1 ИЗ Документ.Заказ КАК З"), "вимагає відбору за періодом");

	Константы = mcp1c_ПроверкаЗапросов.НовыйИсточник("table", "Константы", "Константы");
	Утв.Содержит(Ошибка(Разбор(Константы), "ВЫБРАТЬ Константы.Х ИЗ Константы КАК Константы"), "«Константы» не знайдено");

	ПолитикаБезТабличнойЧасти = Политика();
	ПолитикаБезТабличнойЧасти.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.Реализация", "Товары", "deny"));
	Утв.Содержит(Ошибка(Разбор(Таблица("Т", "Документ.Реализация.Товары")),
		"ВЫБРАТЬ Т.Количество ИЗ Документ.Реализация.Товары КАК Т", ПолитикаБезТабличнойЧасти), "не знайдено",
		"запрещенная табличная часть");
	Утв.Истинно(Проверить(Разбор(Таблица("Т", "Документ.Реализация.Товары")),
		"ВЫБРАТЬ Т.Количество, Т.Ссылка.Контрагент.Наименование ИЗ Документ.Реализация.Товары КАК Т").Успех,
		"табличная часть и переход к владельцу");

КонецПроцедуры

Процедура ТестТаблицыВнеИсточников() Экспорт

	Р = Разбор(Таблица("Р", "Документ.Реализация"));
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ Р.Ссылка ИЗ Документ.Реализация КАК Р ГДЕ Р.Контрагент В "
		+ "(ВЫБРАТЬ К.Ссылка ИЗ Справочник.Контрагенты КАК К ГДЕ К.ПарольКабинета = """")"),
		"«Справочник.Контрагенты» - не джерело", "вложенный запрос в условии");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ Р.Ссылка ИЗ Документ.Реализация КАК Р ГДЕ Р.Контрагент В "
		+ "(ВЫБРАТЬ Ссылка ИЗ Справочник.Контрагенты)"), "не джерело");

КонецПроцедуры

Процедура ТестВременныеТаблицыИВложенныеЗапросы() Экспорт

	Разбор = mcp1c_ПроверкаЗапросов.НовыйРазборПакета();
	Разбор.Источники.Добавить(Таблица("Р", "Документ.Реализация"));
	Колонки = СтрРазделить("Контрагент,Сумма", ",");
	Разбор.ВременныеТаблицы.Вставить("вт", Колонки);
	Разбор.Источники.Добавить(mcp1c_ПроверкаЗапросов.НовыйИсточник("temporary", "ВТ", "ВТ", Колонки));
	Разбор.Источники.Добавить(mcp1c_ПроверкаЗапросов.НовыйИсточник("nested", "Вл", "", СтрРазделить("Контрагент", ",")));
	Для Каждого Колонка Из СтрРазделить("Контрагент,Сумма,Контрагент,Сумма,Контрагент,Итог", ",") Цикл
		Разбор.Колонки.Добавить(Колонка);
	КонецЦикла;
	Текст = "ВЫБРАТЬ Р.Контрагент КАК Контрагент, Р.СуммаДокумента КАК Сумма ПОМЕСТИТЬ ВТ ИЗ Документ.Реализация КАК Р
	|ИНДЕКСИРОВАТЬ ПО Контрагент;
	|ВЫБРАТЬ ВТ.Контрагент КАК Контрагент, СУММА(ВТ.Сумма) КАК Сумма ИЗ ВТ КАК ВТ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ВТ.Контрагент КАК Контрагент ИЗ ВТ КАК ВТ) КАК Вл ПО ВТ.Контрагент = Вл.Контрагент
	|СГРУППИРОВАТЬ ПО ВТ.Контрагент УПОРЯДОЧИТЬ ПО Сумма;
	|УНИЧТОЖИТЬ ВТ";
	Результат = Проверить(Разбор, Текст);
	Утв.Равно(Результат.Ошибка, "");
	Утв.Истинно(Результат.Успех);

	Утв.Содержит(Ошибка(Разбор, "ВЫБРАТЬ ВТ.Контрагент.ПарольКабинета КАК П ИЗ ВТ КАК ВТ"),
		"Розіменування колонок тимчасових таблиць");
	Утв.Содержит(Ошибка(Разбор, "ВЫБРАТЬ ВТ.Нет КАК П ИЗ ВТ КАК ВТ"), "Колонку «ВТ.Нет» не знайдено");
	Утв.Содержит(Ошибка(Разбор, "ВЫБРАТЬ Вл.Контрагент.ИНН КАК П ИЗ ВТ КАК ВТ"), "Розіменування колонок");

КонецПроцедуры

Процедура ТестПсевдонимы() Экспорт

	Утв.Содержит(Ошибка(Разбор(Таблица("Т", "Документ.Реализация"), Таблица("Т", "Справочник.Контрагенты")),
		"ВЫБРАТЬ Т.Ссылка ИЗ Документ.Реализация КАК Т"), "використано для різних джерел");
	Утв.Истинно(Проверить(Разбор(Таблица("Т", "Документ.Реализация"), Таблица("т", "Документ.Реализация")),
		"ВЫБРАТЬ Т.Ссылка ИЗ Документ.Реализация КАК Т").Успех, "один псевдоним одной таблицы в разных запросах");
	Утв.Содержит(Ошибка(Разбор(Таблица("Документ", "Документ.Реализация")),
		"ВЫБРАТЬ Документ.Ссылка ИЗ Документ.Реализация КАК Документ"), "збігається з класом таблиць");

КонецПроцедуры

Процедура ТестВиртуальнаяТаблица() Экспорт

	Р = Разбор(Таблица("О", "РегистрНакопления.ТоварыНаСкладах.Остатки"));
	Утв.Истинно(Проверить(Р, "ВЫБРАТЬ О.Склад КАК Склад, О.КоличествоОстаток КАК Остаток
		|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, Склад = &Склад) КАК О").Успех);
	Р.Колонки.Добавить("ПарольСклада");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ О.Склад КАК ПарольСклада
		|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, ПарольСклада = &П) КАК О"), "не знайдено або недоступне",
		"поле в условии виртуальной таблицы проверяется, даже если так называется колонка");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ О.Склад КАК Склад
		|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, Склад.Нет = &П) КАК О"), "не знайдено");

КонецПроцедуры

Процедура ТестЗапрещенныеКонструкции() Экспорт

	Р = Разбор(Таблица("К", "Справочник.Контрагенты"));
	Из = " ИЗ Справочник.Контрагенты КАК К";
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ К.Ссылка КАК С" + Из + " ИТОГИ ПО ОБЩИЕ"), "ИТОГИ не підтримуються");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ К.Ссылка КАК С" + Из + " ДЛЯ ИЗМЕНЕНИЯ"), "ДЛЯ ИЗМЕНЕНИЯ не дозволено");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ ПРЕДСТАВЛЕНИЕ(К.Ссылка) КАК П" + Из), "Функція ПРЕДСТАВЛЕНИЕ не підтримується");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ Представлениессылки(К.ГоловнойКонтрагент) КАК П" + Из), "ПРЕДСТАВЛЕНИЕССЫЛКИ");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ ВЫРАЗИТЬ(К.ГоловнойКонтрагент КАК Справочник.Контрагенты).ПарольКабинета КАК П" + Из),
		"Розіменування результату виразу");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ К.Ссылка КАК С" + Из + " ГДЕ &П.Наименование = """""), "Розіменування результату");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ К.Товары.(Количество) КАК Т" + Из), "Вибірка табличної частини");
	Утв.Содержит(Ошибка(Р, "ВЫБРАТЬ К.* " + Из), "«*» не підтримується");

КонецПроцедуры

Процедура ТестОшибкаИсходногоТекста() Экспорт

	Утв.Содержит(mcp1c_ПроверкаЗапросов.ОшибкаИсходногоТекста("ВЫБРАТЬ * ИЗ Справочник.Склады"), "«*»");
	Утв.Содержит(mcp1c_ПроверкаЗапросов.ОшибкаИсходногоТекста("SELECT TOP 5 * FROM Catalog.Склады"), "«*»");
	Утв.Содержит(mcp1c_ПроверкаЗапросов.ОшибкаИсходногоТекста("ВЫБРАТЬ С.Ссылка, С.* ИЗ Справочник.Склады КАК С"), "«*»");
	Утв.Равно(mcp1c_ПроверкаЗапросов.ОшибкаИсходногоТекста("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К, С.А * 2 КАК Б, 3 * 4 КАК В "
		+ "ИЗ Справочник.Склады КАК С"), "", "КОЛИЧЕСТВО(*) и умножение");
	Утв.Содержит(mcp1c_ПроверкаЗапросов.ОшибкаИсходногоТекста("ВЫБРАТЬ ""а"), "незакритий");

КонецПроцедуры

Процедура ТестТаблицыЗапросаОтчета() Экспорт

	Текст = "ВЫБРАТЬ
	|	Продажи.Номенклатура КАК Номенклатура,
	|	Продажи.СуммаОборот КАК Сумма
	|{ВЫБРАТЬ
	|	Номенклатура.*}
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&Начало, &Конец, , ) КАК Продажи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Н
	|		ПО Продажи.Номенклатура = Н.Ссылка
	|{ГДЕ
	|	Продажи.Номенклатура.* КАК Номенклатура}
	|ГДЕ
	|	Продажи.Номенклатура ССЫЛКА Справочник.Товары
	|	И Н.Ссылка <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И ВЫРАЗИТЬ(Продажи.Регистратор КАК Документ.Возврат).Номер <> """"
	|	И Продажи.Регистратор В (ВЫБРАТЬ Д.Ссылка ИЗ Документ.Реализация КАК Д)";
	Разбор = mcp1c_ПроверкаЗапросов.ТаблицыЗапроса(Текст);
	Утв.Равно(Разбор.Ошибка, "");
	Утв.МассивРавен(Разбор.Таблицы, "РегистрНакопления.Продажи.Обороты,Справочник.Номенклатура,Документ.Реализация",
		"типы после ССЫЛКА и КАК, значения в ЗНАЧЕНИЕ() - не таблицы");
	Утв.МассивРавен(Разбор.ВозможныеТаблицы, "");
	Утв.Истинно(Разбор.Имена.Найти("СуммаОборот") <> Неопределено);
	Утв.Истинно(Разбор.Имена.Найти("Регистратор") <> Неопределено);

	Разбор = mcp1c_ПроверкаЗапросов.ТаблицыЗапроса("ВЫБРАТЬ Документ.Номер ИЗ Документ.Реализация КАК Документ");
	Утв.МассивРавен(Разбор.ВозможныеТаблицы, "Документ.Номер,Документ.Реализация", "псевдоним с именем класса");
	Утв.МассивРавен(Разбор.Таблицы, "");

	Утв.Содержит(mcp1c_ПроверкаЗапросов.ТаблицыЗапроса("ВЫБРАТЬ К.Х ИЗ Константы КАК К").Ошибка, "Константы");
	Утв.МассивРавен(mcp1c_ПроверкаЗапросов.ИменаВыражения("Сумма / Количество + Контрагент.ПарольКабинета"),
		"Сумма,Количество,Контрагент,ПарольКабинета");

КонецПроцедуры

Процедура ТестЗначенияПараметров() Экспорт

	Ссылка = "4e0c1d2a-0000-4000-8000-000000000001";
	Типы = Новый Соответствие;
	Типы.Вставить("Дата", СтрРазделить("Дата", ","));
	Типы.Вставить("Список", СтрРазделить("Справочник.Контрагенты", ","));
	Типы.Вставить("Флаг", Новый Массив);
	Типы.Вставить("Начало", Новый Массив);
	Аргумент = mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(СтрЗаменить("{'дата': '2026-01-31', 'Список': [{'type': "
		+ "'Catalog.Контрагенты', 'ref': '" + Ссылка + "'}], 'Флаг': true, 'Начало': '2026-01-01'}", "'", """"));
	Результат = mcp1c_ПроверкаЗапросов.ЗначенияПараметров(Аргумент, Типы);
	Утв.Равно(Результат.Ошибка, "");
	Утв.Равно(Результат.Значения.Получить("Дата").Значение, Дата(2026, 1, 31), "имя параметра без учета регистра");
	Список = Результат.Значения.Получить("Список");
	Утв.Равно(Список.Вид, "list");
	Утв.Равно(Список.Элементы[0].Тип, "Справочник.Контрагенты", "класс по-английски");
	Утв.Равно(Список.Элементы[0].Идентификатор, Ссылка);
	Утв.Равно(Результат.Значения.Получить("Флаг").Значение, Истина, "тип не выведен - по значению JSON");
	Утв.Равно(Результат.Значения.Получить("Начало").Значение, Дата(2026, 1, 1), "строка в формате даты");

	Аргумент.Удалить("Флаг");
	Утв.Содержит(mcp1c_ПроверкаЗапросов.ЗначенияПараметров(Аргумент, Типы).Ошибка, "Не задано значення параметра &Флаг");
	Аргумент.Вставить("Флаг", Ложь);
	Аргумент.Вставить("Лишний", 1);
	Утв.Содержит(mcp1c_ПроверкаЗапросов.ЗначенияПараметров(Аргумент, Типы).Ошибка, "Параметра &Лишний немає");
	Аргумент.Удалить("Лишний");
	Аргумент.Вставить("дата", 5);
	Утв.Содержит(mcp1c_ПроверкаЗапросов.ЗначенияПараметров(Аргумент, Типы).Ошибка, "parameters.дата");
	Утв.Равно(mcp1c_ПроверкаЗапросов.ЗначенияПараметров(Неопределено, Новый Соответствие).Ошибка, "", "без параметров");

КонецПроцедуры

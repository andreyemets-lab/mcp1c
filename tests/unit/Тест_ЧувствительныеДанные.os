// Тесты mcp1c_ЧувствительныеДанные: слова имени, категории полей, состояние поля в профиле,
// предупреждения анализа рисков и текст отчета.
#Использовать "../../build/oslib"

Функция Код(ПолноеИмя, Поле, Синоним = "")

	Возврат mcp1c_ЧувствительныеДанные.КатегорияПоля(ПолноеИмя, Поле, Синоним);

КонецФункции

Функция Политика()

	Политика = mcp1c_ПравилаДоступа.НоваяПолитика();
	Политика.ЗапрещенныеПоля = СтрРазделить("*Пароль*,*Token*", ",");
	Политика.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("*"));
	Возврат Политика;

КонецФункции

Функция Кандидат(Объект, Поле, Состояние)

	Кандидат = mcp1c_ЧувствительныеДанные.НовыйКандидат(Объект, Поле, "",
		mcp1c_ЧувствительныеДанные.КатегорияПоля(Объект, Поле));
	Кандидат.Состояние = Состояние;
	Возврат Кандидат;

КонецФункции

Функция ТекстыПредупреждений(Предупреждения, Уровень)

	Тексты = Новый Массив;
	Для Каждого Предупреждение Из Предупреждения Цикл
		Если Предупреждение.Уровень = Уровень Тогда
			Тексты.Добавить(Предупреждение.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

Процедура ТестСловаИмени() Экспорт

	Утв.МассивРавен(mcp1c_ЧувствительныеДанные.СловаИмени("ИННФизЛица"), "инн,физ,лица", "серия прописных - одно слово");
	Утв.МассивРавен(mcp1c_ЧувствительныеДанные.СловаИмени("АдресЭП"), "адрес,эп");
	Утв.МассивРавен(mcp1c_ЧувствительныеДанные.СловаИмени("EMail"), "e,mail");
	Утв.МассивРавен(mcp1c_ЧувствительныеДанные.СловаИмени("Номер телефону"), "номер,телефону", "синоним с пробелом");
	Утв.МассивРавен(mcp1c_ЧувствительныеДанные.СловаИмени("Поле2Значение"), "поле2,значение", "цифры продолжают слово");
	Утв.МассивРавен(mcp1c_ЧувствительныеДанные.СловаИмени("_ID_клиента"), "id,клиента", "подчеркивание - разделитель");
	Утв.Равно(mcp1c_ЧувствительныеДанные.СловаИмени("").Количество(), 0);

КонецПроцедуры

Процедура ТестКатегорииПоИмени() Экспорт

	Утв.Равно(Код("Справочник.ФизическиеЛица", "ИНН"), "tax_id");
	Утв.Равно(Код("Справочник.ФизическиеЛица", "КодПоДРФО"), "tax_id");
	Утв.Равно(Код("Справочник.ФизическиеЛица", "ДатаРождения"), "birth");
	Утв.Равно(Код("Справочник.Контрагенты", "АдресЭП"), "email", "АдресЭП - почта, а не адрес");
	Утв.Равно(Код("Справочник.Партнеры", "EMail"), "email");
	Утв.Равно(Код("Справочник.Контрагенты", "Телефон"), "phone");
	Утв.Равно(Код("Справочник.БанковскиеСчета", "НомерСчета"), "account");
	Утв.Равно(Код("Справочник.Сотрудники", "Оклад"), "salary");
	Утв.Равно(Код("Справочник.Контрагенты", "ЮридическийАдрес"), "address");
	Утв.Равно(Код("Справочник.ФизическиеЛица", "ПаспортныеДанные"), "passport");

	Утв.Равно(Код("Справочник.Склады", "АдресХранения"), "", "адресное хранение - не адрес человека");
	Утв.Равно(Код("Справочник.Обработки", "АдресВременногоХранилища"), "");
	Утв.Равно(Код("Документ.Поступление", "НомерСчетаФактуры"), "", "номер счета-фактуры - не банковский счет");
	Утв.Равно(Код("Документ.Оплата", "НомерСчетаНаОплату"), "");
	Утв.Равно(Код("Справочник.Контрагенты", "КодПоЕДРПОУ"), "", "код юрлица не ИНН физлица");
	Утв.Равно(Код("Справочник.Номенклатура", "Наименование"), "");
	Утв.Равно(Код("Справочник.ФизическиеЛица", "Ссылка"), "", "служебное поле");

КонецПроцедуры

Процедура ТестКатегорииПоСинонимуИТаблице() Экспорт

	Утв.Равно(Код("Справочник.Анкеты", "Реквизит1", "ІПН"), "tax_id", "синоним");
	Утв.Равно(Код("Справочник.Анкеты", "Реквизит2", "Номер телефону"), "phone");
	Утв.Равно(Код("Справочник.Анкеты", "Реквизит3", "Адреса електронної пошти"), "email", "e-mail раньше адреса");
	Утв.Равно(Код("Справочник.Анкеты", "Реквизит4", "Адреса реєстрації"), "address");

	Утв.Равно(Код("Справочник.Контрагенты", "КонтактнаяИнформация.Представление"), "contacts", "контактная информация");
	Утв.Равно(Код("Справочник.Контрагенты", "КонтактнаяИнформация.Вид"), "", "вид контактной информации");
	Утв.Равно(Код("РегистрСведений.КонтактнаяИнформация", "Поле1"), "contacts", "регистр контактной информации");
	Утв.Равно(Код("РегистрСведений.ДокументыФизическихЛиц", "Номер"), "passport", "документы физлиц");
	Утв.Равно(Код("РегистрСведений.ДокументыФизическихЛиц", "Период"), "");
	Утв.Равно(Код("Документ.Реализация", "Номер"), "", "номер документа - не документ личности");

	Категория = mcp1c_ЧувствительныеДанные.ОписаниеКатегории("account");
	Утв.Равно(Категория.ВидМаски, "partial");
	Утв.Равно(Категория.ПараметрМаски, 4);
	Утв.Равно(mcp1c_ЧувствительныеДанные.ОписаниеКатегории("unknown").ВидМаски, "full", "неизвестная категория - полная маска");
	Утв.Равно(mcp1c_ЧувствительныеДанные.Категории().Количество() + 1, mcp1c_ЧувствительныеДанные.КодыКатегорий().Количество(),
		"контактная информация - не по имени поля");
	Утв.Равно(mcp1c_ЧувствительныеДанные.ПредставлениеМаски("round", 1000), "округлення до 1000");
	Утв.Равно(mcp1c_ЧувствительныеДанные.ПредставлениеМаски("partial", 0), "часткова (видно 4 симв.)");

КонецПроцедуры

Функция КодПоТипу(ПолноеИмя, Поле, Типы, Синоним = "")

	Возврат mcp1c_ЧувствительныеДанные.КатегорияПоля(ПолноеИмя, Поле, Синоним, Неопределено, СтрРазделить(Типы, ","));

КонецФункции

Процедура ТестКатегорииПоТипуЗначения() Экспорт

	Утв.Равно(КодПоТипу("Справочник.ШтатноеРасписание", "ОкладТариф", "Число"), "salary");
	Утв.Равно(КодПоТипу("Справочник.ВидыДоходов", "УдержатьНДФЛИзЗарплаты", "Булево"), "", "флаг - не оплата труда");
	Утв.Равно(КодПоТипу("РегистрСведений.НастройкиТранспорта", "EMAILСжиматьФайлИсходящегоСообщения", "Булево"), "",
		"настройка с префиксом EMAIL - не адрес почты");
	Утв.Равно(КодПоТипу("РегистрСведений.НастройкиТранспорта", "EMAILУчетнаяЗапись",
		"Справочник.УчетныеЗаписиЭлектроннойПочты"), "", "ссылка на учетную запись - не адрес");
	Утв.Равно(КодПоТипу("Справочник.УчетныеЗаписи", "АдресЭлектроннойПочты", "Строка"), "email");
	Утв.Равно(КодПоТипу("Справочник.ДоговорыКонтрагентов", "БанковскийСчет", "Справочник.БанковскиеСчета"), "",
		"ссылка на счет - не номер счета");
	Утв.Равно(КодПоТипу("Справочник.БанковскиеСчета", "НомерСчета", "Строка"), "account");
	Утв.Равно(КодПоТипу("Справочник.ВидыКонтактнойИнформации", "СкрыватьНеактуальныеАдреса", "Булево"), "");
	Утв.Равно(КодПоТипу("Справочник.ФизическиеЛица", "МестоРождения", "Строка"), "birth", "место рождения - строка");
	Утв.Равно(КодПоТипу("Справочник.ФизическиеЛица", "ДатаРождения", "Дата"), "birth");
	Утв.Равно(КодПоТипу("РегистрСведений.ДокументыФизическихЛиц", "ДатаВыдачи", "Дата"), "passport");
	Утв.Равно(КодПоТипу("РегистрСведений.ДокументыФизическихЛиц", "Номер", "Число"), "", "документ личности - строка");
	Утв.Равно(КодПоТипу("Справочник.Контрагенты", "КонтактнаяИнформация.Страна", "Справочник.СтраныМира"), "",
		"ссылка в контактной информации");
	Утв.Равно(КодПоТипу("Справочник.Анкеты", "Реквизит1", "Строка,Число", "ІПН"), "tax_id", "составной тип");

КонецПроцедуры

Процедура ТестКатегорииНачалоСлова() Экспорт

	Утв.Равно(Код("Справочник.ГруппыСотрудников", "ПодробноеОписание", "Докладний опис"), "",
		"оклад - начало слова, а не часть слова «докладний»");
	Утв.Равно(Код("Справочник.ШтатноеРасписание", "ОкладТарифМакс"), "salary");
	Утв.Равно(Код("Справочник.Анкеты", "Реквизит5", "Посадові оклади"), "salary", "форма слова");
	Утв.Равно(Код("Справочник.ВерсииМобильныхПриложений", "МобильноеПриложение", "Мобільна прикладна програма"), "",
		"мобильное приложение - не телефон");
	Утв.Равно(Код("Справочник.Организации", "ФайлФаксимильнаяПечать"), "", "факсимиле - не факс");
	Утв.Равно(Код("Справочник.Контрагенты", "Факс"), "phone");
	Утв.Равно(Код("Документ.АктОРасхождениях", "ДокументУдостоверяющийПолномочияЧленаКомиссии1"), "",
		"документ о полномочиях - не документ личности");

КонецПроцедуры

Процедура ТестСостояниеВПрофиле() Экспорт

	П = Политика();
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.ФизическиеЛица", "ИНН", "mask", "hash"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.ФизическиеЛица", "ДатаРождения", "deny"));

	Видимое = Кандидат("Справочник.ФизическиеЛица", "Телефон", "");
	mcp1c_ЧувствительныеДанные.ЗаполнитьСостояние(П, Видимое);
	Утв.Равно(Видимое.Состояние, "visible");

	Маска = Кандидат("Справочник.ФизическиеЛица", "ИНН", "");
	mcp1c_ЧувствительныеДанные.ЗаполнитьСостояние(П, Маска);
	Утв.Равно(Маска.Состояние, "masked");
	Утв.Равно(Маска.Маска, "hash");

	Запрет = Кандидат("Справочник.ФизическиеЛица", "ДатаРождения", "");
	mcp1c_ЧувствительныеДанные.ЗаполнитьСостояние(П, Запрет);
	Утв.Равно(Запрет.Состояние, "hidden");

	Типы = Новый Массив;
	Типы.Добавить("ХранилищеЗначения");
	ПоТипу = Кандидат("Справочник.ФизическиеЛица", "ПаспортныеДанные", "");
	mcp1c_ЧувствительныеДанные.ЗаполнитьСостояние(П, ПоТипу, Типы);
	Утв.Равно(ПоТипу.Состояние, "hidden", "глобальный запрет по типу");

КонецПроцедуры

Процедура ТестПредупрежденияПрофиля() Экспорт

	П = Политика();
	П.ЗапрещенныеПоля.Очистить();
	Агрегаты = mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("РегистрНакопления.Зарплата", "aggregates");
	Агрегаты.МинимальныйРазмерГруппы = 1;
	П.Объекты.Добавить(Агрегаты);
	П.Лимиты.СтрокЗаВызов = 500;
	П.Лимиты.ГлубинаПериодаДней = 400;
	П.ПараметрыПрофиля.Вставить("организации", mcp1c_ПравилаДоступа.НовыйПараметрПрофиля("Организации"));
	СПараметром = mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.Реализация", "Организация", "invalid",
		Неопределено, "", "Организации");
	СПараметром.Ошибка = "Для клієнта не задано значень параметра Организации";
	П.ОграниченияСтрок.Добавить(СПараметром);
	Ошибочное = mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.Поступление", "Склад", "invalid", Неопределено);
	Ошибочное.Ошибка = "Значення обмеження за полем Склад - некоректний JSON";
	П.ОграниченияСтрок.Добавить(Ошибочное);

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Кандидат("Справочник.ФизическиеЛица", "ИНН", "visible"));
	Кандидаты.Добавить(Кандидат("Справочник.ФизическиеЛица", "Телефон", "visible"));
	Кандидаты.Добавить(Кандидат("Справочник.ФизическиеЛица", "ДатаРождения", "masked"));
	Внешние = Новый Массив;
	Внешние.Добавить("Claude Desktop");
	БезПериода = СтрРазделить("Документ.Реализация,РегистрНакопления.Продажи", ",");

	Предупреждения = mcp1c_ЧувствительныеДанные.ПредупрежденияПрофиля(П, Кандидаты, БезПериода, Внешние);
	Высокие = ТекстыПредупреждений(Предупреждения, "high");
	Средние = ТекстыПредупреждений(Предупреждения, "medium");
	Справочные = ТекстыПредупреждений(Предупреждения, "info");
	Утв.Содержит(Высокие, "Глобальні заборони полів порожні");
	Утв.Содержит(Высокие, "2 чутливих полів видно без маски");
	Утв.Содержит(Высокие, "Справочник.ФизическиеЛица.ИНН");
	Утв.Содержит(Высокие, "зовнішнім AI-провайдером (Claude Desktop)");
	Утв.Содержит(Средние, "Правило «*»");
	Утв.Содержит(Средние, "Мінімальний розмір групи 1");
	Утв.Содержит(Средние, "2 документів і регістрів");
	Утв.Содержит(Средние, "Документ.Поступление", "ошибка ограничения без параметра");
	Утв.НеСодержит(Средние, "Документ.Реализация» за полем", "параметр без значения - не ошибка профиля");
	Утв.Содержит(Средние, "Ліміт «рядків за виклик» = 500 (типово 50)", "в 10 раз больше - средний");
	Утв.Содержит(Справочные, "Ліміт «днів періоду» = 400 (типово 366)");

	Текст = mcp1c_ЧувствительныеДанные.ТекстОтчета("Аналіз ризиків профілю «Тест»", Предупреждения, Кандидаты);
	Утв.Содержит(Текст, "Аналіз ризиків профілю «Тест»");
	Утв.Содержит(Текст, "[ВИСОКИЙ]");
	Утв.Содержит(Текст, "Кандидати в чутливі поля (3, без маски - 2)");
	Утв.Содержит(Текст, "Справочник.ФизическиеЛица.ИНН - ВИДНО БЕЗ МАСКИ");
	Утв.Содержит(Текст, "масковано: повна");
	Утв.Истинно(СтрНайти(Текст, "[ВИСОКИЙ]") < СтрНайти(Текст, "[СЕРЕДНІЙ]"), "сначала высокий уровень");

КонецПроцедуры

Процедура ТестБезРисков() Экспорт

	П = mcp1c_ПравилаДоступа.НоваяПолитика();
	П.ЗапрещенныеПоля.Добавить("*Пароль*");
	Предупреждения = mcp1c_ЧувствительныеДанные.ПредупрежденияПрофиля(П, Новый Массив, Новый Массив, Новый Массив);
	Утв.Равно(Предупреждения.Количество(), 1, "только «профиль ничего не открывает»");
	Утв.Равно(Предупреждения[0].Уровень, "info");
	Утв.Содержит(mcp1c_ЧувствительныеДанные.ТекстОтчета("Звіт", Новый Массив, Новый Массив),
		"Кандидатів у чутливі поля не знайдено");

КонецПроцедуры

// Тесты mcp1c_ЗапросыДанных: построение запросов инструментов чтения по аргументам и политике.
#Использовать "../../build/oslib"

#Область Описания

Функция ОписаниеРеализации()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Документ.РеализацияТоваровУслуг", "Документ.РеализацияТоваровУслуг", "document");
	Т.ЕстьПометкаУдаления = Истина;
	Т.ЕстьПроведен = Истина;
	Т.ПолеПериода = "Дата";
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Документ.РеализацияТоваровУслуг", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ПометкаУдаления", "Булево", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Номер", "Строка", "standard", 11);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Дата", "Дата", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Проведен", "Булево", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Контрагент", "Справочник.Контрагенты");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Организация", "Справочник.Организации");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Комментарий", "Строка", , 0);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "СуммаДокумента", "Число");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ВидОперации", "Перечисление.ВидыОпераций");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Основание", "Документ.ЗаказПокупателя, Справочник.Договоры, Строка", , 50);
	Т.КлючевыеПоля = СтрРазделить("Ссылка,Дата,Номер,Проведен", ",");
	Т.ПоляПорядка = СтрРазделить("Дата,Ссылка", ",");
	Т.ПоляПредставления = СтрРазделить("Номер,Дата", ",");
	Т.ПоляПоиска = СтрРазделить("Номер", ",");
	Возврат Т;

КонецФункции

Функция ОписаниеТоваров()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Документ.РеализацияТоваровУслуг.Товары", "Документ.РеализацияТоваровУслуг",
		"document", "tabular_section");
	Т.ПрефиксПолейПолитики = "Товары.";
	Т.ЕстьПометкаУдаления = Истина;
	Т.ЕстьПроведен = Истина;
	Т.ПолеПериода = "Ссылка.Дата";
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Документ.РеализацияТоваровУслуг", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "НомерСтроки", "Число", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Номенклатура", "Справочник.Номенклатура");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Цена", "Число");
	Т.КлючевыеПоля = СтрРазделить("Ссылка,НомерСтроки", ",");
	Т.ПоляПорядка = СтрРазделить("Ссылка,НомерСтроки", ",");
	Возврат Т;

КонецФункции

Функция ОписаниеКонтрагентов()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("Справочник.Контрагенты", "Справочник.Контрагенты", "catalog");
	Т.ЕстьПометкаУдаления = Истина;
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Ссылка", "Справочник.Контрагенты", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ПометкаУдаления", "Булево", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Код", "Строка", "standard", 9);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Наименование", "Строка", "standard", 100);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ИНН", "Строка", , 12);
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ГоловнойКонтрагент", "Справочник.Контрагенты");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "ПарольКабинета", "Строка", , 50);
	Т.КлючевыеПоля = СтрРазделить("Ссылка,Код,Наименование", ",");
	Т.ПоляПорядка = СтрРазделить("Ссылка", ",");
	Т.ПоляПредставления = СтрРазделить("Код,Наименование", ",");
	Т.ПоляПоиска = СтрРазделить("Наименование,Код,ИНН", ",");
	Возврат Т;

КонецФункции

Функция ОписаниеОстатков()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("РегистрНакопления.ТоварыНаСкладах.Остатки",
		"РегистрНакопления.ТоварыНаСкладах", "accumulation_register", "virtual");
	Т.ВиртуальнаяТаблица = "Остатки";
	Т.ВидРегистра = "balance";
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Склад", "Справочник.Склады", "dimension");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Номенклатура", "Справочник.Номенклатура", "dimension");
	Поле = mcp1c_ПутиПолей.ДобавитьПоле(Т, "КоличествоОстаток", "Число", "resource", 0, "Количество");
	Поле.Показатель = "Остаток";
	Поле = mcp1c_ПутиПолей.ДобавитьПоле(Т, "СуммаОстаток", "Число", "resource", 0, "Сумма");
	Поле.Показатель = "Остаток";
	Возврат Т;

КонецФункции

Функция ОписаниеОборотовБухгалтерии()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("РегистрБухгалтерии.Хозрасчетный.Обороты",
		"РегистрБухгалтерии.Хозрасчетный", "accounting_register", "virtual");
	Т.ВиртуальнаяТаблица = "Обороты";
	Т.ПланСчетов = "ПланСчетов.Хозрасчетный";
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Период", "Дата", "period");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Счет", "ПланСчетов.Хозрасчетный", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Субконто1", "Справочник.Контрагенты, Справочник.Номенклатура", "dimension");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "КорСчет", "ПланСчетов.Хозрасчетный", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Организация", "Справочник.Организации", "dimension");
	Поле = mcp1c_ПутиПолей.ДобавитьПоле(Т, "СуммаОборотДт", "Число", "resource", 0, "Сумма");
	Поле.Показатель = "ОборотДт";
	Поле = mcp1c_ПутиПолей.ДобавитьПоле(Т, "СуммаОборотКт", "Число", "resource", 0, "Сумма");
	Поле.Показатель = "ОборотКт";
	Возврат Т;

КонецФункции

Функция ОписаниеСреза()

	Т = mcp1c_ПутиПолей.НовоеОписаниеТаблицы("РегистрСведений.КурсыВалют.СрезПоследних", "РегистрСведений.КурсыВалют",
		"information_register", "virtual");
	Т.ВиртуальнаяТаблица = "СрезПоследних";
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Период", "Дата", "standard");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Валюта", "Справочник.Валюты", "dimension");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Курс", "Число", "resource");
	mcp1c_ПутиПолей.ДобавитьПоле(Т, "Кратность", "Число", "resource");
	Т.КлючевыеПоля = СтрРазделить("Период,Валюта", ",");
	Т.ПоляПорядка = СтрРазделить("Валюта", ",");
	Возврат Т;

КонецФункции

Функция Политика()

	П = mcp1c_ПравилаДоступа.НоваяПолитика();
	П.ЗапрещенныеПоля.Добавить("*Пароль*");
	П.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("*"));
	Возврат П;

КонецФункции

#КонецОбласти

#Область Помощники

// JSON с одинарными кавычками вместо двойных.
Функция J(Текст)

	Возврат mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(СтрЗаменить(Текст, "'", """"));

КонецФункции

Функция Текст(Строки)

	Возврат СтрЗаменить(СтрСоединить(Строки, Символы.ПС), "\t", Символы.Таб);

КонецФункции

// Строит запрос, подгружая описания по запросу построения, как mcp1c_ИнструментыДанных.
Функция Построить(Вид, Аргументы, Таблица, Политика, Лимит = 50, Смещение = 0)

	Описания = Новый Соответствие;
	Для Номер = 1 По 10 Цикл
		Если Вид = "records" Тогда
			П = mcp1c_ЗапросыДанных.ВыборкаЗаписей(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		ИначеЕсли Вид = "find" Тогда
			П = mcp1c_ЗапросыДанных.ПоискОбъектов(Аргументы, Таблица, Описания, Политика, Лимит);
		ИначеЕсли Вид = "card" Тогда
			П = mcp1c_ЗапросыДанных.КарточкаОбъекта(Таблица, Описания, Политика, Аргументы);
		ИначеЕсли Вид = "tabular" Тогда
			П = mcp1c_ЗапросыДанных.СтрокиТабличнойЧасти(Таблица, Описания, Политика, Аргументы, Лимит);
		ИначеЕсли Вид = "balances" Тогда
			П = mcp1c_ЗапросыДанных.Остатки(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		ИначеЕсли Вид = "turnovers" Тогда
			П = mcp1c_ЗапросыДанных.Обороты(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		Иначе
			П = mcp1c_ЗапросыДанных.Срез(Аргументы, Таблица, Описания, Политика, Лимит, Смещение);
		КонецЕсли;
		Если ПустаяСтрока(П.НужноОписание) Тогда
			Возврат П;
		КонецЕсли;
		Если П.НужноОписание = "Справочник.Контрагенты" Тогда
			Описания.Вставить(П.НужноОписание, ОписаниеКонтрагентов());
		ИначеЕсли П.НужноОписание = "Документ.РеализацияТоваровУслуг" Тогда
			Описания.Вставить(П.НужноОписание, ОписаниеРеализации());
		Иначе
			Описание = mcp1c_ПутиПолей.НовоеОписаниеТаблицы(П.НужноОписание, П.НужноОписание, "catalog");
			mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Ссылка", П.НужноОписание, "standard");
			mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Наименование", "Строка", "standard", 100);
			mcp1c_ПутиПолей.ДобавитьПоле(Описание, "Родитель", П.НужноОписание, "standard");
			Описания.Вставить(П.НужноОписание, Описание);
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Построение не завершилось";

КонецФункции

Функция ТекстЗапроса(П)

	Утв.Равно(П.Ошибка, "", "ошибка построения");
	Возврат mcp1c_КонструкторЗапросов.ТекстЗапроса(П.Спецификация);

КонецФункции

Функция ИменаКолонок(П)

	Имена = Новый Массив;
	Для Каждого Колонка Из П.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");

КонецФункции

Функция Ссылка(Тип, Номер)

	Возврат СтрШаблон("{'type':'%1','ref':'4e0c1d2a-0000-0000-0000-00000000000%2'}", Тип, Номер);

КонецФункции

#КонецОбласти

#Область Выборка

Процедура ТестПоляПоУмолчанию() Экспорт

	П = Построить("records", J("{'object':'Документ.РеализацияТоваровУслуг'}"), ОписаниеРеализации(), Политика());
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Ссылка КАК К1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Ссылка) КАК К1_П,");
	Ожидается.Добавить("\tТ.Дата КАК К2,");
	Ожидается.Добавить("\tТ.Номер КАК К3,");
	Ожидается.Добавить("\tТ.Проведен КАК К4,");
	Ожидается.Добавить("\tТ.Контрагент КАК К5,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Контрагент) КАК К5_П,");
	Ожидается.Добавить("\tТ.Организация КАК К6,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Организация) КАК К6_П,");
	Ожидается.Добавить("\tТ.Комментарий КАК К7,");
	Ожидается.Добавить("\tТ.СуммаДокумента КАК К8,");
	Ожидается.Добавить("\tТ.ВидОперации КАК К9,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.ВидОперации) КАК К9_П,");
	Ожидается.Добавить("\tТ.Основание КАК К10,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Основание) КАК К10_П");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tДокумент.РеализацияТоваровУслуг КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.ПометкаУдаления = &П1");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tТ.Дата,");
	Ожидается.Добавить("\tТ.Ссылка");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается));
	Утв.Равно(П.Параметры.Получить("П1").Значение, Ложь, "пометка удаления");
	Утв.Равно(ИменаКолонок(П), "Ссылка,Дата,Номер,Проведен,Контрагент,Организация,Комментарий,СуммаДокумента,"
		+ "ВидОперации,Основание");
	Утв.Равно(mcp1c_ЗапросыДанных.ОписаниеКолонок(П)[0].Получить("kind"), "ref");

КонецПроцедуры

Процедура ТестПоляОтборыИПорядок() Экспорт

	Аргументы = J("{'object':'Документ.РеализацияТоваровУслуг','fields':['Дата','контрагент.инн'],
	|'filters':[{'field':'Контрагент','op':'eq','value':" + Ссылка("Catalog.Контрагенты", 1) + "},
	|{'field':'СуммаДокумента','op':'gt','value':100},
	|{'field':'Комментарий','op':'contains','value':'50%'},
	|{'field':'Дата','op':'between','value':['2026-09-01','2026-09-30']},
	|{'field':'ВидОперации','op':'in','value':['Продажа',{'type':'Перечисление.ВидыОпераций','value':'Возврат'}]}],
	|'only_posted':true,'order_by':[{'field':'Дата','desc':true}]}");
	П = Построить("records", Аргументы, ОписаниеРеализации(), Политика(), 20, 40);

	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 61");
	Ожидается.Добавить("\tТ.Дата КАК К1,");
	Ожидается.Добавить("\tТ.Контрагент.ИНН КАК К2");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tДокумент.РеализацияТоваровУслуг КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.Контрагент = &П1");
	Ожидается.Добавить("\tИ Т.СуммаДокумента > &П2");
	Ожидается.Добавить("\tИ ВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(1024)) ПОДОБНО &П3 СПЕЦСИМВОЛ ""~""");
	Ожидается.Добавить("\tИ Т.Дата МЕЖДУ &П4 И &П5");
	Ожидается.Добавить("\tИ Т.ВидОперации В (&П6)");
	Ожидается.Добавить("\tИ Т.ПометкаУдаления = &П7");
	Ожидается.Добавить("\tИ Т.Проведен = &П8");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tТ.Дата УБЫВ,");
	Ожидается.Добавить("\tТ.Ссылка");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается));
	Утв.Равно(ИменаКолонок(П), "Дата,Контрагент.ИНН", "канонические пути");

	Ссылка_ = П.Параметры.Получить("П1");
	Утв.Равно(Ссылка_.Вид, "ref");
	Утв.Равно(Ссылка_.Тип, "Справочник.Контрагенты", "английский класс приведен к имени из метаданных");
	Утв.Равно(Ссылка_.Идентификатор, "4e0c1d2a-0000-0000-0000-000000000001");
	Утв.Равно(П.Параметры.Получить("П3").Значение, "%50~%%", "экранирование ПОДОБНО");
	Утв.Равно(П.Параметры.Получить("П4").Значение, Дата(2026, 9, 1, 0, 0, 0));
	Утв.Равно(П.Параметры.Получить("П5").Значение, Дата(2026, 9, 30, 23, 59, 59), "верхняя граница - конец дня");
	Список = П.Параметры.Получить("П6");
	Утв.Равно(Список.Вид, "list");
	Утв.Равно(Список.Элементы[0].Вид, "enum");
	Утв.Равно(Список.Элементы[0].Тип, "Перечисление.ВидыОпераций");
	Утв.Равно(Список.Элементы[0].Имя, "Продажа");
	Утв.Равно(Список.Элементы[1].Имя, "Возврат");
	Утв.Равно(П.Параметры.Получить("П8").Значение, Истина, "только проведенные");

КонецПроцедуры

Процедура ТестСкрытыеПоляНигдеНеИспользуются() Экспорт

	П_ = Политика();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "ИНН", "deny"));
	Таблица = ОписаниеРеализации();
	Скрытое = Построить("records", J("{'fields':['Контрагент.ИНН']}"), Таблица, П_);
	Отсутствующее = Построить("records", J("{'fields':['Контрагент.КПП']}"), Таблица, П_);
	Утв.Содержит(Скрытое.Ошибка, "не знайдено або недоступне");
	Утв.Равно(СтрЗаменить(Скрытое.Ошибка, "ИНН", "КПП"), Отсутствующее.Ошибка, "скрытое не отличается от отсутствующего");

	Для Каждого Аргументы Из СтрРазделить("{'filters':[{'field':'Контрагент.ИНН','op':'eq','value':'1'}]}|"
		+ "{'order_by':[{'field':'Контрагент.ИНН'}]}|{'group_by':['Контрагент.ИНН']}|"
		+ "{'aggregates':[{'field':'Контрагент.ИНН','func':'count_distinct'}]}|"
		+ "{'fields':['Контрагент.ПарольКабинета']}", "|") Цикл
		Результат = Построить("records", J(Аргументы), Таблица, П_);
		Утв.Содержит(Результат.Ошибка, "не знайдено або недоступне", Аргументы);
	КонецЦикла;

КонецПроцедуры

Процедура ТестИнъекцияВИменахПолей() Экспорт

	Для Каждого Имя Из СтрРазделить("Наименование ИЗ Справочник.Пользователи|Номер; ВЫБРАТЬ 1|Номер//|Т.Номер", "|") Цикл
		Аргументы = Новый Соответствие;
		Поля = Новый Массив;
		Поля.Добавить(Имя);
		Аргументы.Вставить("fields", Поля);
		Результат = Построить("records", Аргументы, ОписаниеРеализации(), Политика());
		Утв.НеРавно(Результат.Ошибка, "", Имя);
	КонецЦикла;

КонецПроцедуры

Процедура ТестГруппировкаИАгрегаты() Экспорт

	Аргументы = J("{'group_by':['Контрагент'],'aggregates':[{'field':'СуммаДокумента','func':'sum','as':'Сума'},
	|{'func':'count'}],'order_by':[{'field':'Сума','desc':true}]}");
	П = Построить("records", Аргументы, ОписаниеРеализации(), Политика());
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Контрагент КАК К1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Контрагент) КАК К1_П,");
	Ожидается.Добавить("\tСУММА(Т.СуммаДокумента) КАК К2,");
	Ожидается.Добавить("\tКОЛИЧЕСТВО(*) КАК К3");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tДокумент.РеализацияТоваровУслуг КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.ПометкаУдаления = &П1");
	Ожидается.Добавить("СГРУППИРОВАТЬ ПО");
	Ожидается.Добавить("\tТ.Контрагент");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tК2 УБЫВ,");
	Ожидается.Добавить("\tК1");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается));
	Утв.Равно(ИменаКолонок(П), "Контрагент,Сума,count(*)");
	Утв.Равно(П.Колонки[1].Вид, "number");

	Утв.Содержит(Построить("records", J("{'group_by':['Контрагент'],'aggregates':[{'field':'Контрагент','func':'sum'}]}"),
		ОписаниеРеализации(), Политика()).Ошибка, "лише для числових");
	Утв.Содержит(Построить("records", J("{'fields':['Дата'],'group_by':['Контрагент']}"),
		ОписаниеРеализации(), Политика()).Ошибка, "fields не поєднується");
	Утв.Содержит(Построить("records", J("{'group_by':['Контрагент'],'order_by':[{'field':'Дата'}]}"),
		ОписаниеРеализации(), Политика()).Ошибка, "лише за полями group_by");
	Утв.Содержит(Построить("records", J("{'group_by':['Контрагент'],'aggregates':[{'field':'СуммаДокумента',"
		+ "'func':'sum','as':'Контрагент'}]}"), ОписаниеРеализации(), Политика()).Ошибка, "уже є в результаті");

КонецПроцедуры

#КонецОбласти

#Область ОграниченияИПериод

Функция ПолитикаСОграничениями()

	П = Политика();
	П.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.РеализацияТоваровУслуг",
		"Организация", "eq", J(Ссылка("Справочник.Организации", 1))));
	П.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.РеализацияТоваровУслуг",
		"организация", "eq", J(Ссылка("Справочник.Организации", 2))));
	П.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.РеализацияТоваровУслуг",
		"Контрагент", "ne", J("[" + Ссылка("Справочник.Контрагенты", 3) + "," + Ссылка("Справочник.Контрагенты", 4) + "]")));
	Возврат П;

КонецФункции

Процедура ТестОграниченияСтрок() Экспорт

	П = Построить("records", J("{'fields':['Номер']}"), ОписаниеРеализации(), ПолитикаСОграничениями());
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Номер КАК К1");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tДокумент.РеализацияТоваровУслуг КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.ПометкаУдаления = &П1");
	Ожидается.Добавить("\tИ (Т.Организация = &П2 ИЛИ Т.Организация = &П3)");
	Ожидается.Добавить("\tИ НЕ Т.Контрагент В (&П4)");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tТ.Дата,");
	Ожидается.Добавить("\tТ.Ссылка");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается));
	Утв.Равно(П.Параметры.Получить("П4").Элементы.Количество(), 2);

	// Табличная часть: ограничения владельца через Ссылка, даже если поле владельца скрыто от клиента.
	П_ = ПолитикаСОграничениями();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.РеализацияТоваровУслуг", "Организация", "deny"));
	Текст_ = ТекстЗапроса(Построить("records", J("{'fields':['Номенклатура']}"), ОписаниеТоваров(), П_));
	Утв.Содержит(Текст_, "Т.Ссылка.ПометкаУдаления = &П1");
	Утв.Содержит(Текст_, "(Т.Ссылка.Организация = &П2 ИЛИ Т.Ссылка.Организация = &П3)");
	Утв.Содержит(Текст_, "НЕ Т.Ссылка.Контрагент В (&П4)");
	Утв.Содержит(Текст_, "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб + "Т.Ссылка," + Символы.ПС + Символы.Таб + "Т.НомерСтроки");

КонецПроцедуры

Процедура ТестНекорректноеОграничениеЗакрываетДоступ() Экспорт

	Для Каждого Вариант Из СтрРазделить("НетТакогоПоля|eq;Организация|invalid;Организация|eq_контрагент", ";") Цикл
		Части = СтрРазделить(Вариант, "|");
		П_ = Политика();
		Значение = J(Ссылка(?(Части[1] = "eq_контрагент", "Справочник.Контрагенты", "Справочник.Организации"), 1));
		П_.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.РеализацияТоваровУслуг",
			Части[0], ?(Части[1] = "invalid", "invalid", "eq"), Значение));
		Результат = Построить("records", J("{'fields':['Номер']}"), ОписаниеРеализации(), П_);
		Утв.Содержит(Результат.Ошибка, "Обмеження рядків профілю", Вариант);
		Утв.НеРавно(Результат.Причина, "", "причина для журнала: " + Вариант);
	КонецЦикла;

КонецПроцедуры

Процедура ТестОбязательныйПериод() Экспорт

	П_ = Политика();
	П_.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Документ.РеализацияТоваровУслуг", "read", Ложь, Истина));
	Таблица = ОписаниеРеализации();

	Утв.Содержит(Построить("records", J("{'fields':['Номер']}"), Таблица, П_).Ошибка, "вимагає фільтр за періодом");
	Утв.Содержит(Построить("records", J("{'period':{'from':'2026-09-01'}}"), Таблица, П_).Ошибка, "задайте from і to");
	Утв.Содержит(Построить("records", J("{'period':{'from':'2025-01-01','to':'2026-09-30'}}"), Таблица, П_).Ошибка,
		"Період довший за 366");
	Утв.Содержит(Построить("records", J("{'period':{'from':'2026-10-01','to':'2026-09-30'}}"), Таблица, П_).Ошибка,
		"from пізніше за to");
	Утв.Содержит(Построить("records", J("{'period':{'from':'2026-09-01T00:00:00Z','to':'2026-09-30'}}"), Таблица, П_).Ошибка,
		"без часового поясу");

	П = Построить("records", J("{'fields':['Номер'],'period':{'from':'2026-09-01','to':'2026-09-30T18:00'}}"), Таблица, П_);
	Утв.Содержит(ТекстЗапроса(П), "Т.Дата МЕЖДУ &П1 И &П2");
	Утв.Равно(П.Параметры.Получить("П2").Значение, Дата(2026, 9, 30, 18, 0, 0), "время указано - без сдвига к концу дня");

	// Без обязательного отбора одна граница допустима.
	П = Построить("records", J("{'fields':['Номер'],'period':{'to':'2026-09-30'}}"), Таблица, Политика());
	Утв.Содержит(ТекстЗапроса(П), "Т.Дата <= &П1");
	Утв.Равно(П.Параметры.Получить("П1").Значение, Дата(2026, 9, 30, 23, 59, 59));

КонецПроцедуры

Процедура ТестПомеченныеНаУдаление() Экспорт

	П = Построить("records", J("{'fields':['Номер'],'include_deleted':true}"), ОписаниеРеализации(), Политика());
	Утв.Содержит(ТекстЗапроса(П), "Т.ПометкаУдаления = &П1", "профиль не разрешает");
	Утв.Содержит(СтрСоединить(П.Примечания, ";"), "Помічені на вилучення не показуються");

	П_ = Политика();
	П_.РазрешитьПомеченныеНаУдаление = Истина;
	П = Построить("records", J("{'fields':['Номер'],'include_deleted':true}"), ОписаниеРеализации(), П_);
	Утв.НеСодержит(ТекстЗапроса(П), "ПометкаУдаления");

КонецПроцедуры

#КонецОбласти

#Область Регистры

Процедура ТестОстатки() Экспорт

	Аргументы = J("{'register':'РегистрНакопления.ТоварыНаСкладах','date':'2026-10-19',
	|'filters':[{'field':'Склад','op':'eq','value':" + Ссылка("Справочник.Склады", 5) + "},
	|{'field':'КоличествоОстаток','op':'gt','value':0}],'resources':['количество']}");
	П = Построить("balances", Аргументы, ОписаниеОстатков(), Политика());
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Склад КАК К1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Склад) КАК К1_П,");
	Ожидается.Добавить("\tТ.Номенклатура КАК К2,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Номенклатура) КАК К2_П,");
	Ожидается.Добавить("\tСУММА(Т.КоличествоОстаток) КАК К3");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tРегистрНакопления.ТоварыНаСкладах.Остатки(&П1, Склад = &П2) КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.КоличествоОстаток > &П3");
	Ожидается.Добавить("СГРУППИРОВАТЬ ПО");
	Ожидается.Добавить("\tТ.Склад,");
	Ожидается.Добавить("\tТ.Номенклатура");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tК1,");
	Ожидается.Добавить("\tК2");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается));
	Утв.Равно(П.Параметры.Получить("П1").Значение, Дата(2026, 10, 20, 0, 0, 0), "остаток на конец дня");
	Утв.Равно(ИменаКолонок(П), "Склад,Номенклатура,КоличествоОстаток");

	Итог = Построить("balances", J("{'group_by':[]}"), ОписаниеОстатков(), Политика());
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tСУММА(Т.КоличествоОстаток) КАК К1,");
	Ожидается.Добавить("\tСУММА(Т.СуммаОстаток) КАК К2");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tРегистрНакопления.ТоварыНаСкладах.Остатки КАК Т");
	Утв.Равно(ТекстЗапроса(Итог), Текст(Ожидается), "текущие остатки без параметров виртуальной таблицы");

	Утв.Содержит(Построить("balances", J("{'group_by':['КоличествоОстаток']}"), ОписаниеОстатков(), Политика()).Ошибка,
		"за ресурсом");
	Утв.Содержит(Построить("balances", J("{'resources':['Вага']}"), ОписаниеОстатков(), Политика()).Ошибка,
		"Ресурс «Вага» не знайдено");
	Утв.Содержит(Построить("balances", J("{'account':'361'}"), ОписаниеОстатков(), Политика()).Ошибка,
		"лише для регістрів бухгалтерії");

КонецПроцедуры

Процедура ТестСкрытыйРесурсИИзмерение() Экспорт

	П_ = Политика();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("РегистрНакопления.ТоварыНаСкладах", "Сумма", "deny"));
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("РегистрНакопления.ТоварыНаСкладах", "Склад", "deny"));
	П = Построить("balances", J("{}"), ОписаниеОстатков(), П_);
	Утв.Равно(ИменаКолонок(П), "Номенклатура,КоличествоОстаток", "политика ресурса распространяется на СуммаОстаток");
	Утв.Содержит(Построить("balances", J("{'resources':['Сумма']}"), ОписаниеОстатков(), П_).Ошибка, "не знайдено");
	Утв.Содержит(Построить("balances", J("{'filters':[{'field':'СуммаОстаток','op':'gt','value':0}]}"),
		ОписаниеОстатков(), П_).Ошибка, "не знайдено");

КонецПроцедуры

Процедура ТестОборотыРегистраБухгалтерии() Экспорт

	Аргументы = J("{'register':'РегистрБухгалтерии.Хозрасчетный','period':{'from':'2026-09-01','to':'2026-09-30'},
	|'periodicity':'month','account':'361','group_by':['Счет','Субконто1'],
	|'filters':[{'field':'Организация','op':'eq','value':" + Ссылка("Справочник.Организации", 1) + "}]}");
	П = Построить("turnovers", Аргументы, ОписаниеОборотовБухгалтерии(), Политика());
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Период КАК К1,");
	Ожидается.Добавить("\tТ.Счет КАК К2,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Счет) КАК К2_П,");
	Ожидается.Добавить("\tТ.Субконто1 КАК К3,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Субконто1) КАК К3_П,");
	Ожидается.Добавить("\tСУММА(Т.СуммаОборотДт) КАК К4,");
	Ожидается.Добавить("\tСУММА(Т.СуммаОборотКт) КАК К5");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tРегистрБухгалтерии.Хозрасчетный.Обороты(&П1, &П2, Месяц, Счет В ИЕРАРХИИ (&П3), , "
		+ "Организация = &П4) КАК Т");
	Ожидается.Добавить("СГРУППИРОВАТЬ ПО");
	Ожидается.Добавить("\tТ.Период,");
	Ожидается.Добавить("\tТ.Счет,");
	Ожидается.Добавить("\tТ.Субконто1");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tК1,");
	Ожидается.Добавить("\tК2,");
	Ожидается.Добавить("\tК3");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается));
	Счет = П.Параметры.Получить("П3");
	Утв.Равно(Счет.Вид, "account_code");
	Утв.Равно(Счет.Тип, "ПланСчетов.Хозрасчетный");
	Утв.Равно(Счет.Значение, "361");
	Утв.Равно(П.Параметры.Получить("П2").Значение, Дата(2026, 9, 30, 23, 59, 59));

	Утв.Содержит(Построить("turnovers", J("{'register':'X'}"), ОписаниеОборотовБухгалтерии(), Политика()).Ошибка,
		"period");
	Утв.Содержит(Построить("turnovers", J("{'period':{'from':'2026-09-01','to':'2026-09-30'},'group_by':['Период']}"),
		ОписаниеОборотовБухгалтерии(), Политика()).Ошибка, "лише з periodicity");
	Утв.Содержит(Построить("turnovers", J("{'period':{'from':'2026-09-01','to':'2026-09-30'},'periodicity':'decade'}"),
		ОписаниеОборотовБухгалтерии(), Политика()).Ошибка, "periodicity");

КонецПроцедуры

Процедура ТестСрезПоследних() Экспорт

	Аргументы = J("{'register':'РегистрСведений.КурсыВалют','date':'2026-10-19',
	|'filters':[{'field':'Валюта','op':'in','value':[" + Ссылка("Справочник.Валюты", 7) + "]},
	|{'field':'Курс','op':'gt','value':1}]}");
	П = Построить("slice", Аргументы, ОписаниеСреза(), Политика());
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Период КАК К1,");
	Ожидается.Добавить("\tТ.Валюта КАК К2,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Валюта) КАК К2_П,");
	Ожидается.Добавить("\tТ.Курс КАК К3,");
	Ожидается.Добавить("\tТ.Кратность КАК К4");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tРегистрСведений.КурсыВалют.СрезПоследних(&П1, Валюта В (&П2)) КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.Курс > &П3");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tТ.Валюта");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается));
	Утв.Равно(П.Параметры.Получить("П1").Значение, Дата(2026, 10, 19, 23, 59, 59), "срез на конец дня");

КонецПроцедуры

#КонецОбласти

#Область ПоискИКарточка

Процедура ТестПоискОбъектов() Экспорт

	П_ = Политика();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "ИНН", "deny"));
	П = Построить("find", "аль_фа", ОписаниеКонтрагентов(), П_, 20);
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 21");
	Ожидается.Добавить("\tТ.Ссылка КАК К1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Ссылка) КАК К1_П,");
	Ожидается.Добавить("\tТ.Код КАК К2,");
	Ожидается.Добавить("\tТ.Наименование КАК К3");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tСправочник.Контрагенты КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\t(Т.Наименование ПОДОБНО &П1 СПЕЦСИМВОЛ ""~"" ИЛИ Т.Код ПОДОБНО &П2 СПЕЦСИМВОЛ ""~"")");
	Ожидается.Добавить("\tИ Т.ПометкаУдаления = &П3");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tТ.Ссылка");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается), "скрытое поле ИНН в поиске не участвует");
	Утв.Равно(П.Параметры.Получить("П1").Значение, "%аль~_фа%");

	П = Построить("find", "123", ОписаниеКонтрагентов(), Политика(), 20);
	Утв.Содержит(ТекстЗапроса(П), "ИЛИ Т.ИНН ПОДОБНО &П3");
	Утв.Равно(ИменаКолонок(П), "Ссылка,Код,Наименование,ИНН");

	П_ = Политика();
	П_.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Документ.РеализацияТоваровУслуг", "read", Ложь, Истина));
	Утв.Содержит(Построить("find", "123", ОписаниеРеализации(), П_).Ошибка, "вимагає фільтр за періодом");

КонецПроцедуры

Процедура ТестКарточкаОбъекта() Экспорт

	П_ = Политика();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "ИНН", "deny"));
	П = Построить("card", "4E0C1D2A-0000-0000-0000-000000000009", ОписаниеКонтрагентов(), П_);
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 2");
	Ожидается.Добавить("\tТ.Ссылка КАК К1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Ссылка) КАК К1_П,");
	Ожидается.Добавить("\tТ.ПометкаУдаления КАК К2,");
	Ожидается.Добавить("\tТ.Код КАК К3,");
	Ожидается.Добавить("\tТ.Наименование КАК К4,");
	Ожидается.Добавить("\tТ.ГоловнойКонтрагент КАК К5,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.ГоловнойКонтрагент) КАК К5_П");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tСправочник.Контрагенты КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.Ссылка = &П1");
	Ожидается.Добавить("\tИ Т.ПометкаУдаления = &П2");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается), "скрытые и запрещенные поля не выбираются");
	Утв.Равно(П.Параметры.Получить("П1").Тип, "Справочник.Контрагенты");
	Утв.Равно(П.Параметры.Получить("П1").Идентификатор, "4e0c1d2a-0000-0000-0000-000000000009");

	Утв.Содержит(Построить("card", "123", ОписаниеКонтрагентов(), П_).Ошибка, "ref");

	П = Построить("tabular", "4e0c1d2a-0000-0000-0000-000000000009", ОписаниеТоваров(), ПолитикаСОграничениями(), 10);
	Текст_ = ТекстЗапроса(П);
	Утв.Содержит(Текст_, "ВЫБРАТЬ ПЕРВЫЕ 11");
	Утв.НеСодержит(Текст_, "Т.Ссылка КАК", "ссылка владельца не выбирается");
	Утв.Содержит(Текст_, "Т.Ссылка = &П1");
	Утв.Содержит(Текст_, "Т.Ссылка.Организация = &П2");
	Утв.Равно(ИменаКолонок(П), "НомерСтроки,Номенклатура,Цена");

КонецПроцедуры

#КонецОбласти

#Область Значения

Функция Разобрать(ТекстJSON, Типы)

	Возврат mcp1c_ЗапросыДанных.РазобратьЗначение(J(ТекстJSON), СтрРазделить(Типы, ","), "value");

КонецФункции

Процедура ТестРазборЗначений() Экспорт

	Р = Разобрать("{'type':'catalog.контрагенты','ref':'4E0C1D2A-0000-0000-0000-000000000001','presentation':'А'}",
		"Справочник.Контрагенты,Строка");
	Утв.Истинно(Р.Успех, Р.Ошибка);
	Утв.Равно(Р.Значение.Тип, "Справочник.Контрагенты");
	Утв.Равно(Р.Значение.Идентификатор, "4e0c1d2a-0000-0000-0000-000000000001");

	Р = Разобрать("{'ref':'4e0c1d2a-0000-0000-0000-000000000001'}", "Справочник.Контрагенты");
	Утв.Истинно(Р.Успех, "тип можно не указывать, если ссылочный тип один");

	Р = Разобрать("'4e0c1d2a-0000-0000-0000-000000000001'", "Справочник.Контрагенты");
	Утв.Равно(Р.Значение.Вид, "ref", "строка-идентификатор для единственного ссылочного типа");

	Р = Разобрать("'НДС20'", "Перечисление.СтавкиНДС");
	Утв.Равно(Р.Значение.Вид, "enum");
	Утв.Равно(Р.Значение.Имя, "НДС20");

	Р = Разобрать("'2026-09-30'", "Дата");
	Утв.Равно(Р.Значение.Значение, Дата(2026, 9, 30));

	Р = Разобрать("true", "Булево");
	Утв.Равно(Р.Значение.Значение, Истина);

	Утв.Содержит(Разобрать("{'type':'Справочник.Номенклатура','ref':'4e0c1d2a-0000-0000-0000-000000000001'}",
		"Справочник.Контрагенты").Ошибка, "не підходить");
	Утв.Содержит(Разобрать("{'type':'Перечисление.СтавкиНДС','value':'НДС 20'}", "Перечисление.СтавкиНДС").Ошибка,
		"ім'я значення");
	Утв.Содержит(Разобрать("{'type':'Справочник.Контрагенты','ref':'1'}", "Справочник.Контрагенты").Ошибка,
		"унікальний ідентифікатор");
	Утв.Содержит(Разобрать("'30.09.2026'", "Дата").Ошибка, "YYYY-MM-DD");
	Утв.Содержит(Разобрать("5", "Строка").Ошибка, "не підходить");
	Утв.Содержит(Разобрать("'5'", "Число").Ошибка, "не підходить");
	Утв.Содержит(Разобрать("null", "Строка").Ошибка, "is_empty");
	Утв.Содержит(Разобрать("[1]", "Число").Ошибка, "масив");

КонецПроцедуры

Процедура ТестОтборыПоТипамЗначений() Экспорт

	Таблица = ОписаниеРеализации();
	Утв.Содержит(Построить("records", J("{'filters':[{'field':'Контрагент','op':'gt','value':'x'}]}"),
		Таблица, Политика()).Ошибка, "число, дата або рядок");
	Утв.Содержит(Построить("records", J("{'filters':[{'field':'СуммаДокумента','op':'contains','value':'1'}]}"),
		Таблица, Политика()).Ошибка, "лише для рядкових");
	Утв.Содержит(Построить("records", J("{'filters':[{'field':'Дата','op':'between','value':['2026-09-01']}]}"),
		Таблица, Политика()).Ошибка, "двох значень");
	Утв.Содержит(Построить("records", J("{'filters':[{'field':'СуммаДокумента','op':'eq','value':[1,2]}]}"),
		Таблица, Политика()).Ошибка, "op in");
	Утв.Содержит(Построить("records", J("{'filters':[{'field':'Номер','op':'in_hierarchy','value':'1'}]}"),
		Таблица, Политика()).Ошибка, "лише для посилань");

	П = Построить("records", J("{'fields':['Номер'],'filters':[{'field':'Контрагент','op':'is_empty'},"
		+ "{'field':'Основание','op':'not_empty'},{'field':'Контрагент','op':'in_hierarchy','value':"
		+ Ссылка("Справочник.Контрагенты", 2) + "}]}"), Таблица, Политика());
	Текст_ = ТекстЗапроса(П);
	Утв.Содержит(Текст_, "(Т.Контрагент ЕСТЬ NULL ИЛИ Т.Контрагент = &П1)");
	Утв.Содержит(Текст_, "(НЕ Т.Основание ЕСТЬ NULL И Т.Основание <> &П2)");
	Утв.Содержит(Текст_, "Т.Контрагент В ИЕРАРХИИ (&П3)");
	Утв.Равно(П.Параметры.Получить("П1").Вид, "empty");
	Утв.МассивРавен(П.Параметры.Получить("П1").Типы, "Справочник.Контрагенты");

	Много = Новый Массив;
	Для Номер = 1 По 101 Цикл
		Много.Добавить(Номер);
	КонецЦикла;
	Отбор = Новый Соответствие;
	Отбор.Вставить("field", "СуммаДокумента");
	Отбор.Вставить("op", "in");
	Отбор.Вставить("value", Много);
	Отборы = Новый Массив;
	Отборы.Добавить(Отбор);
	Аргументы = Новый Соответствие;
	Аргументы.Вставить("filters", Отборы);
	Утв.Содержит(Построить("records", Аргументы, Таблица, Политика()).Ошибка, "від 1 до 100");

КонецПроцедуры

Процедура ТестСлужебныеФункции() Экспорт

	Утв.Равно(mcp1c_ЗапросыДанных.НормализованноеИмяТипа("chartOfAccounts.Хозрасчетный"), "ПланСчетов.Хозрасчетный");
	Утв.Равно(mcp1c_ЗапросыДанных.НормализованноеИмяТипа("Справочник.Контрагенты"), "Справочник.Контрагенты");
	Утв.Истинно(mcp1c_ЗапросыДанных.ЭтоУникальныйИдентификатор("4E0C1D2A-0000-0000-0000-00000000000f"));
	Утв.Ложно(mcp1c_ЗапросыДанных.ЭтоУникальныйИдентификатор("4E0C1D2A-0000-0000-0000-00000000000g"));
	Утв.Ложно(mcp1c_ЗапросыДанных.ЭтоУникальныйИдентификатор("4E0C1D2A00000-0000-0000-00000000000f"));

КонецПроцедуры

#КонецОбласти

#Область МаскиИАгрегаты

Функция ПолитикаСМасками()

	П = Политика();
	Объект = "Документ.РеализацияТоваровУслуг";
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля(Объект, "Комментарий", "mask", "partial"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля(Объект, "СуммаДокумента", "mask", "round", 1000));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля(Объект, "Контрагент", "mask", "hash"));
	П.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "ИНН", "mask", "full"));
	Возврат П;

КонецФункции

Процедура ТестМаскированныеПоляВВыборке() Экспорт

	П = Построить("records", J("{'fields':['Номер','Комментарий','СуммаДокумента','Контрагент','Организация']}"),
		ОписаниеРеализации(), ПолитикаСМасками());
	Утв.Содержит(ТекстЗапроса(П), "Т.Комментарий КАК К2", "замаскированное поле выбирается");
	Утв.Неопределено_(П.Колонки[0].Маска);
	Утв.Равно(П.Колонки[1].Маска.Вид, "partial");
	Утв.Равно(П.Колонки[1].Вид, "masked");
	Утв.Равно(П.Колонки[2].Маска.Вид, "round");
	Утв.Равно(П.Колонки[2].Вид, "number", "округленное число остается числом");
	Утв.Равно(П.Колонки[3].Вид, "masked");
	Утв.Неопределено_(П.Колонки[4].Маска);
	Утв.Равно(СтрСоединить(mcp1c_ЗапросыДанных.МаскированныеКолонки(П), ","), "Комментарий,СуммаДокумента,Контрагент");
	Колонки = mcp1c_ЗапросыДанных.ОписаниеКолонок(П);
	Утв.Неопределено_(Колонки[0].Получить("mask"));
	Утв.Равно(Колонки[1].Получить("mask").Получить("kind"), "partial");
	Утв.Равно(Колонки[2].Получить("mask").Получить("step"), 1000);

	// Поля по умолчанию тоже маскируются; маска поля связанного объекта - через разыменование.
	П = Построить("records", J("{'object':'Документ.РеализацияТоваровУслуг'}"), ОписаниеРеализации(), ПолитикаСМасками());
	Утв.Содержит(СтрСоединить(mcp1c_ЗапросыДанных.МаскированныеКолонки(П), ","), "Контрагент,Комментарий,СуммаДокумента");
	П_ = Политика();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "ИНН", "mask", "full"));
	П = Построить("records", J("{'fields':['Контрагент.ИНН']}"), ОписаниеРеализации(), П_);
	Утв.Равно(П.Колонки[0].Маска.Вид, "full");

КонецПроцедуры

Процедура ТестМаскированныеПоляНеИспользуютсяВУсловиях() Экспорт

	Таблица = ОписаниеРеализации();
	П_ = ПолитикаСМасками();
	Варианты = Новый Соответствие;
	Варианты.Вставить("{'filters':[{'field':'Комментарий','op':'contains','value':'а'}]}", "фільтрувати за ним не можна");
	Варианты.Вставить("{'filters':[{'field':'СуммаДокумента','op':'gt','value':1000}]}", "фільтрувати за ним не можна");
	Варианты.Вставить("{'filters':[{'field':'Контрагент.Наименование','op':'eq','value':'А'}]}", "розіменування");
	Варианты.Вставить("{'order_by':[{'field':'СуммаДокумента','desc':true}]}", "сортувати за ним не можна");
	Варианты.Вставить("{'group_by':['Контрагент'],'aggregates':[{'func':'count'}]}", "групувати за ним не можна");
	Варианты.Вставить("{'group_by':['Организация'],'aggregates':[{'field':'Комментарий','func':'max'}]}",
		"лише count і count_distinct");
	Для Каждого Вариант Из Варианты Цикл
		Результат = Построить("records", J(Вариант.Ключ), Таблица, П_);
		Утв.Содержит(Результат.Ошибка, Вариант.Значение, Вариант.Ключ);
		Утв.Содержит(Результат.Ошибка, "масковане", Вариант.Ключ);
	КонецЦикла;

	// Количество различных значений и сумма с маской округления допустимы; сумма округляется тем же шагом.
	П = Построить("records", J("{'group_by':['Организация'],'aggregates':[{'field':'Контрагент','func':'count_distinct'},"
		+ "{'field':'СуммаДокумента','func':'sum','as':'Сума'}]}"), Таблица, П_);
	Утв.Содержит(ТекстЗапроса(П), "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Контрагент) КАК К2");
	Утв.Неопределено_(П.Колонки[1].Маска, "у количества маски нет");
	Утв.Равно(П.Колонки[2].Маска.Вид, "round");

КонецПроцедуры

Процедура ТестМаскаВПорядкеПоискеИПериоде() Экспорт

	// Порядок по умолчанию не использует замаскированную дату.
	П_ = Политика();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Документ.РеализацияТоваровУслуг", "Дата", "mask", "full"));
	Текст_ = ТекстЗапроса(Построить("records", J("{'fields':['Номер']}"), ОписаниеРеализации(), П_));
	Утв.Содержит(Текст_, "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб + "Т.Ссылка");
	Утв.НеСодержит(Текст_, "Т.Дата");
	Утв.Содержит(Построить("records", J("{'fields':['Номер'],'period':{'from':'2026-09-01','to':'2026-09-30'}}"),
		ОписаниеРеализации(), П_).Ошибка, "відбирати за періодом за ним не можна");

	// Замаскированное поле в поиске не участвует.
	П_ = Политика();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("Справочник.Контрагенты", "ИНН", "mask", "partial"));
	П = Построить("find", "123", ОписаниеКонтрагентов(), П_, 20);
	Утв.НеСодержит(ТекстЗапроса(П), "ИНН");
	Утв.Равно(ИменаКолонок(П), "Ссылка,Код,Наименование");

КонецПроцедуры

Процедура ТестМаскированныеРесурсыИИзмерения() Экспорт

	П_ = Политика();
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("РегистрНакопления.ТоварыНаСкладах", "Сумма", "mask", "full"));
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("РегистрНакопления.ТоварыНаСкладах", "Склад", "mask", "hash"));
	П_.Поля.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоПоля("РегистрНакопления.ТоварыНаСкладах", "Количество", "mask",
		"round", 10));
	П = Построить("balances", J("{}"), ОписаниеОстатков(), П_);
	Утв.Равно(ИменаКолонок(П), "Номенклатура,КоличествоОстаток", "замаскированные измерение и ресурс пропущены");
	Примечания = СтрСоединить(П.Примечания, ";");
	Утв.Содержит(Примечания, "Масковані виміри не групуються: Склад");
	Утв.Содержит(Примечания, "Масковані ресурси не підсумовуються: Сумма");
	Утв.Равно(П.Колонки[1].Маска.Параметр, 10, "сумма ресурса с маской округления округляется");
	Утв.Содержит(Построить("balances", J("{'resources':['Сумма']}"), ОписаниеОстатков(), П_).Ошибка, "масковане");
	Утв.Содержит(Построить("balances", J("{'group_by':['Склад']}"), ОписаниеОстатков(), П_).Ошибка, "групувати");

КонецПроцедуры

Процедура ТестТолькоАгрегаты() Экспорт

	П_ = Политика();
	Правило = mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("Документ.РеализацияТоваровУслуг", "aggregates");
	Правило.МинимальныйРазмерГруппы = 3;
	П_.Объекты.Добавить(Правило);
	Таблица = ОписаниеРеализации();
	Утв.Содержит(Построить("records", J("{'fields':['Номер']}"), Таблица, П_).Ошибка, "лише в агрегатах");
	Утв.Содержит(Построить("records", J("{'group_by':['Контрагент']}"), Таблица, П_).Ошибка, "задайте aggregates");
	Утв.Содержит(Построить("records", J("{'aggregates':[{'field':'СуммаДокумента','func':'max'}]}"), Таблица, П_).Ошибка,
		"min і max");
	Утв.Содержит(Построить("find", "123", Таблица, П_).Ошибка, "окремі записи не видаються");
	Утв.Содержит(Построить("card", "4e0c1d2a-0000-0000-0000-000000000009", Таблица, П_).Ошибка, "окремі записи");
	Утв.Содержит(Построить("tabular", "4e0c1d2a-0000-0000-0000-000000000009", ОписаниеТоваров(), П_).Ошибка,
		"окремі записи", "табличная часть объекта в режиме агрегатов");

	П = Построить("records", J("{'group_by':['Контрагент'],'aggregates':[{'field':'СуммаДокумента','func':'sum',"
		+ "'as':'Сума'}]}"), Таблица, П_);
	Ожидается = Новый Массив;
	Ожидается.Добавить("ВЫБРАТЬ ПЕРВЫЕ 51");
	Ожидается.Добавить("\tТ.Контрагент КАК К1,");
	Ожидается.Добавить("\tПРЕДСТАВЛЕНИЕССЫЛКИ(Т.Контрагент) КАК К1_П,");
	Ожидается.Добавить("\tСУММА(Т.СуммаДокумента) КАК К2");
	Ожидается.Добавить("ИЗ");
	Ожидается.Добавить("\tДокумент.РеализацияТоваровУслуг КАК Т");
	Ожидается.Добавить("ГДЕ");
	Ожидается.Добавить("\tТ.ПометкаУдаления = &П1");
	Ожидается.Добавить("СГРУППИРОВАТЬ ПО");
	Ожидается.Добавить("\tТ.Контрагент");
	Ожидается.Добавить("ИМЕЮЩИЕ");
	Ожидается.Добавить("\tКОЛИЧЕСТВО(*) >= &П2");
	Ожидается.Добавить("УПОРЯДОЧИТЬ ПО");
	Ожидается.Добавить("\tК1");
	Утв.Равно(ТекстЗапроса(П), Текст(Ожидается));
	Утв.Равно(П.Параметры.Получить("П2").Значение, 3, "минимальный размер группы из профиля");
	Утв.Содержит(СтрСоединить(П.Примечания, ";"), "менше 3 записів");

	Текст_ = ТекстЗапроса(Построить("records", J("{'aggregates':[{'func':'count'}]}"), Таблица, П_));
	Утв.Содержит(Текст_, "КОЛИЧЕСТВО(*) КАК К1");
	Утв.Содержит(Текст_, "ИМЕЮЩИЕ" + Символы.ПС + Символы.Таб + "КОЛИЧЕСТВО(*) >= &П2", "итог без группировки");

	// Регистры в режиме агрегатов: виртуальные таблицы свернуты платформой по измерениям запроса,
	// КОЛИЧЕСТВО(*) в них не равно числу записей (проверено на BAS ERP) - остатки, обороты и срез
	// недоступны, агрегаты записей - через query_records.
	П_.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("РегистрНакопления.ТоварыНаСкладах", "aggregates"));
	П_.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("РегистрБухгалтерии.Хозрасчетный", "aggregates"));
	П_.Объекты.Добавить(mcp1c_ПравилаДоступа.НовоеПравилоОбъекта("РегистрСведений.КурсыВалют", "aggregates"));
	Утв.Содержит(Построить("balances", J("{'group_by':['Склад']}"), ОписаниеОстатков(), П_).Ошибка, "агрегатах записів");
	Утв.Содержит(Построить("turnovers", J("{'period':{'from':'2026-09-01','to':'2026-09-30'}}"),
		ОписаниеОборотовБухгалтерии(), П_).Ошибка, "агрегатах записів");
	Утв.Содержит(Построить("slice", J("{}"), ОписаниеСреза(), П_).Ошибка, "окремі записи");

КонецПроцедуры

Процедура ТестОграничениеСПараметромПрофиля() Экспорт

	П_ = Политика();
	П_.ПараметрыПрофиля.Вставить("разрешенныеорганизации", mcp1c_ПравилаДоступа.НовыйПараметрПрофиля(
		"РазрешенныеОрганизации", "Справочник.Организации"));
	Значения = Новый Массив;
	Значения.Добавить(mcp1c_ПравилаДоступа.НовоеЗначениеПараметра(J(Ссылка("Справочник.Организации", 1)),
		"Справочник.Организации"));
	Значения.Добавить(mcp1c_ПравилаДоступа.НовоеЗначениеПараметра(J(Ссылка("Справочник.Организации", 2)),
		"Справочник.Организации"));
	П_.ЗначенияПараметров.Вставить("разрешенныеорганизации", Значения);
	П_.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.РеализацияТоваровУслуг",
		"Организация", "eq", Неопределено, "", "РазрешенныеОрганизации"));
	mcp1c_ПравилаДоступа.ПодставитьПараметры(П_);

	П = Построить("records", J("{'fields':['Номер']}"), ОписаниеРеализации(), П_);
	Утв.Содержит(ТекстЗапроса(П), "И Т.Организация В (&П2)");
	Список = П.Параметры.Получить("П2");
	Утв.Равно(Список.Элементы.Количество(), 2);
	Утв.Равно(Список.Элементы[1].Идентификатор, "4e0c1d2a-0000-0000-0000-000000000002");
	Утв.Содержит(СтрСоединить(П.Примечания, ";"), "Рядки обмежено правилами профілю");

	// Значения параметра в клиенте не заданы: доступ к объекту закрыт, причина - в журнал.
	П_ = Политика();
	П_.ПараметрыПрофиля.Вставить("разрешенныеорганизации", mcp1c_ПравилаДоступа.НовыйПараметрПрофиля(
		"РазрешенныеОрганизации", "Справочник.Организации"));
	П_.ОграниченияСтрок.Добавить(mcp1c_ПравилаДоступа.НовоеОграничениеСтрок("Документ.РеализацияТоваровУслуг",
		"Организация", "eq", Неопределено, "", "РазрешенныеОрганизации"));
	mcp1c_ПравилаДоступа.ПодставитьПараметры(П_);
	Результат = Построить("records", J("{'fields':['Номер']}"), ОписаниеРеализации(), П_);
	Утв.Содержит(Результат.Ошибка, "Обмеження рядків профілю");
	Утв.НеСодержит(Результат.Ошибка, "РазрешенныеОрганизации", "подробности - только в журнале");
	Утв.Содержит(Результат.Причина, "РазрешенныеОрганизации");

КонецПроцедуры

#КонецОбласти

// Тесты mcp1c_ПользовательскиеИнструменты: проверка определения, описание для tools/list,
// значения аргументов и параметров профиля, лимит строк, доступность инструмента.
#Использовать "../../build/oslib"

Функция ИдОрганизации()
	Возврат "0b8f3a10-1111-4000-8000-000000000001";
КонецФункции

Функция ИдКонтрагента()
	Возврат "0b8f3a10-2222-4000-8000-000000000002";
КонецФункции

Функция J(Текст)

	Возврат mcp1c_Сериализация.ПрочитатьИзСтрокиJSON(СтрЗаменить(Текст, "'", """"));

КонецФункции

Функция Параметр(Имя, ИмяПараметра, Типы, Обязательный = Ложь)

	Результат = mcp1c_ПользовательскиеИнструменты.НовыйПараметр(Имя, ИмяПараметра, Типы);
	Результат.Обязательный = Обязательный;
	Возврат Результат;

КонецФункции

Функция ДолгКлиента()

	Определение = mcp1c_ПользовательскиеИнструменты.НовоеОпределение("customer_debt", "query");
	Определение.Заголовок = "Борг клієнта";
	Определение.Описание = "Залишок взаєморозрахунків з клієнтом на дату: додатний - борг клієнта.";
	Определение.ТекстЗапроса = "ВЫБРАТЬ 1 КАК Сумма";
	Определение.Параметры.Добавить(Параметр("counterparty", "Контрагент", "Catalog.Контрагенты", Истина));
	Дата_ = Параметр("date", "Дата", "Date");
	mcp1c_ПользовательскиеИнструменты.УстановитьЗначенияПараметра(Дата_, """2026-01-01""", "");
	Определение.Параметры.Добавить(Дата_);
	Валюты = Параметр("currencies", "", "Строка");
	Валюты.Список = Истина;
	mcp1c_ПользовательскиеИнструменты.УстановитьЗначенияПараметра(Валюты, "", "[""UAH"", ""USD""]");
	Определение.Параметры.Добавить(Валюты);
	Организация = Параметр("organization", "Организация", "Справочник.Организации");
	Организация.ПараметрПрофиля = "РазрешенныеОрганизации";
	Определение.Параметры.Добавить(Организация);
	Возврат Определение;

КонецФункции

Функция ПолитикаСОрганизацией(ТекстЗначения)

	Политика = mcp1c_ПравилаДоступа.НоваяПолитика();
	Политика.ПараметрыПрофиля.Вставить("разрешенныеорганизации", mcp1c_ПравилаДоступа.НовыйПараметрПрофиля(
		"РазрешенныеОрганизации", "Справочник.Организации"));
	Если ТекстЗначения <> Неопределено Тогда
		Политика.ЗначенияПараметров.Вставить("разрешенныеорганизации",
			mcp1c_ПравилаДоступа.ЗначенияПараметраИзJSON(СтрЗаменить(ТекстЗначения, "'", """")));
	КонецЕсли;
	Возврат Политика;

КонецФункции

Функция Ошибки(Определение)

	Возврат СтрСоединить(mcp1c_ПользовательскиеИнструменты.ОшибкиОпределения(Определение), "; ");

КонецФункции

Процедура ТестКорректноеОпределение() Экспорт

	Утв.Равно(Ошибки(ДолгКлиента()), "");
	Параметр_ = ДолгКлиента().Параметры[0];
	Утв.Равно(Параметр_.ИмяПараметра, "Контрагент");
	Утв.МассивРавен(Параметр_.Типы, "Справочник.Контрагенты", "английский класс приводится к русскому");
	Утв.Равно(ДолгКлиента().Параметры[2].ИмяПараметра, "currencies", "без имени параметра - как аргумент");
	Утв.МассивРавен(ДолгКлиента().Параметры[1].Типы, "Дата");

КонецПроцедуры

Процедура ТестОшибкиИмениВидаИОписания() Экспорт

	Для Каждого Имя Из СтрРазделить("CustomerDebt,ab,1abc,customer-debt", ",") Цикл
		Определение = ДолгКлиента();
		Определение.Имя = Имя;
		Утв.Содержит(Ошибки(Определение), "Ім'я інструмента", Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("query_records,get_context,execute_query", ",") Цикл
		Определение = ДолгКлиента();
		Определение.Имя = Имя;
		Утв.Содержит(Ошибки(Определение), "зайняте вбудованим", Имя);
	КонецЦикла;

	Определение = ДолгКлиента();
	Определение.Описание = " ";
	Утв.Содержит(Ошибки(Определение), "опис для моделі");

	Определение = ДолгКлиента();
	Определение.ТекстЗапроса = "";
	Утв.Содержит(Ошибки(Определение), "текст запиту");

	Определение = ДолгКлиента();
	Определение.Вид = "dcs";
	Утв.Содержит(Ошибки(Определение), "схему компонування");

	Определение = ДолгКлиента();
	Определение.Вид = "method";
	Определение.ИмяМодуля = "ОтчетыСервер";
	Определение.ИмяМетода = "Долг-Клиента";
	Утв.Содержит(Ошибки(Определение), "Ім'я модуля");
	Определение.ИмяМетода = "ДолгКлиента";
	Утв.Равно(Ошибки(Определение), "", "кириллица в идентификаторах");

	Определение = ДолгКлиента();
	Определение.Вид = "";
	Утв.Содержит(Ошибки(Определение), "вид інструмента");

КонецПроцедуры

Процедура ТестОшибкиПараметров() Экспорт

	Определение = ДолгКлиента();
	Определение.Параметры.Добавить(Параметр("1date", "", "Дата"));
	Утв.Содержит(Ошибки(Определение), "ім'я аргументу");

	Определение = ДолгКлиента();
	Определение.Параметры.Добавить(Параметр("counterparty", "Контрагент2", "Строка"));
	Утв.Содержит(Ошибки(Определение), "аргумент з таким ім'ям уже є");

	Определение = ДолгКлиента();
	Определение.Параметры.Добавить(Параметр("other", "контрагент", "Строка"));
	Утв.Содержит(Ошибки(Определение), "уже зіставлено", "имена параметров запроса без учета регистра");

	Определение = ДолгКлиента();
	Определение.Параметры.Добавить(Параметр("other", "&Другой", "Строка"));
	Утв.Содержит(Ошибки(Определение), "ідентифікатор 1С без &");

	Определение = ДолгКлиента();
	Определение.Параметры.Добавить(Параметр("other", "", ""));
	Утв.Содержит(Ошибки(Определение), "не вказано тип");

	Определение = ДолгКлиента();
	Сумма = Параметр("amount", "Сумма", "Число");
	mcp1c_ПользовательскиеИнструменты.УстановитьЗначенияПараметра(Сумма, "{не json", "");
	Определение.Параметры.Добавить(Сумма);
	Утв.Содержит(Ошибки(Определение), "некоректний JSON");

	Определение = ДолгКлиента();
	Сумма = Параметр("amount", "Сумма", "Число");
	mcp1c_ПользовательскиеИнструменты.УстановитьЗначенияПараметра(Сумма, """сто""", "");
	Определение.Параметры.Добавить(Сумма);
	Утв.Содержит(Ошибки(Определение), "значення за замовчуванням", "значение по умолчанию не подходит типу");

	Определение = ДолгКлиента();
	Сумма = Параметр("amount", "Сумма", "Число");
	mcp1c_ПользовательскиеИнструменты.УстановитьЗначенияПараметра(Сумма, "", "{""a"": 1}");
	Определение.Параметры.Добавить(Сумма);
	Утв.Содержит(Ошибки(Определение), "JSON-масив рядків або чисел");

КонецПроцедуры

Процедура ТестОписаниеИнструмента() Экспорт

	Описание = mcp1c_ПользовательскиеИнструменты.ОписаниеИнструмента(ДолгКлиента());
	Утв.Равно(Описание.Получить("name"), "customer_debt");
	Утв.Равно(Описание.Получить("title"), "Борг клієнта");
	Утв.Содержит(Описание.Получить("description"), "додатний - борг клієнта");
	Утв.Содержит(Описание.Получить("description"), "columns і rows");
	Утв.Равно(Описание.Получить("annotations").Получить("readOnlyHint"), Истина);

	Схема = Описание.Получить("inputSchema");
	Утв.Равно(Схема.Получить("additionalProperties"), Ложь);
	Свойства = Схема.Получить("properties");
	Утв.Равно(Свойства.Количество(), 3, "параметр профиля модели не виден");
	Утв.Неопределено_(Свойства.Получить("organization"));
	Утв.МассивРавен(Схема.Получить("required"), "counterparty", "обязательный без значения по умолчанию");

	Контрагент = Свойства.Получить("counterparty");
	Утв.Неопределено_(Контрагент.Получить("type"), "ссылка проверяется разбором по типам");
	Утв.Содержит(Контрагент.Получить("description"), "Справочник.Контрагенты");
	Дата_ = Свойства.Получить("date");
	Утв.Равно(Дата_.Получить("type"), "string");
	Утв.Равно(Дата_.Получить("default"), "2026-01-01");
	Валюты = Свойства.Получить("currencies");
	Утв.Равно(Валюты.Получить("type"), "array");
	Утв.Равно(Валюты.Получить("items").Получить("type"), "string");
	Утв.МассивРавен(Валюты.Получить("items").Получить("enum"), "UAH,USD");

	Выход = Описание.Получить("outputSchema");
	Утв.МассивРавен(Выход.Получить("required"), "columns,rows,row_count,has_more");
	Утв.Содержит(mcp1c_Сериализация.ЗаписатьВСтрокуJSON(Описание), """name"":""customer_debt""");

	Ошибки = Новый Массив;
	mcp1c_СхемаJSON.Проверить(J("{'counterparty': {'type': 'Справочник.Контрагенты', 'ref': '" + ИдКонтрагента()
		+ "'}, 'currencies': ['UAH']}"), Схема, "arguments", Ошибки);
	Утв.Равно(СтрСоединить(Ошибки, "; "), "");
	mcp1c_СхемаJSON.Проверить(J("{'currencies': ['EUR'], 'organization': 'x'}"), Схема, "arguments", Ошибки);
	Утв.Содержит(СтрСоединить(Ошибки, "; "), "counterparty: обов'язковий");
	Утв.Содержит(СтрСоединить(Ошибки, "; "), "допустимі значення");
	Утв.Содержит(СтрСоединить(Ошибки, "; "), "organization: невідомий параметр", "аргумент параметра профиля не принимается");

	Определение = ДолгКлиента();
	Определение.Заголовок = "";
	Определение.Вид = "method";
	Описание = mcp1c_ПользовательскиеИнструменты.ОписаниеИнструмента(Определение);
	Утв.Равно(Описание.Получить("title"), "customer_debt", "без заголовка - имя");
	Утв.Неопределено_(Описание.Получить("outputSchema").Получить("required").Найти("rows"), "у метода может быть result");

КонецПроцедуры

Процедура ТестОписанияПоИмени() Экспорт

	Политика = mcp1c_ПравилаДоступа.НоваяПолитика();
	Для Каждого Имя Из СтрРазделить("zeta_tool,alpha_tool,mid_tool", ",") Цикл
		Определение = ДолгКлиента();
		Определение.Имя = Имя;
		Политика.ПользовательскиеИнструменты.Вставить(Имя, Определение);
	КонецЦикла;
	Имена = Новый Массив;
	Для Каждого Описание Из mcp1c_ПользовательскиеИнструменты.ОписанияИнструментов(Политика) Цикл
		Имена.Добавить(Описание.Получить("name"));
	КонецЦикла;
	Утв.МассивРавен(Имена, "alpha_tool,mid_tool,zeta_tool");

	Утв.Истинно(mcp1c_ПравилаДоступа.ИнструментДоступен(Политика, "mid_tool"), "назначенный профилю");
	Политика.Инструменты.Добавить("get_object");
	Утв.Истинно(mcp1c_ПравилаДоступа.ИнструментДоступен(Политика, "mid_tool"), "явный перечень встроенных не мешает");
	Утв.Ложно(mcp1c_ПравилаДоступа.ИнструментДоступен(Политика, "other_tool"));

КонецПроцедуры

Процедура ТестЗначенияАргументов() Экспорт

	Политика = ПолитикаСОрганизацией("{'type': 'Справочник.Организации', 'ref': '" + ИдОрганизации() + "'}");
	Аргументы = J("{'counterparty': '" + ИдКонтрагента() + "', 'currencies': ['UAH', 'USD']}");
	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(), Аргументы, Политика);
	Утв.Равно(Итог.Ошибка, "");
	Значения = Итог.Значения;

	Контрагент = Значения.Получить("Контрагент");
	Утв.Равно(Контрагент.Вид, "ref", "uuid строкой для единственного ссылочного типа");
	Утв.Равно(Контрагент.Тип, "Справочник.Контрагенты");
	Утв.Равно(Контрагент.Идентификатор, ИдКонтрагента());
	Утв.Равно(Значения.Получить("Дата").Значение, Дата(2026, 1, 1), "значение по умолчанию");
	Список = Значения.Получить("currencies");
	Утв.Равно(Список.Вид, "list");
	Утв.Равно(Список.Элементы.Количество(), 2);
	Утв.Равно(Список.Элементы[1].Значение, "USD");
	Организация = Значения.Получить("Организация");
	Утв.Равно(Организация.Тип, "Справочник.Организации", "значение из параметра профиля клиента");
	Утв.Равно(Организация.Идентификатор, ИдОрганизации());

	Аргументы = J("{'counterparty': '" + ИдКонтрагента() + "', 'date': '2026-09-30T14:00:00'}");
	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(), Аргументы, Политика);
	Утв.Равно(Итог.Значения.Получить("Дата").Значение, Дата(2026, 9, 30, 14, 0, 0));
	Утв.Неопределено_(Итог.Значения.Получить("currencies"), "необязательный без значения не передается");

КонецПроцедуры

Процедура ТестОшибкиАргументов() Экспорт

	Политика = ПолитикаСОрганизацией("{'type': 'Справочник.Организации', 'ref': '" + ИдОрганизации() + "'}");
	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(), J("{}"), Политика);
	Утв.Содержит(Итог.Ошибка, "обов'язковий аргумент counterparty");

	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(),
		J("{'counterparty': '" + ИдКонтрагента() + "', 'date': '30.09.2026'}"), Политика);
	Утв.Содержит(Итог.Ошибка, "arguments.date");

	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(),
		J("{'counterparty': {'type': 'Справочник.Номенклатура', 'ref': '" + ИдКонтрагента() + "'}}"), Политика);
	Утв.Содержит(Итог.Ошибка, "не підходить", "ссылка другого типа");

	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(),
		J("{'counterparty': '" + ИдКонтрагента() + "', 'currencies': 'UAH'}"), Политика);
	Утв.Содержит(Итог.Ошибка, "очікується масив");

КонецПроцедуры

Процедура ТестПараметрПрофиляЗакрываетДоступ() Экспорт

	Аргументы = J("{'counterparty': '" + ИдКонтрагента() + "'}");
	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(), Аргументы,
		ПолитикаСОрганизацией(Неопределено));
	Утв.Содержит(Итог.Ошибка, "Інструмент недоступний цьому клієнту");
	Утв.Содержит(Итог.Причина, "РазрешенныеОрганизации", "причина отказа для журнала");

	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(), Аргументы,
		ПолитикаСОрганизацией("[{'type': 'Справочник.Организации', 'ref': '" + ИдОрганизации()
		+ "'}, {'type': 'Справочник.Организации', 'ref': '" + ИдКонтрагента() + "'}]"));
	Утв.Содержит(Итог.Ошибка, "кілька значень", "несколько значений для параметра - не списка");

	Определение = ДолгКлиента();
	Определение.Параметры[3].Список = Истина;
	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(Определение, Аргументы,
		ПолитикаСОрганизацией("[{'type': 'Справочник.Организации', 'ref': '" + ИдОрганизации()
		+ "'}, {'type': 'Справочник.Организации', 'ref': '" + ИдКонтрагента() + "'}]"));
	Утв.Равно(Итог.Ошибка, "");
	Утв.Равно(Итог.Значения.Получить("Организация").Элементы.Количество(), 2, "параметр-список");

	Итог = mcp1c_ПользовательскиеИнструменты.ЗначенияАргументов(ДолгКлиента(), Аргументы,
		ПолитикаСОрганизацией("{'type': 'Справочник.Контрагенты', 'ref': '" + ИдКонтрагента() + "'}"));
	Утв.Содержит(Итог.Ошибка, "Інструмент недоступний", "значение не того типа");

КонецПроцедуры

Процедура ТестЛимитСтрок() Экспорт

	Определение = ДолгКлиента();
	Утв.Равно(mcp1c_ПользовательскиеИнструменты.ЛимитСтрок(Определение, 50, Неопределено), 50);
	Определение.ЛимитСтрок = 20;
	Утв.Равно(mcp1c_ПользовательскиеИнструменты.ЛимитСтрок(Определение, 50, Неопределено), 20);
	Утв.Равно(mcp1c_ПользовательскиеИнструменты.ЛимитСтрок(Определение, 10, Неопределено), 10, "профиль сильнее");
	Утв.Равно(mcp1c_ПользовательскиеИнструменты.ЛимитСтрок(Определение, 50, 5), 5, "остаток квоты");
	Утв.Равно(mcp1c_ПользовательскиеИнструменты.ЛимитСтрок(Определение, 50, 0), 0, "квота исчерпана");

КонецПроцедуры
